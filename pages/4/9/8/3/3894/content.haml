          .num_remark
            %h6#remark_2 Remark
            %p
              If here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is trivial in that it factors through the point,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi K
                  %annotation{:encoding => "application/x-tex"} k \colon X \to \ast \to \mathbf{B}K
              then this homotopy fiber product is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi K
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,K/G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} K/G
              is the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              (
              %a.existingWikiWord{:href => "/nlab/show/Klein+geometry"}> Klein geometry
              ) which itself sits in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K/G \to \mathbf{B}G \to \mathbf{B}K
                    \\,.
          .num_example
            %h6#example Example
            %p
              Specifically, when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fr(X)
              is
              %span.newWikiWord
                modulated
                %a{:href => "/nlab/new/modulating+moprhism"} ?
              by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_X \colon X \to \mathbf{B} GL(n)
              into the
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              for the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo :
                      %mo =
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K := GL(n)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \to GL(n)
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Fr(X)
          %h4#structure_on_an_etale_groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Structure on an etale
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss the concept in the generality of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
          %p
            See at
            %em
              %a{:href => "differential+cohesive+%28infinity%2C1%29-topos#structures"} differential cohesion – G-Structure
          %h2#properties Properties
          %h3#integrability_of_structure
            Integrability of
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #Integrability.num_defn
            %h6#definition_5 Definition
            %p
              A
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em locally flat
              (
              %a{:href => "#Sternberg64"}> Sternberg 64, section VII, def. 24
              ) or
              %em integrable
              (e.g.
              = succeed ")" do
                %a{:href => "#Alekseevskii"} Alekseevskii
              = succeed "," do
                %em
                  standard flat
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#StandardFlatGStructure"}
            %p
              This means that there is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              by
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              such that the restriction of the
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-structure." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/integrability+of+G-structures"} integrability of G-structures
            for more on this
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            to integrability of
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
          %h3#relation_to_special_holonomy Relation to special holonomy
          %p
            The existence of
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifolds"} Riemannian manifolds
            is closely related to these having
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/special+holonomy"} special holonomy
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              with
              %a.existingWikiWord{:href => "/nlab/show/holonomy+group"} holonomy group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hol
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hol(g) \subset O(n)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊂
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \subset O(n)
              some other
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              admits a torsion-free G-structure precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hol
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hol(g)
              is
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} conjugate
              to a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Moreover, the space of such
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi L
                    %annotation{:encoding => "application/x-tex"} G/L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is the group of elements suchthat conjugating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hol
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hol(g)
              with them lands in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            This appears as (
            %a{:href => "#Joyce"}> Joyce prop. 3.1.8
            )
          %h2#examples Examples
          %h3#canonical_gstructures Canonical G-structures
          #StandardFlatGStructure.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \hookrightarrow GL(n)
              a subgroup, the
              %em
                standard flat
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              on the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is the
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.maruku-ref{:href => "#GStructureGeneratedByFrameField"}
              %a.existingWikiWord{:href => "/nlab/show/frame+field"} frame field
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (the one which is the identity at each point, under the defining identifications).
          %p
          #CanonicalHStructureOnFModH.num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              any
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie
              = succeed "-inclusion," do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \to G/H
              to the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              that exhibits
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#CapSlovak09"} Čap-Slovak 09, p. 53
          %h3#reduction_of_tangent_bundle_structure Reduction of tangent bundle structure
          %ul
            %li
              %p
                For the
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n, \mathbb{R})
                of matrices of positive determinant, a
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi ℝ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo +
                      %annotation{:encoding => "application/x-tex"} GL(n, \mathbb{R})^+
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            %li
              %p
                For the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
                %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
                and at
            %li
              %p
                For the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SL(n,R)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            %li
              %p
                For the trivial group, an
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{e\}
                %span.newWikiWord
                  absolute parallelism
                  %a{:href => "/nlab/new/absolute+parallelism"} ?
                of the manifold.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                      %mi m
                    %annotation{:encoding => "application/x-tex"} n = 2 m
                even, a
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} GL(m, \mathbb{C})
                %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
                on the manifold. It must satisfy an integrability condition to be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
          %h3#lift_of_tangent_bundle_structure Lift of tangent bundle structure
          %p An example for a lift of structure groups is
          %ul
            %li
              for the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi spin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} spin(n)
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
          %p This continues with lifts to the
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/string+group"} string group
                giving
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fivebrane+group"} fivebrane group
                giving
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fivebrane+structure"} fivebrane structure
          %h3#ExamplesOfReductionsOfNonTangentBundles Reduction of more general bundle structure
          %ul
            %li
              %p
                For general
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo →
                        %mi K
                      %annotation{:encoding => "application/x-tex"} G \to K
                %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
                involves
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "-principal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            %li
              %p
                A
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi n
                        %mo ,
                        %mn 2
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(n,n) \hookrightarrow O(2n,2n)
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+complex+structure"} generalized complex structure
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo →
                      %msub
                        %mi E
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n \to E_{n(n)}
                the inclusion of the
                %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
                into the
                %a.existingWikiWord{:href => "/nlab/show/split+real+form"} split real form
                of an
                = succeed "," do
