          %h2#references References
          %h3#traditional Traditional
          %p
            The concept originates around the work of
            %a.existingWikiWord{:href => "/nlab/show/Eli+Cartan"} Eli Cartan
            (
            %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"}> Cartan geometry
            ) and
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Shiing-Shen+Chern"}> Shiing-Shen Chern
              ,
              = succeed "," do
                %em The geometry of G-structures
              = succeed "," do
                %a{:href => "http://www.ams.org/journals/bull/1966-72-02/S0002-9904-1966-11473-8/S0002-9904-1966-11473-8.pdf"} pdf
              = succeed ")" do
                %a{:href => "http://projecteuclid.org/euclid.bams/1183527777"} Euclid
          %p Textbook accounts:
          %ul
            %li#Sternberg64
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shlomo+Sternberg"}> Shlomo Sternberg
                , chapter VII of:
                = succeed "," do
                  %em Lectures on differential geometry
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/chel-316"} ams:chel-316
                = succeed "&rbrack;" do
                  %a{:href => "https://archive.org/details/lecturesondiffer0000ster"} ark:/13960/t1pg9dv6k
