                            %mi j
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi f
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mi C
                          %mtd
                            %mi C
                            %mo ⊕
                            %mi D
                          %mtd
                            %munder
                              %mo ←
                              %mrow
                                %msub
                                  %mi i
                                  %mi D
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; F &amp; &amp; \\
                    \&amp; &amp; \downarrow j &amp; &amp; \\
                    \&amp; &amp; X &amp; &amp; \\
                    \&amp; &amp; \downarrow f &amp; &amp; \\
                    C &amp; \underset{i_C}{\to} &amp; C \oplus D &amp; \underset{i_D}{\leftarrow} &amp; D
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an arbitrary coalgebra map and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi F
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j: F \hookrightarrow X
              is a finite-dimensional subcoalgebra inclusion. We will show that the pullback of the coproduct diagram along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi j
                  %annotation{:encoding => "application/x-tex"} f \circ j
              is a coproduct decomposition of
