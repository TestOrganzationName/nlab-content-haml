          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#colimits"} Colimits
              %li
                %a{:href => "#local_presentability"} Local presentability
              %li
                %a{:href => "#totality_and_completeness"} Totality and completeness
              %li
                %a{:href => "#cartesian_closure"} Cartesian closure
              %li
                %a{:href => "#comonadicity_over_"}
                  Comonadicity over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} R Mod
              %li
                %a{:href => "#extensivity"} Extensivity
              %li
                %a{:href => "#references"} References
          %p
            This page describes some nice properties of the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            of
            %a.existingWikiWord{:href => "/nlab/show/cocommutative+coalgebra"} cocommutative
            %a.existingWikiWord{:href => "/nlab/show/coalgebras"} coalgebras
            over a
            %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lextensive+category"} lextensive
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generating+set"} generating set
          %p
            In the sequel, we will simply say “coalgebra”, although we really mean
            %em cocommutative
            (coassociative, counital) coalgebra.
          %h2#colimits Colimits
          %p
            Colimits in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            are created (reflected) by the forgetful functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi R
                    %mi Cocomm
                    %mi Coalg
                    %mo →
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} U: R Cocomm Coalg \to R Mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi D
                %annotation{:encoding => "application/x-tex"} C, D
            is the direct sum module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊕
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \oplus D
            equipped with the evident comultiplication
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊕
                    %mi D
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊗
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ⊗
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊕
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊕
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \oplus D \to (C \otimes C) \oplus (D \otimes D) \hookrightarrow (C \oplus D) \otimes (C \oplus D)
          %p
            It is perhaps well to point out explicitly that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f: C \to D
            is a coalgebra map, then the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(C)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
            inherits a coalgebra structure from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and provides the image in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Cocomm
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(C \otimes C) = f(C) \otimes f(C)
            as submodules of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ⊗
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D \otimes D
          %h2#local_presentability Local presentability
          %p
            Most of the nice properties can be derived as consequences of the
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} local presentability
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Cocomm
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            = succeed "." do
              %a{:href => "#Porst"} Porst
          %p
            In the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            is locally finitely presentable. The finitely presentable objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            are those coalgebras that are
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
          .num_theorem
            %h6#theorem Theorem
            %p
              Every coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the union of its finite-dimensional subcoalgebras, i.e., is the
              %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
              of the system of finite-dimensional subcoalgebras of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and inclusion maps between them.
          %p
            (For the nonce, we define “subcoalgebra” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to mean vector subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi V
                  %mo ↪
                  %mi C
                %annotation{:encoding => "application/x-tex"} i: V \hookrightarrow C
            such that the restricted comultiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi C
                  %mo ∘
                  %mi i
                %annotation{:encoding => "application/x-tex"} \delta_C \circ i
            is contained in the subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊗
                  %mi V
                %annotation{:encoding => "application/x-tex"} V \otimes V
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊗
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C \otimes C
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            in the sense of equivalence classes of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
          .num_prop
            %h6#proposition Proposition
            %p
              Every finite-dimensional coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is finitely presentable, i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi k
                    %mi Cocomm
                    %mi Coalg
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \hom(C, -): k Cocomm Coalg \to Set
              preserves filtered colimits.
          .proof
            %h6#proof Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %msub
                      %mi colim
                      %mi j
                    %msub
                      %mi D
                      %mi j
                  %annotation{:encoding => "application/x-tex"} D = colim_j D_j
              is a directed colimit, then the image of a coalgebra map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f: C \to D
              is a finite-dimensional subcoalgebra inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f(C) \to D
              which, as a finitely presentable vector space, is included in one of the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi j
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D_j \to D
              of the colimit cone; this inclusion is a subcoalgebra inclusion.
          %p
            It follows easily from these results and cocompleteness of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            is locally finitely presentable. As a result we have a
            %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer
            equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                  %mo ≃
                  %mi Lex
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mi Cocomm
                  %msubsup
                    %mi Coalg
                    %mi fd
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg \simeq Lex(k Cocomm Coalg_{fd}^{op}, Set)
          %p where the category of finite-dimensional coalgebras is dual to the category of finite-dimensional algebras, so that also
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                  %mo ≃
                  %mi Lex
                  %mo{:stretchy => "false"} (
                  %mi Comm
                  %msub
                    %mi Alg
                    %mi fd
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg \simeq Lex(Comm Alg_{fd}, Set).
          %p
            Naturally, choosing a representative of each isomorphism class of finite-dimensional coalgebras, we obtain a generating set of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mi Cocomm
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
          %h2#totality_and_completeness Totality and completeness
          %p
            As is the case for any locally presentable category,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            is not only cocomplete but is a
            %a.existingWikiWord{:href => "/nlab/show/total+category"} totally cocomplete category
            and is (therefore)
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            as well.
          %p
            The construction of
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            can be described explicitly. The
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of two coalgebra maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi C
                  %mover
                    %mo →
                    %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f, g: C \stackrel{\to}{\to} D
            is the largest subcoalgebra contained in the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
            equalizer (the latter coincides with the equalizer as computed in
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sweedler+notation"} Sweedler notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                %annotation{:encoding => "application/x-tex"} f, g
            is the set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi c
                  %mo ∈
                  %mi C
                  %mo :
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} E = \{c \in C: c_{(1)} \otimes f(c_{(2)}) \otimes c_{(3)} = c_{(1)} \otimes g(c_{(2)}) \otimes c_{(3)}\}
          %p
            with the unique structure of coalgebra that makes it a subcoalgebra of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Assuming the construction of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/cofree+coalgebra"} cofree cocommutative coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %mi R
                  %mi Mod
                  %mo →
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} K: R Mod \to R Cocomm Coalg
            to the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                  %mo →
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} U: R Cocomm Coalg \to R Mod
            (which we also touch on below), the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            of a family of coalgebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi i
                %annotation{:encoding => "application/x-tex"} C_i
            can be described as follows. Consider the product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi C
                    %mi i
                %annotation{:encoding => "application/x-tex"} \prod_i C_i
            taken in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi U
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi C
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi C
                    %mi i
                %annotation{:encoding => "application/x-tex"} p: U K(\prod_i C_i) \to \prod_i C_i
            be the component of the counit of the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊣
                  %mi K
                %annotation{:encoding => "application/x-tex"} U \dashv K
            at that product. Then the product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi i
                %annotation{:encoding => "application/x-tex"} C_i
            taken in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            is the largest subcoalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mi C
                  %mo ↪
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi C
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j: C \hookrightarrow K(\prod_i C_i)
            such that each composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                  %mi p
                  %mi j
                  %mo :
                  %mi C
                  %mo →
                  %msub
                    %mi C
                    %mi i
                %annotation{:encoding => "application/x-tex"} \pi_i p j: C \to C_i
            is a coalgebra map. For a proof, see the
            %a{:href => "#Agore"} article
            by Agore.
          %h2#cartesian_closure Cartesian closure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            of two coalgebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi D
                %annotation{:encoding => "application/x-tex"} C, D
            is given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \otimes D
            with the evident coalgebra structure. The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo :
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                  %mo →
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} C \otimes -: R Cocomm Coalg \to R Cocomm Coalg
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo :
                  %mi R
                  %mi Mod
                  %mo →
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} C \otimes -: R Mod \to R Mod
            is cocontinuous there.
          %p
            For locally presentable or more generally total categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} F: \mathbf{C} \to \mathbf{C}
            is enough to guarantee that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            has a right adjoint. It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            is cartesian closed.
          %h2#comonadicity_over_
            Comonadicity over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
          %p
            Again, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                  %mo →
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} U: R Cocomm Coalg \to R Mod
            is cocontinuous and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} R Cocomm Coalg
            is locally presentable,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has a right adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cofree+coalgebra"} cofree cocommutative coalgebra
          %p
            The comonadicity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is proven in the
            %a{:href => "#Barr"} article
            by Barr, section 4.
          %h2#extensivity Extensivity
          %p
            We will show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Cocomm
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} k Cocomm Coalg
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lextensive+category"} lextensive category
          .num_prop
            %h6#proposition_2 Proposition
            %p Coproducts of coalgebras are disjoint.
          .proof
            %h6#proof_2 Proof
            %p
              The coproduct of coalgebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ,
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C, D
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ⊕
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C \oplus D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi C
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                    %mo ⊕
                    %mi D
                    %mo ,
                    %msub
                      %mi i
                      %mi D
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                    %mo ⊕
                    %mi D
                  %annotation{:encoding => "application/x-tex"} i_C: C \to C \oplus D, i_D: D \to C \oplus D
              is the coalgebra equalizer of the two maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
