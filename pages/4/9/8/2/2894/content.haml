                            %mo ⊗
                            %mi D
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                            %mo ⊕
                            %mi D
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
