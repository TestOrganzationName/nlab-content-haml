                          %mo{:stretchy => "false"} (
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          N_Q(c) := Hom_C(Q(-),c) : k \mapsto Hom_C(Q(k),c)
                %li
                  %p
                    and the realization functor is given by the
                    %a.existingWikiWord{:href => "/nlab/show/coend"} coend
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi F
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi Q
                          %mo :
                          %mo =
                          %msup
                            %mo ∫
                            %mrow
                              %mi k
                              %mo ∈
                              %mi K
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          |F|_Q := \int^{k \in K} Q(k)\cdot F(k)
                          
                          \\,,
                  %p
                    where in the integrand we have the canonical
                    %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                    over
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi s
                              %mo ∈
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Q(k) \cdot F(k) = \coprod_{s \in F(k)} Q(k)
                    ).
              %p
                A famous examples of this is obtained for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                    %annotation{:encoding => "application/x-tex"} C =
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo =
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} K = \Delta
                the
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo :
                      %mi Δ
                      %mo →
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Q : \Delta \to Top
                the functor that sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
                to the standard topological
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
                %a.existingWikiWord{:href => "/nlab/show/fundamental+infinity-groupoid"} singular simplicial complex
                functor and the realization is ordinary
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
          %h2#RelatedConcepts Related concepts
          %ul
            %li
              %p
                %strong> adjoint functor
                ,
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/strong+adjoint+functor"} strong adjoint functor
                %li#RelatedSelfAdjointFunctor
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/self-adjoint+functor"} self-adjoint functor
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"}> adjoint triple
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
                    %a.existingWikiWord{:href => "/nlab/show/recollement"} recollement
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/dual+adjunction"} dual adjunction
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/adjunction+of+two+variables"} adjunction of two variables
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous adjunction
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+monad"} adjoint monad
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed point of an adjunction
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/enriched+adjunction"} enriched adjunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/transformation+of+adjoints"} transformation of adjoints
              %p
                %a.existingWikiWord{:href => "/nlab/show/CatAdj"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cat
                          %mi Adj
                      %annotation{:encoding => "application/x-tex"} Cat_{Adj}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/proadjoint"}> proadjoint
                ,
                %a.existingWikiWord{:href => "/nlab/show/Hopf+adjunction"} Hopf adjunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
              %p
                %a.existingWikiWord{:href => "/nlab/show/adjoint+2-functor"}> adjoint 2-functor
                ,
                %a.existingWikiWord{:href => "/nlab/show/strict+adjoint+2-functor"} strict adjoint 2-functor
              %p
                %a.existingWikiWord{:href => "/nlab/show/biadjunction"}> biadjunction
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/lax+2-adjunction"} lax 2-adjunction
                %a.existingWikiWord{:href => "/nlab/show/pseudoadjunction"} pseudoadjunction
            %li
              %p
