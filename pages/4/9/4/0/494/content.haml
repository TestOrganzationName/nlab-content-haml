                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \epsilon_{B}:U(F(B)) \rightarrow B
            %h4#CategoryOfAdjunctionResolutionsOfAMonad Category of adjunction-resolutions of a monad
            %p
              An adjunction inducing a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              (as
              = succeed ")" do
                %a{:href => "#MonadInducedByAnAdjunction"} above
              = succeed "." do
                %em
                  resolution of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %p
              There is in general more than one such resolution, in fact there is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of adjunctions for a given monad whose morphisms are “
              %a.existingWikiWord{:href => "/nlab/show/comparison+functors"}> comparison functors
              ” (eg.
              = succeed ")." do
                %a{:href => "#MacLane71"} MacLane 1971, §VI.3
            %p In this category:
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  is the adjunction over the
                  %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
                  of the monad;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  is that over the
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
                  of algebras, also called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/monadic+adjunction"} monadic adjunction
                  (recognized by
                  = succeed ")." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/monadicity+theorems"} monadicity theorems
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "monad#Borceux94"} Borceux 1994, vol. 2, prop. 4.2.2
            %h4#SemanticsStructureAdjunction Semantics-structure adjunction
            %p
              The above passage from
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              to
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
              and back to their
              %a.existingWikiWord{:href => "/nlab/show/monadic+adjunctions"} monadic adjunctions
              constitutes itself an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/semantics-structure+adjunction"} semantics-structure adjunction
          %h3#opposite_adjoint_functors Opposite adjoint functors
          %p
            Given a pair of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi R
                    %mover
                      %mo ⟵
                      %mi L
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{D}
                  \\underoverset
                  {\underset{R}{\longrightarrow}}
                  {\overset{L}{\longleftarrow}}
                  {\;\;\;\;\bot\;\;\;\;}
                  \\mathcal{C}
          %p
            there is an induced
            %em
              %a.existingWikiWord{:href => "/nlab/show/opposite+adjunction"} opposite adjunction
            of
            %a.existingWikiWord{:href => "/nlab/show/opposite+functors"} opposite functors
            between their
            %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mi op
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟵
                      %mrow
                        %msup
                          %mi L
                          %mi op
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi R
                          %mi op
                  %msup
                    %mi 𝒞
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{D}^{op}
                  \\underoverset
                  {\underset{L^{op}}{\longleftarrow}}
                  {\overset{R^{op}}{\longrightarrow}}
                  {\;\;\;\;\bot\;\;\;\;}
                  \\mathcal{C}^{op}
                  \\,.
          %p
            Hence where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            was the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/opposite+functor"} opposite
            becomes the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            This is immediate from the definition of
            %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
            and the characterization of adjoint functors via the corresponding
            = succeed "." do
              %a{:href => "#InTermsOfHomIsomorphism"} hom-isomorphism
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
            of the opposite adjunction has as components the components of the original
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ϵ
                    %mi c
                    %mrow
                      %msup
                        %mi R
                        %mi op
                      %msup
                        %mi L
                        %mi op
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi R
                    %mi op
                  %mo ∘
                  %msup
                    %mi L
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msubsup
                        %mi η
                        %mi c
                        %mrow
                          %mi R
                          %mi L
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi op
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mphantom
                    %mi AAAAAA
                  %msubsup
                    %mi η
                    %mi d
                    %mrow
                      %msup
                        %mi L
                        %mi op
                      %msup
                        %mi R
                        %mi op
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msubsup
                        %mi ϵ
                        %mi d
                        %mrow
                          %mi L
                          %mi R
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi op
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %msup
                    %mi L
                    %mi op
                  %mo ∘
                  %msup
                    %mi R
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\epsilon^{R^{op} L^{op}}_{c}
                  \\;\colon\;
                  R^{op}\circ L^{op}(c)
                  \\xrightarrow{\;\;  \big( \eta^{R L}_c \big) ^{op}  \;\;}
                  c
                  \\,,
                  {\phantom{AAAAAA}}
                  \\eta^{L^{op} R^{op}}_{d}
                  \\;\colon\;
                  d
                  \\xrightarrow{\;\;  \big( \epsilon^{L R}_d \big) ^{op}  \;\;}
                  L^{op} \circ R^{op}(d)
                  \\,.
          %h3#composing_adjunctions Composing adjunctions
          %p
            Given two pairs of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
