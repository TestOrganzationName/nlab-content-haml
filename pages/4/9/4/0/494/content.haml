          .proof
            %h6#proof_7 Proof
            %p
              For the characterization of faithful
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              by epi counit components, notice (as discussed at
              %em
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              ) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                    %mi x
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} L R x \to x
              being an epimorphism is equivalent to the induced
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi R
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(x, a) \to Hom(L R x, a)
            %p
              being an
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              for all objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi R
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi x
                    %mo ,
                    %mi R
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(L R x , a ) \stackrel{\simeq}{\to} Hom(R x, R a)
            %p
              and that, by the formula for
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              and the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zig-zag+identity"} zig-zag identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mrow
                        %mi x
                        %mo ,
                        %mi a
                    %mo :
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi R
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi x
                    %mo ,
                    %mi R
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    R_{x,a} :  Hom(x,a) \to Hom(L R x, a) \stackrel{\simeq}{\to}
                    Hom(R x, R a)
            %p
              is the component map of the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (
              %a{:href => "geometry+of+physics+–+basic+notions+of+category+theory#ReExpressingMiddleFunctorInAdjointTriple"}> this Prop.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mover
                              %mo →
                              %mi f
                            %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mi R
                            %mi x
                            %mo →
                            %mi x
                            %mover
                              %mo →
                              %mi f
                            %mi a
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi L
                            %mi R
                            %mi x
                            %mo →
                            %mi R
                            %mi x
                            %mover
                              %mo →
                              %mrow
                                %mi R
                                %mi f
                            %mi R
                            %mi a
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi x
                            %mo →
                            %mi R
                            %mi L
                            %mi R
                            %mi x
                            %mo →
                            %mi R
                            %mi x
                            %mover
                              %mo →
                              %mrow
                                %mi R
                                %mi f
                            %mi R
                            %mi a
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi x
                            %mover
                              %mo →
                              %mrow
                                %mi R
                                %mi f
                            %mi R
                            %mi a
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (x \stackrel{f}{\to} a) &amp; \mapsto
                    (L R x \to x \stackrel{f}{\to} a)
                    \\\
                    \&amp; \mapsto
                    (R L R x \to R x \stackrel{R f}{\to} R a)
                    \\\
                    \&amp; \mapsto
                    (R x \to R L R x \to R x \stackrel{R f}{\to} R a)
                    \\\
                    \&amp; = (R x \stackrel{R f}{\to} R a)
                    \\end{aligned}
                    \\,.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mrow
                        %mi x
                        %mo ,
                        %mi a
                  %annotation{:encoding => "application/x-tex"} R_{x,a}
              is injective for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi a
                    %annotation{:encoding => "application/x-tex"} x,a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is faithful, precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                    %mi x
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} L R x \to x
              is an epimorphism for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              full is just the same reasoning applied to the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi L
                    %mi R
                    %mi x
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \epsilon_x \colon L R x \to x
              is a
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
              iff for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              the induced function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi R
                    %mi x
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(x, a) \to Hom(L R x, a)
            %p is a surjection.
            %p
              For the characterization of faithful
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              by monic units notice that analogously (as discussed at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi R
                    %mi L
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \to R L x
              is a monomorphism if for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi R
                    %mi L
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(a,x ) \to Hom(a, R L x)
            %p is an injection. Analogously to the previous argument we find that this is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi a
                        %mo ,
                        %mi x
                    %mo :
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi R
                    %mi L
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi a
                    %mo ,
                    %mi L
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L_{a,x} : Hom(a,x ) \to Hom(a, R L x) \stackrel{\simeq}{\to} Hom(L a, L x)
            %p
              being an injection. So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is faithful precisely if all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi R
                    %mi L
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \to R L x
              are monos. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              full, it’s just the same applied to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi R
                    %mi L
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \to R L x
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
              iff the induced function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi R
                    %mi L
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(a,x ) \to Hom(a, R L x)
            %p
              is a surjection, for all objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p The proof of the other statements proceeds analogously.
          %p Parts of this statement can be strengthened:
          #ReflectionRecognizedByIdempotency.num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) : D \to C
              be a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              such that there is
              %em any
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                    %mo ≃
                    %mi Id
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    L R \simeq Id
                    \\,,
            %p
              then also the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi L
                    %mi R
                    %mo →
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} \epsilon : L R \to Id
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, lemma 1.1.1
            ).
          .proof
            %h6#proof_8 Proof
            %p
              Using the given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L R
              to a comonad structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi D
                    %annotation{:encoding => "application/x-tex"} Id_D
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
              the
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+monoid"} endomorphism monoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
                      %mi D
                  %annotation{:encoding => "application/x-tex"} Id_D
              is commutative. Therefore, since the comultiplication of the comonad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
                      %mi D
                  %annotation{:encoding => "application/x-tex"} Id_D
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              to the counit (by the co-
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
              property applied to this degenerate situation), it is in fact a two-sided
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              and hence the
              = succeed "-counit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi D
                    %annotation{:encoding => "application/x-tex"} Id_D
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L \dashv R)
              is an isomorphism.
          %h3#PointwiseExpression Pointwise expression
          #PointwiseExpressionOfLeftAdjoints.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (pointwise expression of
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
                in terms of
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/comma+categories"} comma categories
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} R \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L \;\colon\; \mathcal{D} \longrightarrow \mathcal{C}
              precisely if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                  all
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  that exist in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo ∈
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of the canonical functor out of the
                  %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} /
                        %mi R
                        %mo ⟶
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"}
                        d/R \longrightarrow \mathcal{C}
                %p exists.
            %p
              In this case the value of the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is given by that limit:
            #eq:FormulaForLeftAdjointByPointwiseLimit.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟵
                        %mrow
                          %mrow
                            %mo (
                            %mi c
                            %mo ,
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi d
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mpadded{:width => "0"}
                                        %mi f
                                %mtr
                                  %mtd
                                    %mi R
                                    %mo{:stretchy => "false"} (
                                    %mi c
                                    %mo{:stretchy => "false"} )
                            %mo )
                          %mo ∈
                          %mi d
                          %mo{:stretchy => "false"} /
                          %mi R
                    %mi c
                  %annotation{:encoding => "application/x-tex"}
                    L(d)
                    \\;\simeq\;
                    \\underset{\underset{ \left( c,  \array{ d \\ \downarrow^{\mathrlap{f}} \\ R(c) } \right)  \in d/R }{\longleftarrow}}{\lim} c
          %p
            (e.g.
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Categories+Work"} MacLane, chapter X, theorem 2
          .proof
            %h6#proof_9 Proof
            %p First assume that the left adjoint exist. Then
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  and hence preserves limits since all
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} right adjoints preserve limits
              %li
                %p
                  by Prop.
                  %a.maruku-ref{:href => "#CollectionOfUniversalArrowsEquivalentToAdjointFunctor"}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                  provides a
                  %a.existingWikiWord{:href => "/nlab/show/universal+morphism"} universal morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \eta_d
                  into
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} L(d)
                  = succeed "," do
                    %a.maruku-ref{:href => "#UniversalMorphismsAreInitialObjectsInCommaCategory"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi η
                          %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L(d), \eta_d)
                  as the
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo{:stretchy => "false"} /
                          %mi R
                        %annotation{:encoding => "application/x-tex"} d/R
            %p
              Conversely, assume that the two conditions are satisfied and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(d)
              be given by
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:FormulaForLeftAdjointByPointwiseLimit"} (9)
            %p
              By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves all limits that exist, we have
            #eq:RAppliedtoFormulaForLeftAdjointByPointwiseLimit.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi R
                            %mrow
                              %mo (
                              %munder
                                %mi lim
                                %munder
                                  %mo ⟵
                                  %mrow
                                    %mrow
                                      %mo (
                                      %mi c
                                      %mo ,
                                      %mrow
                                        %mtable
                                          %mtr
                                            %mtd
                                              %mi d
                                          %mtr
                                            %mtd
                                              %msup
                                                %mo{:stretchy => "false"} ↓
                                                %mpadded{:width => "0"}
                                                  %mi f
                                          %mtr
                                            %mtd
                                              %mi R
                                              %mo{:stretchy => "false"} (
                                              %mi c
                                              %mo{:stretchy => "false"} )
                                      %mo )
                                    %mo ∈
                                    %mi d
                                    %mo{:stretchy => "false"} /
                                    %mi R
                              %mi c
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %munder
                                %mo ⟵
                                %mrow
                                  %mrow
                                    %mo (
                                    %mi c
                                    %mo ,
                                    %mrow
                                      %mtable
                                        %mtr
                                          %mtd
                                            %mi d
                                        %mtr
                                          %mtd
                                            %msup
                                              %mo{:stretchy => "false"} ↓
                                              %mpadded{:width => "0"}
                                                %mi f
                                        %mtr
                                          %mtd
                                            %mi R
                                            %mo{:stretchy => "false"} (
                                            %mi c
                                            %mo{:stretchy => "false"} )
                                    %mo )
                                  %mo ∈
                                  %mi d
                                  %mo{:stretchy => "false"} /
                                  %mi R
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    R(L(d))
                    \&amp; =
                    R\left(
                    \\underset{\underset{ \left( c,  \array{ d \\ \downarrow^{\mathrlap{f}} \\ R(c) } \right)  \in d/R }{\longleftarrow}}{\lim} c
                    \\right)
                    \\\
                    \&amp; \simeq
                    \\underset{\underset{ \left( c,  \array{ d \\ \downarrow^{\mathrlap{f}} \\ R(c) } \right)  \in d/R }{\longleftarrow}}{\lim} R(c)
                    }
            %p
              Since the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mover
                      %mo →
                      %mi f
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \overset{f}{\to} R(d)
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              over the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %msub
                          %mi η
                          %mi d
                        %mphantom
                          %mi AA
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \overset{\phantom{AA} \eta_d \phantom{AA}}{\longrightarrow} R(L(d))
                    \\,.
            %p
              By Prop.
              %a.maruku-ref{:href => "#CollectionOfUniversalArrowsEquivalentToAdjointFunctor"}
              it is now sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \eta_d
              is a
              %a.existingWikiWord{:href => "/nlab/show/universal+morphism"} universal morphism
              into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mover
                      %mo ⟶
                      %mi g
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \overset{g}{\longrightarrow} R(c)
              there is a unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi f
                        %mo ˜
                    %mi c
                  %annotation{:encoding => "application/x-tex"} L(d) \overset{\widetilde f}{\longrightarrow} c
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi d
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mi d
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi f
                                  %mo ˜
                                %mo{:stretchy => "false"} )
                                %mphantom
                                  %mi AA
                          %mtd
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mover
                                  %mi f
                                  %mo ˜
                                %mphantom
                                  %mi AA
                          %mtd
                          %mtd
                            %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; d
                    \\\
                    \&amp; {}^{\mathllap{ \eta_d }}\swarrow &amp;&amp; \searrow^{\mathrlap{f}}
                    \\\
                    R(L(d)) &amp;&amp; \underset{\phantom{AA}R(\widetilde f)\phantom{AA}}{\longrightarrow} &amp;&amp; R(c)
                    \\\
                    L(d)
                    \&amp;&amp;\underset{\phantom{AA}\widetilde f\phantom{AA}}{\longrightarrow}&amp;&amp;
                    c
                    }
            %p
              By Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#UniversalMorphismsAreInitialObjectsInCommaCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L(d), \eta_d)
              being the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mi R
                    %annotation{:encoding => "application/x-tex"} c/R
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              of the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} c/R
              (
              %a{:href => "initial+object#LimitOverIdentityFunctorIsInitialObject"}> this prop.
              ). But this follows directly from the limit formulas
              %a.maruku-eqref{:href => "#eq:FormulaForLeftAdjointByPointwiseLimit"} (9)
              and
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:RAppliedtoFormulaForLeftAdjointByPointwiseLimit"} (10)
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            for more.
          %div
            %h3#RelationBetweenAdjunctionsAndMonads Relation between adjunctions and monads
            %p
              There is a close relation between
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              (
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"}> adjoint functors
              ) and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            %ul
              %li
                %p
                  %a{:href => "#MonadInducedByAnAdjunction"} Monad induced by an adjunction
              %li
                %p
                  %a{:href => "#CategoryOfAdjunctionResolutionsOfAMonad"} Category of adjunction-resolutions of a monad
              %li
                %p
                  %a{:href => "#SemanticsStructureAdjunction"} Semantics-Structure adjunction
            %h4#MonadInducedByAnAdjunction Monad induced by an adjunction
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L \dashv R)
              induces a
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} R \circ L
              and a
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∘
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L \circ R
            %p
              (
              %a{:href => "monad#Huber61"}> Huber 1961, §4
              ; see eg.
              = succeed ";" do
                %a{:href => "monad#MacLane71"} MacLane 1971, §VI.1 (p 134)
              = succeed ")." do
                %a{:href => "monad#Borceux94"} Borceux 1994, vol. 2, prop. 4.2.1
            %p In detail:
            %p
            .num_prop
              %h6 Proposition
              %p
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mi 𝒟
                      %mo ,
                      %mi F
                      %mo ,
                      %mi U
                      %mo ,
                      %mi η
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C},\mathcal{D},F,U,\eta,\epsilon)
                be a pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                ie
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊣
                      %mi U
                    %annotation{:encoding => "application/x-tex"} F \dashv U
                are adjoint functors where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \rightarrow \mathcal{D}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒟
                        %mo →
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} U \colon\mathcal{D} \rightarrow \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi A
                      %mo :
                      %mi A
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_{A}:A \rightarrow U(F(A))
                is the
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mi B
                      %mo{:lspace => "verythinmathspace"} :
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \epsilon_{B} \colon F(U(B)) \rightarrow B
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ∘
                          %mi F
                        %annotation{:encoding => "application/x-tex"} U \circ F
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                    on
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                        %annotation{:encoding => "application/x-tex"} \eta
                    and multiplication
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϵ
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo :
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} U(\epsilon_{F(A)}):U(F(U(F(A)))) \rightarrow U(F(A))
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo ∘
                          %mi U
                        %annotation{:encoding => "application/x-tex"} F \circ U
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                    on
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒟
                          %annotation{:encoding => "application/x-tex"} \mathcal{D}
                    %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϵ
                        %annotation{:encoding => "application/x-tex"} \epsilon
                    and comultiplication
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi η
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mi B
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo :
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} F(\eta_{U(B)}):F(U(B)) \rightarrow F(U(F(U(B))))
              %p
            .proof
              %h6 Proof
              %p
              %p
                We verify that we obtain a monad, the argument for the comonad is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
              %p
                %strong (1)
