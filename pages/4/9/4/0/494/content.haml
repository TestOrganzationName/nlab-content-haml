                        d
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+units"} adjunction units
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi c
                      %annotation{:encoding => "application/x-tex"} \eta_c
                  and
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+counits"} adjunction counits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϵ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \epsilon_d
                  are components of
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Id
                          %mi 𝒞
                        %mo ⇒
                        %mi R
                        %mo ∘
                        %mi L
                      %annotation{:encoding => "application/x-tex"}
                        \\eta \;\colon\; Id_{\mathcal{C}} \Rightarrow R \circ L
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi L
                        %mo ∘
                        %mi R
