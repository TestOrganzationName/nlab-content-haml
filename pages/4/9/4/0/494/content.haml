                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(\epsilon_{F(A)}):U(F(U(F(A)))) \rightarrow U(F(A))
                is obtained by two
                %a.existingWikiWord{:href => "/nlab/show/whiskerings"} whiskerings
                of the counit
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϵ
