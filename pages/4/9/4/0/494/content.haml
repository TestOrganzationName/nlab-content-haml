          .proof
            %h6#proof Proof
            %p
              For the first statement, consider the
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
              %a.maruku-eqref{:href => "#eq:NaturalitySquareForAdjointnessOfFunctors"} (2)
              in the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mrow
                                %mi L
                                %mo{:stretchy => "false"} (
                                %mi c
                                %mo{:stretchy => "false"} )
                            %mo ∈
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒟
                                  %mo{:stretchy => "false"} (
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id_{L(c)}
                    \\in
                    \&amp;
                    Hom_{\mathcal{D}}(L(c), L(c))
                    \&amp;\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c, R(L(c)))
                    \\\
                    \&amp;
                    {}^{\mathllap{Hom_{\mathcal{D}}(L(id), f)}}\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow^{\mathrlap{Hom_{\mathcal{C}}(id, R(f))}}
                    \\\
                    \&amp;
                    Hom_{\mathcal{D}}(L(c), d)
                    \&amp;\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}( c, R(d) )
                    }
            %p
              and consider the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_{L(c_1)}
              in the top left entry. Its image under going down and then right in the diagram is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
