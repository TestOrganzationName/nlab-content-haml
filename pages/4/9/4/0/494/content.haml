                      %mrow
                        %msub
                          %mi η
                          %mi c
                      %annotation{:encoding => "application/x-tex"} \eta_c
                  as the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                #eq:AdjunctFormula.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
