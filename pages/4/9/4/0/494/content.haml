                %path{:d => "M -26.835401 -35.508685 L 28.377083 -35.508685 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.99884,0,0,-0.99884,148.968334,49.884067)"}
                %path{:d => "M -2.488489 2.868602 C -2.030927 1.147856 -1.018033 0.334412 -0.00122881 -0.00191529 C -1.018033 -0.334332 -2.030927 -1.147776 -2.488489 -2.868522 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.99884,0,0,-0.99884,177.552009,85.349649)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "145.865937", "xlink:href" => "#KbMAPcY9AMjI9g_vRu-LLELqb4w=-glyph5-1", :y => "81.836959"}
            %p
              where the horizontal arrows denote the given hom-isomorphisms
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (1)
          This condition is compatible with
          %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal
          and
          %a.existingWikiWord{:href => "/nlab/show/vertical+composition"} vertical composition
          of
          %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
          as
          %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
          in
          %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          and hence yields:
          %p
          #CatAdj.num_defn
            %h6 Definition
            %p
              The (
              %a.existingWikiWord{:href => "/nlab/show/very+large+category"}> very large
              )
              %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide
              and
              %a.existingWikiWord{:href => "/nlab/show/locally+full+sub-2-category"} locally full sub-2-category
              %a.existingWikiWord{:href => "/nlab/show/CatAdj"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cat
                        %mi Adj
                    %annotation{:encoding => "application/x-tex"} Cat_{Adj}
              of
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            #eq:CatAdjInsideCat.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi Adj
                    %mo ⟶
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    Cat_{Adj} \longrightarrow Cat
            %p whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are categories,
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  which are conjugate in the sense of Def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#ConjugateTransformationOfAdjoints"}
            %p
          %p
          .num_prop
            %h6 Proposition
            %p
              Under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibrations"} Grothendieck fibrations
              which arise from
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctors"} pseudofunctors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mo ⟶
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \mathcal{B} \longrightarrow Cat
              that factor through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi Adj
                  %annotation{:encoding => "application/x-tex"} Cat_{Adj}
              %a.maruku-eqref{:href => "#eq:CatAdjInsideCat"} (8)
              are equivalently the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bifibrations"} bifibrations
          This may be
          %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          = succeed ";" do
            %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
          = succeed "." do
            %a{:href => "#HarpazPrasma15"} Harpaz &amp; Prasma (2015), Prop. 2.2.1
          %h2#Properties Properties
          %h3#basic_properties Basic properties
          #UniquenessOfAdjoints.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                are unique up to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              or
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
          .proof
            %h6#proof_5 Proof
            %p
              Suppose the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L \colon \mathcal{D} \to \mathcal{C}
              is given, and we are asking for uniqueness of its right adjoint, if it exists. The other case is directly analogous.
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 1
                    %mo ,
                    %msub
                      %mi R
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} R_1, R_2 \;\colon\; \mathcal{C} \to \mathcal{D}
              are two
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              which are
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
              the corresponding two hom-isomorphisms
              %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (1)
              combine to say that there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_d
                    \\;\colon\;
                    Hom_{\mathcal{C}}(-,R_1(d))
                    \\;\simeq\;
                    Hom_{\mathcal{C}}(-,R_2(d))
            %p
              As in the proof of Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#AdjointFunctorFromObjectwiseRepresentingObject"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_d \;=\; y( \phi_d )
            %p
              for some
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_d \;\colon\;  R_1(d) \overset{\simeq}{\to} R_2(d)
                    \\,.
            %p
              But then the uniqueness statement of Prop.
              %a.maruku-ref{:href => "#AdjointFunctorFromObjectwiseRepresentingObject"}
              implies that the collection of these isomorphisms for each object constitues a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between the functors.
          #AdjointsPreserveCoLimits.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits+and+right+adjoints+preserve+limits"}> left adjoints preserve colimits and right adjoints preserve limits
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) \colon \mathcal{D} \to \mathcal{C}
              be a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                  all
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  that exist in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves all
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{D}
          .proof
            %h6#proof_6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi I
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} y : I \to \mathcal{D}
              be a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              whose
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mrow
                        %msub
                          %mo ←
                          %mi i
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \lim_{\leftarrow_i} y_i
              exists. Then we have a sequence of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x \in C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi R
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mi x
                            %mo ,
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mi x
                            %mo ,
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi R
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %mi R
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{\mathcal{C}}(x, R {\lim_\leftarrow}_i y_i)
                    \&amp;  \simeq
                    Hom_{\mathcal{D}}(L x, {\lim_\leftarrow}_i y_i)
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i Hom_{\mathcal{D}}(L x, y_i)
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i Hom_{\mathcal{C}}( x, R y_i)
                    \\\
                    \&amp; \simeq
                    Hom_{\mathcal{C}}( x, {\lim_\leftarrow}_i R y_i)
                    \\,,
                    \\end{aligned}
            %p
              where we used the hom-isomorphism
              %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (1)
              and the fact that any
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              preserves limits (see there). Because this is natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              implies that we have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mi i
                    %msub
                      %mi y
                      %mi i
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mi i
                    %mi R
                    %msub
                      %mi y
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R {\lim_\leftarrow}_i y_i
                    \\simeq
                    {\lim_\leftarrow}_i R y_i
                    \\,.
            %p
              The argument that shows the preservation of colimits by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is analogous.
          #AdjointFunctorTheorem.num_remark
            %h6#remark_3 Remark
            %p
              A partial converse to Prop.
              %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
              is provided by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              %em
                %a{:href => "#PointwiseExpression"} Pointwise Expression
              below.
          #FullyFaithfulAndInvertibleAdjoints.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \dashv R
              be a pair of adjoint functors (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
                  precisely if the component of the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
                  over every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mi R
                          %mi x
                          %mover
                            %mo →
                            %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} L R x \stackrel{}{\to} x
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is
                  %a.existingWikiWord{:href => "/nlab/show/full+functor"} full
                  precisely if the component of the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
                  over every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mi R
                          %mi x
                          %mover
                            %mo →
                            %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} L R x \stackrel{}{\to} x
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
                  precisely if the component of the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                  over every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ↪
                          %mi R
                          %mi L
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x \hookrightarrow R L x
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is
                  %a.existingWikiWord{:href => "/nlab/show/full+functor"} full
                  precisely if the component of the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                  over every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo →
                          %mi R
                          %mi L
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x \to R L x
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
                  (exhibits a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo :
                        %mi L
                        %mo ∘
                        %mi R
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi Id
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \epsilon : L \circ R \stackrel{\simeq}{\to} Id_D
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
                  (exhibits a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                  is a natural isomorphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo :
                          %msub
                            %mi Id
                            %mi C
                          %mover
                            %mo →
                            %mo ≃
                          %mi R
                          %mo ∘
                          %mi L
                        %annotation{:encoding => "application/x-tex"} \eta : Id_C \stackrel{\simeq}{\to} R \circ L
              %li
                %p The following are equivalent:
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi L
                          %annotation{:encoding => "application/x-tex"} L
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi R
                          %annotation{:encoding => "application/x-tex"} R
                      are both
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi L
                          %annotation{:encoding => "application/x-tex"} L
                      is an
                      = succeed ";" do
