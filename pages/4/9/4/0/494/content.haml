                    %annotation{:encoding => "application/x-tex"} \widetilde f
              = succeed "." do
                %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi η
                        %mi c
                    %annotation{:encoding => "application/x-tex"} R(f)\circ \eta_{c}
              = succeed "." do
                %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p The converse formula follows analogously.
            %p
              The third statement follows directly from this by applying these formulas for the
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              twice and using that the result must be the original morphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mrow
                                %mi L
                                %mo{:stretchy => "false"} (
                                %mi c
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mover
                              %mover
                                %mrow
                                  %msub
                                    %mi id
                                    %mrow
                                      %mi L
                                      %mo{:stretchy => "false"} (
                                      %mi c
                                      %mo{:stretchy => "false"} )
                                %mo ˜
                              %mo ˜
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mrow
