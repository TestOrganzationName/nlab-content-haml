                  %annotation{:encoding => "application/x-tex"} \eta_c
              and
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counits"} adjunction counits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \epsilon_d
              according to Def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralAdjunctsInTermsOfAdjunctionUnitCounit"}
            %p Then
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde f
                  of any morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
