                        %mo ˜
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{D}}(L(c),d)
                    \\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}
                    Hom_{\mathcal{C}}(c,R(d))
            %p
              such that for each
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
