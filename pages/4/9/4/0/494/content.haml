                    %annotation{:encoding => "application/x-tex"} g \;\colon\; c_2 \to c_1
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            #eq:HalfNaturalitySquareForAdjointnessOfFunctors.maruku-equation
              %span.maruku-eq-number (5)
