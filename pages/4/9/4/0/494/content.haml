            in terms of a
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            between
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            (Def.
            %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
            below):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
