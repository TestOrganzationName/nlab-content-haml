                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p^* : [K',C] \to [K,C]
                between
                %a.existingWikiWord{:href => "/nlab/show/functor+categories"} functor categories
                obtained by precomposition with a functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi K
                      %mo →
                      %mi K
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} p : K \to K'
                of
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                categories are called the left and right
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                functors along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
