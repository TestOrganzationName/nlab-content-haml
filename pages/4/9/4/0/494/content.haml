                %path{:d => "M -2.488452 2.867624 C -2.031421 1.148874 -1.019702 0.336374 -0.00017125 0.00043625 C -1.019702 -0.335501 -2.031421 -1.148001 -2.488452 -2.870658 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 80.51189, 25.49653)"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "48.888", "xlink:href" => "#upuvtqHIw0KcncvdOXDCzqOHCJI=-glyph-1-1", :y => "35.82"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "48.789", "xlink:href" => "#upuvtqHIw0KcncvdOXDCzqOHCJI=-glyph-2-1", :y => "21.98"}
                %path{:d => "M 29.446 4.606031 L -25.764937 4.606031 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 51.304, 18.149)"}
                %path{:d => "M -2.486386 2.868926 C -2.033261 1.14627 -1.021543 0.33377 0.001895 0.00173875 C -1.021543 -0.334199 -2.033261 -1.146699 -2.486386 -2.869355 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(-1, 0, 0, 1, 25.29877, 13.54123)"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "49.306", "xlink:href" => "#upuvtqHIw0KcncvdOXDCzqOHCJI=-glyph-1-2", :y => "10.025"}
            %p
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-functors"} hom-functors
              of the following form:
            #eq:HomIsomorphismForAdjointFunctors.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒟
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{D}}\big(L(-),\,-\big)
                    \\;\simeq\;
                    Hom_{\mathcal{C}}\big(-,\,R(-)\big)
                    \\,.
            %p
              This means that for all
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo →
                              %mi f
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mover
                              %mo →
                              %mover
                                %mi f
                                %mo ˜
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{D}}(L(c),d)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c,R(d))
                    \\\
                    ( L(c) \overset{f}{\to} d )
                    \&amp;\mapsto&amp;
                    (c \overset{\widetilde f}{\to} R(d))
                    }
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %strong adjunction isomorphism
              and the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde f
              of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              under this bijections is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is called the adjunct of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo ˜
                    %annotation{:encoding => "application/x-tex"} \widetilde f
            %p
              Naturality here means that for every
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi c
                      %mn 2
                    %mo →
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g \colon c_2 \to c_1
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and for every
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h\colon d_1\to d_2
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
            #eq:NaturalitySquareForAdjointnessOfFunctors.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒟
                                  %mo{:stretchy => "false"} (
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi h
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo ,
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi h
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi d
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{D}}(L(c_1), d_1)
                    \&amp;\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c_1, R(d_1))
                    \\\
                    {}^{\mathllap{Hom_{\mathcal{D}}(L(g), h)}}\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow^{\mathrlap{Hom_{\mathcal{C}}(g, R(h))}}
                    \\\
                    Hom_{\mathcal{D}}(L(c_2),d_2)
                    \&amp;\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c_2,R(d_2))
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commutes
              (see also at
              %em
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              for the definition of the vertical maps here).
            %p
              Explicitly, this commutativity, in turn, means that for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; L(c_1) \to d_1
              with
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo ˜
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi c
                        %mn 1
                      %mo →
                      %mi R
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widetilde f \;\colon\; c_1 \to R(d_1)
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msub
                              %mi d
                              %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo ˜
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi h
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                          %mtd
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 2
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L(c_1) &amp; \overset{f}{\longrightarrow} &amp; d_1
                    \\\
                    {}^{\mathllap{L(g)}}\big\uparrow &amp;&amp; \big\downarrow^{\mathrlap{h}}
                    \\\
                    L(c_2) &amp;&amp; d_2
                    }
                    \\;\;\;=\;\;\;
                    \\array{
                    c_1 &amp;\overset{\widetilde f}{\longrightarrow}&amp; R(d_1)
                    \\\
                    {}^{\mathllap{g}}\big\uparrow &amp;&amp; \big\downarrow^{\mathrlap{R(h)}}
                    \\\
                    c_2 &amp;&amp; R(d_2)
                    }
          #AdjunctionUnitFromHomIsomorphism.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                and
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} counit
                in terms of hom-isomorphism)
            %p
              Given a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi L
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}{\overset{L}{\longleftarrow}}{\bot}
                    \\mathcal{C}
            %p
              according to Def.
              %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              one says that
            %ol
              %li
                %p
                  for any
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(c)
                  is the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit morphism
                  of the adjunction at that object, denoted
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi c
                        %mo ≔
                        %mover
                          %mrow
                            %msub
                              %mi id
                              %mrow
                                %mi L
                                %mo{:stretchy => "false"} (
                                %mi c
