              %p which is exactly the associativity of the multiplication of the monad.
              %p
                %strong (4)
                The naturality of the multiplication
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϵ
                        %mrow
                          %mi F
