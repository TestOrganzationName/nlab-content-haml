                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (Lan_p \dashv p^* \dashv Ran_p)
                      \:=
                      (p_! \dashv p^* \dashv p_*) :
                      [K,C]
                      \\stackrel{\overset{p_!}{\to}}{\stackrel{\overset{p^*}{\leftarrow}}{\underset{p_*}{\to}}}
                      [K',C]
                      \\,.
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ′
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} K' = {*}
                is the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                then this are the
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                and
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                functors on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
