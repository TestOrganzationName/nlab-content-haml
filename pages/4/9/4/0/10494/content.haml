                    %mi H
                %annotation{:encoding => "application/x-tex"} T \mathbf{H}
            from the latter to the former
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi 𝕊
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                    %mo )
                  %mo ⟶
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi GL
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi GL
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  X \times \mathbb{S}
                  \\\
                  \\downarrow
                  \\\
                  X
                  }
                  \\right)
                  \\longrightarrow
                  \\left(
                  \\array{
                  E//GL_1(E)
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B}GL_1(E)
                  }
                  \\right)
          %p
            are equivalently
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi 𝕊
                        %mtd
                          %mover
                            %mo ⟶
                            %mi σ
                        %mtd
                          %mi E
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi GL
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi χ
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi GL
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \times \mathbb{S} &amp;\stackrel{\sigma}{\longrightarrow}&amp; E//GL_1(E)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\stackrel{\chi}{\longrightarrow}&amp; \mathbf{B}GL_1(E)
                  }
          %p and hence
          %ol
            %li
              %p
                a choice of
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist of E-cohomology
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi GL
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi \;\colon \; X  \longrightarrow \mathbf{B}GL_1(E)
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi GL
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} GL_1(E)
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %li
              %p
                an element in the
                = succeed "-twisted" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                = succeed "-cohomology" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∈
                        %msup
                          %mi E
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi χ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \sigma \in E^{\bullet + \chi}(X,E)
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the
                %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-line+bundle"} (∞,1)-line bundle
          %p
            If we consider the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            instead of the external
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom+space"} (∞,1)-categorical hom space
            then things work even more nicely and we can use just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            instead of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} X \times \mathbb{S}
          #MappingSpectrumOutOfUnstableTypeAsCartesianInternalHom.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mn 0
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H} \stackrel{0}{\hookrightarrow} T \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi T
                      %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} E \in Stab(\mathbf{H}) \simeq T_\ast \mathbf{H} \hookrightarrow T \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_{T \mathbf{H}} \in T \mathbf{H}
            %p
              (with respect to the Cartesian
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+%28%E2%88%9E%2C1%29-category"} closed monoidal (∞,1)-category
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\Sigma^\infty X, E]_{Stab(\mathbf{H})} \in Stab(\mathbf{H}) \hookrightarrow T \mathbf{H}
                    \\,,
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_{T \mathbf{H}} \simeq [\Sigma^\infty X,E]_{Stab(\mathbf{H})}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Notice that as an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo ↪
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} T \mathbf{H} \hookrightarrow \mathbf{H}^{seq}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the constant
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi seq
                    %annotation{:encoding => "application/x-tex"} seq
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo •
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_\bullet \simeq \mathbf{H}^{seq}(X \times \bullet, E)
                    \\,.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is constant the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo •
                  %annotation{:encoding => "application/x-tex"} X \times \bullet
              is for each object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              the
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} presheaf represented
              by that object. Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_\bullet \simeq [X,E_\bullet]
                    \\,.
            %p
              This is manifestly the same formula as for the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
              out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mn ∞
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma^\infty X
          %p Similar kind of arguments give the following more general statement.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mn 0
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H} \stackrel{0}{\hookrightarrow} T \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %msub
                      %mi E
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in E_\infty(\mathbf{H})
              an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo →
                    %mi Pic
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} (\widehat{Pic(E)} \to Pic(E)) \hookrightarrow T \mathbf{H}
              its universal
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-line+bundle"} (∞,1)-line bundle
              over its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Picard+%E2%88%9E-groupoid"} Picard ∞-groupoid
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mover
                      %mrow
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [X,\widehat{Pic(E)}]_{T \mathbf{H}} \in T \mathbf{H}
            %p is the object whose
            %ul
              %li
                %p
                  base homotopy type is the
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [X, Pic(E)]
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
