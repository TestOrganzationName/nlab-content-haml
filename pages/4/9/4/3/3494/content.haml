                    %annotation{:encoding => "application/x-tex"} \mathbb{A}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝔸
                      %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {S(\mathbb{A})}
              defined in
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve#the_cosimplicial_category"} homotopy coherent nerve#the_cosimplicial_category
              is such that a h.c. diagram of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} {\mathbb{A}}
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is given precisely by an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝔸
                      %mo{:stretchy => "false"} )
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    F : {S(\mathbb{A})} \to Top
          %p
            This suggested the extension of h.c. diagrams to other contexts such as a general locally Kan
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
