                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} SSet
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} SSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasicategory"} quasicategory
          %p
            To understand simplical h.c. diagrams and thus the h.c. simplicial
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(\mathcal{B})
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
          %p
            The first thing to note is that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi i
                    %mo &lt;
                    %mi j
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0\leq i\lt j\leq n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi j
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S[n](i,j) \cong \Delta[1]^{j-i-1}
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo −
                    %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j-i-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo −
                  %mi i
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} j-i-1
            copies of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
          %p Next some notation:
          %p Given simplicial maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 1
                  %mo :
                  %msub
                    %mi K
                    %mn 1
                  %mo →
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} f_1: K_1 \to \mathcal{B}(x,y),
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 2
                  %mo :
                  %msub
                    %mi K
                    %mn 2
                  %mo →
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} f_2: K_2 \to \mathcal{B}(y,z),
          %p we will denote the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 1
                  %mo ×
                  %msub
                    %mi K
                    %mn 2
                  %mo →
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi c
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K_1 \times K_2 \to \mathcal{B}(x,y)\times \mathcal{B}(y,z) \stackrel{c}{\to} \mathcal{B}(x,z)
          %p
            just by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 2
                  %mo .
                  %msub
                    %mi f
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f_2.f_1
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_2f_1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{A} = [3]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 123
                  %mo{:stretchy => "false"} )
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 01
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(123)X(01)
            is actually
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mn 123
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mn 01
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(123)(I \times X(01) )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 23
                  %mo{:stretchy => "false"} )
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 012
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(23)X(012)
            is exactly what it states.)
          %h3#rectification Rectification
          %p
            Every homotopy coherent diagram is weakly equivalent to a strict diagram, a phenomenon known as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/rectification"} rectification
          %h4#vogts_theorem Vogt’s theorem
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Vogt)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is a small category, there is a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %mi Coh
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi Top
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Coh(A,Top)}
              of h.c. diagrams and homotopy classes of h. c. maps between them. Moreover there is an equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %mi Coh
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi Top
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Top
                          %mi A
                        %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathbf{Coh(A,Top)} \stackrel{\simeq}{\to} \mathbf{Ho(Top^A)}.
          %h4#bergermoerdijk_theorem Berger-Moerdijk theorem
          %p
            If we think of hc diagrams as algebras over an operad, then this rectification is a special case of the general rectification theorem for such algebras. See
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+an+operad"} model structure on algebras over an operad
            for details.
