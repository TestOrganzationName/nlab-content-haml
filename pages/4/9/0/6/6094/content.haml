          %h2#idea Idea
          %p
            The notion of
            %em Calabi-Yau algebra
            is an algebraic incarnation of the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
            and
            = succeed "-version" do
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              a
              %a.existingWikiWord{:href => "/nlab/show/dg-module"} dg-bimodule
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mo !
                    %mo ≔
                    %msub
                      %mi RHom
                      %mrow
                        %mi A
                        %mi Bimod
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N^!
                    \\coloneqq
                    RHom_{A Bimod}(N, A \otimes A)
            %p
              for the dual
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RHom
                  %annotation{:encoding => "application/x-tex"} RHom
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} right derived
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              with respect to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-modules"} model structure on dg-modules
          .num_defn
            %h6#definition_3 Definition
            %p
              A homologically smooth
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong Calabi-Yau algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              if there is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi A
                      %mo !
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    f \colon  A \stackrel{\simeq}{\to} A^![d]
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≃
                    %msup
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \simeq f^![d]
                    \\,.
          %p
            This is
            = succeed "." do
              %a{:href => "#Ginzburg"} Ginzburg, def. 3.2.3
          %h2#properties Properties
          %h3#general General
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-projective+variety"} quasi-projective variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi Coh
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^b(Coh X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of bounded
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %a.existingWikiWord{:href => "/nlab/show/coherent+sheaves"} coherent sheaves
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          #TiltingGenerator.num_defn
            %h6#definition_4 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ∈
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \in D^b(Coh X)
              is called a
              %strong tilting generator
              if the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi ℰ
                        %mo ,
                        %mi ℰ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} Ext^i(\mathcal{E}, \mathcal{E}) = 0
                  for all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo &gt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} i \gt 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi ℰ
                        %mo ,
                        %mi ℱ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} Ext^\bullet(\mathcal{E},\mathcal{F}) = 0
                  implies
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℱ
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathcal{F} = 0
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                  algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi End
                        %mo{:stretchy => "false"} (
                        %mi ℰ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi ℰ
                        %mo ,
                        %mi ℰ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} End(\mathcal{E}) = Hom(\mathcal{E},\mathcal{E})
                  has finite
                  %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
          %p
            This appears as
            = succeed "." do
              %a{:href => "#Ginzburg"} Ginzburg, def. 7.1.1
          .num_remark
            %h6#remark Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              a tilting generator there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    D^b(Coh X) \stackrel{\simeq}{\to}  D^b(End(\mathcal{E})Mod)
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi End
                      %mo{:stretchy => "false"} (
                      %mi ℰ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} End(\mathcal{E})
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              smooth connected variety which is projective over an affine variety, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mi in
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} in D^b(Coh X)
              be a tilting generator, def.
              = succeed "." do
                %a.maruku-ref{:href => "#TiltingGenerator"}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} End \mathcal{E}
              is a Calabi-Yau algebra of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
              of dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
          %p
            This appears as
            = succeed "." do
              %a{:href => "#Ginzburg"} Ginzburg, prop. 3.3.1
          %h4#calabiyau_algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            \-Calabi-Yau algebras
          %p
            A cochain dg-algebra over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is
            = succeed "-Calabi-Yau" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Tor
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mi A
                  %mo ,
                  %msub
                    %mrow
                    %mi A
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Tor^0_A(k_A,{}_A k)
            is a symmetric coalgebra. Proven in
          %ul
            %li
              J.-W. He, X.-F. Mao,
              = succeed "," do
                %em Connected cochain DG algebras of Calabi-Yau dimension 0
              %strong 145
              (2017) 937–953
              %a{:href => "https://doi.org/10.1090/proc/13081"} doi
          %p
            It follows that a Koszul dg-algebra is
            = succeed "-Calabi-Yau" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius
          %h3#relation_to_2d_extended_tqft_and_the_cobordism_hypothesis Relation to 2d extended TQFT and the Cobordism hypothesis
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathbf{S}
              be a
              %span.newWikiWord
                good
                %a{:href => "/nlab/new/good+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} ?
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg(\mathbf{S})
              for the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,2)-category
              whose
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %a.existingWikiWord{:href => "/nlab/show/algebra+in+an+%28%E2%88%9E%2C1%29-category"} algebra objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathbf{S}
              and whose
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              objects.
            %p
              Then a Calabi-Yau object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg(\mathbf{S})
              is an algebra object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              equipped with an
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tr
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi A
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    tr \colon \int_{S^1} A \to 1
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi A
                      %mo ≃
                      %mi A
                      %msub
                        %mo ⊗
                        %mrow
                          %mi A
                          %mo ⊗
                          %mi A
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \int_{S^1} A \simeq A \otimes_{A \otimes A} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ≃
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 0
                    %mi A
                    %mo →
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi A
                    %mover
                      %mo →
                      %mi tr
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    A \otimes A \simeq \int_{S^0} A \to \int_{S^1} A \stackrel{tr}{\to} 1
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as its own
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo ∨
                    %annotation{:encoding => "application/x-tex"} A^\vee
            %p
              Such an algebra object is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+algebra"} Calabi-Yau algebra
                  object
          %p
            This is (
            %a{:href => "#Lurie09"}> Lurie 09, example 4.2.8
            ).
