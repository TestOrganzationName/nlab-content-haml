                          %mrow
                            %mi k
                            %mo +
                            %mi l
                            %mo −
                            %mn 1
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi k
