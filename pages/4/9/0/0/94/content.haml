                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (v_1, \cdots, v_n)
                  of homogeneously graded elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                        %mo ∈
                        %msub
                          %mi 𝔤
                          %mrow
                            %mo{:stretchy => "false"} |
