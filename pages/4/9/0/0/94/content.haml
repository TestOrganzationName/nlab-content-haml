                            %mrow
                              %msub
                                %mi a
                                %mi k
                          %msubsup
                            %mo{:stretchy => "false"} ]
                            %mi k
                            %mi a
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi t
                            %mrow
                              %msub
                                %mi a
                                %mn 1
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %msup
                            %mi t
                            %mrow
                              %msub
                                %mi a
