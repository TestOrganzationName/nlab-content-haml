                            %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi k
                            %mo +
                            %mi l
                            %mo −
                            %mn 1
                    %mo ]
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{k+l = n-1}
                  \\sum_{\sigma \in Unsh(l,k-1)}
                  (-1)^{sgn(\sigma)}
                  \\left[\left[t_{a_1}, \cdots, t_{a_l}\right], t_{a_{l+1}}, \cdots, t_{a_{k+l-1}}\right]
                  \= 0
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            and all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mi i
                    %mo ∈
                    %mi 𝔤
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_{a_i} \in \mathfrak{g}\}
            %a.maruku-eqref{:href => "#eq:LInfinityJacobiIdentity"} (1)
            which says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi 𝔤
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi …
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi k
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\mathfrak{g}, \{[-,\dots,-]_k\}\}
            is an
