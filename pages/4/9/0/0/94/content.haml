                              %mi v
                              %mi i
                            %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} v_i \in \mathfrak{g}_{\vert v_i \vert}
                  the following
                  %a.existingWikiWord{:href => "/nlab/show/equation"} equation
                  holds
                #eq:LInfinityJacobiIdentity.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mi i
                                %mo ,
                                %mi j
                                %mo ∈
                                %mi ℕ
                            %mrow
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                                %mo =
                                %mi n
                                %mo +
                                %mn 1
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi σ
                            %mo ∈
                            %mi UnShuff
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi j
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi l
                          %mi j
                        %mrow
                          %mo (
                          %msub
                            %mi l
                            %mi i
                          %mrow
                            %mo (
                            %msub
                              %mi v
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi v
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo{:stretchy => "false"} )
                            %mo )
                          %mo ,
                          %msub
                            %mi v
                            %mrow
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ⋯
