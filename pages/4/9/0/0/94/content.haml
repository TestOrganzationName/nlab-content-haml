                %a{:href => "https://arxiv.org/abs/1209.4756"}> arXiv:1209.4756
                ), published as
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
                    \-models of based mapping spaces
            %p
