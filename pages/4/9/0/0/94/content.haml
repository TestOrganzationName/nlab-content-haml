                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                  %mrow
                    %mo [
                    %mrow
                      %mo [
                      %msub
                        %mi t
                        %mrow
                          %msub
                            %mi a
