                  \\mapsto
                  \-
                  \\sum_{k = 1}^\infty
                  \\frac{1}{k!}
                  [t_{a_1}, \cdots, t_{a_k}]^a_k
                  \\,
                  t^{a_1} \wedge \cdots \wedge t^{a_k}
                  \\,.
          %p
            Here we take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi t
                    %mi a
