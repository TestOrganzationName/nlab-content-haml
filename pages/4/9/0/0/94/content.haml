          .num_example
            %h6#example Example
            %p In lowest degrees the generalized Jacobi identity says that
            %ol
              %li
                %p
                  for
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo ≔
                        %msub
                          %mi l
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \partial \coloneqq l_1
                  squares to 0:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\partial (\partial(v_1)) = 0
              %li
                %p
                  for
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n = 2
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                      %annotation{:encoding => "application/x-tex"} \partial
                  is a graded
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                  of the binary map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} [
                        %mo ∂
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi v
                              %mn 1
                            %mo{:stretchy => "false"} |
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %mo ∂
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo ∂
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \- [\partial v_1, v_2]
                        \- (-1)^{\vert v_1 \vert \vert v_2 \vert}
                        [\partial v_2, v_1]
                        +
                        \\partial [v_1, v_2]
                        \=
                        0
                %p hence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo ∂
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi v
                              %mn 1
                            %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mo ∂
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\partial [v_1, v_2] =  [\partial v_1, v_2] + (-1)^{\vert v_1 \vert} [v_1, \partial v_2]
                        \\,.
          .num_example
            %h6#example_2 Example
            %p
              When all higher brackets vanish,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} l_{k \gt 2}= 0
              then for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n = 3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    [[v_1,v_2],v_3]
                    +
                    (-1)^{\vert v_1 \vert (\vert v_2 \vert + \vert v_3 \vert)}
                    [[v_2,v_3],v_1]
                    +
                    (-1)^{\vert v_2 \vert (\vert v_1 \vert + \vert v_3 \vert)}
                    [[v_1,v_3],v_2]
                    \=
                    0
            %p
              this is the graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
          .num_example
            %h6#example_3 Example
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} l_3
              is possibly non-vanishing, then on elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo =
                    %msub
                      %mi l
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \partial = l_1
              vanishes, the generalized Jacobi identity for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ∂
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [[v_1,v_2],v_3]
                    +
                    (-1)^{\vert v_1 \vert (\vert v_2 \vert + \vert v_3 \vert)}
                    [[v_2,v_3],v_1]
                    +
                    (-1)^{\vert v_2 \vert (\vert v_1 \vert + \vert v_3 \vert)}
                    [[v_1,v_3],v_2]
                    \=
                    \- \partial [v_1, v_2, v_3]
                    \\,.
            %p This shows that the Jacobi identity holds up to an “exact” term, hence up to homotopy.
          %h3#ReformulationInSemifreeDgCoalgebra In terms of semifree differential coalgebra
          %p
            In (
            %a{:href => "#LadaStasheff92"}> Lada-Stasheff 92
            ) it was pointed out that the higher brackets of an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed ")" do
              %a.maruku-ref{:href => "#LInfinityDefinitionViaGeneralizedJacobiIdentity"}
            %a.existingWikiWord{:href => "/nlab/show/cofree+coalgebra"} cofree coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \vee^\bullet \mathfrak{g}
            over the underlying graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            the structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebra"} differential graded coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} D = [-] + [-,-] + [-,-,-] + \cdots
            the sum of the higher brackets, extended as graded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coderivations"} coderivations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} D^2 = 0
            = succeed ")" do
              %a{:href => "#LadaMarkl94"} Lada-Markl 94
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebras"} differential graded coalgebras
            are an equivalent incarnation of
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            (If one uses unital dg-co-algebras then the
            = succeed "-algbras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/curved+L-infinity+algebras"} curved L-infinity algebras
          %p
            Notice that this immediately imples that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is degreewise finite dimensional, then passing to
            %a.existingWikiWord{:href => "/nlab/show/dual+vector+spaces"} dual vector spaces
            turns semifree
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebra"} differential graded coalgebra
            into
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebras"} differential graded algebras
            = succeed "-equivalent" do
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary finite dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            (and also more generally, if one invokes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
            %a{:href => "model+structure+for+L-infinity+algebras#OnProAlg"} model structure for L-infinity algebras – Use of pro-dg-algebras
            ).
          %p
            In term of the
            %a.existingWikiWord{:href => "/nlab/show/operad"} operadic
            definition of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a{:href => "#InTermsOfAlgebrasOverAnOperad"} above
            this equivalence is an incarnation of the
            %a.existingWikiWord{:href => "/nlab/show/Koszul+duality"} Koszul duality
            between the
            %a.existingWikiWord{:href => "/nlab/show/Lie+operad"} Lie operad
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+operad"} commutative operad
          %p
            We now spell out this dg-coalgebraic incarnation of
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            A (connected)
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebra
            is
          %ul
            %li
              %p
                an
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℕ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}_+
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %li
              %p
                equipped with a differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo :
                      %msup
                        %mo ∨
                        %mo •
                      %mi 𝔤
                      %mo →
                      %msup
                        %mo ∨
                        %mo •
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} D : \vee^\bullet \mathfrak{g} \to \vee^\bullet \mathfrak{g}
                of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} -1
                on the
                %a.existingWikiWord{:href => "/nlab/show/free+graded+co-commutative+coalgebra"} free graded co-commutative coalgebra
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                that squares to 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mn 2
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D^2 = 0
                  \\,.
          %p
            Here the free graded co-commutative co-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \vee^\bullet \mathfrak{g}
            is, as a vector space, the same as the graded
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}
            whose elements we write as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                  %msub
                    %mi t
                    %mn 1
                  %mo ∨
                  %msub
                    %mi t
                    %mn 2
                  %mo +
                  %msub
                    %mi t
                    %mn 3
                  %mo +
                  %msub
                    %mi t
                    %mn 3
                  %mo ∨
                  %msub
                    %mi t
                    %mn 4
                  %mo ∨
                  %msub
                    %mi t
                    %mn 5
                %annotation{:encoding => "application/x-tex"}
                  3 t_1 \vee t_2 + t_3 + t_3 \vee t_4 \vee t_5
          %p
            etc (where the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                %annotation{:encoding => "application/x-tex"} \vee
            is just a funny way to write the wedge
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
          %p but thought of as equipped with the standard coproduct
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ∨
                  %msub
                    %mi v
                    %mn 2
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∝
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %mo ±
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ∨
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi v
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ∨
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta (v_1 \vee v_2 \cdots \vee v_n)
                  \\propto \sum_i \pm (v_1 \vee \cdots \vee v_i) \otimes (v_{i+1} \vee \cdots \vee v_n)
          %blockquote
            %p (work out or see the references for the signs and prefacors).
          %p
            Since this is a
            %em free
            graded co-commutative coalgebra, one can see that any differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                  %mo →
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"}
                  D : \vee^\bullet \mathfrak{g} \to \vee^\bullet \mathfrak{g}
          %p
            on it is fixed by its value “on cogenerators” (a statement that is maybe unfamiliar, but simply the straightforward dual of the more familar statement to which we come below, that differentials on free graded algebras are fixed by their action on generators) which means that we can decompose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %msub
                    %mi D
                    %mn 1
                  %mo +
                  %msub
                    %mi D
                    %mn 2
                  %mo +
                  %msub
                    %mi D
                    %mn 3
                  %mo +
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  D = D_1 +  D_2 + D_3 + \cdots
                  \\,,
          %p
            where each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi i
                %annotation{:encoding => "application/x-tex"} D_i
            acts as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi l
                    %mi i
                %annotation{:encoding => "application/x-tex"} l_i
            when evaluated on a homogeneous element of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mn 1
                  %mo ∨
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi t
                    %mi n
                %annotation{:encoding => "application/x-tex"} t_1 \vee \cdots \vee t_n
            and is then uniquely extended to all of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \vee^\bullet \mathfrak{g}
            by extending it as a
            %em coderivation
            on a coalgebra.
          %p
            For instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 2
                %annotation{:encoding => "application/x-tex"} D_2
            acts on homogeneous elements of word lenght 3 as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ∨
                  %msub
                    %mi t
                    %mn 2
                  %mo ∨
                  %msub
                    %mi t
                    %mn 3
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %msub
                    %mi t
                    %mn 3
                  %mo ±
                  %mi permutations
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_2(t_1 \vee t_2 \vee t_3) =
                  D_2(t_1, t_2)\vee t_3 \pm permutations
                  \\,.
          %blockquote
            %p exercise for the reader: spell this all out more in detail with all the signs and everyrthing. Possibly by looking it up in the references given below.
          %p
            Using this, one checks that the simple condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            squares to 0 is precisely equivalent to the infinite tower of generalized Jacobi identities:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mn 2
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mrow
                    %mo (
                    %mo ∀
                    %mi n
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo +
                        %mi j
                        %mo =
                        %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi shuffles
                        %mi σ
                    %mo ±
                    %msub
                      %mi l
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi l
                      %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi v
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (D^2 = 0)
                  \\Leftrightarrow
                  \\left(
                  \\forall n :
                  \\sum_{i+j = n} \sum_{shuffles \sigma}
                  \\pm l_i (l_j (v_{\sigma(1)}, \cdots, v_{\sigma(j)} )
                  , v_{\sigma(j+1)} , \cdots , v_{\sigma(n)} ) = 0
                  \\right)
                  \\,.
          %p So in conclusion we have:
          .standout
            %p
              An
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
              is cofree and concentrated in negative degree.
          %h3#ReformulationInTermsOfSemifreeDGAlgebra In terms of semifree differential algebra
          %p
            The reformulation of an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∨
                    %mo •
                  %mi 𝔤
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vee^\bullet \mathfrak{g}, D)
            is a useful repackaging of the original definition, but the coalgebraic aspect tends to be not only unfamiliar, but also a bit inconvenient. At least when the graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is degreewise
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
          %p
            (Fully generally the following works when using not just dg-algebras but
            %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            = succeed ")." do
              %em
                %a{:href => "model+structure+for+L-infinity+algebras#OnProAlg"} model structure for L-infinity algebras – Use of pro-dg-algebras
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^*
            is then naturally equipped with an ordinary differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %msup
                    %mi D
                    %mo *
                %annotation{:encoding => "application/x-tex"} d = D^*
            which acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \omega \in \wedge^\bullet \mathfrak{g}^*
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ∨
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi t
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo ±
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ∨
                  %mi ⋯
                  %mo ∨
                  %msub
                    %mi t
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (d \omega) (t_1 \vee \cdots \vee t_n) =
                  \\pm \omega(D(t_1 \vee \cdots \vee t_n))
                  \\,.
          %p When the grading-dust has settled one finds that with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo =
                  %mi k
                  %mo ⊕
                  %msubsup
                    %mi 𝔤
                    %mn 1
                    %mo *
                  %mo ⊕
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝔤
                    %mn 1
                    %mo *
                  %mo ∧
                  %msubsup
                    %mi 𝔤
                    %mn 1
                    %mo *
                  %mo ⊕
                  %msubsup
                    %mi 𝔤
                    %mn 2
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\wedge^\bullet \mathfrak{g}^* =
                  k \oplus \mathfrak{g}^*_1 \oplus (\mathfrak{g}^*_1 \wedge \mathfrak{g}^*_1 \oplus \mathfrak{g}^*_2) \oplus \cdots
          %p
            with the ground field in degree 0, the degree 1-elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            in degree 1, etc, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is of degree +1 and of course squares to 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 2
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d^2 = 0
                  \\,.
          %p
            This means that we have a
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{g}) := (\wedge^\bullet \mathfrak{g}^*, d)
                  \\,.
          %p
            In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            happens to be an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of this Lie algebra. Hence we should generally call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            One observes that this construction is bijective: every (degreewise finite dimensional) cochain
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
            generated in positive degree comes from a (degreewise finite dimensional)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            This means that we may just as well
            %em define
            a (degreewise finite dimensional)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of (degreewise finite dimensional) commutative
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
          %p
            (In general this corresponds to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/curved+L-infinity+algebra"} curved L-infinity algebra
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            dually correspond to the dg-algebras which are
            %a.existingWikiWord{:href => "/nlab/show/augmented+algebra"} augmented
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) \longrightarrow \mathbb{R}
            is a homomorphism of dg-algebras.)
          %p
            And this turns out to be one of the most useful perspectives on
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            In particular, if we simply drop the condition that the dg-algebra be generated in positive degree and allow it to be generated in non-negative degree over the algebra in degree 0, then we have the notion of the (Chevalley-Eilenberg algebra of) an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity-algebroid"} L-infinity-algebroid
          %h4#DGAlgebraDetails Details
          %p
            We discuss in explit detail the computation that shows that an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
