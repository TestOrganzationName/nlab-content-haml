                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
            with a single object.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            \-algebras are
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
            approximations of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            “exponentiates” to a
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega \exp(\mathfrak{g})
          %h2#History History
          #SuperLInfintiyAsFDA.num_remark
            %h6#remark Remark
            %p
              %strong
                (history of the concept of (super-)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                algebras)
            %p
              The identification of the concept of (super-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebras has a non-linear history:
            %p
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              in the incarnation of higher brackets satisfying a higher Jacobi identity (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LInfinityDefinitionViaGeneralizedJacobiIdentity"}
              = succeed "," do
                %a{:href => "#Stasheff92"} Stasheff 92
              = succeed "," do
                %a{:href => "#LadaStasheff92"} Lada-Stasheff 92
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
              of the
              %a.existingWikiWord{:href => "/nlab/show/bosonic+string"} bosonic string
              that was reported in the construction of
              %a.existingWikiWord{:href => "/nlab/show/closed+string+field+theory"} closed string field theory
              in
              = succeed "." do
                %a{:href => "#Zwiebach92"} Zwiebach 92
            %p
              %a{:href => "#LadaStasheff92"} Lada-Stasheff 92
              credit
              %a{:href => "deformation+theory#SchlessingerStasheff85"} Schlessinger-Stasheff 85
              with the introduction of the concept, but while that article considers many closely related structures, it does not consider
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a{:href => "#LadaMarkl94"} Lada-Markl 94
              credit other work by Schlessinger-Stasheff as the origin, but that work appeared much later as
              = succeed "." do
                %a{:href => "deformation+theory#SchlessingerStasheff12"} Schlessinger-Stasheff 12
            %p
              According to
              = succeed "," do
                %a{:href => "#Stasheff16"} Stasheff 16, slide 25
              %a.existingWikiWord{:href => "/nlab/show/Barton+Zwiebach"} Zwiebach
              had this structure already in 1989, when
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Stasheff
              recognized it in a talk by Zwiebach at a
              %a.existingWikiWord{:href => "/nlab/show/GUT"} GUT
              conference in Chapel-Hill. Zwiebach, in turn, was following the
              %a.existingWikiWord{:href => "/nlab/show/BV-formalism"} BV-formalism
              of
              = succeed "," do
                %a{:href => "#BatalinVilkovisky83"} Batalin-Vilkovisky 83
              = succeed "," do
                %a{:href => "#BatakinFradkin83"} Batakin-Fradkin 83
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "," do
                %a{:href => "#Stasheff96"} Stasheff 96
              = succeed "." do
                %a{:href => "#Stasheff97"} Stasheff 97
            %p
              The observation that these systems of higher brackets are fully characterized by their Chevalley-Eilenberg dg-(co-)algebras is due to
              = succeed "." do
                %a{:href => "#LadaMarkl94"} Lada-Markl 94
              = succeed "." do
                %a{:href => "#SatiSchreiberStasheff08"} Sati-Schreiber-Stasheff 08, around def. 13
            %p
              But in this dual incarnation,
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              and more generally
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              %a.existingWikiWord{:href => "/nlab/show/BV-formalism"} BV-formalism
              of
              = succeed "," do
                %a{:href => "#BatalinVilkovisky83"} Batalin-Vilkovisky 83
              = succeed "," do
                %a{:href => "#BatakinFradkin83"} Batakin-Fradkin 83
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature already in
              %a{:href => "D'Auria-Fré-Regge+formulation+of+supergravity#DAuriaFréRegge80b"} D’Auria-Fré-Regge 80
              and explicitly in
              = succeed "." do
                %a{:href => "#Nieuwenhuizen82"} van Nieuwenhuizen 82
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9+formulation+of+supergravity"} D'Auria-Fré formulation of supergravity
              (
              %a{:href => "#DAuriaFre82"}> D’Auria-Fré 82
              ) and eventually came to be referred to as “FDA”s (short for “free differential algebra”) in the
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature (but beware that these dg-algebras are in general
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              only as graded-
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"}> supercommutative superalgebras
              , not as differential algebras) The relation between super
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              literature is made explicit in (
              %a{:href => "#FSS13"}> FSS 13
              ).
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                    %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                    “FDA”
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
            %p
              The construction in
              %a{:href => "#Nieuwenhuizen82"} van Nieuwenhuizen 82
              in turn was motivated by the
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebras"} Sullivan algebras
              in
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              (
              %a{:href => "#rational+homotopy+theory#Sullivan77"}> Sullivan 77
              ). Indeed, their dual incarnations in rational homotopy theory are
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              (
              %a{:href => "#rational+homotopy+theory#Quillen69"}> Quillen 69
              ), hence a special case of
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %p
              This close relation between
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              and
              %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
              might have remained less of a secret had it not been for the focus of
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+minimal+models"} Sullivan minimal models
              on the non-
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              case, which excludes the ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              from the picture. But the Quillen model of
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              effectively says that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/rational+topological+space"} rational topological space
              then its
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega X
              is reflected, infinitesimally, by an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+construction"} Sullivan construction
              in
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              was concretely identified as higher
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              in
              = succeed "." do
                %a{:href => "#Lie+integration#Henriques"} Henriques 08
              = succeed "-theoretic" do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              manifest is in
              = succeed "." do
                %a{:href => "BuijsFelixMurillo12"} Buijs-Félix-Murillo 12, section 2
          %h2#definition Definition
          %h3#in_terms_of_algebras_over_an_operad In terms of algebras over an operad
          %p
            An
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebra
            is an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+operad"} L-∞ operad
          %p In the following we spell out in detail what this means in components.
          %h3#DefinitionViaHigherBrackets In terms of higher brackets
          %p
            We now state the definition of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            equipped with
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/multilinear+maps"} multilinear
            and graded-skew symmetric maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,\cdots,-]
            – the “brackets” – that satisfy a generalization of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
          %p
            To that end, we here choose grading conventions such that the following definition of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is concentrated in
            = succeed "." do
              %em degree zero
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            (“homological grading”). Together this means in particular that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is a
            %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebra"} Lie n-algebra
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
          %p Beware that there are also other conventions possible, and there are other conventions in use, for both these choices, leading to different signs in the following formulas.
          #GradedSignatureOfPermutation.num_defn
            %h6#definition_2 Definition
            %p
              %strong (graded signature of a permuation)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi v
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{v} = (v_1, v_2, \cdots, v_n)
            %p
              be an
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"} n-tuple
              of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of homogeneous degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} |
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \vert v_i \vert  \in \mathbb{Z}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                      %mo ∈
                      %msub
                        %mi V
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi v
                            %mi i
                          %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} v_i \in V_{\vert v_i\vert}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              a
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements, write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi σ
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} (-1)^{\vert \sigma \vert}
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (-1)^k
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is the composite of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              permutations that each exchange precisely one pair of neighboring elements.
            %p
              We say that the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi v
                    %annotation{:encoding => "application/x-tex"} \mathbf{v}
                \-graded signature of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\chi(\sigma, v_1, \cdots, v_n) \;\in\; \{-1,+1\}
            %p
              is the product of the
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi σ
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} (-1)^{\vert \sigma \vert}
              with a factor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mi i
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mi j
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} (-1)^{\vert v_i \vert \vert v_j \vert}
              for each interchange of neighbours
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %msub
                      %mi v
                      %mi j
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\cdots v_i,v_j, \cdots )
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %msub
                      %mi v
                      %mi j
                    %mo ,
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\cdots v_j,v_i, \cdots )
              involved in the decomposition of the permuation as a sequence of swapping neighbour pairs.
          #LInfinityDefinitionViaGeneralizedJacobiIdentity.num_defn
            %h6#definition_3 Definition
            %p
              An
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %ol
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %li
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n \geq 1
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear map
                  = succeed "," do
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                      \-ary bracket
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi n
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %mi 𝔤
                              %mo ⊗
                              %mi ⋯
                              %mo ⊗
                              %mi 𝔤
                            %mo ⏟
                          %mrow
                            %mi n
                            %mspace{:width => "thickmathspace"}
                            %mtext copies
                        %mo ⟶
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        l_n(\cdots)
                        \\;\coloneqq\;
                        [-,-, \cdots, -]_n
                        \\;\colon\;
                        \\underset{n \; \text{copies}}{\underbrace{\mathfrak{g} \otimes \cdots \otimes \mathfrak{g}}}
                        \\longrightarrow
                        \\mathfrak{g}
                %p
                  and of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n-2
                %p
                  (if one includes here
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n = 0
                  then one speaks of a
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/curved+L-infinity+algebra"} curved L-infinity algebra
            %p such that the following conditions hold:
            %ol
              %li
                %p
                  (
                  %strong> graded skew symmetry
                  ) each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                      %annotation{:encoding => "application/x-tex"} l_n
                  is graded antisymmetric, in that for every
                  %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  elements and for every
                  %a.existingWikiWord{:href => "/nlab/show/n-tuple"} n-tuple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (v_1, \cdots, v_n)
                  of homogeneously graded elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                        %mo ∈
                        %msub
                          %mi 𝔤
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi v
                              %mi i
                            %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} v_i \in \mathfrak{g}_{\vert v_i \vert}
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        l_n(v_{\sigma(1)}, v_{\sigma(2)},\cdots ,v_{\sigma(n)})
                        \=
                        \\chi(\sigma,v_1,\cdots, v_n) \cdot l_n(v_1, v_2, \cdots v_n)
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi(\sigma,v_1,\cdots, v_n)
                  is the
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi v
                            %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (v_1,\cdots,v_n)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                        %annotation{:encoding => "application/x-tex"} \sigma
                  = succeed ";" do
                    %a.maruku-ref{:href => "#GradedSignatureOfPermutation"}
              %li
                %p
                  (
                  %strong>
                    strong homotopy
                    %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  ) for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/n-tuple"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
