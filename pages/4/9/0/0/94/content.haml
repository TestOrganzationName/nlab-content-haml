                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mi l
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mi k
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi a
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mi l
                  %mo ∧
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi a
                        %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots =
                  \\sum_{k,l = 1}^\infty
                  \\frac{1}{(k+l-1)!}
                  \\sum_{\sigma \in \Sigma_{k+l-1}}
                  (-1)^{sgn(\sigma)}
                  \\frac{1}{(k-1)! l!}
                  [[t_{b_1}, \cdots, t_{b_l}], t_{a_2}, \cdots, t_{a_k}]^a
                  \\,
                  t^{b_1} \wedge \cdots \wedge t^{b_l}
                  \\wedge
                  t^{a_2} \wedge \cdots \wedge t^{a_{k}}
                  \\,.
          %p
            The sum over all permutations decomposes into a sum over the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo ,
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (l,k-1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/unshuffle"} unshuffle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                %annotation{:encoding => "application/x-tex"} l
            and the last
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (k-1)
            indices. By the graded-symmetry of the bracket, the latter do not change the value of the nested bracket. Since there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mi l
                  %mo !
                %annotation{:encoding => "application/x-tex"} (k-1)! l!
            many of them, we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ,
                      %mi l
                      %mo =
                      %mn 1
                    %mn ∞
                  %mfrac
                    %mn 1
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mi l
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
