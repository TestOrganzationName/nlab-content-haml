                  \\,.
          %p
            Here the wedge product on the right projects the nested bracket onto its graded-symmetric components. This is produced by summing over all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
