                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\sum_{{i,j \in \mathbb{N}} \atop {i+j = n+1}}
                        \\sum_{\sigma \in UnShuff(i,j-1)}
                        \\chi(\sigma,v_1, \cdots, v_{n})
                        (-1)^{i(j-1)}
                        l_{j} \left(
                        l_i \left( v_{\sigma(1)}, \cdots, v_{\sigma(i)} \right),
                        v_{\sigma(i+1)} , \cdots , v_{\sigma(n)}
                        \\right)
                        \= 0
                        \\,,
                %p
                  where the inner sum runs over all
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i,j-1)
                  %a.existingWikiWord{:href => "/nlab/show/unshuffles"} unshuffles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  and where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                  is the graded signature sign from def.
