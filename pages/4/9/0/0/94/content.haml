                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_n
                non-vanishing is called an
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/n-Lie+algebra"} n-Lie algebra
                – to be distinguished from a
                %em
                  Lie
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                \! However, in large parts of the literature
                = succeed "-Lie" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_n
                is
                %em not
                of the required homogeneous degree in the grading, or in which no grading is considered in the first place. Such
                = succeed "-Lie" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-algebras," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/n-Lie+algebra"} n-Lie algebra
            %li
              %p
                An
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
