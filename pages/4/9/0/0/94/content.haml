            is equivalent to the condition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo +
                      %mi l
                      %mo =
                      %mi n
                      %mo −
                      %mn 1
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Unsh
                      %mo{:stretchy => "false"} (
                      %mi l
                      %mo ,
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
