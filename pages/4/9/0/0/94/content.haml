                  %mo ∈
                  %msub
                    %mi Σ
                    %mrow
                      %mi k
                      %mo +
                      %mi l
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma_{k+l-1}
            weighted by the Koszul-
            %a.existingWikiWord{:href => "/nlab/show/signature"} signature
            of the permutation:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ,
                      %mi l
                      %mo =
                      %mn 1
                    %mn ∞
                  %mfrac
                    %mn 1
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
