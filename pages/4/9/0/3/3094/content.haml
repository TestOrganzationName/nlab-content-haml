                          %mtd
                            %mi D
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp; \stackrel{i}{\hookrightarrow} &amp; B \\
                    \\mathllap{f} \downarrow &amp; po &amp; \downarrow \mathrlap{g} \\
                    C &amp; \underset{j}{\hookrightarrow} &amp; D,
                    }
            %p
              is a (closed/open) subspace
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo :
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} j: C \hookrightarrow D
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U = \hom(1, -): Top \to Set
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              has both a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is monic in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              is also a pullback, so that we have the
              %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley equality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi i
                    %mo ∘
                    %msup
                      %mi f
                      %mo *
                    %mo =
                    %msup
                      %mi g
                      %mo *
                    %msub
                      %mo ∃
                      %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_i \circ f^\ast = g^\ast \exists_j \colon P(C) \to P(B)
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_i \colon P(A) \to P(B)
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              map between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^\ast: P(C) \to P(A)
              is the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              map).
            %p
              To prove that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is a subspace, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \subseteq C
              be any open set. Then there exists open
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊆
                    %mi B
                  %annotation{:encoding => "application/x-tex"} V \subseteq B
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^\ast(V) = f^\ast(U)
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a subspace inclusion. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_U \colon C \to \mathbf{2}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_V \colon B \to \mathbf{2}
              are the maps to
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
              that classify these open sets, then by the universal property of the pushout, there exists a unique continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi W
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_W \colon D \to \mathbf{2}
              which extends the pair of maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mi U
                      %mo ,
                      %msub
                        %mi χ
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \chi_U, \chi_V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi U
                    %annotation{:encoding => "application/x-tex"} j^{-1}(W) = U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is a subspace inclusion.
            %p
              If moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is an open inclusion, then for any open
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \subseteq C
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                  %annotation{:encoding => "application/x-tex"} j^\ast(\exists_j(U)) = U
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is monic) and (by Beck-Chevalley)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∃
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g^\ast(\exists_j(U)) = \exists_i(f^\ast(U))
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_j(U)
              is open, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is an open inclusion. The same proof, replacing the word “open” with the word “closed” throughout, shows that the pushout of a closed inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a closed inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          %p A similar (but even simpler) line of argument establishes the following result.
          #transfinite.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              category, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi κ
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} F: \kappa \to Top
              be a functor that preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/directed+colimits"} directed colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ≤
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(i \leq j)
              is a (closed/open) subspace inclusion for each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i \leq j
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi colim
                      %mrow
                        %mi i
                        %mo ∈
                        %mi κ
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(0) \to colim_{i \in \kappa} F(i)
              is also a (closed/open) inclusion.
          %h2#variations Variations
          %p
            There is also a notion of a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            induced along a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from a Grothendieck topology on another category (actually the input can be a somewhat more general
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            will serve as a sort of a completion). (this will be explained later).
          %p
            A topology may be induced by more than a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            other than a subset inclusion, or indeed by a family of functions out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            (not necessarily all with the same
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/target"} target
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+topology"} weak topology
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
            %a.existingWikiWord{:href => "/nlab/show/initial+structure"} initial structure
            for a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/sink"} source
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/strong+topology"} strong topology
            (or
            %a.existingWikiWord{:href => "/nlab/show/final+structure"} final structure
            for a
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/sink"} sink
            %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
            on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
