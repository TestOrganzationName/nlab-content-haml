                = succeed "," do
                  %em Topological Quantum Computation and Quantum Compilation
                = succeed "&rbrack;" do
                  %a{:href => "https://studenttheses.uu.nl/handle/20.500.12932/17738"} studenttheses.uu.nl:20.500.12932/17738
            %li
              %p
                Keisuke Fujii,
                = succeed "," do
                  %em Quantum Computation with Topological Codes: from qubit to topological fault-tolerance
                %strong 8
                (2015) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1504.01444"}> arXiv:1504.01444
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-981-287-996-7"} doi:10.1007/978-981-287-996-7
            %li
              %p
                Vadym Kliuchnikov, Alex Bocharov, Krysta M. Svore,
                = succeed "," do
                  %em Asymptotically Optimal Topological Quantum Compiling
                %strong 112
                (2014) 140504 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1310.4150"}> arXiv:1310.4150
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevLett.112.140504"} doi:10.1103/PhysRevLett.112.140504
            %li
              %p
                Caitlin Carnahan, Daniel Zeuch,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+E.+Bonesteel"} Nicholas E. Bonesteel
                = succeed "," do
                  %em Systematically generated two-qubit anyon braids
                %strong 93
                052328 (2016) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1511.00719"}> arXiv:1511.00719
