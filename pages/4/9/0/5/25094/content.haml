                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msubsup
                    %mi g
                    %mn 1
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi g
                    %mi n
                  %mo ,
                  %msubsup
                    %mi g
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle g_1, g_1^{-1} \cdots, g_n, g_n^{-1} \rangle
            of the
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            %em Solovay-Kitaev theorem
            \&amp;lbrack;
            %a{:href => "#Kitaev97"}> Kitaev (1997)
            ,
            = succeed "&rbrack;" do
              %a{:href => "#NielsenChuang00"} Nielsen &amp; Chuang (2000, §A3)
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi g
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{g_1, \cdots, g_n\}
            which are needed in order to approximate any given element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g \,\in\, SU(2)
            to given accuracy.
          %p
            In
            = succeed "-theory" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
          %ol
            %li
              %p
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi g
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi g
                        %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{g_0, \cdots, g_n\}
                as a given set of (operations of)
                %a.existingWikiWord{:href => "/nlab/show/quantum+gates"} quantum gates
                on
                %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
              %p
                (that the subgroup these generate is
                %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense
                in
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
                is said to mean that this is a
                %em universal set
                of quantum gates);
            %li
              %p
                the target element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \,\in\, SU(2)
                as an intended operation on qbits (an intended quantum program);
            %li
              %p
                the sequence of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi i
                    %annotation{:encoding => "application/x-tex"} g_i
                used to approximate
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                as a
                %a.existingWikiWord{:href => "/nlab/show/quantum+circuit"} quantum circuit
                realizing the quantum program (“
                %a.existingWikiWord{:href => "/nlab/show/quantum+compilation"}> quantum compilation
                ”),
          %p
            and then the Solovay-Kitaev theorem guarantees that the maximum
            %em depth
            of the quantum circuit grows only slowly with its required accuracy.
          %p
            In fact, the theorem holds in the generality of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(d)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}_{\geq 1}
            %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            corresponds to working with
            %em
              %a.existingWikiWord{:href => "/nlab/show/qdits"} qdits
            instead of just
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
          %p
            Regarding the practical relevance, it has been argued &amp;lbrack;
            %a{:href => "https://quantumcomputing.stackexchange.com/a/22197/19363"}> MO:a/22197
            \&amp;rbrack; that
            = succeed "-hardware" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computing"} quantum computing
            %a.existingWikiWord{:href => "/nlab/show/superconductors"} superconductors
            will already allow to approximate any operation on a “physical qbit” by a single
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+gate"} quantum gate
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/logical+qbits"} logical qbits
            %a.existingWikiWord{:href => "/nlab/show/quantum+error+correction"} quantum error correction
            into account.
          %p
            Similarly, in
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
            the available set of basic
            %a.existingWikiWord{:href => "/nlab/show/anyon"} anyon
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braid gates
            is typically far from the usual
            = succeed "-basis" do
              %a.existingWikiWord{:href => "/nlab/show/QBit"} QBit
            = succeed "," do
              %a{:href => "#BonesteelHormoziZikosSimon05"} Bonesteel, Hormozi, Zikos &amp; Simon (2005)
            = succeed "," do
              %a{:href => "#HormoziZikosBonesteelSimon07"} Hormozi, Zikos, Bonesteel &amp; Simon (2007)
            = succeed ")." do
              %a{:href => "#HormoziBonesteelSimon09"} Hormozi, Bonesteel &amp; Simon (2009)
          %p#BraidImplementingCNotGate
            For example, the following lengthy braid has been proposed &amp;lbrack;
            %a{:href => "#HormoziZikosBonesteelSimon07"}> Hormozi, Zikos, Bonesteel &amp; Simon (2007)
            \&amp;rbrack; as a possible topological quantum compilation of a
            %em single
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/CNOT+gate"} CNOT gate
          %center
            %img{:src => "https://ncatlab.org/nlab/files/BraidImplementingCNOTGate.jpg", :width => "800"}/
          %h2#references References
          %h3#general General
          %p
            According to
            %a{:href => "#DawsonNielsen06"} Dawson &amp; Nielsen (2006, p. 13)
            the first announcement of the theorem was
          %ul
            %li
              “by
              %a.existingWikiWord{:href => "/nlab/show/Robert+Solovay"} Solovay
              in 1995 on an email discussion list”.
          %p A proof was then outlined in:
          %ul
            %li#Kitaev97
              %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"}> Alexei Kitaev
              , Thm. 4.8 of:
              = succeed "," do
                %em Quantum computations: algorithms and error correction
              %strong 52
              6 (1997) &amp;lbrack;
              %a{:href => "https://iopscience.iop.org/article/10.1070/RM1997v052n06ABEH002155"}> doi:10.1070/RM1997v052n06ABEH002155
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://ochicken.top/Library/Physics/Quantum_Computation_and_Quantum_Information/1997.06%20A.Yu.Kitaev_%20Quantum%20computations_%20algorithms%20and%20error%20correction%20(kitaev1997).pdf"} pdf
          %p followed by talk announcement:
          %ul
            %li#Solovay00
              %a.existingWikiWord{:href => "/nlab/show/Robert+Solovay"}> Robert Solovay
              ,
              = succeed "," do
                %em Lie Groups and Quantum Circuits
              = succeed "," do
                %a{:href => "https://www.msri.org/workshops/189/schedules/12826"} webpage
              = succeed "&rbrack;" do
                %a{:href => "https://s3-us-west-1.amazonaws.com/msri-videos/paperclip/videos/data/000/049/315/original/189-12826-Lie_Groups_and_Quantum_Circuits-Robert_Solovay.mp4"} mp4
          %p
            Following
            = succeed "," do
              %a{:href => "#Kitaev97"} Kitaev (1997)
          %ul
            %li#NielsenChuang00
              %a.existingWikiWord{:href => "/nlab/show/Michael+A.+Nielsen"}> Michael A. Nielsen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Isaac+L.+Chuang"} Isaac L. Chuang
              = succeed "," do
                %em Solovay-Kitaev theorem
              = succeed "," do
                %em Quantum computation and quantum information
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/CBO9780511976667"} doi:10.1017/CBO9780511976667
              = succeed "," do
                %a{:href => "http://csis.pace.edu/~ctappert/cs837-19spring/QC-textbook.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/NielsenChuangQuantumComputation.pdf", :title => "pdf"} pdf
          %p Review:
          %ul
            %li#KitaevShenVyalyi02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"}> Alexei Kitaev
                , A. H. Shen, M. N. Vyalyi, §8.3 in:
                = succeed "," do
                  %em Classical and Quantum Computation
                = succeed "," do
                  %strong 47
                = succeed "&rbrack;" do
                  %a{:href => "http://dx.doi.org/10.1090/gsm/047"} doi:10.1090/gsm/047
            %li#DawsonNielsen06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christopher+M.+Dawson"}> Christopher M. Dawson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+A.+Nielsen"} Michael A. Nielsen
                = succeed "," do
                  %em The Solovay-Kitaev algorithm
                %strong 6
                1 (2006) 81–95 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/quant-ph/0505030"}> arXiv:quant-ph/0505030
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://dl.acm.org/doi/10.5555/2011679.2011685"} doi:10.5555/2011679.2011685
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Solovay%E2%80%93Kitaev_theorem"} Solovay-Kitaev theorem
            %li
              %p
                Maris Ozols,
                %em The Solovay-Kitaev theorem
                \&amp;lbrack;
                %a{:href => "http://home.lu.lv/~sd20008/papers/essays/Solovay-Kitaev.pdf"}> pdf
                \&amp;rbrack;
          %p Further refinement of the algorithm:
          %ul
            %li
              Attila B. Nagy,
              = succeed "," do
                %em On an implementation of the Solovay-Kitaev algorithm
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/quant-ph/0606077"} arXiv:quant-ph/0606077
          %h3#QuantumCircuitCompilationReferences Quantum circuit compilation
          %p More on quantum circuit compilation:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+J.+Ross"}> Neil J. Ross
                , Chapters 6-7 in:
                = succeed "," do
                  %em Algebraic and Logical Methods in Quantum Computation
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1510.02198"} arXiv:1510.02198
            %li
              %p
                Adi Botea, Akihiro Kishimoto, Radu Marinescu,
                = succeed "," do
                  %em On the Complexity of Quantum Circuit Compilation
                %strong 9
                1 (2018) &amp;lbrack;
                %a{:href => "https://doi.org/10.1609/socs.v9i1.18463"}> doi:10.1609/socs.v9i1.18463
                \&amp;rbrack;
            %li
              %p
                Robert Wille; Stefan Hillmich; Lukas Burgholzer,
                = succeed "," do
                  %em Efficient and Correct Compilation of Quantum Circuits
                %em 2020 IEEE International Symposium on Circuits and Systems (ISCAS)
                IEEE Explore (2020) &amp;lbrack;
                %a{:href => "https://doi.org/10.1109/ISCAS45731.2020.9180791"}> doi:10.1109/ISCAS45731.2020.9180791
                \&amp;rbrack;
            %li
              %p
                Nathanial Stemen,
                %em Quantum Circuit Compilation from the Ground Up
                (2022) &amp;lbrack;
                %a{:href => "https://uwaterloo.ca/applied-mathematics/sites/ca.applied-mathematics/files/uploads/files/quantum_circuit_compilation_from_the_ground_up.pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                Giulia Meuli, Fereshte Mozafari, Bruno Schmitt, Heinz Riener, Mathias Soeken, Giovanni De Micheli:
                %em
                  %a{:href => "https://si2.epfl.ch/~demichel/research/quantum.html"} Quantum Compilation
          %p A textbook account:
          %ul
            %li
              Marco Maronese, Lorenzo Moro, Lorenzo Rocutto, Enrico Prati,
              = succeed "," do
                %em Quantum Compiling
              = succeed "," do
                %em Quantum Computing Environments
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/2112.00187"} arXiv:2112.00187
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-030-89746-8_2"} doi:10.1007/978-3-030-89746-8_2
          %p
            Quantum compilation with a
            %a.existingWikiWord{:href => "/nlab/show/proof+assistant"} proof assistant
            based on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/QWIRE"} QWIRE
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kesha+Hietala"}> Kesha Hietala
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Rand"} Robert Rand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shih-Han+Hung"} Shih-Han Hung
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hicks"} Michael Hicks
                = succeed "," do
                  %em A verified optimizer for Quantum circuits
                %strong 5
                Issue POPL 37 (2021) 1–29 &amp;lbrack;
                %a{:href => "https://doi.org/10.1145/3434318"}> doi:10.1145/3434318
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kesha+Hietala"}> Kesha Hietala
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Rand"} Robert Rand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shih-Han+Hung"} Shih-Han Hung
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hicks"} Michael Hicks
                = succeed "," do
                  %em Proving Quantum Programs Correct
                = succeed "," do
                  %em 12th International Conference on Interactive Theorem Proving (ITP 2021)
                %strong 193
                (2021) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2010.01240"}> arXiv:2010.01240
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kesha+Hietala"}> Kesha Hietala
                ,
                %em A verified software toolchain for quantum programming
                (2022) &amp;lbrack;
                %a{:href => "https://khieta.github.io/files/drafts/khieta-dissertation.pdf"}> pdf
                \&amp;rbrack;
          %h3#ReferencesInTopologicalQuantumComputation Topological quantum compilation
          %p
            Discussion of the Solovay-Kitaev theorem for quantum compilation in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
          %ul
            %li#BonesteelHormoziZikosSimon05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+E.+Bonesteel"}> Nicholas E. Bonesteel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Layla+Hormozi"} Layla Hormozi
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georgios+Zikos"} Georgios Zikos
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Steven+H.+Simon"} Steven H. Simon
                = succeed "," do
                  %em Braid Topologies for Quantum Computation
                %strong 95
                140503 (2005) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/quant-ph/0505065"}> arXiv:quant-ph/0505065
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevLett.95.140503"} doi:10.1103/PhysRevLett.95.140503
            %li#HormoziZikosBonesteelSimon07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Layla+Hormozi"}> Layla Hormozi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georgios+Zikos"} Georgios Zikos
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+E.+Bonesteel"} Nicholas E. Bonesteel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Steven+H.+Simon"} Steven H. Simon
                = succeed "," do
                  %em Topological Quantum Compiling
                %strong 75
                165310 (2007) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/quant-ph/0610111"}> arXiv:quant-ph/0610111
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevB.75.165310"} doi:10.1103/PhysRevB.75.165310
            %li#HormoziBonesteelSimon09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Layla+Hormozi"}> Layla Hormozi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+E.+Bonesteel"} Nicholas E. Bonesteel
                = succeed "," do
