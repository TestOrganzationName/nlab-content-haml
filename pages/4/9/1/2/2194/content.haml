                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi ℤ
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi ℝ
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}
                    \\xrightarrow{\;\;}
                    \\mathbb{R}
                    \\xrightarrow{\;\;}
                    S^1
                    \\xrightarrow{\;\;}
                    B \mathbb{Z}
                    \\xrightarrow{\;\;}
                    B \mathbb{R}
                    \\xrightarrow{\;\;}
