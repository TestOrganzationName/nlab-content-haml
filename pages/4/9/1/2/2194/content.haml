          %h2#definition Definition
          %p
          #PontrjaginDualGroup.num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} commutative
              (
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"}> Hausdorff
              )
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %em
                %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is any continuous homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %mi A
                    %mo →
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi: A\to S^1
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              %strong Pontrjagin dual group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi TopGrps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi A
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{A}
                    \\;\coloneqq\;
                    TopGrps
                    \\big(
                    A
                    ,\,
                    S^1
                    \\big)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              of all these
              %a.existingWikiWord{:href => "/nlab/show/group+characters"} group characters
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              complex numbers in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                      %mo ⊂
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} S^1\subset\mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              of
              %a.existingWikiWord{:href => "/nlab/show/uniform+convergence"} uniform convergence
              on each
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} K\subset A
              (this is equivalent to the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              The Pontrjagin dual of the additive group of
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is the Pontrjagin dual of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msup
                        %mi z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (n,z) \mapsto z^n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transforms"} Fourier transforms
          %p
          .num_remark
            %h6 Example
            %p
              More generally, the Pontrjagin dual of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^n
              is the
              %a.existingWikiWord{:href => "/nlab/show/n-torus"} n-torus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (S^1)^n
              %a.existingWikiWord{:href => "/nlab/show/solid+state+physics"} solid state physics
              this example appears in the guise of the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Brillouin+torus"} Brillouin torus
          %p
            In general, the dual of a
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete
            group is a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            group and conversely. In particular, therefore, the dual of a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            is again finite.
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              are Pontrjagin self-dual:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi n
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{Z}/n} \,\simeq\, \mathbb{Z}/n
          %p
          #PontrajginDualOfCompactGroupAsSecondGroupCohomologyGroup.num_prop
            %h6 Proposition
            %p
              %strong (Pontrjagin dual of compact group as second group cohomology group)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              (more generally: a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
              in degree-2
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              (more generally: refined
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi H
                      %mi grp
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{G}
                    \\;\simeq\;
                    H^2_{grp}
                    \\big(
                    G
                    ;\,
                    \\mathbb{Z}
                    \\big)
                    \\;=\;
                    H^2
                    \\big(
                    B G
                    ;\,
                    \\mathbb{Z}
                    \\big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              The key point is that, by assumption on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            #eq:RealGroupCohomologyOfCompactGroupVanishes.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi grp
                      %mrow
                        %mo •
                        %mo ≥
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℝ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{\bullet \geq 1}_{grp}
                    \\big(
                    G;\, \mathbb{R}
                    \\big)
                    \\;=\;
                    0
                    \\,.
            %p
              Using this, the conclusion is obtained as follows: The defining
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ↠
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z} \xhookrightarrow{\;} \mathbb{R} \twoheadrightarrow S^1
            %p
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/2-groups"} 2-groups
              (and further of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/n-groups"} n-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mover
