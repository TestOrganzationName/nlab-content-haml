                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(1)
              is an initial object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              takes finite products to finite coproducts (coproducts are necessary for a Heyting algebra). So it remains to show
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a preorder. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x, y
              be any two objects. The number of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \to y
              is the number of morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} 1 \to [x, y]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} N([x, y]) \to N(1) = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} z \to 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is a retract of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ×
                      %mi z
                      %mo ≅
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \times z \cong 0
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ≅
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} z \cong 0
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} z \to 0
            %p
              The second statement is immediate: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is the dualizing object, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≅
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d \cong [1, d] = N(1) \cong 0
            %p
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} N(x) = [x, 0]
              is the negation and the hypothesis becomes the condition that double negation on the Heyting algebra is the identity, i.e., the Heyting algebra is a Boolean algebra.
          %h3#in_the_category_of_spectra__anderson_duality In the category of spectra – Anderson duality
          %p
            In the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category+of+spectra"} stable (infinity,1)-category of spectra
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            (which induces
            %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+duality"} Spanier-Whitehead duality
            on spectra which are
            %a.existingWikiWord{:href => "/nlab/show/dualizable+objects"} dualizable objects
            with respect to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            %a.existingWikiWord{:href => "/nlab/show/Anderson+spectrum"} Anderson spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi ℤ
                %annotation{:encoding => "application/x-tex"} I_{\mathbb{Z}}
            is a dualizing object on a suitable subcategory of finite spectra (
            %a.existingWikiWord{:href => "/nlab/show/Representability+Theorems"}> Lurie, Example 4.3.9
            ). The
            %a.existingWikiWord{:href => "/nlab/show/duality"} duality
            operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi I
                    %mi ℤ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,I_{\mathbb{Z}}]
            that it induces is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Anderson+duality"} Anderson duality
          %p
            For instance, the Anderson dual of
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            is (complex conjugation-equivariantly) the 4-fold
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn 4
                  %mi KU
                %annotation{:encoding => "application/x-tex"} \Sigma^4 KU
            (
            %a{:href => "#HeardStojanoska14"}> Heard-Stojanoska 14, theorem 8.2
            ); and
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1/2]
            is Anderson dual to its 21-fold suspension (
            %a{:href => "#Stojanoska12"}> Stojanoska 12
            )
          %h3#in_the_category_of_suplattices In the category of suplattices
          %p
            In the category
            %a.existingWikiWord{:href => "/nlab/show/Sup"} Sup
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suplattices"} suplattices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Omega^{op}
            of the poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            of
            %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
            is a global dualizing object (and hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sup
                %annotation{:encoding => "application/x-tex"} Sup
            is
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A,B]
            is the suplattice of sup-preserving maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %msup
                    %mi Ω
                    %mi op
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A,\Omega^{op}]
            is the suplattice of contravariant maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %msup
                    %mi Ω
                    %mi op
                %annotation{:encoding => "application/x-tex"} A \to \Omega^{op}
            that take suprema in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to infima in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            for posets, any such map is representable by an element of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %msup
                      %mi Ω
                      %mi op
                    %mo{:stretchy => "false"} ]
                    %mo ≅
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} [A,\Omega^{op}] \cong A^{op}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A\cong (A^{op})^{op}
          %h3#chu_spaces Chu spaces
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Chu+construction"} Chu construction
            is a (co)universal way of “making any object into a dualizing object”.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/dual+object+in+a+closed+category"} dual object in a closed category
            %li
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous category
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chu+construction"} Chu construction
            %li
              %a.existingWikiWord{:href => "/nlab/show/ambimorphic+object"} ambimorphic object
          %h2#references References
          %p General discussion is in
          %ul
            %li#BoryachenkoDrinfeld11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mitya+Boryachenko"}> Mitya Boryachenko
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+Drinfeld"} Vladimir Drinfeld
                %em A duality formalism in the spirit of Grothendieck and Verdier
                (
                %a{:href => "http://arxiv.org/abs/1108.6020"}> arXiv:1108.6020
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , section 4.2 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Representability+Theorems"} Representability Theorems
          %p
            Reviews of the general concept and then discussion of
            %a.existingWikiWord{:href => "/nlab/show/Anderson+duality"} Anderson duality
            is in
          %ul
            %li#Stojanoska12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vesna+Stojanoska"}> Vesna Stojanoska
                ,
                = succeed "," do
                  %em Duality for Topological Modular Forms
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1105.3968"} arXiv:1105.3968
            %li#HeardStojanoska14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Drew+Heard"}> Drew Heard
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vesna+Stojanoska"} Vesna Stojanoska
                %em K-theory, reality, and duality
                (
                %a{:href => "http://arxiv.org/abs/1401.2581"}> arXiv:1401.2581
                )
          %p
            Discussion in the context of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %a.existingWikiWord{:href => "/nlab/show/quantum+logic"} quantum logic
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            is in
          %ul
            %li#Abramsky09
              %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
              ,
              = succeed "," do
                %em No-Cloning in categorical quantum mechanics
              %em Semantic Techniques for Quantum Computation
              , Cambridge University Press (
              %a{:href => "http://arxiv.org/abs/0910.2401"}> arXiv:0910.2401
              )
        .revisedby
