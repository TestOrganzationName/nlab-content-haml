                        \\,,
              %li
                %p
                  and whose unary Lie bracket is given by the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} }
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \{-\} = \mathbf{d}
            %p
              This means that the
              = succeed "-extended" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.maruku-ref{:href => "#ExtendedHamiltonEquations"}
              reads in terms of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
              equivalently thus (
              %a{:href => "#hgp13"}> hgp 13, remark 2.5.10
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mo ±
                    %mo{:stretchy => "false"} {
                    %mi H
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{v_1, \cdots, v_n\} = \pm\{H\}
                    \\,.
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            to be regarded as a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} E \to \Sigma
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            are in fact
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            (which is always true locally). Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi j
                    %mn 1
                  %mi E
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} (j^1 E)^\ast
            for the coreresponding dual
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %a.existingWikiWord{:href => "/nlab/show/n-plectic+form"} n-plectic form
            which in local coordinates reads
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ≔
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msubsup
                    %mi p
                    %mi a
                    %mi i
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi q
                    %mi a
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mrow
                      %msub
                        %mo ∂
                        %mi i
                  %msub
                    %mi vol
                    %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\omega
                  \\coloneqq
                  \\mathbf{d}p^i_a \wedge \mathbf{d}q^a \wedge (\iota_{\partial_i} vol_\Sigma)
          %p
            as discussed at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔭𝔬𝔦𝔰
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{pois}(X,\omega)
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %mi 𝔭𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi j
                      %mn 1
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \longrightarrow \mathfrak{pois}((j^1 E)^\ast, \omega)
            %p
              which induce the canonical map under the projection to vector fields on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              are
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalently
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              consisting of
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                      %annotation{:encoding => "application/x-tex"} v_i
            %p
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi j
                        %mn 1
                      %mi E
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (j^1 E)^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_i)
              satisfy the
              %span.newWikiWord
                de Donder-Weyl equation
                %a{:href => "/nlab/new/de+Donder-Weyl+equation"} ?
              for
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_1 \cdots v_n} \omega = \pm \mathbf{d}H
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+element"} Maurer-Cartan element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                    %mo ∈
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi 𝔭𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{J}
                    \\in
                    \\wedge^\bullet(\mathbb{R}^n) \otimes \mathfrak{pois}(X,\omega)
            %p
              of total degree 1, which satifies the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo !
                    %mo{:stretchy => "false"} {
                    %msub
                      %munder
                        %mrow
                          %mi 𝒥
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %mi 𝒥
                        %mo ⏟
                      %mrow
                        %mi k
                        %mspace{:width => "thickmathspace"}
                        %mi factors
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_k \frac{1}{k!}\{\underbrace{\mathcal{J}\wedge \cdots \wedge \mathcal{J}}_{k\; factors}\}
                    \= 0
                    \\,.
            %p
              If we suggestively write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}\sigma^i
              for the generators of the
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \wedge^\bullet(\mathbb{R}^n)
              = succeed "," do
                %a.maruku-ref{:href => "#nExtendedHamiltonEquationAsLInfinityRelation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \mathcal{J}
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi i
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %msub
                      %mi J
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                    %mo ⊗
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %msub
                          %mi i
                          %mn 2
                    %mo +
                    %mi ⋯
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi n
                    %mo ⊗
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{J}
                    \=
                    \\mathbf{d}\sigma^i \otimes (v_i, J_i)
                    +
                    \\mathbf{d}\sigma^{i_1} \wedge \mathbf{d}\sigma^{i_2}
                    \\otimes J_{i_1 i_2}
                    +
                    \\cdots
                    +
                    \\mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^n
                    \\otimes
                    H
                    \\,,
            %p
              where the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i
              are vector fields on the extended phase space,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi i
                          %mi k
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi j
                      %mn 1
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J_{i_1 \cdots i_k} \in \Omega^{n-k}((j^1 E)^\ast)
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a smooth function. Again by remark
              = succeed "," do
                %a.maruku-ref{:href => "#nExtendedHamiltonEquationAsLInfinityRelation"}
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
              on this element is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                    %mi ⋯
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi i
                              %mi k
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi i
                          %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_{i_1}} \cdots \iota_{v_{i_k}} \omega
                    \=
                    \\pm
                    \\mathbf{d} J_{i_1 \cdots i_k}
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \leq k \leq n-1
              and all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi i
                        %mi j
                      %msubsup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi j
                          %mo =
                          %mn 1
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \{i_j\}_{j = 1}^k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ⋯
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi n
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_{1}} \cdots \iota_{v_{n}} \omega
                    \=
                    \\pm
                    \\mathbf{d} H
                    \\,.
            %p The condition on the projection means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo =
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi j
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi j
                          %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_i = \frac{\partial}{\partial\sigma^i}
                    +
                    \\frac{\partial \phi^a}{\partial \sigma^i}
                    \\frac{\partial }{\partial \phi^a}
                    +
                    \\frac{\partial \phi^a_{,j}}{\partial \sigma^i}
                    \\frac{\partial }{\partial \phi^a_{,j}}
                    \\,.
            %p
              This way the last equation is the
              = succeed "." do
                %span.newWikiWord
                  de Donder-Weyl equation
                  %a{:href => "/nlab/new/de+Donder-Weyl+equation"} ?
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi i
                          %mi k
                    %mo ≔
                    %mo ±
                    %mi H
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                        %mi ⋯
                        %msub
                          %mo ∂
                          %mrow
                            %msub
                              %mi i
                              %mi k
                    %msub
                      %mi vol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    J_{i_1 \cdots i_k}
                    \\coloneqq
                    \\pm H \iota_{\partial_{i_1} \cdots \partial_{i_k}} vol_\Sigma
          %p
            We can further interpret this in
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            as follows:
          .num_remark
            %h6#remark_2 Remark
            %p
              By (
              %a{:href => "#hgp13"}> hgp 13
              ) the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
              of the smooth
              %a.existingWikiWord{:href => "/nlab/show/automorphism+n-group"} automorphism n-group
              of any
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              by a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ∇
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ω
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi F
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{\nabla}{\longrightarrow}&amp; \mathbf{B}^n U(1)_{conn}
                    \\\
                    \&amp; {}_{\mathllap{\omega}}\searrow &amp; \downarrow^{\mathrlap{F_{(-)}}}
                    \\\
                    \&amp;&amp; \mathbf{\Omega}^n_{cl}
                    }
            %p
              regarded as an object in the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi n
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}^n U(1)_{conn}}
              of that
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    QuantMorph(X,\nabla) = \mathbf{Aut}_{\mathbf{H}_{/\mathbf{B}^n U(1)_{conn}}}(\nabla)
                    \\,.
            %p
              In terms of this
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integrated
              perspective, remark
              %a.maruku-ref{:href => "#nExtendedHamiltonEquationAsLInfinityRelation"}
              says that
              = succeed "-Hamitlonian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/n-morphisms"} n-morphisms
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mo )
                      %mrow
                        %msub
                          %mo □
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \left(\mathbf{H}_{/\mathbf{B}^n U(1)_{conn}}\right)^{\Box_n}
              whose faces carry trivial labels.
            %p
              Here for instance for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              a
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mo )
                      %mrow
                        %msub
                          %mo □
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \left(\mathbf{H}_{/\mathbf{B}^2 U(1)_{conn}}\right)^{\Box_2}
              looks, “viewed from the top”, like a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mo ∇
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mo ∇
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \stackrel{}{\longrightarrow} &amp;&amp; X
                    \\\
                    \&amp; {}_{\mathllap{\nabla}}\searrow &amp;&amp; \swarrow_{\mathrlap{\nabla}}
                    \\\
                    \\downarrow &amp;&amp; \mathbf{B}^2 U(1)_{conn} &amp;&amp; \downarrow
                    \\\
                    \&amp;  {}^{\mathllap{\nabla}}\nearrow &amp;&amp; \nwarrow^{\mathrlap{\nabla}}
                    \\\
                    X &amp;&amp; \underset{}{\longrightarrow} &amp;&amp; X
                    }
            %p
              with a big 3-
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              filling this pyramid.
            %p
              The equation of remark
              %a.maruku-ref{:href => "#nExtendedHamiltonEquationAsLInfinityRelation"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
              exhibiting an infinitesimal such situation.
            %p
              More in detai: the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{pois}(X,\omega)
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              which in simplicial degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              has as elements the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+elements"} Maurer-Cartan elements
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi 𝔭𝔬𝔦𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} omgea
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Sigma_n)\otimes \mathfrak{pois}(X,\omgea)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi n
                    %mo =
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma_n = \Delta^n
              is the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (with boundaries and corners).
            %p
              Write then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}\sigma^i
              for the canonical
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              of 1-forms on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Sigma_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi i
                    %mo ⊗
                    %msub
                      %mi v
                      %mi i
                    %mo +
                    %mi vol
                    %mo ⊗
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \=
                    \\mathbf{d}\sigma^i \otimes v_i
                    +
                    vol \otimes H
                    \\,.
            %p
              This satisfying the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}A + [A] +  [A \wedge A] + [A\wedge A \wedge A] + \cdots = 0
            %p then is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi v
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %msub
                      %munder
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mn 1
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mi n
                        %mo ⏟
                      %mrow
                        %mo =
                        %mi vol
                    %mo ⊗
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    [\mathbf{d}\sigma^1 \otimes v_1 \wedge \cdots \wedge \mathbf{d}\sigma^1 \otimes v_1]
                    +
                    \\underbrace{
                    \\mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^n
                    }_{= vol}
                    \\otimes [H]
                    \= 0
            %p which is again the de Donder-Weyl-Hamilton equation of motion.
          #HDWAsMaurerCartan.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a pre-
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+manifold"} n-plectic manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega)
              the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
              then
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ⟶
                    %mi 𝔭𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^k \longrightarrow \mathfrak{pois}(X,\omega)
            %p
              are in bijection to tuples consisting of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_1, \cdots, v_k)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi i
                          %mi l
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{J_{i_1 \cdots i_l}\}
              and a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mn 1
                              %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi i
                              %mi l
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mi J
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi i
                          %mi l
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_{1_1} \cdots v_{i_l}} \omega = \pm \mathbf{d} J_{i_1 \cdots i_l}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mn 1
                              %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi i
                              %mi n
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_{1_1} \cdots v_{i_n}} \omega = \pm \mathbf{d} H
            %p holds.
          %p
            The following is the higher/local analog of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+Noether+theorem"} symplectic Noether theorem
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            a pre-
            %a.existingWikiWord{:href => "/nlab/show/n-plectic+manifold"}> n-plectic manifold
            , (…)
          %p
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \in C^\infty(X)
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            to be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+Hamiltonian"} de Donder-Weyl Hamiltonian
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v_1, \cdots, v_n)
            be a Hamiltonian
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.maruku-ref{:href => "#kTuplesOfCommutingDWFlows"}
            this corresponds to an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            map of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mi 𝔭𝔬𝔦𝔰
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((v_1, \cdots, v_n), H)
                  \\;\colon\;
                  \\mathbb{R}[n-1] \longrightarrow \mathfrak{pois}(X,\omega)
                  \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (higher symplectic Noether theorem)
            %p
              The extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((v_1, \cdots, v_n), H)
              to a homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo ,
                    %msub
                      %mi v
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi H
                    %mo ,
                    %mi J
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊕
                    %mi ℝ
                    %mo ⟶
                    %mi 𝔭𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ((v_1, \cdots, v_n, v_0), H, J, \{K_i\})
                    \\;\colon\;
                    \\mathbb{R}[n-1]\oplus \mathbb{R}
                    \\longrightarrow
                    \\mathfrak{pois}(X,\omega)
            %p
              is equivalently the choice of a vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v_0
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_0} \mathbf{d}H
                    \=
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 0
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_0} \omega = \pm \mathbf{d}J
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_1 \cdots v_n} \omega = \pm \mathbf{d}H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mrow
                            %mi i
                            %mo −
                            %mn 1
                        %msub
                          %mi v
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                        %msub
                          %mi v
                          %mn 0
                    %mi ω
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi K
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_1 \cdots v_{i-1} v_{i+1} \cdots v_n v_0} \omega
                    \=
                    \\mathbf{d} K^i
