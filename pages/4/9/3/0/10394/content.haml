                        %mi ⋯
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi v
                              %mn 1
                        %mi ω
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        [(v_1, A_1), \cdots, (v_n,A_n)]
                        \=
                        \\pm
                        \\iota_{v_n}\cdots \iota_{v_1} \omega
                        \\;\;\;
                        \\in
