          %h2#idea Idea
          %p
            A
            %em
              Hamiltonian
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            is the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            as one passes from
            %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
            to
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of a Hamiltonian
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            out of an
            = succeed "-manifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
          %h2#definition Definition
          #ExtendedHamiltonEquations.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              equipped with a degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{n+1}(X)
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              regarded as a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/multisymplectic+manifold"} multisymplectic manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-plectic+manifold"} n-plectic manifold
            %p
              Let moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} H \;\colon\; X \longrightarrow \mathbb{R}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+function"} Hamiltonian function
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+Hamiltonian"} de Donder-Weyl Hamiltonian
            %p
              Then a
              %em
                Hamiltonian
                = succeed "-vector" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/multivector+field"} multivector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi v
                    %mo ∈
                    %mi Γ
