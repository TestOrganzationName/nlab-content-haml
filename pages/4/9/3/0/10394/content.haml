                    \\,.
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              to be regarded as a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \to \Sigma
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are in fact
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              (which is always true locally). Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mn 1
                    %mi E
                  %annotation{:encoding => "application/x-tex"} j^1 E
              for the corresponding jet bundle]], equipped with the canonical “kinetic”
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+form"} n-plectic form
              which in local coordinates reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ≔
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi v
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mo ∧
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi v
                    %msup
                      %mi q
                      %mi a
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi i
                    %msub
                      %mi vol
                      %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\coloneqq
                    \\mathbf{d}_v\phi^a_{,i} \wedge \mathbf{d}_v q^a \wedge (\iota_{\partial_i} vol_\Sigma)
            %p
              as discussed at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \phi^a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \phi^a_{,i}
              smooth functions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              and for vector fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo ≔
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi j
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi j
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi i
                          %mi a
                  %annotation{:encoding => "application/x-tex"}
                    v_i
                    \\coloneqq
                    \\frac{\partial}{\partial \sigma^i}
                    +
                    \\frac{\partial \phi^a}{\partial \sigma^i}
                    +
                    \\frac{\partial \phi^a_{,j}}{\partial \sigma^j}
                    \\frac{\partial}{\partial \phi^a_{,i}}
            %p the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                    %mi ω
                    %mo =
                    %mo ±
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_1 \cdots v_n} \omega = \pm \mathbf{d}H
            %p
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+equations"} de Donder-Weyl equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi H
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi p
                          %mi a
                          %mi i
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi p
                          %mi a
                          %mi i
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi H
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial \phi^a}{\partial \sigma^i}
                    \=
                    \\frac{\partial H}{\partial p^i_a}
                    \\;\;\;\;
                    \\frac{\partial p^i_a}{\partial \sigma^i}
                    \=
                    \\frac{\partial H}{\partial \phi^a}
                    \\,.
          .proof
            %h6#proof Proof
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi v
                    %msup
                      %mi ϕ
                      %mi a
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi ϕ
                      %mi a
                    %mo −
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}_v \phi^a = \mathbf{d}\phi^a - \phi^a_{,i}\mathbf{d}\sigma^i
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi v
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mo −
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                        %mi j
                      %mi a
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}_v \phi^a_{,i}
                    \=
                    \\mathbf{d}\phi^a_{,i}
                    \-
                    \\phi^a_{,i j} \mathbf{d}\sigma^j
                    \\,.
            %p
              The claimed equation comes from contracting in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi ϕ
                      %mi a
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi i
                    %msub
                      %mi vol
                      %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}\phi^a_{,i} \wedge \mathbf{d}\phi^a \wedge (\iota_{\partial_i}vol_\Sigma)
              all but the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mi i
                        %mo ∂
                        %msup
                          %mi σ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi j
                    %mfrac
                      %mrow
                        %mo ∂
                        %msub
                          %mi ϕ
                          %mi a
                      %mrow
                        %mo ∂
                        %msup
                          %mi σ
                          %mrow
                            %mi i
                            %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial \phi^a}{\partial \sigma^i \partial \sigma^{[j}}
                    \\frac{\partial \phi_a}{\partial \sigma^{i]}}
                    \\mathbf{d}\sigma^j
            %p and these cancel against the horizontal derivative contributions form above.
          %h2#InterpretationInHigherGeometry Interpretation in higher geometry
          %p
            We discuss here how Hamiltonian
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
            associated with the given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
          #nExtendedHamiltonEquationAsLInfinityRelation.num_remark
            %h6#remark Remark
            %p
              By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+manifold"} n-plectic manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              induces a
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔭𝔬𝔦𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{pois}(X,\omega)
            %ul
              %li
                %p
                  in positive degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  it has the degree
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
