                    %msup
                      %mo ∧
                      %mi n
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{v} \in \Gamma(\wedge^{n} T X)
              satisfying the analog of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations"} Hamilton's equations
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mstyle{:mathvariant => "bold"}
                        %mi v
                    %mi ω
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
