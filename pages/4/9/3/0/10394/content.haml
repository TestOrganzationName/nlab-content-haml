                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-k)
                  %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  in degree 0 it has pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (v,A)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+n-forms"} Hamiltonian n-forms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  with their
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  (such that
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi A
                          %mo =
                          %msub
                            %mi ι
                            %mi v
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}A = \iota_v \omega
            %p and
            %ul
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} n-ary Lie bracket
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \geq 2
                  is non-trivial only on
                  = succeed "-tuples" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi A
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mi n
                        %mo ,
                        %msub
                          %mi A
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo ±
                        %msub
                          %mi ι
                          %mrow
