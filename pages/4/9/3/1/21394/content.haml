          .num_defn
            %h6#notation Notation
            %p
              Given a cylinder functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℰ
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} C \colon \mathcal{E} \to \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Id
                      %mi ℰ
                    %mo +
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Id
                      %mi ℰ
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \partial \colon Id_{\mathcal{E}} + \Id_{\mathcal{E}} \to C
              for the
              %a.existingWikiWord{:href => "/nlab/show/copairing"} copairing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi δ
                        %mn 0
                      %mo ,
                      %msub
                        %mi δ
                        %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \partial = [\delta_0,\delta_1]
          .num_defn
            %h6#WFSCylindrical Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊣
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C \dashv P
              be an adjoint functorial cylinder on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is
              %strong cylindrical
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is closed under the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product#PushoutApplication"} pushout application
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ev
                        %mo ^
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi ℰ
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo →
                      %msup
                        %mi ℰ
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \widehat{ev}(\partial,-) \colon \mathcal{E}^{\mathbf{2}} \to \mathcal{E}^{\mathbf{2}}
          .num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊣
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C \dashv P
              be an adjoint functorial cylinder on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %strong cylindrical
              when (C,AF) and (AC,F) are cylindrical and the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product#PushoutApplication"} pushout applications
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ev
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mn 0
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mover
                      %mi ev
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℰ
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo →
                    %msup
                      %mi ℰ
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \widehat{ev}(\delta_0,-), \widehat{ev}(\delta_1,-) \colon \mathcal{E}^{\mathbf{2}} \to \mathcal{E}^{\mathbf{2}}
              send cofibrations to anodyne cofibrations.
          .num_defn
            %h6#note Note
            %p
              This notion is distinct from
              %a.existingWikiWord{:href => "/nlab/show/Richard+Williamson"} Richard Williamson's
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cylinder+functor#CylindricalModelStructures"} cylindrical model structures
          %p
            In a cylindrical premodel structure, the first condition of Proposition
            %a.maruku-ref{:href => "#CriteriaCases"}
            implies the second (
            %a{:href => "#csElegance"}> Cavallo &amp; Sattler 2022, Lemma 3.22
            ), yielding a simplified recognition theorem:
          #CriteriaCasesCylindrical.num_prop
            %h6#proposition_2 Proposition
            %p
              In a cylindrical premodel category,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              satisfies the 2-out-of-3 property if and only if the following conditions are satisfied:
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ,
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g,f
                  are cofibrations such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g f
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  are anodyne cofibrations, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is an anodyne cofibration. If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ,
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g,f
                  are fibrations such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g f
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  are anodyne fibrations, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is an anodyne fibration.
              %li
                %p
                  Any composite of an anodyne fibration followed by an anodyne cofibration is in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
