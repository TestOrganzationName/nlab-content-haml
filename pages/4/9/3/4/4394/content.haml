              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular
          %p
          .proof
            %h6 Proof
            %p
              %strong
                %a{:href => "#regular1"} (1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇔
                    %annotation{:encoding => "application/x-tex"} \iff
                = succeed ":" do
                  %a{:href => "#regular2"} (2)
              Given a neighborhood base for a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
