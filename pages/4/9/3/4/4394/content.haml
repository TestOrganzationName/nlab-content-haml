              if one of the two equivalent conditions
              %a{:href => "#regular1"} (1)
              and
              %a{:href => "#regular2"} (2)
              from proposition
              %a.maruku-ref{:href => "#implications"}
              holds. A bitopological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
