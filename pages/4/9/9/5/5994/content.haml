                          %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation in generalized cohomology
                      %tr
                        %td{:style => "text-align: left;"}
                          %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
                        %td{:style => "text-align: left;"}
                          (
                          %a.existingWikiWord{:href => "/nlab/show/virtual+fundamental+class"}> virtual
                          )
                          %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
                      %tr
                        %td{:style => "text-align: left;"}
                          %a.existingWikiWord{:href => "/nlab/show/Riemann+integration"}> Riemann
                          \/
                          %a.existingWikiWord{:href => "/nlab/show/Lebesgue+integration"} Lebesgue integration
                          %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} of differential forms
                        %td{:style => "text-align: left;"}
                          %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"}> push-forward in generalized cohomology
                          \/
                          %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+differential+cohomology"} in differential cohomology
                  %h2#analytic_integration Analytic integration
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/integral+calculus"} integral calculus
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Riemann+integration"}> Riemann integration
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/Lebesgue+integration"} Lebesgue integration
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/line+integral"}> line integral
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/contour+integration"} contour integration
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"}> integration over supermanifolds
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Berezin+integral"} Berezin integral
                    %a.existingWikiWord{:href => "/nlab/show/fermionic+path+integral"} fermionic path integral
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Kontsevich+integral"}> Kontsevich integral
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Selberg+integral"} Selberg integral
                    %a.existingWikiWord{:href => "/nlab/show/elliptic+Selberg+integral"} elliptic Selberg integral
                  %h2#cohomological_integration Cohomological integration
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/integration+in+ordinary+differential+cohomology"} integration in ordinary differential cohomology
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/integration+in+differential+K-theory"} integration in differential K-theory
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Riemann-Roch+theorem"} Riemann-Roch theorem
                  %h2#variants Variants
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Batalin-Vilkovisky+integral"} Batalin-Vilkovisky integral
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#setup"} Setup
              %li
                %a{:href => "#pfaffian_bundles"} Pfaffian bundles
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            over the
            = succeed "ic" do
              %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/spinors+in+Yang-Mills+theory"} spinors in Yang-Mills theory
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
            of the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
          %h2#setup Setup
          %p
            For definiteness, we consider a
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            on a worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
            target
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with fields
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/boson"}> boson
                s:
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fermion"}> fermion
                s (
                %a.existingWikiWord{:href => "/nlab/show/gravitino"}> gravitino
                ):
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∈
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msup
                          %mi ϕ
                          %mo *
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \psi \in \Gamma(S(\Sigma) \otimes \phi^* T X)
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                of a
                %a.existingWikiWord{:href => "/nlab/show/spinor+bundle"} spinor bundle
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                and the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                of the
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                along the given bosonic field
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msup
                    %mi S
                    %mi bos
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msubsup
                    %mi S
                    %mi ϕ
                    %mi ferm
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S : (\phi, \psi) \mapsto S^{bos}(\phi) + S^{ferm}_{\phi}(\psi)
          %p is the sum of the
          %ul
            %li
              %p bosonic action
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi bos
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi Σ
                      %mo{:stretchy => "false"} ⟨
                      %mi d
                      %mi ϕ
                      %mo ∧
                      %mo ⋆
                      %mi d
                      %mi ϕ
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      S^{bos}(\phi)
                      \=
                      \\int_\Sigma \langle d \phi \wedge \star d \phi\rangle
            %li
              %p fermionic action
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi S
                        %mi ϕ
                        %mi ferm
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi Σ
                      %mo{:stretchy => "false"} ⟨
                      %mi ψ
                      %mo ,
                      %msub
                        %mi D
                        %mi ϕ
                      %mi ψ
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      S^{ferm}_\phi(\psi)
                      \= \int_\Sigma \langle \psi, D_\phi \psi\rangle
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi ϕ
                    %annotation{:encoding => "application/x-tex"} D_\phi
                is a
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊗
                      %msup
                        %mi ϕ
                        %mo *
                      %mi T
                      %mi M
                    %annotation{:encoding => "application/x-tex"} S \otimes \phi^* T M
                (the Dirac operator on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                twisted by the pullback of the
                %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T^* X
                ).
          %p
            One imagines than that the hypothetical
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            symboilically written as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ϕ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ψ
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\int [d \phi] [d \psi] \exp(S(\psi)(\phi,\psi))
          %p can be computed in two steps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo =
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ϕ
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi bos
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo (
                    %mo ∫
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mi ψ
                    %mo{:stretchy => "false"} ]
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi S
                      %mi ϕ
                      %mi ferm
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\cdots = \int [d \phi] \exp(S^{bos}(\phi))
                  \\left(
                  \\int [d \psi]
                  \\exp(S^{ferm}_\phi(\psi))
                  \\right)
          %p by first computing the integral over the fermions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pfaff
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ψ
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi S
                    %mi ϕ
                    %mi ferm
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  pfaff(\phi)
                  \:=
                  \\int [d \psi]
                  \\exp(S^{ferm}_\phi(\psi))
          %p
            and then inserting this into the remaining bosonic integral. Now, as opposed to the bosonic integral, this fermionic integral can be given well-defined sense by interpreting it as an infinite-dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
          %p
            However, while this makes the expression well defined, the result is not quite a function of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pfaff
                %annotation{:encoding => "application/x-tex"} pfaff
            of a
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Pfaff
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi pfaff
                              %mo :
                              %mo =
                              %msubsup
                                %mi Z
                                %mi eff
                                %mi ferm
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Pfaff
                  \\\
                  {}^{pfaff := Z_{eff}^{ferm}}\nearrow &amp; \downarrow
                  \\\
                  C^{\infty}(\Sigma, X)
                  \&amp;= &amp;  C^{\infty}(\Sigma, X)
                  }
          %p over the space of bosonic field configurations.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pfaff
                %annotation{:encoding => "application/x-tex"} Pfaff
            is not isomorphic to the trivial line bundle, we say the system has a fermionic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pfaff
                %annotation{:encoding => "application/x-tex"} Pfaff
            is trivializable, any choice of trivialization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mi Paff
                  %mover
                    %mo →
                    %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"}
                  t : Paff \stackrel{\simeq}{\to} C^\infty(\Sigma, X) \times \mathbb{C}
          %p makes the fermionic path integral into a genuine function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Z
                    %mi eff
                    %mi ferm
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ∘
                  %mi pfaff
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Z_{eff}^{ferm}
                  \: =
                  (t \circ pfaff) :
                  C^\infty(\Sigma, X) \to \mathbb{C}
                  \\,.
          %p
            Any such choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            is called a choice of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+integrand"} quantum integrand
          %p With this one can then try to enter the remaining bosonic path integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ϕ
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi bos
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi Z
                    %mi eff
                    %mi ferm
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\int [d \phi] \exp(S^{bos}(\phi)) Z_{eff}^{ferm}(\phi)
          %h2#pfaffian_bundles Pfaffian bundles
          %blockquote
            %p
              We are implicitly assuming that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi Σ
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} dim \Sigma = 2
              or maybe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 8
                    %mi n
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 8 n + 2
              in the following. Needs to be generalized.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            of the determinant of a skew symmetric
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ×
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n\times n)
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            – the
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
            of the matrix – can be understood as the
            %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pfaff
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mover
                    %mi θ
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} ⟨
                  %mi θ
                  %mo ,
                  %mi D
                  %mi θ
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi det
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  pfaff(D)
                  \=
                  \\int [d \vec \theta]
                  \\exp( \langle \theta , D \theta\rangle)
                  \\in
                  det \mathbb{R}^n
          %p
            over the
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \theta_i
            %a.existingWikiWord{:href => "/nlab/show/determinant+line"} determinant line
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            instead depends on a parameter
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
          %p
            We now generalize this to the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is not a finite-dimensional matrix, but a
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            acting on spaces of sections of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spinor+bundle"} spinor bundle
            %em locally
            to a finite dimensional one in a consistent way, such that the above ordinary construction of Pfaffians applies.
          %p In the above setup, write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mo ±
                  %mo :
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mo ±
                  %mo ⊗
                  %msup
                    %mi ϕ
                    %mo *
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}_\phi^{\pm} := \Gamma(S^{\pm} \otimes \phi^* T^* X)
          %p
            for the space of spinor sections for given
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mo ±
                  %mo :
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mo ±
                  %mo →
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mo ∓
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_\phi^{\pm} : \mathcal{H}_\phi^{\pm} \to \mathcal{H}^{\mp}_\phi
                  \\,.
          %p We also have a “quaternionic structure”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi J
                    %mi ϕ
                    %mo ±
                  %mo :
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mo ±
                  %mo →
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mo ∓
                %annotation{:encoding => "application/x-tex"}
                  J_\phi^{\pm} : \mathcal{H}_\phi^{\pm} \to \mathcal{H}^{\mp}_\phi
          %p
            Define then an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            of the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma,X)
            of the space of bosonic fields with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/open+set"} open set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi μ
                %annotation{:encoding => "application/x-tex"} U_\mu
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ≤
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0 \leq \mu)
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi μ
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ϕ
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi μ
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} nin
                  %mi Spec
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mn 2
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  U_\mu := \{ \phi \in C^\infty(\Sigma,X)  | \mu \nin Spec D_\phi^2\}
                  \\,,
          %p
            hence the collection of bosonic field configurations such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is not in the
            %a.existingWikiWord{:href => "/nlab/show/operator+spectrum"} operator spectrum
            of the squared
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
          %p
            Over these open subsets we have the
            %em finite
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mrow
                      %mi μ
                      %mo ±
                  %mo :
                  %mo =
                  %msub
                    %mo ⊕
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi ϵ
                      %mo ≤
                      %mi μ
                  %mi Eig
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mn 2
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}_\phi^{\mu \pm}
                  \:=
                  \\oplus_{0 \leq \epsilon \leq \mu}
                  Eig(D_\phi^2, \epsilon)
          %p
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} D_\phi^2
            for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
          %p The Dirac operator that we are interested in is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mi μ
                  %mo :
                  %mo =
                  %msubsup
                    %mi J
                    %mi ϕ
                    %mo −
                  %mo ∘
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mo +
                  %mo :
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mrow
                      %mi μ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo →
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mrow
                      %mi μ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_\phi^\mu
                  \:=
                  J_\phi^- \circ D_\phi^+ : \mathcal{H}_\phi^{\mu,+} \to \mathcal{H}_\phi^{\mu,+}
                  \\,.
          %p
            This defines now a finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mi μ
                  %mo −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\langle -, D_\phi^\mu -\rangle
          %p
            whose
            %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
            is the
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi ψ
                  %mo{:stretchy => "false"} ]
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} ⟨
                  %mi ψ
                  %mo ,
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mi μ
                  %mi ψ
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi pfaff
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi D
                    %mi ϕ
                    %mi μ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi det
                  %msubsup
                    %mi ℋ
                    %mi ϕ
                    %mrow
                      %mi μ
                      %mi π
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int [d \psi] \exp(\langle \psi , D^\mu_\phi \psi \rangle )
                  \=
                  pfaff(D^\mu_\phi) \in det \mathcal{H}^{\mu \pi}_\phi
                  \\,.
          %p
            One shows that these constructions for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            glue together to define
          %ul
            %li
              %p
                a smooth
                %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pfaff
                      %mo →
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Pfaff \to C^\infty(\Sigma, X)
            %li
              %p
                with a smooth
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi pfaff
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} pfaff(D)
          %p
            Moreover, there is canonically a
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian metric
            and a canonical unitary
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            (the
            = succeed ")" do
              %span.newWikiWord
                Freed-Bismut connection
                %a{:href => "/nlab/new/Freed-Bismut+connection"} ?
          %h2#examples Examples
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            describing the
            %a.existingWikiWord{:href => "/nlab/show/brane"} heterotic superstring
            propagating on a
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            is related to the existence of a (twisted)
            %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
