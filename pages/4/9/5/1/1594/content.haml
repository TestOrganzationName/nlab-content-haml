                %a{:href => "https://arxiv.org/abs/1909.08699"}> arXiv:1909.08699
                \&amp;rbrack;
          %p See also:
          %ul
            %li
              %p
                Wikipedia:
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Orbifold"} Orbifolds
            %li
              %p
                Alanod Sibih:
                = succeed "," do
                  %em Orbifold Atlas Groupoids
                = succeed "&rbrack;" do
