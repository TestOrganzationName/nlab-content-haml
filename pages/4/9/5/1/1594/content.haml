          %h2#definition Definition
          %h3#DefinitionViaOrbifoldAtlases Via orbifold atlases
          %p
            The traditional definition of orbifolds, going back to
            = succeed ":" do
              %a{:href => "#Satake1956"} Satake 1956
          %p
          #OrbifoldDefinitionViaOrbifoldAtlas.num_defn
            %h6 Definition
            %p
              %strong (effective orbifold structure via orbifold atlas)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
            %ol
              %li
                %p
                  An
                  %em
                    orbifold
                    %a.existingWikiWord{:href => "/nlab/show/chart"} chart
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi G
                        %mo ↷
                        %mover
                          %mi U
                          %mo ^
                        %mo ,
                        %mi ϕ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \big(G \curvearrowright \widehat{U}, \phi\big)
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                      , the
                      = succeed "," do
                        %em dimension
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mover
                              %mi U
                              %mo ^
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \widehat U \subset \mathbb{R}^n
                      , a
                      %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi G
                            %mo ⊂
                            %mi Diff
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi U
                              %mo ^
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} G \subset Diff(\widehat{U})
                      , a
                      %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
                      of
                      %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
                      of
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mover
                                %mi U
                                %mo ^
                            %annotation{:encoding => "application/x-tex"} \widehat{U}
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi ϕ
                            %mo :
                            %mover
                              %mi U
                              %mo ^
                            %mo ⟶
                            %mi X
                          %annotation{:encoding => "application/x-tex"} \phi : \widehat{U} \longrightarrow X
                      , a
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi G
                            %annotation{:encoding => "application/x-tex"} G
                      %a.existingWikiWord{:href => "/nlab/show/equivariant"} invariant
                      %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                      such that:
                    %ol
                      %li
                        %p
                          its
                          %a.existingWikiWord{:href => "/nlab/show/image"} image
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi U
