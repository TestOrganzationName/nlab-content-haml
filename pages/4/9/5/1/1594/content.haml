            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Janez+Mr%C4%8Dun"} Janez Mrčun
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Introduction+to+foliations+and+Lie+groupoids"} Introduction to foliations and Lie groupoids
                %strong 91
                (2003) &amp;lbrack;ISBN: 0-521-83197-0,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511615450"} doi:10.1017/CBO9780511615450
            %li#BoyerGalicki07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Boyer"}> Charles Boyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Galicki"} Krzysztof Galicki
                = succeed "," do
                  %em Sasakian Geometry
                = succeed ")" do
                  %a{:href => "https://www.oxfordscholarship.com/view/10.1093/acprof:oso/9780198564959.001.0001/acprof-9780198564959"} doi:10.1093/acprof:oso/9780198564959.001.0001
            %li#Kaye07
              %p
                Adam Kaye,
                %em Two-Dimensional Orbifolds
                (2007) &amp;lbrack;
                %a{:href => "http://www.math.uchicago.edu/~may/VIGRE/VIGRE2007/REUPapers/FINALFULL/Kaye.pdf"}> pdf
                \&amp;rbrack;
            %li#CBG08
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+H.+Conway"}> John H. Conway
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Heidi+Burgiel"} Heidi Burgiel
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Chaim+Goodman-Strauss"} Chaim Goodman-Strauss
                = succeed "," do
                  %em Orbifolds
                = succeed "," do
                  %em The Symmetries of Things
                = succeed "&rbrack;" do
                  %a{:href => "https://www.routledge.com/The-Symmetries-of-Things/Conway-Burgiel-Goodman-Strauss/p/book/9781568812205"} ISBN:9781568812205
            %li
              %p
                Michael Davis,
                = succeed "," do
                  %em Lectures on orbifolds and reflection groups
                = succeed "&rbrack;" do
                  %a{:href => "https://math.osu.edu/sites/math.osu.edu/files/08-05-MRI-preprint.pdf"} pdf
            %li#Porti09
              %p
                Joan Porti,
                %em An introduction to orbifolds
                (2009) &amp;lbrack;
                %a{:href => "http://mat.uab.es/~porti/orbifoldLeiden.pdf"}> pdf
                \&amp;rbrack;
            %li#Snowden11
              %p
                Andrew Snowden:
                %em Introduction to orbifolds
                (2011) &amp;lbrack;
                %a{:href => "https://ocw.mit.edu/courses/18-904-seminar-in-topology-spring-2011/resources/mit18_904s11_finlorbifolds/"}> webpage
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Snowden-Orbifolds.pdf", :title => "pdf"} pdf
            %li#AdemKlaus
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alejandro+Adem"}> Alejandro Adem
                , Michele Klaus,
                %em Lectures on orbifolds and group cohomology
                (
                %a{:href => "http://www.math.ubc.ca/~adem/hangzhou.pdf"}> pdf
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/AdemKlausOrbifolds.pdf", :title => "pdf"} pdf
            %li
              %p
                Francisco C. Caramello Jr:
