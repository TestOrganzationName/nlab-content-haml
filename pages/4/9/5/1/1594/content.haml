              %blockquote
                %p
                  (on the relation to
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/orbispaces"} orbispaces
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+stacks"} topological stacks
          %h3#ReferencesAsDiffeologicalSpaces As diffeological spaces
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
            regarded as naive local
            %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
            (instead of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotients"} homotopy quotients
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
          %ul
            %li#IKZ10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Patrick+Iglesias-Zemmour"}> Patrick Iglesias-Zemmour
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yael+Karshon"} Yael Karshon
                = succeed "," do
                  %em Orbifolds as diffeologies
                %strong
                  %a{:href => "https://www.ams.org/journals/tran/2010-362-06/"} 362
                (2010) 2811-2831 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0501093"}> arXiv:math/0501093
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.ams.org/journals/tran/2010-362-06/S0002-9947-10-05006-3"} doi:10.1090/S0002-9947-10-05006-3
            %li#Watts15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jordan+Watts"}> Jordan Watts
                ,
                = succeed "," do
                  %em The Differential Structure of an Orbifold
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1503.01740"} arXiv:1503.01740
          %p
