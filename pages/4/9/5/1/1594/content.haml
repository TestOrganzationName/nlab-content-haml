              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Orbifolds+in+Mathematics+and+Physics"} Orbifolds in Mathematics and Physics
              = succeed "," do
                %strong 310
              = succeed "&rbrack;" do
                %a{:href => "https://bookstore.ams.org/conm-310"} ISBN:978-0-8218-2990-5
