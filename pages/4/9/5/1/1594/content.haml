          %p
          #IsotropyActionOfTraditionalOrbiDefinitionIsEffective.num_remark
            %h6 Remark
            %p
              The assumption in Def.
              %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              that the orbi-chart groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of the
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism+group"} diffeomorphism group
              implies that their
              %a.existingWikiWord{:href => "/nlab/show/group+action"} action
              on the chart is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+group+action"} effective
              %em effective orbifolds
              to distinguish this original definition from the more relaxed one where the chart actions are only required to be through any
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ⟶
                      %mi Diff
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mover
                        %mi U
                        %mo ^
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} G \longrightarrow Diff\big(\widehat{U}\big)
          %p
            The above definition
            %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
            does not explicitly require that chart embeddings be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+maps"} equivariant
            = succeed "):" do
              %a{:href => "#MoerdijkPronk99"} MP99 §1.1.1(i)
          %p
          #PairsOfOrbiChartEmbeddingsRelatedByGroupAction.num_lemma
            %h6 Lemma
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi G
                      %mn 1
                    %mo ↷
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ↪
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi G
                      %mn 2
                    %mo ↷
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 2
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_i
                    \\,\colon\,
                    \\big(G_1 \curvearrowright \widehat{U}_1, \phi_1\big)
                    \\hookrightarrow
                    \\big(G_2 \curvearrowright \widehat{U}_2, \phi_2\big)
            %p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
              = succeed ")," do
                %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                    %mo ∈
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_2 \in G_2
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mn 2
                    %mo =
                    %msub
                      %mi g
                      %mn 2
                    %mo ∘
                    %msub
                      %mi ι
                      %mn 1
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_2 = g_2 \circ \iota_1
                    \\mathrlap{\,.}
            %p
          .proof
            %h6 Proof
            %p By definition of chart embeddings, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo ∘
                    %msub
                      %mi ι
                      %mn 1
                    %mo =
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo =
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo ∘
                    %msub
                      %mi ι
                      %mn 2
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_2 \circ \iota_1
                    \=
                    \\phi_1
                    \=
                    \\phi_2 \circ \iota_2
                    \\mathrlap{\,.}
            %p
              By the orbi-chart property of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \phi_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x \in \widehat{U}_1
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_2(x)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi ι
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_2(x) = g_2(x) \circ \iota_1(x)
                    \\,,
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ^
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi g
                          %mn 2
                    %msub
                      %mi G
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{U} \overset{g_2}{\longrightarrow} G_2 \colon x \to g_2(x)
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p
              Finally, by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \widehat{U}_1
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
          %p
          .num_prop
            %h6 Proposition
            %p
              Given an embedding of orbifold charts (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi G
                      %mn 1
                    %mo ↷
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ↪
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi G
                      %mn 2
                    %mo ↷
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 2
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota
                    \\,\colon\,
                    \\big(G_1 \curvearrowright \widehat{U}_1, \phi_1\big)
                    \\hookrightarrow
                    \\big(G_2 \curvearrowright \widehat{U}_2, \phi_2\big)
            %p
              there exists a unique
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi G
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \colon G_1 \longrightarrow G_2
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ∈
                    %msub
                      %mi G
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g_1 \in G_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x \in \widehat{U}_1
            #eq:EquivarianceOfOrbiChartEmbedding.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota( g_1 \cdot x )
                    \\;=\;
                    \\iota(g_1) \cdot \iota(x)
                    \\,.
            %p
              Moreover, if the orbifold is effective (Rem.
              = succeed ")," do
                %a.maruku-ref{:href => "#IsotropyActionOfTraditionalOrbiDefinitionIsEffective"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} injective
          .proof
            %h6 Proof
            %p
              Noting that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∘
                    %msub
                      %mi g
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda \circ g_1
              is am embedding, Lem.
              %a.maruku-ref{:href => "#PairsOfOrbiChartEmbeddingsRelatedByGroupAction"}
              implies a unique
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_2
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 2
                      %mo ∘
                      %mi λ
                      %mo =
                      %mi λ
                      %mo ∘
                      %msub
                        %mi g
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} g_2 \circ \lambda = \lambda \circ g_1
            %p
              To see that this homomorphism is injective of the chart actions are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/effective+group+action"} effective group action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g_1
              is such that that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} e
                    %annotation{:encoding => "application/x-tex"} \iota(g_1) = \mathrm{e}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %mi{:mathvariant => "normal"} e
                    %annotation{:encoding => "application/x-tex"} g_1 = \mathrm{e}
              %a.maruku-eqref{:href => "#eq:EquivarianceOfOrbiChartEmbedding"} (1)
              just proven states that, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mover
                          %mi U
                          %mo ^
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x \in \widehat{U}_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota(g_1 \cdot x)
                    \=
                    \\iota(x)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding of smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} g_1 \cdot x = x
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mover
                          %mi U
                          %mo ^
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x \in \widehat{U}_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/effective+group+action"} effectiveness
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %mi{:mathvariant => "normal"} e
                    %annotation{:encoding => "application/x-tex"} g_1 = \mathrm{e}
          %p
          .num_remark
            %h6 Remark
            %p
              Every orbifold (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ,
                    %mover
                      %mi U
                      %mo ^
                    %mo ,
                    %mi ϕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big(G, \widehat{U}, \phi\big)
              are
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ^
                    %mo ≃
                    %msup
                      %mi 𝔻
                      %mi n
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \widehat{U} \simeq \mathbb{D}^n \subset \mathbb{R}^n
              equipped with an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear
              = succeed ".This" do
                %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metrics"} Riemannian metrics
              and the differential version of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/slice+theorem"} slice theorem
          (cf.
          = succeed ")" do
            %a{:href => "#MoerdijkPronk99"} MP99 §1.1.1(ii)
          %h3#DefinitionViaProperEtaleGroupoids Via proper étale groupoids
          %p
            Equivalently, an orbifold is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+stack"} smooth stack
            presented by an
            %a.existingWikiWord{:href => "/nlab/show/orbifold+groupoid"} orbifold groupoid
            \&amp;lbrack;
            %a{:href => "#MoerdijkPronk97"}> Moerdijk &amp; Pronk 1997
            ,
            = succeed "&rbrack;." do
              %a{:href => "#MoerdijkPronk99"} 1999
          %p
          #OrbifoldAsProperEtaleGroupoid.num_defn
            %h6 Definition
            %p
              An
              %em orbifold
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              which is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+groupoid"}> étale
                  \:
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/source"} source
                  map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s \colon Mor(\mathcal{G}) \longrightarrow Obj(\mathcal{G})
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphisms"} local diffeomorphisms
                  (as are then all the other structure maps),
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/proper+Lie+groupoid"}> proper
                  \:
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/source"} source
                  and
                  %a.existingWikiWord{:href => "/nlab/show/target"} target
                  maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (s,t) \colon Mor(\mathcal{G}) \longrightarrow Obj(\mathcal{G})
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              From the perspective of the traditional Definition
              %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              one may rather want to say that (cf.
              = succeed "):" do
                %a{:href => "#Moerdijk02"} Moerdijk 2002 §3.2
              %em orbifold structure
              on a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a choice of Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              as in Def.
              = succeed "," do
                %a.maruku-ref{:href => "#OrbifoldAsProperEtaleGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              from its space of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi{:mathvariant => "normal"} Mor
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ∼
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Obj(\mathcal{G})/\mathrm{Mor}(\mathcal{G}) \overset{\sim}{\longrightarrow} X
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is determined, up to homeomorphism, from the groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of orbifold structures in this sense is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of the corresponding
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
              (cf.
              = succeed ")" do
                %a{:href => "#Moerdijk02"} Moerdijk 2002 §3.3
          %p
          .num_remark
            %h6 Remark
            %p
              The main ingredient in the construction (cf.
              = succeed ")" do
                %a{:href => "#Amenta12"} Amenta 2012, Cor. 2.4.13
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldAsProperEtaleGroupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in the object space of a proper étale Lie groupoid has an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \subset Obj(\mathcal{G})
              on which the groupoid structure restricts to an
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⫽
                    %msub
                      %mi G
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \sslash G_x
              of the
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              %a.existingWikiWord{:href => "/nlab/show/isotropy+group"} isotropy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi x
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_x \coloneqq Hom_{\mathcal{G}}(x,x)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %a{:href => "#MoerdijkPronk97"} Moerdijk &amp; Pronk 1997, pp. 15
              = succeed ")" do
                %a{:href => "#Amenta12"} Amenta 2012, Thm. 2.4.11
            %p
              Conversely, the construction of a proper étale Lie groupoid (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldAsProperEtaleGroupoid"}
              = succeed ")" do
                %a.maruku-ref{:href => "#OrbifoldDefinitionViaOrbifoldAtlas"}
              = succeed "." do
                %a{:href => "#MoerdijkPronk99"} Moerdijk &amp; Pronk 1999, inside proof of Thm. 4.1.1
          %h2#properties Properties
          %h3#general General
          %ul
            %li
              %p
                One can consider a
                %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
                of proper étale Lie groupoids and the orbifolds will be the objects of certain bicategorical
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                of this bicategory (a result of
                = succeed ")." do
                  %a{:href => "#MoerdijkPronk97"} Moerdijk-Pronk 97
            %li
              %p
                Equivalently, every orbifold is globally a quotient of a smooth manifold by an
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of finite-dimensional
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                with finite
                %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizers
                in each point. (eg (
                %a{:href => "#ALR07"}> Adem-Leida-Ruan 2007
                ), Corollary 1.24)
          %h3#GlobalQuotientOrbifolds Global quotient orbifolds
          %p
            In (
            %a{:href => "#ALR07"}> ALR 07, theorem 1.23
            ) it is asserted that every effective orbifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (paracompact, Hausdorff) is isomorphic to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/global+quotient+orbifold"} global quotient orbifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is the dimension of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (which is a manifold).
          %h3#cohomology (Co)homology
          %p
            It has been noticed that the topological invariants of the underlying topological space of an orbifold as a topological space with an orbifold structure are not appropriate, but have to be corrected leading to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orbifold+Euler+characteristics"} orbifold Euler characteristics
            %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
            etc. One of the constructions which is useful in this respect is the
            %a.existingWikiWord{:href => "/nlab/show/inertia+orbifold"} inertia orbifold
            (the inertia stack of the original orbifold) which gives rise to “twisted sectors” in Hilbert space of a quantum field theory on the orbifold, and also to twisted sectors in the appropriate cohomology spaces. A further generalization gives multitwisted sectors.
          %h2#examples Examples
          %p
          #SignInvolutionOrbifoldOfNTorus.num_remark
            %h6 Example
            %p
              %strong
                (sign involution orbifold of the
                = succeed "-torus)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %br/
              A basic class of examples of closed
              %a.existingWikiWord{:href => "/nlab/show/flat+orbifolds"} flat orbifolds
              are the
              %a.existingWikiWord{:href => "/nlab/show/orbifold+quotients"} orbifold quotients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕋
                      %mi n
                    %mo ⫽
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}^n \sslash C_2
              of the
              %a.existingWikiWord{:href => "/nlab/show/n-torus"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-torus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕋
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}^n \,\coloneqq\, \mathbb{R}^n/\mathbb{Z}^n
              by the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              %a.existingWikiWord{:href => "/nlab/show/group+action"} action
              inverting the sign of the canonical
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %ul
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n = 0
                  this is the
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbf{B} \mathbb{Z}_2
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n = 1
                  this plays the central role in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten theory
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n = 2
                  this is known as the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pillowcase+orbifold"} pillowcase orbifold
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} n = 3
                  this does not have a special name but appears as the
                  %a.existingWikiWord{:href => "/nlab/show/Brillouin+torus"} Brillouin torus
                  orbifold for
                  %a.existingWikiWord{:href => "/nlab/show/crystal"} crystalline
                  materials with
                  %a.existingWikiWord{:href => "/nlab/show/time-reversal+symmetry"} time-reversal symmetry
                  when considering their
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+topological+phases+of+matter"} K-theory classification of topological phases of matter
                  %a.existingWikiWord{:href => "/nlab/show/string+theory+vacuum"} string backgrounds
                  (e.g.
                  = succeed ")." do
                    %a{:href => "https://arxiv.org/abs/2205.09764"} arXiv:2205.09764
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} n = 4
                  this is known as the
                  = succeed "." do
                    %a{:href => "K3+surface#KummerSurface"} Kummer surface
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} n = 5
                  this appears as the
                  %a.existingWikiWord{:href => "/nlab/show/MO5-plane"} MO5-plane
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %p
          %p
            %strong Further examples:
          %ul
            %li
              %p Some basic building blocks of orbifolds:
              %p
                The quotient of a
                %a.existingWikiWord{:href => "/nlab/show/ball"} ball
                by a
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                of the
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
                of rotations is an orbifold, and orbifolds may be obtained by cutting out balls from ordinary
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                and gluing in these orbifold quotients.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
                over the
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                is an orbifold, being the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                of the
                %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
                by the
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                acting by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/M%C3%B6bius+transformations"} Möbius transformations
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                any orbifold, then the
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒢
                        %mrow
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi 𝒢
                        %mrow
                          %mi B
                          %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}^{\Pi(S^1)} = \mathcal{G}^{B\mathbb{Z}}
                is again an orbifold, called the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inertia+orbifold"} inertia orbifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pillowcase+orbifold"} pillowcase orbifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spindle+orbifold"} spindle orbifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-orbifolds"} G₂-orbifolds
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/lens+spaces"} lens spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ADE+singularities"} ADE singularities
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+cones"} metric cones
            %li
              %p
                See also
                %a{:href => "#Lange24"} Lange 2024
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/presentable+orbifold"}> presentable orbifold
                ,
                = succeed "," do
