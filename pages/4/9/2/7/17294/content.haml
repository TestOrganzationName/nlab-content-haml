                ,
                = succeed "," do
                  %a{:href => "https://projecteuclid.org/journals/homology-homotopy-and-applications/volume-12/issue-2/On-left-and-right-model-categories-and-left-and-right/hha/1296223884.full"} euclid:1296223884
                = succeed "," do
