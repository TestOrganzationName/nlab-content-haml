          %h2#idea Idea
          %p
            The refinement of the concept of
            %a.existingWikiWord{:href => "/nlab/show/lax+colimits"} lax colimits
            from
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+theory"} (infinity,1)-category theory
          %h2#valued_diagrams
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
            \-valued diagrams
          %p
            In the special case of functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} f : C \to (\infty,1)Cat
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-end"} (∞,1)-end
            and coend.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi laxcolim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ×
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  laxcolim(f)   \simeq \int^{c \in C} (C_{c/})^{op} \times f(c)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi oplaxcolim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %msub
                    %mi C
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                  %mo ×
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  oplaxcolim(f)   \simeq \int^{c \in C} C_{c/} \times f(c)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi laxlim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi c
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  laxlim(f)  \simeq \int_{c \in C} Fun(C_{/c}, f(c))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi oplaxlim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi c
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  oplaxlim(f)  \simeq \int_{c \in C} Fun((C_{/c})^{op}, f(c))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo •
                  %mo :
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C_{/\bullet} : C \to (\infty,1) Cat
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo •
                      %mo{:stretchy => "false"} /
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C_{\bullet/} : C^{op} \to (\infty,1)Cat
            are the functors sending a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo →
                  %mi c
                  %mo ′
                %annotation{:encoding => "application/x-tex"} c \to c'
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the composition functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi c
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi c
                      %mo ′
                %annotation{:encoding => "application/x-tex"} C_{/c} \to C_{/c'}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mo ′
                        %mo{:stretchy => "false"} /
                    %mo →
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} C_{c'/} \to C_{c/}
          %p
            Take care to note that lax colimits correspond to
            %em oplax
            cones, just as in the 2-categorical case.
          %p These operations also have simple descriptions in terms of fibrations
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi C
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} f : C \to (\infty,1)Cat
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi laxlim
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Fun
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %msub
                        %mi el
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} laxlim(f) \simeq Fun_C(C, el_C(f))
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi oplaxlim
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Fun
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %msub
                        %mover
                          %mi el
                          %mo ¯
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} oplaxlim(f) \simeq Fun_{C^{op}}(C^{op}, \overline{el}_{C^{op}}(f))
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi laxcolim
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mover
                          %mi el
                          %mo ¯
                        %mrow
                          %msup
                            %mi C
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} laxcolim(f) \simeq \overline{el}_{C^\op}(f)
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi oplaxcolim
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi el
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} oplaxcolim(f) \simeq el_C(f)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                  %annotation{:encoding => "application/x-tex"} el
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi el
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{el}
              are the covariant and contravariant
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fun
                      %mi K
                  %annotation{:encoding => "application/x-tex"} Fun_K
              is the hom-category functor on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi K
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Cat_{/K}
          .proof
            %h6#proof Proof
            %p For the case of lax limits (and dually oplax limits), we can compute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Map
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi laxlim
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ∈
                                %mi C
                            %mi Map
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi Fun
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi c
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ∈
                                %mi C
                            %mi Map
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ×
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi c
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Nat
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ×
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mo •
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msubsup
                              %mi Map
                              %mi C
                              %mi cocart
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⊗
                            %msup
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %mo{:stretchy => "false"} ]
                            %mo ,
                            %msub
                              %mi el
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Map
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ×
                            %mi C
                            %mo ,
                            %msub
                              %mi el
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mi Map
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %msub
                              %mi Fun
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ,
                            %msub
                              %mi el
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Map(A, laxlim(f))
                    \&amp;\simeq \int_{c \in C} Map(A, Fun(C_{/c}, f(c)))
                    \\simeq \int_{c \in C} Map(A \times C_{/c}, f(c))
                    \\\&amp;\simeq Nat(A \times C_{/\bullet}, f)
                    \\simeq Map_C^{cocart}(A \otimes C^{[1]}, el_C(f))
                    \\\&amp;\simeq Map_C(A \times C, el_C(f))
                    \\simeq Map(A, Fun_C(C, el_C(f)))
                    \\end{aligned}
            %p
              using the fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %msup
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %mi C
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi t
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A \times C^{[1]} \to C : (a,t) \mapsto t_1
              is the free
              %a.existingWikiWord{:href => "/nlab/show/cocartesian+fibration"} cocartesian fibration
              generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mi C
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} A \times C \to C
            %p
              For the case of oplax colimits (and dually lax colimits), we can observe
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi oplaxcolim
                    %annotation{:encoding => "application/x-tex"} oplaxcolim
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi el
                        %mi C
                    %annotation{:encoding => "application/x-tex"} el_C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi C
                      %mi cocart
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat_{/C}^{cocart} \to (\infty,1)Cat
              preserve colimits and both sides of the isomorphism send
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %msub
                        %mi C
                        %mrow
                          %mi c
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} [1] \times C(c, -) \mapsto [1] \times C_{c/}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi C
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat^C
              containing these functors and closed under small colimits, which is the entirety of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi Cat
                        %mi C
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Cat^C
          %p
            It’s worth noting morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cat
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                %annotation{:encoding => "application/x-tex"} (\infty,1)Cat_{/C}
            between cocartesian fibrations can be thought of as lax transformations, so this agrees with the intuition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi laxlim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} laxlim(f)
            should be the category of lax natural transformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ⇒
                  %mi f
                %annotation{:encoding => "application/x-tex"} 1 \Rightarrow f
            and similar.
          %h2#examples Examples
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %mi C
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} t : C \to (\infty,1)Cat
                be the terminal functor. Then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi laxcolim
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} laxcolim(t) \simeq C^{op}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi oplaxcolim
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi C
                      %annotation{:encoding => "application/x-tex"} oplaxcolim(t) \simeq C
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} J : [1] \to (\infty,1)Cat
                is the diagram depicting a functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f : A \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi laxlim
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} ↓
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} laxlim(J) \simeq (f \downarrow B)
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi oplaxlim
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} ↓
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} oplaxlim(J) \simeq (B \downarrow f)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi laxcolim
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⨿
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                          %mo ×
                          %mi A
                      %mi B
                    %annotation{:encoding => "application/x-tex"} laxcolim(J) \simeq ([1] \times A) \amalg_{\{0\} \times A} B
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi oplaxcolim
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⨿
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi A
                        %mi B
                      %annotation{:encoding => "application/x-tex"} oplaxcolim(J) \simeq ([1] \times A ) \amalg_{\{1\} \times A} B
