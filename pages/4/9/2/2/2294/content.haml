          %h2#idea Idea
          %p
            There are two common ways to define a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %ol
            %li
              %p
                As a
                %a.existingWikiWord{:href => "/nlab/show/collection"} collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} C_0
                of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                and a collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C_1
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %a.existingWikiWord{:href => "/nlab/show/source"} source
                and
                %a.existingWikiWord{:href => "/nlab/show/target"} target
                maps
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                        %mo →
                        %msub
                          %mi C
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} C_1\to C_0
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi C
                              %mn 0
                        %msub
                          %mi C
                          %mn 1
                        %mo →
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} C_1\times_{C_0} C_1\to C_1
                %a.existingWikiWord{:href => "/nlab/show/identity+assigning+map"} identity assigning map
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 0
                        %mo →
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} C_0\to C_1
            %li
              %p
                As a collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} C_0
                of objects, together with for each pair
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x,y
                of objects, a collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom_C(x,y)
                of morphisms, together with identities
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi x
                      %mo ∈
                      %msub
                        %mi hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1_x\in hom_C(x,x)
                and composition maps
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %msub
                          %mi hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} hom_C(y,z)\times hom_C(x,y)\to hom_C(x,z)
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/logic"} logical
            terms, the first is formulated as a
            = succeed "-sorted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependently typed theory
          %p
            However, there is a third way of defining a category which uses only one collection (representing the collection of morphisms) and thus is formulated as an untyped (or
            = succeed "-sorted)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em not
            the usual way of replacing sorts with predicates, but instead a slightly clever trick. The basic idea is that an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            can be identified with its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
          %h2#definition Definition
          %p
            A
            %strong category
            (single-sorted version) is a
            %a.existingWikiWord{:href => "/nlab/show/collection"} collection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %em morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ,
                  %mi t
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} s,t:C\to C
            and a
            %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                    %mo :
                    %mi C
                    %mo ×
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \circ:C\times C\to C
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(s(x)) = s(x) = t(s(x))
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t(t(x)) = t(x) = s(t(x))
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∘
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x\circ y
              is defined if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s(x)=t(y)
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∘
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x\circ y
              is defined, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(x\circ y) = s(y)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∘
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t(x\circ y)=t(x)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∘
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x\circ s(x)=x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} t(x)\circ x=x
              (both composites are always defined, because of the first two axioms)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi z
                    %mo =
                    %mi x
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∘
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x\circ y)\circ z = x\circ (y\circ z)
              , if either is defined (in which case the other is defined by the axiom 3).
          %p
            The first two axioms say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            are
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            %a.existingWikiWord{:href => "/nlab/show/endofunctions"} endofunctions
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            which have the same
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/image"} image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} s(x)=x
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} t(x)=x
            %em identities
            or
            = succeed "." do
              %em objects
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between single-sorted categories is just a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f:C\to D
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(s(x)) = s(f(x))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(t(x)) = t(f(x))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∘
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x\circ y)= f(x)\circ f(y)
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\circ y
            is defined (which, by the first two axioms of a functor and axiom (3) of a category, implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)\circ f(y)
            is defined).
          %p
            Finally, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            between functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f,g:C\to D
            of single-sorted categories is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha:C\to D
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(\alpha(x)) = s(f(x))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t(\alpha(x)) = t(g(x))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(x) \circ f(y) = g(x) \circ \alpha(y)
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\circ y
            is defined (which implies that both composites in this identity are defined). Note that while a natural transformation is ordinarily defined to consist of a component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(x)
            only when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is an
            = succeed "," do
              %em object
            = succeed "." do
              %em morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            at a morphism is the diagonal of the corresponding naturality square.
          %p
            It can now be proved that single-sorted categories, functors, and natural transformations form a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            which is (strictly)
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the usual
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %h2#remarks Remarks
          %h3#specializations Specializations
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            is a single-sorted category in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            is a constant function (hence so is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+of+categories"} isomorphism of categories
            %a.existingWikiWord{:href => "/nlab/show/oidification"} oidification
            of monoids than the usual categories.
          %h3#internalization Internalization
          %p
            The usual definition of an
            %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
            is two-sorted, but the one-sorted definition can also be interpreted
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internally
            %a.existingWikiWord{:href => "/nlab/show/ambient+category"} ambient category
            only to have
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            is specified explicitly in the definition, one can just require
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            to be an ordinary morphism whose domain is the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            It is easy to see that any internal two-sorted category gives an internal one-sorted category (consider the object of arrows). The converse is true as long as the ambient category has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/split+idempotents"} split idempotents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            to obtain an object of objects. In general, however, the two concepts are not equivalent.
          %h3#generalizations Generalizations
          %p
            There exist similar single-sorted definitions of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-categories"} categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-categories"} ∞-categories
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-morphisms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
            = succeed "-morphisms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \lt n
            = succeed "-morphism." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
