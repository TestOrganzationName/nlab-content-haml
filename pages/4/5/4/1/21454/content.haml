                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ≃
                              %msub
                                %mi Hom
                                %mi k
