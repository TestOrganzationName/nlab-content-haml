                      \&amp; =
                      [ f_1,  [  f_2, f_3(v) ] ]
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{deg(f_2)deg(f_3)}
                      [ f_1,  [  f_3, f_2(v) ] ]
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{deg(f_1)(deg(f_2) + deg(f_3))}
                      [  f_2,  [ f_3,  f_1(v) ] ]
                      \\\
                      \&amp; \phantom{=}
                      +
                      (-1)^{deg(f_1)(deg(f_2) + deg(f_3)) + deg(f_2)deg(f_3)}
                      [  f_3,  [ f_2,  f_1(v) ] ]
                      \\\
                      \&amp; =
                      [ f_1,  [  f_2, f_3(v) ] ]
                      \-
                      (-1)^{deg(f_1) deg(f_2)}
                      {
                      \\color{green}
                      [ f_2,  [  f_1, f_3(v) ] ]
                      }
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{deg(f_2) deg(f_3)}
                      \\big(
                      [ f_1,  [  f_3, f_2(v) ] ]
                      \-
                      (-1)^{deg(f_1) deg(f_3)}
                      {
                      \\color{orange}
                      [ f_3,  [  f_1, f_2(v) ] ]
                      }
                      \\big)
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{deg(f_1)(deg(f_2) + deg(f_3))}
                      \\big(
                      [  f_2,  [ f_3,  f_1(v) ] ]
                      \-
                      (-1)^{deg(f_1)deg(f_3)}
                      {
                      \\color{blue}
                      [  f_2,  [ f_1,  f_3(v) ] ]
                      }
                      \\big)
                      \\\
                      \&amp; \phantom{=}
                      +
                      (-1)^{deg(f_1) deg(f_2 ) + deg(f_1) deg(f_3) + deg(f_2) deg(f_3)}
                      \\big(
                      [  f_3,  [ f_2,  f_1(v) ] ]
                      \-
                      (-1)^{deg(f_1) deg(f_2)}
                      {
                      \\color{cyan}
                      [  f_3,  [ f_1,  f_2(c) ] ]
                      }
                      \\big)
                      \\\
                      \&amp; \phantom{=}
                      +
                      (-1)^{deg(f_1) deg(f_2)}
                      \\big(
                      \\underset{
                      \= 0
                      }{
                      \\underbrace{
                      +
                      {
                      \\color{green}
                      [ f_2,  [  f_1, f_3(v) ] ]
                      }
                      \-
                      {
                      \\color{blue}
                      [  f_2,  [ f_1,  f_3(v) ] ]
                      }
                      }
                      }
                      \\big)
                      \\\
                      \&amp; \phantom{=}
                      +
                      (-1)^{deg(f_1) deg(f_3) + deg(f_2) deg(f_3)}
                      \\big(
                      \\underset{
                      \= 0
                      }{
                      \\underbrace{
                      {
                      \\color{orange}
                      [  f_3,  [ f_1,  f_2(v) ] ]
                      }
                      \-
                      {
                      \\color{cyan}
                      [ f_3,  [  f_1, f_2(v) ] ]
                      }
                      }
                      }
                      \\big)
                      \\\
                      \&amp; =
                      \\big[
                      [f_1, f_2], f_3(v)
                      \\big]
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{ deg(f_2) deg(f_3) }
                      \\big[
                      [f_1, f_3], f_2(c)
                      \\big]
                      \\\
                      \&amp; \phantom{=}
                      +
                      (-1)^{ deg(f_1) deg(f_2)  }
                      \\big[
                      f_2, [f_1, f_3](v)
                      \\big]
                      \\\
                      \&amp; \phantom{=}
                      \-
                      (-1)^{ deg(f_3)( deg(f_1) + deg(f_2) ) }
                      \\big[
                      f_3, [f_1, f_2](v)
                      \\big]
                      \\\
                      \&amp; =
                      \\big[
                      [f_1, f_2], f_3
                      \\big](v)
                      +
                      (-1)^{deg(f_1)deg(f_2))}
                      \\big[
                      f_2, [f_1, f_3]
                      \\big](v)
                      \\end{aligned}
              %blockquote
                %p (Fine, but is this sufficient to induct over the full range of all three degrees?)
            #LieBracketOnglInsideSuperLieAlgebraInducedFromVectorSpace.num_example
              %h6#example Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo ∈
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo =
                      %msub
                        %mi Hom
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f,g \in MultEnd(V)_0 = Hom_k(V,V)
                %a.maruku-eqref{:href => "#eq:ExplicitComponentSpacesOfSuperLieAlgebraInducedFromVectorSpace"} (1)
                we have that the bracket on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} MultEnd(V)
                in Def.
                %a.maruku-ref{:href => "#SuperLieAlgebraInducedFromVectorSpace"}
                restricts to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      [f,g](v)
                      \\;=\;
                      [f,g(v)] - [g,f(v)]
                      \\;=\;
                      f(g(v)) - g(f(v))
              %p
                (by combining
                %a.maruku-eqref{:href => "#eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace"} (3)
                with
                = succeed ")." do
                  %a.maruku-eqref{:href => "#eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace"} (2)
              %p
                This is the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                of the
                %a.existingWikiWord{:href => "/nlab/show/general+linear+Lie+algebra"} general linear Lie algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤𝔩
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{gl}(V)
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:ExplicitComponentSpacesOfSuperLieAlgebraInducedFromVectorSpace"} (1)
            %h4#embedding_tensors Embedding tensors
            #EmbeddingTensor.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/embedding+tensor"}> embedding tensor
                  )
              %p Given
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                          %mo ⊗
                          %mi V
                          %mover
                            %mo ⟶
                            %mi ρ
                          %mi V
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes V \overset{\rho}{\longrightarrow} V
                    a
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  %p
                    (typically required to be a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/faithful+representation"} faithful representation
                    %a.maruku-ref{:href => "#EmbeddingTensorsInduceTensorHierarchies"}
                    below),
              %p
                then an
                %em embedding tensor
                is a
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi V
                      %mo ⟶
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta
                      \\;\colon\;
                      V \longrightarrow \mathfrak{g}
              %p
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} v_i \in V
                the following condition (“quadratic constraint”) is satisfied:
              #eq:QuadraticConstraint.maruku-equation
                %span.maruku-eq-number (4)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi Θ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi ρ
                        %mrow
                          %mi Θ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      [\Theta(v_1), \Theta(v_2)]
                      \\;=\;
                      \\Theta
                      \\big(
                      \\rho_{\Theta(v_1)}(v_2)
                      \\big)
                      \\,,
              %p
                where on the left we have the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              The idea of this definition goes back to
              = succeed "," do
                %a{:href => "embedding+tensor#NicolaiSamtleben00"} Nicolai-Samtleben 00
              %a.existingWikiWord{:href => "/nlab/show/tensor+hierarchies"} tensor hierarchies
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/gauged+supergravity"} gauged supergravity
              = succeed "." do
                %a{:href => "embedding+tensor#Lavau17"} Lavau 17
            #RelationToLeibnizAlgebraStructure.num_remark
              %h6#remark_2 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebra"}> Leibniz algebra
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"}> structure
                  )
              %p
                The “quadratic constraint”
                %a.maruku-eqref{:href => "#eq:QuadraticConstraint"} (4)
                implies (see
                = succeed ")" do
                  %a{:href => "Leibniz+algebra#LeibnizAlgebraFromLieModuleAndEmbeddingTensor"} this Prop.
                %a.existingWikiWord{:href => "/nlab/show/magma"} product
              #eq:InducedLeibnizAlgebraStructure.maruku-equation
                %span.maruku-eq-number (5)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi V
                              %mo ⊗
                              %mi V
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %mi V
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo ,
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi v
                                %mn 1
                              %mo ⋅
                              %msub
                                %mi v
                                %mn 2
                              %mpadded{:width => "0"}
                                %mrow
                                  %mspace{:width => "thickmathspace"}
                                  %mo ≔
                                  %mspace{:width => "thickmathspace"}
                                  %msub
                                    %mi ρ
                                    %mrow
                                      %mi Θ
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi v
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi v
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      V \otimes V
                      \&amp;\overset{ }{\longrightarrow}&amp;
                      V
                      \\\
                      (v_1, v_2)
                      \&amp;\mapsto&amp;
                      v_1 \cdot v_2
                      \\mathrlap{
                      \\;\coloneqq\;
                      \\rho_{\Theta(v_1)}(v_2)
                      }
                      }
              %p
                makes (the underlying
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                of)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebra"} Leibniz algebra
                %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebra"} Leibniz algebra
                structure “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ⋅
                    %annotation{:encoding => "application/x-tex"} \cdot
                ” on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is already given, we may ask that it coincides with this one induced from the embedding tensor, a condition then called the
                = succeed ":" do
                  %em linear constraint
              #eq:LinearConstraint.maruku-equation
                %span.maruku-eq-number (6)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi v
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi ρ
                        %mrow
                          %mi Θ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      v_1 \cdot v_2 \;=\; \rho_{\Theta(v_1)}(v_2)
                      \\,.
              %p
                With respect to this induced Leibniz algebra structure, hence equivalently with the “linear constraint”
                %a.maruku-eqref{:href => "#eq:LinearConstraint"} (6)
                understood, the “quadratic constraint”
                %a.maruku-eqref{:href => "#eq:QuadraticConstraint"} (4)
                equivalently says that the embedding tensor is a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of
                %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebras"} Leibniz algebras
                (using that
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
                are special cases of a Leibniz algebras):
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [\Theta(v_1), \Theta(v_2)]
                      \\;=\;
                      \\Theta(v_1 \cdot v_2)
                      \\,.
            #EmbeddingTensorViaSuperLieAlgebraInducedFromVectorSpace.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/embedding+tensors"} embedding tensors
                  are square-0 elements in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi MultEnd
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} MultEnd(V)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                be a
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %p
                An element in degree -1 of the
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} MultEnd(V)
                from Def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TheSuperLieAlgebraInducedFromVectorSpace"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mo ∈
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ≃
                      %msub
                        %mi Hom
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi 𝔤𝔩
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta \in MultEnd(V)_{-1} \simeq Hom_{k}(V, \mathfrak{gl}(V))
                      \\,,
              %p
                which by Example
                %a.maruku-ref{:href => "#LieBracketOnglInsideSuperLieAlgebraInducedFromVectorSpace"}
                is identified with a
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi V
                      %mo ⟶
                      %mi 𝔤
                      %mo ≔
                      %mi 𝔤𝔩
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta \;\colon\; V \longrightarrow \mathfrak{g} \coloneqq \mathfrak{gl}(V)
              %p
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                to the
                %a.existingWikiWord{:href => "/nlab/show/general+linear+Lie+algebra"} general linear Lie algebra
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %em
                  %a.existingWikiWord{:href => "/nlab/show/embedding+tensor"} embedding tensor
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#EmbeddingTensor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Θ
                      %mo ,
                      %mi Θ
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mphantom
                        %mi AAA
                      %mo ⇔
                      %mphantom
                        %mi AAA
                      %mo{:stretchy => "false"} [
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ρ
                        %mrow
                          %mi Θ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [\Theta, \Theta]
                      \\;=\;
                      0
                      \\phantom{AAA}
                      \\Leftrightarrow
                      \\phantom{AAA}
                      [\Theta(v_1), \Theta(v_2) ]
                      \\;=\;
                      \\Theta( \rho_{\Theta(v_1)}(v_2) )
                      \\,.
              %p
                Here on the right,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤𝔩
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{gl}(V)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                denotes the canonical
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤𝔩
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{gl}(V)
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
            .proof
              %h6#proof_2 Proof
              %p
                By unwinding of the definition
                %a.maruku-eqref{:href => "#eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace"} (2)
                and
                %a.maruku-eqref{:href => "#eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace"} (3)
                and using again Example
                %a.maruku-ref{:href => "#LieBracketOnglInsideSuperLieAlgebraInducedFromVectorSpace"}
                we compute as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mo{:stretchy => "false"} [
                              %mi Θ
                              %mo ,
                              %mi Θ
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} [
                              %mi Θ
                              %mo ,
                              %mi Θ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} [
                              %mi Θ
                              %mo ,
                              %munder
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi Θ
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi v
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi v
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                                %mpadded{:lspace => "-50%width", :width => "0"}
                                  %mrow
                                    %mo =
                                    %msub
                                      %mi ρ
                                      %mrow
                                        %mi Θ
                                        %mo{:stretchy => "false"} (
                                        %msub
                                          %mi v
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi v
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ]
                              %mo −
                              %mo{:stretchy => "false"} [
                              %mi Θ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi Θ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi Θ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi ρ
                                %mrow
                                  %mi Θ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi v
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mo{:stretchy => "false"} [
                              %mi Θ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
