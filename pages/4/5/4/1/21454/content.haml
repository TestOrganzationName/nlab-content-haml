                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\big( \tfrac{1}{2} [\Theta,\Theta](v_1) \big)(v_2)
                      \&amp; =
                      [\Theta, \Theta(v_1)](v_2)
                      \\\
                      \&amp; =
                      [\Theta,
                      \\underset{
                      \\mathclap{
                      \= \rho_{\Theta(v_1)}(v_2)
                      }
