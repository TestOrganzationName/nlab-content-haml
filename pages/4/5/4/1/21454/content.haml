          %div
            %h3#EmbeddingTensorsAndTensorHierarchyInSuperdgLieTheory Embedding tensors and tensor hierarchy in super/dg-Lie theory
            %p
              We spell out aspects of the formalization of the concept of
              %a.existingWikiWord{:href => "/nlab/show/embedding+tensors"} embedding tensors
              and their
              %a.existingWikiWord{:href => "/nlab/show/tensor+hierarchies"} tensor hierarchies
              in terms of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
            %h4#TheSuperLieAlgebraOfEndomorphisms The super Lie algebra of multi-endomorphisms
            %p
              The algebra of
              %a.existingWikiWord{:href => "/nlab/show/embedding+tensors"} embedding tensors
              and their
              %a.existingWikiWord{:href => "/nlab/show/tensor+hierarchies"} tensor hierarchies
              turns out to be neatly captured by structure found in or induced from the following
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %p
              The following construction is briefly highlighted in
              %a{:href => "M-brane+3-algebra#Palmkvist09"} Palmkvist 09, 2.3
              %a{:href => "tensor+hierarchy#Palmkvist13"} Palmkvist 13, 3.1
              (reviewed more clearly in
              = succeed ")" do
                %a{:href => "tensor+hierarchy#LavauPalmkvist19"} Lavau-Palmkvist 19, 2.4
              = succeed ":" do
                %a{:href => "super+Lie+algebra#Kantor70"} Kantor 70
            #TheSuperLieAlgebraInducedFromVectorSpace.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                  of
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/multimorphism"} multi
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                be a
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional vector space
                over some
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
              %p
                Define a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Vect
                        %mi k
                        %mi ℤ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      MultEnd(V) \;\in \; Vect_k^{\mathbb{Z}}
                      \\,,
              %p
                concentrated in degrees
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≤
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \leq 1
                %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
                as follows:
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n =1
                we set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi V
                      %mspace{:width => "thinmathspace"}
                      %mo .
