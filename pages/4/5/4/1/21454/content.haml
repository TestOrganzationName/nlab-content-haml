                              %mo{:stretchy => "false"} (
                              %mi V
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                            %mtd
                              %mo =
                              %msub
                                %mi Hom
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo ,
                              %msub
                                %mi Hom
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ≃
                              %msub
                                %mi Hom
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo ⊗
                              %mi V
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi MultEnd
                              %mo{:stretchy => "false"} (
                              %mi V
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 2
                            %mtd
                              %mo =
                              %msub
                                %mi Hom
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo ,
                              %msub
                                %mi Hom
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo ,
