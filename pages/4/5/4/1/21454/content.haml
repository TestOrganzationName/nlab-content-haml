                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo =
                      %mi V
                    %annotation{:encoding => "application/x-tex"} v \in MultEnd(V)_1 = V
                we set
              #eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      [f, v]
                      \\;\coloneqq\;
                      f(v)
              %p
                Finally, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ≤
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} f\in MultEnd(V)_{ deg(f) \leq 0 }
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi MultEnd
                      %mo{:stretchy => "false"} (
                      %mi V
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ≤
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} g\in MultEnd(V)_{deg(g) \leq 0}
                we set
              #eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace.maruku-equation
                %span.maruku-eq-number (3)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi f
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thickmathspace"}
