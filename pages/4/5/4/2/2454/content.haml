                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(L\coprod L)\cong U(L)\otimes U(L)
          %h2#properties Properties
          %h3#IsomorphismProblem Isomorphism problem
          %p
            Notice that the enveloping algebras of two Lie algebras may be
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            as
            %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
            even if the two Lie algebras they arise from are not isomorphic to each other.
          %p
            This happens even in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of the Lie algebra is encoded in its universal enveloping algebra, in the guise of the
            %em Gelfand-Kirillov dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GK
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} GK\big(U(L)\big)
          %h3#poisson_algebra_structure_on_
            Poisson algebra structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(\mathfrak{g})
          %p
            The universal enveloping algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(\mathfrak{g})
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            is naturally a (non-commutative)
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            with the restriction of the Poisson bracket to generators being the original
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
          %h3#hopf_algebra_structure_on_
            Hopf algebra structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(\mathfrak{g})
          %p
            Suppose the universal enveloping algebras of Lie algebras exist in a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the functorial choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ↦
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L\mapsto U(L)
            realizing the above construction with tensor products is fixed. For example, this is true in the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} L\to 0
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is the trivial Lie algebra) induces the counit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \epsilon:U(L)\to U(0)=\mathbf{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ×
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta:U(L)\to U(L\times L)\cong U(L)\otimes U(L)
            is induced by the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo →
                  %mi L
                  %mo ×
                  %mi L
                %annotation{:encoding => "application/x-tex"} L\to L\times L
            whereas the antipode
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S=U(-id):U(L)\to U(L)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(L)
            into a
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ")" do
              %a{:href => "#MilnorMoore65"} Milnor-Moore 65, section 5
            %em
              %a.existingWikiWord{:href => "/nlab/show/Milnor-Moore+theorem"} Milnor-Moore theorem
            states conditions under which the converse holds (hence under which a primitively generated Hopf algebra is a universal enveloping algebra of a Lie algebra).
          %p
            If the category is simply the vector spaces over a field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} l\in L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            with its image in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(L)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi l
                    %mo ⊗
                    %mn 1
                    %mo +
                    %mn 1
                    %mo ⊗
                    %mi l
                  %annotation{:encoding => "application/x-tex"} \Delta(l) = l\otimes 1 + 1\otimes l
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            are the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/primitive+element"} primitive element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(L)
          %h3#pbw_theorem PBW theorem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9%E2%80%93Birkhoff%E2%80%93Witt+theorem"} Poincaré–Birkhoff–Witt theorem
            states that the
            %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
            algebra of an enveloping algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(g)
            in
            %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            is canonically isomorphic to a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(g)
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(g)
            as a coalgebra, via the projection map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Gr
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(g)\to Gr U(g)
          %h3#relation_to_formal_deformation_quantization Relation to formal deformation quantization
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
            the section
            = succeed "." do
              %em
                %a{:href => "formal+deformation+quantization#RelationToUniversalEnvelopingAlgebras"} Relation to universal enveloping algebras
          %h3#RelationToTheGroupAlgebra Relation to the group algebra
          %blockquote
            %p
              The universal enveloping algebra of a Lie algebra is the analogue of the usual
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              of a group. It has the analogous function of exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+modules"} Lie algebra modules
              as a category of
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              for an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              structure. By dualization, one obtains a commutative Hopf algebra which, in the case where the Lie algebra is that of an irreducible
              %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+0"} characteristic 0
          %p
            (quoted from
            = succeed "," do
              %a{:href => "#Hochschild81"} Hochschild 1981, p. 221
            = succeed ";" do
              %a{:href => "#Hochschild81"} ibid. Thm. 3.1 on p. 230
            = succeed ")" do
              %a{:href => "#Tjin92"} Tjin 1992, Thm. 1
          %h2#examples Examples
          %p
          #WeylAlgebraAndHeisenbergAlgebra.num_remark
            %h6 Example
            %p
              Consider the standard
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebra"} Heisenberg Lie algebra
            %p
              Depending on conventions, the
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
              of the
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebra"} Heisenberg Lie algebra
              either already is the
              %a.existingWikiWord{:href => "/nlab/show/Weyl+algebra"} Weyl algebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2n
              generators or else it becomes so after after forming the
              %a.existingWikiWord{:href => "/nlab/show/quotient+algebra"} quotient algebra
              in which the central generator is identified with the
              %a.existingWikiWord{:href => "/nlab/show/unit+element"} unit element
              of the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              – whereas in the former case (considered eg. in
              = succeed ";" do
                %a{:href => "#Kravchenko00"} Kravchenko 2000, Def. 2.1
              = succeed ")" do
                %a{:href => "#Bekaert05"} Bekaert 2005, p. 9
              %a.existingWikiWord{:href => "/nlab/show/Planck+constant"} Planck constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              with the Weyl algebra regarded as a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi m
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2m}
            %p
              Accordingly, given a
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+n-algebra"}
                Heisenberg Lie
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              it makes sense to call its
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+E-n+algebra"}
                universal enveloping
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi n
                      %annotation{:encoding => "application/x-tex"} E_n
              a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Weyl+n-algebra"}
                    Weyl
                    = succeed "-algebra" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
          %p
          .num_remark
            %h6 Example
            %p
              %strong (Universal enveloping of a tangent Lie algebra)
              %br/
              The universal enveloping algebra of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebra"} tangent Lie algebra
              of a finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              over the real or complex numbers is canonically isomorphic to the algebra of the left invariant
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+series"} Hausdorff series
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9%E2%80%93Birkhoff%E2%80%93Witt+theorem"} Poincaré–Birkhoff–Witt theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coexponential+map"} coexponential map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Duflo+isomorphism"} Duflo isomorphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/oidification"} oidification
                to
                %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebroid"} universal enveloping algebroid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+E-n+algebra"} universal enveloping E-n algebra
          %h2#references References
          %ul
            %li#Serre64
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
                \:
                = succeed "," do
                  %em Universal Algebra of a Lie Algebra
                = succeed "," do
                  %em Lie Algebras and Lie Groups – 1964 Lectures given at Harvard University
                = succeed "," do
                  %strong 1500
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-70634-2"} doi:10.1007/978-3-540-70634-2
            %li#Dixmier74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacques+Dixmier"}> Jacques Dixmier
                ;
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Alg%C3%A8bres+Enveloppantes"} Algèbres Enveloppantes
                = succeed "," do
                  %em Enveloping Algebras
                %strong 11
                American Mathematical Society (1996) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/gsm-11"}> ams:gsm-11
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolas+Bourbaki"}> Nicolas Bourbaki
                , §I.2 in:
                = succeed "," do
                  %em Lie groups and Lie algebras – Chapters 1-3
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/9783540642428"} ISBN:9783540642428
            %li#Hochschild81
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gerhard+P.+Hochschild"}> Gerhard P. Hochschild
                ,
                = succeed "," do
                  %em The Universal Enveloping Algebra
                = succeed "," do
                  %em Basic Theory of Algebraic Groups and Lie Algebras
                = succeed "," do
                  %strong 75
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-1-4613-8114-3_16"} doi:10.1007/978-1-4613-8114-3_16
          %p
            Further discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+groups"} quantum groups
          %ul
            %li#Tjin92
              %a.existingWikiWord{:href => "/nlab/show/Tjark+Tjin"}> Tjark Tjin
              ,
              = succeed "," do
                %em An introduction to quantized Lie groups and algebras
              %strong 7
              (1992) 6175-6213 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9111043"}> arXiv:hep-th/9111043
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/S0217751X92002805"} doi:10.1142/S0217751X92002805
          %p
            Discussion in the generality of
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            such as notably of the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+Lie+algebras"} Whitehead Lie algebras
            arising in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
          %ul
            %li#MilnorMoore65
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Moore"} John Moore
                = succeed "," do
                  %em On the structure of Hopf algebras
                %strong 81
                (1965) 211-264 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/1970615"}> doi:10.2307/1970615
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.uio.no/studier/emner/matnat/math/MAT9580/v12/undervisningsmateriale/milnor-moore-ann-math-1965.pdf"} pdf
            %li#MayPonto12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"} Kate Ponto
                = succeed "," do
                  %em More concise algebraic topology – Localization, Completion, and Model Categories
                = succeed "," do
                  %a{:href => "https://press.uchicago.edu/ucp/books/book/chicago/M/bo12322308.html"} ISBN:9780226511795
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.uchicago.edu/~may/TEAK/KateBookFinal.pdf"} pdf
          %p See also:
          %ul
            %li
              %p
                Wikipedia:
                = succeed "," do
                  %em
                    %a{:href => "http://en.wikipedia.org/wiki/Universal_enveloping_algebra"} Universal enveloping algebra
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Poincar%C3%A9%E2%80%93Birkhoff%E2%80%93Witt_theorem"} PBW theorem
            %li
              %p
                F. A. Berezin,
                = succeed "," do
                  %em Some remarks about the associated envelope of a Lie algebra
                %a{:href => "http://www.mathnet.ru/php/getFT.phtml?jrnid=faa&paperid=2813&volume=1&year=1967&issue=2&fpage=1&what=fullt&option_lang=eng"} Rus. pdf
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=219671"} MR219671
            %li
              %p
                MathOverflow question
                %a{:href => "http://mathoverflow.net/questions/25020/what-is-the-universal-enveloping-algebra"} What is the universal enveloping algebra
                which is looking for a rather general construction in a class of symmetric monoidal
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pseudoabelian+category"} pseudoabelian categories
