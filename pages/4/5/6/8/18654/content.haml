                    ),
                    %br/
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/kaon"} kaon
                    %a.existingWikiWord{:href => "/nlab/show/K%2A-meson"} K*-meson
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
