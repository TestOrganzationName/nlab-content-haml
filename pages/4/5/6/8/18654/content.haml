                          %mi d
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (u d d)
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
          %p
            %br/
          %h2#details Details
          %h3#as_the_goldstone_boson_of_chiral_symmetry_breaking As the Goldstone boson of chiral symmetry breaking
          %p
            From the point of view of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/quark"} quark
            %a.existingWikiWord{:href => "/nlab/show/model+%28in+theoretical+physics%29"} model
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nuclear+physics"} nuclear physics
            %a.existingWikiWord{:href => "/nlab/show/Goldstone+boson"} Goldstone boson
            corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/spontaneous+symmetry+breaking"} spontaneous symmetry breaking
            of the “
            %a.existingWikiWord{:href => "/nlab/show/chiral+symmetry"}> chiral
            ”-
            %a.existingWikiWord{:href => "/nlab/show/symmetry+group"} symmetry group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi R
                  %mo ×
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi L
                %annotation{:encoding => "application/x-tex"} SU(2)_R \times SU(2)_L
            to the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi V
                  %annotation{:encoding => "application/x-tex"} SU(2)_V
            %a.existingWikiWord{:href => "/nlab/show/vacuum+expectation+value"} vacuum expectation value
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi q
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} ⟩
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \langle q \bar q\rangle \neq 0
            of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/quark"} quark
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/condensate"} condensate
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#MachleidtEntem11"} Machleidt-Entem 11, 2.1.3
          %h3#plain_pion_field Plain pion field
          %p
            Hence, in the sense of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Wigner+classification"} Wigner classification
            %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
            of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
            %a.existingWikiWord{:href => "/nlab/show/Pin+group"} Pin group
            (is a spacetime
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pseudoscalar"} pseudoscalar
            %a.existingWikiWord{:href => "/nlab/show/adjoint+representation"} adjoint representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/isospin"} isospin
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
          %div{:style => "margin: 0px 10px 0px 20px"}
            %img{:src => "/nlab/files/LightAndChiralPartnerMesonFieldsPinIII.jpg", :width => "600px"}/
          %p
            As such, a pion
            %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            from
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            to the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
          #eq:PlainPionField.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mover
                    %mi π
                    %mo{:stretchy => "false"} →
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 3
                      %mo ,
                      %mn 1
                  %mo ⟶
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  i \vec \pi
                  \\;\colon\;
                  \\mathbb{R}^{3,1}
                  \\longrightarrow
                  \\mathfrak{su}(2)
                  \\,,
          %p
            where the vecotr notation on the left is to indicate that this is, at each spacetime point (
            %a.existingWikiWord{:href => "/nlab/show/event"}> event
            )
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 3
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^{3,1}
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
            3-dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mover
                    %mi π
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ≃
                    %mi ℝ
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i \vec \pi(x) \;\in\; \mathfrak{su}(2) \;\simeq_{\mathbb{R}}\; \mathbb{R}^3
                  \\,.
          %p
            This means that for any choice of
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
          %p
            In the
            = succeed "-literature" do
              %a.existingWikiWord{:href => "/nlab/show/nuclear+physics"} nuclear physics
            %a.existingWikiWord{:href => "/nlab/show/Cartan-Weyl+basis"} Cartan-Weyl basis
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Span
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi t
                    %mo +
                  %mo ,
                  %msub
                    %mi t
                    %mo −
                  %mo ,
                  %msub
                    %mi t
                    %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ≃
                    %mi ℝ
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Span}
                  \\big(
                  \\{t_+, t_-, t_0\}
                  \\big)
                  \\;\simeq_{\mathbb{R}}\;
                  \\mathfrak{su}(2)
          %p in terms of which the components of the pion field are hence denoted as follows
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/pion"} pion
                  field component
                %th
                  %a.existingWikiWord{:href => "/nlab/show/quark"} quark
                  %a.existingWikiWord{:href => "/nlab/show/bound+state"} bound state
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \pi^0
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} u \bar u
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mover
                          %mi d
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} d \bar d
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \pi^+
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mover
                          %mi d
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} u \bar d
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mo −
                      %annotation{:encoding => "application/x-tex"} \pi^-
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} d \bar u
          %p
            %br/
          %h3#exponentiated_pion_field Exponentiated pion field
          %p
            Especially in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chiral+perturbation+theory"} chiral perturbation theory
            %a.existingWikiWord{:href => "/nlab/show/exponentiation"} exponentiation
            of
            %a.maruku-eqref{:href => "#eq:PlainPionField"} (1)
            to an
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
          #eq:ExponentiatedPionField.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mi i
                      %mover
                        %mi π
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi f
                        %mi π
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 3
                      %mo ,
                      %mn 1
                  %mo ⟶
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  e^{i \vec \pi/f_\pi}
                  \\;\colon\;
                  \\mathbb{R}^{3,1}
                  \\longrightarrow
                  SU(2)
                  \\,,
          %p
            (
            %a{:href => "#Witten83"}> Witten 83, (2)
            ,
            = succeed ")" do
              %a{:href => "#AdkinsNappi84"} Adkins-Nappi 84, (1)-(3)
            %em exponentiated pion field
            or often just
            = succeed "," do
              %em the chiral field
            = succeed "," do
              %a{:href => "#MachleidtEntem11"} Machleidt-Entem 11, (2.29)
            = succeed "." do
              %a{:href => "#RhoEtAl16"} Rho et al. 16, around (1)
          %p
            Here the
            %a.existingWikiWord{:href => "/nlab/show/physical+unit"} unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi π
                %annotation{:encoding => "application/x-tex"} f_\pi
            is called the
            = succeed "." do
              %em pion decay constant
          %p
            Assuming that the pion field
            %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanishes at spatial infinity
            hence means that the exponentiated pion field is a
            %a.existingWikiWord{:href => "/nlab/show/map"} map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mi i
                      %mover
                        %mi π
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi f
                        %mi π
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 1
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 3
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi cpt
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 1
                  %mo ×
                  %msup
                    %mi S
                    %mn 3
                  %mo ⟶
                  %msup
                    %mi S
                    %mn 3
                  %mo ≃
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  e^{i \vec \pi/f_\pi}
                  \\;\colon\;
                  \\mathbb{R}^{0,1} \times (\mathbb{R}^3)^{cpt}
                  \\;=\;
                  \\mathbb{R}^{0,1} \times S^3
                  \\longrightarrow
                  S^3
                  \\simeq
                  SU(2)
          %p
            from (the
            = succeed "-axis" do
