                            %mi c
                            %mo{:stretchy => "false"} ¯
                        %annotation{:encoding => "application/x-tex"} c \bar c
                    )
                  %td{:style => "text-align: left;"}
                    %strong>
                      %a.existingWikiWord{:href => "/nlab/show/bottom+quark"} bottom
