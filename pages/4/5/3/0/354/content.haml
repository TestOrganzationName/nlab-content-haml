                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists f}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            Demanding that all such diagrams exist is therefore demanding that we have an invertible composition operation on 1-morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            In order for this to qualify as an
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/associativity+law"} associativity law
            up to
            %a.existingWikiWord{:href => "/nlab/show/coherent"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedra
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "," do
              %em pentagonators
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            conditions are captured by generalizing the above conditions to all dimensions as in the definition of Kan complexes.
          %p
            In order to conceive of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
