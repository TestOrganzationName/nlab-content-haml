                        %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒢
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i(\mathcal{G}_0)
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/identities"} identities
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
