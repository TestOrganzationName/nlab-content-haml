          %h3#HomotopyTheoryOfKanComplexes
            Homotopy theory of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_5 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KanCplx
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    KanCplx \hookrightarrow sSet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of Kan complexes, which is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of that of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              on the Kan complexes.
          .num_remark
            %h6#remark_7 Remark
            %p
              This means that, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet,Y_\bullet \in KanCplx
              two Kan complexes, an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              in the
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi KanCplx
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{KanCplx}(X_\bullet,Y_\bullet)
              is
            %ul
              %li
                a sequence of
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n \colon X_n \to Y_n
                for all
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p such that
            %ul
              %li
                these respect all the face maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi k
                    %annotation{:encoding => "application/x-tex"} d_k
                and the degeneracy maps
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi k
                      %annotation{:encoding => "application/x-tex"} s_k
          #MappingObjectOfKanComplexes.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet,Y_\bullet \in KanCplx
              two Kan complexes, their
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"}
                    Maps(X_\bullet,Y_\bullet)_\bullet \in KanCplx
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mo •
                      %mi n
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps(X_\bullet,Y_\bullet) \colon [n] \mapsto Hom_{sSet}(X_\bullet \times \Delta^n_\bullet, Y_\bullet)
                    \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#MappingObjectOfKanComplexes"}
              defines an
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of Kan complexes.
          .num_remark
            %h6#remark_8 Remark
            %p
              As such, it is also common to write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Maps(X,Y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,Y]
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Maps(X,Y)
          #PathSpaceObjectOfKanComplexes.num_example
            %h6#example Example
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    I_\bullet \coloneqq \{0 \stackrel{\simeq}{\to} 1\}
            %p
              for the Kan complex which is a
              %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              with two objects and one nontrivial morphism and its inverse between them. This comes with two inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    i_0, i_1 \colon \ast \to I
            %p of its endpoints.
            %p
              Then, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in KanCplx
              any other Kan complex, the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [I,X]_\bullet
              from def.
              %a.maruku-ref{:href => "#MappingObjectOfKanComplexes"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi I
                      %mo •
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet \stackrel{[i_0,X_\bullet]}{\leftarrow} [I_\bullet,X_\bullet]_\bullet \stackrel{[i_1,X]}{\to} X_\bullet
                    \\,.
          %p
            A 1-cell in the mapping Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mo •
                  %mo ,
                  %msub
                    %mi Y
                    %mo •
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X_\bullet, Y_\bullet]_\bullet
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            between two morphisms of Kan complexes:
          .num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo ,
                    %msub
                      %mi g
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet, g_\bullet \colon X_\bullet \to Y_\bullet
              two morphisms between two Kan complexes, hence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo •
                      %mo ,
                      %msub
                        %mi g
                        %mo •
                      %mo ∈
                      %msub
                        %mi Hom
                        %mi KanCplx
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\bullet,g_\bullet \in Hom_{KanCplx}(X,Y)
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow g
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi I
                      %mo •
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \eta_\bullet \colon X_\bullet \to [I_\bullet,X_\bullet]_\bullet
              into the
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              of def.
              %a.maruku-ref{:href => "#PathSpaceObjectOfKanComplexes"}
              such that we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mo •
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi i
                                    %mn 0
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mo •
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mo •
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi I
                              %mo •
                            %mo ,
                            %msub
                              %mi Y
                              %mo •
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mo •
                            %mo ↘
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi i
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mo •
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                            %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y_\bullet
                    \\\
                    \&amp; {}^{\mathllap{f_\bullet}}\nearrow &amp; \uparrow^{\mathrlap{[i_0, X_\bullet]_\bullet}}
                    \\\
                    X_\bullet &amp;\stackrel{\eta_\bullet}{\to}&amp; [I_\bullet, Y_\bullet]
                    \\\
                    \&amp; {}_{\mathllap{g_\bullet}}\searrow &amp; \downarrow_{\mathrlap{[i_1, X_\bullet]_\bullet}}
                    \\\
                    \&amp;&amp;  Y \bullet
                    }
                    \\,.
          %p
            It follows that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"} KanCplx
            is naturally
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over itself.
          %p
            We may write
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"} KanCplx
            regarded as a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} KanCplx
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (without the subscript) for a Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            regarded as an object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \infty Grpd
          %h2#properties Properties
          %h3#model_category Model category
          %p
            Kan complexes are the
            %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            in the
            %em
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structures on simplicial sets
            for which the fibrations are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibrations
          %p
            In this context, a weak equivalence between Kan complexes is a morphism of simplicial sets that induces an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            on the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
            of the two Kan complexes: a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          %h2#examples Examples
          %h3#kan_complexes_from_nerves_of_groupoids
            Kan complexes from nerves of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .un_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C)
              of a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              is a Kan complex if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          %p
            The existence of
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            corresponds to the fact that, in the
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(D)
            %a.existingWikiWord{:href => "/nlab/show/horns"} horns
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi d
                            %mn 0
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mi f
                      %mtr
                        %mtd
                          %msub
                            %mi d
                            %mn 1
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi Id
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                        %mtd
                        %mtd
