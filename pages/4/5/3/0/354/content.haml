              %li
                %p
                  equivalently, the map from
                  = succeed "-simplices" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-horns" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo ,
                          %mi i
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n,i)
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
