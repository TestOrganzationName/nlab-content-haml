                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "383.753", "xlink:href" => "#cPBaBFI5jv9_lwomzyrnFRGl84U=-glyph2-6", :y => "225.48"}
                %path{:d => "M 115.631844 1.397687 L 137.4795 -65.836688 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.19452 1.593227 C -1.097463 0.9957 0.00104424 0.0974012 0.297826 0.000974171 C -0.00116545 -0.0987478 -1.097114 -0.997691 -1.196206 -1.593008 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.30945,0.95242,0.95242,-0.30945,384.68816,214.55649)"}
                %path{:d => "M 76.167 -27.274188 L 133.362313 -68.828875 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.195745 1.592604 C -1.09496 0.99677 0.000569312 0.0984248 0.297415 0.00123064 C -0.0000959369 -0.0994071 -1.095608 -0.99644 -1.195805 -1.593897 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.81154,0.58963,0.58963,-0.81154,380.57041,217.54829)"}
                %path{:d => "M 151.331063 -18.418719 L 118.561531 5.393781 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.195412 1.593913 C -1.097787 0.995782 0.000891814 0.0996973 0.300029 -0.000653277 C 0.000223366 -0.0981369 -1.095316 -0.995162 -1.195524 -1.592626 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.81154,0.58961,0.58961,-0.81154,398.53815,167.13507)"}
                %path{:d => "M 107.530281 5.12425 L 74.756844 -18.68825 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.195263 1.592733 C -1.095054 0.99527 0.000484696 0.0982443 0.30029 0.000760686 C 0.00115314 -0.0995899 -1.097525 -0.995674 -1.195151 -1.593806 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.81154,-0.58961,-0.58961,-0.81154,354.73722,143.59564)"}
                %path{:d => "M 71.608406 -29.262469 L 84.124031 -67.785906 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.194885 1.592097 C -1.096611 0.998277 0.00191988 0.0999936 0.2975 -0.000138182 C -0.00149138 -0.0998664 -1.096224 -0.995126 -1.196511 -1.594159 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.30943,-0.95242,-0.95242,0.30943,318.81458,177.9787)"}
                %path{:d => "M 93.206063 -74.051531 L 133.713875 -74.051531 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.195505 1.594681 C -1.093943 0.997025 -0.0001925 0.0985875 0.300589 0.00093125 C -0.0001925 -0.100631 -1.093943 -0.995162 -1.195505 -1.592819 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-1,0,0,1,340.41387,222.7686)"}
                %path{:d => "M 142.4795 -67.348406 L 154.995125 -28.824969 ", :style => "fill:none;stroke-width:0.3985;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(1,0,0,-1,247.208,148.718)"}
                %path{:d => "M -1.194599 1.593398 C -1.095518 0.998075 0.000420049 0.0991054 0.299411 -0.000622825 C -0.00108379 -0.0982501 -1.095905 -0.995329 -1.196684 -1.594063 ", :style => "fill:none;stroke-width:0.31879;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.30943,0.95242,0.95242,0.30943,389.68699,216.06659)"}
          %p
            In fact, the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(K)
            of an
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            whose collection of
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi K
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo :
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(K)_k := Hom(O(k),K)
            is precisely the collection of images of the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(k)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            Here is the fully formal prescription of how to think of a Kan complex as an
            = succeed "-groupoid:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                The Kan complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is the
                %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
                of an
                %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
                in which all morphism are invertible;
            %li
              %p
                The
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi k
                    %annotation{:encoding => "application/x-tex"} C_k
                are precisely the
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(k)
            %li
              %p
                The
                = succeed "-filler" do
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %ol
                %li
                  %p
                    there exists a notion of composition of adjacent k-morphisms in the
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
                %li
                  %p
                    under this composition, all
                    = succeed "-morphisms" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi k
                          %annotation{:encoding => "application/x-tex"} k
          %p This is easy to see in low dimensions:
          %ul
            %li
              %p
                a 1-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi \in C_1
                in the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has a single source 0-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mo =
                      %msub
                        %mi d
                        %mn 1
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} x := d_1 \phi
                and a single target 0-cell
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo :
                        %mo =
                        %msub
                          %mi d
                          %mn 0
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} y := d_0 \phi
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo →
                        %mi ϕ
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x \stackrel{\phi}{\to} y
                      \\,.
            %li
              %p
                a 2-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \phi \in C_2
                in the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has two incoming 1-cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mi ϕ
                      %mo ,
                      %msub
                        %mi d
                        %mn 0
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_2 \phi, d_0 \phi \in C_1
                and one outgoing 1-cell
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %mi ϕ
                        %mo ∈
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} d_1 \phi \in C_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                as a globular 2-morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 2
                                    %mi ϕ
                              %mo ↗
                            %mtd
                              %msup
                                %mo ⇓
                                %mi ϕ
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                                    %mi ϕ
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                            %mtd
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                                  %mi ϕ
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; x_1
                      \\\
                      \&amp; {}^{\mathllap{d_2 \phi}}\nearrow &amp;\Downarrow^\phi&amp; \searrow^{\mathrlap{d_0 \phi}}
                      \\\
                      x_0 &amp;&amp;\underset{d_1 \phi}{\to}&amp;&amp; x_2
                      }
                      \\,.
          %p
            In more detail, one may think of the two adjacent incoming
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em not
            as being the composite of these two morphisms, but just as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/composable+pair"} composable pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            as being a
            %strong compositor
            in a
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            that shows how the composable pair is composed to the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} d_1 \phi
          %p
            So, if an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"} globular
            %a.existingWikiWord{:href => "/nlab/show/Batanin+%E2%88%9E-category"} ∞-category
            in which all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            (or rather the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-nerve"} ∞-nerve
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
          %p
            Notably, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is to be regarded as (the nerve of) an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %em unique
            2-cell
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi f
                          %mo ↗
                        %mtd
                          %mo ⇓
                        %mtd
                          %msup
                            %mo ↘
                            %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi h
                              %mo =
                              %mi g
                              %mo ∘
                              %mi f
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{f}\nearrow &amp;\Downarrow&amp; \searrow^{g}
                  \\\
                  x_0 &amp;&amp;\underset{h = g \circ f}{\to}&amp;&amp; x_2
                  }
          %p
            that is the unique
            %strong identity 2-morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                  %mover
                    %mo ⇒
                    %mo =
                  %mi h
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  g \circ f \stackrel{=}{\Rightarrow} h
                  \\,.
          %p
            More generally, in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi x
                    %mn 0
                  %mo →
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} k \colon x_0 \to x_2
            2-isomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo ⇒
                    %mi k
                  %annotation{:encoding => "application/x-tex"} g \circ f \Rightarrow k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi k
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{f}\nearrow &amp;\Downarrow^{\simeq}&amp; \searrow^{g}
                  \\\
                  x_0 &amp;&amp;\underset{k }{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            All we can say for sure is that
            %em at least
            one such 2-cell exists, and that the 2-cells themselves may be composed in some way. This is precisely what the horn filler conditions in a Kan complex encode.
          %p
            We have already seen in low dimension how the existence of composites in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            To see in a similar fashion that the Kan condition ensures the existence of
            = succeed "," do
              %em inverses
            %em outer horn
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow
                  \\\
                  x_0 &amp;&amp;\underset{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            In general, given such a diagram in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            composed with the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mi h
                                %mo ∘
                                %msup
                                  %mi f
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow
                  \&amp;\Downarrow^{\simeq}&amp; \searrow^{\mathrlap{h \circ f^{-1}}}
                  \\\
                  x_0 &amp;&amp;\underset{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            A similar analysis for higher dimensional cells shows that the fact that a Kan complex has all horn fillers encodes precisely the fact that it is the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            of an
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            in which
            %em all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            are composable if adjacent and have a weak inverse.
          %h3#1GroupoidsAsKanComplexes 1-Groupoids as Kan complexes
          %p
            We review how
            %a.existingWikiWord{:href => "/nlab/show/1-groupoids"} 1-groupoids
            are incarnated as Kan complexes via their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
          #Groupoid.num_defn
            %h6#definition_3 Definition
            %p
              A (
              %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
              )
              %em
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              is
            %ul
              %li
