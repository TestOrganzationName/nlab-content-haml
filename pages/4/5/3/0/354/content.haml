                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_i \colon \mathcal{G}_{n-1} \to \mathcal{G}_n
                    \\,.
          #NerveOfGroupoidIsKanComplex.num_prop
            %h6#proposition Proposition
            %p
              These collections of maps in def.
              %a.maruku-ref{:href => "#NerveOfGroupoid"}
              satisfy the
