                      %annotation{:encoding => "application/x-tex"}
                        [\Delta[n], S]\, \twoheadrightarrow \,[\Lambda^i[n],S]
                        \\,.
          .num_remark
            %h6#remark Remark
            %p
              The last characterization in def.
              %a.maruku-ref{:href => "#KanComplexes"}
              is sometimes taken to induce the generalization to
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              Kan complexes in ambient geometric contexts. For instance, the generalization of
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
              to “Lie Kan complexes” might be defined to be given by
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              such that the morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Λ
                      %mi i
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\Delta[n], S] \to [\Lambda^i[n],S]
            %p
              are
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/surjective+submersions"} surjective submersions
            %p
              While this is useful for some purposes, one should beware that this naive generalization, if taken at face value, may break the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy-theoretic
              interpretation of (say, smooth) Kan complexes as models for (say,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              = succeed ")." do
                %a{:href => "#NSSb"} NSS, section 4.2
              %em
                %a.existingWikiWord{:href => "/nlab/show/internal+%E2%88%9E-groupoid"} internal ∞-groupoid
              for more.
          .num_remark
            %h6#remark_2 Remark
            %p
              Some special cases of def.
              %a.maruku-ref{:href => "#KanComplexes"}
              go by their own terminology:
            %ul
              %li
                %p
                  a Kan complex such that, for every
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo &gt;
                          %mi n
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} k \gt n+1
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \partial \Delta
                  has a unique
                  %a.existingWikiWord{:href => "/nlab/show/filler"} filler
                  is called
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} coskeletal
              %li
                %p
                  a Kan complex that is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeletal
                  such that, in addition, the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  and
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+2)
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  have a unique filler are also called
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"} n-hypergroupoids
            %p
              These
              = succeed "-coskeletal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/n-groupoids"} n-groupoids
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+n-types"} homotopy n-types
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28infinity%2C1%29-category"} n-truncated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
          %h2#AsGrpds
            As models for
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Here, we discuss aspects of how
            %em Kan complexes
            serve as a model (a “
            %a.existingWikiWord{:href => "/nlab/show/geometric+definition+of+higher+categories"}> geometric model
            ”) for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoids"} 2-groupoids
            %a.existingWikiWord{:href => "/nlab/show/n-groupoids"} n-groupoids
            and generally
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
          %p First, we survey the general idea in
          %ul
            %li
              %a{:href => "#HeuristicsOnCompositionAndInverses"}> Heuristics on composition and inverses
              \.
          %p
            Then, we recall 1-
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            as Kan complexes via their
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            in
          %ul
            %li
              %a{:href => "#1GroupoidsAsKanComplexes"}> 1-Groupoids as Kan complexes
              \.
          %p Then, we discuss basic aspects of the
          %ul
            %li
              %a{:href => "#HomotopyTheoryOfKanComplexes"}> Homotopy theory of ∞-groupoids as Kan complexes
              \.
          .num_remark
            %h6#remark_3 Remark
            %p
              This is a special case of how
              %a.existingWikiWord{:href => "/nlab/show/weak+Kan+complexes"} weak Kan complexes
              (
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"}> quasi-categories
              ) are a model for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
          .num_remark
            %h6#remark_4 Remark
            %p The horn filling condition from this point of view is read as guaranteeing that:
            %p
              for all collections of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k-1
              composable
              %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
              (given by a horn
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi k
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^k[n]
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
              – their
              %em composite
              – and an
              = succeed "-morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              For illustrations of the horn-
              %a.existingWikiWord{:href => "/nlab/show/filler"} filler
              conditions see also at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          .num_remark
            %h6#remark_5 Remark
            %p
              Whatever other definition of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              one considers, it is expected (and in most cases has been shown) to map to a Kan complex under the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
              for more on this.
          .num_remark
            %h6#remark_6 Remark
            %p
              Of all the models for
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              known in the literature, Kan complexes are probably the most widely used, certainly in
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              and related “geometric” approaches to
              %a.existingWikiWord{:href => "/nlab/show/higher+category"} higher category
              (such as in terms of
              %a.existingWikiWord{:href => "/nlab/show/n-fold+complete+Segal+spaces"} n-fold complete Segal spaces
              etc.), less so in “algebraic” approaches to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              inside the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              – lends itself usefully to many computations. To some extent, it is maybe a historical coincidence that the theory was worked out in such detail for this model specifically. Maybe if
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Kan
              – who first tried
              %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
              and then rejected them in favor of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              due to some technical issues – had tried
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+cubical+set"} cubical sets with connection
              first, things would have developed differently. See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
              for discussion of this issue.
            %p
              But, in any case, it seems clear that there is no “fundamental” conceptual reason to prefer Kan complexes over other models for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              (not as an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              %a.existingWikiWord{:href => "/nlab/show/univalent+foundations"} univalent foundations
              of mathematics in terms of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %a.existingWikiWord{:href => "/nlab/show/theory"} theory
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              is given as an abstract foundational notion, and then
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              and related structures are shown to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model"} model
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %h3#HeuristicsOnCompositionAndInverses Heuristics on composition and inverses
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            is primarily supposed to be a structure that consists of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
            = succeed "-morphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
          %p
            In the context of Kan complexes, the tool for organizing such collections of
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            is the notion of a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/geometric+shape+for+higher+structures"} shape
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            – a
            %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
            %a.existingWikiWord{:href => "/nlab/show/edge"} edge
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
            %a.existingWikiWord{:href => "/nlab/show/triangle"} triangle
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
            %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedron
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k = 3
          %p
            This means that a simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mo •
                %annotation{:encoding => "application/x-tex"} K_\bullet
            is a sequence of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi K
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{K_n\}_{n \in \mathbb{N}}
            (sets of
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi K
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo →
                  %msub
                    %mi K
                    %mi k
                %annotation{:encoding => "application/x-tex"} d_i \colon K_{k+1} \to K_{k}
            that send a
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi K
                    %mi k
                  %mo →
                  %msub
                    %mi K
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_i \colon K_k \to K_{k+1}
            that, over a
            = succeed "-simplex," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-simplex\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/identities"} identities
          %p
            If we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are abstract cellular
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            and whose morphisms are all cellular maps between these, then such a simplicial set is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  K \colon \Delta^{op} \to Set
          %p Hence, we think of this as assigning
          %ul
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} [0] \mapsto K_0
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} [1] \mapsto K_1
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} [2] \mapsto K_2
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 3
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} [3] \mapsto K_3
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/3-morphism"} 3-morphism
          %p and generally
          %ul
            %li
              a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi K
                      %mi k
                  %annotation{:encoding => "application/x-tex"} [k] \mapsto K_k
              of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
          %p as well as specifying
          %ul
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi K
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n] \hookrightarrow [n+1]) \mapsto (K_{n+1} \to K_n)
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n+1
                = succeed "-morphisms;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mi n
                      %mo →
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n+1] \to [n]) \mapsto (K_{n} \to K_{n+1})
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is supposed to be a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            enforces that these assignments of sets and functions satisfy conditions that make consistent our interpretation of them as sets of
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          %p
            But, apart from this source-target matching, a generic simplicial set does not yet encode a notion of
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of these morphisms.
          %p
            For instance, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2]
            the simplicial set consisting of two attached 1-cells
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^1[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;&amp;&amp; 2
                  }
                  \\right\}
          %p
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} (f,g) : \Lambda^1[2] \to K
            an image of this situation in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi x
                    %mn 1
                  %mover
                    %mo →
                    %mi g
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{f}{\to} x_1 \stackrel{g}{\to} x_2
            of two
            %em composable
            1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            that may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi h
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{h}{\to} x_2
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            (and to adhere to the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mpadded{:width => "0"}
                              %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow &amp;\Downarrow^{\mathrlap{\simeq}}&amp;
                  \\searrow^{\mathrlap{g}}
                  \\\
                  x_0 &amp;&amp;\stackrel{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            From the picture, it is clear that this is equivalent to demanding that, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2] \hookrightarrow \Delta[2]
            the obvious inclusion of the two abstract composable 1-morphisms into the 2-simplex, we have a diagram of morphisms of simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mn 1
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mi h
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^1[2] &amp;\stackrel{(f,g)}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists h}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            A simplicial set where, for all such
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            exists may be thought of as a collection of higher morphisms that is equipped with a notion of composition of adjacent 1-morphisms.
          %p
            For the purpose of describing
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^2[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;\to&amp;&amp; 2
                  }
                  \\right\}
          %p the simplicial set consisting of two 1-morphisms that touch at their end, hence for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  (g,h) : \Lambda^2[2] \to K
          %p
            two such 1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            had an inverse
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and thereby find a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            connecting the sources of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
