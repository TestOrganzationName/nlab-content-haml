              %li
                %p
                  equipped with
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 1
                                %msub
                                  %mo ×
                                  %mrow
                                    %msub
                                      %mi 𝒢
                                      %mn 0
                                %msub
                                  %mi 𝒢
                                  %mn 1
                              %mtd
                                %mover
                                  %mo →
                                  %mo ∘
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 1
                              %mtd
                                %mover
                                  %mover
                                    %munder
                                      %mo →
                                      %mi s
                                    %mover
                                      %mo ←
                                      %mi i
                                  %mover
                                    %mo →
                                    %mi t
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{G}_1 \times_{\mathcal{G}_0} \mathcal{G}_1
                        \&amp;\stackrel{\circ}{\to}&amp;
                        \\mathcal{G}_1
                        \&amp; \stackrel{\overset{t}{\to}}{\stackrel{\overset{i}{\leftarrow}}{\underset{s}{\to}}}&amp;
                        \\mathcal{G}_0
                        }\,,
                %p
                  where the
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                  on the left is that over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 1
                          %mover
                            %mo →
                            %mi t
                          %msub
                            %mi 𝒢
                            %mn 0
                          %mover
                            %mo ←
                            %mi s
                          %msub
                            %mi 𝒢
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{t}{\to} \mathcal{G}_0 \stackrel{s}{\leftarrow} \mathcal{G}_1
            %p such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  takes values in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∘
                        %mi i
                        %mo =
                        %mi s
                        %mo ∘
                        %mi i
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 0
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"}
                        t \circ i = s \circ i =   id_{\mathcal{G}_0}, \;\;\;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
