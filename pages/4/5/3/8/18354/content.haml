              so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi i
                      %mo ⊧
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi i
                      %mo ,
                      %msub
                        %mi y
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M_i \models \varphi(x_i, y_i)
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %p
              Indeed, in the example we first mentioned, consider the sequences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1, 2, 3, \dots)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo ,
                      %mn 2
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 3
                      %mo ,
                      %mn 3
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 4
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1 + 1/2, 2 + 1/3, 3 + 1/4, \dots)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo
                        %mo *
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} ^*\mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1/n
              away from y”, these two sequences agree cofinitely many times (and every ultrafilter contains the cofinite filter). But these cofinite sets of indices are getting smaller and smaller and intersect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
