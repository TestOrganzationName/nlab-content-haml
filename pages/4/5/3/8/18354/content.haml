                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo{:stretchy => "false"} /
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \left( \prod_{i \in I} M_i(X/E) \right) /\mathcal{U}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi m
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi E
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} [[m_i]_E]_{\mathcal{U}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
