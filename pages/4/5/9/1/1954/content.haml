          %h2#idea Idea
          %p
            The notion of
            %em Ehresmann connection
            is one of the various equivalent definitions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
          %h2#definition Definition
          %h3#InTermsDiffForms In terms of differential forms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            with
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo ×
                  %mi G
                  %mo ⟶
                  %mi P
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\colon\; P \times G \longrightarrow P
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔤
                  %mo ⟶
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\rho_* \;\colon\; \mathfrak{g} \longrightarrow \Gamma(T P)
          %p
            its derivative, sending each element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
            to the
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            that at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} p \in P
            is the push-forward
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho(p,-)_*(x)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in \Gamma(T P)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            a differential form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi v
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \iota_v \omega
            for the contraction.
          #CartanEhresmannConnection.num_defn
            %h6#definition_2 Definition
            %p
              Given a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong Cartan-Ehresmann connection
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+1-form"} Lie algebra-valued 1-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A\in \Omega^1(P, \mathfrak{g})
            %p
              on the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              satisfying two conditions:
            %ol
              %li
                %p
                  %strong first Ehresmann condition
                %p
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mi A
                        %mo =
                        %mi x
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\iota_{\rho_*(x)} A = x
                        \\,.
              %li
                %p
                  %strong second Ehresmann condition
                %p
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mi A
                        %mo =
                        %msub
                          %mi ad
                          %mi x
                        %mi A
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{L}_{\rho_*(x)} A = ad_x A
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\rho_*(x)}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                  along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \rho_*(x)
                  and where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ad
                          %mi x
                        %mo :
                        %mi 𝔤
                        %mo →
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} ad_x : \mathfrak{g} \to \mathfrak{g}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  on itself.
          #FormulationInTermsOfCurvatureForm.num_prop
            %h6#proposition Proposition
            %p This is equivalent to
            %ol
              %li
                %p
                  %strong first Ehresmann condition
                %p
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mi A
                        %mo =
                        %mi x
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\iota_{\rho_*(x)} A = x
                        \\,.
              %li
                %p
                  %strong second Ehresmann condition
                %p
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi F
                          %mi A
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\iota_{\rho_*(x)} F_A = 0
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi A
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_A \in \Omega^2(P, \mathfrak{g})
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                  2-form of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6#proof Proof
            %p
              Using
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi ρ
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi A
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \iota_{\rho_*(x)} A = x
              we have by
              %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi ρ
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi F
                              %mi A
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi ρ
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi{:mathvariant => "normal"} d
                            %mi A
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ∧
                            %mi A
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi ρ
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mi A
                            %mo −
                            %mi{:mathvariant => "normal"} d
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi ρ
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mi A
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi ρ
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mi A
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{\rho_*(x)} F_A
                    \&amp;=
                    \\iota_{\rho_*(x)}
                    \\big(
                    \\mathrm{d} A + \tfrac{1}{2} [A\wedge A]
                    \\big)
                    \\\
                    \&amp; =
                    \\mathcal{L}_{\rho_*(x)} A
                    \-
                    \\mathrm{d} \iota_{\rho_*(x)} A
                    +
                    [x, A]
                    \\\
                    \&amp; =
                    \\mathcal{L}_{\rho_*(x)} A
                    +
                    [x, A]
                    \\,.
                    \\end{aligned}
          %h3#in_terms_of_distributions In terms of distributions
          %p
            Given a smooth bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi: E\to X
            with typical fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            (e.g. a smooth vector bundle or a smooth principal
            = succeed "-bundle)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi E
                  %mo ⊂
                  %mi T
                  %mi E
                %annotation{:encoding => "application/x-tex"} V E\subset T E
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi p
                %annotation{:encoding => "application/x-tex"} V_p
            consists of the tangent vectors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi p
                %annotation{:encoding => "application/x-tex"} v_p
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi p
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (T_p \pi)(v_p) = 0
            %strong smooth distribution (field) of horizontal subspaces
            is a choice of a vector subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi p
                  %mi E
                  %mo ⊂
                  %msub
                    %mi T
                    %mi p
                  %mi E
                %annotation{:encoding => "application/x-tex"} H_p E\subset T_p E
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            such that
          %p
            E1. (complementarity)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi u
                  %mi E
                  %mspace{:width => "mediummathspace"}
                  %mo =
                  %mspace{:width => "mediummathspace"}
                  %msub
                    %mi H
                    %mi u
                  %mi E
                  %mo ⊕
                  %msub
                    %mi V
                    %mi u
                  %mi E
                %annotation{:encoding => "application/x-tex"} T_u E \: = \: H_u E \oplus V_u E
          %p
            E2.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ↦
                  %msub
                    %mi H
                    %mi p
                  %mi E
                %annotation{:encoding => "application/x-tex"} p\mapsto H_p E
            is smooth. That means that in the unique decomposition of any smooth vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            into vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi H
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mi u
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^H \in \Gamma(H_u E)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi V
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi u
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^V \in \Gamma(V_u E)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msup
                    %mi X
                    %mi H
                  %mo +
                  %msup
                    %mi X
                    %mi V
                %annotation{:encoding => "application/x-tex"} X = X^H + X^V
            the vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi H
                %annotation{:encoding => "application/x-tex"} X^H
            is smooth (or equivalently
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi V
                %annotation{:encoding => "application/x-tex"} X^V
            is smooth, or equivalently both) as a section of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi E
                %annotation{:encoding => "application/x-tex"} T E
            (there exist yet several other equivalent formulations of the smooothness criterion).
          %p
            An Ehresmann connection describes a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi : P \to X
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            some
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ⊂
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} H \subset T P
            which is a subbundle of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            complementary at each point to the vertical tangent bundle to the fiber. More precisely, an
            %strong Ehresmann connection
            on a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi:P\to X
            is a smooth distribution of horizontal subspaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ↦
                  %msub
                    %mi H
                    %mi p
                  %mi P
                %annotation{:encoding => "application/x-tex"} p\mapsto H_p P
            which is
            = succeed ":" do
              %strong equivariant
          %p
            E3.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mrow
                      %mi p
                      %mi g
                  %mi P
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi p
                  %msub
                    %mi R
                    %mi g
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi H
                    %mi p
                  %mi P
                %annotation{:encoding => "application/x-tex"} H_{p g}P = (T_p R_g) H_p P
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} p \in P
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
          %p
            This subbundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %msub
                    %mo ∪
                    %mi p
                  %msub
                    %mi H
                    %mi p
                  %mo ⊂
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} H = \cup_p H_p\subset T X
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            can be expressed as a field of subspaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi x
                  %mo =
                  %mi Ker
                  %msub
                    %mi A
                    %mi x
                  %mo =
                  %mi Ann
                  %msub
                    %mi A
                    %mi x
                  %mo ⊂
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} H_x = Ker A_x = Ann A_x\subset T P
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} x\in P
            ) which are pointwise annihilators of a smooth
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,Lie(G))
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            that satisfies two Ehresmann conditions from the previous subsection.
          %p
            The Ehresmann connections on a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mi H
                  %mi P
                  %mo ⊂
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} T^H P\subset T P
            is the smooth horizontal distrubution of subspaces defining the principal connection on a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a Lie group and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a smooth left
            = succeed "-space," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} P\times_G F
            of the associated bundle with typical fiber
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} f\in F
            one defines a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi f
                  %mo :
                  %mi P
                  %mo →
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} \rho_f : P\to P\times_G F
            assigning the class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [p,f]
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} p\in P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi p
                  %msub
                    %mi ρ
                    %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi T
                    %mi p
                    %mi H
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo :
                  %msubsup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} ]
                    %mi H
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} (T_p \rho_f)(T^H_p P) =: T_{[p,f]}^H P\times_G F
            defines the horizontal subspace
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi p
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} ]
                      %mi H
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi F
                    %mo ⊂
                    %msub
                      %mi T
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi p
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} ]
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} T_{[p,f]}^H P\times_G F\subset T_{[p,f]} P\times_G F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,f)
            in the class
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [p,f]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ↦
                  %msubsup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} ]
                    %mi H
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} p\mapsto T_{[p,f]}^H P\times_G F
            is a connection on the associated bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi F
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P\times_G F\to X
          %h3#in_terms_of_cohesive_homotopy_type_theory In terms of cohesive homotopy type theory
          %p
            One may also describe(flat) Ehresmann connections in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
          %p
            The general abstract discussion is
            = succeed "." do
              %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#FlatEhresmannConnections"} here
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
            this reduces to the traditional notion is
            = succeed "." do
              %a{:href => "smooth+infinity-groupoid+--+structures#FlatEhresmannConnections"} here
          %h2#properties Properties
          %h3#general General
          .num_defn
            %h6#definition_3 Definition
            %p The two definitions in terms of 1-forms and in terms of horizontal distributions are equivalent.
          .proof
            %h6#proof_2 Proof
            %p
              At each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} p \in P
              take the horizontal subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi p
                    %mi P
                  %annotation{:encoding => "application/x-tex"} H_p P
              to be the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi T
                      %mi p
                    %mi P
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} A(p) : T_p P \to \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi p
                    %mi P
                    %mo :
                    %mo =
                    %mi ker
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_p P := ker A(p)
          .num_defn
            %h6#remark Remark
            %p
              This means we may think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as measuring how
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
              paths in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              fail to be
              %em horizontal
              or
              %em parallel
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
          %h3#curvature_characteristic_forms Curvature characteristic forms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \langle - \rangle \in W(\mathfrak{g})
            be an
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            on the Lie algebra. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            an Ehresmann connection, write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %mi ⋯
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \rangle = \langle F_A \wedge F_A \wedge \cdots F_A\rangle
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            obtained by evaluating this on wedge powers of the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle F_A \rangle \in \Omega^{2k}(P)
              are closed, descend along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi P
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p : P \to X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{2k}(X)
              are independent of the choice of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
          .proof
            %h6#proof_3 Proof
            %p
              That the forms are closed follows from the
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    d F_A = [A\wedge F_A]
            %p
              satisfied by the curvature 2-form and the defining as-invariance of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle-\rangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              itself may be identified with a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              (see there)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(P) \leftarrow W(\mathfrak{g}) : A
            %p and the evaluation of the curvature in the invariant polynomials corresponds to the precomposition with the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    W(\mathfrak{g})
                    \\longleftarrow
                    CE(b^{2k-1}\mathbb{R} )
                    \\;\colon\;
                    \\langle - \rangle
            %p
              described at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            %p
              to show that these forms descend, it is sufficient to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} x \in \mathfrak{g}
              we have
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \iota_{\rho_*(X)} \langle F_A \rangle = 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi ρ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\rho_*(x)} \langle F_A \rangle = 0
            %p
              The first follows from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mi ρ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi F
                        %mi A
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \iota_{\rho_*(x)} F_A = 0
              = succeed "-closure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
          .num_remark
            %h6#remark_2 Remark
            %p
              The form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_A \rangle
              is called the
              %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              of the connection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\inv(\mathfrak{g}) \to \Omega^\bullet(X)
            %p
              induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P,A)
              as above is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %h2#note_on_terminology Note on terminology
          %p
            The terminology for the various incarnations of the single notion of
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            varies throughout the literature. What we here call an Ehresmann connection is sometimes, but not always, called
            %strong principal connection
            (as it is defined for
            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          %h2#references References
          %p The notion originates with:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"}> Charles Ehresmann
                ,
                = succeed "," do
                  %em Les connexions infinitésimales dans un espace fibré différentiable
              %p Colloque de topologie (espaces fibrés), Bruxelles, 1950, Georges Thone, Liège; Masson et Cie., Paris (1951) 29–55
              %p
                %a.existingWikiWord{:href => "/nlab/show/S%C3%A9minaire+Bourbaki"}> Séminaire Bourbaki
                ,
                %strong 1
                24 (1952) 153–168 &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/?id=SB_1948-1951__1__153_0"}> numdam:SB_1948-1951__1__153_0
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.numdam.org/article/SB_1948-1951__1__153_0.pdf"} pdf
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mikio+Nakahara"}> Mikio Nakahara
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Geometry%2C+Topology+and+Physics"} Geometry, Topology and Physics
              = succeed "," do
                %a{:href => "https://doi.org/10.1201/9781315275826"} doi:10.1201/9781315275826
              = succeed "&rbrack;" do
                %a{:href => "http://alpha.sinp.msu.ru/~panov/LibBooks/GRAV/(Graduate_Student_Series_in_Physics)Mikio_Nakahara-Geometry,_Topology_and_Physics,_Second_Edition_(Graduate_Student_Series_in_Physics)-Institute_of_Physics_Publishing(2003).pdf"} pdf
          %p
            A formulation and discussion of Ehresmann connections using language and tools from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
              %em
                %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} Models for Smooth Infinitesimal Analysis
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
          %ul
            %li#Waldorf16
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              %em A global perspective to connections on principal 2-bundles
              (
              %a{:href => "https://arxiv.org/abs/1608.00401"}> arXiv:1608.00401
              )
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/connections+on+principal+%E2%88%9E-bundles"} connections on principal ∞-bundles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Cech+cocycles+for+differential+characteristic+classes"} Cech cocycles for differential characteristic classes
                  – An
                  = succeed "-Lie" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1011.4735"} arXiv:1011.4735
              = succeed ")" do
                %a{:href => "http://projecteuclid.org/euclid.atmp/1358950853"} Euclid
          %p A more comprehensive account is in sections 3.9.6, 3.9.7 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
