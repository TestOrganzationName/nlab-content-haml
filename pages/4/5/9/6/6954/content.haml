                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              because it carries a basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
