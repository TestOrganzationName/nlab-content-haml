                %path#svg_59338_3{:d => "m197,108c14,10 19,19 21,36", :fill => "none", :stroke => "#000000", "stroke-width" => "2"}
                %path#svg_59338_4{:d => "m191,116c-19,-14 -51,7 -51,29", :fill => "none", :stroke => "#000000", "stroke-width" => "2"}
                %foreignobject#svg_59338_5{"font-size" => "16", :height => "20", :width => "48", :x => "0", :y => "133"}
                  %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
