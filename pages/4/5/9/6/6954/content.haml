                              %mi u
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi W
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\langle f(a x + b y), u_i \rangle_W &amp; = &amp; \langle a x + b y, e_i \rangle_V \\
                    \&amp; = &amp; a \langle x, e_i\rangle_V + b\langle y, e_i\rangle_V \\
                    \&amp; = &amp; a \langle f(x), u_i \rangle_W + b \langle f(y), u_i \rangle_W \\
                    \&amp; = &amp; \langle a f(x) + b f(y), u_i \rangle_W
                    }
            %p
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mi i
                    %annotation{:encoding => "application/x-tex"} u_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
