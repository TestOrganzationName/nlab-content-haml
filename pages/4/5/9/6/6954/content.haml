                    %annotation{:encoding => "application/x-tex"} W
            %p
              Summarizing, any isometry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon V \to V
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi M
                    %mi x
                    %mo +
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f(x) = M x + b
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a linear injection and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
