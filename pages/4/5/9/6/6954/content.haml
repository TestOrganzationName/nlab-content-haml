                              %mn 2
                            %mi u
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    4\langle u, v + w \rangle &amp;= {\|u + v + w\|^2} - {\|u - v - w\|^2} \\
                    \&amp;={\left\|\left(\frac{1}{2}u + v\right) + \left(\frac{1}{2}u + w\right)\right\|^2} - {\left\|\left(\frac{1}{2}u - v\right) + \left(\frac{1}{2}u - w \right)\right\|^2} \\
                    \&amp;={\left\|\left(\frac{1}{2}u + v\right) + \left(\frac{1}{2}u + w\right)\right\|^2} + {\left\|\left(\frac{1}{2}u + v\right) - \left(\frac{1}{2}u + w\right)\right\|^2} \\
                    \&amp;\qquad -  {\left\|\left(\frac{1}{2}u - v\right) - \left(\frac{1}{2}u - w\right)\right\|^2} - {\left\|\left(\frac{1}{2}u - v\right) + \left(\frac{1}{2}u - w \right)\right\|^2} \\
                    \&amp;=2{\left\|\frac{1}{2}u + v\right\|^2} + 2{\left\|\frac{1}{2}u + w\right\|^2} -  2{\left\|\frac{1}{2}u - v\right\|^2} - 2{\left\|\frac{1}{2}u - w\right\|^2} \\
                    \&amp;= 2{\left\|\frac{1}{2}u + v\right\|^2}  -  2{\left\|\frac{1}{2}u - v\right\|^2} \\
                    \&amp;\quad+ 2{\left\|\frac{1}{2}u + w\right\|^2} - 2{\left\|\frac{1}{2}u - w\right\|^2}\\
                    \&amp;= 8\langle \frac{1}{2}u,v \rangle + 8\langle \frac{1}{2}u,w\rangle
                    \\end{aligned}
            %p
              To get it as stated, we then apply this in the special case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} w = 0
              to deduce that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 2
                      %mo{:stretchy => "false"} ⟨
                      %mfrac
                        %mn 1
                        %mn 2
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = 2\langle \frac{1}{2} u, v\rangle
          %p The properties above were all reasonably straightforward deductions from the definition. There is one more property that is needed which is a little more complicated. First, we note a useful result about the continuity of the supposed inner product.
          #ipcts.num_lemma
            %h6#lemma_2 Lemma
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi u
                      %mo +
                      %mi v
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mo −
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi u
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mo −
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (u,v) \mapsto \frac{1}{2}({\|u + v\|^2} - {\|u\|^2} - {\|v\|^2})
              is continuous.
          .proof
            %h6#proof_2 Proof
            %p This is a simple consequence of composition of continuous maps.
          %p Using that, we can prove the following property of the proposal for an inner product.
          #iplinear.num_proposition
            %h6#proposition Proposition
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u,v\rangle
              satisfies the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi λ
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi λ
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u,\lambda v \rangle = \lambda \langle u, v \rangle
            %p
              for all vectors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
          .proof
            %h6#proof_3 Proof
            %p
              We first use the formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u, v + w \rangle = \langle u, v \rangle + \langle u, w\rangle
              to prove that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u, n v \rangle = n \langle u, v\rangle.
            %p
              We prove this by induction. It is clearly true for the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi n
                    %mi v
                    %mo +
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u, (n+1)v \rangle = \langle u, n v + v \rangle = \langle u, n v\rangle + \langle u, v \rangle = n \langle u, v \rangle + \langle u, v \rangle = (n + 1)\langle u, v \rangle
            %p
              whence, by induction, it holds for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Next we observe that it holds for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo −
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    0 = \langle u, 0 \rangle = \langle u, v - v \rangle = \langle u, v \rangle + \langle u, - v \rangle
            %p whence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u, -v \rangle = - \langle u, v \rangle.
            %p
              Next, we prove it for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi p
                        %mi q
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \frac{p}{q} \in \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \frac{1}{n}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mfrac
                      %mn 1
                      %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mfrac
                      %mi n
                      %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mfrac
                      %mn 1
                      %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mfrac
                      %mn 1
                      %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mfrac
                      %mi n
                      %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mfrac
                      %mn 1
                      %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u, \frac{1}{n} v \rangle = \frac{n}{n} \langle u, \frac{1}{n} v \rangle = \frac{1}{n} \langle u, \frac{n}{n} v \rangle = \frac{1}{n} \langle u, v \rangle.
            %p
              To get to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{R}
              we need to appeal to continuity. We find a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} (q_n) \in \mathbb{Q}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} (q_n) \to \lambda
              and see that by continuity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi λ
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %msub
                      %mi q
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi lim
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %msub
                      %mi q
                      %mi n
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi lim
                    %msub
                      %mi q
                      %mi n
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi λ
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle u, \lambda v \rangle = \langle u, (\lim q_n) v \rangle = \lim \langle u, q_n v \rangle = \lim q_n \langle u, v \rangle = \lambda \langle u, v \rangle.
          #scangip.num_corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|{-}\|}
              is a norm on a vector space satisfying the parallelogram law then the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mfrac
                      %mn 1
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi u
                        %mo +
                        %mi v
                        %msup
                          %mo{:stretchy => "false"} ‖
                          %mn 2
                      %mo −
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi u
                        %msup
                          %mo{:stretchy => "false"} ‖
                          %mn 2
                      %mo −
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi v
                        %msup
                          %mo{:stretchy => "false"} ‖
                          %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (u,v) \mapsto \frac{1}{2}\left({\|u + v\|^2} - {\|u\|^2} - {\|v\|^2}\right)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
          %h2#isometries_on_inner_product_spaces Isometries on inner product spaces
          %p Because lengths determine inner products, and because inner products respect linear structure, isometries must also respect linear (or affine) structure:
          .un_thm
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a vector space with a norm satisfying the parallelogram law. Then an isometry (distance-preserving function)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon V \to V
              is an injective linear affine map.
          .proof
            %h6#proof_4 Proof
            %p
              Put
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v = f(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi v
                  %annotation{:encoding => "application/x-tex"} x \mapsto f(x) - v
              is also an isometry, so that without loss of generality we may assume
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f(0) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a linear isomorphism.
            %p
              Letting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(x, y)
              denote the distance between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|x-y\|} = d(x, y) = d(f(x), f(y)) = {\|f(x)-f(y)\|}
            %p
              and then, putting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} y=0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|x\|} = {\|f(x)\|}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo =
                          %mtd
                            %mfrac
                              %mn 1
                              %mn 2
                            %mrow
                              %mo (
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi x
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo +
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo −
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi x
                                %mo −
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mfrac
                              %mn 1
                              %mn 2
                            %mrow
                              %mo (
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo +
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo −
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                                %msup
                                  %mo{:stretchy => "false"} ‖
                                  %mn 2
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\langle x, y\rangle &amp; = &amp; \frac1{2}\left({\|x\|^2} + {\|y\|^2} - {\|x-y\|^2}\right) \\
                    \&amp; = &amp; \frac1{2}\left({\|f(x)\|^2} + {\|f(y)\|^2} - {\|f(x)-f(y)\|^2}\right) \\
                    \&amp; = &amp; \langle f(x), f(y) \rangle
                    }
            %p
              i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              preserves the inner product.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              be the linear subspace spanned by the image
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              inherits an inner product, and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e_i\}
              is an orthonormal basis of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              (without restriction on cardinality), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi u
                      %mi i
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{u_i = f(e_i)\}
              is also an orthonormal basis of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              preserves the inner product. Next, for any linear combination
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi x
                      %mo +
                      %mi b
                      %mi y
                    %annotation{:encoding => "application/x-tex"} a x + b y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi x
                            %mo +
                            %mi b
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi u
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi W
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi a
                            %mi x
                            %mo +
                            %mi b
                            %mi y
                            %mo ,
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi V
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi a
                            %mo{:stretchy => "false"} ⟨
                            %mi x
                            %mo ,
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi V
                            %mo +
                            %mi b
                            %mo{:stretchy => "false"} ⟨
                            %mi y
                            %mo ,
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi V
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi a
                            %mo{:stretchy => "false"} ⟨
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi u
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi W
                            %mo +
                            %mi b
                            %mo{:stretchy => "false"} ⟨
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi u
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mi W
                        %mtr
