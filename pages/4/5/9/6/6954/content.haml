                %foreignobject#svg_59338_9{"font-size" => "16", :height => "20", :width => "48", :x => "131", :y => "96"}
                  %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \psi
          %p The cosine law for this special case leads to two formulae:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %mo +
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                        %mtd
                          %mo =
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                          %mo +
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                          %mo −
                          %mn 2
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %mo{:stretchy => "false"} ‖
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi v
                            %mo{:stretchy => "false"} ‖
                          %mi cos
                          %mo{:stretchy => "false"} (
                          %mi ψ
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %mo −
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                        %mtd
                          %mo =
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                          %mo +
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} ‖
                              %mn 2
                          %mo −
                          %mn 2
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi u
                            %mo{:stretchy => "false"} ‖
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi v
                            %mo{:stretchy => "false"} ‖
                          %mi cos
                          %mo{:stretchy => "false"} (
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  {\|u + v\|^2} &amp;= {\|u\|^2} + {\|v\|^2} - 2{\|u\|}{\|v\|} \cos(\psi) \\
                  {\|u - v\|^2} &amp;= {\|u\|^2} + {\|v\|^2} - 2{\|u\|}{\|v\|} \cos(\phi)
                  \\end{aligned}
          %p
            By imposing the assumption that angles should add correctly, we deduce that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo =
                  %mi π
                  %mo −
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \psi = \pi - \phi
            and thus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cos (\psi) = - \cos(\phi)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi u
                    %mo +
                    %mi v
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                  %mo +
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi u
                    %mo −
                    %mi v
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                  %mo =
                  %mn 2
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi u
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                  %mo +
                  %mn 2
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi v
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                %annotation{:encoding => "application/x-tex"}
                  {\|u + v\|^2} + {\|u - v\|^2} = 2 {\|u\|^2} + 2 {\|v\|^2}
          %p If a norm satisfies this identity, then the definition of angle (using the cosine identity) satisfies all the basic properties of angles that one can consider.
          %h2#inner_products Inner Products
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            which satisfies the parallelogram identity is the norm associated with an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polarization+identities"} polarization identities
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %mi u
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mo =
                          %mfrac
                            %mn 1
                            %mn 2
                          %mrow
                            %mo (
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %mo +
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo −
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo −
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mfrac
                            %mn 1
                            %mn 2
                          %mrow
                            %mo (
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo +
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo −
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %mo −
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mfrac
                            %mn 1
                            %mn 4
                          %mrow
                            %mo (
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %mo +
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo −
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi u
                              %mo −
                              %mi v
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                            %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\langle u, v \rangle &amp;= \frac{1}{2} \left({\|u + v\|^2} - {\|u\|^2} - {\|v\|^2} \right) \\
                  \&amp;= \frac{1}{2} \left({\|u\|^2} + {\|v\|^2} - {\|u - v\|^2}\right) \\
                  \&amp;= \frac{1}{4} \left({\|u + v\|^2} - {\|u - v\|^2}\right)
                  \\end{aligned}
          %p It is possible to show directly that this is an inner product. Certain properties are easy to deduce directly from the formulae.
          #lemipprop.num_lemma
            %h6#lemma Lemma
            %p
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} (u,v) \to \langle u, v\rangle
              satisfies the following properties:
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi u
                      %mo{:stretchy => "false"} ⟩
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle u, u \rangle  \ge 0
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi u
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle u, u \rangle = 0
                if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} u = 0
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle u, 0 \rangle = 0
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi u
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = \langle v, u \rangle
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi λ
                      %mi u
                      %mo ,
                      %mi λ
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %msup
                        %mi λ
                        %mn 2
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle \lambda u, \lambda v \rangle = \lambda^2 \langle u, v \rangle
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo +
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                      %mo =
