                  %li
                    %a{:href => "#final_functors"} Final functors
                  %li
                    %a{:href => "#PullbacksOfFibrations"} Pullbacks of fibrations
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em homotopy exact square
            is the analogue of an
            %a.existingWikiWord{:href => "/nlab/show/exact+square"} exact square
            which applies to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extensions
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Kan+extension"} (∞,1)-Kan extensions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derivator"} derivators
          %h2#definition Definition
          %p
            Let
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be small
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} categories
            %a.existingWikiWord{:href => "/nlab/show/functor"} functors
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi u
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi v
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %munder
                            %mo →
                            %mi g
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \overset{f}{\to} &amp; B\\
                  ^u\downarrow &amp; \swArrow &amp; \downarrow^v\\
                  C&amp; \underset{g}{\to} &amp; D}
          %p
            which is inhabited by a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            (which might be an
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be either
          %ul
            %li
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %li
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              (or a topologically enriched category, or a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            %li
              an
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (∞,1)-category
              (of any sort), or
            %li
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
          %p
            We write
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mi A
                  %annotation{:encoding => "application/x-tex"} M^A
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mi B
                  %annotation{:encoding => "application/x-tex"} M^B
            = succeed "-categories," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            of whatever shape. We write
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi M
                      %mi B
                    %mo →
                    %msup
                      %mi B
                      %mi A
                  %annotation{:encoding => "application/x-tex"} f^*\colon M^B\to B^A
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi M
                      %mi D
                    %mo →
                    %msup
                      %mi M
                      %mi C
                  %annotation{:encoding => "application/x-tex"} g^*\colon M^D\to M^C
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi M
                      %mi A
                    %mo →
                    %msup
                      %mi M
                      %mi C
                  %annotation{:encoding => "application/x-tex"} u_!\colon M^A\to M^C
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi M
                    %mi B
                  %mo →
                  %msup
                    %mi M
                    %mi D
                %annotation{:encoding => "application/x-tex"} v_!\colon M^B\to M^D
            and so on for the homotopically meaningful notions of pointwise
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} left Kan extension
          %ul
            %li
              If
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a model category, then
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u_!
              denotes the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of pointwise Kan extension along
              = succeed "." do
                %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %li
              If
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a simplicially enriched category, then
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u_!
              is the coherent pointwise
              %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy left Kan extension
              along
              = succeed "," do
                %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
            %li
              If
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is an
              = succeed "-category," do
                %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u_!
              denotes the pointwise
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Kan+extension"} (∞,1)-Kan extensions
              along
              = succeed "." do
                %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %li
              If
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a derivator, then
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u_!
              simply denotes the left adjoint of
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u^*
              (which is assumed to exist and to “be pointwise” by the derivator axioms).
          %p
            Assume that
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is such that the relevant extensions
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_!
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mo !
                %annotation{:encoding => "application/x-tex"} v_!
            exist. Then there is a canonical
            %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley transformation
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_32.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                  %msup
                    %mi f
                    %mo *
                  %mo →
                  %msup
                    %mi g
                    %mo *
                  %msub
                    %mi v
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_! f^* \to g^* v_!
          %p defined as the composite
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_33.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                  %msup
                    %mi f
                    %mo *
                  %mo →
                  %msub
                    %mi u
                    %mo !
                  %msup
                    %mi f
                    %mo *
                  %msup
                    %mi v
                    %mo *
                  %msub
                    %mi v
                    %mo !
                  %mo →
                  %msub
                    %mi u
                    %mo !
                  %msup
                    %mi u
                    %mo *
                  %msup
                    %mi g
                    %mo *
                  %msub
                    %mi v
                    %mo !
                  %mo →
                  %msup
                    %mi g
                    %mo *
                  %msub
                    %mi v
                    %mo !
                  %mo .
                %annotation{:encoding => "application/x-tex"} u_! f^* \to u_! f^* v^* v_! \to u_! u^* g^* v_! \to g^* v_!.
          %p
            and we say that the given square is
            %strong
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              \-exact
            if this transformation is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            = succeed "-exact" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %strong homotopy exact
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mate"} mates
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_37.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mo *
                  %msub
                    %mi g
                    %mo *
                  %mo →
                  %msub
                    %mi f
                    %mo *
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} v^* g_* \to f_* u^*
          %p
            is an equivalence, where
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mo *
                %annotation{:encoding => "application/x-tex"} g_*
            denote the analogous sort of
            %em right
            Kan extension.
          %p
            Of course when we say “for all
            = succeed "\u201D" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            we consider. However, we actually get the
            %em same
            definition regardless of whether we mean “for all model categories
            = succeed "\u201D" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "\u201D" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-categories" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "\u201D" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "\u201D." do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %h2#remarks Remarks
          %p
            Since any 1-category is a degenerate sort of
            = succeed "-category," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/exact+square"} exact
            in the usual 1-categorical sense, but the converse is not true. This also implies that a square can be
            = succeed "-exact" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            without being homotopy exact. However, there exists a “universal”
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that
            = succeed "-exactness" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mn ∞
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} M=\infty Gpd
          %h2#characterization Characterization
          %p
            Of course, the above definition is “functional”, while in practice we want some more combinatorial characterization which is easier to check. This can be done completely analogously to the characterization of ordinary
            %a.existingWikiWord{:href => "/nlab/show/exact+square"} exact squares
            using comma objects, except that at the last step we need to consider a more restricted notion of “equivalence” (i.e. a more restricted
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/basic+localizer"} basic localizer
          %p
            The characterization is the following. Given
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b\in B
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\in C
            and
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi\colon v(b) \to g(c)
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo{:stretchy => "false"} /
                  %mi c
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi φ
                %annotation{:encoding => "application/x-tex"} (b/A/c)_\varphi
            denote the category whose objects are triples
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,\alpha,\beta)
            with
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %mi u
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} \alpha\colon u(a)\to c
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:lspace => "verythinmathspace"} :
                  %mi b
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta\colon b\to f(a)
            such that
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} g(\alpha) \circ v(\beta) = \varphi
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo →
                  %mi a
                  %mo ′
                %annotation{:encoding => "application/x-tex"} a\to a'
            making two triangles commute.
          .un_theorem
            %h6#theorem Theorem
            %p
              A square is homotopy exact if and only if each category
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi φ
                  %annotation{:encoding => "application/x-tex"} (b/A/c)_\varphi
              has a
              %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
          %ul
            %li
              See
              %a{:href => "/nlab/show/exact+square#CommaObj"} exact square
              for the proof that is being generalized.
            %li
              See
              %a{:href => "/nlab/show/derivator#ExactSquares"} derivator
              for the proof in the case of derivators, which relies on Cisinski’s characterization of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/basic+localizer"} basic localizers
            %li
              The proof in the (∞,1)-categorical case generalizes the characterization of
              = succeed "." do
                %a{:href => "/nlab/show/final+(∞,1%29-functor#Properties"} final (∞,1)-functors
          %h2#examples Examples
          %h3#comma_squares Comma squares
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma square
            is homotopy exact. In other words, if
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} /
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A=(v/g)
            is the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            with
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            the canonical projections, then the square is homotopy exact. If in addition
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} C=*
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            just picks out an object
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} d\in D
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the comma category
            = succeed ";" do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} /
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v/d)
          %h3#fully_faithful_functors Fully faithful functors
          %p
            If
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} u\colon A\to B
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful functor
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_72.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi id
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi id
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi u
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %munder
                            %mo →
                            %mi u
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \overset{id}{\to} &amp; A\\
                  ^{id}\downarrow &amp;&amp; \downarrow^u\\
                  A &amp; \underset{u}{\to} &amp; B}
          %p
            is homotopy exact. This just says that the unit
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi A
                  %mo →
                  %msup
                    %mi u
                    %mo *
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} Id_A \to u^* u_!
            is an isomorphism, i.e. that left (and equivalently right) homotopy Kan extensions along
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            are “honest” extensions.
          %h3#final_functors Final functors
          %p
            A functor
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} u\colon A\to B
            is a
            %a.existingWikiWord{:href => "/nlab/show/final+%28infinity%2C1%29-functor"} homotopy final functor
            if and only if the square
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_76.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi u
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %munder
                            %mo →
                            %mrow
                        %mtd
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \overset{u}{\to} &amp; B\\
                  \\downarrow &amp;&amp; \downarrow\\
                  *&amp; \underset{}{\to} &amp; *}
          %p
            is homotopy exact. Homotopy exactness of this square says that for
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} F\colon B\to M
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hocolim
                    %mi A
                  %msup
                    %mi u
                    %mo *
                  %mi F
                  %mo →
                  %msub
                    %mi hocolim
                    %mi B
                  %mi F
                %annotation{:encoding => "application/x-tex"} hocolim_A u^*F \to hocolim_B F
            is an isomorphism, which is one equivalent definition of when
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is homotopy final. In this case, the characterization theorem reduces to saying that
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is homotopy final if and only if each comma category
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi u
                %annotation{:encoding => "application/x-tex"} b/u
            has a contractible nerve, which is a known characterization of homotopy final functors.
          %h3#PullbacksOfFibrations Pullbacks of fibrations
          %p
            This example is due to
            = succeed "." do
              %a{:href => "#Groth"} Moritz Groth
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} p\colon C\to D
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck opfibration
          .maruku-equation
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_83.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi u
                        %mtd
                          %mi C
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi v
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi p
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mi q
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{ A &amp; \xrightarrow{u} &amp; C \\
                  ^v\downarrow &amp;&amp; \downarrow^p\\
                  B &amp; \xrightarrow{q} &amp; D }
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p
            For a proof, suppose given
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b\in B
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\in C
            and a morphism
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi\colon p(c) \to q(b)
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be the category whose contractibility we must check. By definition, since
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                    %msub
                      %mo ×
                      %mi D
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A = B\times_D C
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            consists of objects
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ′
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c'\in C
            and
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ′
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b'\in B
            such that
            = succeed "," do
              %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(c') = q(b')
            %math#mathml_0f5e1be87694ca9e1bbc9098abd259afbfc74b8a_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
