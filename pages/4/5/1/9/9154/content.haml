                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)\times O(k-n) \hookrightarrow O(k)
            %p
              Generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi V
                  %annotation{:encoding => "application/x-tex"} W \subset V
              an inclusion of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              vector spaces, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
