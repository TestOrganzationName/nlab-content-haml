                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo −
