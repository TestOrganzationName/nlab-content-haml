                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Gr_n(\mathbb{R}^k) \coloneqq O(k)/(O(n) \times O(k-n))
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+group"} product group
              is via its canonical embedding
