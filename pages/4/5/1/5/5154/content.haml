              %li
                %a{:href => "#Examples"} Examples
              %ul
                %li
                  %a{:href => "#monoids_associative_algebras"} Monoids (associative algebras)
                %li
                  %a{:href => "#AInfAlgebras"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
