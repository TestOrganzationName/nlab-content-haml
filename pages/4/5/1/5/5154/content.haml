          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            enriched in some suitable
            %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is supposed to be a
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebras+over+an+%28%E2%88%9E%2C1%29-operad"} ∞-algebras over an (∞,1)-operad
          %h2#definition Definition
          %h2#existence Existence
          %h3#cofibrant_operads Cofibrant operads
          .un_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+model+category"} symmetric monoidal model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
              be a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/operad"} operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              satisfies the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoid+axiom+in+a+monoidal+model+category"} monoid axiom in a monoidal model category
              %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
              on the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_C(O)
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
          %p
            See (
            %a{:href => "#Spitzweck01"}> Spitzweck 01
            , Theorem 4).
          %h3#objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-objects
          .num_defn
            %h6#assumption Assumption
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              equipped with the structure of
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %li
                %p
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            %p such that
            %ul
              %li
                %p
                  the model structure is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %li
                %p
                  the tensor unit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  is cofibrant.
          .num_prop
            %h6#proposition Proposition
            %p
              Under these conditions there is for each
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              the structure of a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              on the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℰ
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}^{\mathbf{B}G}
              of objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              equipped with a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℰ
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}^{\mathbf{B}G} \to \mathcal{E}
            %p preserves and reflects fibrations and weak equivalences.
          %p
            This is discussed in the examples at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
          %h3#coloured_operads Coloured operads
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} C \in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            a set of colours and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/coloured+operad"} coloured operad
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}}(P)
            for the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi P
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi ℰ
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  U_P \;\colon\; Alg_{\mathcal{E}}(P) \to \mathcal{E}^C
          %p
            from the category of
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebras over the operad
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            to the underlying
            = succeed "-colored" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          #admissible.num_defn
            %h6#definition_2 Definition
            %p
              A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/coloured+operad"} coloured operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is called
              %strong admissible
              if the
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}}(P)
              along the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi P
                    %mo :
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi ℰ
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    U_P : Alg_{\mathcal{E}}(P)
                    \\to \mathcal{E}^{C}
            %p exists.
          .num_defn
            %h6#remark Remark
            %p
              So if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is admissible, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}}(P)
              carries the model structure where a morphism of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              is a fibration or weak equivalence if the underlying morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is, respectively.
            %p
              Below we discuss general properties of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              under which this model structure indeed exists.
          %h2#properties Properties
          %h3#existence_by_coalgebra_intervals Existence by coalgebra intervals
          %p
            The above
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            on
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            exists if there is a suitable
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                cocommutative coalgebra
                %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} H\in \mathcal{E}
              is
            %ul
              %li
                %p
                  a cocommutative co-unital
                  %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %li
                %p equipped with a factorization
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                        %mo :
                        %mi I
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi I
                        %mo ↪
                        %mi H
                        %mo →
                        %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\nabla : I \coprod I \hookrightarrow H \to I
                %p
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  into two
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℰ
                        %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .num_example
            %h6#examples Examples
            %p Such cocommutative coalgebra intervals exist in
            %ul
              %li
                %p
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on compactly generated topological spaces
              %li
                %p
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              %li
                %p
                  the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+symmetric+spectra"} model structure on symmetric spectra
            %p In
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
            %p there is a coalgebra interval.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal
              fibrant replacement functor and a coalgebra
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              then every non-symmetric
              %a.existingWikiWord{:href => "/nlab/show/coloured+operad"} coloured operad
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is admissible, def.
              = succeed ":" do
                %a.maruku-ref{:href => "#admissible"}
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              on algebras exists.
            %p If the interval is moreover cocommutative, then the same is true for every symmetric coloured operad.
          %p
            This is (
            %a{:href => "#BergerMoerdiskAlgebras"}> BergerMoerdijk, theorem 2.1
            ), following (
            %a{:href => "#BergerMoerdijkHomotopy"}> BergerMoerdijk-Homotopy, theorem 3.2
            ). For more details see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
          .num_remark
            %h6#remark_2 Remark
            %p
              Since the coalgebra interval in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              is not cocommutative, this case requires special discussion, as some of the statements below will not apply to it. For more on this case see
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras+over+an+operad"} model structure on dg-algebras over an operad
          %h3#RectificationOfAlgebras Rectification of algebras
          %p
            Recall the notion of resolutions of operads and of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(H,P)
            from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
          %p
            We now discuss conditions under which model categories of algebras over a resolved operad is Quillen equivalent to that over the original operad. This yields general
            %em
              %a.existingWikiWord{:href => "/nlab/show/rectification"} rectification
            results for homotopy-algebras over an operad (see also the
            %em
              %a{:href => "#Examples"} Examples
            below.)
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be in addition a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi P
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \phi : P \to Q
              a weak equivalence between admissible
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed "-coloured" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mo !
                    %mo ⊣
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ←
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\phi_! \dashv \phi^*) :
                    Alg_\mathcal{E}(P)
                    \\stackrel{\leftarrow}{\to}
                    Alg_\mathcal{E}(Q)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %p
            This is (
            %a{:href => "#BergerMoerdijkAlgebras"}> BergerMoerdijk, theorem 4.1
            ).
          #RectificationTheorem.num_theorem
            %h6#theorem_4 Theorem
            %p
              %strong
                (rectification of homotopy
                = succeed "-algebras)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %p
              Let still
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be left proper.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be an admissible
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              such that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(H,P)
              is admissible.
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϵ
                      %mo !
                    %mo ⊣
                    %msup
                      %mi ϵ
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ←
                    %msub
                      %mi Alg
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\epsilon_! \dashv \epsilon^*) :
                    Alg_\mathcal{E}(P)
                    \\stackrel{\leftarrow}{\to}
                    Alg_\mathcal{E}(W(H,P))
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %h2#equivalence_of_modelcategorical_algebras_and_quasicategorical_algebras Equivalence of model-categorical algebras and quasicategorical algebras
          %p
            The results of
            = succeed "," do
              %a{:href => "#Lurie.HA"} Lurie
            = succeed "," do
              %a{:href => "#PavlovScholbach18"} Pavlov–Scholbach
            %a{:href => "#Haugseng"} Haugseng
            establish an equivalence of
            %a.existingWikiWord{:href => "/nlab/show/quasicategories"} quasicategories
            between the underlying quasicategory of the model category of algebras over an operad and the quasicategory of quasicategorical algebras over the underlying quasicategorical operad, provided some mild conditions are met.
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Theorem 7.11 in
              = succeed "," do
                %a{:href => "#PavlovScholbach18"} Pavlov–Scholbach
              = succeed ".)" do
                %a{:href => "#Haugseng"} Haugseng
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+model+category"} symmetric monoidal model category
              equipped with a subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} V^\flat
              of flat objects. Given a flat admissible Σ-cofibrant
              = succeed "-operad" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                    %annotation{:encoding => "application/x-tex"} O
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi O
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi Alg
                      %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_O(V)^c[W_O^{-1}]\to Alg_O(V[W^{-1}])
            %p
              is an equivalence of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasicategories"} quasicategories
          %p
            Here a full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo ♭
                  %mo ⊂
                  %mi V
                %annotation{:encoding => "application/x-tex"} V^\flat\subset V
            is a
            %strong subcategory of flat objects
            (
            %a{:href => "#Haugseng"}> Haugseng
            , Definition 4.1) if it contains all cofibrant objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} V^\flat
          %p
            Here a
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %strong flat
            if it is enriched in the subcategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo ♭
                    %mo ⊂
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V^\flat\subset V
          %p
            An operad is
            %strong admissible
            if the category of algebras admits a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
          %p
            An operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            is
            %strong Σ-cofibrant
            if the unit map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1\to O(1)
            is a cofibration and the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            is cofibrant in the projective model structure on
            = succeed "-objects" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma_n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            By Remark 4.9 in
            = succeed "," do
              %a{:href => "#Haugseng"} Haugseng
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(x,x)
            are flat.
          %h2#Examples Examples
          %h3#monoids_associative_algebras Monoids (associative algebras)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mi Assoc
                %annotation{:encoding => "application/x-tex"} P = Assoc
            the
            %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
            it category of algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mi P
                %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}} P
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of monoids
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mi P
                %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}} P
            is the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+monoids+in+a+monoidal+model+category"} model structure on monoids in a monoidal model category
          %h3#AInfAlgebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            \-Algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Assoc
                %annotation{:encoding => "application/x-tex"} Assoc
            be the
            %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
            in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            regarded as an operad in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            under the
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo :
                    %mi Set
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Disc : Set \to Top
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mo *
                %annotation{:encoding => "application/x-tex"} I_*
            be the operad whose algebras are pointed objects. There is a canonical morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi I
                      %mo *
                    %mo →
                    %mi Assoc
                  %annotation{:encoding => "application/x-tex"} i : I_* \to Assoc
          .num_lemma
            %h6#claim Claim
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/relative+Boardman-Vogt+resolution"} relative Boardman-Vogt resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo *
                    %mo ↪
                    %msub
                      %mi I
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mi i
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi I
                      %mo *
                    %mo →
                    %mi Assoc
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Assoc
                  %annotation{:encoding => "application/x-tex"}
                    I_* \hookrightarrow I_*[i] \hookrightarrow W([0,1], I_* \to Assoc)  \stackrel{\simeq}{\to} Assoc
            %p
              produces precisely
              = succeed "\u2018s" do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Stasheff
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+operad"} A-∞ operad
          %p
            This is (
            %a{:href => "#BergerMoerdijkAlgebras"}> BergerMoerdijk, page 13
            )
          .num_cor
            %h6#corollary Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
              is equivalent as an
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
          .proof
            %h6#proof Proof
            %p
              This follows from the
              = succeed "," do
                %a{:href => "#RectificationTheorem"} rectification theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi I
                      %mo *
                    %mo →
                    %mi Assoc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W([0,1], I_* \to Assoc)
              are precisely
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
          .num_remark
            %h6#remark_3 Remark
            %p
              This is a classical statement. See
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
              for background and references.
          %h3#algebras_and_simplicial_lie_algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            \-algebras and simplicial Lie algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lie
                %annotation{:encoding => "application/x-tex"} Lie
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+operad"} Lie operad
          %p
            A cofibrant resolution is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"} L-infinity algebras
          %p Now (…)
          %h3#HomotopyCoherentDiagrams Homotopy coherent diagrams
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a small
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            with set of objects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Obj(C)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Diag
                    %mi C
                %annotation{:encoding => "application/x-tex"} Diag_{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Diag
                    %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi c
                    %mi n
                  %mo ;
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi if
                            %mi n
                            %mo =
                            %mn 1
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  Diag_C(c_1, \cdots, c_n;c) =
                  \\left\{
                  \\array{
                  C(c_1, c) &amp; if n = 1
                  \\\
                  \\emptyset &amp; otherwise
                  }
                  \\right.
          %p
            whose algebras are
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi ℰ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F : C \to \mathcal{E}
                  \\,,
          %p
            hence
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi HoCoDiag
                    %mi C
                  %mo :
                  %mo =
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo ,
                  %msub
                    %mi Diag
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  HoCoDiag_C := W(H,Diag_C)
          %p
            is the operad for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+diagram"} homotopy coherent diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/rectification"} rectification
            theorem above now says that every homotopy coherent diagram is equivalent to an ordinary
            = succeed "-diagram." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{E} =
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            this is known as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Vogt%27s+theorem"} Vogt's theorem
          %h3#InfCatOfMods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-Categories of algebras and bimodules over an operad
          %p
            The constuction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}}(P)
            of a category of
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            is contravariantly functorial in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo •
                %annotation{:encoding => "application/x-tex"} P^\bullet
            is a
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            in the category of operads, we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi P
                    %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Alg_{\mathcal{E}}(P^\bullet)
            is a (large)
            %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
            of algebras. Moreover, the
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(P)
            is functorial in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p These two facts together allow us to construct simplicial categories of homotopy algebras.
          %p
            Specifically, there is a cosimplicial operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Assoc
                    %mo •
                %annotation{:encoding => "application/x-tex"} Assoc^\bullet
            which
          %ul
            %li
              %p
                in degree 0 is the usual
                %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Assoc
                          %mn 0
                        %mo =
                        %mi Assoc
                      %annotation{:encoding => "application/x-tex"} Assoc^0  = Assoc
            %li
              %p
                in degree 1 is the operad whose algebras are triples consisting of two associative monoids and one
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
                between them;
            %li
              %p
                in degree 2 it is the operad whose algebras are tuples consisting of three associative algebras
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                      %mo ,
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %msub
                        %mi A
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A_0, A_1, A_2
                as well as one
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi i
                      %annotation{:encoding => "application/x-tex"} A_i
                = succeed "-bimodule" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi j
                      %annotation{:encoding => "application/x-tex"} A_j
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} N_{ i j}
                for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo &lt;
                      %mi j
                      %mo ≤
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 0 \leq i \lt j \leq 2
                and a homomorphism of bimodules
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mrow
                          %mn 0
                          %mn 1
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi A
                            %mn 1
                      %msub
                        %mi N
                        %mrow
                          %mn 1
                          %mn 2
                      %mo →
                      %msub
                        %mi N
                        %mrow
                          %mn 0
                          %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      N_{0 1} \otimes_{A_1} N_{1 2} \to N_{0 2}
            %li
              %p and so on.
          %p
            The simplicial category of algebras over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Assoc
                    %mo •
                %annotation{:encoding => "application/x-tex"} Assoc^\bullet
            is one incarnation of the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of algebras, bimodules and bimodules homomorphisms.
          %p
            We can pass to the corresponding
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            to the entire cosimplicial diagram of operads, to obtain the cosimplicial
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+operad"} A-∞ operad
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi A
                    %mn ∞
                    %mo •
                  %mo :
                  %mo =
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Assoc
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A_\infty^\bullet := W(Assoc^\bullet)
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
            of algebras over this has as objects
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
          %p
            This is discussed in (
            %a{:href => "#BergerMoerdijkAlgebras"}> BergerMoerdijkAlgebras, section 6
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+monoids+in+a+monoidal+model+category"} model structure on monoids in a monoidal model category
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+for+ring+spectra"} model structure for ring spectra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+modules+in+a+monoidal+model+category"} model structure on modules in a monoidal model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebra over a monad
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-monad"} ∞-algebra over an (∞,1)-monad
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+a+monad"} model structure on algebras over a monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+algebraic+theory"} algebra over an algebraic theory
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-algebraic+theory"} ∞-algebra over an (∞,1)-algebraic theory
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial T-algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"}> (∞,1)-operad
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+%28%E2%88%9E%2C1%29-operad"}> algebra over an (∞,1)-operad
                    ,
                    %strong model structure on algebras over an operad
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/module+over+an+algebra+over+an+%28%E2%88%9E%2C1%29-operad"}> module over an algebra over an (∞,1)-operad
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/model+structure+on+modules+over+an+algebra+over+an+operad"} model structure on modules over an algebra over an operad
          %h2#references References
          %p
            A general discussion of the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
            is in
          %ul#BergerMoerdijkHomotopy
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              %em Axiomatic homotopy theory for operads
              Comment. Math. Helv. 78 (2003), 805–831. (
              %a{:href => "http://arxiv.org/abs/math/0206094"}> arXiv:math/0206094
              )
          %p See also
          %ul
            %li#Spitzweck01
              %a.existingWikiWord{:href => "/nlab/show/Markus+Spitzweck"}> Markus Spitzweck
              ,
              = succeed "," do
                %em Operads, Algebras and Modules in General Model Categories
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/math/0101102"} arXiv:math/0101102
          %p
            The concrete construction of the specific cofibrant resolutions in these structures going by the name
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            is in
          %ul
            %li#BergerMoerdijkResolution
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              = succeed "," do
                %em The Boardman-Vogt resolution of operads in monoidal model categories
              = succeed ")" do
                %a{:href => "http://math.unice.fr/~cberger/BV.pdf"} pdf
          %p The discussion of the model structure on algebras over a suitable operad:
          %ul
            %li#BergerMoerdijkAlgebras
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              = succeed "," do
                %em Resolution of coloured operads and rectification of homotopy algebras
              = succeed "," do
                %em Categories in Algebra, Geometry and Mathematical Physics
              %strong 431
              (2007) 31-58 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0512576"}> arXiv:math/0512576
              ,
              = succeed "&rbrack;" do
                %a{:href => "www.ams.org/books/conm/431"} ams:conm/431
          %p
            More discussion on the transport of operad algebra structures along
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localizations
            between the underlying model categories is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carles+Casacuberta"}> Carles Casacuberta
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Javier+Guti%C3%A9rrez"} Javier Gutiérrez
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rainer+Vogt"} Rainer Vogt
                = succeed "," do
                  %em Localization of algebras over coloured operads
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0806.3983"} arXiv:0806.3983
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Javier+Guti%C3%A9rrez"}> Javier Gutiérrez
                ,
                = succeed "," do
                  %em Transfer of algebras over operads along derived Quillen adjunctions
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1104.0584"} arXiv:1104.0584
          %p
            Discussion with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
            realized as
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            is in
          %ul
            %li#Schwede12
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              , section III.6 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Symmetric spectra
              = succeed ")" do
                %a{:href => "http://www.math.uni-bonn.de/~schwede/SymSpec-v3.pdf"} pdf
          %p
            Discussion with application to
            %a.existingWikiWord{:href => "/nlab/show/homotopical+algebraic+quantum+field+theory"} homotopical algebraic quantum field theory
            is in
          %ul
            %li#BeniniSchenkelWoike18
              %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lukas+Woike"} Lukas Woike
              %em Homotopy theory of algebraic quantum field theories
              (
              %a{:href => "https://arxiv.org/abs/1805.08795"}> arXiv:1805.08795
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/rectification"} rectification
            of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operad"} symmetric
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/colored+operads"} colored operads
          %ul
            %li#PavlovScholbach18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Pavlov"}> Dmitri Pavlov
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jakob+Scholbach"} Jakob Scholbach
                = succeed "," do
                  %em Admissibility and rectification of colored symmetric operads
                %strong 11
                3 (2018) 559-601
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://doi.org/10.1112/topo.12008"} doi:10.1112/topo.12008
                %a{:href => "https://arxiv.org/abs/1410.5675"} arXiv:1410.5675
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#Haugseng
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"}> Rune Haugseng
                ,
                = succeed "," do
                  %em Algebras for enriched ∞-operads
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1909.10042"} arXiv
          %p These are based on an earlier account by Lurie:
          %ul
            %li{:id => "Lurie.HA"}
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
        .revisedby
          %p
