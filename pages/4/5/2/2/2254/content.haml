                              %mn 1
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi i
                              %mo =
                              %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a_{i,0}
                    \=
                    \\left\{
                    \\array{
                    1 &amp; if \; i = 1
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\;\;\;\;\,,
                    \\;\;\;\;\;
                    a_{0,i}
                    \=
                    \\left\{
                    \\array{
                    1 &amp; if \; i = 1
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is necessarily of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo +
                    %mi y
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ≥
                        %mn 1
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(x,y)
                    \\;=\;
                    x + y + \underset{i,j \geq 1}{\sum} a_{i,j} x^i y^j
                    \\,.
            %p
              The existence of inverses is no extra condition: by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on the index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              one finds that there exists a unique
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 1
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota(x) = \underset{i \geq 1}{\sum} \iota(x)_i x^i
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(x,\iota(x)) = 0
                    \\;\;\;\,,
                    \\;\;\;
                    \\mu(\iota(x),x) = 0
                    \\,.
            %p
              Hence 1-dimensional formal group laws over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Adic
                    %mi R
                    %msup
                      %mi CAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Adic R CAlg^{op}
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[ [ x ] ]
          .num_example
            %h6#example_3 Example
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msub
                      %mi a
                      %mn 3
                    %msup
                      %mi x
                      %mn 3
                    %mo +
                    %mi …
                  %annotation{:encoding => "application/x-tex"} f(x) = x + a_2 x^2 + a_3 x^3 + \ldots
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[ [x] ]
              has a functional or compositional inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(x)
              in the monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} x R[ [x] ]
              under composition. Thus we may define a 1-dimensional formal group law by the formula
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mu(x, y) = f^{-1}(f(x) + f(y))
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard's theorem
          %h3#formal_group_schemes Formal group schemes
          %p
            Much more general are
            %strong formal group schemes
            from (
            %a{:href => "#Grothendieck"}> Grothendieck
            )
          %p
            %strong Formal group schemes
            are simply the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/formal+schemes"} formal schemes
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
          %h3#formal_groups_over_an_operad Formal groups over an operad
          %p
            For a generalization over
            %a.existingWikiWord{:href => "/nlab/show/operads"} operads
            see (
            %a{:href => "#Fresse"}> Fresse
            ).
          %h2#properties Properties
          %h3#in_characteristic_0 In characteristic 0
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The quotient
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℳ
                      %mi FG
                    %mo ×
                    %mi Spec
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}_{FG} \times Spec \mathbb{Q}
              of formal group over the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              is isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}_m
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
              (over
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} Spec \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              0 every formal group is determined, up to unique
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          %p
            For instance (
            %a{:href => "#Lurie10"}> Lurie 10, lecture 12, corollary 3
            ).
          %h3#Universal1dFormalGroupLaw Universal 1d commutative formal group law
          %p
            It is immediate that there exists a ring carrying a universal formal group law. For observe that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %msubsup
                    %mi x
                    %mn 1
                    %mi i
                  %msubsup
                    %mi x
                    %mn 1
                    %mi j
                %annotation{:encoding => "application/x-tex"} \underset{i,j}{\sum} a_{i,j} x_1^i x_1^j
            an element in a
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            algebra, then the condition that it defines a
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            is equivalently a sequence of polynomial
            %a.existingWikiWord{:href => "/nlab/show/equations"} equations
            on the
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi k
                  %annotation{:encoding => "application/x-tex"} a_k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo =
                  %msub
                    %mi a
                    %mrow
                      %mi j
                      %mo ,
                      %mi i
                %annotation{:encoding => "application/x-tex"}
                  a_{i,j} = a_{j,i}
          %p and the unitality constraint means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mn 0
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi i
                            %mo =
                            %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi otherwise
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a_{i 0}
                  \=
                  \\left\{
                  \\array{
                  1 &amp; if \; i = 1
                  \\\
                  0 &amp; otherwise
                  }
                  \\right.
                  \\,.
          %p Similarly associativity is equivalently a condition on combinations of triple products of the coefficients. It is not necessary to even write this out, the important point is only that it is some polynomial equation.
          %p This allows to make the following definition
          #LazardRing.num_defn
            %h6#definition_3 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              is the
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              generated by elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} a_{i j}
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mi j
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2(i+j-1)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i,j \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi relations
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mi below
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L = \mathbb{Z}[a_{i j}] / (relations\;1,2,3\;below)
            %p quotiented by the relations
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo =
                        %msub
                          %mi a
                          %mrow
                            %mi j
                            %mi i
                      %annotation{:encoding => "application/x-tex"} a_{i j} = a_{j i}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mn 10
                        %mo =
                        %msub
                          %mi a
                          %mn 01
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} a_{10} = a_{01} = 1
                  ;
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∀
                        %mi i
                        %mo ≠
                        %mn 1
                        %mo :
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mn 0
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \forall i \neq 1: a_{i 0} = 0
              %li
                %p
                  the obvious
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
                  condition
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ,
                      %mi k
                    %annotation{:encoding => "application/x-tex"} i,j,k
            %p
              The
              %strong
                universal 1-dimensional commutative
                %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              is the formal power series with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the Lazard ring given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mo ∈
                    %mi L
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell(x,y) \coloneqq \sum_{i,j} a_{i j} x^i y^j \in L[ [ x , y ] ]
                    \\,.
          #LazardRing.num_remark
            %h6#remark Remark
            %p
              The grading is chosen with regards to the formal group laws arising from
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theories"} complex oriented cohomology theories
              (
              %a{:href => "complex+oriented+cohomology+theory#ComplexOrientedCohomologyTheoryFormalGroupLaw"}> prop.
              ) where the
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              naturally has degree -2. This way
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi i
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi j
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(a_{i j} x^i y^j)
                    \=
                    deg(a_{i j}) + i deg(x) + j deg(y)
                    \=
                    \-2
                    \\,.
          %p The following is immediate from the definition:
          #LazardRingIsUniversal.num_prop
            %h6#proposition_3 Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and 1-dimensional commutative
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#Commutative1DimFormalGroupLaw"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo ⟶
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; L \longrightarrow R
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LazardRing"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi ℓ
                    %mo =
                    %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast \ell = \mu
                    \\,.
          .proof
            %h6#proof Proof
            %p
              If the formal group law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              has coefficients
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_{i,j}\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mi ℓ
                      %mo =
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} f_\ast \ell = \mu
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi c
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i,j}{\sum} f(a_{i,j}) x^i y^j
                    \=
                    \\underset{i,j}{\sum} c_{i,j} x^i y^j
            %p
              it must be that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"}
                    f(a_{i,j}) = c_{i,j}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} a_{i,j}
              are the generators of the Lazard ring. Hence it only remains to see that this indeed constitutes a ring homomorphism. But this is guaranteed by the vary choice of relations imposed in the definition of the Lazard ring.
          %p What is however highly nontrivial is this statement:
          #LazardTheorem.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+theorem"}> Lazard's theorem
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LazardRing"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\simeq
                    \\mathbb{Z}[ t_1, t_2, \cdots ]
            %p
              in countably many generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi i
                    %annotation{:encoding => "application/x-tex"} 2 i
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lazard+theorem"} Lazard theorem
              %a.maruku-ref{:href => "#LazardTheorem"}
              first of all implies, via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#LazardRingIsUniversal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              then every choice of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi i
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_i \in R\}
              defines a formal group law. (On the other hand, it is nontrivial to say which formal group law that is.)
            %p
              Deeper is the fact expressed by the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Milnor-Quillen+theorem+on+MU"} Milnor-Quillen theorem on MU
              %a.maruku-ref{:href => "#LazardTheorem"}
              is canonically identified with the
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(M U)
              of
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of the universal complex
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/MU"} MU
                  carries a
                  %a.existingWikiWord{:href => "/nlab/show/universal+complex+orientation+on+MU"} universal complex orientation
                  in that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  any
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                  then homotopy classes of homotopy ring homomorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mi U
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} M U \to E
                  are in bijection to
                  %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex orientations
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex orientation
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  induced a 1-dimensional commutative
                  %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
                  (
                  %a{:href => "complex+oriented+cohomology+theory#ComplexOrientedCohomologyTheoryFormalGroupLaw"}> prop.
                  )
              %li
                %p
                  under forming stable homotopy groups every ring spectrum homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mi U
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} M U \to E
                  induces a ring homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ≃
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        L \simeq \pi_\bullet(M U) \longrightarrow \pi_\bullet(E)
                %p
                  and hence, by the universality of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            %p This is the formal group law given by the above complex orientation.
            %p
              Hence the universal group law over the Lazard ring is a kind of
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+complex+orientation+on+MU"} universal complex orientation on MU
