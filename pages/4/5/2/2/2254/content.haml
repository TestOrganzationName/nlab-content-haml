          #Commutative1DimFormalGroupLaw.num_example
            %h6#example_2 Example
            %p
              A 1-dimensional commutative formal group law according to def.
              %a.maruku-ref{:href => "#GroupObjectFormalGroupLaw"}
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ≥
                        %mn 0
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
