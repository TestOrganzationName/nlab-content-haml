              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            #eq:EquivalenceOfEquivariantTopologicalGroupsToSemidirectProductTopGroups.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
