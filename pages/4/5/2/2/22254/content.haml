                          %mo ,
                          %mi g
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (e, g)
              %li
                %p
                  the
                  %a{:href => "action#eq:ActionPropertyOfGroupActions"} action property
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  on the underlying topological spaces is equivalently the
                  %a{:href => "action#eq:ActionPropertyOfGroupActions"} action property
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
