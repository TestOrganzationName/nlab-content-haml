            %p
              (which jointly witness the semidirect product as a split group extension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")." do
                %a{:href => "group+extension#SplitExtensionsAndSemidirectProductGroups"} there
          .proof
            %h6 Proof
            %p This is a straightforward matter of unwinding the definitions:
            %p
              First to see that we have a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              as claimed:
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Actions
                    %mo{:stretchy => "false"} (
                    %mi TopologicalSpaces
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G Actions(TopologicalSpaces)
              is, by definition, a plain
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              whose underlying topological space is equipped with a continuous
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              and such such this
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              and a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⟶
                    %msub
                      %mi Aut
                      %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \;\colon\;G \longrightarrow Aut_{Grp}(\mathcal{G})
              to the group-
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              (whose
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} hom
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %a.maruku-eqref{:href => "#eq:HomAdjunctInTopologicalSpaces"} (1)
              is
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
            %p
              This is exactly the data that determines the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ASemidirectProductGroup"} (4)
            %p
              Moreover, a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of equivariant groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo ,
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{G}_1, \alpha_1) \longrightarrow (\mathcal{G}_2, \alpha_2)
              is a continuous
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi \,\colon\, \mathcal{G}_1 \longrightarrow \mathcal{G}_2
              whose underlying map is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo ∘
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    g \in G
                    }{\forall}
                    \\;\;
                    \\;\;
                    \\phi \circ \alpha_1(g) \;=\; \alpha_2(g) \circ \phi
                    \\,.
            %p
              By
              %a.maruku-eqref{:href => "#eq:ASemidirectProductGroup"} (4)
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              induces a
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+groups"} semidirect product groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 1
                            %msub
                              %mo ⋊
                              %mrow
                                %msub
                                  %mi α
                                  %mn 1
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 2
                            %msub
                              %mo ⋊
                              %mrow
                                %msub
                                  %mi α
                                  %mn 2
                            %mi G
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 1
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi ϕ
                                %mo ×
                                %msub
                                  %mi id
                                  %mi G
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 2
                            %mo ×
                            %mi G
