            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+space"} regularity
          %p
            An apartness space is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/locally+decomposable+space"} locally decomposable
            if whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\bowtie A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} x\bowtie B
            and every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            satisfies either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} y\bowtie A
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} y\in B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ⋈
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} B = \{ y \mid \neg(y\bowtie A) \}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≠
                %annotation{:encoding => "application/x-tex"} \neq
            the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
          %h2#relation_to_topological_spaces Relation to topological spaces
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a topological space, we define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x\bowtie A
            if there is a neighborhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            disjoint from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a neighborhood of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an apartness space. Only the last axiom is somewhat nontrivial: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} x\in U
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            open and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi A
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} U\cap A = \emptyset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi y
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ⋈
                    %mi A
                    %mo →
                    %mi y
                    %mo ∉
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie A \to y\notin B)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ⋈
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (y\in U) \Rightarrow (y\bowtie A)
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∩
                  %mi B
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} U\cap B = \emptyset
            too, so
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x\bowtie B
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an apartness space, define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\subseteq X
            to be a neighborhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} x\in U
            if there is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x\bowtie A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi y
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ⋈
                    %mi A
                    %mo ⇒
                    %mi y
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie A \Rightarrow y\in U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a topological space. Again the nontrivial part is the “transitivity” of neighborhoods, i.e. that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a neighborhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            then so is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi U
                %annotation{:encoding => "application/x-tex"} \{ y \mid U
            is a neighborhood of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} y \}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x\bowtie A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi y
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ⋈
                    %mi A
                    %mo ⇒
                    %mi y
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie A \Rightarrow y\in U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a neighborhood of any point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y\bowtie A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi y
                  %mo ⋈
                  %mi A
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ y \mid y\bowtie A\}
            is a neighborhood of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            If we order the topologies on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mo ≤
                  %msub
                    %mi τ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \tau_1 \le \tau_2
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 2
                  %mo ⊆
                  %msub
                    %mi τ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \tau_2 \subseteq \tau_1
            (i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \tau_1
            is finer than
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \tau_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋈
                    %mn 1
                  %mo ≤
                  %msub
                    %mo ⋈
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \bowtie_1 \le \bowtie_2
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo ⋈
                      %mn 2
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo ⋈
                      %mn 1
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x\bowtie_2 A) \Rightarrow (x\bowtie_1 A)
            %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ↦
                  %msub
                    %mo ⋈
                    %mi τ
                %annotation{:encoding => "application/x-tex"} \tau \mapsto \bowtie_\tau
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋈
                  %mo ↦
                  %msub
                    %mi τ
                    %mo ⋈
                %annotation{:encoding => "application/x-tex"} \bowtie \mapsto \tau_\bowtie
            respectively. Moreover, we have:
          .un_theorem
            %h6#theorem Theorem
            %p
              The above functions exhibit the poset of apartnesses on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
              sub-poset of the poset of topologies on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo ≤
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mo ⋈
                          %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau \le \tau_{\bowtie_\tau}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⋈
                        %mrow
                          %msub
                            %mi τ
                            %mo ⋈
                      %mo =
                      %mo ⋈
                    %annotation{:encoding => "application/x-tex"} \bowtie_{\tau_\bowtie} = \bowtie
          .proof
            %h6#proof Proof
            %p
              For the former inequality, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is open in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mo ⋈
                            %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau_{\bowtie_\tau}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              there is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ⋈
                      %mi τ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\bowtie_\tau A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi y
                      %msub
                        %mo ⋈
                        %mi τ
                      %mi A
                      %mo ⇒
                      %mi y
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie_\tau A \Rightarrow y\in U)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ⋈
                        %mi τ
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x\bowtie_\tau A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x\in V
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} V\cap A = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} y\in V
              satisfies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %msub
                        %mo ⋈
                        %mi τ
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y\bowtie_\tau A
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} y\in U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊆
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V\subseteq U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is open.
            %p
              For the latter equation, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⋈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x\bowtie A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ⋈
                      %mrow
                        %msub
                          %mi τ
                          %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \bowtie_{\tau_\bowtie} A
              we must construct an open set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mo ⋈
                  %annotation{:encoding => "application/x-tex"} U\in \tau_\bowtie
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U\cap A = \emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi y
                      %mo ⋈
                      %mi A
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U = \{ y \mid y\bowtie A \}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ⋈
                        %mrow
                          %msub
                            %mi τ
                            %mo ⋈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \bowtie_{\tau_\bowtie} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mo ⋈
                  %annotation{:encoding => "application/x-tex"} U\in \tau_\bowtie
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U\cap A = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mo ⋈
                  %annotation{:encoding => "application/x-tex"} U\in \tau_\bowtie
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              mean there is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x\bowtie B
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ⋈
                      %mi B
                      %mo ⇒
                      %mi y
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie B \Rightarrow y\in U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\bowtie A
              it suffices to show
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ⋈
                      %mi B
                      %mo →
                      %mi y
                      %mo ∉
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall y, (y\bowtie B \to y\notin A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ⋈
                    %mi B
                    %mo ⇒
                    %mi y
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} y\bowtie B \Rightarrow y\in U
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U\cap A = \emptyset
          %p
            In other words, an apartness space can be regarded as a well-behaved kind of topological space: one in which for every open neighborhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            there is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and an open neighborhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∩
                  %mi A
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} V\cap A = \emptyset
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            contains the interior of the complement of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is then in the interior of the complement of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is in the interior of the complement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            then the latter is such a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi int
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in int(\neg A) \subseteq U
            %a{:href => "#BSV"} Bridges et. al.
            this condition is called being
            = succeed "." do
              %strong topologically consistent
          %p
            A sufficient condition for topological consistency is local decomposability. This was defined above for apartness spaces; more generally, a topological space is said to be
            %a.existingWikiWord{:href => "/nlab/show/locally+decomposable+space"} locally decomposable
            if for every open neighborhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            there is an open neighborhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∪
                    %mo ¬
                    %mi V
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \cup \neg V = X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} y\in X
            satisfies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∉
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (y\in U)\vee (y\notin V)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi int
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mo ¬
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo ¬
                    %mo ¬
                    %mi V
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in int(\neg\neg V) \subseteq \neg\neg V \subseteq U
          %p
            In contrast to the above theorem, it is not quite justified to say that the
            %em category
            of apartness spaces is a subcategory of the category of topological ones. It is most natural to say that a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            between apartness spaces is
            %strong continuous
            if for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x\in X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A\subseteq X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⋈
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \bowtie f(A)
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\bowtie A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are topological spaces and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is topologically continuous, then it is apartness-continuous in this sense for the induced apartnesses. For if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)\bowtie f(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} f(x) \in U
            for some open set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            disjoint from
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            then gives that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{-1}(U)
            is an open set containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and disjoint from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\bowtie A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo →
                    %mi Apart
                  %annotation{:encoding => "application/x-tex"} Top \to Apart
          %p
            However, a continuous map between apartness spaces in the above sense apparently need not be continuous for the induced topologies; but this is true if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is locally decomposable. For if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} U\subseteq Y
            is open and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\in f^{-1}(U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} A\subseteq Y
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} f(x)\bowtie A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} y\bowtie A
            implies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} y\in U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ⊆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} B\subseteq Y
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} f(x)\bowtie B
            and every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            satisfies either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} y\bowtie A
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} y\in B
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C = f^{-1}(B)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                    %mo ⋈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x'\bowtie C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ′
                  %mo ∉
                  %mi C
                %annotation{:encoding => "application/x-tex"} x'\notin C
            and hence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f(x')\notin B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} f(x')\bowtie A
            and thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} f(x')\in U
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                    %mo ∈
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x'\in f^{-1}(U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} f(x)\bowtie B
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi C
                %annotation{:encoding => "application/x-tex"} x\bowtie C
            by apartness-continuity. Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{-1}(U)
            is open.
          %p Thus, the category of locally decomposable apartness spaces is equivalent to the category of locally decomposable topological spaces.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/unified+topological+space"} unified topological space
          %h2#references References
          %p
            Notions of “apartness space” based on a presentation in terms of basic opens, somewhat akin to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+topology"} formal topology
          %ul#FW96
            %li
              %a.existingWikiWord{:href => "/nlab/show/Franka+Waaldijk"}> Franka Waaldijk
              ,
              = succeed "," do
                %em Modern intuitionistic topology
              %a{:href => "http://www.fwaaldijk.nl/modern%20intuitionistic%20topology.pdf"} link
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Franka+Waaldijk"}> Franka Waaldijk
              ,
              = succeed "," do
                %em Natural topology
              %a{:href => "https://arxiv.org/abs/1210.6288"} arxiv
          %p The above definition in terms of an apartness relation between points and subsets is slightly adapted from the version given in:
          %ul#BSV02
            %li
              %a.existingWikiWord{:href => "/nlab/show/Douglas+Bridges"}> Douglas Bridges
              , Peter Schuster, and Luminita Vita,
              = succeed "," do
                %em Apartness, Topology, and Uniformity: a Constructive View
              %a{:href => "http://dx.doi.org/10.1002/1521-3870%28200210%2948:1%2B%3C16::AID-MALQ16%3E3.0.CO;2-7"} doi
          %ul#BV11
            %li
              %a.existingWikiWord{:href => "/nlab/show/Douglas+Bridges"} Douglas Bridges
              and Luminita Vita,
              = succeed "." do
                %em Apartness and Uniformity: A Constructive Development
              %a{:href => "http://link.springer.com/book/10.1007%2F978-3-642-22415-7"} link
        .revisedby
