                      %a.existingWikiWord{:href => "/nlab/show/P%C3%B3lya+enumeration+theorem"} Pólya enumeration theorem
                  %p
                    %strong Combinatorial identities
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/binomial+theorem"} binomial theorem
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Catalan+number"} Catalan number
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Chu%E2%80%93Vandermonde+identity"} Chu–Vandermonde identity
                  %p
                    %strong Polytopes
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/associahedron"} associahedron
                  .property
                    category:
                    %a.category_link{:href => "/nlab/all_pages/combinatorics"} combinatorics
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#example_schur_functors"} Example: Schur functors
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong 2-plethory
            (
            %a{:href => "#BMT21"}> Baez-Moeller-Trimble
            ) is a categorification of a rig-
            %a.existingWikiWord{:href => "/nlab/show/plethory"}> plethory
            \. Just as a rig-plethory is defined as a monoid in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Birig
                    %mo ,
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathsf{Birig}, \odot)
            %a.existingWikiWord{:href => "/nlab/show/pseudomonoid"} pseudomonoid
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Birig
                    %mo ,
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2\mathsf{Birig}, \odot)
          %p
            The property that polynomials in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{N}[x]
            can be composed is a consequence of the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{N}[x]
            is the free rig in one generator, and hence represents the identity functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Rig
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Rig
                  %annotation{:encoding => "application/x-tex"} \mathsf{Rig}\to \mathsf{Rig}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Schur+functor"} Schur functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Schur
                %annotation{:encoding => "application/x-tex"} \mathsf{Schur}
            can be seen as a 2-rig (in the sense below) representing the identity 2-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Rig
                    %mo →
                    %mn 2
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Rig
                  %annotation{:encoding => "application/x-tex"} 2\mathsf{Rig}\to 2\mathsf{Rig}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Schur
                %annotation{:encoding => "application/x-tex"} \mathsf{Schur}
            has the structure of a 2-plethory. Taking isomorphism classes, one recovers the rig-
            %a.existingWikiWord{:href => "/nlab/show/plethory"} plethory
            structure on the positive
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+function"} symmetric function
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/plethysm"} plethysm
          %h2#definitions Definitions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of characteristic zero, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Rig
                %annotation{:encoding => "application/x-tex"} \mathsf{Rig}
            be the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Rig
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} U:\mathsf{Rig} \to \mathsf{Set}
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          %p A birig is equivalently defined as:
          %ul
            %li
              %p
                A rig object in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi Rig
                          %mtext op
                      %annotation{:encoding => "application/x-tex"} \mathsf{Rig}^\text{op}
            %li
              %p
                A rig
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                and a lift of the representable functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                      %mo →
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathsf{Rig}(B,-):\mathsf{Rig}\to \mathsf{Set}
                to a functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi B
                      %mo :
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                      %mo →
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                    %annotation{:encoding => "application/x-tex"} \Phi_B:\mathsf{Rig}\to \mathsf{Rig}
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∘
                        %msub
                          %mi Φ
                          %mi B
                        %mo =
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Rig
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U \circ \Phi_B=\mathsf{Rig}(B,-)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mi B
                      %annotation{:encoding => "application/x-tex"} \Phi_B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi B
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \Phi_B'
                can be composed. Denote the resulting object by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊙
                        %mi B
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} B\odot B'
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mi B
                        %mo ∘
                        %msub
                          %mi Φ
                          %mi B
                        %mo ′
                        %mo =
                        %msub
                          %mi Φ
                          %mrow
                            %mi B
                            %mo ′
                            %mo ∘
                            %mi B
                      %annotation{:encoding => "application/x-tex"} \Phi_B \circ \Phi_B'=\Phi_{B' \circ B}
            %li
              %p
                A functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo :
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                      %mo →
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Rig
                    %annotation{:encoding => "application/x-tex"} \Phi:\mathsf{Rig}\to \mathsf{Rig}
                that is a right adjoint.
          %p
            Denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Birig
                  %mo ,
                  %mo ⊙
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathsf{Birig}, \odot)
            the monoidal category of birigs, viewed as a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Rig
                  %annotation{:encoding => "application/x-tex"} \mathsf Rig
          %p
            A rig-
            %a.existingWikiWord{:href => "/nlab/show/plethory"} plethory
            is equivalently defined as:
          %ul
            %li
              %p
                A monoid in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Birig
                        %mo ,
                        %mo ⊙
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathsf{Birig}, \odot)
            %li
              %p
                A birig
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \Phi_B
                is a comonad.
          %p The categorified versions of the definitions above are as follows.
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Rig
                %annotation{:encoding => "application/x-tex"} 2\mathsf{Rig}
            has:
          %ul
            %li
              %p
                Objects:
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal"} symmetric monoidal
                = succeed "-linear" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete"} Cauchy complete
            %li
              %p
                1-morphisms:
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal"} symmetric monoidal
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+functor"} linear functor
            %li
              %p
                2-morphisms:
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal"} symmetric monoidal
                linear natural transformations.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi U
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Cat
                %annotation{:encoding => "application/x-tex"} \mathsf{U}:\mathsf{2Rig} \to \mathsf{Cat}
            be the forgetful
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
          %p
            A
            %strong 2-birig
            is a 2-rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathsf B
            and a lift of the 2-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Cat
                %annotation{:encoding => "application/x-tex"} \mathsf{2Rig}(B,-):\mathsf{2Rig}\to \mathsf{Cat}
            to a 2-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                %annotation{:encoding => "application/x-tex"} \Phi_\mathsf{B}:\mathsf{2Rig}\to \mathsf{2Rig}
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi U
                    %mo ∘
                    %msub
                      %mi Φ
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi B
                    %mo =
                    %mstyle{:mathvariant => "sans-serif"}
                      %mrow
                        %mn 2
                        %mi Rig
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf U \circ \Phi_\mathsf{B}=\mathsf{2Rig}(\mathsf{B},-)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi B
                  %annotation{:encoding => "application/x-tex"} \Phi_\mathsf{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mstyle{:mathvariant => "sans-serif"}
                      %mrow
                        %mi B
                        %mo ′
                %annotation{:encoding => "application/x-tex"} \Phi_\mathsf{B'}
            can be composed. Denote the resulting object by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                    %mo ⊙
                    %mstyle{:mathvariant => "sans-serif"}
                      %mrow
                        %mi B
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathsf{B}\odot \mathsf{B'}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi B
                    %mo ∘
                    %msub
                      %mi Φ
                      %mstyle{:mathvariant => "sans-serif"}
                        %mrow
                          %mi B
                          %mo ′
                    %mo =
                    %msub
                      %mi Φ
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mrow
                            %mi B
                            %mo ′
                        %mo ⊙
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi B
                  %annotation{:encoding => "application/x-tex"} \Phi_\mathsf{B} \circ \Phi_\mathsf{B'}=\Phi_{\mathsf{B'}\odot \mathsf{B}}
          %p
            Denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Birig
                  %mo ,
                  %mo ⊙
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathsf{2Birig}, \odot)
            the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
            of 2-birigs, viewed as a full
            %a.existingWikiWord{:href => "/nlab/show/sub-2-category"} sub-2-category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mrow
                        %mn 2
                        %mi Rig
                  %annotation{:encoding => "application/x-tex"} \mathsf{2Rig}
          %p
            A
            %strong 2-plethory
            can be equivalently defined as
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/pseudomonoid"} pseudomonoid
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Birig
                        %mo ,
                        %mo ⊙
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (2\mathsf{Birig}, \odot)
            %li
              %p
                A 2-comonad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo :
                      %mstyle{:mathvariant => "sans-serif"}
                        %mrow
                          %mn 2
                          %mi Rig
                      %mo →
                      %mstyle{:mathvariant => "sans-serif"}
                        %mrow
                          %mn 2
                          %mi Rig
                    %annotation{:encoding => "application/x-tex"} \Phi:\mathsf{2Rig}  \to  \mathsf{2Rig}
                whose underlying 2-functor is a right 2-adjoint.
          %h2#example_schur_functors Example: Schur functors
          %p
            For any 2-plethory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            with left 2-adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi U
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \mathsf{U}\Phi
            is representable, with representing object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi k
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi S
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi(\overline{k\mathsf{S}})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi k
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi S
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{k\mathsf{S}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            of the
            = succeed "-linearization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/permutation+groupoid"} permutation groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathsf{S}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi k
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi S
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{k\mathsf{S}}
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Schur
                %annotation{:encoding => "application/x-tex"} \mathsf{Schur}
            made into a 2-rig with the pointwise tensor product.
          %p
            In particular, the identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mrow
                      %mn 2
                      %mi Rig
                %annotation{:encoding => "application/x-tex"} 1: \mathsf{2Rig} \to \mathsf{2Rig}
            is a 2-plethory with underlying 2-rig
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi k
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi S
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{k\mathsf{S}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mover
                    %mrow
                      %mi k
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi S
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J(\overline{k\mathsf{S}})
            has a commutative monoid structure coming from the decategorifications of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊕
                %annotation{:encoding => "application/x-tex"} \oplus
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mover
                    %mrow
                      %mi k
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi S
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J(\overline{k\mathsf{S}})
            is isomorphic to the monoid of positive
            %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Lambda_+
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Lambda_+
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Schur
                %annotation{:encoding => "application/x-tex"} \mathsf{Schur}
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi k
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi S
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ℤ
                    %msub
                      %mo ⊗
                      %mi ℕ
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi k
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi S
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\overline{k\mathsf{S}})=\mathbb{Z}\otimes_\mathbb{N} J(\overline{k\mathsf{S}})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mover
                    %mrow
                      %mi k
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi S
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J(\overline{k\mathsf{S}})
            extends to a ring-plethory structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi k
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi S
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\overline{k\mathsf{S}})
