                              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#statement"} Statement
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#as_idempotent_approximation"} As idempotent approximation
                %li
                  %a{:href => "#a_logical_description"} A logical description
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            between
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            factors into a
            %a.existingWikiWord{:href => "/nlab/show/geometric+surjection"} geometric surjection
            followed by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            construction in the
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos-theoretic
            sense, and gives rise to a
            %a.existingWikiWord{:href => "/nlab/show/factorization+system+in+a+2-category"} factorization system in a 2-category
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
          %h2#statement Statement
          .num_prop
            %h6#proposition Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/factorization+system+on+a+2-category"} factorization system
              on the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
              whose left class is the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/surjective+geometric+morphism"} surjective geometric morphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embeddings"} geometric embeddings
            %p
              Moreover, the factorization of a given geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{E} \to \mathcal{F}
              is, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/topos+of+coalgebras"} topos of coalgebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi f
                      %mo *
                    %mi CoAlg
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* f_* CoAlg(\mathcal{E})
              of the
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi f
                        %mo *
                      %mo :
                      %mi ℰ
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} f^* f_* : \mathcal{E} \to \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℰ
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi ℱ
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi F
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %msub
                              %mi f
                              %mo *
                            %mi CoAlg
                            %mo{:stretchy => "false"} (
                            %mi ℰ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi E
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E} &amp;&amp;\stackrel{f}{\to}&amp;&amp; \mathcal{F}
                    \\\
                    \&amp; {}_{\mathllap{F}}\searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; f^* f_* CoAlg(\mathcal{E})
                    }
                    \\,E.
          %p
            This appears for instance as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, VII 4., theorem 6
            ).
          %p We use the following lemma
          #ConditionForSheafFactorization.num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
              on a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} i : Sh_j(\mathcal{E}) \to \mathcal{E}
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℱ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{F} \to \mathcal{E}
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              precisely if
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_*
                takes values in
                = succeed "-sheaves;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
            %p or, equivalently
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                sends
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This appears as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, VII 4. prop. 2
            ).
          .proof
            %h6#proof_of_the_lemma Proof of the lemma
            %p
              We first show the first statement, that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to factor it is sufficient for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              to take values in
              = succeed "-sheaves:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                    %mo :
                    %mo =
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi ℱ
                    %mo →
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_* := i^* f_*: \mathcal{F} \to Sh_j(\mathcal{E})
                    \\,.
            %p
              Since by assumption the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %msub
                      %mi i
                      %mo *
                    %msup
                      %mi i
                      %mo *
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \to i_* i^* x
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              this indeed serves to factor
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_*
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %msub
                      %mi p
                      %mo *
                    %mo ≃
                    %msub
                      %mi i
                      %mo *
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi f
                      %mo *
                    %mo ≃
                    %msub
                      %mi f
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_* p_* \simeq i_* i^* f_* \simeq f_*
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_*
              is then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mo ≃
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi i
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    p^* \simeq f^* i_*
                    \\,,
            %p because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ℱ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mo *
                            %mi E
                            %mo ,
                            %mi F
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi ℱ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %msub
                              %mi i
                              %mo *
                            %mi E
                            %mo ,
                            %mi F
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi ℰ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mo *
                            %mi E
                            %mo ,
                            %msub
                              %mi f
                              %mo *
                            %mi F
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi ℰ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mo *
                            %mi E
                            %mo ,
                            %msub
                              %mi i
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi f
                              %mo *
                            %mi F
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Sh
                              %mi j
                            %mi ℰ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi f
                              %mo *
                            %mi F
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Sh
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %msub
                              %mi p
                              %mo *
                            %mi F
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{F}(g^* E, F)
                    \&amp; \simeq \mathcal{F}(f^* i_* E, F)
                    \\\
                    \&amp; \simeq \mathcal{E}(i_* E, f_* F)
                    \\\
                    \&amp; \simeq \mathcal{E}(i_* E, i_* i^* f_* F)
                    \\\
                    \&amp; \simeq Sh_j\mathcal{E} (E, i^* f_* F)
                    \\\
                    \&amp; \simeq Sh_j(E, p_* F)
                    \\end{aligned}
                    \\,,
            %p
              where in the middle steps we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f_* F
              is a
              = succeed "-sheaf," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              is full and faithful.
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              is left exact, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mo *
                    %mo ⊣
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p^* \dashv p_*)
              is indeed a factorizing geometric morphism.
            %p
              We now show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              taking values in sheaves is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              mapping dense monos to isos.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} u : U \hookrightarrow X
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{E}
              any object. Consider the induced naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℰ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mi f
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi ℱ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi ℰ
                                  %mo{:stretchy => "false"} (
                                  %mi u
                                  %mo ,
                                  %msub
                                    %mi f
                                    %mo *
                                  %mi A
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℱ
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi f
                                    %mo *
                                  %mi u
                                  %mo ,
                                  %mi A
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi ℰ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %msub
                              %mi f
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi ℱ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi U
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E}(X, f_* A) &amp;\stackrel{\simeq}{\to}&amp; \mathcal{F}(f^* X, A)
                    \\\
                    {}^{\mathllap{\mathcal{E}(u, f_* A)}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\mathcal{F}(f^* u, A)}}
                    \\\
                    \\mathcal{E}(U, f_* A)
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    \\mathcal{F}(f^* U, A)
                    }
            %p
              of the adjunction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f_* A
              is a
              = succeed "-sheaf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              this being an iso for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi u
                  %annotation{:encoding => "application/x-tex"} f^* u
              being an iso. And conversely.
          .proof
            %h6#proof_of_the_proposition Proof of the proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℱ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{F} \to \mathcal{E}
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %p We first discuss the existence of the factorization, then its uniqueness.
            %p
              To construct the factorization, we shall give a
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              through the
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              of the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %p
              Take the closure operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo :
                    %mi Sub
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℰ
                    %mo →
                    %mi Sub
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \overline{(-)} : Sub(-)_{\mathcal{E}} \to Sub(-)_{\mathcal{E}}
              to be given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi U
                              %mo ¯
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi f
                              %mo *
                            %msup
                              %mi f
                              %mo *
                            %mi U
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi f
                              %mo *
                            %msup
                              %mi f
                              %mo *
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\overline{U} &amp;\to&amp; f_* f^* U
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\to&amp; f_* f^* X
                    }
                    \\,,
            %p
              where the bottom morphism is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mo *
                      %mo ⊣
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves both pullbacks and pushouts.
            %p
              Notice that this implies that for two
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \hookrightarrow X
              we have
            #eq:ASubobjectRelation.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mover
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (U_1 \subset \overline{U_2})
                    \\;\;\;
                    \\Leftrightarrow
                    \\;\;\;
                    (f^* U_1 \subset f^* U_2)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    i : Sh_j(\mathcal{E}) \to \mathcal{E}
            %p
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %p
              By lemma
              %a.maruku-ref{:href => "#ConditionForSheafFactorization"}
              we get a factorization through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              sends
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
              is dense so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %mover
                      %mi U
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} X \subset \overline{U}
              then, by
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ASubobjectRelation"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi X
                    %mo ⊂
                    %msup
                      %mi f
                      %mo *
                    %mi U
                  %annotation{:encoding => "application/x-tex"} f^* X \subset f^* U
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mi X
                      %mo =
                      %msup
                        %mi f
                        %mo *
                      %mi U
                    %annotation{:encoding => "application/x-tex"} f^* X = f^* U
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℱ
                    %mover
                      %mo →
                      %mi p
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi i
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    f : \mathcal{F} \stackrel{p}{\to} Sh_j(\mathcal{E}) \stackrel{i}{\to}
                    \\mathcal{E}
            %p
              for the factorization thus established. It remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              here is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+surjection"} geometric surjection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              induces an injective homomorphism of subobject lattices.
            %p
              So suppose that for subobjects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset X
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %msub
                        %mi U
                        %mn 1
                      %mo ≃
                      %msup
                        %mi p
                        %mo *
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p^* U_1 \simeq p^* U_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi i
                        %mo *
                      %msub
                        %mi U
                        %mn 1
                      %mo ≃
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi i
                        %mo *
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f^* i_* U_1 \simeq f^* i_* U_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %msub
                              %mi i
                              %mo *
                            %msub
                              %mi U
                              %mn 1
                          %mtd
                            %mo ≃
                            %msup
                              %mi p
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi i
                              %mo *
                            %msub
                              %mi U
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi p
                              %mo *
                            %msub
                              %mi U
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi p
                              %mo *
                            %msub
                              %mi U
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi p
                              %mo *
                            %msup
                              %mi i
                              %mo *
                            %msub
                              %mi i
                              %mo *
                            %msub
                              %mi U
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi f
                              %mo *
                            %mi i
                            %mo :
                            %mo *
                            %msub
                              %mi U
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    f^* i_* U_1 &amp; \simeq p^* i^* i_* U_1
                    \\\
                    \&amp; \simeq p^* U_1
                    \\\
                    \&amp; \simeq p^* U_2
                    \\\
                    \&amp; \simeq p^* i^* i_* U_2
                    \\\
                    \&amp; \simeq f^* i:* U_2
                    \\end{aligned}
            %p
              by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
              %a.maruku-eqref{:href => "#eq:ASubobjectRelation"} (1)
              it follows that also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %msub
                      %mi U
                      %mn 1
                    %mo ≃
                    %mover
                      %mrow
                        %msub
                          %mi i
                          %mo *
                        %msub
                          %mi U
                          %mn 2
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    i_* U_1 \simeq \overline{i_* U_2}
            %p and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msub
                      %mi i
                      %mo *
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq i_* U_2
            %p
              by the very fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              includes
              = succeed "-sheaves" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              if a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ≃
                    %msub
                      %mi U
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_1 \simeq U_2
                    \\,.
            %p
              So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              is indeed injective on subobjects and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+surjection"} geometric surjection
            %p This establishes the existence of a surjection/embedding factorization. Next we discss that this is unique.
            %p So consider two factorizations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↗
                          %mtd
                            %msup
                              %mo ⇓
                              %mo ≃
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                        %mtr
                          %mtd
                            %mi ℱ
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi ℰ
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathcal{A}
                    \\\
                    \&amp; {}^{\mathllap{p_1}}\nearrow &amp;\Downarrow^\simeq&amp; \searrow^{\mathrlap{i_1}}
                    \\\
                    \\mathcal{F}
                    \&amp;&amp;\stackrel{f}{\to}&amp;&amp;
                    \\mathcal{E}
                    \\\
                    \&amp; {}_{\mathllap{p_2}}\searrow &amp;\downarrow^{\simeq}&amp; \nearrow_{\mathrlap{i_2}}
                    \\\
                    \&amp;&amp; \mathcal{B}
                    }
            %p into a geometric surjection followed by a geometric embedding.
            %p
              We will now argue that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i_1
              factors – essentially uniquely – through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i_2
              in a way that makes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                        %mtr
                          %mtd
                            %mi ℱ
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi g
                          %mtd
                          %mtd
                            %mi ℰ
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathcal{A}
                    \\\
                    \&amp; {}^{\mathllap{p_1}}\nearrow &amp;&amp; \searrow^{\mathrlap{i_1}}
                    \\\
                    \\mathcal{F}
                    \&amp;&amp;\downarrow^g&amp;&amp;
                    \\mathcal{E}
                    \\\
                    \&amp; {}_{\mathllap{p_2}}\searrow &amp;&amp; \nearrow_{\mathrlap{i_2}}
                    \\\
                    \&amp;&amp; \mathcal{B}
                    }
            %p
              commute up to natural isomorphisms. By the same argument for the upside-down situation we find an essentially unique middle vertical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi ℬ
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} h : \mathcal{B} \to \mathcal{A}
              the other way round. Then essential uniqueness of these factorizations implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi h
                    %mo ≃
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} g \circ h \simeq Id
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∘
                      %mi g
                      %mo ≃
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} h \circ g \simeq Id
            %p
              To find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              (by the discussion there) is, up to equivalence, an inclusion of
              = succeed "-sheaves" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              the bottom morphism and then use again lemma
              %a.maruku-ref{:href => "#ConditionForSheafFactorization"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i_1
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i_2
              – essentially uniquely – precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_1^*
              sends
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
            %p
              To see that it does, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi IU
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} IU \to X
              be a dense mono and consider the naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 2
                              %mo *
                            %msubsup
                              %mi i
                              %mn 2
                              %mo *
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mo *
                            %msubsup
                              %mi i
                              %mn 1
                              %mo *
                            %mi U
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 2
                              %mo *
                            %msubsup
                              %mi i
                              %mn 2
                              %mo *
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mo *
                            %msubsup
                              %mi i
                              %mn 1
                              %mo *
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    p_2^* i_2^* U &amp;\stackrel{\simeq}{\to}&amp; p_1^* i_1^* U
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    p_2^* i_2^* X &amp;\stackrel{\simeq}{\to}&amp; p_1^* i_1^* X
                    }
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mn 2
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_2^*(U \to X)
              is an iso by definition, the left vertical morphism is, and thus so is the right vertical morphism. But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              is a
              %a.existingWikiWord{:href => "/nlab/show/geometric+surjection"} geometric surjection
              we have (by the discussion there) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_1^*
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mn 1
                      %mo *
                    %mi U
                    %mo →
                    %msubsup
                      %mi i
                      %mn 1
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_1^* U \to i_1^* X
              is an isomorphism.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i_1
              factors via some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i_2
              and the proof is completed by the above argument.
          %h2#examples Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f : X \to Y
                a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                between
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to im(f) \to Y
                its ordinary
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                factorization through an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
                = succeed "es" do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Sh(X) \to Sh(im(f)) \to Sh(Y)
              %p is a geometric surjection/geometric embedding factorization.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                any topos,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f : X \to Y
                any morphism in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to im(f) \to Y
                its
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                factorization, the corresponding composite of
                %a.existingWikiWord{:href => "/nlab/show/base+change+geometric+morphisms"} base change geometric morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %mi ℰ
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℰ
                      %mo{:stretchy => "false"} /
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{E}/X  \to \mathcal{E}/im(f) \to \mathcal{E}/Y
              %p is a geometric surjection/embedding factorization.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} f : C \to D
                any
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                between
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C \to im(f) \to D
                for its
                %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
                factorization. Then the induced composite
                %a{:href => "http://ncatlab.org/nlab/show/geometric%20morphism#BetweenPresheafToposes"} geometric morphism of presheaf toposes
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo →
                        %mrow
                      %mo{:stretchy => "false"} [
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi D
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      [C^{op}, Set] \stackrel{}{\to} [im(f)^{op}, Set] \to
                      [D^{op}, Set]
              %p is a geometric surjection/embedding factorization.
          %p
            See (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, p. 377
            ).
          %h2#properties Properties
          %h3#as_idempotent_approximation As idempotent approximation
          %p
            A geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℱ
                  %mo →
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} f:\mathcal{F}\to\mathcal{E}
            induces via the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo ⊢
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^\ast\vdash f_\ast
            a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and this idempotent approximation coincides with the monad induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo ⊢
                  %msub
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i^\ast\vdash i_\ast
            given by the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            from the factorization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi i
                    %mo ∘
                    %mi q
                  %annotation{:encoding => "application/x-tex"} f=i\circ q
          %p
            For references and further details on the idempotent approximation see at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
          %h3#a_logical_description A logical description
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be a
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            over a signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℰ
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f:\mathcal{E}\to Set[T]
            a geometric morphism to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            corresponds to a certain
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            Notice that every geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            between
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"} Grothendieck toposes
            is of this form for some geometric theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and hence corresponds to some model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            \! This model permits to attach a geometric theory to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as well:
          %p
            The
            %strong theory of M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Th(M)
            consists of all geometric sequents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊧
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} M\models \sigma
          %p
            Then the following holds (
            %a{:href => "#Caramello09"}> Caramello 2009
            , p.57):
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The topos occurring in the middle of the surjection-embedding factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is precisely the classifying topos for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Th(M)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mo ↠
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}\twoheadrightarrow Set[Th(M)]\hookrightarrow Set[T]
