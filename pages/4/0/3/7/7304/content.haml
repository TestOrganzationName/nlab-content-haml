          %p
            sending pairs of (cocartesian lifts of) inert morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %mo ×
                  %msup
                    %mi 𝒫
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes} \times \mathcal{P}^{\otimes}
            to (cocartesian lifts of) inert morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒬
                  %annotation{:encoding => "application/x-tex"} \mathcal{Q}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} BiFun
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %mo ,
                  %msup
                    %mi 𝒫
                    %mo ⊗
                  %mo ;
                  %msup
                    %mi 𝒬
                    %mo ⊗
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi{:mathvariant => "normal"} Fun
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %mo ×
                  %msup
                    %mi 𝒫
                    %mo ⊗
                  %mo ,
                  %msup
                    %mi 𝒬
                    %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{BiFun}(\mathcal{O}^{\otimes},\mathcal{P}^{\otimes}; \mathcal{Q}^{\otimes}) \subset \mathrm{Fun}_{/\mathbb{F}_*}(\mathcal{O}^{\otimes} \times \mathcal{P}^{\otimes}, \mathcal{Q}^{\otimes})
            be the full subcategory spanned by functors satisfying the above inert morphism condition.
          %p
          .num_prop
            %h6 Proposition
            %p
              There is an equivalence of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Alg
                      %mrow
                        %msup
                          %mi 𝒪
                          %mo ⊗
                        %msub
                          %mo ⊗
                          %mi{:mathvariant => "normal"} BV
                        %msup
                          %mi 𝒫
                          %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒬
                      %mo ⊗
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi{:mathvariant => "normal"} BiFun
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒪
                      %mo ⊗
                    %mo ,
                    %msup
                      %mi 𝒫
                      %mo ⊗
                    %mo ;
                    %msup
                      %mi 𝒬
                      %mo ⊗
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Alg}_{\mathcal{O}^{\otimes} \otimes_{\mathrm{BV}} \mathcal{P}^{\otimes}}(\mathcal{Q}^{\otimes}) \simeq \mathrm{BiFun}(\mathcal{O}^{\otimes},\mathcal{P}^{\otimes}; \mathcal{Q}^{\otimes}) .
            %p
          %h3#the_symmetric_monoidal_categorical_universal_property
            The symmetric monoidal
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The following is Theorem E of
            %a{:href => "#Barkan23"} Barkan-Steinebrunner 23
          .num_theorem
            %h6 Theorem
            %p
              The
              %a{:href => "https://ncatlab.org/nlab/show/tensor+product+of+commutative+monoids#in_category_theory"}
                canonical tensor product of symmetric monoidal
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              uniquely restricts to a tensor product on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Op
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathrm{Op}_\infty
              such that the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+envelope"} symmetric monoidal envelope
              is a symmetric monoidal functor.
          %p
            This is not the symmetric monoidal structure constructed in Higher algebra; however, both it and that of Higher algebra have tensor functors satisfying the above
            = succeed "," do
              %a{:href => "#Bifunctorprop"} universal property
          %p
            Lurie’s tensor product comes from an ad-hoc construction involving a left-derived functor from a seldom-used
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} BV
                  %annotation{:encoding => "application/x-tex"} \otimes_{\BV}
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
            may be “incorrect.”
          %h3#connectivity_and_the_eckmannhilton_argument Connectivity and the Eckmann-Hilton argument
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒜
                    %mn 2
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_2^{\otimes}
            be the free unital
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"} (∞,1)-operad
            with a binary operation (so that it’s Stasheff’s 2nd operad, i.e.
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_2
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/unital+magmas"} unital magmas
            %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
            states that the canonical map of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operads"} (∞,1)-operads
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒜
                    %mn 2
                    %mo ⊗
                  %msub
                    %mo ⊗
                    %mi{:mathvariant => "normal"} BV
                  %msubsup
                    %mi 𝒜
                    %mn 2
                    %mo ⊗
                  %mo →
                  %msup
                    %mi{:mathvariant => "normal"} Comm
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_2^{\otimes} \otimes_{\mathrm{BV}} \mathcal{A}_2^{\otimes} \rightarrow \mathrm{Comm}^{\otimes}
            induces an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Alg
                    %mrow
                      %msub
                        %mi 𝒜
                        %mn 2
                  %msubsup
                    %mi{:mathvariant => "normal"} Alg
                    %mrow
                      %msub
                        %mi 𝒜
                        %mn 2
                    %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} Alg
                    %mrow
                      %msub
                        %mi 𝒜
                        %mn 2
                      %msub
                        %mo ⊗
                        %mi{:mathvariant => "normal"} BV
                      %msub
                        %mi 𝒜
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} CAlg
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Alg}_{\mathcal{A}_2} \mathrm{Alg}_{\mathcal{A}_2}^{\otimes}(\mathcal{C}) \simeq \mathrm{Alg}_{\mathcal{A}_2 \otimes_{\mathrm{BV}} \mathcal{A}_2}(\mathcal{C}) \rightarrow \mathrm{CAlg}(\mathcal{C})
          %p
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a symmetric monoidal 1-category.
          %p
            We say that a reduced
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"} (∞,1)-operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes}
            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %mo →
                  %msup
                    %mi{:mathvariant => "normal"} Comm
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes} \rightarrow \mathrm{Comm}^{\otimes}
            induces equivalences on the respective categories of algebras in symmetric monoidal
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The following result is proved in
            = succeed "," do
              %a{:href => "#Schlank19"} Schlank-Yanovski 19
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
          %p
          .num_theorem
            %h6 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes}
              is
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} d_{\mathcal{O}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒫
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}^{\otimes}
              is
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} d_{\mathcal{P}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo ⊗
                    %msub
                      %mo ⊗
                      %mi{:mathvariant => "normal"} BV
                    %msup
                      %mi 𝒫
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes} \otimes_{\mathrm{BV}} \mathcal{P}^{\otimes}
              is
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi 𝒪
                      %mo +
                      %msub
                        %mi d
                        %mi 𝒫
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (d_{\mathcal{O}} + d_{\mathcal{P}} + 2)
          %h2#examples Examples
          %h3#infinite_tensor_products_of_reduced_operads_are_
            Infinite tensor products of reduced
            = succeed "-operads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Comm
                  %annotation{:encoding => "application/x-tex"} \mathrm{Comm}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes}
            be a reduced
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} triv
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathrm{triv}^{\otimes} \rightarrow \mathcal{O}^{\otimes}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mrow
                      %mo ⊗
                      %mn ∞
                  %mo ≔
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                  %mrow
                    %mo (
                    %msup
                      %mi 𝒪
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒪
                      %mrow
                        %mo ⊗
                        %mn 2
                    %mo →
                    %msup
                      %mi 𝒪
                      %mrow
                        %mo ⊗
                        %mn 3
                    %mo →
                    %mi ⋯
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}^{\otimes \infty} \coloneqq \colim \left( \mathcal{O}^{\otimes} \rightarrow \mathcal{O}^{\otimes 2} \rightarrow \mathcal{O}^{\otimes 3} \rightarrow \cdots \right)
          %p
            The above
            %a{:href => "#EH"} connectivity bound
            implies the following corollary, which may be viewed as an
            = succeed "." do
              %em operadic Eilenberg swindle
          %p
          .num_cor
            %h6 Corollary
            %p
              The canonical map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mrow
                        %mo ⊗
                        %mn ∞
                    %mo →
                    %msup
                      %mi{:mathvariant => "normal"} Comm
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes \infty} \rightarrow \mathrm{Comm}^{\otimes}
              is an equivalence.
          %h3#dunns_additivity_theorem Dunn’s additivity theorem
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            be the topological
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/little+n-cubes+operad"} little n-cubes operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo ,
                  %msub
                    %mi C
                    %mi m
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi n
                      %mo +
                      %mi m
                %annotation{:encoding => "application/x-tex"} C_n,C_m \rightarrow C_{n+m}
            together yield a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %msub
                      %mi C
                      %mi n
                    %mo ⊗
                    %msub
                      %mi C
                      %mi m
                    %mo →
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mi m
                  %annotation{:encoding => "application/x-tex"} \mu:C_n \otimes C_m \rightarrow C_{n+m}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
