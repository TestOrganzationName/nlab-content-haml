                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi{:mathvariant => "normal"} Comm
                          %annotation{:encoding => "application/x-tex"} \mathrm{Comm}
                %li
                  %a{:href => "#dunns_additivity_theorem"} Dunn’s additivity theorem
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em Boardman-Vogt tensor product
            is a natural
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            %a.existingWikiWord{:href => "/nlab/show/Operad"} Operad
            of colored
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            over
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          %h2#definition Definition
          %h3#in_the_1category_of_symmetric_operads In the 1-category of symmetric operads
          %p
            All
            %a.existingWikiWord{:href => "/nlab/show/operads"} operads
            in the following are colored
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            enriched over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategories"} symmetric multicategories
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            be an operad over a set of colors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒬
                %annotation{:encoding => "application/x-tex"} \mathcal{Q}
            be an operad over a set of colors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            Their
            %strong Boardman-Vogt tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %msub
                    %mo ⊗
                    %mi BV
                  %mi 𝒬
                %annotation{:encoding => "application/x-tex"} \mathcal{P} \otimes_{BV} \mathcal{Q}
            is the operad whose set of colors is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \times D
          %p
            There is one generating operation for every pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,d)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi c
                    %mi n
                  %mo ;
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p \in \mathcal{P}(c_1, \cdots, c_n; c)
            and with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⊗
                  %mi d
                  %mo ∈
                  %mi 𝒫
                  %msub
                    %mo ⊗
                    %mi BV
                  %mi 𝒬
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi n
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  p \otimes d
                  \\in
                  \\mathcal{P} \otimes_{BV} \mathcal{Q}(
                  (c_1,d), \cdots, (c_n,d); (c,d)
                  )
          %p
            and for each pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,q)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi 𝒬
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi d
                      %mi n
                    %mo ;
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q \in \mathcal{Q}(d_1, \cdots, d_n; d)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ⊗
                  %mi q
                  %mo ∈
                  %mi 𝒫
                  %msub
                    %mo ⊗
                    %mi BV
                  %mi 𝒬
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %msub
                    %mi d
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  c \otimes q
                  \\in
                  \\mathcal{P}\otimes_{BV} \mathcal{Q}(
                  (c, d_1), \cdots, (c, d_n);
                  (c,d)
                  )
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %ol
            %li
              %p
                The tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \otimes (-)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
                respects the composition in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒬
                      %annotation{:encoding => "application/x-tex"} \mathcal{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi d
                    %annotation{:encoding => "application/x-tex"} (-) \otimes d
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} d \in D
                respects the composition in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}
                and both respect the action of the
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                on the operations.
              %p
                Equivalently this means that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
                tensoring with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                extends to a morphism of operads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒬
                      %mo →
                      %mo{:stretchy => "false"} {
                      %mi c
                      %mo{:stretchy => "false"} }
                      %msub
                        %mo ⊗
                        %mi BV
                      %mi 𝒬
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{Q} \to \{c\} \otimes_{BV}\mathcal{Q}
              %p
                and for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} d \in D
                a morphism of operads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %mo →
                      %mi 𝒫
                      %msub
                        %mo ⊗
                        %mi BV
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{P} \to \mathcal{P} \otimes_{BV} \{d\}
                      \\,.
            %li
              %p
                The operations in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒬
                    %annotation{:encoding => "application/x-tex"} \mathcal{Q}
                %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distribute
                over each other in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %msub
                        %mo ⊗
                        %mi BV
                      %mi 𝒬
                    %annotation{:encoding => "application/x-tex"} \mathcal{P} \otimes_{BV} \mathcal{Q}
                in the evident sense (…).
          %h3#in_the_category_of_operads
            In the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-operads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} Cat
                    %mrow
                      %mn ∞
                      %mo ,
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mo *
                    %mrow
                      %mi{:mathvariant => "normal"} Int
                      %mo −
                      %mi{:mathvariant => "normal"} cocart
                  %mo ⊂
                  %msub
                    %mi{:mathvariant => "normal"} Cat
                    %mrow
                      %mn ∞
                      %mo ,
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Cat}_{\infty,/\mathbb{F}_*}^{\mathrm{Int}-\mathrm{cocart}} \subset \mathrm{Cat}_{\infty,/\mathbb{F}_*}
            denote the (non-full) subcategory of functors to finite pointed sets which posses cocartesian lifts over inert morphisms.
          %p
            The full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Op
                    %mn ∞
                  %mo ⊂
                  %msubsup
                    %mi{:mathvariant => "normal"} Cat
                    %mrow
                      %mn ∞
                      %mo ,
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mo *
                    %mrow
                      %mi{:mathvariant => "normal"} Int
                      %mo −
                      %mi{:mathvariant => "normal"} cocart
                %annotation{:encoding => "application/x-tex"} \mathrm{Op}_\infty \subset \mathrm{Cat}_{\infty,/\mathbb{F}_*}^{\mathrm{Int}-\mathrm{cocart}}
            spanned by the
            = succeed "-operads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi{:mathvariant => "normal"} Op
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} Cat
                    %mrow
                      %mn ∞
                      %mo ,
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mo *
                    %mrow
                      %mi{:mathvariant => "normal"} Int
                      %mo −
                      %mi{:mathvariant => "normal"} cocart
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} Op
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_{\mathrm{Op}}: \mathrm{Cat}_{\infty,/\mathbb{F}_*}^{\mathrm{Int}-\mathrm{cocart}} \rightarrow \mathrm{Op}_\infty
            for its localization functor.
          %p
            Then, given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo ⊗
                    %mo ,
                    %msup
                      %mi 𝒫
                      %mo ⊗
                    %mo ∈
                    %msub
                      %mi{:mathvariant => "normal"} Op
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes},\mathcal{P}^{\otimes} \in \mathrm{Op}_\infty
            %strong Boardman-Vogt tensor product
            is the localization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %msub
                    %mo ⊗
                    %mi{:mathvariant => "normal"} BV
                  %msup
                    %mi 𝒫
                    %mo ⊗
                  %mo :
                  %mo =
                  %msub
                    %mi L
                    %mi{:mathvariant => "normal"} Op
                  %mrow
                    %mo (
                    %msup
                      %mi 𝒪
                      %mo ⊗
                    %mo ×
                    %msup
                      %mi 𝒫
                      %mo ⊗
                    %mo →
                    %msub
                      %mi 𝔽
                      %mo *
                    %mo ×
                    %msub
                      %mi 𝔽
                      %mo *
                    %mover
                      %mo →
                      %mo ∧
                    %msub
                      %mi 𝔽
                      %mo *
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}^{\otimes} \otimes_{\mathrm{BV}} \mathcal{P}^{\otimes} := L_{\mathrm{Op}} \left( \mathcal{O}^{\otimes} \times \mathcal{P}^{\otimes} \rightarrow \mathbb{F}_* \times \mathbb{F}_* \xrightarrow{\wedge} \mathbb{F}_* \right).
          %h2#properties Properties
          %h3#ClosedMonoidalStructure Closed monoidal structure
          .num_prop
            %h6#proposition Proposition
            %p
              Equipped with the Boardman-Vogt tensor product,
              %a.existingWikiWord{:href => "/nlab/show/Operad"} Operad
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          %p
            See for instance the proof provided in (
            %a{:href => "#Weiss"}> Weiss, theorem 2.22
            ).
          %p This implies directly several useful statements about the BV-tensor product
          .num_cor
            %h6#corollary Corollary
            %ul
              %li
                The BV tensor products preserves
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                of operads in each variable separately.
          %p We write in the following
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %msup
                    %mi Operad
                    %mi op
                  %mo ×
                  %mi Operad
                  %mo →
                  %mi Operad
                %annotation{:encoding => "application/x-tex"}
                  [-,-] : Operad^{op} \times Operad \to Operad
          %p
            for the corresponding
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            (leaving a subscrip “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi BV
                %annotation{:encoding => "application/x-tex"} {}_{BV}
            ” implicit.)
          #InternalHomOperadAsAlgebraOperad.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} P, Q \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Operad"} Operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P, Q]
              has
            %ul
              %li
                %p
                  as colors the
                  %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} P-algebras
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
              %li
                %p
                  as unary operations the
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
          %p
            See (
            %a{:href => "#Weiss"}> Weiss, lemma 2.23
            ).
          %p
            We may therefore speak of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi P
                  %mo ,
                  %mi Q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [P,Q]
            as being the
            %strong
              operad of
              = succeed "-algebras" do
