                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "227.774576", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph6-1", :y => "91.311241"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "234.338238", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph1-2", :y => "91.311241"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "225.151503", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph7-2", :y => "80.885722"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "222.668952", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph7-3", :y => "78.404167"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "218.090533", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph8-1", :y => "50.653611"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "227.633057", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph3-4", :y => "19.493657"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "227.633057", "xlink:href" => "#wJ9Pz6ReEwYV7L4Mccq92CLri9o=-glyph4-4", :y => "19.493657"}
                %path{:d => "M 202.608754 -67.71017 L 202.608754 -8.599525 ", :style => "fill:none;stroke-width:0.478;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.996608,0,0,-0.996608,25.711257,10.92183)"}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mrow
                      %mi n
                      %mo +
                      %mi m
                %annotation{:encoding => "application/x-tex"} D_{n+m}
            us the operad of decomposable little
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+m)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi C
                    %mi m
                %annotation{:encoding => "application/x-tex"} C_{n} | C_{m}
            is the image of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %a{:href => "#Dunn88"} Dunn 88
            is the statement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mu'
            is a local
            = succeed "-equivalence." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .num_theorem
            %h6 Theorem
            %p
              The topological operads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mo ⊗
                    %msub
                      %mi C
                      %mi m
                    %mo ≃
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mi m
                  %annotation{:encoding => "application/x-tex"} C_n \otimes C_m \simeq C_{n+m}
              are related by a zigzag of local
              = succeed "-equivalences." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          This theorem is slightly unusual, as the operad
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %msub
                  %mi C
                  %mi n
              %annotation{:encoding => "application/x-tex"} C_n
          is
          %em not
          cofibrant, and the tensor product in the statement is
          = succeed "." do
            %em underived
          %a{:href => "#Brinkmeier00"} Brinkmeier 00
          and the recent paper
          = succeed "." do
            %a{:href => "#Barata22"} Barata-Moerdijk 22
          %p
            The corresponding statement for the
            %em derived
            tensor product is proved as Theorem 5.1.2.2 in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p
          .num_theorem
            %h6 Theorem
            %p
              The canonical map of
              = succeed "-operads" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔼
                      %mi n
                      %mo ⊗
                    %mo ⊗
                    %msubsup
                      %mi 𝔼
                      %mi m
                      %mo ⊗
                    %mo →
                    %msubsup
                      %mi 𝔼
                      %mrow
                        %mi n
                        %mo +
                        %mi m
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_{n}^{\otimes} \otimes \mathbb{E}_{m}^{\otimes} \rightarrow \mathbb{E}_{n + m}^{\otimes}
              is an equivalence; hence for any symmetric monoidal
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} Alg
                      %mrow
                        %msub
                          %mi 𝔼
                          %mrow
                            %mi n
                            %mo +
                            %mi m
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi{:mathvariant => "normal"} Alg
                      %mrow
                        %msub
                          %mi 𝔼
                          %mi n
                      %mo ⊗
                    %msubsup
                      %mi{:mathvariant => "normal"} Alg
                      %mrow
                        %msub
                          %mi 𝔼
                          %mi m
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Alg}^{\otimes}_{\mathbb{E}_{n+m}}(\mathcal{C}) \rightarrow \mathrm{Alg}_{\mathbb{E}_n}^{\otimes} \mathrm{Alg}_{\mathbb{E}_m}^{\otimes}(\mathcal{C})
            %p is an equivalence.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                The Boardman-Vogt tensor product extends from operads to a tensor product on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dendroidal+sets"} dendroidal sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+monads"} tensor product of monads
          %h2#references References
          %p The original reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Boardman"}> Michael Boardman
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rainer+Vogt"} Rainer Vogt
              = succeed "," do
                %em Homotopy invariant algebraic structures on topological spaces
          %p A review is in
          %ul
            %li#Weiss
              %a.existingWikiWord{:href => "/nlab/show/Ittay+Weiss"}> Ittay Weiss
              ,
              = succeed "," do
                %em From Operads to Dendroidal Sets
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
              AMS (2011) (
              %a{:href => "http://arxiv.org/abs/1012.4315"}> arXiv:1012.4315
              )
          %p see around def. 2.21 there.
          %p Underived proofs of Dunn’s additivity theorem include
          %ul
            %li#Dunn88
              %p
                Gerald Dunn,
                %em Tensor product of operads and iterated loop spaces.
                (1988) (
                %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/Dunn.pdf"}> pdf
                )
            %li#Brinkmeier00
              %p
                Michael Brinkmeier,
                = succeed "." do
                  %em On Operads
            %li#Barata22
              %p
                %span.newWikiWord>
                  Miguel Barata
                  %a{:href => "/nlab/new/Miguel+Barata"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em On the additivity of the little cubes operads
                (2022) (
                %a{:href => "https://arxiv.org/abs/2205.12875"}> arXiv:2205.12875
                )
          %p
            The
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-operadic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra
              \.
          %p It is reviewed in the form used above in the lecture notes
          %ul
            %li#Haugseng23
              %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"}> Rune Haugseng
              ,
              %em
                An allegedly somewhat friendly introduction to
                = succeed "-operads" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "https://folk.ntnu.no/runegha/iopd.pdf"}> pdf
              )
          %p
            It was realized to be compatible with the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+envelope"} symmetric monoidal envelope
            in
          %ul
            %li#Barkan23
              %a.existingWikiWord{:href => "/nlab/show/Shaul+Barkan"}> Shaul Barkan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jan+Steinebrunner"} Jan Steinebrunner
              = succeed "," do
                %em Segalification and the Boardman-Vogt tensor product
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/2301.08650"} arXiv:2301.08650
          %p
            The ∞-categorical
            %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
            is due to
          %ul
            %li#Schlank19
              %a.existingWikiWord{:href => "/nlab/show/Tomer+Schlank"}> Tomer Schlank
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lior+Yanovski"} Lior Yanovski
              = succeed "," do
                %em The ∞-Categorical Eckmann-Hilton Argument
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1808.06006"} arXiv:1808.06006
              = succeed ")" do
                %a{:href => "https://doi.org/10.2140/agt.2019.19.3119"} doi:10.2140/agt.2019.19.3119
