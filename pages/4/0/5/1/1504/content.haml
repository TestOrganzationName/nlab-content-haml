                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    C_{a_0,  a_1, \cdots, a_k} r^{a_0} \wedge r^{a_1}
                    \&amp;=
                    (-1)^{(deg t_{a_0} + 1)(deg t_{a_1} + 1) + (deg t_{a_0})(deg t_{a_1})}
                    C_{a_0,  a_1, \cdots, a_k} r^{a_0} \wedge r^{a_1}
                    \\\
