                            %mo ∧
                            %msup
                              %mi r
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %msub
                                  %mi t
