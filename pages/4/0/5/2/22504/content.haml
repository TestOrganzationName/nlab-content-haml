                %a.maruku-eqref{:href => "#eq:SetOfssYTOfFixedShape"} (4)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
