          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            a
            %em (semi-)standard Young tableau
            is a labelling of the boxes of a
            %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            with
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Young+tableau"} Young tableau
            %em minimum
            that labels do not decrease to the right and do increase downwards.
          %p
            The number of (semi-)standard Young tableau of given shape (underlying
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+symmetric+group"} of the symmetric-
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+general+linear+group"} and general linear group
          %h2#definition Definition
          %p
          #YoungDiagram.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Young+diagram"}> Young diagram
                )
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %em
                %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                boxes
              is a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mn 1
                    %mo ≥
                    %msub
                      %mi λ
                      %mn 2
                    %mo ≥
                    %mi ⋯
                    %mo ≥
                    %msub
                      %mi λ
                      %mrow
                        %mi rows
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi λ
                      %mi i
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"}
                    (\lambda_1 \geq \lambda_2 \geq \cdots \geq \lambda_{rows(\lambda)} )
                    \\,,
                    \\;\;
                    \\lambda_i \in \mathbb{N}_+
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            #eq:NumberOfBoxes.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi λ
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    n \;=\;  \underset{i}{\sum} \lambda_i
                    \\,,
            %p
          %p
          #SemistandardYoungTableau.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"}> semistandard Young tableau
                )
              %br/
            %p
              Given a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#YoungDiagram"}
              %em semistandard Young tableau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              %em of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
            %ul
              %li
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                  of the following form (a
                  = succeed "):" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Young+tableau"} Young tableau
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi T
                          %mrow
                            %mi i
                            %mo ,
                            %mi j
                        %mo ∈
                        %msub
                          %mi ℕ
                          %mo +
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mn 1
                                %mo ≤
                                %mi i
                                %mo ≤
                                %mi rows
                                %mo{:stretchy => "false"} (
                                %mi λ
                                %mo{:stretchy => "false"} )
                            %mrow
                              %mrow
                                %mn 1
                                %mo ≤
                                %mi j
                                %mo ≤
                                %msub
                                  %mi λ
                                  %mi i
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\big(
                        T_{i, j}
                        \\in
                        \\mathbb{N}_+
                        \\big)_{
                        {1 \leq i \leq rows(\lambda)} \atop { 1 \leq j \leq \lambda_i }
                        }
                        \\,;
              %li
                %p such that these labels are:
                %ol
                  %li
                    %p weakly increasing to the right/along rows;
                    #eq:RowsAreWeaklyIncreasing.maruku-equation
                      %span.maruku-eq-number (2)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mo ∀
                              %mi i
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi j
                              %mn 1
                            %mo &lt;
                            %msub
                              %mi j
                              %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi T
                              %mrow
                                %mi i
                                %mo ,
                                %msub
                                  %mi j
                                  %mn 1
                            %mo ≤
                            %msub
                              %mi T
                              %mrow
                                %mi i
                                %mo ,
                                %msub
                                  %mi j
                                  %mn 2
                          %annotation{:encoding => "application/x-tex"}
                            \\underset{
                            i
                            }{\forall}
                            \\;\;\;\;\;\;
                            j_1 \lt j_2 \;\Rightarrow\; T_{i, j_1} \leq T_{i, j_2}
                  %li
                    %p strictly increasing downwards/along columns:
                    #eq:ColumnsAreStrictlyIncreasing.maruku-equation
                      %span.maruku-eq-number (3)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mo ∀
                              %mi j
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi i
                              %mn 1
                            %mo &lt;
                            %msub
                              %mi i
                              %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi T
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                                %mo ,
                                %mi j
                            %mo &lt;
                            %msub
                              %mi T
                              %mrow
                                %msub
                                  %mi i
                                  %mn 2
                                %mo ,
                                %mi j
                          %annotation{:encoding => "application/x-tex"}
                            \\underset{ j }{\forall}
                            \\;\;\;\;\;\;
                            i_1 \lt i_2 \;\Rightarrow\; T_{i_1, j} \lt T_{i_2,  j}
            %p
          %p
          #RemarkOnSSYTAxioms.num_remark
            %h6 Remark
            %p
              Beware that in a semistandard Young tableau (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SemistandardYoungTableau"}
            %ul
              %li
                %p
                  the label
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} T_{1,  1}
                  in the top left box is
                  %em not required
                  to be 1;
              %li
                %p
                  in
                  %em some
                  applications (e.g.
                  %a.maruku-eqref{:href => "#eq:RelationToSchurPolynomialsOfFinitelyManyVariables"} (7)
                  below), though not in general, the labels are in addition required to be bounded
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                          %mo ≤
                          %mi k
                        %annotation{:encoding => "application/x-tex"} T_{i, j} \leq k
            %p
          %p
          #StandardYoungTableau.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableau"}> standard Young tableau
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SemistandardYoungTableau"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              boxes
              %a.maruku-eqref{:href => "#eq:NumberOfBoxes"} (1)
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableau"} standard Young tableau
              if every element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \big\{1, \cdots, n\}
              appears exactly once as a label.
          %p
          #RemarkOnSYTAxioms.num_remark
            %h6 Remark
            %p
              In particular, in a standard Young tableau (Def.
              %a.maruku-ref{:href => "#StandardYoungTableau"}>
              ) we have that:
            %ol
              %li
                %p
                  not just the columns but also the rows are strictly increasing (cf.
                  = succeed ")," do
                    %a.maruku-eqref{:href => "#eq:RowsAreWeaklyIncreasing"} (2)
              %li
                %p
                  the first label of a standard Young tableau must be
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 1
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} T_{1,1} = 1
                  (cf. Rem.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#RemarkOnSSYTAxioms"}
            %p
          %h2#examples Examples
          %p The following is a semistandard Young tableau that does happen to start with 1 but is not a standard Young tableau:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %mn 1
                        %mtd
                          %mn 1
                        %mtd
                          %mn 3
                      %mtr
                        %mtd
                          %mn 2
                        %mtd
                          %mn 3
                      %mtr
                        %mtd
                          %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  1 &amp; 1 &amp; 1 &amp; 3
                  \\\
                  2 &amp; 3
                  \\\
                  4
                  }
          %h2#properties Properties
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi Part
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda \in Part(n)
          #eq:SetOfssYTOfFixedShape.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ssYT
                    %mi λ
                  %mspace{:width => "thickmathspace"}
                  %mi in
                  %mspace{:width => "thickmathspace"}
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  ssYT_\lambda
                  \\;in\;
                  Set
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of semistandard Young tableaux (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SemistandardYoungTableau"}
            %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            (i.e. forgetting its labels) is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
          %p
            Given moreover a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
            we write
          #eq:SetOfssYTOfFixedShapeWithBoundedLabels.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ssYT
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi ssYT
                    %mi λ
                %annotation{:encoding => "application/x-tex"}
                  ssYT_\lambda(N)
                  \\;\subset\;
                  ssYT_\lambda
          %p
            for the subset on those semistandard Young tableau
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            whose labels are bounded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            in that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \underset{i,j}{\forall}\; T_{i, j } \;\leq\; N
          %h3#RelationToSchurPolynomials Relation to Schur polynomials
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi T
                %annotation{:encoding => "application/x-tex"} X^T
            for the
            %a.existingWikiWord{:href => "/nlab/show/monomial"} monomial
            which contains one factor of the
            %a.existingWikiWord{:href => "/nlab/show/variable"} variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi k
                %annotation{:encoding => "application/x-tex"} x_k
            for each occurrence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            in the Young tableau:
          #eq:MonomialAssociatedWithSemistandardYoungTableau.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi T
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %mo #
                      %mn 1
                      %mi s
                  %msubsup
                    %mi x
                    %mn 2
                    %mrow
                      %mo #
                      %mn 2
                      %mi s
                  %mi ⋯
