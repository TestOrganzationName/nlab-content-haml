              %a.maruku-eqref{:href => "#eq:MonomialAssociatedWithSemistandardYoungTableau"} (6)
              associated with all
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
              of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
