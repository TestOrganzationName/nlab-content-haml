          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#on_a_symplectic_vector_space"} On a symplectic vector space
              %li
