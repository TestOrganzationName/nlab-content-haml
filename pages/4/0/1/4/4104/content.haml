                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \overline{G \cdot \{ f \}} \subset \text{Inext}(C) \subseteq C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is not minimal, a contradiction!
            %p
              Therefore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo =
                      %mtext card
                      %mo{:stretchy => "false"} (
