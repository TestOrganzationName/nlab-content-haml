            %p
              (1) (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-invariance) if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mo ∩
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi \in \cap_{n \in \mathbb{N}} C_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \phi \in C_n
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi g
                    %mo ∈
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \phi^g \in C_n
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mi g
                      %mo ∈
                      %msub
                        %mo ∩
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi^g \in \cap_{n \in \mathbb{N}} C_n
            %p
              (2) (compactness)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∩
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \cap_{n \in \mathbb{N}} C_n
              is closed so
            %p
              (3) (convexity)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∩
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
