                          %mn 1
                      %mo ⊂
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} C_{n+1} \subset C_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
