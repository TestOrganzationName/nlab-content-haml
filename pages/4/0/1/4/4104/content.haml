                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1 = \text{card}(\text{Ext}(C))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h3#extensive_and_intensive_properties Extensive and Intensive Properties
          %p
            In Lawvere’s thinking about
            = succeed "," do
              %a{:href => "intensive+or+extensive+quantity"} extensive and intensive quantities
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(G)
                is a space of
                %em intensive quantities
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ℝ
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mtext Ban
                    %annotation{:encoding => "application/x-tex"} [C(G), \mathbb{R}]_{\text{Ban}}
                is the space of
                %em extensive quantities
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext Ban
                    %annotation{:encoding => "application/x-tex"} \text{Ban}
                is the category of Banach spaces with bounded maps as maps. The Haar integral is the unique
                = succeed "-invariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/integration"} integration
                map is the canonical
                %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
                pairing
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi G
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ℝ
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mtext Ban
                      %mo ⟶
                      %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_G \;\colon\; C(G) \times [C(G), \mathbb{R}]_{\text{Ban}}  \longrightarrow \mathbb{R}
                      \\,.
          %p
            If we suggestively write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi G
                  %mi f
                  %mi d
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \int_G f d \phi
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_G (f, \phi) = \phi(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi G
                  %mo −
                  %mi d
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \int_G - d \phi
            becomes a way of writing
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            to be the Haar measure, we can write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi G
                    %mo −
                    %mi d
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \int_G - d \phi
          %h2#left_and_right_haar_measures_that_differ Left and Right Haar Measures that Differ
          %p
            The left and the right Haar measure may or may not coincide, groups for which they coincide are called
            = succeed "." do
              %strong unimodular
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                            %mtr
                              %mtd
                                %mi y
                              %mtd
                                %mi x
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo |
                    %mspace{:width => "thinmathspace"}
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi ℝ
                    %mo ,
                    %mi y
                    %mo &gt;
                    %mn 0
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  G := \left\{ \left.\, \begin{pmatrix} y &amp; x \\ 0 &amp; 1 \end{pmatrix}\,\right|\, x, y \in \mathbb{R}, y \gt 0  \right\}
          %p The left and right invariant measures are, respectively,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi L
                  %mo =
                  %msup
                    %mi y
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi y
                  %mo ,
                  %mspace{:width => "1em"}
                  %msub
                    %mi μ
                    %mi R
                  %mo =
                  %msup
                    %mi y
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi y
                %annotation{:encoding => "application/x-tex"}
                  \\mu_L = y^{-2} \,\mathrm{d}x \,\mathrm{d}y,\quad   \mu_R = y^{-1} \,\mathrm{d}x \,\mathrm{d}y
          %p and so G is not unimodular.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Abelian+groups"} Abelian groups
            are obviously unimodular; so are
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact
            groups and
            %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete
            groups.
          %h2#references References
          %p Textbook account:
          %ul
            %li#Bredon72
              %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
              , Section 0.3 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+compact+transformation+groups"} Introduction to compact transformation groups
              = succeed "," do
                %a{:href => "https://www.elsevier.com/books/introduction-to-compact-transformation-groups/bredon/978-0-12-128850-1"} ISBN 9780080873596
              = succeed "&rbrack;" do
                %a{:href => "http://www.indiana.edu/~jfdavis/seminar/Bredon,Introduction_to_Compact_Transformation_Groups.pdf"} pdf
          %p Proofs:
          %ul
            %li#Alfsen63
              %p
                E. M. Alfsen:
                = succeed "," do
                  %em A Simplified Constructive Proof of the Existence and Uniqueness of Haar Measure
                %strong 12
                (1963) &amp;lbrack;
                %a{:href => "https://doi.org/10.7146/math.scand.a-10675"}> doi:10.7146/math.scand.a-10675
                \&amp;rbrack;
            %li#Rubinstein-Salzedo04
              %p
                Simon Rubinstein-Salzedo:
                %em On the existence and uniqueness of invariant measures on locally compact groups
                (2004) &amp;lbrack;
                %a{:href => "http://simonrs.com/HaarMeasure.pdf"}> pdf
                \&amp;rbrack;
            %li#Bader20
              %p
                Uri Bader, MO answer (2020) &amp;lbrack;
                %a{:href => "https://mathoverflow.net/a/351405/381"}> MO:a/351405
                \&amp;rbrack;
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Uffe+Haagerup"}> Uffe Haagerup
                , Agata Przybyszewska:
                %em Proper metrics on locally compact groups, and proper affine isometric actions on Banach spaces
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0606794"}> arXiv:math/0606794
                \&amp;rbrack;
            %li
