          %p
          .proof
            %h6 Proof
            %p
              Consider the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^0(G)^*
              which satisfy
            %p
              (1) (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-invariance) for all functionals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi g
                  %annotation{:encoding => "application/x-tex"} \phi^g
              sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(f^{g^{-1}})
              is contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              (2) (compactness) The subtopology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is compact.
            %p
              (3) (convexity) for elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \phi_1, \ldots, \phi_n
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a_1, ..., a_n \in [0,\infty)
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi a
                        %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \sum_{i = 1}^n a_i = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mi ϕ
                        %mi i
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \sum_{i = 1}^n a_i \phi_i \in C
            %p
              (4) (nonemptiness) there is an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^0(G)^*
              contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              Claim 1:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is nonempty.
            %p
              Recall that the
              %a.existingWikiWord{:href => "/nlab/show/Hahn-Banach+theorem"} Hahn-Banach theorem
              theorem for a Banach space with squared Minkowski seminorm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mtext sup
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi ϕ
                      %mi i
                    %mover
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \text{sup}_{i \in I} \phi_i \overline{\phi_i}
              for continuous functionals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ϕ
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{ \phi_i \}_{i \in I}
              provides the existence of a continuous functional
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %msup
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \phi : C^0(G) \rightarrow \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi ϕ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ \phi \}
              satisfies (4) and (2) but possibly not (3) or (1).
            %p
              The
              = succeed "-norm" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^0(G)
              given by the squared Minkowski seminorm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mtext sup
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %msub
                      %mi ev
                      %mi g
                    %mover
                      %mrow
                        %msub
                          %mi ev
                          %mi g
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \text{sup}_{g \in G} ev_g \overline{ev_g}
              is equivalently described as the compact open topology on continuous functions from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^0(G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{ f \} \subset C^0(G)
              is closed because it is a single point in a Hausdorff space. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo :
                    %mi G
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mu_{g^{-1}} : G \rightarrow G
              for the continuous function sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi hg
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} hg^{-1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi G
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f : G \rightarrow \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi g
                    %mo :
                    %mi G
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f^g : G \rightarrow \mathbb{R}
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msub
                        %mi μ
                        %mrow
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                    %annotation{:encoding => "application/x-tex"} f \circ \mu_{g^{-1}}
            %p The composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext ev
                    %mo ∘
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mn 1
                    %mo ×
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi μ
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ×
                    %mtext Inv
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi G
                    %mo ×
                    %mi G
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\text{ev} \circ
                    \\Big(1 \times
                    \\big(\mu \circ
                    (1 \times \text{Inv})
                    \\big)
                    \\Big)
                    \\;\colon\;
                    [G,\mathbb{R}] \times G \times G
                    \\longrightarrow
                    \\mathbb{R}
            %p is continuous, from which we get that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi G
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [G,\mathbb{R}] \times G
                    \\longrightarrow
                    [G,\mathbb{R}]
            %p
              is continuous, using the calculus of
              %a.existingWikiWord{:href => "/nlab/show/mates"} mates
              for
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+objects"} exponentiable objects
              in topological spaces, along with the fact that a compact space is exponentiable.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi G
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G,\mathbb{R}] \times G \rightarrow [G,\mathbb{R}]
              sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              to the continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi g
                  %annotation{:encoding => "application/x-tex"} f^g
              sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi hg
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi μ
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(hg^{-1}) = f \circ \mu_{g^{-1}} (h)
              is continuous. It follows that image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \{ f \} \times G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G,\mathbb{R}]
              is compact. This is the
              = succeed "-orbit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi f
                        %mi g
                      %mo :
                      %mi g
                      %mo ∈
                      %mi G
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ f^g : g \in G \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi f
                      %mi g
                    %mo :
                    %mi g
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ f^g : g \in G \}
              satisfies (1) (2) and (4), but possibly not (3).
            %p
              The Krein-Smulian theorem, applied to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⋅
                    %mi f
                  %annotation{:encoding => "application/x-tex"} G \cdot f
              which is compact in the Banach space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^0(G)^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi G
                        %mo ⋅
                        %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{G \cdot f}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⋅
                    %mi f
                  %annotation{:encoding => "application/x-tex"} G \cdot f
              is compact in the weak topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^0(G)^*
              (not to be confused with the weak
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo *
                  %annotation{:encoding => "application/x-tex"} {}^*
              topology on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^0(G)^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi G
                        %mo ⋅
                        %mi f
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{G \cdot f}
              is
              = succeed "-invariant," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi G
                          %mo ⋅
                          %mi f
                        %mo ¯
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \overline{G \cdot f} \in S
            %p
              Claim 2: given a chain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{ C_n \}_{n \in \mathbb{N}}
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} C_n \in S
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mi n
