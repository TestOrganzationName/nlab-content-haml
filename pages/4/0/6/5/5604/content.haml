                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %mo =
                  %mi gpd
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi t
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\llbracket (t:\forall X.T)(U)\rrbracket =
                  gpd(i)(\llbracket t\rrbracket_D)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi U
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                %annotation{:encoding => "application/x-tex"} i\colon D \to \llbracket U\rrbracket
            is a bijection with a set in the skeleton
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} j\colon C\to D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gpd
                  %mo{:stretchy => "false"} (
                  %mi j
