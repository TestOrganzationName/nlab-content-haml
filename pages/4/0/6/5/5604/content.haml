                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-limits+-+contents"} Edit this sidebar
          %h1#complete_small_categories Complete small categories
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#in_classical_logic"} In classical logic
              %li
                %a{:href => "#in_grothendieck_toposes"} In Grothendieck toposes
              %li
                %a{:href => "#in_more_general_toposes_and_constructive_mathematics"} In more general toposes and constructive mathematics
              %li
                %a{:href => "#modelling_impredicative_type_theory"} Modelling impredicative type theory
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            A
            %strong complete small category
            (or
            = succeed ")" do
              %strong small complete category
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            which is both
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            (has only a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            (has a
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            of every small
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          %p
            (Note that the phrase “
            %a.existingWikiWord{:href => "/nlab/show/small-complete+category"}> small-complete category
            ” is sometimes used to mean merely a complete category, i.e. one which is “complete relative to small diagrams”. Therefore, “complete small category” is a safer term for our concept.)
          %h2#in_classical_logic In classical logic
          %p
            In the presence of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            %a.existingWikiWord{:href => "/nlab/show/complete+lattices"} complete lattices
            by the following theorem due to
            = succeed "." do
              %a{:href => "#Freyd64"} Freyd 64, p. 78
          #CompleteSmallCategoriesArePosets.num_theorem
            %h6#theorem Theorem
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              has
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              of families of objects whose size is at least that of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} set of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
          .proof
            %h6#proof Proof
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              be any two objects, and suppose (contrary to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              being a preorder) that there are at least two different morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⇉
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \rightrightarrows y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(x, \prod_{f \in Mor(D)} y) \cong \prod_{f \in Mor(D)} D(x, y)
            %p
              has
              %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
              at least
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %mo &gt;
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} 2^{|Mor(D)|} \gt {|Mor(D)|}
          %p
            This basic fact has profound implications for instance for the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            and the existence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
          %p
            (More generally, we only need to assume the existence of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/powers"} powers
          %h2#in_grothendieck_toposes In Grothendieck toposes
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            is not, in general,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
            %a.existingWikiWord{:href => "/nlab/show/internal+categories"} internal categories
            in a topos. However, in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %a{:href => "http://mathoverflow.net/questions/43433/small-complete-categories-in-a-grothendieck-topos"} this question
          %h2#in_more_general_toposes_and_constructive_mathematics In more general toposes and constructive mathematics
          %p
            However, it is possible to have non-preorder complete small categories in non-Grothendieck topoi. In particular, the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/effective+topos"} effective topos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/realizability+topos"} realizability toposes
            %a.existingWikiWord{:href => "/nlab/show/modest+sets"} modest sets
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partial+equivalence+relations"} partial equivalence relations
            %a{:href => "#Hyland88"} Hyland88
            and
            %a{:href => "#HRR90"} HRR90
            for details.
          %p
            It follows that, in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            or in a Grothendieck topos must be a preorder.
          %p
            There is a subtlety, however, because in the absence of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %em exists
            a limit for every diagram. The complete small categories in realizability toposes are only weakly complete, which categorically means that only the
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            completions of their corresponding
            %a.existingWikiWord{:href => "/nlab/show/indexed+categories"} indexed categories
            are complete in the relevant indexed-category sense.
          %p
            It seems to be unknown whether there exists a (necessarily non-Grothendieck) topos containing a
            %em strongly
            complete small category. However, one of the complete small categories in the effective topos does become strongly complete when the ambient context is restricted to the subcategory of
            %a.existingWikiWord{:href => "/nlab/show/assemblies"} assemblies
            rather than the entire effective topos.
          %h2#modelling_impredicative_type_theory Modelling impredicative type theory
          %p
            Complete small categories have applications to the modeling of impredicative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polymorphism"} polymorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf C
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            that is small and complete. Then we can interpret an impredicatively-quantified type as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mo ∀
                  %mi X
                  %mo .
                  %mi T
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi T
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \llbracket \forall X.T \rrbracket = \prod_{A\in \mathbf{C}} \llbracket T\rrbracket_{A/X}
          %p although there are more elaborate formulations that use a subset of this product.
          %p
            At least at first glance, this requires
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            to be
            %em strongly
            complete. Hence it works in the category of assemblies, but not the entire realizability topos.
          %p
            An alternative approach is to suppose that there is a full
            %a.existingWikiWord{:href => "/nlab/show/replete+subcategory"} replete subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            which is complete in the sense of being closed under set-indexed products and equalizers, yet
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/essentially+small"} essentially small
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            will not itself be small.) Such a category can be obtained as the repletion of any
            %em weakly
            complete
            %em actually
            small subcategory, such as exist in realizability toposes. See
            %a{:href => "#RS04"} RS04
            and
            = succeed "." do
              %a{:href => "#MS09"} MS09
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                %annotation{:encoding => "application/x-tex"} \forall
            is then achieved by a product over the sets in the small skeleton
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                  %annotation{:encoding => "application/x-tex"} \forall
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                  %annotation{:encoding => "application/x-tex"} \forall
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mo ∀
                  %mi X
                  %mo .
                  %mi T
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi π
                  %mo ∈
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi T
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo{:stretchy => "false"} |
                  %mo ∀
                  %mi R
                  %mo ⊆
                  %mi A
                  %mo ×
                  %mi B
                  %mo .
                  %msub
                    %mi ℛ
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\llbracket \forall X.T \rrbracket = \{\pi\in \prod_{A\in \mathbf{C}} \llbracket T\rrbracket_{A/X} | \forall R\subseteq A\times B. \mathcal{R}_R(
                  \\pi(A),\pi(B))\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℛ
                    %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{R}_R
            is a binary logical relation, suitably defined, and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo :
                  %mo ∀
                  %mi X
                  %mo .
