          %h1#pretopological_spaces Pretopological spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#convergence_structure"} Convergence structure
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#topological_structure"} Topological structure
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em pretopological space
            is a slight generalisation of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            where the concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            is taken as primary. The
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            on the
            %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
            of a pretopological space is called its
            = succeed "," do
              %em pretopology
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+pretopology"} Grothendieck pretopology
            (which is not even analogous).
          %h2#definitions Definitions
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong point
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong set
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∈
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}\in
            between points in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and sets in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a
            %strong neighbourhood
            (or
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mo ∈
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} \stackrel{\circ}\in
              \-neighbourhood
            to be precise) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi U
                %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U
            (which may also be written
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mover
                      %mi U
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} x \in \stackrel{\circ}U
          %p
            A
            %strong pretopology
            (or
            = succeed ")" do
              %strong pretopological structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is such a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∈
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}\in
            that satisfies these properties:
          %ol
            %li
              Centred: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              belongs to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mo ∈
                      %mi U
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U \;\Rightarrow\; x \in U .
            %li
              Nontrivial: Every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              has a neighbourhood. In light of (4), the entire space is a neighbourhood of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi S
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in S .
              %p (Some references leave this out, but that seems to be an error.)
            %li
              Directed: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are neighbourhoods of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi V
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mo ∩
                      %mi V
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U \;\Rightarrow\; x \stackrel{\circ}\in V \;\Rightarrow\; x \stackrel{\circ}\in U \cap V .
              %p
                (Strictly speaking, the relation should not be called
                %a.existingWikiWord{:href => "/nlab/show/direction"} directed
                unless it is also nontrivial.)
            %li
              Isotone: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is contained in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a neighbourhood of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo ⊆
                      %mi V
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi V
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U \;\Rightarrow\; U \subseteq V \;\Rightarrow\; x \stackrel{\circ}\in V .
          %p
            In other words, the collection of neighbourhoods of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            must be a
            %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            that is refined by the free
            %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %strong neighbourhood filter
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            A pretopology can also be given by a base or subbase. A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/base"} base
            for a pretopology is any relation that satisfies (1–3), using the first version for each of (2,3); a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
            is any relation that satisfies (1). (It would not really be appropriate to use the symbol ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mover
                    %mo ∈
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}\in
            ’ for a mere base or subbase; you'd probably want to think of it as a family of sets indexed by the points, and use the term ‘basic neighourhood’ or ‘subbasic neighbourhood’.) You get a base (in fact one satisfying the stronger versions of 2,3) from a subbase by closing under finitary intersections; you get a pretopology from a base by taking supsersets. (Really, this is just a special case of considering a base or subbase of a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/filter"} filter
          %p
            A
            %strong pretopological space
            is a set equipped with a pretopological structure.
          %p
            A
            %strong continuous map
            from a pretopological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to a pretopological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            such that:
          %ul
            %li
              For every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*(U)
              is a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %p
            In this way, pretopological spaces and continuous maps form a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pre
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Pre Top
          %h2#convergence_structure Convergence structure
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            on a pretopological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            %strong converges
            to a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (written
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \to x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            refines (contains) the neighbourhood filter of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p This relation satisfies the following properties:
          %ul
            %li
              Centred: The free ultrafilter at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (the collection of all sets that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              belongs to) converges to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mi x
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \{ A \;|\; x \in A \} \to x .
            %li
              Isotone: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              refines
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              converges to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo →
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %mo ⊆
                      %mi G
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mo →
                      %mi x
                      %mo .
                    %annotation{:encoding => "application/x-tex"} F \to x \;\Rightarrow\; F \subseteq G \;\Rightarrow\; G \to x .
            %li
              Infinitely directed: The intersection of all filters that converge to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              itself converges to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mo{:stretchy => "false"} {
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %mo →
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mi x
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \bigcap \{ F \;|\; F \to x \} \to x .
          %p
            In this way, every pretopological space becomes a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/convergence+space"} convergence space
          %p
            In fact, we can recover the pretopological structure from the convergence structure as follows:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi U
                %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            belongs to every filter that converges to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pre
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Pre Top
            a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conv
                %annotation{:encoding => "application/x-tex"} Conv
            of convergence spaces.
          %p
            Actually, we can do more. The definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi U
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}U
            from the convergence structure assigns a pretopological structure to
            %em any
            convergence space, although in general this pretopology defines a weaker notion of convergence (more filters converge to more points). Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pre
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Pre Top
            is also a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conv
                  %annotation{:encoding => "application/x-tex"} Conv
          %p
            Every pretopological convergence satisfies the star property, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pre
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Pre Top
            is a full reflective subcategory of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ps
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Ps Top
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudotopological+spaces"} pseudotopological spaces
          %h2#examples Examples
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is a pretopological space, using the usual definition of (not necessarily open) neighbourhood:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi U
                %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U
            if there exists some open set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} x \in G
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} G \subseteq U
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of topological spaces becomes a full subcategory of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pre
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Pre Top
          %p In fact, we can easily characterise the topological pretopologies, allowing us to define a topological space as a pretopological space satisfying this axiom:
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a set, then let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} \stackrel{\circ}U
              be the set of all points that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a neighbourhood of. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} \stackrel{\circ}U
              is a neighbourhood of each of its members. That is,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mover
                        %mo ∈
                        %mo ∘
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi y
                      %mover
                        %mo ∈
                        %mo ∘
                      %mi U
                      %mo{:stretchy => "false"} }
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U \;\Rightarrow\; x \stackrel{\circ}\in \{ y \;|\; y \stackrel{\circ}\in U \} .
          %p In the terms defined below, a topological space is a pretopological space in which every preinterior is open.
          %p There are many examples of pretopological spaces that are not topological spaces, although the last two are rather artificial:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2
              becomes a pretopological space if we say a neighborhood of a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,y)
              is any set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U \subseteq \mathbb{Z}^2
              that contains all these points:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi i
                  %mo ,
                  %mi y
                  %mo +
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mtext where
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %mo ,
                  %mi j
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (x+i, y+j) \; \text{where} \; i,j \in \{-1,0,1\}
          %ul
            %li
              %p
                There is a pretopology on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                where the neighborhoods of rational numbers are those from the Euclidean topology, while those of the irrational numbers are those from the discrete topology.
            %li
              %p
                Consider a
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is a neighborhood of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                if there is a positive number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                contains the ball
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi y
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mi ϵ
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ y \;|\; d(x,y) \lt \epsilon \}
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                the
                = succeed ":" do
                  %em plus pretopology
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is a neighborhood of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \vec{x} = (x_1,\ldots,x_n)
                if there is a positive number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                contains the
                = succeed "-ball" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} l^0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} →
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi inf
                          %mi i
                        %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi i
                        %mo ,
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mi ϵ
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ \vec{y} \;|\; \inf_i d(x_i,y_i) \lt \epsilon \}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is a line and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n = 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1,x_2)
                at the centre and cross bars of length
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} 2 \epsilon
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                is a pretopological space, but it is topological only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \leq 1
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
          %p
            The first example, and many similar examples, arise naturally in the theory of cellular automata. The third example, based on Section 15.6 of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/HAF"} HAF
            %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Unif
                  %mo ×
                  %mi Unif
                %annotation{:encoding => "application/x-tex"} Unif \times Unif
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pre
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Pre Top
            %a.existingWikiWord{:href => "/nlab/show/uniform+convergence+space"} uniform convergence space
            that generalises uniform spaces much like convergence spaces generalise topological spaces; perhaps the plus product takes place there.)
          %h2#topological_structure Topological structure
          %p
            Fix a pretopological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            The
            %strong preinterior
            of a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}A
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} A^\circ
            of all points that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a neighbourhood of:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo ∘
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi A
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \stackrel{\circ}A = \{ x \;|\; x \stackrel{\circ}\in A \} .
          %p
            A set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong open
            if it equals its preinterior. The
            %strong interior
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Int
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Int(A)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the union of all of the open sets contained in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Similarly, the
            %strong preclosure
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{A}
            of all points that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            meets every neighbourhood of:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mo ∀
                  %mi U
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi U
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo ∩
                  %mi U
                  %mo ≠
                  %mi ∅
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \{ x \;|\; \forall{U},\; x \stackrel{\circ}\in U \;\Rightarrow\; A \cap U \neq \empty \} .
          %p
            A set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong closed
            if it equals its preclosure. The
            %strong closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(A)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the intersection of all of the closed sets containing
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo ∈
                    %mo ∘
                  %mi U
                %annotation{:encoding => "application/x-tex"} x \stackrel{\circ}\in U
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            meets every set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} x \in \bar{A}
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
          %p (Warning: not all references use these terms in the same way. This terminology is based on the premise that a closure should be closed.)
          %p
            The duality between (pre)interiors and open sets on the one hand and (pre)closures and closed sets on the other hand is (at least if you assume
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            is the complement of the (pre)closure, and a set is open if and only if its complement is closed. However, a preinterior is generally not open but larger than an interior; similarly, a preclosure is generally not closed but smaller than a closure. The situation looks like this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊇
                  %mover
                    %mi A
                    %mo ∘
                  %mo ⊇
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi A
                    %mo ∘
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mo ⊇
                  %mi ⋯
                  %mo ⊇
                  %mi Int
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} A \supseteq \stackrel{\circ}A \supseteq (\stackrel{\circ}A)^{\circ} \supseteq \cdots \supseteq Int(A) ,
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ⊆
                  %mover
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ¯
                  %mo ⊆
                  %mi ⋯
                  %mo ⊆
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} A \subseteq \bar{A} \subseteq \overline{\bar{A}} \subseteq \cdots \subseteq Cl(A) .
          %p
            In many cases this iteration stabilizes after finitely many terms. The plus power
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n
            seems to stabilise after
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            iterations. And in a topological space, of course, it only takes one step.
          %p
            In general, however, there can be transfinitely many terms in these sequences. For example, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            be any
            %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
            (thought of as the
            %a.existingWikiWord{:href => "/nlab/show/well-ordered+set"} well-ordered set
            of all smaller ordinal numbers) with the following pretopology:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mover
                      %mo ∈
                      %mo ∘
                    %mi U
                  %annotation{:encoding => "application/x-tex"} 0 \stackrel{\circ}\in U
              iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} U = \Omega
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi α
                    %mover
                      %mo ∈
                      %mo ∘
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \alpha \stackrel{\circ}\in U
              , where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo &lt;
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \alpha \lt \Omega
              is a nonzero ordinal, iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} [\beta,\Omega) \subseteq U
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo &lt;
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \beta \lt \alpha
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo ,
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A=[1,\Omega)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo ∘
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo ,
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \stackrel{\circ}A = [2,\Omega)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo ∘
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo ,
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\stackrel{\circ}A)^\circ = [3,\Omega)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            steps to stabilize at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} Int(A)=\emptyset
          %p
            Note that an interior is open, and a closure is closed. Indeed, the open sets in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            form a topological structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %em not
            (in general) give the original pretopology on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
