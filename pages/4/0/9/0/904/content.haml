          %h2#idea Idea
          %p
            The
            %em fundamental group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
            of a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,x)
            is the group of based
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/loops"} loops
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            This is also called
            %em
              the first
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The notion of
            %em fundamental group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
            generalises in one direction to the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n(X,a)
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x : * \to X
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              based at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma : \Delta^1  \to X
            %p
              from the topological 1-
              %a.existingWikiWord{:href => "/nlab/show/simplex"}> simplex
              , such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \gamma(0) = \gamma(1) = x
            %p
              A
              %em
                based
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between two loops is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ×
                            %msup
                              %mi Δ
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta^1
                    \\\
                    \\downarrow^{\mathrlap{(id,\delta_0)}} &amp; \searrow^{\mathrlap{f}}
                    \\\
                    \\Delta^1 \times \Delta^1 &amp;\stackrel{\eta}{\to}&amp; X
                    \\\
                    \\uparrow^{\mathrlap{(id,\delta_1)}} &amp; \nearrow_{\mathrlap{g}}
                    \\\
                    \\Delta^1
                    }
            %p
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \eta(0,-) = \eta(1,-) = x
          .num_prop
            %h6#proposition Proposition
            %p
              This notion of based homotopy is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          .proof
            %h6#proof Proof
            %p
              This is directly checked. It is also a special case of the general discussion at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
          #Concatenation.num_definition
            %h6#definition_3 Definition
            %p
              Given two loops
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mn 1
                      %mo ,
                      %msub
                        %mi γ
                        %mn 2
                      %mo :
                      %msup
                        %mi Δ
                        %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \gamma_1, \gamma_2 : \Delta^1 \to X
              %strong concatenation
              to be the loop
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 2
                    %mo ⋅
                    %msub
                      %mi γ
                      %mn 1
                    %mo :
                    %mi t
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi γ
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mi t
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ≤
                              %mi t
                              %mo ≤
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi γ
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo ≤
                              %mi t
                              %mo ≤
                              %mn 1
                              %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma_2 \cdot \gamma_1 : t \mapsto
                    \\left\{
                    \\array{
                    \\gamma_1(2 t) &amp; ( 0 \leq t \leq 1/2 )
                    \\\
                    \\gamma_2(2 (t-1/2)) &amp; (1/2 \leq t \leq 1)
                    }
                    \\right.
                    \\,.
          #GroupStructure.num_prop
            %h6#proposition_2 Proposition
            %p
              Concatenation of loops respects based homotopy classes where it becomes an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              %a.existingWikiWord{:href => "/nlab/show/unital"} unital
              binary pairing with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
          .num_remark
            %h6#remark Remark
            %p
              See also at
              %em
                %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
              for similar constructions.
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a topological space and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a point, the set of based homotopy equivalence classes of based loops in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with the group structure from prop.
              %a.maruku-ref{:href => "#GroupStructure"}
              is the
              %strong fundamental group
              or
              %strong
                first
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grp
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(X,x) \in Grp
                    \\,.
          %p
            Hence if we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [\gamma] \in p_1(X,x)
            for the based homotopy class of a loop
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi γ
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi γ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi γ
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi γ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\gamma_1] \cdot [\gamma_2] \coloneqq [\gamma_1 \cdot \gamma_2]
                  \\,.
          #SimplyConnectedSpace.num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              whose fundamental group is trivial is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
          #EMSpace.num_defn
            %h6#definition_6 Definition
            %p
              Conversely, a topological space whose only non-trivial
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              is the fundamental group is called an
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(\pi_1(X), 1)
          %h2#properties Properties
          %h3#naturality Naturality
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is path-
              %a.existingWikiWord{:href => "/nlab/show/connected+space"}> connected space
              , then all of the fundamental groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_0, x_1 \in X
              any two basepoints, there is by assumption a path connecting them, hence a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    p : \Delta^1 \to X
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} p(0) = x_0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi x
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p(1) = x_1
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ¯
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar p \coloneqq (p(1-(-)))
              for the same path with the orientation reversed. Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \gamma_0
              any loop based at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi γ
                        %mn 0
                      %mo ⋅
                      %mover
                        %mi p
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [ p \cdot (\gamma_0 \cdot \bar p) ]
              %a.maruku-ref{:href => "#Concatenation"}
              yield a loop based at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              (obtained from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\gamma_0]
              by
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [p]
            %p
              It is immediate to check that this induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ad
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi p
                        %mo{:stretchy => "false"} ]
                    %mo :
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ad_{[p]} : \pi_1(X,x_0) \to \pi_1(X,x_1)
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              Therefore one sometimes loosely speaks of ‘the’ fundamental group of a connected space. But beware that the isomorphism in the above construction is not unique. Therefore forming fundamental groups is not a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on connected spaces.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              It is, however, a functor on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                  %annotation{:encoding => "application/x-tex"} \pi_1(-) :
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo →
                  %annotation{:encoding => "application/x-tex"} {}^{*/} \to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
          %h3#RelationToSingularHomology Relation to singular homology
          %p
            The fundamental group is in general non-abelian (i.e. is not an
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %a{:href => "#Examples"} Examples
            below. For a connected topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
            is equivalent to the first
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi ab
                  %mo ≃
                  %msub
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1(X,x)^{ab} \simeq H_1(X)
                  \\,.
          %p
            See at
            %em
              %a{:href => "singular%20homology#RelationToHomotopyGroups"} singular homology – Relation to homotopy groups
            for more on this.
          %h3#relation_to_universal_covers_and_galois_groups Relation to universal covers and Galois groups
          %p
            There is a relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+cover"} universal covers
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+fundamental+group"} étale fundamental group
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chevalley+fundamental+group"} Chevalley fundamental group
          %p
            In particular in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            and
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            this essentially identifies the concept of fundamental group with that of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Galois+groups"} Galois groups
            %em
              %a.existingWikiWord{:href => "/nlab/show/algebraic+fundamental+group"} algebraic fundamental group
            in this context. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            for more on this.
          %p
            See also at
            = succeed "." do
              %em
                %span.newWikiWord
                  link between Galois theory and fundamental groups
                  %a{:href => "/nlab/new/link+between+Galois+theory+and+fundamental+groups"} ?
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck%27s+Galois+theory"} Grothendieck's Galois theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi 𝒞
                  %mo →
                  %mi Sets
                %annotation{:encoding => "application/x-tex"} F:\mathcal{C}\to Sets
            or to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSets
                  %annotation{:encoding => "application/x-tex"} FinSets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is the category of coverings of the given space. This theory extends to other situations and the term
            %a.existingWikiWord{:href => "/nlab/show/algebraic+fundamental+group"} algebraic fundamental group
            is used in particular for the case of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
          %h2#generalizations Generalizations
          %h3#nonlocally_nice_spaces_and_generalised_spaces Non-locally ‘nice’ spaces and ‘generalised’ spaces
          %p
            The definition of fundamental group in terms of homotopy classes of loops at a base point does not work well for the spaces that occur in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            there are in general very few paths, and
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
            gave a definition of a fundamental group in SGA1 which is closely related to the
            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois groups
            of number theory, but in cases where both the path-based group and this
            %a.existingWikiWord{:href => "/nlab/show/algebraic+fundamental+group"} algebraic fundamental group
            make sense, the algebraic form tends to be related to the
            %a.existingWikiWord{:href => "/nlab/show/profinite+completion+of+a+group"} profinite completion
            of the topological fundamental group; see the example in that entry.
          %p
            A similar type of construction gives the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group+of+a+topos"} fundamental group of a topos
          %p
            The notion of fundamental group generalizes to that of
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            in both the loop based theory and in
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck%27s+Galois+theory"} Grothendieck's Galois theory
            as described in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SGA1"} SGA1
            %a.existingWikiWord{:href => "/nlab/show/pro-spaces"} pro-spaces
            in work of Isaksen.
          %h3#proper_fundamental_groups Proper fundamental groups
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/proper+homotopy+theory"} proper homotopy theory
            there are two related fundamental groups for single ended spaces.
          %h2#Examples Examples
          #EuclideanSpaceFundamentalGroup.num_example
            %h6#example Example
            %p
              %strong
                (Euclidean space is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              be the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              with its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
              the fundamental group is trivial:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(\mathbb{R}^n, x) = 1
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma \;\colon\; [0,1] \longrightarrow \mathbb{R}^n
            %p
              be
              %a.existingWikiWord{:href => "/nlab/show/loop"} loop
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \gamma(0) = x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \gamma(1) = x
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi x
                            %mo +
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi γ
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi x
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1] \times [0,1] &amp;\overset{\eta}{\longrightarrow}&amp; \mathbb{R}^n
                    \\\
                    (t,s) &amp;\mapsto&amp; x + s (\gamma(t) - x)
                    }
                    \\,.
            %p
              This is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id_{[0,1]} \times \gamma) \;\colon\; (t,s) \mapsto (\gamma(t),s)
              (which is continuous as the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product
              of two continuous functions) and the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi x
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v,s) \mapsto x + s ( v - x )
              (which is continuous since
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous"} polynomials are continuous
            %p Moreover, by construction we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi const
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(-,1) = \gamma(-)
                    \\phantom{AAAA}
                    \\eta(-,0) = const_x
                    \\,.
            %p
              Therefore this is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              to the constant loop at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          .num_example
            %h6#example_2 Example
            %p
              By definition
              = succeed "," do
                %a.maruku-ref{:href => "#SimplyConnectedSpace"}
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
              is trivial.
          .num_example
            %h6#example_3 Example
            %p
              The
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group+of+the+circle+is+the+integers"} fundamental group of the circle is the integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(S^1) \simeq \mathbb{Z}
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              An instructive formalization of this basic statement in
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              is in (
              %a{:href => "#Shulman"}> Shulman
              ).
          .num_example
            %h6#example_4 Example
            %p
              By definition
              = succeed "," do
                %a.maruku-ref{:href => "#EMSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(G,1)
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \pi_1(K(G,1)) = G
