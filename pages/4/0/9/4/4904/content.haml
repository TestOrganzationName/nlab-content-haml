                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ⋯
                  %mo ×
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  F(c_1 \times \cdots, \c_n)
                  \\to
                  F(c_1) \times \cdots \times F(c_n)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
          %p
            We now look at model category structure on
            %em strictly
            product preserving functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} C \to sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_{(\infty,1)}(C)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+homotopy+T-algebras"} model structure on homotopy T-algebras
          #ModelStructureOnSimplicialAlgebrasOverOrdinaryLawveretheory.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be the
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo ⊂
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T Alg^{\Delta^{op}} \subset Func(T,sSet)
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              to
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              on those functors that preserve these
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} T Alg^{\Delta^{op}}
              carries the structure of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} (T Alg^{\Delta^{op}})_{proj}
              where the weak equivalences and the fibrations are those maps underlying which are weak equivalences or fibrations, respectively, in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
          %p
            This is due to (
            %a{:href => "#Quillen67"}> Quillen 67, II.4 theorem 4
            ).
          %p
            The inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                %annotation{:encoding => "application/x-tex"} i : sAlg(C) \hookrightarrow sPSh(C^{op})_{proj}
            into the projective
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            evidently preserves fibrations and acyclic fibrations and gives a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                  %mover
                    %munder
                      %mo ↪
                      %mi i
                    %mo ←
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  sAlg(C)_{proj}
                  \\stackrel{\leftarrow}{\underset{i}{\hookrightarrow}}
                  sPSh(C^{op})
                  \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The total right
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sAlg
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}i \;\colon\; Ho(sAlg(C)_{proj}) \to Ho(sPSh(C^{op})_{proj})
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              and an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in sPSh(C^{op})
              belongs to the
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}i
              precisely if it preserves products up to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          %p
            This is due to (
            %a{:href => "#Badzioch02"}> Badzioch 02, def. 5.2, prop. 5.4, cor. 5.7
            ).
          %p
            It follows that the natural
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mover
                    %mo ⟶
                    %mrow
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (sAlg(C)_{proj})^\circ
                  \\stackrel{}{\longrightarrow}
                  PSh_{(\infty,1)}(C^{op})
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence
          %h3#ForAlgebrasOverSimplicialLawvereTheories For algebras over simplicial Lawvere theories
          #SimplicialLawvereTheory.num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi Skel
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi FinSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma = (Skel(FinSet^{\ast/}))
              be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Segal%27s+category"} Segal's category
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of a
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+Lawvere+theory"} simplicial Lawvere theory
              is a a pointed
              %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} i \;\colon\;\Gamma \to T
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  has the same
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  as
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is the identity on objects
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %p
              Given a simplicial theory
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %em
                simplicial
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
              is a product preserving
              %a.existingWikiWord{:href => "/nlab/show/simplicial+functor"} simplicial functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+simplicial+sets"} pointed simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    X(1_+) \in sSet
            %p
              (the value on the pointed 2-element set) is called the
              %em underlying simplicial set
              of the
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between such functors. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                    %mo ∈
                    %mi sSet
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    T Alg \in sSet Cat
            %p
              for the resulting
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
            %p
              A homomorphism is called a
              %em weak equivalence
              or a
              %em fibration
              if on underlying simplicial sets it is a weak equivalence or fibration, respectively, in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi Alg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    (T Alg)_{proj}
            %p
              for the category equipped with these
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of morphisms.
          %p
            (
            %a{:href => "#Schwede01"}> Schwede 01, def. 2.1 and def. 2.2 and beginning of section 3
            )
          .num_remark
            %h6#remark Remark
            %p
              In the case that the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Lawvere+theory"} simplicial Lawvere theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              happens to be simplicially discrete, i.e. an ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi Alg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} (T Alg)_{proj}
              of simplicial
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.maruku-ref{:href => "#SimplicialLawvereTheory"}
              with that from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ModelStructureOnSimplicialAlgebrasOverOrdinaryLawveretheory"}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Lawvere+theory"} simplicial Lawvere theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SimplicialLawvereTheory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi Alg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} (T Alg)_{proj}
              from def.
              %a.maruku-ref{:href => "#SimplicialLawvereTheory"}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          %p
            This is due to (
            %a{:href => "#Reedy74"}> Reedy 74, theorem I
            ), reviewed in (
            %a{:href => "#Schwede01"}> Schwede 01
            ).
          %p
            The analogous statement with the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            replaced by the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            is due to (
            %a{:href => "#Schw&#228;nzlVogt91"}> Schwänzl-Vogt 91
            )
          %p
            A comprehensive statement of these facts is in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, section 5.5.9
          %h3#OtherCases Other cases
          #QuillenCriterion.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enough+projectives"} enough projectives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{\mathrm{op}}}
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %em weak equivalence
              or
              %em fibration
              if for every
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} P \in \mathcal{C}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(P,f)
              is a weak equivalence or fibration, respectively, in the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              (i.e. a
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %ul
              %li
                %p
                  every object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{op}}
                  is fibrant;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is closed under
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  and has a
                  %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/generators"} generators
            %p
              then this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{op}}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          %p
            (
            %a{:href => "#Quillen67"}> Quillen 67, II.4, theorem 4
            )
          %h2#properties Properties
          %h3#relation_to_homotopy_algebras
            Relation to homotopy
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .num_theorem
            %h6#theorem Theorem
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the model structure on simplicial
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
          %p
            This is (
            %a{:href => "#Badzioch02"}> Badzioch 02, theorem 1.3
            ).
          %h3#homotopy_groups Homotopy groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be an
            = succeed "," do
              %em abelian Lawvere theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} Ab \to T
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
            and is necessarily a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .num_prop
            %h6#observation Observation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_*
              of a simplicial abelian
              = succeed "-agebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_*(A)
          .num_prop
            %h6#observation_2 Observation
            %p
              The inclusion of the full
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi T
                    %mi Alg
                    %mo ↪
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} i : T Alg \hookrightarrow T Alg^{\Delta^{op}}
              of ordinary
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %mo ⊣
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi T
                    %mi Alg
                    %mover
                      %munder
                        %mo ↪
                        %mi i
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi π
                            %mn 0
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"}
                    (\pi_0  \dashv i) : T Alg \stackrel{\overset{\pi_0}{\leftarrow}}{\underset{i}{\hookrightarrow}}
                    T Alg^{\Delta^{op}}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/trivial+model+structure"} trivial model structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} T Alg
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi i
                    %mo :
                    %mi T
                    %mi Alg
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} i : T Alg \to Ho(T Alg^{\Delta^{op}})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          %p
            This allows us to think of ordinary
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %blockquote
            %p
              all this is certainly true for ordinary
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %h2#examples Examples
          %h3#simplicial_associative_algebras
            Simplicial associative
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            A
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+ring"} simplicial ring
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            the Lawvere theory of rings.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be an ordinary commutative ring and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            the theory of commutative
            %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} T Alg
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sCAlg
                    %mi k
                %annotation{:encoding => "application/x-tex"} sCAlg_k
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi CAlg
                      %mi k
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CAlg_k^{op}
          %p
            Such simplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")." do
              %a{:href => "#ToenVezzosi"} Toën-Vezzosi, section 2.2.1
            = succeed "," do
              %a{:href => "#Schwede97"} Schwede 97
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
          %h3#simplicial_commutative_algebras
            Simplicial commutative
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p The following is a variant of the model structure on simplicial commutative algebras that is implied by the above general theorem.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              %strong (second model structure)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be the
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
              for (
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative
              and)
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cAlg
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} (cAlg_k)^{\Delta^{op}}
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              with
            %ul
              %li
                %p
                  weak equivalences the morphisms whose underlying morphism of simplicial sets are weak equivalences in the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %li
                %p
                  fibrations the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \to Y
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %msub
                          %mi π
                          %mn 0
                        %mi X
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi π
                              %mn 0
                            %mi Y
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \to \pi_0 X \times_{\pi_0 Y} Y
                  is a degreewise surjection.
          %p
            This appears as (
            %a{:href => "#GoerssSchemmerhorn"}> Goerss-Schemmerhorn, theorem 4.17
            ).
          %h3#simplicial_lie_algebras Simplicial Lie algebras
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+Lie+algebras"} model structure on simplicial Lie algebras
          %h3#SimplicialCommutativeHopfAlgebras Simplicial complete Hopf algebras
          %p
            Complete rational
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
            are not the models of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            = succeed ")." do
              %a{:href => "#Quillen67"} Quillen 67, bottom of p. 265 (61 of 92)
          %p
            But they do satisfy the assumptions of proposition
            %a.maruku-ref{:href => "#QuillenCriterion"}
            (
            %a{:href => "#Quillen69"}> Quillen 69, appendix B, prop. 2.24
            ). Hence simplicial rational complete Hopf algebras form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+abelian+groups"} model structure on simplicial abelian groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+algebras"} model structure on cosimplicial algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+monoids"} model structure on monoids
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebra over a monad
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-monad"} ∞-algebra over an (∞,1)-monad
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+a+monad"} model structure on algebras over a monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+algebraic+theory"} algebra over an algebraic theory
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-algebraic+theory"} ∞-algebra over an (∞,1)-algebraic theory
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-operad"} ∞-algebra over an (∞,1)-operad
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+an+operad"} model structure on algebras over an operad
          %h2#references References
          %p
            The classical reference for the
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            on simplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li#Quillen67
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , Section II.4 item 5 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopical+Algebra"} Homotopical Algebra
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0097438"} doi:10.1007/BFb0097438
          %p with some further remarks in
          %ul
            %li#Quillen69
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              , Section II.3 of:
              = succeed "," do
                %em Rational homotopy theory
              = succeed "," do
                %a{:href => "http://www.jstor.org/stable/1970725"} JSTOR
              = succeed ")" do
                %a{:href => "http://www.math.northwestern.edu/~konter/gtrs/rational.pdf"} pdf
          %p
            The generalization to the case that the theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            itself is allowed to be simplicial is due to
          %ul
            %li#Reedy74
              %a.existingWikiWord{:href => "/nlab/show/Christopher+Reedy"}> Christopher Reedy
              ,
              = succeed "," do
                %em Homology of algebraic theories
          %p and the topological version is due to
          %ul
            %li{:id => "Schw&#228;nzlVogt91"}
              %a.existingWikiWord{:href => "/nlab/show/Roland+Schw%C3%A4nzl"}> Roland Schwänzl
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rainer+Vogt"} Rainer Vogt
              = succeed "," do
                %em
                  The categories of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
                  = succeed "-monoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} E_\infty
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BF01198229"} doi:10.1007/BF01198229
          %p More is in
          %ul
            %li#Schwede01
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %em Stable homotopy of algebraic theories
              = succeed ")" do
                %a{:href => "http://www.math.uni-bonn.de/people/schwede/stable.pdf"} pdf
          %p In
          %ul
            %li#Rezk
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em Every homotopy theory of simplicial algebras admits a proper model
              (
              %a{:href => "http://arxiv.org/abs/math/0003065"}> math/0003065
              ) ,
          %p
            it is discussed that every model category of simplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to a left
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
          %p
            The fact that the model structure on simplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#Badzioch02
              %a.existingWikiWord{:href => "/nlab/show/Bernard+Badzioch"}> Bernard Badzioch
              ,
              = succeed "," do
                %em Algebraic theories in homotopy theory
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/3062135"} JSTOR
          %p and the multi-sorted version is in
          %ul
            %li#Bergner07
              %a.existingWikiWord{:href => "/nlab/show/Julie+Bergner"}> Julie Bergner
              ,
              = succeed "," do
                %em Rigidification of algebras over multi-sorted theories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/0508152"} arXiv:0508152
          %p
            The simplicial model structure on ordinary simplicial algebras (i.e. simplicial
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kirsten+Schemmerhorn"} Kirsten Schemmerhorn
                %em Model categories and simplicial methods
                (
                %a{:href => "http://www.math.northwestern.edu/~pgoerss/papers/ucnotes.pdf"}> pdf
                )
            %li#Schwede97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %em Spectra in model categories and applications to the algebraic cotangent complex
                = succeed "." do
                  %a{:href => "http://www.math.uni-bonn.de/people/schwede/modelspec.pdf"} pdf
          %p
            Discussion of simplicial commutative associative algbras over a ring in the context of
            %a.existingWikiWord{:href => "/nlab/show/derived+geometry"} derived geometry
            is in
          %ul
            %li#ToenVezzosi
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriele+Vezzosi"} Gabriele Vezzosi
              %em Homotopical Algebraic Geometry II: geometric stacks and applications
              (
              %a{:href => "http://arxiv.org/abs/math/0404373"}> arXiv
              )
          %p
            Discussion of divided
            %a.existingWikiWord{:href => "/nlab/show/power+operations"} power operations
            on simplicial algebras is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"}> Benoit Fresse
              ,
              = succeed "," do
                %em On the homotopy of simplicial algebras over an operad
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/118177"} jstor
        .revisedby
