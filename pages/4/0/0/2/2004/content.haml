                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi G
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G^\rho(b) : TG^A(b)\to G^A(b)
            is the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G^A(b)
            and the morphism part simply as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\mapsto G(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi ρ
                  %mo :
                  %mi b
                  %mo ↦
                  %msup
                    %mi G
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi TG
                    %mi A
                  %mo ⇒
                  %msup
                    %mi G
                    %mi A
                %annotation{:encoding => "application/x-tex"} G^\rho : b\mapsto G^\rho(b) : TG^A\Rightarrow G^A
            is a natural transformation because for any morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi b
                    %mo →
                    %mi b
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f:b\to b'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi G
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi G
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(f) : (G^A(b),G^\rho(b))\to (G^A(b'),G^\rho(b'))
            is by the definition of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi ρ
                %annotation{:encoding => "application/x-tex"} G^\rho
            is, by the same argument, an action
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msup
                      %mi G
                      %mi A
                  %annotation{:encoding => "application/x-tex"} [B,T](G^A)\Rightarrow G^A
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [B,T]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi A
                  %mo ,
                  %msup
                    %mi G
                    %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G^A,G^\sigma)
            for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi Ob
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b\in Ob B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi σ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G^\sigma(b)
            will evaluate to a
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G^A(b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi G
                    %mi σ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b\mapsto (G^A(b), G^\sigma(b))
            is an object part of a functor in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %msup
                    %mi A
                    %mi T
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [B,A^T]
            with morphism part again
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\mapsto G(g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi A
                  %mo ,
                  %msup
                    %mi G
                    %mi σ
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi H
                    %mi A
                  %mo ,
                  %msup
                    %mi H
                    %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g: (G^A,G^\sigma)\Rightarrow (H^A,H^\tau)
            is similar.
          %p
            Dually, for a comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi Ω
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A, \Omega]
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A, B]
            and an isomorphism of categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %msup
                    %mi B
                    %mi Ω
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi B
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo ,
                      %mi Ω
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [A, B^\Omega] \cong [A, B]^{[A, \Omega]}
          %h3#limits_and_colimits_in_em_categories Limits and colimits in EM categories
          %ul
            %li
              %p
                The Eilenberg–Moore category of a monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                on a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has all
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                which exist in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %a.existingWikiWord{:href => "/nlab/show/created+limit"} created
                by the forgetful functor.
            %li
              %p
                In contrast, the subject of
                %a.existingWikiWord{:href => "/nlab/show/colimits+in+categories+of+algebras"} colimits in categories of algebras
                is less easy, but a good deal can be said.
          %h3#LocalPresentability Local presentability
          #AccessibleMonad.num_defn
            %h6#definition_3 Definition
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/accessible+monad"} accessible monad
              is a
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              on an
              %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible category
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The Eilenberg–Moore category of a
              = succeed "-accessible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %a.maruku-ref{:href => "#AccessibleMonad"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible category
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              then so is the EM-category.
          %p
            (
            %a{:href => "#AdamekRosicky"}> Adamek-Rosicky, 2.78
            )
          %p
            Moreover, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %ul
            %li
              %p
                if a
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mi C
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} T : C \to C
                has a
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Alg
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} T Alg(C)= C^T
                is itself a topos;
            %li
              %p
                if a
                %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mi C
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} T : C \to C
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/exact+functor"} left exact
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi CoAlg
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} T CoAlg(C) = C_T
                is itself a topos.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/topos+of+algebras+over+a+monad"} topos of algebras over a monad
            for details.
          %h2#examples Examples
          .num_example
            %h6#examples_2 Examples
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %munder
                        %mi i
                        %mo ↪
                      %mover
                        %mo ←
                        %mi L
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \stackrel{\overset{L}{\leftarrow}}{\underset{\hookrightarrow}{i}} \mathcal{D}
              then the Eilenberg–Moore category of the induced
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} i\circ L
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              recovers the subcategory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            For instance (
            %a{:href => "#Borceux"}> Borceux, vol 2, cor. 4.2.4
            ).
