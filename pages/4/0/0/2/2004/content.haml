                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Pumpluen-Monaden.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
                , §VI.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categories+for+the+Working+Mathematician"} Categories for the Working Mathematician
                %strong 5
                Springer (1971) &amp;lbrack;
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"}> doi:10.1007/978-1-4757-4721-8
                \&amp;rbrack;
