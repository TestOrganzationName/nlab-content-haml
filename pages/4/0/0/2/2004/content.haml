          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+algebras+over+an+%28%E2%88%9E%2C1%29-monad"} (∞,1)-category of algebras over an (∞,1)-monad
            %li
