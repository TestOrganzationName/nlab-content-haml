          %h2#idea Idea
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+monad"} algebras over a monad
            (also: “modules over a monad”) is traditionally called its
            %em Eilenberg–Moore category
            (EM). Dually, the EM category of a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            is its category of coalgebras (co-modules).
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            of
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} (co-)free
            (co-)algebras is traditionally called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of the (co-)monad.
          %p
            The EM and Kleisli categories have universal properties which make sense for (co-)monads in any
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            (not necessarily
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %h2#Definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi η
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,\eta,\mu)
            be a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} T \colon C\to C
            is an
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            with multiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mi T
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} \mu \colon T T\to T
            and unit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Id
                      %mi C
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \eta \colon Id_C\to T
          .num_defn
            %h6#definition_2 Definition
            %p
              A (left)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} module
              (or
              = succeed "-algebra)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\nu)
              of an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \nu\colon T(A)\to A
              which is a
              = succeed "," do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo ∘
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ν
                    %mo ∘
                    %msub
                      %mi μ
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\nu\circ T(\nu)=\nu\circ\mu_{A} \colon T(T(A))\to A
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo ∘
                    %msub
                      %mi η
                      %mi A
                    %mo =
                    %msub
                      %mi id
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nu\circ\eta_A = id_A
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msup
                      %mi ν
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msup
                      %mi ν
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\colon (A,\nu^A)\to (B,\nu^B)
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that commutes with the action, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msup
                      %mi ν
                      %mi A
                    %mo =
                    %msup
                      %mi ν
                      %mi B
                    %mo ∘
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f\circ\nu^A=\nu^B\circ T(f)\colon T(A)\to B
                    \\,.
            %p
              The composition of morphisms of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              of
              = succeed "-modules/algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %strong Eilenberg–Moore category
              of the monad
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Alg
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Alg(T)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mspace{:width => "thinmathspace"}
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} T\,Alg
            %p
              By construction, there is a
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi U
                      %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mi T
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    U^T \colon C^T \to C
            %p
              (which may be thought of as the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
              = succeed "-module)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi T
                  %annotation{:encoding => "application/x-tex"} F^T
              such that the monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi U
                      %mi T
                    %msup
                      %mi F
                      %mi T
                  %annotation{:encoding => "application/x-tex"} U^T F^T
              arising from the adjunction is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %h3#eilenbergmoore_object Eilenberg–Moore object
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi a
                  %mo →
                  %mi a
                %annotation{:encoding => "application/x-tex"} t \colon a \to a
            is a monad in any
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %strong Eilenberg–Moore object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mi t
                %annotation{:encoding => "application/x-tex"} a^t
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            is, if it exists, the universal (left)
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi a
                    %mi t
                  %mo →
                  %mi a
                %annotation{:encoding => "application/x-tex"} u^t \colon a^t \to a
            and a 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:lspace => "verythinmathspace"} :
                  %mi t
                  %msup
                    %mi u
                    %mi t
                  %mo ⇒
                  %msup
                    %mi u
                    %mi t
                %annotation{:encoding => "application/x-tex"} \beta \colon t u^t \Rightarrow u^t
            that mediate a 2-natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msup
                    %mi a
                    %mi t
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi LMod
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(x, a^t) \cong LMod(x,t)
            between morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %mi x
                  %mo →
                  %msup
                    %mi a
                    %mi t
                %annotation{:encoding => "application/x-tex"} h \colon x \to a^t
            and
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi a
                    %mo ,
                    %mi λ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi t
                    %mi m
                    %mo ⇒
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m \colon x \to a, \lambda \colon t m \Rightarrow m)
