                %strong 2
                2 (1972) 149-168 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0022-4049(72)90019-9"}> doi:10.1016/0022-4049(72)90019-9
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Wells"} Charles Wells
                = succeed "," do
