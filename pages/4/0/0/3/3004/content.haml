                          %mi 𝒞
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
                calls these
                %em torsors
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
