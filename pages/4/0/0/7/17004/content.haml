              = succeed "," do
                %em The generalized Boardman homomorphisms
              = succeed ")" do
                %a{:href => "https://doi.org/10.2478/BF02475949"} doi:10.2478/BF02475949
          %p
            A lift of
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+invariants"} Seiberg-Witten invariants
            to classes in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
