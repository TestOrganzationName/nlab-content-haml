              %p
                %em A stable cohomotopy refinement of Seiberg-Witten invariants: I
                (
                %a{:href => "http://arxiv.org/abs/math/0204340"}> arXiv:math/0204340
                )
            %li
              %p
                %em A stable cohomotopy refinement of Seiberg-Witten invariants: II
                (
                %a{:href => "http://arxiv.org/abs/math/0204267"}> arXiv:math/0204267
                )
          %p
