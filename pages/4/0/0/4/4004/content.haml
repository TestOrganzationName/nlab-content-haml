          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} T\colon A\to B
            be a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            such that the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            can canonically be factored as the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi T
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi T
                  %mn 1
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Σ
                        %mrow
                          %mi T
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A
                  \\overset{\;\;T_1\;\;}{\longrightarrow}
                  B/T1
                  \\overset{\;\;\Sigma_{T1}\;\;}{\longrightarrow}
                  B
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            applied to the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≃
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A \simeq A/1
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            (projection on the source).
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a
            = succeed "," do
              %strong parametric right adjoint
            = succeed "," do
              %strong p.r.a.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "," do
              %strong local right adjoints
            %a.existingWikiWord{:href => "/nlab/show/local+adjunctions"} local adjunctions
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/locally"} locally
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multi-adjoint"} multi-adjoint
            %a.existingWikiWord{:href => "/nlab/show/multi-adjoints"} multi-adjoints
            can be formulated without assuming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a terminal object.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            is called
            %strong p.r.a.
            if its functor part is p.r.a. and moreover its unit and multiplication are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformation"} cartesian
            = succeed "." do
