            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %strong
                circle
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
          %p Classes of examples include
          %ul
            %li
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
          %h3#bundle_gerbes Bundle gerbes
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
                is a concrete model for the total space
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                of the total space of a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              %p
                More generally, a
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+gerbe"} nonabelian bundle gerbe
                is a concrete model for the
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                of the total space of a general
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
                is a concrete model for the total space
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
                of the total space of a
                = succeed "-principal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
              %p
                More generally, a
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+2-gerbe"} nonabelian bundle 2-gerbe
                is a concrete model for the
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
                of the total space of a general principal 3-bundle.
              %p Classes of examples include
              %ul
                %li
                  the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+bundle+2-gerbe"} Chern-Simons bundle 2-gerbe
          %h3#normal_morphisms_of_groups
            Normal morphisms of
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            A principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/0-connected"} 0-connected
            object /
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} mathf
                  %mi B
                  %mi K
                %annotation{:encoding => "application/x-tex"} \mathf{B}K
            is a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/normal+morphism+of+%E2%88%9E-groups"} normal morphism of ∞-groups
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
                \/
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+3-bundle"} principal 3-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/2-gerbe"} 2-gerbe
                \/
                %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            %li
              %p
                %strong
                  principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
                \/
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-gerbe"} ∞-gerbe
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/twisted+%E2%88%9E-bundle"} twisted ∞-bundle
                %a.existingWikiWord{:href => "/nlab/show/groupoid-principal+%E2%88%9E-bundle"} groupoid-principal ∞-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-vector+bundle"} (∞,n)-vector bundle
          %h2#References References
          %p
            The notion of principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/torsors"} torsors
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model
            for generalized spaces in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"}> Rick Jardine
                , Z. Luo:
                = succeed "," do
                  %em Higher order principal bundles
                %strong 140
                2 (2006) 221-243 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0305004105008911"}> doi:10.1017/S0305004105008911
                , web.archive:
                %a{:href => "https://web.archive.org/web/20050212221131id_/http://www.math.uwo.ca:80/~jardine/papers/cocycles8.pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"}> Rick Jardine
                \:
                = succeed "," do
                  %em Cocycle categories
                %em Algebraic Topology
                Abel Symposia
                %strong 4
                (2009) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math.AT/0605198"}> arXiv:math.AT/0605198
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-01200-6_8"} doi:10.1007/978-3-642-01200-6_8
          %p An earlier description in terms of simplicial objects is
          %ul
            %li
              P. Glenn,
              = succeed "," do
                %em Realization of cohomology classes in arbitrary exact categories
              %strong 25
              1 (1982) 33-105 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(82)90094-9"}> doi:10.1016/0022-4049(82)90094-9
              \&amp;rbrack;
          %p
            In that article not the total space of the bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            is axiomatized, but the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on it.
          %p
            See the remarks at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          %p See also
          %ul
            %li#Wendt10
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Wendt"}> Matthias Wendt
              ,
              = succeed "," do
                %em Classifying spaces and fibrations of simplicial sheaves
              %strong 6
              1 (2011) 1-38 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1009.2930"}> arXiv:1009.2930
              \&amp;rbrack;
          %p
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundles"} associated ∞-bundles
          %p
            The fully general abstract formalization in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            as discussed here was first indicated in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Twisted+Differential+String+and+Fivebrane+Structures"} Twisted Differential String and Fivebrane Structures
                (2009)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"} Zoran Škoda
                %a{:href => "https://arxiv.org/pdf/1004.2472.pdf#page=20"} §7.1
                of:
                %em Categorified symmetries
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1004.2472"}> arXiv:1004.2472
                \&amp;rbrack;
          %p with more comprehensive accounts in:
          %ul
            %li#NSS12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Principal+%E2%88%9E-bundles+--+models+and+general+theory"}
                      Principal
                      = succeed "-bundles" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mn ∞
                            %annotation{:encoding => "application/x-tex"} \infty
                %strong 10
                4 (2015) 749-801 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1207.0248"}> arXiv:1207.0248
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://link.springer.com/article/10.1007/s40062-014-0083-6"} doi:10.1007/s40062-014-0083-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
                (2013)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Equivariant+Principal+infinity-Bundles"}
                    Equivariant Principal
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2112.13654"}> arXiv:2112.13654
                \&amp;rbrack;
          %p For some additional developments and applications to ∞-group extensions, see also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Severin+Bunk"}> Severin Bunk
              \:
              = succeed "," do
                %em Principal ∞-bundles and smooth String group models
              %strong 387
              689–743 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00208-022-02462-0"}> doi:10.1007/s00208-022-02462-0
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/2008.12263"} arXiv:2008.12263
          %p A comparison of smooth principal ∞-bundles and diffeological principal bundles for diffeological groups is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emilio+Minichiello"}> Emilio Minichiello
              ,
              = succeed "," do
                %em Diffeological Principal Bundles and Principal Infinity Bundles
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/2202.11023"} arXiv:2202.11023
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            for a large class of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#RobertsStevenson
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Michael+Roberts"}> David Michael Roberts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
                %em Simplicial principal bundle in parameterized spaces
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1203.2460"}> arXiv:1203.2460
                \&amp;rbrack;
            %li#Stevenson
              %p
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
                ,
                %em Classifying theory for simplicial parametrized groups
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1203.2461"}> arXiv:1203.2461
                \&amp;rbrack;
          %p
            A fairly comprehensive account of the literature is also in the introduction of
            = succeed "." do
              %a{:href => "#NSS12"} NSS 12, “Presentations”
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H}= \infty Grpd
            the statement that homotopy types over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            are equivalently
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/infinity-actions"} infinity-actions
            is maybe due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emmanuel+Dror+Farjoun"}> Emmanuel Dror Farjoun
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"} William Dwyer
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              = succeed "," do
                %em Equivariant maps which are self homotopy equivalences
              %strong 80
              4 (1980) 670672 &amp;lbrack;
              %a{:href => "http://www.jstor.org/stable/2043448"}> jstor:2043448
              \&amp;rbrack;
          %p This is mentioned for instance as exercise 4.2in
          %ul
            %li#Dwyer2008
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %em Homotopy theory of classifying spaces
              %a{:href => "http://www.math.ku.dk/~jg/homotopical2008/Dwyer.CopenhagenNotes.pdf"} pdf
          %p
            Closely related discussion of homotopy fiber sequences and homotopy action but in terms of
            %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
            is in section 5 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matan+Prezma"}> Matan Prezma
              ,
              %em Homotopy normal maps
              (
              %a{:href => "http://arxiv.org/pdf/1011.4708v7.pdf"}> arXiv
              )
          %p
            There, conditions are given for a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi B
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet \to B_\bullet
            to a
            %a.existingWikiWord{:href => "/nlab/show/reduced+Segal+space"} reduced Segal space
            to have a fixed homotopy fiber, and hence encode an action of the loop group of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            on that fiber.
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            of
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+compactification"} Kaluza-Klein compactification
            along
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/double+field+theory"} double field theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+T-duality"} non-abelian T-duality
            = succeed "," do
