                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} G = \mathbf{B}^{n-1} U(1) \in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
            = succeed "," do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#BnU1"} circle Lie n-group
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
