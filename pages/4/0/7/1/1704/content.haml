                            %msub
                              %mo ×
                              %mi X
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                            %mo ×
                            %mi G
