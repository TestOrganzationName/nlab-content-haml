          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              an
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"} infinity-group
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              any object, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                  %annotation{:encoding => "application/x-tex"}
                    G Bund(X) \subset Grpd(\mathbf{H})/{*//G}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/sub-%28infinity%2C1%29-category"} sub-(infinity,1)-category
              on the
              %a.existingWikiWord{:href => "/nlab/show/over-%28infinity%2C1%29-category"} over-(infinity,1)-category
              of the groupoid objects over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} *//G
              on the
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .num_prop
            %h6#proposition_3 Proposition
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G Bund(X) \simeq \mathbf{H}(X, \mathbf{B}G)
            %p
              of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
          .proof
            %h6#proof_3 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^I
              is still an
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
              and hence the Giraud-Lurie axioms still hold. This means that by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
              (using the statement below
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. 6.2.3.5
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi eff
                      %mi I
                  %annotation{:encoding => "application/x-tex"}
                    Grpd(\mathbf{H}^I) \simeq
                    (\mathbf{H}^{I})^{I}_{eff}
            %p
              between groupoid objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^I
              and
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28infinity%2C1%29-category"} effective epimorphisms
              in the arrow category.
            %p
              Notice that groupoid objects and effective epis in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^I
              are given objectwise over the two objects of the interval
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} I = \Delta[1]
            %p Restricting this equivalence along the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X, \mathbf{B}G)
                    \\hookrightarrow
                    (\mathbf{H}^I)^I
            %p given by sending a cocycle to its homotopy fiber diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi P
                            %mtd
                              %mo →
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mo →
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (X \to \mathbf{B}G)
                    \\mapsto
                    \\left(
                    \\array{
                    P &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\to&amp; \mathbf{B}G
                    }
                    \\right)
            %p therefore yields precisely the equivalence in question
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mi Bund
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi I
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↪
                              %mi hofib
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi I
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G Bund(X) &amp;\hookrightarrow&amp; Grpd(\mathbf{H}^I)
                    \\\
                    \\downarrow^\simeq &amp;&amp; \downarrow^\simeq
                    \\\
                    \\mathbf{H}(X, \mathbf{B}G)
                    \&amp;\stackrel{hofib}{\hookrightarrow}&amp;
                    (\mathbf{H}^I)^I
                    }
                    \\,.
          %p
            In words this says that the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            classified
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-bundles," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
          %h3#connections_on_principal_bundles
            Connections on
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            For some comments on the generalization of the notion of
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            to principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+an+%28%E2%88%9E%2C1%29-topos+--+survey"} differential cohomology in an (∞,1)-topos – survey
          %h2#concrete_realizations Concrete realizations
          %p
            We discuss realizations of the general definition in various
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %h3#in_topological_spaces In topological spaces
          %p
            The following general construction was originally due to Quillen and defines principal
            %em groupoid
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            in its
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
            by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a small
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi P
                  %mo :
                  %mi C
                  %mo →
                  %mi SSet
                %annotation{:encoding => "application/x-tex"}
                  \\rho_P : C \to SSet
          %p
            be a functor with values in
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            such that it sends all morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to weak equivalences in
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            (
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} weak homotopy equivalences
            of simplicial sets).
          %p
            Consider first the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has a single object, so that it is the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            of a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            or
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mo =
                  %msub
                    %mi ρ
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  P := \rho_P(\bullet)
          %p be the simplicial set assigned to this single object and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo =
                  %mi P
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo :
                  %mo =
                  %mi hocolim
                  %msub
                    %mi ρ
                    %mi P
                %annotation{:encoding => "application/x-tex"}
                  X := P//G := hocolim \rho_P
          %p
            be the corresponding
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            (see there for the description as a weak colimit).
          %p
            Notice that, as every
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action+group"} action group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P//G \to \mathbf{B}G
          .un_theorem
            %h6#theorem Theorem
            %p Given the above, the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
            %p
              is a homotopy pullback (i.e. defines a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} fibration sequence
          .proof
            %h6#proof_4 Proof
            %p This is originally due to
            %ul
              %li
                D. Quillen,
                = succeed "," do
                  %em Higher algebraic K-theory I
            %p The statement is reproduced in section IV of
            %ul
              %li
                P. G. Goerss and J. F. Jardine, 1999,
                = succeed "," do
                  %em Simplicial Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/html/archive/goerss-jardine.html"} ps
          .un_remark
            %h6#remark Remark
            %p
              For the simple case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \rho_C
              necessarily takes values not just in weak equivalences but is isomorphisms of simplicial sets, this says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              is a
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundle." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %em principality
              of the action is manifestly exhibited by the fact that the base space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the (weak) quotient of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              by the action of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              The above reproduces manifest the description of ordinary
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
            %p
              More generally, when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is just a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              the above descibes something a bit more general than an ordinary
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              (as then the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on the total space may be by weak equivalences that are not isomorphisms).
          %p
            Quillen’s original construction is more general than this, concerning in fact 1-
            %a.existingWikiWord{:href => "/nlab/show/groupoid"}> groupoid
            \-principal
            = succeed "-bundles:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi P
                    %mo :
                    %mi C
                    %mo →
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_P : C \to SSet
            %p a functor that sends all morphisms to weak equivalences of simplicial sets.
            %p
              Let now for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi c
                    %mo :
                    %mo =
                    %msub
                      %mi ρ
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P_c := \rho_C(c)
            %p
              be the “bundle of
              = succeed "-fibers\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
            %p
              Then for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi P
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mo *
                                %mo ↦
                                %mi c
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P_c &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{{*} \mapsto c}
                    \\\
                    X &amp;\stackrel{g}{\to}&amp; C
                    }
            %p
              is a homotopy pullback (i.e. defines a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} fibration sequence
          %p This classical construction is recalled in the introduction of
          %ul
            %li
              Jardine,
              %em Diagrams and torsors
              (
              %a{:href => "http://www.math.uiuc.edu/K-theory/0723/diagrams3.pdf"}> pdf
              )
          %h3#in_simplicial_sets__kan_complexes In simplicial sets / Kan complexes
          %p
            See
            = succeed "." do
