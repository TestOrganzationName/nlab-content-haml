                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                            %mo ×
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                          %mtd
                            %mi G
                        %mtr
                          %mtd
