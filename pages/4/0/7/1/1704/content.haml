          %h2#idea Idea
          %p
            The notion of
            %em
              principal
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            is a
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorification
            of
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            from
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            and
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
          %p For motivation, background and further details see
          %ul
            %li
