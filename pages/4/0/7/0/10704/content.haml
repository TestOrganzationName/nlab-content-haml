                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{\{p\}} = \mathbb{Z}_{(p)}
                  is the integers localized at the
                  %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
