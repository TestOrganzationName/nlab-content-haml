              for the
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} ring
              of
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localized
              by inverting all primes in
