                    %annotation{:encoding => "application/x-tex"} \neg T
          .num_example
            %h6#example Example
            %p The most important cases are:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi p
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} T = \{p\}
                  for a prime
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
                  %strong
                    localization at
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  or
                  = succeed "." do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                      \-localization
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi T
                        %mo =
                        %mo ¬
                        %mo{:stretchy => "false"} {
                        %mi p
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} T = \neg \{p\}
                  , the set of all primes except
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
                  = succeed "." do
                    %strong
                      localization away from
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi T
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} T = \emptyset
                  \. In this case,
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
                  = succeed "." do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            %p In these cases:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mi ∅
                        %mo =
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_\emptyset = \mathbb{Q}
                  is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mrow
                            %mo ¬
                            %mo{:stretchy => "false"} {
                            %mi p
                            %mo{:stretchy => "false"} }
                        %mo =
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mfrac
                          %mn 1
                          %mi p
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{\neg\{p\}} = \mathbb{Z}[\frac{1}{p}]
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mrow
                            %mo{:stretchy => "false"} {
