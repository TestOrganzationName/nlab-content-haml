                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/surgery/gtop.pdf"} pdf
            %li#BousfieldKan72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Homotopy+limits%2C+completions+and+localizations"} Homotopy limits, completions and localizations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Frank+Adams"}> John Frank Adams
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Zbigniew+Fiedorowicz"} Zbigniew Fiedorowicz
                = succeed "," do
                  %em Localisation and Completion with an addendum on the use of Brown-Peterson homology in stable homotopy
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1012.5020"} arXiv:1012.5020
            %li#MayPonto
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"} Kate Ponto
                %em More concise algebraic topology: Localization, completion, and model categories
                (
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/mayponto.pdf"}> pdf
                )
            %li#CasacubertaPeschke
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carles+Casacuberta"}> Carles Casacuberta
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georg+Peschke"} Georg Peschke
                = succeed "," do
                  %em Localizing with respect to self maps of the circle
                %strong 339
                (1993) 117-140 &amp;lbrack;
                %a{:href => "https://doi.org/10.1090/S0002-9947-1993-1123451-X"}> doi:10.1090/S0002-9947-1993-1123451-X
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.ub.edu/topologia/casacuberta/articles/cpes.pdf"} pdf
            %li#Lurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
