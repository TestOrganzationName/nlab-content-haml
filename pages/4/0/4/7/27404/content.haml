          %h2#definition Definition
          %p
            An
            %strong affine set
            or
            %strong antithesis set
            or
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              \-set
            is a
            %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∼
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \sim)
            with an
            %a.existingWikiWord{:href => "/nlab/show/irreflexive+symmetric+relation"} irreflexive symmetric relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≁
                %annotation{:encoding => "application/x-tex"} \nsim
            such that the equivalence relation satisfies the
            %a.existingWikiWord{:href => "/nlab/show/principle+of+substitution"} principle of substitution
            for the irreflexive symmetric relation in both variables: for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∼
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ≁
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ≁
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi{:mathvariant => "normal"} and
                  %mspace{:width => "1em"}
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∼
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ≁
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ≁
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x \sim y) \to ((x \nsim z) \to (y \nsim z)) \quad \mathrm{and} \quad (x \sim y) \to ((z \nsim x) \to (z \nsim y))
          %p In addition,
          %ul
            %li
              %p
