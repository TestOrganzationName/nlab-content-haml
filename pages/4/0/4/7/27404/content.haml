          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            %a.existingWikiWord{:href => "/nlab/show/negation"} non
            %a.existingWikiWord{:href => "/nlab/show/trivial+ring"} trivial
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+subset"} multiplicative subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} -1 \in M
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ∈
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (0 \in M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is an
            = succeed "-set" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            and the irreflexive symmetric relation given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} (y - x) \in M
