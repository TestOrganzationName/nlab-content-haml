          #OneMorphismsInShapeOfMapsFromSphericalFormToBGammaEquivalentlyHaveConstantUnderlyingBundle.num_lemma
            %h6 Lemma
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \esh \,Maps\big( S^{n+2}/G ,\, \mathbf{B}\Gamma \big)
              (Exp.
              = succeed ")" do
                %a.maruku-ref{:href => "#OneMorphismInShapeOfMappingStackFromSphericalSpaceFormToBGamma"}
            #eq:OneMorphismInShapeOfMappingStacksOutOfAConstantBundle.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
