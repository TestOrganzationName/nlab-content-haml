                      %mo{:stretchy => "false"} /
                      %mi G
                      %mo ×
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %mrow
                          %mo ∋
                          %mi t
                      %munder
                        %mo ⊔
                        %mo *
