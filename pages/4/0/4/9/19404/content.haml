            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    (t,x) \,\in\, [0,1] \times S^{n+2}
                    }{\forall}
                    \\;\;
                    c(t)(x,g) \,=\, c(0)(\ast,g)
                    \\,.
            %p
              But the remaining data is then all in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma(-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \ast \,\in\, S^{n+2}
              (and then re-extending it as a constant function on this value) yields a 1-morphism of the desired form.
          %p
          #ComparisonMorphismIsSurjectiveOnConnectedComponents.num_lemma
            %h6 Lemma
            %p
              The comparison morphism (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMorphismBetweenShapesOfMappingStacks"}
              %a.existingWikiWord{:href => "/nlab/show/surjective"} surjective
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
          .proof
            %h6 Proof
            %p
              We need to show that every cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(0)
              there exists a cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c'(1)
              which is constant along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n+2}
              and a 1-morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c(-) \xrightarrow{\gamma(-)} c'(-)
              %a.maruku-ref{:href => "#ConjugacyClassesOfGroupHomomorphismsSurjectOnPrincipalBundlesOverSphericalSpaceForm"}
              there is even a Cech coboundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(0)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c'(1) = c(0)^{\gamma(0)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(t) \coloneqq c(0)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(t) \coloneqq \gamma(1)
              gives the required morphism.
          %p
          #ComparisonMorphismBijectiveOnConnectedComponents.num_prop
