          %p
          #ConjugacyClassesOfGroupHomomorphismsSurjectOnPrincipalBundlesOverSphericalSpaceForm.num_lemma
            %h6 Lemma
            %p
              Under the truncation assumption
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GammaIsNTruncated"} (3)
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi Γ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi conj
                    %mover
                      %mo →
                      %mrow
                        %mphantom
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo −
                        %mo ∼
                        %mphantom
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo −
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi Γ
                    %mi PrnBdl
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                        %mo{:stretchy => "false"} /
                        %mi G
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi iso
                  %annotation{:encoding => "application/x-tex"}
                    Hom(G,\Gamma)_{/\sim_{conj}}
                    \\xrightarrow{\phantom{--}\sim\phantom{--}}
                    \\Big(
                    \\Gamma PrnBdl(TopSp)_{S^{n + 2}/G}
                    \\Big)_{/\sim_{iso}}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying map
              of a
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              is represented by the
              %a.existingWikiWord{:href => "/nlab/show/topological+realization"} topological realization
              of any of its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycles
              %a.maruku-ref{:href => "#CanonicalCechGroupoidOfGammaPrincipalBundlesOnSphericalSpaceForm"}
              implies that in the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              the left and the composite function are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
