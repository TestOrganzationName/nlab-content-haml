                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi B
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_0
                    \\big(
                    \\Gamma PrnBdl(TopSp)_{S^{n+2}}
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\tau_0
                    \\,
                    Maps
                    \\big(
                    Shp(S^{n+2})
                    ,\,
                    B \Gamma
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\ast
                    \\,.
            %p
              Therefore, every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              on the spherical space form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} S^n/G
              trivializes after being
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pulled back
              along the coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CoprojectionInDiscussionOfGerbesOnSphericalSpaceForms"} (4)
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
              is a
              %a.existingWikiWord{:href => "/nlab/show/topological+functor"} topological functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ×
                    %msup
                      %mi G
                      %mi op
                    %mo ⇉
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo ⇉
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo *
                    %mo ×
                    %msup
                      %mi Γ
                      %mi op
                    %mo ⇉
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Γ
                    %mo ⇉
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    S^{n+2} \times G^{op} \rightrightarrows S^{n+2}
                    \\big)
                    \\xrightarrow{\;\;
                    (c_1 \rightrightarrows \ast)
                    \\;\;}
                    \\big(
                    \\ast \times \Gamma^{op} \rightrightarrows \ast
                    \\big)
                    \=
                    \\big(
                    \\Gamma \rightrightarrows \ast
                    \\big)
            %p
              out of the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ×
                    %msup
                      %mi G
                      %mi op
                    %mo ⇉
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S^{n+2} \times G^{op} \rightrightarrows X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              into the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ⇉
