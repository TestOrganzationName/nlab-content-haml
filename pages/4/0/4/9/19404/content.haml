          %p
          #ComparisonMorphismIsInjectiveOnConnectedComponents.num_lemma
            %h6 Lemma
            %p
              The comparison morphism (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMorphismBetweenShapesOfMappingStacks"}
              %a.existingWikiWord{:href => "/nlab/show/injective"} injective
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
          .proof
            %h6 Proof
            %p Given a 1-morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
