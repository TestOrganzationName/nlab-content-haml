                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo +
                                %mn 2
                          %annotation{:encoding => "application/x-tex"} S^{n+2}
              %li
                %p
                  their associated
                  %a.existingWikiWord{:href => "/nlab/show/D-topological+space"} D-
                  = succeed "," do
