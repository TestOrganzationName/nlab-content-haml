                  satisfying the following equivalent conditions (equivalent by the
                  = succeed "):" do
                    %a{:href => "group+actions+on+spheres#MadsenThomasWallTheorem"} Madsen-Thomas-Wall theorem
                %ol
                  %li
                    %p
                      for all
                      %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi p
                            %annotation{:encoding => "application/x-tex"} p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi H
                            %mo ⊂
                            %mi G
                          %annotation{:encoding => "application/x-tex"} H \subset G
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                      of
                      %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                            %mi p
                          %annotation{:encoding => "application/x-tex"} 2 p
                      or
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi p
                                %mn 2
                            %annotation{:encoding => "application/x-tex"} p^2
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi H
                          %annotation{:encoding => "application/x-tex"} H
                      is
                      %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                      to a
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
