          %p
            Discussion for the
            %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
            with application to
            %a.existingWikiWord{:href => "/nlab/show/near+horizon+geometries"} near horizon geometries
            of
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            (
            %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT+duality"} AdS/CFT dual
            to the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/ABJM+model"} ABJM model
          %ul
            %li#MFFGME09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+de+Medeiros"}> Paul de Medeiros
                ,
                = succeed "," do
