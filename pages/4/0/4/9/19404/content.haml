                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⇉
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma PrnBdl(TopSp)_{S^{n+2}/G}
                    \\;\;
                    \\simeq
                    \\;\;
                    TopFunc
                    \\big(
                    ( S^{n+2} \times G \rightrightarrows S^{n+2} )
                    ,\,
                    ( \Gamma \rightrightarrows \ast )
                    \\big)
                    \\,.
            %p
              Moreover, the analogous statement holds for bundles over the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S^{n+2}/G \times \Delta^k
              with the
              %a.existingWikiWord{:href => "/nlab/show/topological+k-simplex"} topological k-simplex
              for all
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi PrnBdl
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                        %mo{:stretchy => "false"} /
                        %mi G
                        %mo ×
                        %msup
                          %mi Δ
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi TopFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ×
                    %mi G
                    %mo ⇉
                    %msup
