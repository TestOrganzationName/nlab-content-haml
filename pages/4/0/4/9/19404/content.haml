                    \\,
                    Maps
                    \\big(
                    S^{n+2}/G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\big)
                    \\;\;\;
                    \\in
                    \\;
                    Grp(Grpd_\infty)
                    \\,.
            %p
          %p
          #ComparisonMorphismIsoOnFundamentalGroups.num_prop
            %h6 Proposition
            %p
              The comparison morphism (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMorphismBetweenShapesOfMappingStacks"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
              (for any basepoint):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 1
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∼
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
