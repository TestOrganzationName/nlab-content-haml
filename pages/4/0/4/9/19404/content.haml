            %p
              which is such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \{0\} \subset [0,1]
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            #eq:RestrictionOfEllToLeftEndpointIsIdentity.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi P
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi id
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi P
                      %mn 0
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell\vert_0 \;\colon\; P_0 \xrightarrow{\; id \;} P_0
                    \\mathrlap{\,.}
            %p
