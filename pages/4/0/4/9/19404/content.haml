                    S^{n+2}/G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\Big)
                    \\bigg)
            %p
          .proof
            %h6 Proof
            %p
              By Lemma
              %a.maruku-ref{:href => "#ComparisonMorphismIsInjectiveOnConnectedComponents"}
              it is injective, and by Lemma
              %a.maruku-ref{:href => "#ComparisonMorphismIsSurjectiveOnConnectedComponents"}
              it is surjective.
          %p
          #ComparisonMorphisnInjectiveOnFundamentalGroups.num_lemma
            %h6 Lemma
            %p
              The comparison morphism (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMorphismBetweenShapesOfMappingStacks"}
              %a.existingWikiWord{:href => "/nlab/show/injective"} injective
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
          .proof
            %h6 Proof
            %p
              Since both simplicial sets have all 2-horn fillers, by Lem.
              = succeed "," do
                %a.maruku-ref{:href => "#ThePresentationsForShapesOfMappingStacksAreKanComplexes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(-) \xrightarrow{\gamma(-)} c(-)
              a 1-morphism with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(0) = c(1)
              and all data constant along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n+2}
              that if this is homotopic relative boundary to the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(0)
              by any 2-cell, then it is so by a 2-cell all whose data is constant along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{n+2}
            %p
              Idea: As in Lem.
              %a.maruku-ref{:href => "#OneMorphismsInShapeOfMapsFromSphericalFormToBGammaEquivalentlyHaveConstantUnderlyingBundle"}
              we find that the given homotopy is itself equivalent to one whose underlying cocycle is constant along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{n+2}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma(-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \ast \in S^{n+2}
              (and then re-extending as a constant function) yields the desired homotopy.
          %p
