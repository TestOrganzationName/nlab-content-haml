                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/comodule+algebra"} comodule algebra
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/Hopf+action"} Hopf action
                        %a.existingWikiWord{:href => "/nlab/show/measuring"} measuring
                  %h2#geometric_representation_theory Geometric representation theory
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/D-module"}> D-module
                        ,
                        = succeed "," do
