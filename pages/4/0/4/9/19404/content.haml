                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1
                    \\big(
                    \\esh \, Map(p/\!\!/G,\,\mathbf{B}\Gamma)
                    \\big)
                    \\;\;
                    \\colon
                    \\;\;
                    \\pi_1
                    \\bigg(
                    \\esh
                    \\,
                    Map
                    \\Big(
                    \\mathbf{B}G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\Big)
                    \\bigg)
                    \\xrightarrow
                    {\;\;\;
                    \\sim
                    \\;\;\;}
                    \\pi_1
                    \\bigg(
                    \\esh
                    \\,
                    Map
                    \\Big(
                    S^{n+2}/G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\Big)
                    \\bigg)
            %p
          .proof
            %h6 Proof
            %p
              By Lemma
              %a.maruku-ref{:href => "#ComparisonMorphisnInjectiveOnFundamentalGroups"}
              this function is
              %a.existingWikiWord{:href => "/nlab/show/injective"} injective
              on fundamental groups.
            %p
              In order to see surjectivity, we may use that the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"} group structure
              (Rem.
              = succeed ")," do
                %a.maruku-ref{:href => "#ConcordancesOfHigherGerbesOnSphericalSpaceFormHaveGroupStructure"}
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              have isomorphic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %a.maruku-ref{:href => "#ComparisonMorphismSurjectiveOnFundamentalGroups"}
              gives the surjectivity.
          %p (…)
