          = succeed "." do
            %a.existingWikiWord{:href => "/nlab/show/free+action"} free
          %p
          #CanonicalCechGroupoidOfGammaPrincipalBundlesOnSphericalSpaceForm.num_lemma
            %h6 Lemma
            %p
              %strong
                (canonical
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/spherical+space+form"} spherical space form
              %br/
              Under the truncation condition
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GammaIsNTruncated"} (3)
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} S^{n+2}/G
              (
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/TopSp"} TopSp
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to the groupoid of
              %a.existingWikiWord{:href => "/nlab/show/topological+functors"} topological functors
              out of the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              into the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:TheTopologicalDeloopingGroupoidOfGamma"} (5)
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between them:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi PrnBdl
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                        %mo{:stretchy => "false"} /
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi TopFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
