                    \\;\overset{!}{=}\;
                    \\ast
            %p
              and this holds by the truncation assumption
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GammaIsNTruncated"} (3)
          %p
          #ConcordancesOfHigherGerbesOnSphericalSpaceFormHaveGroupStructure.num_remark
            %h6 Remark
            %p
              With
              %a.maruku-eqref{:href => "#eq:DeloopingOfShapeIsInfinityGroup"} (2)
              in Assumption
              = succeed "," do
                %a.maruku-ref{:href => "#AssumptionForHigherGerbesOnSphericalSpaceForms"}
              %a.maruku-ref{:href => "#ConcordancesOnSphericalSpaceFormIsMapsOfClassifyingSpaces"}
              implies that the space of concordances has
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-group
              structure:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
