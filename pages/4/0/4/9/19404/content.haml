                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{n+1} B \Gamma \,\simeq\, B \Gamma
                    \\;\;\;
                    \\in
                    \\;
                    Grp_\infty
            %p
              and hence, by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying theory
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n+2}
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial bundle
            #eq:UniqueGerbesOnNSphere.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Γ
                    %mi PrnBdl
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Shp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
