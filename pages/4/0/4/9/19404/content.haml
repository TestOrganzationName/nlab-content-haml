                              %mi Δ
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times \Delta^1
                    \&amp;\xrightarrow{\phantom{--}}&amp;
                    P'
                    \\\
                    \\big\downarrow
                    {}^{\mathrlap{p \times id_{[0,1]}}}
                    \&amp;&amp;
                    \\big\downarrow
