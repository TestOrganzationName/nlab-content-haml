            %p
          %p
          #ComparisonMapOfConcordanceInfinityGroupoidsIsEquivalence.num_theorem
            %h6 Theorem
            %p
              Under Assumption
              = succeed "," do
                %a.maruku-ref{:href => "#AssumptionForHigherGerbesOnSphericalSpaceForms"}
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismBetweenShapesOfMappingStacks"} (10)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+infinity-groupoids"}
                  equivalence of
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          .proof
            %h6 Proof
            %p
              The claim means that the comparison morphism is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              on all
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \pi_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              this is Prop.
              %a.maruku-ref{:href => "#ComparisonMorphismBijectiveOnConnectedComponents"}
              below, while for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              this is Prop.
              %a.maruku-ref{:href => "#ComparisonMorphismIsoOnFundamentalGroups"}
              below, whose proof has an evident generalization to all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
          #SmoothOkaForMapsOutOfBGIntoBGammaIfGammaIsBraidedTruncated.num_cor
            %h6 Corollary
            %p
              Under Assumption
              = succeed "," do
                %a.maruku-ref{:href => "#AssumptionForHigherGerbesOnSphericalSpaceForms"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+infinity-groupoids"}
                equivalence of
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              of the form:
            #eq:TheResultingSmoothOkaLikeEquivalence.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi B
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    \\,
                    Map
                    \\big(
                    \\mathbf{B}G
                    ,\,
                    \\mathbf{B}\Gamma
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    Map
                    \\big(
                    \\esh
                    \\,
                    \\mathbf{B}G
                    ,\,
                    \\esh
                    \\,
                    \\mathbf{B}\Gamma
                    \\big)
                    \\;=\;
                    Map
                    \\big(
                    B G
                    ,\,
