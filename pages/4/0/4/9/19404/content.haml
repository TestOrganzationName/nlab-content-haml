            %p
              and the 1-
              %a.existingWikiWord{:href => "/nlab/show/face"} face
              is of the claimed form
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:OneMorphismInShapeOfMappingStacksOutOfAConstantBundle"} (13)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
