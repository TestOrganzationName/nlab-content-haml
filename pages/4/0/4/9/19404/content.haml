                    \\times \Delta^k
                    ,\,
                    ( \Gamma \rightrightarrows \ast )
                    \\big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              The
              = succeed "-truncation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.maruku-eqref{:href => "#eq:GammaIsNTruncated"} (3)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              implies that its
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Γ
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi Shp
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo |
                      %mi Γ
                      %mo ⇉
                      %mo *
                      %mo |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \Gamma \,\simeq\, Shp( \left\vert \Gamma \rightrightarrows \ast \right\vert  )
              is an
              = succeed "-type" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi B
                    %mi Γ
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi B
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
