            %p
              With every
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n+2}
              this way, morphisms between principal bundles correspond to Cech
              %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
              between these Cech cocycles, which are canonically identified with continuous
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between these functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo ⇉
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c_1 \rightrightarrows \ast)
          %p
          #ShapesOfMappingStacks.num_defn
            %h6 Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids of concordances of principal bundles on spherical space forms)
              %br/
              Consider the following two
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-groupoids
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} cohesive shape
              of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
              from
