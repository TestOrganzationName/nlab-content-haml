                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/lambda-ring"} lambda-ring
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/symmetric+function"} symmetric function
                        %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/principal+bundle"}> principal bundle
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                        %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah Lie algebroid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/geometric+function+theory"}> geometric function theory
                        ,
