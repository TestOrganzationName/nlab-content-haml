                  %mi G
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                %annotation{:encoding => "application/x-tex"} S^{n+2}/G \times \Delta^k
            with the
            %a.existingWikiWord{:href => "/nlab/show/topological+k-simplex"} topological k-simplex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi Γ
                  %mi PrnBdl
                  %mo{:stretchy => "false"} (
                  %mi TopSp
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
