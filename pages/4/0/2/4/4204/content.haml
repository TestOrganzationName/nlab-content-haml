                    %a.existingWikiWord{:href => "/nlab/show/closed+string"} closed
                    %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological string
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/2Mod"} 2Mod
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
