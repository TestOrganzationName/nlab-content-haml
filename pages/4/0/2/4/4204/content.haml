                          %mstyle{:mathvariant => "bold"}
                            %mi S
                        %annotation{:encoding => "application/x-tex"} \mathbf{S}
                  %td{:style => "text-align: left;"}
                    (
                    %a{:href => "2d+TQFT#Lurie09"}> Lurie 09, section 4.2
                    )
          %h2#FiltrationOfModuliSpace Filtrations of the moduli space of surfaces
          %p
            The following study of the behaviour of 2-dimensional TQFTs in terms of the
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
            of marked hyperbolic surfaces is due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ezra+Getzler"} Ezra Getzler
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modular+operad"} modular operad
          %h3#monoid_objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            \-monoid objects
          %p
            Let
            = succeed "(" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                  %annotation{:encoding => "application/x-tex"} Core
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of finite sets. Under union of sets this is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi FinSet
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\Phi : Core(FinSet) \to C
          %p
            is a commutative
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi FinSet
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\Phi : Core(FinSet) \to C
          %p if the structure maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Phi(n+m) \stackrel{\simeq}{\to} \Phi(m) \otimes \Phi(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\phi(m) \stackrel{\simeq}{\to} \Phi(1)^{\otimes m}
          %p are weak equivalences.
          %p
            Segal called these “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            \-objects”. Since
            %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"} Carlos Simpson
            they are called
            = succeed "s." do
              %span.newWikiWord
                Segal object
                %a{:href => "/nlab/new/Segal+object"} ?
          %p
            There is also
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+algebra"} A-infinity algebra
            %a.existingWikiWord{:href => "/nlab/show/associahedra"} associahedra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} K_n
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-2)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/polytope"} polytope
          %p There is naturally a filtration on these guys with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 0
                  %msub
                    %mi K
                    %mi n
                  %mo ⊂
                  %msub
                    %mi F
                    %mn 1
                  %msub
                    %mi K
                    %mi n
                  %mo ⊂
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F_0 K_n \subset F_1 K_n \subset \cdots
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 0
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} F_0 K_n
            is the set of vertices,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 1
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} F_1 K_n
            the set of edges, etc.
          %p The collection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi S
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi K
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{
                  S_\bullet(K_n)
                  \\}
          %p
            of simplicial realizations of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} K_n
            form an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
            that is symmetric monoidal, a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi K
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %mo ⊗
                      %mi n
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S_\bullet(K_n) \to C_\bullet(X^{\otimes n}, X)
          %p
            %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> MacLane
            ‘s
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem"} coherence theorem
            says or uses that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-category"} n-category
          %p
            we may replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi m
                %annotation{:encoding => "application/x-tex"} K_m
            here by the
            = succeed "-filtration" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi n
                    %msub
                      %mi K
                      %mi m
                  %annotation{:encoding => "application/x-tex"} F_n K_m
          %h3#closed_2d_quantum_field_theory Closed 2d quantum field theory
          %h4#compactified_moduli_spaces_of_riemann_surfaces Compactified moduli spaces of Riemann surfaces
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\Sigma, (z_1, \cdots, z_n))
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            surface with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            distinct marked points. Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}(\Sigma, (z_1, \cdots, z_n))
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hyperbolic+metric"} hyperbolic metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (z_i)
          %p We have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℋ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi Diff
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  M(\Sigma, \vec z)
                  \=
                  \\mathcal{H}(\Sigma, \vec z)/Diff_+(\Sigma, \vec z)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo =
                  %msub
                    %mi Τ
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi Γ
                    %mi ng
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  M_{g,n} = \Tau_{g,n} / \Gamma^ng
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Τ
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} \Tau_{g,n}
            is the
            %a.existingWikiWord{:href => "/nlab/show/Teichm%C3%BCller+space"} Teichmüller space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mapping+class+group"} mapping class group
          %p
            Here we can assume that the
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi without
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi z
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \chi(\Sigma without \{z_i\}) \lt 0
            because otherwise this moduli space is empty.
          %h4#fenchelnielson_coordinates_on_moduli_space Fenchel-Nielson coordinates on moduli space
          %p
            We want to parameterize Teichmüller space by cutting surfaces into pieces with geodesic boundaries and
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \xi = -1
          %ul
            %li
              %p the 3-holed sphere;
            %li
              %p the 2-holed cusp;
            %li
              %p the 1-holed 2-cusp;
            %li
              %p the 3-cusp
          %p
            Each surface of
            %a.existingWikiWord{:href => "/nlab/show/genus"} genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            marked points will have
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi g
                      %mo −
                      %mn 2
                      %mo +
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2g - 2 + n
                generalized pants;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 3
                      %mi g
                      %mo −
                      %mn 3
                      %mo +
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 3 g - 3 + n
                closed curves.
          %p
            The boundary lengths
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℓ
                    %mi i
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \ell_i \in \mathbb{R}_+
            and twists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} t_i \in \mathbb{R}
            of these pieces for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ≤
                  %mi i
                  %mo ≤
                  %mn 3
                  %mi g
                  %mo −
                  %mn 3
                  %mo +
                  %mi n
                %annotation{:encoding => "application/x-tex"}
                  1 \leq i \leq 3g-3+n
          %p
            constitute the
            %a.existingWikiWord{:href => "/nlab/show/Fenchel-Nielsen+coordinates"} Fenchel-Nielsen coordinates
            on
            %a.existingWikiWord{:href => "/nlab/show/Teichm%C3%BCller+space"} Teichmüller space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Τ
                  %annotation{:encoding => "application/x-tex"} \Tau
          %p
            Also use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mi i
                  %mo :
                  %mo =
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi ℓ
                    %mi i
                  %mo ∈
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \theta_i := t_i/\ell_i \in \mathbb{R}/\mathbb{Z}
          %p
            This constitutes is a real analytic
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            of Teichmüller space. On
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            this reduces to coordinates
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                    %mo ∈
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msub
                        %mi ℓ
                        %mi i
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} t_i \in \mathbb{R}/{\ell_i \mathbb{Z}}
          %p
            Allow the lengths
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℓ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \ell_i
            to go to 0, but keep the angles
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \theta_i
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} manifold with corners
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Τ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \Tau
            (due to
            = succeed ")" do
              %span.newWikiWord
                Bill Harvey
                %a{:href => "/nlab/new/Bill+Harvey"} ?
            %span.newWikiWord
              bordification
              %a{:href => "/nlab/new/bordification"} ?
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Τ
                  %annotation{:encoding => "application/x-tex"} \Tau
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/mapping+class+group"} mapping class group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            still acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Τ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \Tau
            and the quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat M
            is an
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            with corners, inside which still sits our moduli space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            Kimura-Stasheff-Voronov: add a choice of directions at each nodal point in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
          %p
            This yields the
            %a.existingWikiWord{:href => "/nlab/show/classifying+stack"} classifying stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_{g,n}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} \Gamma_{g,n}
          %p Then the collection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi 𝒫
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{
                  \\mathcal{P}_{g,n}
                  \\}
          %p
            is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/modular+operad"} modular operad
          %p
            A 2-dimensional closed
            %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
            is an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            over this in a simplicial category, in the above sense.
          %p
            This involves either the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_{g,n}
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S_\bullet(\mathcal{P}_{g,n})
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi k
                  %msub
                    %mi 𝒫
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo :
                  %mo =
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} |
                    %mo .
                    %mo .
                    %mo .
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  F_k \mathcal{P}_{g,n}
                  \:=
                  \\left\{
                  [\Sigma] |
                  \...
                  \\right\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mn 2
                  %mi g
                  %mo −
                  %mn 2
                  %mo +
                  %mi n
                  %mo −
                  %mi k
                %annotation{:encoding => "application/x-tex"} \geq 2g-2+n-k
            spheres as components (after cutting along zero-length closed curves).
          %p So for instance
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                      %msub
                        %mi 𝒫
                        %mrow
                          %mi g
                          %mo ,
                          %mi n
                    %annotation{:encoding => "application/x-tex"} F_0 \mathcal{P}_{g,n}
                is the pants-decomposition;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %msub
                        %mi 𝒫
                        %mrow
                          %mi g
                          %mo ,
                          %mi n
                    %annotation{:encoding => "application/x-tex"} F_1 \mathcal{P}_{g,n}
                is decompositions into pants and one piece being the result of either gluing two pants to each other or of gluing two circles of a single pant to each other.
              %p
                This
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %mo .
                      %mo .
                    %annotation{:encoding => "application/x-tex"} F_1 ..
                is a connected space, due to a theorem by Hatcher-Thurston.
                %strong Notice
                This is equivalent to the familiar statement that a closed 2d TFT is a commutative
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                      %msub
                        %mi 𝒫
                        %mrow
                          %mi g
                          %mo ,
                          %mi n
                    %annotation{:encoding => "application/x-tex"} F_2 \mathcal{P}_{g,n}
                is the decomposition into pieces as before together with one two-holed torus or one five-holed sphere.
              %p
                This space has the space
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒫
                          %mrow
                            %mi g
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \mathcal{P}_{g,n}
              %p This is equivalent to the theorem by Moore and Seiberg about categorified 2-d TFT.
          .un_theorem
            %h6#theorem Theorem
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/Ezra+Getzler"}> Ezra Getzler
              )
            %p The inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi k
                    %msub
                      %mi 𝒫
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                    %mo ↪
                    %msub
                      %mi 𝒫
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"}
                    F_k \mathcal{P}_{g,n} \hookrightarrow \mathcal{P}_{g,n}
            %p
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            %p
              Here a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              is
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0(X) \to \pi_0(Y)
                  is surjective;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi π
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_i(X,x) \to \pi_i(Y,f(x))
                  is a bijection for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo &lt;
                        %mi k
                      %annotation{:encoding => "application/x-tex"} i \lt k
                  and surjective
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo =
                          %mi k
                        %annotation{:encoding => "application/x-tex"} i = k
            %p
              This means precisely that the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              is
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          .proof
            %h6#proof Proof
            %p
              Use the cellular decomposition of moduli space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℳ
                      %mrow
                        %mi g
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}_{g,1}
              following Mumford, Thurston, Harer, Woeditch-Epstein, Penner.
          %p Some other versions of this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi k
                  %msub
                    %mi Τ
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo →
                  %msub
                    %mi Τ
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"}
                  F_k \Tau_{g,n} \to \Tau_{g,n}
          %p
            is
            = succeed "-connected." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            One can also use
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+compactification"} Deligne-Mumford compactification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi k
                  %msub
                    %mover
                      %mi ℳ
                      %mo{:stretchy => "false"} ¯
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                  %mo →
                  %msub
                    %mover
                      %mi ℳ
                      %mo{:stretchy => "false"} ¯
                    %mrow
                      %mi g
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"}
                  F_k \bar \mathcal{M}_{g,n} \to \bar \mathcal{M}_{g,n}
          %p
            and this is also
            = succeed "-connected." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h3#openclosed_case Open-closed case
          %p …
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sewing+constraint"} sewing constraint
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/Cardy+condition"} Cardy condition
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/D%3D0+TQFT"} D=0 TQFT
                %li
                  %p
                    %strong D=2 TQFT
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/D%3D2+Chern-Simons+theory"} D=2 Chern-Simons theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/TCFT"} TCFT
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/A-model"}> A-model
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Landau-Ginzburg+model"} Landau-Ginzburg model
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Levin-Wen+model"} Levin-Wen model
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/D%3D3+TQFT"} D=3 TQFT
                  %ul
