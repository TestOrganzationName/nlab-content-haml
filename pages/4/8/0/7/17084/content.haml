          %h2#idea Idea
          %p
            The
            %em
              rational
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            is the
            %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
          %p
            As a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            this is a
            %a.existingWikiWord{:href => "/nlab/show/rational+topological+space"} rational topological space
            closest to the
            = succeed "-sphere," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %h2#sullivan_models Sullivan models
          %p
            The minimal
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            of a
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S^{2k+1}
            of odd
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            is the dg-algebra with a single generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_{2k+1}
            in degre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 2k+1
            and vanishing differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{2k+1} = 0
                  \\,.
          %p
            The minimal
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            of a sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} S^{2k}
            of even dimension, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} \omega_{2k}
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                %annotation{:encoding => "application/x-tex"} 2k
            and another generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 4
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_{4k-1}
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi k
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 4k-1
            with the differential defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{2k}= 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 4
                      %mi k
                      %mo −
                      %mn 1
                  %mo =
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo ∧
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{4k-1} = \omega_{2k}\wedge \omega_{2k}
                  \\,.
          %p
            One may understand this form the central fact of
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            (the proposition
            = succeed "):" do
              %a{:href => "rational+homotopy+theory#HomotopyGroupsFromSullivanGenerators"} here
          %p
            An
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo ∧
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} \omega_{2k}\wedge \omega_{2k}
            needs to be canceled in cohomology. That is accomplished by the second generator
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \omega_{4k-1}
          %p
            Again by
            = succeed "," do
              %a{:href => "rational+homotopy+theory#HomotopyGroupsFromSullivanGenerators"} that proposition
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            are concentrated, in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 2k+1
            for the odd
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                %annotation{:encoding => "application/x-tex"} 2k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi k
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 4k-1
            in for the even
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 2k
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            appearing in the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Serre+finiteness+theorem"} Serre finiteness theorem
          %p
            For instance the
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            has rational homotopy in degree 4 and 7. The one in degree 7 being represented by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
          %p
            Hence, odd dimensional
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+equivalence"} rationally homotopy equivalent
            to
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},n)
          %h2#applications Applications
          %h3#hopf_invariant Hopf invariant
          #RecognitionFromSullivanModels.num_prop
            %h6#proposition Proposition
            %p
              By standard results in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    S^{4k-1} \overset{\phi}{\longrightarrow} S^{2k}
            %p
              corresponds to a unique
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝔩
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔩
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mi CE
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝔩
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE
                    \\big(
                    \\mathfrak{l}S^{4k-1}
                    \\big)
                    \\overset{ CE(\mathfrak{l}\phi) }{\longleftarrow}
                    CE
                    \\big(
                    \\mathfrak{l}S^{2k}
                    \\big)
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+models"} Sullivan models
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+n-sphere"} of n-spheres
            %p
              The unique free
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              of this homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔩
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{l}\phi)
              is the
              %a.existingWikiWord{:href => "/nlab/show/Hopf+invariant"} Hopf invariant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HI
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HI(\phi)
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            %div{:style => "text-align: center"}
              %img{:src => "/nlab/files/HopfInvariantFromSullivanModels.jpg", :width => "530px"}/
