          #InclusionOfChainComplexIntoItsCylinder.num_remark
            %h6#remark_5 Remark
            %p
              The two boundary inclusions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              into the cylinder are given in terms of def.
              %a.maruku-ref{:href => "#BoundaryInclusionIntoChainComplexIntervalObject"}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mn 0
                      %mi X
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo ≃
                    %msub
                      %mo *
                      %mo •
                    %mo ⊗
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ⊗
                        %msub
                          %mi id
                          %mi X
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⊗
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    i^X_0
                    \:
                    X_\bullet \simeq *_\bullet \otimes X_\bullet
                    \\stackrel{i_0 \otimes id_X}{\to} (I\otimes X)_\bullet
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mn 1
                      %mi X
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo ≃
                    %msub
                      %mo *
                      %mo •
                    %mo ⊗
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi id
                          %mi X
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⊗
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    i^X_1
                    \:
                    X_\bullet \simeq *_\bullet \otimes X_\bullet
                    \\stackrel{i_1 \otimes id_X}{\to} (I\otimes X)_\bullet
            %p which in components is the inclusion of the second or first direct summand, respectively
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ↪
                    %msub
                      %mi X
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_n \hookrightarrow X_n \oplus X_n \oplus X_{n-1}
                    \\,.
          %p
            One part of definition
            %a.maruku-ref{:href => "#CylindersAndCones"}
            now reads:
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : X_\bullet \to Y_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
