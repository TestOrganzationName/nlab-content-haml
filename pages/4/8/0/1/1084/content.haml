              is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi cyl
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                            %mo ←
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mi I
                              %mo •
                            %mo ⊗
                            %msub
                              %mi X
                              %mo •
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                          %mtd
                            %msub
                              %mi X
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    cyl(f)_\bullet &amp;\leftarrow&amp; Y_\bullet
                    \\\
                    \\uparrow &amp;&amp; \uparrow^{\mathrlap{f}}
                    \\\
                    I_\bullet \otimes X_\bullet  &amp;\stackrel{i_0}{\leftarrow}&amp; X_\bullet
                    }
                    \\,.
          #MappingConeForChainComplexesExplicitly.num_prop
            %h6#proposition_5 Proposition
            %p
              The components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} cyl(f)_\bullet
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cyl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi X
                      %mi n
                    %mo ⊕
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    cyl(f)_n = X_n \oplus Y_n \oplus X_{n-1}
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ⊕
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mo ∂
                                  %mi X
                                %mo ⊕
                                %msup
                                  %mo ∂
                                  %mi Y
                          %mtd
                            %msub
                              %mi X
                              %mi n
                            %mo ⊕
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %mo ⊕
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi id
                                %mo ,
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⊕
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo ∂
                                  %mi X
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_{n+1} \oplus Y_{n+1} &amp;\stackrel{\partial^X \oplus \partial^Y}{\to}&amp; X_n \oplus Y_n
                    \\\
                    \\oplus &amp;\nearrow_{(-id,f)}&amp; \oplus
                    \\\
                    X_{n} &amp;\underset{-\partial^X}{\to}&amp; X_{n-1}
                    }
                    \\,,
            %p
              hence in
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cyl
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mo ∂
                                %mi X
                              %mo ⊕
                              %msup
                                %mo ∂
                                %mi Y
