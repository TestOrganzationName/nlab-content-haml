                              %mi X
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mo •
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi Z
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; cone(f)[1]_\bullet &amp;\to&amp; \cdots
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{h[1]_\bullet}}_{\mathrlap{\simeq}}
                    \\\
                    \&amp;&amp; &amp;&amp; cone(f)_\bullet &amp;\to&amp; X[1]_\bullet &amp;\stackrel{f[1]_\bullet}{\to}&amp; Y[1]_\bullet &amp;\to&amp; Z[1]_\bullet
                    \\\
                    \&amp;&amp; &amp;&amp; \downarrow^{\mathrlap{h_\bullet}}_{\mathrlap{\simeq}}
                    \\\
                    X_\bullet
                    \&amp;\stackrel{f_\bullet}{\to}&amp;
                    Y_\bullet
                    \&amp;\stackrel{}{\to}&amp;
                    Z_\bullet
                    }
                    \\,.
            %p Observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mi k
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n( X[k]_\bullet) \simeq H_{n-k}(X_\bullet)
                    \\,.
            %p It is therefore sufficient to check that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi cone
                              %mo{:stretchy => "false"} (
                              %mi f
                              %msub
                                %mo{:stretchy => "false"} )
                                %mo •
                            %mtd
                              %mo →
                            %mtd
                              %mi X
                              %mo{:stretchy => "false"} [
                              %mn 1
                              %msub
                                %mo{:stretchy => "false"} ]
                                %mo •
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mo ≃
                          %mtr
                            %mtd
                              %msub
                                %mi Z
                                %mo •
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n
                    \\left(
                    \\array{
                    cone(f)_\bullet &amp;\to&amp; X[1]_\bullet
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    Z_\bullet
                    }
                    \\right)
                    \\;\;
                    \:
                    \\;\;
                    H_n(Z_\bullet) \to H_n(cone(f)_\bullet) \to H_{n-1}(X_\bullet)
            %p
              equals the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \delta_n
              induced by the short exact sequence.
            %p
              By prop.
              %a.maruku-ref{:href => "#ConeInjectionEquivalentToZigzag"}
              the inverse of the vertical map is given by choosing lifts and forming the corresponding element given by the connecting homomorphism. By prop.
              %a.maruku-ref{:href => "#ProjectionOutOfChainComplexMappingConeIsHoCofiber"}
              the horizontal map is just the projection, and hence the assignment is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [z_n] \mapsto [x_{n-1}, y_n] \mapsto [x_{n-1}]
                    \\,.
            %p So in total the image of the zig-zag under homology sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Z
                    %mo ↦
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [z_n]_Z \mapsto -[\partial^Y \hat z_n]_X
                    \\,.
            %p
              By the discussion
              = succeed "," do
                %a{:href => "connecting%20homomorphism#OnHomologyInTermsOfElements"} there
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
          %h3#DistinguishedTriangles Distinguished triangles from mapping cones
          %p
            In summary, the
            %a{:href => "#HomologyExactSequencesAndFiberSequences"} above
            says that for every
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo •
                  %mo :
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %msub
                    %mi Y
                    %mo •
                %annotation{:encoding => "application/x-tex"} f_\bullet : X_\bullet \to Y_\bullet
            we obtain maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi Y
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mrow
                                  %msub
                                    %mi Y
                                    %mo •
                      %mo )
                  %mi cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mrow
                                  %mi X
                                  %mo{:stretchy => "false"} [
                                  %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                            %mtd
                              %mn 0
                      %mo )
                  %mi X
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet \stackrel{f}{\to}
                  Y_\bullet
                  \\stackrel{
                  \\left(
                  \\array{
                  0
                  \\\
                  id_{Y_\bullet}
                  }
                  \\right)
                  }{\to}
                  cone(f)_\bullet
                  \\stackrel{
                  \\left(
                  \\array{
                  id_{X[1]_\bullet} &amp; 0
                  }
                  \\right)
                  }{\to}
                  X[1]_\bullet
          %p
            which form a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            and such that this sequence continues by forming
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suspension+of+a+chain+complex"} suspensions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} [
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                  %mo{:stretchy => "false"} [
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mrow
                                  %mi Y
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                      %mo )
                  %mi cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mrow
                                  %mi X
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo +
                                  %mn 11
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                            %mtd
                              %mn 0
                      %mo )
                  %mi X
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo +
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  X[n]_\bullet \stackrel{f}{\to}
                  Y[n]_\bullet
                  \\stackrel{
                  \\left(
                  \\array{
                  0
                  \\\
                  id_{Y[n]_\bullet}
                  }
                  \\right)
                  }{\to}
                  cone(f)[n]_\bullet
                  \\stackrel{
                  \\left(
                  \\array{
                  id_{X[n+11]_\bullet} &amp; 0
                  }
                  \\right)
                  }{\to}
                  X[n+1]_\bullet
          %p To amplify this quasi-cyclic behaviour one sometimes depicts the situation as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mo •
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                        %mtd
                          %msub
                            %mi Y
                            %mo •
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %mo{:stretchy => "false"} ]
                          %mo ↖
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo •
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_\bullet &amp;&amp;\stackrel{f}{\to}&amp;&amp; Y_\bullet
                  \\\
                  \&amp; {}_{\mathllap{[1]}}\nwarrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; cone(f)_\bullet
                  }
          %p
            and hence speaks of a “triangle”, or
            %strong distinguished triangle
            or
            %strong mapping cone triangle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %ul
            %li
              distinguished triangle = period of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              \.
          %p
            Due to these “triangles” one calls the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of chain complexes
            %a.existingWikiWord{:href => "/nlab/show/localization"} localized
            at the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
          %p
            Notice that equivalently we can express the triangles via the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cyl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cyl(f)
            is quasi-isomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of chain complexes, every distinguished triangle is quasi-isomorphic to a distinguished triangle of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi Cyl
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A\to Cyl(u)\to Cone(u)\to A[1]
          %p
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} u:A\to B
            where all the morphisms in the triangle are appropriatedly induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
          %h2#related_concepts Related concepts
          %div
            %p
              %strong
                examples of
                = succeed ":" do
                  %a{:href => "Top#UniversalConstructions"} universal constructions of topological spaces
            %table
              %thead
                %tr
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AAAA
                        %annotation{:encoding => "application/x-tex"} \phantom{AAAA}
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
