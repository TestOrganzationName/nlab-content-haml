                                %mo ∂
                                %mi X
                      %mo )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ⊕
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ⊕
                    %msub
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^{cyl(f)}
                    \=
                    \\left(
                    \\array{
                    \\partial^X \oplus \partial^Y &amp; (-id, f_n)
                    \\\
                    0 &amp; -\partial^X
                    }
                    \\right)
                    \:
                    (X_{n+1} \oplus Y_{n+1}) \oplus X_{n}
                    \\to
                    (X_{n} \oplus Y_{n}) \oplus X_{n-1}
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in a
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
              are computed in the underlying
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              of
              %a.existingWikiWord{:href => "/nlab/show/towers"} towers
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (see at
              = succeed ")." do
                %a{:href => "limits+and+colimits+by+example#limitsinpresheafcat"} limits in presheaf categories
            %p
              the pushout identifies one
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Y_n
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
              and so where previously a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi X
                          %mi n
                  %annotation{:encoding => "application/x-tex"} id_{X_n}
              appeared on the diagonl, there is now
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n
          %p
            The last part of definition
            %a.maruku-ref{:href => "#CylindersAndCones"}
            now reads:
          .num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : X_\bullet \to Y_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %strong mapping cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cone(f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mi cyl
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mi X
                            %mo ⊗
                            %mi I
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo ←
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    cone(f) &amp;\leftarrow&amp; cyl(f)
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    cone(X) &amp;\leftarrow&amp; X \otimes I
                    \\\
                    \\uparrow &amp;&amp; \uparrow^{\mathrlap{i_1}}
                    \\\
                    0 &amp;\leftarrow&amp; X
                    }
          %p
            In the literature this appears for instance as (
            %a{:href => "#Schapira"}> Schapira, def. 3.2.2
            ).
          #ComponentsOfMappingConeInChainComplexes.num_prop
            %h6#proposition_6 Proposition
            %p
              The components of the mapping cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cone(f)
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    cone(f)_n =   Y_n \oplus X_{n-1}
            %p with differential given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mo ∂
                                  %mi Y
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %mo ⊕
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %mo ⊕
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo ∂
                                  %mi X
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y_{n+1} &amp;\stackrel{\partial^Y}{\to}&amp; Y_n
                    \\\
                    \\oplus &amp;\nearrow_{f_n}&amp; \oplus
                    \\\
                    X_{n} &amp;\underset{-\partial^X}{\to}&amp; X_{n-1}
                    }
                    \\,,
            %p
              and hence in
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mo ∂
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                                %mi Y
                            %mtd
                              %msub
                                %mi f
                                %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msubsup
                                %mo ∂
                                %mi n
                                %mi X
                      %mo )
                    %mo :
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ⊕
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^{cone(f)}
                    \=
                    \\left(
                    \\array{
                    \\partial^Y_{n+1} &amp; f_n
                    \\\
                    0 &amp; -\partial^X_n
                    }
                    \\right)
                    \:
                    Y_{n+1} \oplus X_{n}
                    \\to
                    Y_{n} \oplus X_{n-1}
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              As before the pushout is computed degreewise. This identifies the remaining unshifted copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with 0.
          #InclusionIntoChainComplexCone.num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f : X_\bullet \to Y_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi Y
                      %mo •
                    %mo →
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} i : Y_\bullet \to cone(f)_\bullet
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Y_\bullet
              into the mapping cone of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is given in components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mo :
                    %msub
                      %mi Y
                      %mi n
                    %mo →
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    i_n : Y_n \to cone(f)_n = Y_n \oplus X_{n-1}
            %p
              by the canonical inclusion of a summand into a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          .proof
            %h6#proof_4 Proof
            %p
              This follows by starting with remark
              %a.maruku-ref{:href => "#InclusionOfChainComplexIntoItsCylinder"}
              and then following these inclusions through the formation of the two colimits as discussed above.
          %p
            The construction above builds the mapping cone explicitly via the standard formula for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushouts"} homotopy pushouts
          #ConeViaDoubleComplex.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} D_{\bullet,\bullet}
              concentrated in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mn 1
                        %mo ,
                        %mo •
                    %mo ≔
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} D_{1,\bullet} \coloneqq X_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mn 0
                        %mo ,
                        %mo •
                    %mo ≔
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} D_{0,\bullet} \coloneqq Y_\bullet
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mrow
                          %mn 0
                          %mo ,
                          %mo •
                      %mo ≔
                      %msub
                        %mi f
                        %mo •
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi D
                        %mrow
                          %mn 1
                          %mo ,
                          %mo •
                      %mo →
                      %msub
                        %mi D
                        %mrow
                          %mn 0
                          %mo ,
                          %mo •
                    %annotation{:encoding => "application/x-tex"} \partial_{0,\bullet} \coloneqq f_\bullet \colon D_{1,\bullet} \to D_{0,\bullet}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} D_{\bullet, \bullet}
              is also a model for the mapping cone of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cone(f) \simeq tot(D_{\bullet,\bullet})
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              One checks by inspection that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} tot(D_{\bullet,\bullet}) = Cone(\tilde f)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde f\colon X_\bullet \to Y_\bullet
              for which there is a
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⇒
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \Rightarrow f'
              (given only by multiplication by signs).
          %p
            This appears for instance as (
            %a{:href => "#Weibel"}> Weibel, Exercise 1.2.8
            ).
          %h3#InCochainComplexes For cochain complexes
          %p
            We spell out the situation in more detail in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cochain+complexes"} category of cochain complexes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be some
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete
            %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch^\bullet(\mathcal{A})
            the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi V
                    %mo •
                  %mo →
                  %msup
                    %mi W
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  f : V^\bullet \to W^{\bullet}
          %p a morphism, the mapping cone is the complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo →
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mrow
                                  %mi Cone
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi ⋯
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≔
                          %mrow
                            %mo (
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi ⋯
                                    %mo →
                                  %mtd
                                    %msup
                                      %mi V
                                      %mi k
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %msub
                                          %mi d
                                          %mi V
                                  %mtd
                                    %msup
                                      %mi V
                                      %mrow
                                        %mi k
                                        %mo +
                                        %mn 1
                                  %mtd
                                    %mo →
                                    %mi ⋯
                                %mtr
                                  %mtd
                                  %mtd
                                    %mo ⊕
                                  %mtd
                                    %msup
                                      %mo ↘
                                      %mrow
                                        %msup
                                          %mi f
                                          %mi k
                                  %mtd
                                    %mo ⊕
                                %mtr
                                  %mtd
                                    %mi ⋯
                                    %mo →
                                  %mtd
                                    %msup
                                      %mi W
                                      %mrow
                                        %mi k
                                        %mo −
                                        %mn 1
                                  %mtd
                                    %munder
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi d
                                          %mi W
                                  %mtd
                                    %msup
                                      %mi W
                                      %mi k
                                  %mtd
                                    %mo →
                                    %mi ⋯
                            %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Cone(f)
                  \&amp; \coloneqq
                  (\cdots \to Cone(f)^{k-1} \stackrel{d_{Cone(f)}}{\to} Cone(f)^k) \to \cdots)
                  \\\
                  \&amp; \coloneqq
                  \\left(
                  \\array{
                  \\cdots \to &amp; V^k &amp;\stackrel{- d_V}{\to}&amp; V^{k+1} &amp; \to \cdots
                  \\\
                  \&amp; \oplus &amp;\searrow^{f^k}&amp; \oplus
                  \\\
                  \\cdots \to &amp; W^{k-1} &amp;\underset{d_W}{\to}&amp; W^k &amp; \to \cdots
                  }
                  \\right)
                  \\end{aligned}
                  \\,.
          %p
            There is a canonical co
            %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                          %mo{:stretchy => "false"} ↑
                        %mtd
                          %msub
                            %mo ⇙
                            %mi η
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi W
                        %mtd
                          %mover
                            %mo ←
                            %mi f
                        %mtd
                          %mi V
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Cone(f) &amp;\leftarrow&amp; 0
                  \\\
                  {}^{\mathllap{i}}\uparrow &amp;\swArrow_{\eta}&amp; \uparrow
                  \\\
                  W &amp;\stackrel{f}{\leftarrow}&amp; V
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi W
                  %mo →
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i : W \to Cone(f)
            is the canonical inclusion, componentwise given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mi k
                  %mo :
                  %msup
                    %mi W
                    %mi k
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mi Id
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi V
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo ⊕
                  %msup
                    %mi W
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  i^k : W^k \stackrel{(0,Id)}{\to} V_{k+1} \oplus W^k
          %p
            and where the cochain homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            has components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi η
                    %mi k
                  %mo :
                  %msup
                    %mi V
                    %mi k
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Id
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                  %mo =
                  %msup
                    %mi V
                    %mi k
                  %mo ⊕
                  %msup
                    %mi W
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\eta^k : V^k \stackrel{(Id,0)}{\to} Cone(f)^{k-1} = V^k \oplus W^{k-1}
          %p
            which we denote on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msup
                    %mi V
                    %mi k
                %annotation{:encoding => "application/x-tex"} v \in V^k
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi v
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta : v \mapsto (f(v))[1]
                  \\,.
          %p The fact that this is a cochain homotopy means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi i
                  %mo ∘
                  %mi f
                  %mo −
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  [d,\eta] = i \circ f - 0
                  \\,,
          %p
            which we check on any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msup
                    %mi V
                    %mi k
                %annotation{:encoding => "application/x-tex"} v \in V^k
            by computing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi d
                          %mo ,
                          %mi η
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi d
                            %mrow
                              %mi Cone
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi η
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi V
                          %mi v
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi d
                            %mrow
                              %mi Cone
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi V
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mrow
                            %mo (
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mi W
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi W
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  [d, \eta](v) &amp;=
                  d_{Cone(f)} \circ \eta (v)
                  + \eta(d_V v)
                  \\\
                  \&amp; = d_{Cone(f)} (f(v)[1]) + (f(d_V v))[1]
                  \\\
                  \&amp; =
                  \\left(
                  f(v)
                  \-
                  (d_{W}f(v))[1]
                  \\right)
                  +
                  (d_W (f(v)))[1]
                  \\\
                  \&amp; = f(v)
                  \\end{aligned}
                  \\,,
          %p
            where we used the above definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d_{Cone(f)}
            and the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a chain homomorphism and hence intertwines the differentials.
          %p This cochain homotopy is universal in that for any other cochain homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo ←
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi j
                          %mo{:stretchy => "false"} ↑
                        %mtd
                          %msub
                            %mo ⇙
                            %mi ρ
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi W
                        %mtd
                          %mover
                            %mo ←
                            %mi f
                        %mtd
                          %mi V
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\leftarrow&amp; 0
                  \\\
                  {}^{\mathllap{j}}\uparrow &amp;\swArrow_{\rho}&amp; \uparrow
                  \\\
                  W &amp;\stackrel{f}{\leftarrow}&amp; V
                  }
          %p hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ∘
                  %mi f
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  j \circ f = [d,\rho]
          %p we have a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  (j,\rho) :  Cone(f) \to X
          %p
            given on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            and on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi ρ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo :
                  %msup
                    %mi V
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo ⊕
                  %msup
                    %mi W
                    %mi k
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ρ
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  (j,\rho)^k : V^{k+1} \oplus W^k \stackrel{(\rho, j)}{\to} X^k
          %p
            which is indeed a cochain homomorphism because for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo +
                  %mi w
                  %mo ∈
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v + w \in Cone(f)
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi d
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo ,
                          %mi ρ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo +
                          %mi w
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi d
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi ρ
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo +
                          %msub
                            %mi d
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mi d
                          %mo ,
                          %mi ρ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi ρ
                          %msub
                            %mi d
                            %mi V
                          %mi v
                          %mo +
                          %mi j
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi W
                          %mi w
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi j
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi ρ
                          %msub
                            %mi d
                            %mi V
                          %mi v
                          %mo +
                          %mi j
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mrow
                              %mi Cone
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi w
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo ,
                          %mi ρ
                          %mo{:stretchy => "false"} )
                          %msub
                            %mi d
                            %mrow
                              %mi Cone
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo +
                          %mi w
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  d_X (j,\rho)(v + w)
                  \&amp; =
                  d_X (\rho v) +  d_X (j(w))
                  \\\
                  \&amp; = [d,\rho](v) - \rho d_V v + j (d_W w)
                  \\\
                  \&amp; = j f (v) - \rho d_V v + j (d_{Cone(f)} w)
                  \\\
                  \&amp; = (j,\rho) d_{Cone(f)}(v + w)
                  \\end{aligned}
          %p
            and which is unique with the property that
            %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo ←
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi j
                          %mo{:stretchy => "false"} ↑
                        %mtd
                          %msub
                            %mo ⇙
                            %mi ρ
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi W
                        %mtd
                          %mover
                            %mo ←
                            %mi f
                        %mtd
                          %mi V
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mo ↖
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo ,
                                %mi ρ
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                          %mo{:stretchy => "false"} ↑
                        %mtd
                          %msub
                            %mo ⇙
                            %mi η
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi W
                        %mtd
                          %mover
                            %mo ←
                            %mi f
                        %mtd
                          %mi V
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\leftarrow&amp; 0
                  \\\
                  {}^{\mathllap{j}}\uparrow &amp;\swArrow_{\rho}&amp; \uparrow
                  \\\
                  W &amp;\stackrel{f}{\leftarrow}&amp; V
                  }
                  \\;\;\;\;\;
                  \=
                  \\;\;\;\;\;
                  \\array{
                  X
                  \\\
                  \&amp; \nwarrow^{\mathrlap{(j,\rho)}}
                  \\\
                  \&amp;&amp;  Cone(f) &amp;\leftarrow&amp; 0
                  \\\
                  \&amp;&amp; {}^{\mathllap{i}}\uparrow &amp;\swArrow_{\eta}&amp; \uparrow
                  \\\
                  \&amp;&amp; W &amp;\stackrel{f}{\leftarrow}&amp; V
                  }
          %p hence that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi i
                %annotation{:encoding => "application/x-tex"}
                  j = (j,\rho) \circ i
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi η
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho = (j,\rho) \circ \eta
                  \\,.
          %h3#in_additive_categories_with_translation In additive categories with translation
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
            %a.existingWikiWord{:href => "/nlab/show/category+with+translation"} with translation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi 𝒜
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T=[1] : \mathcal{A} \to \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be two
            %a.existingWikiWord{:href => "/nlab/show/differential+objects"} differential objects
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{A},T)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            any
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The
            %strong mapping cone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cone(f)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is the
            %a.existingWikiWord{:href => "/nlab/show/differential+object"} differential object
            whose underlying object is the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                  %mo ⊕
                  %mi Y
                %annotation{:encoding => "application/x-tex"} T X \oplus Y
            and whose differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi cone
                      %mi f
                  %mo :
                  %mi T
                  %mi X
                  %mo ⊕
                  %mi X
                  %mo →
                  %mi T
                  %mi T
                  %mi X
                  %mo ⊕
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} d_{cone f} : T X \oplus X \to T T X \oplus T X
            is given in
            %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
            notation by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi cone
                      %mi f
                  %mo :
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi T
                                %mi X
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi d
                              %mi Y
                    %mo )
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi T
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi d
                              %mi Y
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{cone f} :=
                  \\left(
                  \\array{
                  d_{T X} &amp; 0
                  \\\
                  T(f) &amp; d_Y
                  }
                  \\right)
                  \=
                  \\left(
                  \\array{
                  \- T(d_X) &amp; 0
                  \\\
                  T(f) &amp; d_Y
                  }
                  \\right)
                  \\,.
          %p
            Notice the minus sign here, coming from the definition of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+object"} shifted differential object
          %h2#properties Properties
          %h3#HomologyExactSequencesAndFiberSequences Homology exact sequences and fiber sequences
          %p
            We discuss the relation between mapping cones in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories+of+chain+complexes"} categories of chain complexes
            = succeed "," do
              %a{:href => "#InChainComplexes"} above
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+in+homology"} long exact sequences in homology
            = succeed "." do
              %em
                %a{:href => "long+exact+sequence+in+homology#RelationToHomotopyFiberSequences"} Relation to homotopy fiber sequences
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi X
                    %mo •
                  %mo ⟶
                  %msub
                    %mi Y
                    %mo •
                %annotation{:encoding => "application/x-tex"} f : X_\bullet \longrightarrow Y_\bullet
            be a
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} cone(f) \in Ch_\bullet(\mathcal{A})
            for its mapping cone as explicitly given in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ComponentsOfMappingConeInChainComplexes"}
          #ProjectionOutOfChainComplexMappingCone.num_defn
            %h6#definition_8 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X[1]_\bullet \in Ch_\bullet(\mathcal{A})
              for the
              %a.existingWikiWord{:href => "/nlab/show/suspension+of+a+chain+complex"} suspension of a chain complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    p : cone(f) \to X[1]_\bullet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              which in components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                    %mo :
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    p_n : cone(f)_n \to X[1]_n
            %p
              is given, via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ComponentsOfMappingConeInChainComplexes"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                    %mo :
                    %msub
                      %mi Y
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_n : Y_\n \oplus X_{n-1} \to X_{n-1}
                    \\,.
          #ProjectionOutOfChainComplexMappingConeIsHoCofiber.num_prop
            %h6#proposition_9 Proposition
            %p
              The chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} p : cone(f)_\bullet \to X[1]_\bullet
              represents the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of the canonical map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %msub
                        %mi Y
                        %mo •
                      %mo →
                      %mi cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} i : Y_\bullet \to cone(f)_\bullet
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#InclusionIntoChainComplexCone"}
              and def.
              %a.maruku-ref{:href => "#ProjectionOutOfChainComplexMappingCone"}
              the sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                    %mover
                      %mo →
                      %mi i
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mover
                      %mo →
                      %mi p
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    Y_\bullet
                    \\stackrel{i}{\to}
                    cone(f)_\bullet
                    \\stackrel{p}{\to}
                    X[1]_\bullet
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of chain complexes (since it is so degreewise, in fact degreewise it is even a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
              %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %mover
                              %mo ↪
                              %mi i
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y_\bullet &amp;\stackrel{i}{\hookrightarrow}&amp; cone(f)_\bullet
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; X[1]_\bullet
                    }
                    \\,.
            %p
              Now, in the
              %a.existingWikiWord{:href => "/nlab/show/injective+model+structure+on+chain+complexes"} injective model structure on chain complexes
              all chain complxes are
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              and an inclusion such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi Y
                      %mo •
                    %mo ↪
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} i : Y_\bullet \hookrightarrow cone(f)_\bullet
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              this means that the ordinary colimit here is in fact a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          #HomotopyCofiberSequenceOfChainMap.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : X_\bullet \to Y_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mo •
                    %msub
                      %mi Y
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mo •
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mo •
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                    %msub
                      %mi Y
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet
                    \\stackrel{f_\bullet}{\to}
                    Y_\bullet
                    \\stackrel{i_\bullet}{\to}
                    cone(f)_\bullet
                    \\stackrel{p_\bullet}{\to}
                    X[1]_\bullet
                    \\stackrel{f[1]_\bullet}{\to}
                    Y_\bullet
                    \\stackrel{i[1]_\bullet}{\to}
                    cone(f)_\bullet
                    \\stackrel{p[1]_\bullet}{\to}
                    X[2]_\bullet
                    \\to
                    \\cdots
          %p
            In order to compare this to the discussion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphisms"} connecting homomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo •
                %annotation{:encoding => "application/x-tex"} f_\bullet
            happens to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            by the map into its
            %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %msub
                    %mi Y
                    %mo •
                  %mover
                    %mo →
                    %mo ≃
                  %mi cyl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet \to Y_\bullet \stackrel{\simeq}{\to} cyl(f)
                  \\,.
          %p
            By the axioms on an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            in this case we have a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mi X
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi f
                        %mo •
                  %msub
                    %mi Y
                    %mo •
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mo •
                  %msub
                    %mi Z
                    %mo •
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0 \to X_\bullet \stackrel{f_\bullet}{\to} Y_\bullet \stackrel{p_\bullet}{\to} Z_\bullet \to 0
          %p
            of chain complexes. The following discussion revolves around the fact that now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} cone(f)_\bullet
            as well as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mo •
                %annotation{:encoding => "application/x-tex"} Z_\bullet
            are both models for the homotopy cofiber of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          #ConeInjectionEquivalentToZigzag.num_lemma
            %h6#lemma Lemma
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mo •
                    %msub
                      %mi Y
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mo •
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet \stackrel{f_\bullet}{\to} Y_\bullet \stackrel{p_\bullet}{\to} Z_\bullet
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            %p The collection of linear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi n
                    %mo :
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    h_n : Y_n \oplus X_{n-1} \to Y_n \stackrel{}{\to} Z_n
            %p
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mo •
                    %mo :
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h_\bullet : cone(f)_\bullet \to Z_\bullet
                    \\,.
            %p
              This is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi h
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(h_\bullet)
              is given by sending a representing
              %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} z \in Z_n
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo ,
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊕
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\hat z_n, \partial^Y \hat z_n) \in Y_n \oplus X_{n+1}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \hat z_n
              is any choice of lift through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p_n
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \partial^Y \hat z_n
              is the formula expressing the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              in terms of elements, as discussed at
              = succeed "." do
                %a{:href => "connecting%20homomorphism#OnHomologyInTermsOfElements"} Connecting homomorphism – In terms of elements
            %p
              Finally, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo •
                    %mo :
                    %msub
                      %mi Y
                      %mo •
                    %mo →
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} i_\bullet : Y_\bullet \to cone(f)_\bullet
              is eqivalent in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Z
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; cone(f)_\bullet
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{h}}_{\mathrlap{\simeq}}
                    \\\
                    Y_\bullet &amp;\to&amp; Z_\bullet
                    }
                    \\,.
          %p
            In the literature this appears for instance as (
            %a{:href => "#Schapira"}> Schapira, cor. 7.2.2
            ).
          .proof
            %h6#proof_7 Proof
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mo •
                  %annotation{:encoding => "application/x-tex"} h_\bullet
              defines a chain map recall the differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial^{cone(f)}
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ComponentsOfMappingConeInChainComplexes"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi X
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo +
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^{cone(f)} (x_{n-1}, \hat z_n)
                    \=
                    (  -\partial^X x_{n-1} , \partial^Y \hat z_n + x_{n-1} )
            %p
              and use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x_{n-1}
              is in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p_n
              by exactness, hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi h
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msup
                              %mo ∂
                              %mrow
                                %mi cone
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mo ∂
                              %mi X
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo +
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi p
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo +
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi p
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mo ∂
                              %mi Z
                            %msub
                              %mi p
                              %mi n
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mo ∂
                              %mi Z
                            %msub
                              %mi h
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h_{n-1}\partial^{cone(f)}(x_{n-1}, \hat z_n)
                    \&amp;=
                    h_{n-1}( -\partial^X x_{n-1}, \partial^Y \hat z_n + x_{n-1}  )
                    \\\
                    \&amp; = p_{n-1}( \partial^Y \hat z_n + x_{n-1})
                    \\\
                    \&amp; = p_{n-1}( \partial^Y \hat z_n )
                    \\\
                    \&amp; = \partial^Z p_n \hat z_n
                    \\\
                    \&amp; = \partial^Z h_n(x_{n-1}, \hat z_n)
                    \\end{aligned}
                    \\,.
            %p
              It is immediate to see that we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mo •
                            %mo ↗
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Z
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; cone(f)_\bullet
                    \\\
                    \&amp; {}^{\mathllap{i_\bullet}}\nearrow&amp; \downarrow^{\mathrlap{h}}_{\mathrlap{\simeq}}
                    \\\
                    Y_\bullet &amp;\to&amp; Z_\bullet
                    }
            %p
              since the composite morphism is the inclusion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              followed by the bottom morphism on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              Abstractly, this already implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"} cone(f)_\bullet \to Z_\bullet
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %a.existingWikiWord{:href => "/nlab/show/cocones"} cocones
              under the diagram defining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cone(f)
              in prop.
              %a.maruku-ref{:href => "#HomotopyCofiberByFactorizationLemma"}
              and by the above both of these cocones are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy-colimiting
            %p But in checking the claimed inverse of the induced map on homology groups, we verify this also explicity:
            %p
              We first determine those cycles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (x_{n-1}, y_n) \in cone(f)_n
              which lift a cycle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} z_n
              %a.maruku-ref{:href => "#HomotopyCofiberByFactorizationLemma"}
              a lift of chains is any pair of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_{n-1}, \hat z_n)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \hat z_n
              is a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} z_n
              through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mi n
                      %mo →
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Y_n \to X_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x_{n-1}
              has to be found such that this pair is a cycle. By prop.
              %a.maruku-ref{:href => "#ComponentsOfMappingConeInChainComplexes"}
              the differential acts on it by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi X
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo +
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^{cone(f)} (x_{n-1}, \hat z_n)
                    \=
                    (  -\partial^X x_{n-1} , \partial^Y \hat z_n + x_{n-1} )
            %p and so the condition is that
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x_{n-1} \coloneqq -\partial^Y \hat z_n
              (which implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi X
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi X
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi Y
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^X x_{n-1} = -\partial^X \partial^Y \hat z_n = -\partial^Y \partial^Y \hat z_n = 0
              due to the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
              is assumed to be an inclusion, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \partial^X
              is the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \partial^Y
              to elements in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X_n
            %p
              This condition clearly has a unique solution for every lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \hat z_n
              and a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \hat z_n
              always exists since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                    %mo :
                    %msub
                      %mi Y
                      %mi n
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p_n : Y_n \to Z_n
              is surjective, by assumption that we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of chain complexes. This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi h
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(h_\bullet)
              is surjective.
            %p
              To see that it is also injective we need to show that if a
              %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo ,
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (-\partial^Y \hat z_n, \hat z_n) \in cone(f)_n
              maps to a cycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi n
                    %mo =
                    %msub
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} z_n = p_n(\hat z_n)
              that is trivial in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(Z)
              in that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} c_{n+1}
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi Z
                      %msub
                        %mi c
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo =
                      %msub
                        %mi z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \partial^Z c_{n+1} = z_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n, y_{n+1})
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mrow
                        %mi cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi X
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo ,
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^{cone(f)}(x_n, y_{n+1})
                    \\coloneqq
                    (-\partial^X x_n, \partial^Y y_{n+1} + x_n)
                    \=
                    (-\partial^Y \hat z_n, \hat z_n)
                    \\,.
            %p
              For that let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∈
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat c_{n+1} \in Y_{n+1}
              be a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} c_{n+1}
              through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} p_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} p_{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi z
                      %mi n
                    %mo −
                    %msup
                      %mo ∂
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi n
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi z
                      %mi n
                    %mo −
                    %msup
                      %mo ∂
                      %mi Z
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    p_{n}( \hat z_n -  \partial^Y \hat c_{n+1})
                    \=
                    z_n -\partial^Z ( p_n \hat c_{n+1} )
                    \=
                    z_n - \partial^Z ( c_{n+1} )
                    \=
                    0
            %p
              by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} z_n
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} c_{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat z_n - \partial^Y \hat c_{n+1}
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              by exactness.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mi n
                    %mo −
                    %msup
                      %mo ∂
                      %mi Y
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (z_n - \partial^Y \hat c_{n+1}, \hat c_{n+1}) \in cone(f)_n
              trivializes the given cocycle:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mo ∂
                              %mrow
                                %mi cone
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo −
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mo ∂
                              %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo −
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo +
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo −
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mo ∂
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo −
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mo ∂
                              %mi Y
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo ,
                            %msub
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ^
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\partial^{cone(f)}( \hat z_n - \partial^Y \hat c_{n+1}  , \hat c_{n+1})
                    \&amp; =
                    (-\partial^X(\hat z_n - \partial^Y \hat c_{n+1} ), \partial^Y \hat c_{n+1} + (\hat z_n - \partial^Y \hat c_{n+1} ) )
                    \\\
                    \&amp; = (-\partial^Y(\hat z_n - \partial^Y \hat c_{n+1}),  \hat z_n )
                    \\\
                    \&amp; =
                    ( -\partial^Y \hat z_n, \hat z_n )
                    \\end{aligned}
                    \\,.
          .num_theorem
            %h6#theorem Theorem
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mo •
                    %msub
                      %mi Y
                      %mo •
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet \stackrel{f_\bullet}{\to} Y_\bullet \to Z_\bullet
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"}
                    H_n(-) : Ch_\bullet(\mathcal{A}) \to \mathcal{A}
            %p
              sends the homotopy cofiber sequence of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyCofiberSequenceOfChainMap"}
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
              induced by the given short exact sequence, hence to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi δ
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi δ
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X_\bullet)
                    \\to
                    H_n(Y_\bullet)
                    \\to
                    H_n(Z_\bullet)
                    \\stackrel{\delta}{\to}
                    H_{n-1}(X_\bullet)
                    \\to
                    H_{n-1}(Y_\bullet)
                    \\to
                    H_{n-1}(Z_\bullet)
                    \\stackrel{\delta}{\to}
                    H_{n-2}(X_\bullet)
                    \\to \cdots
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \delta_n
              is the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
          .proof
            %h6#proof_8 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#ConeInjectionEquivalentToZigzag"}
              the homotopy cofiber sequence is equivalen to the
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi h
                                  %mo{:stretchy => "false"} [
                                  %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mo •
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %mi Z
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi h
                                    %mo •
                        %mtr
