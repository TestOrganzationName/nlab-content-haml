                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 0
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hat X &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    Y^I &amp;\stackrel{d_1}{\to}&amp; Y
                    \\\
                    \\downarrow^{\mathrlap{d_0}}
                    \\\
                    Y
                    }
                    \\,.
            %p
              Take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              to be the composite vertical morphism in the above diagram, hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %msup
                      %mi Y
                      %mi I
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p \;\colon\; \hat X \to Y^I \stackrel{d_0}{\to} Y
                    \\,.
            %p
              To see that this is indeed a fibration, notice that, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi Id
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Y
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi d
                                  %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 0
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hat X
                    \&amp;\stackrel{}{\to}&amp;
                    X \times Y
                    \&amp;\stackrel{p_1}{\to}&amp;
                    X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(f, Id)}} &amp;&amp; \downarrow^\mathrlap{f}
                    \\\
                    Y^I &amp;\stackrel{(d_1 , d_0) }{\to}&amp;
                    Y \times Y &amp;\stackrel{p_1}{\to}&amp;
                    Y
                    \\\
                    \\downarrow^{\mathrlap{d_0}} &amp; \swarrow_{p_2}
                    \\\
                    Y
                    }
                    \\,.
            %p
              Both squares are pullback squares. Since pullbacks of fibrations are fibrations, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat X  \to X \times Y
              is a fibration. Similarly, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is assumed to be fibrant (as all objects in a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y \to Y
              is a fibration (see
              = succeed ")." do
                %a{:href => "category+of+fibrant+objects#SimpleConsequences"} here
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is thereby exhibited as the composite of two fibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                          %mtd
                            %mo :
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                            %mo →
                            %mi X
                            %mo ×
                            %mi Y
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi Id
                                %mo{:stretchy => "false"} )
                            %mi Y
                            %mo ×
                            %mi Y
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p &amp;: \hat X \to X \times Y
                    \\stackrel{(f ,Id)}{\to}
                    Y \times Y
                    \\stackrel{p_2}{\to}
                    Y
                    \\end{aligned}
                    \\,,
            %p (the first map being a pullback of a fibration as above, the composite of the second and the third map being the projection just menioned) it is itself a fibration.
            %p
              Next, by the
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
              of
              %a.existingWikiWord{:href => "/nlab/show/path+space+objects"} path space objects
              in a
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Y
                      %mi I
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} d_1 \;\colon\; Y^I \to Y
              is an acyclic fibration. Since these are stable under pullback, also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat X \to X
              is an acyclic fibration.
            %p
              But, by the axioms,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi I
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y^I \to Y
              has a right inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo →
                      %msup
                        %mi Y
                        %mi I
                    %annotation{:encoding => "application/x-tex"} Y \to Y^I
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              property this induces a right inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat X \to X
              fitting into a
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Y
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi Id
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; \hat X &amp;\to&amp; X
                    \\\
                    {}^{\mathrlap{f}}\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    Y &amp;\to&amp; Y^I &amp;\stackrel{d_1}{\to}&amp; Y
                    \\\
                    \&amp; {}_{\mathllap{Id}}\searrow&amp; \downarrow^{\mathrlap{d_0}}
                    \\\
                    \&amp;&amp; Y
                    }
                    \\,.
            %p This establishes the claim.
          %h5#homotopy_and_homotopy_pullback Homotopy and Homotopy pullback
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          .num_defn
            %h6#definition_8 Definition
            %p
              Two morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f,g : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(A,B)
              are
            %ul
              %li
                %p
                  %strong>
                    right
                    %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
                  , denoted
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ≃
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \simeq g
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mi f
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mover
                                  %mo →
                                  %mi η
                              %mtd
                                %msup
                                  %mi B
                                  %mi I
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mi g
                                %mo ↘
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi d
                                        %mn 1
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; B
                        \\\
                        \&amp; {}^f\nearrow &amp; \uparrow^{d_0}
                        \\\
                        A &amp;\stackrel{\eta}{\to}&amp;
                        B^I
                        \\\
                        \&amp; {}_g\searrow &amp; \downarrow^{\mathrlap{d_1}}
                        \\\
                        \&amp;&amp; B
                        }
                %p
                  for some
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi B
                            %mi I
                        %annotation{:encoding => "application/x-tex"} B^I
              %li
                %p
                  %strong>
                    %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
                  , denoted
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∼
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \sim g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mi w
                                %mo ∈
                                %mi W
                            %mo ↗
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                        %mtr
                          %mtd
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ^
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                          %mtd
                            %msup
                              %mi B
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi w
                                %mo ∈
                                %mi W
                            %mo ↘
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    A
                    \&amp;\stackrel{f}{\to}&amp; B
                    \\\
                    \&amp;{}^{w \in W}\nearrow&amp;&amp;&amp; \uparrow^{d_0}
                    \\\
                    \\hat A
                    \&amp;&amp;
                    \\stackrel{\eta}{\to}
                    \&amp;&amp;
                    B^I
                    \\\
                    \&amp;{}_{w\in W}\searrow &amp; &amp;&amp;
                    \\downarrow^{d_1}
                    \\\
                    \&amp;&amp;
                    A
                    \&amp;\stackrel{g}{\to}&amp;
                    B
                    }
            %p
              for some object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat A
              and for some
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} B^I
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p In view of this the following definition is natural.
          #HomotopyFiberProducts.num_defn
            %h6#definition_9 Definition
            %p
              A
              %strong homotopy fiber product
              or
              %strong homotopy pullback
              of two morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi u
                    %mi C
                    %mover
                      %mo ←
                      %mi v
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    A \stackrel{u}{\to} C \stackrel{v}{\leftarrow} B
            %p
              in a category of fibrant objects is the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times_C C^I \times_C B
              defined as the (ordinary)
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi C
                            %msup
                              %mi C
                              %mi I
                            %msub
                              %mo ×
                              %mi C
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi v
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi C
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times_C C^I \times_C B &amp;\longrightarrow&amp; &amp;\longrightarrow &amp; B
                    \\\
