              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo =
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
