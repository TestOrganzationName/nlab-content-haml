                  to an acyclic fibration);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi I
