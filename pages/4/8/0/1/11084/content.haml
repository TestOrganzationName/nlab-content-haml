          %h4#fibration_categories_and_the_factorization_lemma Fibration categories and the Factorization lemma
          %p
            We saw
            %a{:href => "#PrincipalBundlesViaSmoothGroupoids"} above
            that smooth
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            may naturally be understood in terms of pullbacks of the fibrant replacement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{E}G\to \mathbf{B}G
            of the point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}G
            along a Cech cocycle, regarded as a homomorphism of smooth groupoids.
          %p
            This is a special case of a very general construction of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            which will also apply, below, to
            %a{:href => "#WeakyPrincipalSimplicialBundles"} weakly principal simplicial bundles
            and then generally to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} principal infinity-bundles
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories+of+fibrant+objects"} categories of fibrant objects
          %h5#categories_of_fibrant_objects Categories of Fibrant objects
          #CategoryOfFibrantObjects.num_defn
            %h6#definition_7 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ul
              %li
                %p
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  that contains all
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi W
                        %mo ↪
                        %mi 𝒞
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Core(\mathcal{C}) \hookrightarrow W \hookrightarrow \mathcal{C}
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in Mor(W)
                  is called a
                  = succeed ";" do
                    %strong weak equivalence
              %li
                %p equipped with a further subcategory
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi F
                        %mo ↪
                        %mi 𝒞
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Core(\mathcal{C}) \hookrightarrow F \hookrightarrow \mathcal{C}
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in Mor(F)
                  is called a
                  %strong fibration
                %p
                  Those morphisms which are both weak equivalences and fibrations are called
                  %strong acyclic fibrations
                  \.
            %p This data has to satisfy the following properties:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  has
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} {\ast}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  of a fibration along an arbitrary morphism exists, and is again a fibration;
              %li
                %p
                  acyclic fibrations are preserved under
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %li
                %p
                  weak equivalences satisfy
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
              %li
                %p
                  for every object there exists a
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                %ul
                  %li
                    this means: for every object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                    there exists at least one object denoted
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi B
                            %mi I
                        %annotation{:encoding => "application/x-tex"} B^I
                    (not necessarily but possibly the
                    %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                    with an
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mover
                          %mo →
                          %mrow
                            %mi Id
                            %mo ×
                            %mi Id
                        %mi B
                        %mo ×
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mover
                          %mo →
                          %mi σ
                        %msup
                          %mi B
                          %mi I
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi d
                              %mn 0
                            %mo ×
                            %msub
                              %mi d
                              %mn 1
                        %mi B
                        %mo ×
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (B \stackrel{Id \times Id}{\to} B \times B)
                        \=
                        (B \stackrel{\sigma}{\to} B^I \stackrel{d_0 \times d_1}{\to} B \times B)
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  is a weak equivalence and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %mo ×
                        %msub
                          %mi d
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} d_0 \times d_1
                  is a fibration;
              %li
                %p
                  all objects are
                  = succeed "," do
                    %em fibrant
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} B \to {\ast}
                  to the terminal object are fibrations.
          #PreSmoothGroupoidsFormCategoryOfFibrantObjects.num_prop
            %h6#proposition_5 Proposition
            %p
              The category of pre-smooth groupoids (
              %a{:href => "geometry%20of%20physics%20--%20smooth%20homotopy%20types#PreSmoothGroupoids"}> here
              ) becomes a category of fibrant objects, def.
              %a.maruku-ref{:href => "#CategoryOfFibrantObjects"}
              with fibrations as in def.
              %a.maruku-ref{:href => "#FibrationOfSmoothGroupoids"}
              and weak equivalences the local weak equivalences (as defined
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+smooth+homotopy+types#LocalWeakEquivalence"} here
          %h5#factorization_lemma Factorization lemma
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            %em
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
            says the following.
          #FactorizationLemma.num_lemma
            %h6#lemma Lemma
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mi i
                    %mover
