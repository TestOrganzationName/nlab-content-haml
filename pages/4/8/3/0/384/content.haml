                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
