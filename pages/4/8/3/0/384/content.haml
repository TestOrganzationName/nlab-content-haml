            %p
              If here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} X = \emptyset
              is the
              %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
              then the result is a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ↪
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              built form “attaching cells to nothing”. This is then called just a
              %em
                topological
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              of countable hight.
            %p
              Finally, a topological (relative) cell complex of countable hight is called a
              %strong CW-complex
              if the
              = succeed "-st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi k
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_k \to X_{k+1}
              is entirely by
              = succeed "-cells," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
