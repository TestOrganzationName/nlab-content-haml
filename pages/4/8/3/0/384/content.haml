                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mn 2
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    X = X_{-1} \hookrightarrow X_0 \hookrightarrow X_1 \hookrightarrow X_2 \hookrightarrow \cdots
            %p such that
            %ol
              %li
                %p
