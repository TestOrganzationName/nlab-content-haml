                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                                %mo =
                                %msub
                                  %mi X
                                  %mn 0
                              %mtd
                                %mo ⟶
                              %mtd
                                %msub
