                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W \hookrightarrow Mor(\mathcal{C})
            declared to be “
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"}> weak equivalences
            ”, the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi W
                  %mi 𝒞
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  L_W \mathcal{C} \in (\infty,1)Cat
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            by universally turning each weak equivalence into an actual
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            in the sense of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            In particular let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi KanCplx
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(C^{op}, KanCplx)
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/stalk"} stalkwise
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            of Kan complexes. Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %msub
                    %mi Sh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi L
                    %mi W
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi KanCplx
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq Sh_{\infty}(C) \coloneqq L_{W} Func(C^{op}, KanCplx)
          %p
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            An
            = succeed "-object" do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in such an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(G)
            is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            is called an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            “with geometric structure as encoded by the test spaces
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+products"} homotopy fiber products
            of point inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} * \to X
            of any object X, the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                  %mo ≔
                  %mo *
                  %munder
                    %mo ×
                    %mi X
                  %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega X \coloneqq {*} \underset{X}{\times} {*}
                  \\,.
          %p
            In fact this are
            %em all
            the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            that there are, up to equivalence: forimg
            %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mover
                    %munderover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo ≃
                    %mover
                      %mo ←
                      %mi Ω
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  Grp(\mathbf{H})
                  \\stackrel{\overset{\Omega}{\leftarrow}}{\underoverset{\mathbf{B}}{\simeq}{\to}}
                  \\mathbf{H}^{*/}_{\geq 1}
          %p
            between
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            and
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/connected+object+in+an+%28%E2%88%9E%2C1%29-topos"} connected
            objects. The inverse equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            operation.
          %p
            We say that such an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesive"} cohesive
            if it is equipped with an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
            (co)/
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monads"} (∞,1)-monads
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                %th
                %th
                  %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                %th
                %th
                  %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            %tbody
              %tr
                %td{:style => "text-align: left;"} idemp. monad
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"} idemp. comonad
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"} idemp. monad
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \Pi
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                      %annotation{:encoding => "application/x-tex"} \sharp
          %p
            This implies (strictly speaking we need
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            for that, coming from another adjoint triple of (co)monads) that for every
            %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔾
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{G} \in Grp(\mathbf{H})
            there is a canonical object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}_{conn}
            which modulats
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
          %h3#higher_atiyah_groupoids Higher Atiyah groupoids
          %p
            Looking at the
            %a{:href => "#OrdinaryPrequantumGeometryInTermsofAutomorphismsInSlices"} above
            table and noticing the
            %a{:href => "#TheNeedForHigherPrequantumBundles"} above
            need for higher prequantum bundles, we should try to find an analogous table of concepts in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"}> slice
                \-
                %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-groups"} automorphism ∞-groups
                in
                %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/cohesive"} cohesive
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+%E2%88%9E-group"} quantomorphism ∞-group
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-bisections"} ∞-bisections
                    of
                    %a.existingWikiWord{:href => "/nlab/show/higher+Courant+groupoid"} higher Courant groupoid
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-bisections"} ∞-bisections
                    of
                    %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"}> L-∞ algebras
                    \:
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Heisenberg+L-%E2%88%9E+algebra"} Heisenberg L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Poisson+L-%E2%88%9E+algebra"} Poisson L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Courant+L-%E2%88%9E+algebra"} Courant L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"} twisted vector fields
          %p (…)
          %p
            The way all these notions and theorems work is by considering
            %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-groups"} automorphism ∞-groups
            of the classifying (or rather: modulating) maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}\mathbb{G}_{conn}
            of a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+%E2%88%9E-bundle"} prequantum ∞-bundle
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            over the domain. For instance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi QuantMorph
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munderover
                              %mo →
                              %mo ≃
                              %mi ϕ
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↘
                          %mtd
                            %mo ⇙
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mo ∇
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi 𝔾
                              %mi conn
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{QuantMorph}(\nabla)
                  \=
                  \\left\{
                  \\array{
                  X &amp;&amp; \underoverset{\simeq}{\phi}{\to} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\nabla}}\searrow &amp;\swArrow&amp; \swarrow_{\mathrlap{\nabla}}
                  \\\
                  \&amp;&amp; \mathbf{B}\mathbb{G}_{conn}
                  }
                  \\right\}
                  \\,.
          %p The others are obtained by succesively forgetting connection data. For instance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} BiSect
                  %mo{:stretchy => "false"} (
                  %mi Cou
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munderover
                              %mo →
                              %mo ≃
                              %mi ϕ
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mo ∇
                                    %mn 1
                            %mo ↘
                          %mtd
                            %mo ⇙
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ∇
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi 𝔾
                              %mi conn
                            %mo{:stretchy => "false"} )
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\BiSect(Cou(\nabla))
                  \=
                  \\left\{
                  \\array{
                  X &amp;&amp; \underoverset{\simeq}{\phi}{\to} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\nabla_1}}\searrow &amp;\swArrow&amp; \swarrow_{\mathrlap{\nabla_1}}
                  \\\
                  \&amp;&amp; \mathbf{B}(\mathbf{B}\mathbb{G}_{conn})
                  }
                  \\right\}
                  \\,.
