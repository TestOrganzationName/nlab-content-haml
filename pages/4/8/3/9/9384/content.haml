                        %mi FlatConn
                      %mrow
                        %mo (
                        %mo ∇
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\Omega \mathbb{G}\right)\mathbf{FlatConn}\left(\nabla\right)
                    \\to
