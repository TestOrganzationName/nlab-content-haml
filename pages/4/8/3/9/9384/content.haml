          %h3#the_central_theorem_quantomorphism_group_extensions
            The central theorem: Quantomorphism
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
              a
              %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}\mathbb{G}_{conn}
              a higher prequantum geometry with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
              there is a long
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi Ω
                      %mi 𝔾
                      %mo )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mrow
                      %mo (
                      %mo ∇
                      %mo )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi HamSympl
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo ∇
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
