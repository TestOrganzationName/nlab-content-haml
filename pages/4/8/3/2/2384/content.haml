              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_1,f_0)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f_1:[n_1] \to [n_1']
              is an order-preserving injection and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 0
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f_0:[n_0] \to [n_0']
              is an order-preserving function such that the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⪯
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c'(f_0(i)) \preceq c(i)
              holds in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ,
                    %mo ⪯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega,\preceq)
              for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi n
                        %mn 0
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} i \in [n_0]
          %p
            We define the
            %em
              category of segments over a preorder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ,
                    %mo ⪯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega,\preceq)
            as the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Seg
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Seg}(\Omega)
            whose objects are segments over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            and whose arrows are the morphisms of segments between them.
          %p
            We can show that if the preorder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mo ⪯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega,\preceq)
            defines a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Seg
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Seg}(\Omega)
            can be equipped with a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            structure.
          %h3#references References
          %p Ologs and biology:
          %ul
            %li
              JY Wong, J McDonald, M Taylor-Pinney,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Spivak"} DI Spivak
              = succeed "," do
                %em Materials by Design: Merging Proteins and Music
              %a{:href => "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3752788/"} link
            %li
              T. Giesa,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Spivak"} DI Spivak
              = succeed "," do
                %em Reoccurring patterns in hierarchical protein materials and music: The power of analogies
              %a{:href => "https://arxiv.org/pdf/1111.5297.pdf"} pdf
          %p Introductory material for categories of segments:
          %ul
            %li
              %p
                A
                %a{:href => "https://www.youtube.com/watch?v=l2PB9by6IBc"} talk
                by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kenny+Courser"} K Courser
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Remy+Tuyeras"}> R Tuyeras
                ,
                = succeed "," do
                  %em Category Theory for Genetics
                %a{:href => "https://arxiv.org/abs/1708.05255"} arXiv:1708.05255
          %h2#theories_and_models Theories and models
          %p
            This section presents category theoretic models taking the form of diagrams. These models can be either presented as functors with properties or as commutative diagrams. Common examples are models for a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limit+sketch"} limit sketch
          %h3#stockflow_diagrams_and_petri_nets Stock-flow diagrams and Petri nets
          %p
            In the spirit of
            %a.existingWikiWord{:href => "/nlab/show/David+Spivak"} Spivak's
            approach in encoding databases as functors over small categories, functors have been used to organize (and hence model) biological data. One example is that of stock-flow diagrams, which are defined as follows.
