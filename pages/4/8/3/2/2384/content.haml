                %path{:d => "M 74.734919 -64.505101 L 74.648411 -64.442186 ", :style => "fill:none;stroke-width:0.478;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.9934,0,0,-0.9934,13.344269,15.483132)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "49.843772", "xlink:href" => "#h8NW7f7MnLkKOR8JHjWdp_f7oMA=-glyph1-4", :y => "59.486779"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "20.215617", "xlink:href" => "#h8NW7f7MnLkKOR8JHjWdp_f7oMA=-glyph2-3", :y => "21.420684"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "20.215617", "xlink:href" => "#h8NW7f7MnLkKOR8JHjWdp_f7oMA=-glyph3-3", :y => "21.420684"}
                %path{:d => "M 74.734919 -64.505101 L 6.916222 -5.978199 ", :style => "fill:none;stroke-width:0.478;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.9934,0,0,-0.9934,13.344269,15.483132)"}
                %path{:d => "M 7.00273 -6.045046 L 6.916222 -5.978199 ", :style => "fill:none;stroke-width:0.478;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.9934,0,0,-0.9934,13.344269,15.483132)"}
          %p
            The previous diagram should be seen as a sketch specifying a structure in which there are
            %em links
            that go from a
            %em stock
            to a
            %em flow
            such that each
            %em flow
            goes from a
            %em stock
            to another
            = succeed "." do
              %em stock
          .num_defn
            %h6#definition_3 Definition
            %p
              We define a
              %em primitive stock-flow diagram
              as a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                  %annotation{:encoding => "application/x-tex"} \mathsf{H} \to \mathbf{FinSet}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{FinSet}
              is the category of finite sets and functions.
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              %em stock-flow diagram
              consists of primitive stock-flow diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                  %annotation{:encoding => "application/x-tex"} F:\mathsf{H} \to \mathbf{FinSet}
              and, for every element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} flow
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in F(\mathrm{flow})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi U
                          %mi x
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{U_x} \to \mathbb{R}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              denotes the finite fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi t
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(t)^{-1}(x)
          %p
            There is a notion of
            %em open
            stock-flow diagram that can be composed by using the composition of cospans. Stock-flow diagrams have been used to model
            %a{:href => "https://en.wikipedia.org/wiki/List_of_epidemics"} epidemics
            and more specifically
            = succeed "." do
              %a{:href => "https://en.wikipedia.org/wiki/COVID-19"} COVID-19
          %h3#pedigrads Pedigrads
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pedigrad"} pedigrad
            is a model for a limit sketch defined on a
            = succeed "." do
              %a{:href => "#CategoryOfSegments"} category of segments
            %a{:href => "https://en.wikipedia.org/wiki/Genomics"} genomic data
            and design algorithms to study them.
          %h3#references_2 References
          %p Stock-flow diagrams and petri nets:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> JC Baez
                , X Li, S Libkind, N Osgood and E Patterson,
                = succeed "," do
                  %em Compositional modeling with stock and flow diagrams
                %a{:href => "https://arxiv.org/abs/2205.08373"} arXiv:2205.08373
            %li
              %p
                A Baas, J Fairbanks, M Halter, S Libkind and E Patterson,
                = succeed "," do
                  %em An algebraic framework for structured epidemic modeling
                %a{:href => "https://arxiv.org/abs/2203.16345"} arXiv:2203.16345
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> JC Baez
                , BS Pollard,
                = succeed "," do
                  %em A Compositional Framework for Reaction Networks
                %a{:href => "https://arxiv.org/abs/1704.02051"} arXiv:1704.02051
          %p Pedigrads:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Remy+Tuyeras"}> R Tuyeras
                ,
                = succeed "," do
                  %em Category theory for genetics I: mutations and sequence alignments
                %a{:href => "http://www.tac.mta.ca/tac/volumes/33/40/33-40abs.html"} link
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Remy+Tuyeras"}> R Tuyeras
                ,
                = succeed "," do
                  %em Category theory for genetics II: genotype, phenotype and haplotype
                %a{:href => "https://arxiv.org/abs/1805.07004"} arXiv:1805.07004
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Remy+Tuyeras"}> R Tuyeras
                ,
                = succeed "," do
                  %em A category theoretical argument for causal inference
                %a{:href => "https://arxiv.org/abs/2004.09999"} arXiv:2004.09999
          %h2#adjunctions Adjunctions
          %p
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} Adjunctions
            have been used to model
            %a{:href => "https://en.wikipedia.org/wiki/Pathogen"} pathogens
            and
            = succeed "," do
              %a{:href => "https://en.wikipedia.org/wiki/Disease"} disease diagnoses
            = succeed "." do
              %a{:href => "https://en.wikipedia.org/wiki/Immune_response"} immune response
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            the set of immune responses and as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            the set pathogens and
            = succeed "." do
              %a{:href => "https://en.wikipedia.org/wiki/Signs_and_symptoms"} disease symptoms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to a subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo ⊆
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Q \subseteq \mathsf{Sub}(P) \times \mathsf{Sub}(I)
          %p
            We can complete this binary
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            into a functor of the following form.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi P
                  %msup
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi op
                  %mo ×
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Q: \mathsf{Sub}(P)^{\mathsf{op}} \times \mathsf{Sub}(I) \to \mathbf{2} = \{0 \leq 1\}.
          %p
            We can then define a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F:\mathsf{Sub}(I) \to \mathsf{Sub}(P)
            with the following specification.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                  %mo{:stretchy => "false"} {
                  %mi p
                  %mo{:stretchy => "false"} |
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  F(i) = \bigcup\{p| Q(p,i) = 1\}
          %p
            If the binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is defined such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            preserves
            %a.existingWikiWord{:href => "/nlab/show/meet"} meets
            (ie. intersections), then we can use the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            to define a left-adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L:\mathsf{Sub}(P) \to \mathsf{Sub}(I)
            for the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo{:stretchy => "false"} |
                  %mi p
                  %mo ⊆
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  L(p) = \bigcap\{i|p \subseteq F(i)\}
          %p
            The previous adjunction gives us a context in which we can reason about immune responses and their triggering pathogens and diseases. Further, the adjunction formalism ensures a certain
            %em continuity
            in time and space regarding the linking of diseases/pathogens to their immune response (as suggested in the following correspondence).
          %div{:style => "text-align: center"}
