                                  %mi j
                                  %mi l
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi k
                                %mi l
                            %mi g
                            %mo ⋅
                            %mi f
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi j
                                  %mn 1
                            %mi ⋯
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi j
                                  %mi l
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                            %mi ⋯
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi i
                                  %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left(
                    f \theta^{i_1}\cdots \theta^{i_k}
                    \\right)
                    \\left(
                    g \theta^{j_1}\cdots \theta^{j_l}
                    \\right)
                    \&amp; =
                    f \cdot g \; \theta^{i_1}\cdots \theta^{i_k} \theta^{j_1}\cdots \theta^{j_l}
                    \\\
                    \&amp; =
