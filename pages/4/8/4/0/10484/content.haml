                    C^\infty(\mathbb{R}^{p|q})
                    \\coloneqq
                    C^\infty(\mathbb{R}^p) \otimes_{\mathbb{R}} \wedge^\bullet\langle\theta^1, \cdots, \theta^q\rangle
            %p with the product given by the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %msup
                                %mi θ
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                              %mi ⋯
                              %msup
                                %mi θ
                                %mrow
                                  %msub
                                    %mi i
                                    %mi k
                              %mo )
                            %mrow
                              %mo (
                              %mi g
                              %msup
                                %mi θ
                                %mrow
                                  %msub
                                    %mi j
                                    %mn 1
                              %mi ⋯
                              %msup
                                %mi θ
                                %mrow
                                  %msub
                                    %mi j
                                    %mi l
                              %mo )
                          %mtd
                            %mo =
                            %mi f
                            %mo ⋅
                            %mi g
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                            %mi ⋯
                            %msup
                              %mi θ
                              %mrow
                                %msub
                                  %mi i
                                  %mi k
                            %msup
                              %mi θ
