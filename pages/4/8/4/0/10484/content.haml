                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
            is freely generated as a super-
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over the
            %a.existingWikiWord{:href => "/nlab/show/smooth+superalgebra"} smooth superalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^{p|q})
            by expressions of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mi k
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mi l
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}x^{a_1} \wedge \cdots \wedge \mathbf{d}x^{a_k} \wedge \mathbf{d}\theta^{\alpha_1} \wedge \cdots \wedge \mathbf{d}\theta^{\alpha_l}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo [
                    %mrow
                      %mo {
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi a
                            %mi k
                      %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi θ
                        %mrow
                          %msub
                            %mi α
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi θ
                        %mrow
                          %msub
                            %mi α
                            %mi l
                      %mo }
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(\mathbb{R}^{p|q})
                  \=
                  C^\infty(\mathbb{R}^{p|q})
                  \\left[
                  \\left\{
                  \\mathbf{d}x^{a_1} \wedge \cdots \wedge \mathbf{d}x^{a_k}
                  \\wedge
                  \\mathbf{d}\theta^{\alpha_1} \wedge \cdots \wedge \mathbf{d}\theta^{\alpha_l}
                  \\right\}
                  \\right]
                  \\,.
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            now carries the structure of a
          %ul
            %li differential graded-commutative graded commutative superalgebra
          %p which should be thought of as bracketed as follows
          %ul
            %li differential graded-commutative graded (commutative superalgebra).
          %p
            This means in effect that elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
            carry a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}_2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} grading
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                corresponds to the “cohomological grading”;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                corresponds to the super-grading.
          %p We write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  (n,\sigma)\in \mathbb{Z} \times \mathbb{Z}_2
          %p for elements in this grading group.
          %p
            In this notation the grading of the elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
            is all induced by the fact that the de Rham differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                %annotation{:encoding => "application/x-tex"} \mathbf{d}
            itself is a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi even
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,even)
          %table
            %thead
              %tr
                %th generator
                %th bi-degree
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mi a
                      %annotation{:encoding => "application/x-tex"} x^a
                %td{:style => "text-align: left;"} (0,even)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi θ
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \theta^\alpha
                %td{:style => "text-align: left;"} (0,odd)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \mathbf{d}
                %td{:style => "text-align: left;"} (1,even)
          %p Here the last line means that we have
          %table
            %thead
              %tr
                %th generator
                %th bi-degree
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mi a
                      %annotation{:encoding => "application/x-tex"} x^a
                %td{:style => "text-align: left;"} (0,even)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi θ
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \theta^\alpha
                %td{:style => "text-align: left;"} (0,odd)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %msup
                          %mi x
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \mathbf{d}x^a
                %td{:style => "text-align: left;"} (1,even)
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %msup
                          %mi θ
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \mathbf{d}\theta^\alpha
                %td{:style => "text-align: left;"} (1,odd)
          %p
            The formula for the “cohomologically- and super-graded commutativity” in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∧
                  %mi β
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi n
                        %mi α
                      %msub
                        %mi n
                        %mi β
                      %mo +
                      %msub
                        %mi σ
                        %mi α
                      %msub
                        %mi σ
                        %mi β
                  %mspace{:width => "thickmathspace"}
                  %mi β
                  %mo ∧
                  %mi α
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \wedge \beta
                  \=
                  \\;
                  (- 1)^{n_\alpha n_\beta + \sigma_\alpha \sigma_\beta}
                  \\;
                  \\beta \wedge \alpha
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ,
                  %mi β
                  %mo ∈
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha,  \beta \in \Omega^\bullet(\mathbb{R}^{p|q})
            of homogeneous
            = succeed "-degree." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}\times \mathbb{Z}_2
            %em two
            contributions to the sign picked up when exchanging two super-differential forms in the wedge product:
          %ol
            %li
              %p
                there is a “cohomological sign” which for commuting a
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} p_1
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} p_2
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                            %msub
                              %mi p
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} (-1)^{p_1 p_2}
            %li
              %p
                in addition there is a “super-grading” sich which for commuting a
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma_1
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_2
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mn 1
                            %msub
                              %mi σ
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} (-1)^{\sigma_1 \sigma_2}
          %p Some examples:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  x^{a_1} (\mathbf{d}x^{a_2}) = + (\mathbf{d}x^{a_2}) x^{a_1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mi α
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi a
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi θ
                    %mi α
                %annotation{:encoding => "application/x-tex"}
                  \\theta^\alpha (\mathbf{d}x^a) = + (\mathbf{d}x^a) \theta^\alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\theta^{\alpha_1} (\mathbf{d}\theta^{\alpha_2})
                  \=
                  \- (\mathbf{d}\theta^{\alpha_2}) \theta^{\alpha_1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d}x^{a_1}
                  \\wedge
                  \\mathbf{d} x^{a_2}
                  \=
                  \-
                  \\mathbf{d} x^{a_2}
                  \\wedge
                  \\mathbf{d} x^{a_1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi a
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mi α
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mi α
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi a
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d}x^a
                  \\wedge
                  \\mathbf{d} \theta^{\alpha}
                  \=
                  \-
                  \\mathbf{d}\theta^{\alpha}
                  \\wedge
                  \\mathbf{d} x^a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 1
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 2
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 2
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mrow
                      %msub
                        %mi α
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d}\theta^{\alpha_1}
                  \\wedge
                  \\mathbf{d} \theta^{\alpha_2}
                  \=
                  +
                  \\mathbf{d}\theta^{\alpha_2}
                  \\wedge
                  \\mathbf{d} \theta^{\alpha_1}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+G-space"} Euclidean G-space
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometries of physics
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
