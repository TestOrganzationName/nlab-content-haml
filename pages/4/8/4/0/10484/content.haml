              %p
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %li
              %p
                (
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} smooth Serre-Swan theorem
                ) The functor that assigns smooth
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                of smooth
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi SmthVectBund
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                      %mo ↪
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_X(-) \;\colon\; SmthVectBund_{/X} \hookrightarrow C^\infty(X) Mod
              %p
                is
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
                (its
                %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
                being the
                %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
                %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
                over the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          %p There is a third such magic algebraic property of smooth functions, which plays a role now:
          #DerivationsOfSmoothFunctions.num_defn
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"}> derivations of smooth functions are vector fields
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi der
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    der_X \;\colon\; \Gamma(T X) \longrightarrow Der(C^\infty(X))
            %p
              for the function that sends a smooth
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
              to the
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              given by forming
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi der
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} der_X(v)(f) \coloneqq v(f)
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
            %p
              Then this function is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi CAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} C^\infty(X) \in CAlg_{\mathbb{R}}
              comes from
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              along some smooth vector field, which is uniquely defined thereby.
          .proof
            %h6#proof Proof
            %p
              By the existence of
              %a.existingWikiWord{:href => "/nlab/show/partitions+of+unity"} partitions of unity
              we may restrict to the situation where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
              every
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
              may be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mi g
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f(x) = f(0) + \sum_i x_i g_i(x)
            %p
              for
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{g_i \in C^\infty(X)\}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_i(0) = \frac{\partial f}{\partial x_i}(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta : C^\infty(X) \to C^\infty(X)
              by definition satisfies the Leibniz rule, it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi i
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta(f)(0) = \sum_i \delta(x_i) \frac{\partial f}{\partial x_i}(0)
                    \\,.
            %p
              Similarly, by translation, at all other points. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is already fixed by its action of the coordinate functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mi i
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x_i \in C^\infty(X)\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                    %mo ∈
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_\delta \in T \mathbb{R}^n
              be the
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi i
                  %annotation{:encoding => "application/x-tex"}
                    v_\delta \coloneqq \sum_i \delta(x_i) \frac{\partial}{\partial x_i}
            %p
              then it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is the derivation coming from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi δ
                  %annotation{:encoding => "application/x-tex"} v_\delta
              under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_X(T X) \to Der(C^\infty(X))
          %p
            Recall further from
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+superalgebra"} geometry of physics – superalgebra
            that the category of
            %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
            is related to that of ordinary
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            by an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"} adjoint cylinder
            (
            %a{:href => "geometry+of+physics+--+superalgebra#InclusionOfCAlgIntosCAlg"}> this prop.
            ):
          #AdjointCylinderOnSuperAffines.num_prop
            %h6#proposition_2 Proposition
            %p
              The canonical inclusion of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              into
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
              is part of an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CAlg
                      %mi k
                    %munderover
                      %mo ↪
                      %munder
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi even
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi odd
                    %msub
                      %mi sCAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CAlg_k
                    \\underoverset
                    {\underset{(-)_{even}}{\longleftarrow}}
                    {\overset{(-)/(-)_{odd}}{\longleftarrow}}
                    {\hookrightarrow}
                    sCAlg_k
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of this statement is that
              %a.existingWikiWord{:href => "/nlab/show/affine+superschemes"} affine superschemes
              are related to ordinary
              %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              by an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"} adjoint cylinder
              of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ↪
                      %munder
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mover
                            %mover
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                              %mo ⇝
                            %mphantom
                              %mi A
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %munder
                            %mover
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                              %mo ⇉
                            %mphantom
                              %mi A
                          %mphantom
                            %mi AA
                    %mi Aff
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sVect
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aff(Vect_k)
                    \\underoverset
                    {\underset
                    {
                    \\phantom{AA}
                    \\overset
                    {\phantom{A}}
                    {\overset{\rightsquigarrow}{(-)}}
                    \\phantom{AA}
                    }
                    {\longleftarrow}
                    }
                    {\overset
                    {
                    \\phantom{AA}
                    \\underset
                    {\phantom{A}}
                    { \overset{\rightrightarrows}{(-)} }
                    \\phantom{AA}
                    }
                    {\longleftarrow}
                    }
                    {\hookrightarrow}
                    Aff(sVect_k)
                    \\,.
            %p
              (Beware that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \overset{\rightsquigarrow}{(-)}
              is the formal dual of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} (-)/(-)_{odd}
              while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ⇉
                  %annotation{:encoding => "application/x-tex"} \overset{\rightrightarrows}{(-)}
              is the formal dual of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                    %annotation{:encoding => "application/x-tex"} (-)_{even}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
              on top of
              %a.existingWikiWord{:href => "/nlab/show/right+adjoints"} right adjoints
              and the handedness of
              %a.existingWikiWord{:href => "/nlab/show/adjoints"} adjoints
              changes as we pass to
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
          %p
            The notation in prop.
            %a.maruku-ref{:href => "#AdjointCylinderOnSuperAffines"}
            is to serve as a convenient mnemonic for the nature of these functors:
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
          %ol
            %li
              %p
                a single
                %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
                is denoted by a solid arrow “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo →
                    %annotation{:encoding => "application/x-tex"} \to
                ” and the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ⇉
                    %annotation{:encoding => "application/x-tex"} \overset{\rightrightarrows}{(-)}
                produces a space whose
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
                is generated over smooth functions by the product of two fermionic functions
            %li
              %p
                a single
                %a.existingWikiWord{:href => "/nlab/show/boson"} boson
                is denoted by a wiggly arrow
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇝
                    %annotation{:encoding => "application/x-tex"} \rightsquigarrow
                and the functor denoted by this symbol produces a spaces whose
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
                contains only the bosonic smooth functions, no odd-graded functions.
          %p
            This highlights an important point: while the image of a
            %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
            under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇝
                %annotation{:encoding => "application/x-tex"} \rightsquigarrow
            is an ordinary
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} |
                          %mi q
                    %mo ⇝
                  %mo ≃
                  %msup
                    %mi ℝ
                    %mi p
                %annotation{:encoding => "application/x-tex"}
                  \\overset{\rightsquigarrow}{\mathbb{R}^{p\vert q}}
                  \\simeq
                  \\mathbb{R}^p
          %p
            its image under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mo ⇉
                %annotation{:encoding => "application/x-tex"} \overset{\rightrightarrows}{(-)}
            is a bosonic space, but not an ordinary manifold. For instance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi 𝒪
                          %mrow
                            %mo (
                            %mover
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mn 0
                                    %mo{:stretchy => "false"} |
                                    %mn 2
                              %mo ⇉
                            %mo )
                        %mtd
                          %mo =
                          %mi 𝒪
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mn 2
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi even
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∧
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mn 2
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi even
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mrow
                              %mo {
                              %msub
                                %mi a
                                %mn 0
                              %mo +
                              %msub
                                %mi a
                                %mn 1
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi θ
                                %mn 1
                              %mo +
                              %msub
                                %mi a
                                %mn 2
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi θ
                                %mn 2
                              %mo +
                              %msub
                                %mi a
                                %mn 12
                              %msub
                                %mi θ
                                %mn 1
                              %msub
                                %mi θ
                                %mn 2
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi a
                                %mo •
                              %mo ∈
                              %mi ℝ
                              %mspace{:width => "thinmathspace"}
                              %mo }
                            %mi even
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mrow
                            %mo {
                            %msub
                              %mi a
                              %mn 0
                            %mo +
                            %msub
                              %mi a
                              %mn 12
                            %msub
                              %mi θ
                              %mn 1
                            %msub
                              %mi θ
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi a
                              %mn 12
                            %mo ∈
                            %mi ℝ
                            %mspace{:width => "thinmathspace"}
                            %mo }
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi ℝ
                          %mo{:stretchy => "false"} [
                          %mi ϵ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ϵ
                            %mn 2
                          %mo =
                          %mn 0
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathcal{O}\left( \overset{\rightrightarrows}{\mathbb{R}^{0\vert 2}}\right)
                  \&amp; =
                  \\mathcal{O}(\mathbb{R}^{0\vert 2})_{even}
                  \\\
                  \&amp; =
                  (\wedge^\bullet(\mathbb{R}^2)^\ast)_{even}
                  \\\
                  \&amp;=
                  \\left\{a_0 + a_1 \, \theta_1 + a_2 \, \theta_2 + a_{12} \theta_1 \theta_2 \,\vert a_\bullet \in \mathbb{R}\,\right\}_{even}
                  \\\
                  \&amp;=
                  \\left\{a_0  + a_{12} \theta_1 \theta_2 \,\vert a_{12} \in \mathbb{R}\,\right\}
                  \\\
                  \&amp;=
                  \\mathbb{R}[\epsilon]/(\epsilon^2 = 0)
                  \\end{aligned}
          %p
            where in the last line we renamed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mn 1
                  %msub
                    %mi θ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \theta_1 \theta_2
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
          %p
            This algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϵ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}[\epsilon]/(\epsilon^2)
            is known as the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+dual+numbers"} algebra of dual numbers
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
            on a bosonic but
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
            %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            on it takes values “so tiny” that its square, which is bound to be even tinier, is actually indistinguishable from zero.
          %p In generalization of this we make the following definitions
          #FormalCartSp.num_defn
            %h6#definition_3 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi InfPoint
                    %mo ↪
                    %msubsup
                      %mi CAlg
                      %mi ℝ
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    InfPoint \hookrightarrow CAlg_{\mathbb{R}}^{op}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              on
              %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ⊕
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}\oplus V
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+ideal"} nilpotent ideal
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              these algebras ar called
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
              they are known as
              %strong
                local
                %a.existingWikiWord{:href => "/nlab/show/Artin+algebras"} Artin algebras
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p Write moreover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalCartSp
                    %mo ≔
                    %mi CartSp
                    %mo ⋊
                    %mi InfPoint
                    %mo ↪
                    %msubsup
                      %mi CAlg
                      %mi ℝ
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    FormalCartSp \coloneqq CartSp \rtimes InfPoint \hookrightarrow CAlg_{\mathbb{R}}^{op}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on
              %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
              of those algebras which are
              %a.existingWikiWord{:href => "/nlab/show/tensor+products"} tensor products
              of commutative
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(\mathbb{R}^n) \otimes C^\infty(D)
            %p
              of algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^p)
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              with algebras corresponding to infinitesimally thickened points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as above.
          %p
            This kind of construction is traditionally more familiar from the theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+schemes"} formal schemes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          %p
            The crucial property of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FormalCartSp"}
            %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/jets"} jets
          .num_example
            %h6#example Example
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔻
                      %mn 1
                    %mo =
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^1 = Spec(\mathbb{R}[\epsilon]/(\epsilon^2))
              for the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+dual+numbers"} algebra of dual numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \times \mathbb{D}\longrightarrow \mathbb{R}^n
            %p
              which are the identity after restriction along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo →
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \to \mathbb{R}^n \times \mathbb{D}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi ϵ
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (C^\infty(\mathbb{R}^n) \oplus \epsilon C^\infty(\mathbb{R}^n))
                    \\longleftarrow
                    C^\infty(\mathbb{R}^n)
            %p
              which are the identity modulo
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"}
                    f + (\partial f) \epsilon
            %p
              for some smooth function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\partial f) \in C^\infty(\mathbb{R}^n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_1,f_2 \in C^\infty(\mathbb{R}^n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %msub
                      %mi f
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_1 f_2 + (\partial (f_1 f_2))\epsilon )
                    \=
                    (f_1 + (\partial f_1) \epsilon)
                    (f_2 + (\partial f_2) \epsilon)
                    \\,.
            %p
              Multiplying this out and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon^2 = 0
              this in turn is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi f
                      %mn 2
                    %mo +
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial(f_1 f_2) = (\partial f_1) f_2 + f_1 (\partial f_2)
                    \\,.
            %p
              This in turn means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
