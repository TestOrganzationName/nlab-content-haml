          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbf{k}
            be a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0 and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi k
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbf{k}^*
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                \-Drinfeld associator
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                \-associator
            %a.existingWikiWord{:href => "/nlab/show/grouplike+element"} grouplike element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(a,b)
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbf{k}
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            in two non-commuting
            %a.existingWikiWord{:href => "/nlab/show/variables"} variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            satisfying:
          %ol
            %li
              The pentagon equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 12
                      %mo ,
                      %msub
                        %mi t
                        %mn 23
                      %mo +
                      %msub
                        %mi t
                        %mn 24
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 13
                      %mo +
                      %msub
                        %mi t
                        %mn 23
                      %mo ,
                      %msub
                        %mi t
                        %mn 34
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 23
                      %mo ,
                      %msub
                        %mi t
                        %mn 34
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 12
                      %mo +
                      %msub
                        %mi t
                        %mn 13
                      %mo ,
                      %msub
                        %mi t
                        %mn 24
                      %mo +
                      %msub
                        %mi t
                        %mn 34
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 12
                      %mo ,
                      %msub
                        %mi t
                        %mn 23
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Phi(t_{12} , t_{23} + t_{24} )\Phi(t_{13} + t_{23} , t_{34} ) = \Phi(t_{23} , t_{34} )\Phi(t_{12} + t_{13} , t_{24} + t_{34} )\Phi(t_{12} , t_{23} )
              %p
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi L
                            %mn 4
                          %mo{:stretchy => "false"} )
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{U(L_4)}
            %li
              the hexagon equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi b
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\lambda a/2)\Phi(c,a)\exp(\lambda c/2)\Phi(b,c)\exp(\lambda b/2)\Phi(a,b)=1
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn 4
                %annotation{:encoding => "application/x-tex"} L_4
            is the fourth
            %a.existingWikiWord{:href => "/nlab/show/Drinfeld-Kohno+Lie+algebra"} Drinfeld-Kohno Lie algebra
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo −
                    %mi b
                  %annotation{:encoding => "application/x-tex"} c=-a-b
          .num_remark
            %h6#remark Remark
            %p
              The set of “0-associators” is what is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck-Teichmueller+group"} Grothendieck-Teichmueller group
          %h2#relations_with_braided_monoidal_categories Relations with braided monoidal categories
          %p
            These
            %a.existingWikiWord{:href => "/nlab/show/equations"} equations
            are modelled on the defining
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebraic
            data.
          %p
            Drinfeld associators are also used to construct
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-Hopf+algebra"} quasi-Hopf algebras
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{g},t)
              be a metrizable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              together with a non-degenerate symmetric
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is a
              = succeed "-associator" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              a formal variable, then the action of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ⊗
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℏ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ⊗
                        %mn 3
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi(\hbar (t \otimes 1),\hbar (1\otimes t)) \in U(\mathfrak{g})^{\otimes 3}[[\hbar]]
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mi ℏ
                        %mi λ
                        %mi t
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ∘
                    %mi P
                  %annotation{:encoding => "application/x-tex"} e^{\hbar \lambda t/2}\circ P
              turns the category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U(\mathfrak{g} ) [ [ \hbar ] ]
              module into a braided monoidal category, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the flip:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ⊗
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi b
                      %mo ⊗
                      %mi a
                    %annotation{:encoding => "application/x-tex"} P(a\otimes b)=b\otimes a
          .num_remark
            %h6#remark_2 Remark
            %p
              Examples of metrizable Lie algebras are provided by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simple+Lie+algebras"} simple Lie algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              is a scalar mutliple of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+group"} quantum group
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Drinfeld-Kohno+theorem"} Drinfeld-Kohno theorem
          %h2#existence Existence
          %p
            An explicit associator over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            was constructed by
            %a.existingWikiWord{:href => "/nlab/show/Drinfeld"} Drinfeld
            from the
            %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
            of a universal version of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+equation"} Knizhnik-Zamolodchikov equation
            %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
            under the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck-Teichmueller+group"} Grothendieck-Teichmueller group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Q
                %annotation{:encoding => "application/x-tex"} \mathbf{Q}
            also exists.
          %h2#applications Applications
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Drinfeld-Kohno+theorem"} Drinfeld-Kohno theorem
            %li
              %span.newWikiWord
                Etingof-Kazhdan quantization functor
                %a{:href => "/nlab/new/Etingof-Kazhdan+quantization+functor"} ?
            %li
              %span.newWikiWord
                Formality
                %a{:href => "/nlab/new/Formality"} ?
              of the
              %a.existingWikiWord{:href => "/nlab/show/little+2-disk+operad"} little 2-disk operad
            %li
              Construction of a functorial
              %span.newWikiWord
                universal finite type invariant
                %a{:href => "/nlab/new/universal+finite+type+invariant"} ?
            %li
              %a.existingWikiWord{:href => "/nlab/show/dilogarithm"} dilogarithm
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+series"}> Hausdorff series
              ,
              %a.existingWikiWord{:href => "/nlab/show/Kashiwara-Vergne+conjecture"} Kashiwara-Vergne conjecture
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Drinfeld"}> Vladimir Drinfeld
              \. On quasitriangular quasi-Hopf algebras and on a group that is closely connected with Gal(
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                      %mo ¯
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \overline{\mathbf{Q}}/\mathbf{Q}
              ).
              %em Leningrad Math. J.
              2:4 (1990), 829–860. (
              %a{:href => "http://mi.mathnet.ru/eng/aa199"}> mathnet.ru
              )
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
              \.
              %em On associators and the Grothendieck-Teichmuller group I.
              Selecta Math. (N.S.) 4:2 (1998), 183–212. (
              %a{:href => "https://www.math.toronto.edu/drorbn/papers/GT1/GT1.pdf"}> pdf
              )
            %li
              A. Alekseev, C. Torossian,
              = succeed "," do
                %em
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Kashiwara-Vergne+conjecture"} Kashiwara-Vergne conjecture
                  and Drinfeld’s associators
              = succeed ";" do
                %a{:href => "http://www.math.jussieu.fr/~torossian/AT1.pdf"} pdf
              %em Kontsevich deformation quantization and flat connections
              %a{:href => "https://arxiv.org/abs/0906.0187"} arxiv/0906.0187
              %a{:href => "https://doi.org/10.1007/s00220-010-1106-8"} doi
            %li
              A. Alekseev, B. Enriques, C. Torossian,
              = succeed "," do
                %em Drinfeld associators, braid groups and explicit solutions of the Kashiwara-Vergne equations
              %a{:href => "https://arxiv.org/abs/0903.4067"} arxiv/0903.4067
            %li
              %a.existingWikiWord{:href => "/nlab/show/Anton+Alekseev"}> Anton Alekseev
              , Florian Naef, Xiaomeng Xu, Chenchang Zhu,
              = succeed "," do
                %em Chern–Simons, Wess–Zumino and other cocycles from Kashiwara–Vergne and associators
