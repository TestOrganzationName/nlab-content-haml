            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CohesiveTopos"}
            %ol
              %li
                %p
                  %strong>
                    %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
                  \: For every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  = succeed "-transformation" do
                    %em comparison of extremes
                  %a.maruku-eqref{:href => "#eq:OppositeExtrmeComparison"} (?)
                  for the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi ʃ
                          %mo ,
                          %mo ⊣
                          %mo ♭
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (&amp;#643;, \dashv \flat)
