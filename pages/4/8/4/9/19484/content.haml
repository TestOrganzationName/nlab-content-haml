                    %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
                    of
                    %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
