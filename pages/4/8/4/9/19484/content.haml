                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                    %annotation{:encoding => "application/x-tex"} \simeq
                %a.existingWikiWord{:href => "/nlab/show/discrete+objects+are+concrete"} discrete objects are concrete
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                    %annotation{:encoding => "application/x-tex"} \simeq
