              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \Pi
                  preserves
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                %p
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                          %mo ,
