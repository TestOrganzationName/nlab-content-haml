          .proof
            %h6#proof Proof
            %p
              The existence of the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              means equivalently (by Example
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              (Example
              = succeed "):" do
                %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                      %mover
                        %mo ⟵
                        %mi p
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\ast
                    \\underoverset
                    {\underset{}{\hookrightarrow}}
                    {\overset{p}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              takes the unique object of the terminal category to that terminal object.
            %p
              From this it follows, by Example
              = succeed "," do
                %a.maruku-ref{:href => "#KanExtensionOfAdjointPairIsAdjointQuadruple"}
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              produces an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              (Remark
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointTriples"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo *
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} [\ast, Set] \simeq Set
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  is the operation of pre-composition with the terminal object inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                        %mo ↪
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \ast \hookrightarrow \mathcal{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Disc
                      %annotation{:encoding => "application/x-tex"} Disc
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
                  along the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                        %mo ↪
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \ast \hookrightarrow \mathcal{C}
                  of the terminal object.
            %p
              The former is manifestly the operation of evaluating on the terminal object. Moreover, since the terminal object inclusion is manifestly a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is fully faithful (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#LeftKanExtensionAlongFullyFaithfulFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              is fully faithful, by (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullyFaithfulAdjointTriple"}
            %p
              Equivalently,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
