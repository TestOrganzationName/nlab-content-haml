                            \\,.
          %p This definition is designed to make the following true:
          #CategoriesOfSheavesOnCohesiveSiteIsCohesive.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                on a
                %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
                is a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OneCohesiveSite"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              on the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
              (given that a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              by definition has
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/corestriction"} co-
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restricts
              from the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
              as a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#CohesiveTopos"}
            #eq:SheafToposAdjointQuadruple.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Π
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi Disc
                                %mphantom
                                  %mi AA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Γ
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi coDisc
                                %mphantom
                                  %mi AA
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Sh(\mathcal{C})
                    \\array{
                    \\overset{\phantom{AAA} \Pi \phantom{AAA}}{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} Disc \phantom{AA} }{\hookleftarrow}
                    \\\
                    \\overset{\phantom{AAA} \Gamma \phantom{AAA} }{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} coDisc \phantom{AA} }{\hookleftarrow}
                    }
                    Set
          .proof
            %h6#proof_2 Proof
            %p
              By example
              %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
              we alreaday have the analogous statement for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/categories+of+presheaves"} categories of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              from Example
              %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
              factor through the definition inclusion of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              the
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coDisc(S)
              are indeed
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Sheaf"}
            %p
              By the formulaton of the
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
              via the
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#CechGroupoidCoRepresents"}
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              hom-isomorphisms (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#eq:HomIsomorphismForAdjointFunctors"}> here
              ) this is readily seen to be equivalent to the two further conditions on a cohesive site (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#OneCohesiveSite"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              be a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family.
            %p
              The sheaf condition
              %a.maruku-eqref{:href => "#eq:SheafIsLocalObjectWithRespectToCechCovers"} (?)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mrow
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %msub
                                %mo{:stretchy => "false"} }
                                %mi i
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\left[
                    C(\{U_i\}) \overset{p_{\{U_i\}_i}}{\to} y(X)
                    \\,,\,
                    Disc(S)
                    \\right]
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %a.maruku-eqref{:href => "#eq:Pi0IsColimit"} (4)
              means equivalently that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %munder
                        %mi lim
                        %munder
                          %mo ⟶
                          %mrow
                            %msup
                              %mi 𝒞
                              %mi op
                      %mrow
                        %mo (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo →
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi S
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\left[
                    \\underset{\underset{\mathcal{C}^{op}}{\longrightarrow}}{\lim}
                    \\left( C(\{U_i\}) \right) \to
                    \\ast
                    \\,,\,
                    S
                    \\right]
            %p
              is an isomorphism of groupoids, where we used that colimits of representables are
              %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
              (Lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#ColimitOfRepresentableIsSingleton"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %munder
                          %mo ⟶
                          %mrow
                            %msup
                              %mi 𝒞
                              %mi op
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \underset{\underset{\mathcal{C}^{op}}{\longrightarrow}}{\lim} y(X) \simeq \ast
            %p
              But now in this
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is really a groupoid in the image of the
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective embedding
              of sets into groupoids, whose
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
