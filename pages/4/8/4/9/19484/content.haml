                      %semantics
                        %mrow
                          %mo ♭
                        %annotation{:encoding => "application/x-tex"} \flat
                  %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit of an adjunction
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composed
                  with the ʃ-
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %msubsup
                              %mi ϵ
                              %mi X
                              %mo ♭
                            %mphantom
                              %mi AA
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %msubsup
                              %mi ϵ
                              %mi X
                              %mi ʃ
                            %mphantom
                              %mi AA
                        %mi ʃ
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\flat X
                        \\overset{ \phantom{AA} \epsilon^\flat_X \phantom{AA} }{\longrightarrow}
                        X
                        \\overset{ \phantom{AA} \epsilon^&amp;#643;_X \phantom{AA} }{\longrightarrow}
                        \&amp;#643; X
                %p
                  is an
