            %li
              %p
                For a
                = succeed "," do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/multigraph"} multigraph
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
