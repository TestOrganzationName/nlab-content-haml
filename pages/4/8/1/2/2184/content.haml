                = succeed "(Oxford" do
                  %em Proceedings of the 6th International Workshop on Quantum Physics and Logic
                %a{:href => "https://arxiv.org/abs/0908.2675"} arXiv:0908.2675
            %li#Kock2016GHP
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
                , Graphs, hypergraphs, and properads,
                %em Collect. Math.
                67 (2016), 155-190.
                %a{:href => "https://arxiv.org/abs/1407.3744"} arXiv:1407.3744
            %li#Kock2016BM
              %p
