            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mo{:stretchy => "false"} [
                    %mi W
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F\subseteq [W]^2
          %p
            In particular, such a subgraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
