                      %mo{:stretchy => "false"} ]
                      %mn 2
                    %mo ∩
                    %mi E
                  %annotation{:encoding => "application/x-tex"} F = [W]^2\cap E
            %em induced
            subgraph must contain all edges
            %em induced
            within the ambient graph by the vertex set of the subgraph.
            %sup#fnref:2
              %a{:href => "#fn:2", :rel => "footnote"} 2
          %p
            Another usual notion of subgraph in combinatorics is
            %sup#fnref:3
              %a{:href => "#fn:3", :rel => "footnote"} 3
            %em spanning
            subgraph:
          %p
            this means just any subgraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W,F)
            in the above sense with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} W=V
            %span.newWikiWord
              Hamilton circuits
              %a{:href => "/nlab/new/Hamilton+circuit"} ?
            = succeed "," do
              %sup#fnref:4
                %a{:href => "#fn:4", :rel => "footnote"} 4
            %span.newWikiWord
              perfect matchings
              %a{:href => "/nlab/new/perfect+matching"} ?
            and
            = succeed "." do
              %span.newWikiWord
                spanning trees
                %a{:href => "/nlab/new/spanning+tree"} ?
          %p
            From the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
          %ul
            %li
              %p
                %em subgraphs
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monos"} monos
            %li
              %p
                %em induced subgraphs
                are
                %a.existingWikiWord{:href => "/nlab/show/regular+monos"} regular monos
          %p
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+simple+graphs"} category of simple graphs
          %p
            One synonym, in the nLab
            %sup#fnref:5
              %a{:href => "#fn:5", :rel => "footnote"} 5
            for
            %em induced subgraph
            is
            = succeed "," do
              %em full subgraph
            %em full
            in category theory (but also for more precise reasons).
          %p
            The precise meaning of
            %em subgraph
            depends on the chosen formalization of
            = succeed "," do
              %em graph
          %h2#undirected_graphs_as_1complexes_barycentric_subdivision Undirected graphs as 1-complexes, barycentric subdivision
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complex
            of dimension one consists of the data of a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            together with a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of non-empty subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of cardinality at most
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            subsets. In other words, a 1-dimensional simplicial complex is essentially the same thing as a simple graph, with the set of edges being determined by the set of simplices and vice versa:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} }
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} }
                  %mo ∈
                  %mi S
                  %mo ,
                  %mi x
                  %mo ≠
                  %mi y
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "2em"}
                  %mi S
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo ∈
                  %mi V
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  E = \{\{x,y\} \mid \{x,y\} \in S, x \ne y\}
                  \\qquad
                  S = \{\{x\} \mid x \in V\} \cup E
          %p
            For this reason, simple graphs are sometimes referred to as
            %strong simplicial graphs
            = succeed "." do
              %a{:href => "#GrossTucker"} (Gross &amp; Tucker 1987)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with loops or multiple edges can more generally be seen as a 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            (or more precisely, it has a
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi G
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |G|
            as a CW-complex in which 0-cells correspond to vertices and 1-cells to edges).
          %p
            Given a general undirected graph, it is always possible to obtain a simple graph through the process of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/barycentric+subdivision"} barycentric subdivision
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a graph with vertex set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and edge set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %strong barycentric subdivision
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ′
                %annotation{:encoding => "application/x-tex"} G'
            with vertex set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} V \cup E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v \in V
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} e \in E
            just in case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is incident to (i.e., at either end of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ′
                %annotation{:encoding => "application/x-tex"} G'
            contains no loops, while the two-fold barycentric subdivision
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ″
                %annotation{:encoding => "application/x-tex"} G''
            contains no loops or multiple edges, in other words is a simple graph. (More generally, the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \le n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planarity
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Betti+number"} Betti number
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em graph-theoretic
            properties are preserved. For example, barycentric subdivision always produces a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/bipartite+graph"} bipartite graph
          %h2#flavors_of_graphs Flavors of graphs
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/reflexive+graph"} reflexive graph
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
          %h2#lawveres_remarks_on_graph_theory Lawvere’s remarks on graph theory
          %p
            At the
            %a.existingWikiWord{:href => "/nlab/show/Como"} Como
            conference in 1990,
            %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
            gave a videotaped lecture including the following remarks:
          %blockquote
            %p#LawvreOnGraphTheory
              I have great problems reading books on graph theory, books and papers on graph theory, because they never tell you exactly what they are talking about. Sometimes the graphs are [word inaudible, even when played slower], sometimes they are absolutely reflexive, sometimes they are not. Even if they go so far as talking about homomorphisms, I still don’t know exactly what that is, i.e., which category are we in? What they should do is admit that they are working in three or four
              %em different
              categories and they don’t know how to pass from one to the other, and so on, and [inaudible words] to simplify.
              %br>/
              But no, they prefer to talk in a vague way and smushing these together. [inaudible] tried to understand some of the problems of graph theorists and get [bogged? locked?] in the first page. Does anybody actually know what a graph minor is? [some interjection from the audience] Graph minor. Big problem. (..) you see, this famous [inaudible works] problem on graph minors. Looks like that that might be interesting. But I can’t determine
              %em exactly
              what it is, because, if you read the first parts of the paper, they waffle, you see, they don’t give you a
              %em property
              (…) ([William Lawvere] in his 1990 lecture at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Como"} Como
          %h2#in_constructive_mathematics In constructive mathematics
          %p
            The notion of graph bifurcates in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          %ul
            %li
              %p
                The set of edges of a graph could be defined with a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                      %mo ×
                      %mi V
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo ≠
                      %mi y
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} E \coloneqq \{(x, y) \in V \times V \vert x \neq y\}
            %li
              %p
                The set of edges of a graph could be defined with a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                      %mo ×
                      %mi V
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} E \coloneqq \{(x, y) \in V \times V \vert x \# y\}
