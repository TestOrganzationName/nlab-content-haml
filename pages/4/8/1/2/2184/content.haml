          %h3#undirected_graphs Undirected graphs
          %p We are now ready for the first batch of definitions.
          %ul
            %li
              %p
                For a
                = succeed "," do
                  %strong simple graph
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                of
                %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
