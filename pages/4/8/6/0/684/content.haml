                                %mi B
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega_{pt}B &amp;\to&amp; [I,B]
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{d_0 \times d_1}
                  \\\
                  pt
                  \&amp;\stackrel{pt_B \times pt_B}{\to}&amp;
                  B \times B
                  }
                  \\,.
          %h4#remarks_2 Remarks
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi pt
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \Omega_{pt}B
                is the fiber of the
                %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi pt
                        %mi B
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \mathbf{E}_{pt}B \to B
            %li
              %p
                the based loop space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi pt
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \Omega_{pt} B
                is the pullback of the free loop space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \Lambda B
                to the point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Ω
                                %mi pt
                              %mi B
                            %mtd
                              %mo →
                            %mtd
                              %mi Λ
                              %mi B
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi pt
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi pt
                                    %mi B
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Omega_{pt} B &amp;\to&amp; \Lambda B
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      pt &amp;\stackrel{pt_B}{\to}&amp; B
                      }
                      \\,.
          %h2#remarks_3 Remarks
          %ul
            %li
              %p
                The loop space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                can be regarded as the homotopy trace on the identity span on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            %li
              %p
                The free loop space object inherits the structure of an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
                %a.existingWikiWord{:href => "/nlab/show/A-infinity-category"} category
                from that of the
                %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi I
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [I,B]
            %li
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} suitable extension
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Diff
                      %annotation{:encoding => "application/x-tex"} \operatorname{Diff}
                %strong not
                give the usual
                %em smooth
                loop space (free or based). It gives the space of paths with coincident endpoints rather than the space of smooth maps from the circle. Thus the
                %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
                is not a loop space object.
          %h2#examples Examples
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                    %annotation{:encoding => "application/x-tex"} C =
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                with the standard
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} B= X
                a topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mi B
                      %mo =
                      %mi Λ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Lambda B = \Lambda X
                is the ordinary free
                %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                The generalization of this to
                %em smooth
                spaces is discussed at
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                    %annotation{:encoding => "application/x-tex"} C =
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                with the standard interval object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mover
                        %mo →
                        %mo ≃
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} I = \{a \stackrel{\simeq}{\to} b\}
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                be the one-object groupoid corresponding to a group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo =
                      %mi G
                      %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi Ad
                      %mi G
                    %annotation{:encoding => "application/x-tex"}
                      \\Lambda \mathbf{B}G = G//_{Ad}G
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                acting on itself by its adjoint action. Notice the example at
                %a.existingWikiWord{:href => "/nlab/show/co-span+co-trace"} co-span co-trace
                which says that the cotrace on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cotr
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} cotr(I) = \mathbf{B}\mathbb{Z}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Lambda \mathbf{B}G =  [\mathbf{B}\mathbb{Z}, \mathbf{B}G]
                      \\,.
              %p
                The role of this
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \Lambda \mathbf{B}G
                as a loop object is amplified in particular in
              %ul
                %li
                  %p
                    Simon Willerton,
                    %em The twisted Drinfeld double of a finite group via gerbes and finite groupoids
                    (
                    %a{:href => "http://arxiv.org/abs/math.QA/0503266"}> arXiv
                    )
                %li
                  %p
                    Bruce Bartlett,
                    %em On unitary 2-representations of finite groups and topological quantum field theory
                    (
                    %a{:href => "http://arxiv.org/abs/0901.3975"}> arXiv
                    )
            %li
              %p
                On the other hand, the
                %em based
                loop object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                is just
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo =
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega \mathbf{B}G = G
                      \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong> loop space object
                ,
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              %p
                %a.existingWikiWord{:href => "/nlab/show/loop+space+type"} loop space type
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/delooping"}> delooping
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/loop+space"}> loop space
                    ,
