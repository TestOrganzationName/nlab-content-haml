          %h3#based_loop_space_objects Based loop space objects
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            with point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pt
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi pt
                        %mi B
                  %mi B
                %annotation{:encoding => "application/x-tex"} pt \stackrel{pt_B}{\to} B
            then the
            %strong based loop space object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is the pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi pt
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega_{pt} B
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi pt
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                              %mo ×
                              %msub
                                %mi d
                                %mn 1
                      %mtr
                        %mtd
                          %mi pt
                        %mtd
                          %mover
                            %mo →
