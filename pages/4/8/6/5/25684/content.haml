              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} outS
                  %annotation{:encoding => "application/x-tex"} \mathrm{outS}
              implicitly carries around the underlying proposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            %p
              For instance, in type theories with
              = succeed "," do
                %span.newWikiWord
                  coercive subtyping
                  %a{:href => "/nlab/new/coercive+subtyping"} ?
              %em stronger
              extension types into
              %em weaker
              ones using the composition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} inS
                  %annotation{:encoding => "application/x-tex"} \mathrm{inS}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} outS
                    %annotation{:encoding => "application/x-tex"} \mathrm{outS}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ,
                    %mi ϕ
                    %mo ⊢
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \Gamma, \phi \vdash \phi'
              to say that the proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi'
