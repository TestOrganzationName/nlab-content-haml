              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
            %p
              Hence for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi V
                      %mrow
                        %msub
                          %mi j
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} x \in V_{j_0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} y \in V_{j}
              there is a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
              connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              is compact and since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_i
              that covers the image of this path. This proves the claim.
            %p It follows that there is a function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒱
                    %mo ⟶
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; \mathcal{V} \longrightarrow \mathbb{N}
            %p
              which sends each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              to the
              %a.existingWikiWord{:href => "/nlab/show/minimum"} minimum
              natural number as above.
            %p
              We claim now that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1, \cdots, n\}
              under this function is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %a.existingWikiWord{:href => "/nlab/show/countable+unions+of+countable+sets+are+countable"} countable unions of countable sets are countable
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{ Cl(V_j) \subset X\}_{j \in J}
              is a countable cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by compact subspaces, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is sigma-compact.
            %p
              We prove this last claim by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              by construction. Assume it is true for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(\{0,1, \cdots, n\})
              is a finite set. Since finite unions of compact subspaces are again compact (
              %a{:href => "compact+space#UnionsAndIntersectionOfCompactSubspaces"}> this prop.
              ) it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                    %mo ≔
                    %munder
                      %mo ∪
                      %mrow
                        %mi V
                        %mo ∈
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    K_n
                    \\coloneqq
                    \\underset{V \in f^{-1}(\{0,\cdots, n\})}{\cup} V
            %p
              is compact. By local finiteness of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi j
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                    %annotation{:encoding => "application/x-tex"} \{V_j\}_{j \in J}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in K_n
              has an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi x
                  %annotation{:encoding => "application/x-tex"} W_x
              that intersects only a finite set of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi j
                    %annotation{:encoding => "application/x-tex"} V_j
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mi x
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi K
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \{W_x \subset X\}_{x \in K_n}
              has a finite subcover. In conclusion this implies that only a finite number of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              intersect
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
            %p
              Now by definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(\{0,1,\cdots, n+1\})
              is a subset of those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              which intersect
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
          %h3#topological_manifold Topological manifold
          #TopologicalManifold.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"}> topological manifold
                )
            %p
              A
              %em
                topological manifold is a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                which is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+space"} locally Euclidean
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LocallyEuclideanSpace"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+topological+space"}> paracompact Hausdorff
                  \.
            %p
              If the local
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean
              neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \overset{\simeq}{\to} U \subset X
              are all of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              for a fixed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-dimensional manifold
              or
              = succeed "." do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-fold
          .num_remark
            %h6#remark_2 Remark
            %p
              %strong (varying terminology)
            %p
              Often a topological manifold (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalManifold"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sigma-compact"} sigma-compact
              %a.maruku-ref{:href => "#RegularityConditionsForTopologicalManifoldsComparison"}
              this is not an extra condition as long as there is a
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
          %h3#differentiable_manifolds Differentiable manifolds
          #Charts.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+chart"} local chart
                and
                %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
            %p
              Given an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalManifold"}
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ChartsOfAManifold.png", :width => "400"}/
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mi n
                        %mover
                          %mo →
                          %mrow
                            %mphantom
                              %mi A
                            %mo ≃
                            %mphantom
                              %mi A
                        %mi U
                      %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^n \overset{\phantom{A}\simeq\phantom{A}}{\to} U
                  is also called a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/local+coordinate+chart"} local coordinate chart
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  by local charts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msup
                              %mi ℝ
                              %mi n
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi i
                            %mi U
                            %mo ⊂
                            %mi X
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \left\{ \mathbb{R}^n \overset{\phi_i}{\to} U \subset X \right\}_{i \in I}
                  is called an
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  of the topological manifold.
              %li
                %p
                  denoting for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i,j \in I
                  the
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                  of the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mo ≔
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                      %annotation{:encoding => "application/x-tex"}
                        U_{i j} \coloneqq U_i \cap U_j
                %p then the induced homeomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ⊃
                        %mphantom
                          %mi AA
                        %msubsup
                          %mi ϕ
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %msub
                              %mi ϕ
                              %mi i
                            %mphantom
                              %mi A
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %msubsup
                              %mi ϕ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mphantom
                              %mi A
                        %msubsup
                          %mi ϕ
                          %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mo{:stretchy => "false"} )
                        %mphantom
                          %mi AA
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{R}^n
                        \\supset
                        \\phantom{AA}
                        \\phi_i^{-1}(U_{i j})
                        \\overset{\phantom{A}\phi_i\phantom{A}}{\longrightarrow}
                        U_{i j}
                        \\overset{\phantom{A}\phi_j^{-1}\phantom{A}}{\longrightarrow}
                        \\phi_j^{-1}(U_{i j})
                        \\phantom{AA}
                        \\subset
                        \\mathbb{R}^n
                %p
                  is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
                  from chart
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  to chart
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
            %blockquote
              %p
                graphics grabbed from
                %a.existingWikiWord{:href => "/nlab/show/The+Geometry+of+Physics+-+An+Introduction"} Frankel
          #Differentiable.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N} \cup \{\infty\}
              then a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#TopologicalManifold"}
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi ℝ
                          %mi n
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n \overset{\phi_i}{\to} X\}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Charts"}
                  %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
                  are
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  times continuously
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable
            %p
              A
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              between
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mi f
                        %mphantom
                          %mi AA
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo ′
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ψ
                          %mi j
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X, \{\mathbb{R}^{n} \overset{\phi_i}{\to} U_i \subset X\}_{i \in I})
                    \\overset{\phantom{AA}f\phantom{AA}}{\longrightarrow}
                    (Y, \{\mathbb{R}^{n'} \overset{\psi_j}{\to} V_j \subset Y\}_{j \in J})
            %p is
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            %p such that
            %ul
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \in I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                      %annotation{:encoding => "application/x-tex"} j \in J
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ⊃
                        %mphantom
                          %mi AA
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ∘
                        %msub
                          %mi ϕ
                          %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mi f
                        %msub
                          %mi V
                          %mi j
                        %mover
                          %mo ⟶
                          %mrow
                            %msubsup
                              %mi ψ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo ′
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{R}^n
                        \\supset
                        \\phantom{AA}
                        (f\circ \phi_i)^{-1}(V_j)
                        \\overset{\phi_i}{\longrightarrow}
                        f^{-1}(V_j)
                        \\overset{f}{\longrightarrow}
                        V_j
                        \\overset{\psi_j^{-1}}{\longrightarrow}
                        \\mathbb{R}^{n'}
                %p
                  is a
                  = succeed "-fold" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                  between open subsets of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          %p
            Notice that this in in general a non-trivial condition even if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X = Y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is the identity function. In this case the above exhibits a passage to a different, but equivalent, differentiable atlas.
          %h2#properties Properties
          #OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              carries the structure of a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+differentiable+manifolds"} embedding of differentiable manifolds
          .proof
            %h6#proof_4 Proof
            %p
              Since the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              (
              %a{:href => "topological+manifold#LocalPropertiesOfLocallyEuclideanSpace"}> this prop.
              ) it is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (
              %a{:href => "locally+connected+topological+space#AlternativeCharacterizationsOfLocalConnectivity"}> this prop.
              ).
            %p
              Therefore we are reduced to showing the statement for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a single
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              %a{:href => "topological+manifold#RegularityConditionsForTopologicalManifoldsComparison"} this prop
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/second-countable+topological+space"} second-countable topological space
            %p
              Now a
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of a second-countable Hausdorff space is clearly itself second countable and Hausdorff.
            %p
              Similarly it is immediate that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is still
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is locally Euclidean every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in S \subset X
              has a Euclidean neighbourhood in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is open there exists an open ball in that (itself
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to Euclidean space) which is a Euclidean neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              For the differentiable structure we pick these Euclidean neighbourhoods from the given atlas. Then the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              for the Euclidean charts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h2#examples Examples
          %p
            See the examples at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/triangulation+theorem"} triangulation theorem
          %h2#references References
          %p Historical articles:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hellmuth+Kneser"}> Hellmuth Kneser
                ,
                = succeed "," do
                  %em Die Topologie der Mannigfaltigkeiten
                = succeed ")" do
                  %a{:href => "https://eudml.org/doc/145701"} eudml:145701
            %li
              %p
                J. W. Cannon,
                = succeed "," do
                  %em The recognition problem: What is a topological manifold?
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1090/S0002-9904-1978-14527-3"} doi:10.1090/S0002-9904-1978-14527-3
          %p Textbook accounts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+M.+Lee"}> John M. Lee
              ,
              = succeed "," do
                %em Introduction to topological manifolds
              = succeed "," do
                %strong 202
              %p
                Second edition: Springer (2011) &amp;lbrack;ISBN:978-1-4419-7939-1,
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-1-4419-7940-7"} doi:10.1007/978-1-4419-7940-7
                = succeed "&rbrack;" do
                  %a{:href => "https://sites.math.washington.edu/~lee/Books/ITM/errata.pdf"} pdf
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Topological_manifold"} Topological manifold
