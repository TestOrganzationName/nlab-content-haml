                = succeed "," do
                  %strong 22
                %a{:href => "http://dx.doi.org/10.1007/BF01077609"} doi
                (Rus. orig: функц. анализ и его приложения
                = succeed "," do
                  %strong 22
                = succeed ")" do
                  %a{:href => "http://www.mathnet.ru/php/getFT.phtml?jrnid=faa&paperid=1113&volume=22&year=1988&issue=2&fpage=69&what=fullt&option_lang=eng"} pdf
            %li
