                = succeed "\u2018s" do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Ranicki"} Andrew Ranicki
                %a{:href => "http://www.maths.ed.ac.uk/~aar/maslov.htm"} Maslov index seminar
                page.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Piccione"}> Paolo Piccione
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+V.+Tausk"} Daniel V. Tausk
                = succeed "," do
                  %em A student’s guide to symplectic spaces, Grassmannians and Maslov index
                = succeed "," do
                  %a{:href => "http://www.impa.br/opencms/pt/biblioteca/pm/PM_27.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/PiccioneTausk-SymplecticSpaces.pdf", :title => "pdf"} pdf
            %li
              %p
                M. V. Finkelberg,
                = succeed "," do
                  %em Orthogonal Maslov index
                %a{:href => "https://doi.org/10.1007/bf01077047"} doi
