                %a{:href => "http://opus.kobv.de/ubp/volltexte/2009/3021/pdf/2006_06.pdf"} pdf
            %li
              %p
                Leo T. Butler,
                = succeed "," do
                  %em The Maslov cocycle, smooth structures and real-analytic complete integrability
                %a{:href => "http://uk.arxiv.org/abs/0708.3157v2"} arxiv/0708.3157
            %li
              %p
                S. Merigon,
                = succeed "," do
                  %em L’indice de Maslov en dimension infinie
                %a{:href => "http://www.heldermann.de/JLT/JLT18/JLT181/jlt18010.htm"} J. Lie Theory 18
                (2008), no. 1, 161–180.
            %li
              %p
