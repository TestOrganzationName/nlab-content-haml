                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msubsup
                                  %mi p
                                  %mi m
                                  %mo *
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msubsup
                                %mi p
                                %mn 0
                                %mo *
                        %mtd
                          %msub
                            %mi X
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_{m+n} &amp;\stackrel{
                  p^*_{0,\cdots, m}
                  }{\to}&amp; X_m
                  \\\
                  {}^{\mathllap{p^*_{m, \cdots, m+n}}}\downarrow
                  \&amp;&amp; \downarrow^{\mathrlap{p^*_m}}
                  \\\
                  X_n &amp;\stackrel{p^*_0}{\to}&amp; X_0
                  }
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            square.
          %p
            A Segal space for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
          %h2#Examples Examples
          %h3#InSetByNervesOfCategories
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            a (
            %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
            )
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            we may regard its ordinary
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} N(\mathcal{C}) \in Set^{\Delta^{op}}
            as a Segal space, under the canonical inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo ↪
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Set \hookrightarrow \infty Grpd
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo ↪
                  %mn ∞
                  %msup
                    %mi Grpd
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N(\mathcal{C}) \in Set^{\Delta^{op}} \hookrightarrow \infty Grpd^{\Delta^{op}}
                  \\,.
          %p
            In fact, the classical “nerve theorem” about the
            %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
            says that a simplicial set is the nerve of a category precisely if it is a Segal space.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Equiv(N(\mathcal{C})_1) \hookrightarrow N(\mathcal{C})_1
            is precisely the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            in all
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            Therefore under this identification,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(\mathcal{C})
            is a
            %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
            precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gaunt+category"} gaunt category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identities"} identities
          %p
            In particular if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} (0,1)-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(\mathcal{C})
            is complete Segal precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is in fact an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
          %h3#ConstructionFromACategory
            Construction in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} 1Grpd
            from a category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be an ordinary category. We discuss how Segal spaces are associated with this.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"} \mathcal{K}
            be a
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒦
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} p \colon \mathcal{K} \to \mathcal{C}
            a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            which is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
          %p
            Then let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} X_1 \coloneqq (p/p)\in Grpd
            be the “lax fiber product” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            with itself, or rather the
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            with itself, hence the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∂
                                %mn 1
                        %mtd
                          %mi 𝒦
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mo ∂
                                  %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi 𝒦
                        %mtd
                          %munder
                            %mo →
                            %mi p
                        %mtd
                          %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_1 &amp;\stackrel{\partial_1}{\to}&amp; \mathcal{K}
                  \\\
                  {}^{\mathllap{\partial_0}}\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  \\mathcal{K} &amp;\underset{p}{\to}&amp; \mathcal{C}
                  }
                  \\,.
          %p
            Next let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 2
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_2 = (p/p/p)
            be the “3-fold comma category”, hence the comma category in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 2
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∂
                                %mn 0
                        %mtd
                          %mi 𝒦
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mo ∂
                                %mn 1
                        %mtd
                          %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_2 &amp;\stackrel{\partial_{0}}{\to}&amp; \mathcal{K}
                  \\\
                  {}^{\mathllap{}}\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  X_1 &amp;\underset{\partial_1}{\to}&amp; \mathcal{C}
                  }
          %p
            and so forth:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ≔
                    %msup
                      %mi p
                      %mrow
                        %msup
                          %mo{:stretchy => "false"} /
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} X_n \coloneqq p^{/^{n+1}}
          %p
            This way an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} X_n
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
            of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"} (x_0,x_1, \cdots, x_n) \in \mathcal{K}
            together with a sequence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            composable morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(x_0) \to p(x_1) \to \cdots \to p(x_n)
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            is an
            = succeed "-tuple" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 0
                  %mo ,
                  %msub
                    %mi f
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"} (f_0,f_1, \cdots, f_n) \in \mathcal{K}
            and a
            %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 0
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 1
                                %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi ⋯
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 1
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi x
                          %msub
                            %mo ′
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi x
                          %msub
                            %mo ′
                            %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  p(x_0) &amp;\to&amp; p(x_1) &amp;\to&amp;  \cdots &amp;\to&amp; p(x_1)
                  \\\
                  {}^{\mathllap{p(f_0)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p(f_1)}} &amp;&amp; \cdots   &amp;&amp; \downarrow^{\mathrlap{p(f_1)}}
                  \\\
                  p(x'_0) &amp;\to&amp; p(x_1) &amp;\to&amp; \cdots &amp;\to&amp; p(x'_1)
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            By direct inspection, the maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mi n
                %annotation{:encoding => "application/x-tex"} X_n \to X^{\partial \Delta^n}
            obtained this way are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isofibrations"} isofibrations
            %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
            in the
            %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"} canonical model structure
            on
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            and so the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            that enter the
            %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            are given by ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+products"} fiber products
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo ∈
                  %msup
                    %mi Grpd
                    %mi Δ
                  %mo ↪
                  %mn ∞
                  %msup
                    %mi Grpd
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet \in Grpd^{\Delta} \hookrightarrow \infty Grpd^{\Delta^{op}}
          %p constructed this way is a Segal space.
          %p
            Two special case of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            are important:
          %ul
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                      %mo ≃
                      %mi core
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{K} \simeq core(\mathcal{C})
                is the
                %a.existingWikiWord{:href => "/nlab/show/core"} core
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is the canonical core inclusion, one finds that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Equiv
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Equiv(X_1) \hookrightarrow X_1
                by the above construction is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Equiv
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msup
                              %mi Δ
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} Equiv(X_1) = Core(\mathcal{C})^{\Delta^1}
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                of the
                %a.existingWikiWord{:href => "/nlab/show/core"} core
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                by, for instance, the source or restriction map. Hence for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                the core inclusion, the above construction gives the
                %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
                corresponding to the category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} p \colon \pi_0(\mathcal{C}) \to \mathcal{C}
                is a choice of basepoints in each
                %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                is the
                %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
                incarnation of the category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#ExamplesInIGrpd
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} 1Grpd
          %p
            We consider the situation of
            = succeed "," do
              %em
                %a{:href => "#ConstructionFromACategory"} From a category
          %p
            Consider a Segal space that is degreewise just a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo ∈
                  %mn 1
                  %msup
                    %mi Grpd
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo ↪
                  %mn ∞
                  %msup
                    %mi Grpd
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet \in 1Grpd^{\Delta^{op}} \hookrightarrow \infty Grpd^{\Delta^{op}}
                  \\,.
          %p
            Choosing this to be
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mn 0
                  %mo ,
                  %msub
                    %mo ∂
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %msub
                    %mi X
                    %mn 0
                  %mo ×
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} (\partial_0,\partial_1) \colon X_1 \to X_0 \times X_0
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
          %p
            We may write an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ∈
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} K \in X_1
            as a horizontal morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi K
                  %msub
                    %mo ∂
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\partial_1(K) \stackrel{K}{\to} \partial_2(K)
          %p
            and a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi L
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} \lambda \colon L \to K
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X_1
            as a vertical
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            arrow:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mo ∂
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi L
                        %mtd
                          %msub
                            %mo ∂
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mo ∂
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mi λ
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ⇓
                            %mpadded{:width => "0"}
                              %mi λ
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mo ∂
                                  %mn 0
                                %mo{:stretchy => "false"} (
                                %mi λ
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mo ∂
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi K
                        %mtd
                          %msub
                            %mo ∂
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\partial_1(L) &amp; \stackrel{L}{\to} &amp; \partial_0(L)
                  \\\
                  {}^{\mathllap{\partial_1(\lambda)}}\downarrow &amp;\Downarrow^{\mathrlap{\lambda}}&amp; \downarrow^{\mathrlap{\partial_0(\lambda)}}
                  \\\
                  \\partial_1(K) &amp;\stackrel{K}{\to}&amp; \partial_0(K)
                  }
                  \\,.
          %p
            Then the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mn 1
                  %mo ,
                  %msub
                    %mo ∂
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\partial_1,\partial_0)
            is an
            %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
            means that for every “niche”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi y
                            %mn 0
                        %mtd
                        %mtd
                          %msub
                            %mi y
                            %mn 1
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mi K
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  y_0 &amp; &amp; y_1
                  \\\
                  {}^{\mathllap{f_0}}\downarrow
                  \&amp;&amp;
                  \\downarrow^{\mathrlap{f_1}}
                  \\\
                  x_0 &amp;\stackrel{K}{\to}&amp; x_1
                  }
                  \\,,
          %p
            namely for every pair of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 0
                  %mo ,
                  %msub
                    %mi f
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f_0, f_1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            and lift of its codomain to an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} K \in X_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi y
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mi L
                        %mtd
                          %msub
                            %mi Y
                            %mn 1
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ⇓
                            %mpadded{:width => "0"}
                              %mi λ
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mi K
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  y_0 &amp; \stackrel{L}{\to} &amp; Y_1
                  \\\
                  {}^{\mathllap{f_0}}\downarrow
                  \&amp;\Downarrow^{\mathrlap{\lambda}}&amp;
                  \\downarrow^{\mathrlap{f_1}}
                  \\\
                  x_0 &amp;\stackrel{K}{\to}&amp; x_1
                  }
                  \\,,
          %p
            namely a lift of the whole pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 0
                  %mo ,
                  %msub
                    %mi f
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f_0,f_1)
            to a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X_1
            is a groupoid).
          %p
            Comparison with the definition of a
            %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} 2-category equipped with proarrows
            in the incarnation
            %em
              %a{:href => "2-category+equipped+with+proarrows#DefinitionAsDoubleCategory"} as a double category
            shows that this is the beginning of the construction of a
            %a.existingWikiWord{:href => "/nlab/show/pseudo+double+category"} pseudo double category
            whose vertical category is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            and whose weak horizontal composition is that induced by the Segal maps.
          %p
            Assume next that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 3
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mn 2
                %annotation{:encoding => "application/x-tex"} X_3 \to X^{\partial \Delta^2}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %msup
                          %mi Δ
                          %mi n
                  %annotation{:encoding => "application/x-tex"} X^n \to X^{\partial \Delta^n }
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \geq 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            is
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
            as a simplicial object. This means that the horizontal composition in this pseudo double category has unique composites, hence that the horizontal category is an ordinary category. If then furthermore the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi X
                    %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ∂
                        %mn 0
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Equiv(X_1) \to X_1 \stackrel{\partial_0}{\to} X_0
            is an equivalence, hence is the Segal space is a
            %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
            this means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            arises from this horizontal category by the construction
            = succeed "." do
              %a{:href => "#ConstructionFromACategory"} above
          %h2#related_notions Related notions
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/reduced+Segal+space"}> reduced Segal space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/semi-Segal+space"} semi-Segal space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"}> complete Segal space
                ,
