          %h2#idea Idea
          %p
            According to the general pattern on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
            in which all
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            %em
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            and of an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            More precisely, this is the notion of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            up to
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/internal+category+in+an+%28%E2%88%9E%2C1%29-category"} internal category
                in
                = succeed "/basic" do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                (as such usually modeled as a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
            %li
              %p
                a category
                %a.existingWikiWord{:href => "/nlab/show/enriched+%28infinity%2C1%29-category"} homotopy enriched
                over
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                (as such usually modeled as a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
          %p
            Among all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-categories
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %p
                admit a
                %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher version
                of
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
                (
                %a.existingWikiWord{:href => "/nlab/show/limit"}> limit
                s,
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+and+topos+theory"} sheaf and topos theory
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+theory"} (infinity,1)-category theory
            %li
              %p
                and know everything about higher
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
          %p
            Notably, for understanding the collection of all
            %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-categories
            for arbitrary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
