                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
