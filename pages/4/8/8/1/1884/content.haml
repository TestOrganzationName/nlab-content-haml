                    \\;\colon\;
                    K(X) \oplus K(Y)
                    \\longrightarrow
                    K(X \times Y)
          %p
            We want to see that this restricts to an operation on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
          #ReducedKTheoryOfProductSpace.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong (reduced K-theory of product space)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y_0)
              be two
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              their
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \wedge Y
              their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K(X \times Y)
                    \\;\simeq\;
                    \\tilde K(X \wedge Y)
                    \\oplus
                    \\tilde{K}(X)
                    \\oplus
                    \\tilde K(Y)
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              Be definition, the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              by the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \wedge Y
                    \\;=\;
                    (X \times Y) / (X \vee Y)
            %p for the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ∨
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mi y
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi y
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \vee Y &amp;\overset{i}{\longrightarrow}&amp; X \times Y
                    \\\
                    x &amp;\mapsto&amp; (x, y_0)
                    \\\
                    y &amp;\mapsto&amp; (x_0, y)
                    }
                    \\,.
            %p
              This quotient is still a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              because
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              and and it is still
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              because
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+in+Hausdorff+spaces+are+separated+by+neighbourhoods+from+points"} compact subspaces in Hausdorff spaces are separated by neighbourhoods from points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X \vee Y)/ (X \vee Y) \in (X \times Y)/(X \vee Y)
              is separated by open neighbourhoods from points in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ∨
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \times Y) \setminus (X \vee Y)
            %p
              Hence corollary
              %a.maruku-ref{:href => "#LongExactSequenceInReducedTopologicalKTheory"}
              yields a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
