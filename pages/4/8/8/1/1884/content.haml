                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/universal+complex+line+bundle"} universal
            %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
