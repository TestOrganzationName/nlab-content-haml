                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/retractions"} retractions
              in that they factor the
              %a.existingWikiWord{:href => "/nlab/show/identity+maps"} identity maps
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
