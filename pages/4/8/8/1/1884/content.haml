            %p
              By functoriality (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctorialityOfReducedKGroups"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %mover
                          %mi K
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
