          .proof
            %h6#proof_13 Proof
            %p
              First consider the statement for reduced cohomology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
