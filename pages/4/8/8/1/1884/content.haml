                    \\,.
            %p
              This is known as the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bott+element"} Bott element
              %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
              of complex topological K-theory, discussed
              = succeed "." do
                %a{:href => "#BottPeriodicities"} below
          %p
            In order to describe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi K
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
            itself as an equivalence class, we consider the followign refinement of
            %a.existingWikiWord{:href => "/nlab/show/stable+equivalence+of+vector+bundles"} stable equivalence of vector bundles
            (def.
            = succeed "):" do
              %a.maruku-ref{:href => "#StableEquivalenceOfVectorBundles"}
          #EquivalenceRelationForReducedKTheory.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                for
                %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by declaring that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ∼
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_1 \sim E_2
              if there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo ,
                    %msub
                      %mi k
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k_1, k_2 \in \mathbb{N}
              such that there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              between the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              with the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} X \times \mathbb{R}^{k_1}
              and of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} X \times \mathbb{R}^{k_2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo ∼
                      %mi red
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %msub
                            %mi k
                            %mn 1
                          %mo ,
                          %msub
                            %mi k
                            %mn 2
                          %mo ∈
                          %mi ℕ
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %msub
                          %mo ⊕
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %msub
                          %mo ⊕
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (E_1 \sim_{red} E_2)
                    \\Leftrightarrow
                    \\left(
                    \\underset{k_1,k_2 \in \mathbb{N}}{\exists}
                    \\left(
                    (E_1 \oplus_X (X \times \mathbb{R}^{k_1})
                    \\;\simeq\;
                    (E_2 \oplus_X (X \times \mathbb{R}^{k_2})
