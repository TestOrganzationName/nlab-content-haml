                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              By remark
              %a.maruku-ref{:href => "#RestrictionInKTheoryToPointComputesVirtualRank"}
              the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi const
                      %mi x
                      %mo *
                  %annotation{:encoding => "application/x-tex"} const_x^\ast
              is identified with the
              %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
              of vanishing virtual rank. By prop.
              %a.maruku-ref{:href => "#OnCompactHausdorffVirtualVectorBundlesAreFormalDifferentcesWithATrivialBundle"}
              this kernel is identified with the elements of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %msub
                          %mi rk
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [E] - [X \times k^{rk_x(E)}]
                    \\,.
          #BottElement.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Bott+element"}> Bott element
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %msub
                      %mi Vect
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi K
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    h \in Vect_{\mathbb{C}}(S^2) \longrightarrow K_{\mathbb{C}}(S^2)
            %p
              for the complex topological K-theory class of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"} basic complex line bundle on the 2-sphere
              %a.maruku-ref{:href => "#KGrupDirectSummandReducedKGroup"}
              its image in
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              is the
              %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundle"} virtual vector bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi h
                    %mo −
                    %mn 1
                    %mo ∈
                    %msub
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
