                    \\oplus
                    \\mathbb{Z}
                    \\right)
                    \\,.
            %p
              Multiplying out and chasing through the constructions to see that this reduces to an isomorphism on the common summand
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \tilde K(S^2) \oplus \tilde{K}(X) \oplus \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mover
                        %mo ⊠
                        %mo{:stretchy => "false"} ˜
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn 2
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K(S^2) \otimes \tilde{K}(X)
                    \\underoverset{\simeq}{\tilde \boxtimes}{\longrightarrow}
                    \\tilde K(S^2 \wedge X)
                    \=
                    \\tilde K(\Sigma^2 X)
                    \\,,
            %p
              where on the right we used that
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              with the 2-sphere is the same as double
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            %p
              Finally there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mi β
                          %mtd
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mi ℂ
