                    %mo ∖
                    %mi X
                    %mo =
                    %mi Y
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (X \vee Y) \setminus X = Y \setminus \{y\}
              which is open because all points in a
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              (which is in particular
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separated
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
