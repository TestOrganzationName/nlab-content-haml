              %a.existingWikiWord{:href => "/nlab/show/cofiber+sequence"} cofiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi i
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo ∪
                    %mi Cone
