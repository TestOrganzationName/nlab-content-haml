                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\tilde K(S^2) \oplus \mathbb{Z}
                    \\right)
                    \\otimes
                    \\left(
                    \\tilde{K}(X) \oplus \mathbb{Z}
                    \\right)
                    \\;\simeq\;
                    \\left(
                    \\tilde K(S^2 \times X)
                    \\oplus
                    \\mathbb{Z}
                    \\right)
                    \\simeq
                    \\left(
                    \\tilde K(S^2 \wedge X)
                    \\oplus
