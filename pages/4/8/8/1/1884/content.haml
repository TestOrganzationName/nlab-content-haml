                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi ℤ
                            %mo ⊗
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mi ℂ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo ⟶
                              %mrow
                                %mi β
                                %mo ⊗
                                %mi id
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mi ℂ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
                              %mi ℂ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mover
                                %mo ⊠
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %msub
                              %mover
                                %mi K
                                %mo{:stretchy => "false"} ˜
