              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              (
              %a{:href => "quotient+space#QuotientBySubspace"}> this def.
              ). Denote the
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              of
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              inclusion and of
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              co-projection by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
