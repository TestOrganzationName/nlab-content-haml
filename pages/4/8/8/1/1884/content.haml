                  \\begin{aligned}
                  \\mu^\ast c_1^K
                  \&amp;\coloneqq
                  \\mu^\ast (\mathcal{O}(1) - 1)
                  \\\
                  \&amp; =
                  \\left(pr_1^\ast \mathcal{O}(1)\right)  \cdot  \left(pr_2^\ast \mathcal{O}(1)\right) - 1
                  \\\
                  \&amp;  =
