                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,U(n)]
          %p There is another variant on the classifying space
          #Uk.num_defn
            %h6#definition_16 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi 𝒦
                    %mo =
                    %mrow
                      %mo {
                      %mi g
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi ℋ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi g
                      %mo −
                      %mi id
                      %mo ∈
                      %mi 𝒦
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    U_{\mathcal{K}}
                    \=
                    \\left\{
                    g \in U(\mathcal{H}) | g - id \in \mathcal{K}
                    \\right\}
            %p
              be the group of unitary operators on a
              %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              which differ from the identity by a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+operator"} compact operator
          %p Palais showed that
          .num_prop
            %h6#proposition_15 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} U_\mathcal{K}
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalent
              model for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                    %annotation{:encoding => "application/x-tex"} B U
              %a.existingWikiWord{:href => "/nlab/show/norm+closure"} norm closure
              of the evident model of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B U
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi ℋ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(\mathcal{H})
            %p
              Moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi 𝒦
                    %mo ⊂
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_{\mathcal{K}} \subset U(\mathcal{H})
              is a
              %a.existingWikiWord{:href => "/nlab/show/Banach+Lie+group"} Banach Lie
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
