            %p
              In particular these maps are
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injections
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjections
            %p
              Therefore by prop.
              %a.maruku-ref{:href => "#ExactSequenceInReducedTopologicalKTheory"}
              there are
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\tilde{K}(X)
                    \\longrightarrow
                    \\tilde K(X \vee Y)
                    \\longrightarrow
                    \\tilde K(Y)
                    \\to
