              of the
              %a.existingWikiWord{:href => "/nlab/show/unstable+topological+K-theory"} unstable topological K-theory
              groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
