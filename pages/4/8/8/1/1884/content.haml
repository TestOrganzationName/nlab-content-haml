                  %annotation{:encoding => "application/x-tex"}
                    0 \to \tilde{K}(X) \overset{\phantom{AAA}}{\hookrightarrow} K(X) \overset{const_x^\ast}{\longrightarrow} K(\ast) \simeq \mathbb{Z}
