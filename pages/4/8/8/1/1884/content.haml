                  %annotation{:encoding => "application/x-tex"}
                    \\left(Vect(X)_{/\sim_{red}}, +\right)
                    \\,.
          #ReducedKEquivalenceRelationVerified.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              then the commutative
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi red
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Vect(X)_{/\sim_{red}}, +)
              from def.
              %a.maruku-ref{:href => "#EquivalenceRelationForReducedKTheory"}
              is already an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              and is in fact
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi red
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde{K}(X) \simeq (Vect(X)_{/\sim_{red}}, +)
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#KGrupDirectSummandReducedKGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
              is the subgroup of the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group+of+a+commutative+monoid"} Grothendieck group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X)
              on the elements of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi E
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mrow
                          %msub
                            %mi rk
                            %mi x
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [E]- [X \times k^{rk_x(E)}]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi E
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Vect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mo ∼
                    %annotation{:encoding => "application/x-tex"} [E] \in Vect(X)_{/\sim}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∼
                      %mi red
                  %annotation{:encoding => "application/x-tex"} \sim_{red}
              on these representatives.
            %p The relation in the Grothendieck group is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ∼
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mo ⇔
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mo{:stretchy => "false"} [
                          %mi H
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Vect
                          %mo{:stretchy => "false"} (
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mo ∼
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ×
                        %msup
                          %mi k
                          %mrow
                            %msub
                              %mi rk
                              %mi x
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ×
                        %msup
                          %mi k
                          %mrow
                            %msub
                              %mi rk
                              %mi x
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    [E_1]
                    \\sim
                    [E_2]
                    \\right)
                    \\Leftrightarrow
                    \\left(
                    \\underset{[G], [H] \in Vect(X)_{/\sim}}{\exists}
                    \\left(
                    ( [E_1]+ [G], [X \times k^{rk_x(E_1)}] + [G] )
                    \\;=\;
                    ( [E_2] + [H], [X \times k^{rk_x(E_2)}] + [H] )
                    \\right)
                    \\right)
            %p
              As before, in prop.
              %a.maruku-ref{:href => "#OnCompactHausdorffVirtualVectorBundlesAreFormalDifferentcesWithATrivialBundle"}
              we may assume without restriction that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} G = X \times k^{n_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} H = X \times k^{n_2}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [E_1] + [X \times k^{n_1}]
                    \=
                    [E_2] + [X \times k^{n_2}]
            %p
              is the one that defines
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∼
                        %mi red
                    %annotation{:encoding => "application/x-tex"} \sim_{red}
          .num_remark
            %h6#remark_7 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/non-unital+ring"} non-unital
                = succeed "-structure" do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi K
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
            %p
              In view of the
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              structure on the K-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X)
              from remark
              = succeed "," do
                %a.maruku-ref{:href => "#KTheoryRing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of a ring
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctorialityOfKGroup"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(X)
              %a.existingWikiWord{:href => "/nlab/show/non-unital+ring"} non-unital
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %p
              (The ring unit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X)
              is the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mn 1
                    %mo ,
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X \times k^1, X \times k^0]
              of the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
          %h3#TheRelativeKGroup The relative K-group
          #RelativeKTheory.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/relative+K-theory"}> relative K-theory
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A \subset X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
            %p
              Then the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/relative+K-theory"} relative K-theory
                  group of the pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X,A)
              is the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              group (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X/A
              (
              %a{:href => "quotient+space#QuotientBySubspace"}> this def.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K(X,A)
                    \\;\coloneqq\;
                    \\tilde K(X/A)
                    \\,.
          #RelatveKTheoryReducesToBareKTheoryAndToReducedKTheory.num_defn
            %h6#example_4 Example
            %p
              %strong (expressing plain and reduced K-theory in terms of relative K-theory)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/relative+K-theory"} relative K-theory
              construction from def.
              %a.maruku-ref{:href => "#RelativeKTheory"}
              reduces in special cases to the plain K-theory group and to the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              group.
            %p
              Recall that for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi ∅
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A = \emptyset \subset X
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi ∅
                    %mo =
                    %msub
                      %mi X
                      %mo +
                    %mo =
                    %mi X
                    %mo ⊔
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X/\emptyset = X_+ = X \sqcup \ast
              (by
              = succeed ")." do
                %a{:href => "quotient+space#QuotientBySubspace"} this example
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mi ∅
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A = \emptyset \subset X
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ∅
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi K
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊔
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(X,\emptyset) = \tilde K(X \sqcup \ast) \simeq K(X)
                  (example
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ExpressingPlainKTHeoryGroupInTermsOfReducedKTheoryGroup"}
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A = \{x\} \subset X
                  we have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mover
                            %mi K
                            %mo{:stretchy => "false"} ˜
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mover
                            %mi K
                            %mo{:stretchy => "false"} ˜
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} K(X, \{x\}) = \tilde K(X/\{x\}) = \tilde{K}(X)
          %h3#TheGradedKGroups The graded K-groups
          %p The (reduced) K-theory groups of reduced suspensions of pointed space are called the “K-group in degree 1”:
          #GradedKGroups.num_defn
            %h6#definition_8 Definition
            %p
              %strong (graded K-groups)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K^1(X)
                    \\;\coloneqq\;
                    \\tilde K(\Sigma X)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K^1(X,A)
                    \\coloneqq
                    \\tilde K( \Sigma(X/A) )
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            %p We say these are the K(-cohomology)-groups in degree 1. For emphasis one says that the original K-groups are in degree zero and writes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %msup
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %msup
                      %mi K
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K^0(X) \coloneqq K(X)
                    \\phantom{AAAA}
                    \\tilde K^0(X) \coloneqq \tilde{K}(X)
                    \\phantom{AAA}
                    K^0(X,A) \coloneqq K(X,A)
                    \\,.
            %p
              The groups are collected to the
              = succeed "," do
                %em graded K-groups
              %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K^\bullet(X)
                    \\coloneqq
                    \\tilde K^0(X) \oplus \tilde K^1(X)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi K
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi K
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo .
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K^\bullet(X,A)
                    \\coloneqq
                    K^0(X,A) \oplus K^1(X.A)
            %p
              regarded as
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              this becomes a non-unital
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+ring"} graded-commutative ring
              (discussed
              = succeed ")." do
                %a{:href => "#GradedRingStructure"} below
          %p
            Recall from example
            %a.maruku-ref{:href => "#ExpressingPlainKTHeoryGroupInTermsOfReducedKTheoryGroup"}
            and from example
            %a.maruku-ref{:href => "#RelatveKTheoryReducesToBareKTheoryAndToReducedKTheory"}
            the identifications of plain, reduced and relative K-groups, which with the degree-zero notation from def.
            %a.maruku-ref{:href => "#GradedKGroups"}
            read:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi K
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K^0(X, \emptyset)
                  \\simeq
                  \\tilde K^0(X_+)
                  \\simeq
                  K^0(X)
          %p
            The analogue is true for the K-groups in degree 1 from def.
            = succeed "," do
              %a.maruku-ref{:href => "#GradedKGroups"}
          %h3#ForNonCompactSpaces For non-compact spaces
          %p
            By prop.
            %a.maruku-ref{:href => "#OnCompactHausdorffVirtualVectorBundlesAreFormalDifferentcesWithATrivialBundle"}
            the topological K-theory groups of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            are
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represended
            by
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            into the
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi O
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} B O \times \mathbb{Z}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo ×
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B U \times \mathbb{Z}
            = succeed ")." do
              %a.maruku-ref{:href => "#BUn"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi X
                    %mtext compact
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %msub
                      %mi K
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo →
                    %mi B
                    %mi U
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} ]
                    %mphantom
                      %mi AAAAA
                    %msub
                      %mi K
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi B
                    %mi O
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} ]
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  X \text{compact}
                  \\right)
                  \\;\Rightarrow\;
                  \\left(
                  K_{\mathbb{C}}(X)
                  \\simeq
                  [X \to B U \times \mathbb{Z}]
                  \\phantom{AAAAA}
                  K_{\mathbb{R}}(X)
                  \\simeq
                  [X, B O \times \mathbb{Z}]
                  \\right)
                  \\,.
          %p There are various ways of generalizing this situation to non-compact spaces:
          #GrothendieckGroupKTheory.num_defn
            %h6#definition_9 Definition
            %p
              %strong (Grothendieck group topological K-theory)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
              construction on the
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ,
                    %mo ⊕
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Vect(X)/_\sim, \oplus)
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              makes sense for every
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              this is usually just called the “Grothendieck group of vector bundles on
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi GrothGroup
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ,
                    %mo ⊕
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{K}(X) \coloneqq GrothGroup( Vect(X)/_\sim, \oplus )
                    \\,.
          #RepresntableTopologicalKTheory.num_defn
            %h6#definition_10 Definition
            %p
              %strong (representable topological K-theory)
            %p
              The group of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              into a (classifying) space is of course well defined for any domain space, hence for any topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              one may set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi rep
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi B
                    %mi U
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} ]
                    %mphantom
                      %mi AAAAA
                    %msub
                      %mi K
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi rep
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi B
                    %mi O
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    K_{\mathbb{C}}(X)_{rep}
                    \\;\coloneqq\;
                    [X,B U \times \mathbb{Z}]
                    \\phantom{AAAAA}
                    K_{\mathbb{R}}(X)_{rep}
                    \\;\coloneqq\;
                    [X,B O \times \mathbb{Z}]
            %p
              This is called
              = succeed "." do
                %em representable K-theory
          %p
            Representable K-theory over
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+spaces"} paracompact topological spaces
            was discussed in (
            %a{:href => "#Karoubi70"}> Karoubi 70
            ).
          #InverseLimitTopologicalKTheory.num_defn
            %h6#definition_11 Definition
            %p
              %strong (inverse limit topological K-theory)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              with the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (“
              %a.existingWikiWord{:href => "/nlab/show/direct+limit"}> direct limit
              ”)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \simeq \underset{\longrightarrow}{\lim}_n X_n
              such that each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+cell+complex"} finite cell complex
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              (
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"}> inverse limit
              ) of the corresponding K-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi invl
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K(X)_{invl} \coloneqq \underset{\longleftarrow}{\lim}_n K(X_n)
            %p
              is called the
              %em inverse limit K-theory
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            No two of these definitions are equivalent to each other on all of their domain of defintion (e.g.
            = succeed "," do
              %a{:href => "#AndersonHodgkin68"} Anderson-Hodgkin 68
            = succeed ")." do
              %a{:href => "#JackowskiOliver"} Jackowski-Oliver
          %p
            Representable and direct limit K-theory of spaces that are
            %a.existingWikiWord{:href => "/nlab/show/sequential+colimits"} sequential colimits
            of
            %a.existingWikiWord{:href => "/nlab/show/compact+spaces"} compact spaces
            differ in general by a
            = succeed "-term" do
              %a.existingWikiWord{:href => "/nlab/show/lim%5E1"} lim^1
            = succeed ")." do
              %a{:href => "#SegalAtiyah69"} Segal-Atiyah 69, prop. 4.1
          %h2#Examples Examples
          .num_example
            %h6#example_5 Example
            %p
              %strong
                (topological K-theory ring of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
            %p
              We have already seen in example
              %a.maruku-ref{:href => "#KGroupOfThePoint"}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K(\ast) \simeq \mathbb{Z}
                    \\,.
          #ComplexTopologicalKTheoryOfTheCircle.num_example
            %h6#example_6 Example
            %p
              %strong
                (complex topological K-theory ring of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %p
              Since the complex
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
