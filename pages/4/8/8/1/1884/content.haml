              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
          .proof
            %h6#proof Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              compact Hausdorff then lemma
              %a.maruku-ref{:href => "#DirectSumHasInverseUpToTrivialBundle"}
              implies that for every
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo −
                  %annotation{:encoding => "application/x-tex"} E_-
              there exists a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo −
                  %annotation{:encoding => "application/x-tex"} \tilde E_-
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo −
                      %msub
                        %mo ⊕
                        %mi X
                      %msub
                        %mover
                          %mi E
                          %mo{:stretchy => "false"} ˜
                        %mo −
                      %mo ≃
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E_- \oplus_X \tilde E_- \simeq X \times k^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mo −
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi E
                            %mo +
                          %mo{:stretchy => "false"} ]
                          %mo +
                          %mo{:stretchy => "false"} [
                          %msub
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ˜
                            %mo −
                          %mo{:stretchy => "false"} ]
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi E
                        %mo{:stretchy => "false"} ]
                    %mo −
                    %munder
                      %munder
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi E
                            %mo −
                          %mo{:stretchy => "false"} ]
                          %mo +
                          %mo{:stretchy => "false"} [
                          %msub
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ˜
                            %mo −
                          %mo{:stretchy => "false"} ]
                          %mo )
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ×
                        %msup
                          %mi k
                          %mi n
                        %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [E_+] - [E_-]
                    \=
                    \\underset{[E]}{\underbrace{[E_+] + [\tilde E_-]}}
                    \-
                    \\underset{[X \times k^n]}{\underbrace{ \left( [E_-] + [\tilde E_-] \right) } }
                    \=
                    [E] - [X \times k^n]
                    \\,.
          #KTheoryRing.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(X)
                from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
            %p
              Also the operation of
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              descends to
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              and makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mo ,
                    %mo ⊕
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Vect(X)_{\sim}, \oplus, \otimes )
              a
              %a.existingWikiWord{:href => "/nlab/show/semi-ring"} semi-ring
              (
              %a.existingWikiWord{:href => "/nlab/show/rig"}> rig
              ).
            %p
              (This is the shadow under passing to isomorphism classes of the fact that the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Vect(X)
              is a
              %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+category"} distributive monoidal category
              under
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
            %p
              This multiplicative structure passes to the K-group (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#KGroupByGrothendieckGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mo +
                    %mo ,
                    %msub
                      %mi E
                      %mo −
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi F
                      %mo +
                    %mo ,
                    %msub
                      %mi F
                      %mo −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo +
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi F
                      %mo +
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊕
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo −
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi F
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo +
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi F
                      %mo −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊕
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo −
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi F
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [E_+, E_-] \cdot [F_+, F_-]
                    \\;\coloneqq\;
                    [ (E_+ \otimes_X F_+) \oplus_X (E_- \otimes_X F_-) \,,\, (E_+ \otimes_X F_-) \oplus_X (E_- \otimes_X F_+)  ]
                    \\,.
            %p
              Accordingly the ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (K(X), +,\cdot)
              is also called the
              %em K-theory ring
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #FunctorialityOfKGroup.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
                of the K-theory ring assignment)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+vector+bundles"} pullback of vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \;\colon\; Vect(Y) \longrightarrow Vect(X)
            %p
              is compatible with
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              as well as with
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              and hence descends to a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \;\colon\; K(Y) \longrightarrow K(X)
            %p
              between the K-theory rings from remark
              = succeed "." do
                %a.maruku-ref{:href => "#KTheoryRing"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mover
                      %mo ⟶
                      %mi g
                    %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    X \overset{f}{\longrightarrow} Y \overset{g}{\longrightarrow} Z
            %p
              two consecutive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mo ∘
                    %msup
                      %mi g
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (g \circ f)^\ast = f^\ast \circ g^\ast \;\colon\; K(Z) \longrightarrow K(X)
                    \\,.
            %p
              Finally, of course pullback along an
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} id_X \colon X \to X
              is the identity group homomorphism.
            %p
              In summary this says that the assignment of K-groups to topological spaces is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Top
                      %mi op
                    %mo ⟶
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"}
                    K(-)
                    \\;\colon\;
                    Top^{op}
                    \\longrightarrow
                    CRing
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              to the category
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
          %p
            We consider next the image of plain vector bundles in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
          #StableEquivalenceOfVectorBundles.num_prop
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stable+equivalence+of+vector+bundles"}> stable equivalence of vector bundles
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∼
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} \sim_{stable}
              on
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by declaring two vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mi E
                      %mn 2
                    %mo ∈
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_1 E_2 \in Vect(X)
              to be equivalent if there exists a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \times k^n
              of some
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              such that after
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              with this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo ∼
                        %mi stable
                      %msub
                        %mi E
                        %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∃
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mrow
                      %mo (
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo ⊕
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo ⊕
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    E_1
                    \\sim_{stable}
                    E_2
                    \\right)
                    \\;\Leftrightarrow\;
                    \\underset{n \in \mathbb{N}}{\exists}
                    \\left(
                    E_1 \oplus_X (X \times k^n)
                    \\;\simeq\;
                    E_2 \oplus_X (X \times k^n)
                    \\right)
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo ∼
                      %mi stable
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_1 \sim_{stable} E_2
              we say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              are
              = succeed "." do
                %em stably equivalent vector bundles
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of plain
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/semigroups"} semigroups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Vect
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mo ∼
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi E
                              %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi E
                                %mn 1
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ×
                              %msup
                                %mi k
                                %mn 0
                              %mo{:stretchy => "false"} ]
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Vect(X)_{/\sim}
                    \&amp; \longrightarrow &amp;
                    K(X)
                    \\\
                    [E_1] &amp;\overset{\phantom{AAA}}{\mapsto}&amp; \left( [E_1], [X \times k^0] \right)
                    }
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SemigroupOfIsomorphismClassesOfTopologicalVectorBundlesOnX"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              %a.maruku-ref{:href => "#KGroupByGrothendieckGroup"}
              ).
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of this function is the
              %a.existingWikiWord{:href => "/nlab/show/stable+equivalence+classes+of+vector+bundles"} stable equivalence classes of vector bundles
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#StableEquivalenceOfVectorBundles"}
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              onto
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi stable
                  %annotation{:encoding => "application/x-tex"} Vect(X)_{/\sim_{stable}}
              followed by an
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi stable
                    %mo ↪
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Vect(X)_{/\sim}
                    \\longrightarrow
                    Vect(X)_{/\sim_{stable}}
                    \\hookrightarrow
                    K(X)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              The homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Vect(X)_{/\sim} \to K(X)
              is the one given by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group+of+a+commutative+monoid"} Grothendieck group
              construction (
              %a{:href => "Grothendieck+group+of+a+commutative+monoid#UniversalProperty"}> this prop.
              ).
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group+of+a+commutative+monoid"} Grothendieck group
              (
              %a{:href => "Grothendieck+group+of+a+commutative+monoid#GrothendieckGroupViaQuotientOfCartesianProduct"}> this def.
              ), two elements of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    [E_1], [X \times k^0]
                    \\right)
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    \\left(
                    [E_2], [X \times k^0]
                    \\right)
            %p
              are equivalent precisely if there exist vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_2
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo ⊕
                        %mi X
                      %msub
                        %mi F
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi F
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo ⊕
                        %mi X
                      %msub
                        %mi F
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi F
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    [ E_1 \oplus_X F_1 ], [ F_1]
                    \\right)
                    \\;=\;
                    \\left(
                    [E_2 \oplus_X F_2], [F_2]
                    \\right)
                    \\,.
            %p
              First of all this means that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %mo ≃
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_1 \simeq F_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %mi F
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo ⊕
                    %mi F
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [E_1 \oplus F] \;=\; [E_2 \oplus F]
                    \\,.
            %p
              Now, by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is compact Hausdorff, lemma
              %a.maruku-ref{:href => "#DirectSumHasInverseUpToTrivialBundle"}
              implies that there exists a vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde F
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⊕
                      %mi X
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                    %mo ≃
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    F \oplus_X \tilde F \simeq X \times k^n
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              of some
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [E_1 \oplus (X \times k^n)]
                    \\;=\;
                    [E_2 \oplus (X \times k^n)]
                    \\,.
            %p
              This is the definition of stable equivalence from def.
              = succeed "." do
                %a.maruku-ref{:href => "#StableEquivalenceOfVectorBundles"}
          %h3#ReducedKGroup The reduced K-group
          #KernelReducedKGroup.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"}> reduced K-theory
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              equipped with a choice of point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} const_x \colon \ast  \to X
              from the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
            %p
              By the functoriality of the K-groups (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctorialityOfKGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi const
                      %mi x
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    const_x^\ast \;\colon\; K(X) \longrightarrow K(\ast)
            %p given by restricting a virtual vector bundle to the basepoint.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of this map is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
                group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi const
                      %mi x
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde{K}(X) \;\coloneqq\; ker(const_x^\ast)
                    \\,.
          #ExpressingPlainKTHeoryGroupInTermsOfReducedKTheoryGroup.num_example
            %h6#example_2 Example
            %p
              %strong (expressing plain K-groups as reduced K-groups)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo *
                    %mo ≔
                    %mi X
                    %mo ⊔
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X_* \coloneqq X \sqcup \ast
              for its
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              with base point the adjoined point.
            %p
              Then the reduced K-theory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo +
                  %annotation{:encoding => "application/x-tex"} X_+
              is the plain K-theory of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde{K}(X_+)
                    \\simeq
                    K(X)
                    \\,.
            %p
              Because every
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \sqcup \ast
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              of one that has
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              zero on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              and one that has rank zero on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (
              %a{:href => "direct+sum+of+vector+bundles#DirectSumOnDisjointUnionSpace"}> this example.
              )
          #RestrictionInKTheoryToPointComputesVirtualRank.num_remark
            %h6#remark_4 Remark
            %p
              %strong (restriction in K-theory to the point computes virtual rank)
            %p
              By example
              %a.maruku-ref{:href => "#KGroupOfThePoint"}
              we have that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} K(\ast) \simeq \mathbb{Z}
                  ;
              %li
                %p
                  under this identification the function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi const
                          %mi x
                          %mo *
                      %annotation{:encoding => "application/x-tex"} const_x^\ast
                  is the assignment of
                  %em virtual rank
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msubsup
                                      %mi const
                                      %mi x
                                      %mo *
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mo ≃
                              %mtd
                                %mi ℤ
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} [
                                %mi E
                                %mo{:stretchy => "false"} ]
                                %mo −
                                %mo{:stretchy => "false"} [
                                %mi F
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mover
                                  %mo ↦
                                  %mphantom
                                    %mi AAA
                              %mtd
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi E
                                  %mi x
                                %mo{:stretchy => "false"} ]
                                %mo −
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi F
                                  %mi x
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mo ↦
                              %mtd
                                %msub
                                  %mi rk
                                  %mi x
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                                %mo −
                                %msub
                                  %mi rk
                                  %mi x
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        K(X) &amp;\overset{const_x^\ast}{\longrightarrow}&amp; K(\ast) &amp;\overset{\simeq}{\to}&amp; \mathbb{Z}
                        \\\
                        [E]- [F] &amp;\overset{\phantom{AAA}}{\mapsto}&amp; [E_x] - [F_x] &amp;\mapsto&amp; rk_x(E) - rk_x(F)
                        }
          #VanishingAtInfinity.num_defn
            %h6#remark_5 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"}> vanishing at infinity
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow \mathbb{R}
            %p
              is said to
              %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanish at infinity
              if it
              %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              by zero to the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msub
                      %mi τ
                      %mi cpt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^* \coloneqq (X \sqcup \{\infty\}, \tau_{cpt})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi x
                                  %mo ↦
                                  %mrow
                                    %mo {
                                    %mrow
                                      %mtable
                                        %mtr
                                          %mtd
                                            %mi f
                                            %mo{:stretchy => "false"} (
                                            %mi x
                                            %mo{:stretchy => "false"} )
                                          %mtd
                                            %mo{:stretchy => "false"} |
                                          %mtd
                                            %mi x
                                            %mo ∈
                                            %mi X
                                        %mtr
                                          %mtd
                                            %mn 0
                                          %mtd
                                            %mo{:stretchy => "false"} |
                                          %mtd
                                            %mi x
                                            %mo =
                                            %mn ∞
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{f}{\longrightarrow}&amp; \mathbb{R}
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{ x \mapsto \left\{ \array{ f(x) &amp;\vert&amp; x \in X \\ 0 &amp;\vert&amp; x = \infty }  \right. }}
                    \\\
                    X^\ast
                    }
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^\ast
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              (by
              %a{:href => "one-point+compactification#OnePointExtensionIsCompact"} this prop.
              and
              = succeed ")" do
                %a{:href => "one-point+compactification#HausdorffOnePointCompactification"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              with basepoint the element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mo ∈
                      %msup
                        %mi X
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \infty \in X^\ast
            %p
              Moreover, every
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              arises this way as the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              of the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of any of its points:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X \simeq (X \setminus \{x\})^\ast
              (by
              = succeed ")." do
                %a{:href => "one-point+compactification#CompactHausdorffSpaceIsCompactificationOfComplementOfAnyPoint"} this remark
            %p
              Since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+subspaces+of+compact+Hausdorff+spaces+are+locally+compact"} open subspaces of compact Hausdorff spaces are locally compact
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \setminus \{x\} \subset X
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              = succeed ")." do
                %a{:href => "one-point+compactification#InclusionIntoOnePointExtensionIsOpenEmbedding"} this prop.
            %p
              Therefore one may think of the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-groups"} reduced K-groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
          #FunctorialityOfReducedKGroups.num_remark
            %h6#remark_6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
                of the reduced K-groups)
            %p
              By the functoriality of the unreduced K-groups (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctorialityOfKGroup"}
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of) the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of all topological spaces, the reduced K-groups (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              (whose
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are the
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              that preserve the base-point):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi Ab
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde{K} \;\colon\; (Top^{\ast/})^{op} \longrightarrow Ab
                    \\,.
            %p
              This follows by the functoriality of the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              construction (which in turn follows by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the kernel):
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              a continuous function which preserves basepoints
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f(x) = y
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi const
                              %mi x
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi const
                                  %mi x
                                  %mo *
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∃
                                  %mo !
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                        %mtr
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi const
                              %mi y
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi const
                                  %mi x
                                  %mo *
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi y
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ker(const_x^\ast)
                    \&amp;\longrightarrow&amp;
                    K(X)
                    \&amp;\overset{const_x^\ast}{\longrightarrow}&amp;
                    K(\{x\})
                    \\\
                    \\uparrow^{\mathrlap{\exists !}} &amp;&amp; \uparrow^{\mathrlap{f^\ast}} &amp;&amp; \uparrow^{\mathrlap{f^\ast}}
                    \\\
                    ker(const_y^\ast)
                    \&amp;\longrightarrow&amp;
                    K(Y)
                    \&amp;\overset{const_x^\ast}{\longrightarrow}&amp;
                    K(\{y\})
                    }
                    \\,.
          #KGrupDirectSummandReducedKGroup.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (over
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{K}(X)
                is a
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summand
                of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(X)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              is a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              then the defining
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              groups (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#KernelReducedKGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
