            is in the image of the pullback morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi i
                      %mo{:stretchy => "false"} ˜
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
