            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            (in general non-compact) then the map from the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi Vect
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %mo ,
                  %mo ⊕
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{K}(B G) \coloneqq Grp(Vect(B G)/_\sim, \oplus)
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#GrothendieckGroupKTheory"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi B
