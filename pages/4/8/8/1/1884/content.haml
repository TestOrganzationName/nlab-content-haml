                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_{\tilde{K}(X)}
                    \\;\colon\;
                    \\tilde{K}(X) \longrightarrow \tilde K(X \vee Y) \longrightarrow \tilde{K}(X)
                    \\phantom{AA}
                    \\text{and}
