                    %mo ⊠
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\boxtimes
                    \\;\colon\;
                    K(X) \otimes K(S^2) \overset{\simeq}{\longrightarrow} K(X \times S^2)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %h3#BottPeriodicities Bott periodicity
          %p
            When restricted to
            %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
            then the external product theorem (cor.
            = succeed ")" do
              %a.maruku-ref{:href => "#ExternalProductTheorem"}
            %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            of topological K-theory:
          #BottPeriodicity.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"}> Bott periodicity
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            %p
              Then the external product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde X
              in reduced K-theory (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExternalTensorProductInKTheory"}
              %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"} basic complex line bundle on the 2-sphere
              in reduced K-theory yields an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-groups"} reduced K-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⊠
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn 2
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (h-1)
                    \\tilde \boxtimes
                    (-)
                    \\;\colon\;
                    \\tilde{K}(X) \overset{\simeq}{\longrightarrow} \tilde K(\Sigma^2 X)
            %p
              from that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to that of its double
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mn 2
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma^2 X
          %p
            %a{:href => "#Wirthmuller12"} e.g. Wirthmuller 12, p. 34 (36 of 67)
          .proof
            %h6#proof_12 Proof
            %p
              By
              %a{:href => "topologica+K-theory#ReducedKTheoryOfProductSpace"} this example
              there is for any two pointed compact Hausdorff spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K(Y \times X)
                    \\simeq
                    \\tilde K(Y \wedge X)
                    \\oplus
                    \\tilde K(Y)
                    \\oplus
                    \\tilde{K}(X)
            %p
              relating the reduced K-theory of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              with that of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            %p
              Using this and the fact that for any pointed compact Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} K(Z) \simeq \tilde K(Z) \oplus \mathbb{Z}
              (
              %a{:href => "topological+K-theory#KGrupDirectSummandReducedKGroup"}> this prop.
              ) the isomorphism of the external product theorem (cor.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExternalProductTheorem"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mo ⊠
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K(S^2) \otimes K(X)
                    \\underoverset{\simeq}{\boxtimes}{\longrightarrow}
                    K(S^2 \times X)
            %p becomes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                      %mo )
                    %mo ⊗
                    %mrow
                      %mo (
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ×
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %mover
                        %mi K
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ∧
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
