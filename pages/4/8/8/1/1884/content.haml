            %p
              Since a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (and using that the
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n)
              are (see there)
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              out of it commutes with the
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Top
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Top
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi n
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
