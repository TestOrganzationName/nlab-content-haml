                              %msub
                                %mi rk
                                %mi x
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %mo ⏟
                      %mrow
