            = succeed "." do
              %a{:href => "topological+vector+bundle#IsomorphismOfVectorBundlesOnClosedSubsetOfCompactHausdorffSpaceExtendsToOpenNeighbourhoods"} this lemma
          #ExactSequenceInReducedTopologicalKTheory.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong (exact sequence in reduced topological K-theory)
            %p Let
            %ul
              %li
                %p
