              %a.existingWikiWord{:href => "/nlab/show/homotopy+invariance"} homotopy invariance
              of the K-groups (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#KGroupsHomotopyInvariance"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We discuss some useful consequences of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+in+cohomology"} long exact sequences in cohomology
          #DirectSumOfKTheoryGroupsOverRetracts.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                decomposition of K-theory groups over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/retractions"} retractions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a (
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"}> pointed
              )
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              a (
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"}> pointed
              )
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi i
                  %annotation{:encoding => "application/x-tex"} A \overset{i}{\to}
              X as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} r \colon X \to A
              such that the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mover
                      %mo ⟶
                      %mi i
                    %mi X
                    %mover
                      %mo ⟶
                      %mi r
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    id_A
                    \\;\colon\;
                    A
                    \\overset{i}{\longrightarrow}
                    X
                    \\overset{r}{\longrightarrow}
                    A
            %p
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            %p
              Then there is a splitting of the K-theory group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the K-theory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the
              %a.existingWikiWord{:href => "/nlab/show/relative+K-theory"} relative K-theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X/A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K(X)
                    \\;\simeq\;
                    K(A)
                    \\oplus
                    K(X,A)
            %p
              and in the pointed case a splitting of the
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced K-theory
              groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi K
                    %mo{:stretchy => "false"} (
