          .proof
            %h6#proof_8 Proof
            %p
              The long exact sequence from cor
              %a.maruku-ref{:href => "#LongExactSequenceInReducedTopologicalKTheory"}
              together with the retraction yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi r
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi i
                            %mo *
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                      %mover
                        %mo ⟵
                        %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K(A)
                    \\underoverset
                    {\underset{r^\ast}{\longrightarrow}}
                    {\overset{i^\ast}{\longleftarrow}}
                    {}
                    \\tilde{K}(X)
                    \\overset{}{\longleftarrow}
                    K(X,A)
                    \\longleftarrow
                    \\tilde K(\Sigma A)
                    \\underoverset
                    {\underset{}{\longrightarrow}}
                    {\overset{}{\longleftarrow}}
                    {}
                    \\tilde K(\Sigma X)
                    \\,.
            %p
              The splitting makes the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^\ast
              and its suspension be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/surjections"} surjections
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              which are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ⟵
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi r
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi i
                            %mo *
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\longleftarrow
                    \\tilde K(A)
                    \\underoverset
                    {\underset{r^\ast}{\longrightarrow}}
                    {\overset{i^\ast}{\longleftarrow}}
                    {}
                    \\tilde{K}(X)
                    \\longleftarrow
                    K(X,A)
                    \\longleftarrow
                    0
                    \\,.
          #FiniteWedgePropertyForReducedTopologicalKTheory.num_example
            %h6#example_9 Example
            %p
              %strong
                (finite
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/wedge+axiom"} wedge axiom
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              be two
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊔
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∼
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \vee Y \;\coloneqq\; (X \sqcup Y)/(x \sim y)
            %p
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient
              of their
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              by re-identifying the base points).
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde K(X \vee Y) \simeq \tilde{K}(X) \oplus \tilde K(Y)
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              We have
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X = X \times \{y\} \hookrightarrow X \times Y
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi Y
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Y = \{x\} \times Y \hookrightarrow (X \times Y) / (X \times \{y\})
                    \\,.
            %p
              Applying prop.
              %a.maruku-ref{:href => "#DirectSumOfKTheoryGroupsOverRetracts"}
              to each of these consecutively yields an isomorphism that establishes the claim:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
