          %div{:style => "float:right;margin:0 20px 10px 20px;"}
            %img{:alt => "Screenshot of homotopy.io", :src => "https://www.cs.bham.ac.uk/~vicaryjo/images/face_of_pentagon.jpg", :width => "450"}/
          %p
            This page describes
            = succeed "," do
              %em homotopy.io
            %a.existingWikiWord{:href => "/nlab/show/proof+assistant"} proof assistant
            for finitely-presented
            %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-category"}
                %em> n
