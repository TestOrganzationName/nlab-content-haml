                      (cross-linked reference resource)
            %p
              based on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Agda-flat"}> Agda-flat
                \:
                %a{:href => "http://www.cl.cam.ac.uk/~amp12/agda/internal-universes/code/agda-flat/install.txt"} installation instructions
            %p
              based on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Rzk"} Rzk
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/DisCoPy"} DisCoPy
            %p
