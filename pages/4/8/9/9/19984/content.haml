            %p#BasedOnCubicalTypeTheory
              based on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            %ul
              %li
                %p
                  %a{:href => "https://github.com/mortberg/cubicaltt"} cubicaltt
              %li
                %p
                  %a{:href => "http://github.com/redprl/redtt"} redtt
              %li
