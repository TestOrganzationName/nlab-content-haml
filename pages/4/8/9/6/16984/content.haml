          %h2#idea Idea
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an algebraically closed
            %a.existingWikiWord{:href => "/nlab/show/perfectoid+field"} perfectoid field
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{p}
            %em Fargues-Fontaine curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi C
                %annotation{:encoding => "application/x-tex"} X_{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/complete+variety"} complete
            %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            whose
            %a.existingWikiWord{:href => "/nlab/show/closed+points"} closed points
            parametrize the untilts of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
            of the corresponding point.
          %h2#as_an_adic_space As an adic space
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a finite extension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{p}
            with uniformizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            and residue field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %msup
                    %mi R
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S=Spa(R,R^{+})
            be a
            %a.existingWikiWord{:href => "/nlab/show/perfectoid+space"} perfectoid space
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi 𝔽
                      %mo ¯
                    %mi q
                %annotation{:encoding => "application/x-tex"} \overline{\mathbb{F}}_{q}
            with pseudouniformizer
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϖ
                  %annotation{:encoding => "application/x-tex"} \varpi
            %a.existingWikiWord{:href => "/nlab/show/Witt+vectors"} Witt vectors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi 𝒪
                          %mi E
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mo ⊗
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi κ
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi 𝒪
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W_{\mathcal{O}_{E}}(R):=W(R^{+}\otimes_{W(\kappa)}\mathcal{O}_{E})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi S
                %annotation{:encoding => "application/x-tex"} Y_{S}
            to be the locus in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi E
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spa(W_{\mathcal{O}_{E}}(R))
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϖ
                %annotation{:encoding => "application/x-tex"} \varpi
            are invertible. We think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi S
                %annotation{:encoding => "application/x-tex"} Y_{S}
            as the “fiber product”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spa
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spa(R^{+})\times Spa(\mathcal{O}_{E})
          %p
            The (relative) Fargues-Fontaine curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi S
                %annotation{:encoding => "application/x-tex"} X_{S}
            is then defined to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi S
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi ϕ
                      %mi S
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} Y_{S}/\phi_{S}^{\mathbb{Z}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi S
                %annotation{:encoding => "application/x-tex"} \phi_{S}
            is the Frobenius on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h2#in_the_geometrization_of_the_local_langlands_correspondence In the geometrization of the local Langlands correspondence
          %p
            The Fargues-Fontaine curve finds application in the geometrization of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+Langlands+correspondence"} local Langlands correspondence
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            is stated for a curve. Naively, one might think that the “curve” for the local Langlands correspondence should be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(E)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a local field. However, the local Langlands correspondence concerns the Weil group instead of the absolute Galois group, one should instead consider
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} breve
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi ϕ
                      %mi E
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} Spec(\breve{E})/\phi_{E}^{\mathbb{Z}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} breve
                  %mi E
                %annotation{:encoding => "application/x-tex"} \breve{E}
            is the maximal unramified extension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi E
                %annotation{:encoding => "application/x-tex"} \phi_{E}
            is the Frobenius.
          %p
            To truly obtain a geometrization, however, one needs to “relativize” this, which is analogous to considering the stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bun
                    %mi G
                %annotation{:encoding => "application/x-tex"} Bun_{G}
            in the geometric Langlands correspondence instead of just its points
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bun
                      %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bun_{G}(\mathbb{F}_{q})
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is, say
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{q}((t))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %msup
                    %mi R
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S=Spa(R,R^{+})
            with pseudouniformizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϖ
                %annotation{:encoding => "application/x-tex"} \varpi
            we may take the fiber product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mo ×
                      %mrow
                        %mi Spa
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔽
                          %mi q
                        %mo{:stretchy => "false"} )
                    %mi Spa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S\times_{Spa(\mathbb{F}_{q})} Spa(\mathbb{F}_{q}((t)))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a finite extension of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℚ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{q}
            over which we take the fiber product.
          %p
            However, we note that in the case where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %msub
                      %mi 𝔽
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E=\mathbb{F}_{q}((t))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %msub
                    %mo ×
                    %mrow
                      %mi Spa
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mi q
                      %mo{:stretchy => "false"} )
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S\times_{Spa(\mathbb{F}_{q})} Spa(\mathbb{F}_{q}((t)))
            is the locus inside
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi R
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi Spa
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mi q
                      %mo{:stretchy => "false"} )
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spa(R^{+})\times_{Spa(\mathbb{F}_{q})} Spa(\mathbb{F}_{q}[[t]])
            where both the uniformizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϖ
                %annotation{:encoding => "application/x-tex"} \varpi
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and the uniformizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{q}
            are both invertible.
          %p
            Now noting that the mixed characteristic analogue of forming power series is taking Witt vectors (compare, for instance,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi p
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{p}[[t]]
            and
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} W(\mathbb{F}_{p})=\mathbb{Z}_{p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi S
                %annotation{:encoding => "application/x-tex"} Y_{S}
            defined above as the analogue of our fiber product,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spa
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spa
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spa(R^{+})\times Spa(\mathcal{O}_{E})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi S
                    %mo =
                    %msub
                      %mi Y
                      %mi S
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ϕ
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} X_{S}=Y_{S}/\phi^{\mathbb{Z}}
          %h2#as_a_scheme As a scheme
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mi Spa
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S=Spa(C)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an algebraically closed perfectoid field over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{C}
            be the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathcal{O}_{C})
            be the
            %a.existingWikiWord{:href => "/nlab/show/Witt+vectors"} Witt vectors
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi C
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \phi_{C}:C\to C
            be the Frobenius morphism. We define a
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mo ⋅
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi r
                %annotation{:encoding => "application/x-tex"} \vert\cdot\vert_{r}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} W(\mathcal{O}_{C})[1/p]
            as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo ≫
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mi p
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi r
                  %mo =
                  %munder
                    %mi sup
                    %mi n
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi r
                      %mi n
                %annotation{:encoding => "application/x-tex"} \vert \sum_{n\gg -\infty} [a_{n}]p^{n}\vert_{r}=\sup_{n}\vert a_{n}\vert p^{-r n}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi C
                %annotation{:encoding => "application/x-tex"} B_{C}
            be the Frechet completion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} W(\mathcal{O}_{C})[1/p]
            with respect to all the norms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mo ⋅
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi r
                %annotation{:encoding => "application/x-tex"} \vert\cdot\vert_{r}
            for every positive
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
          %p
            Then the schematic Fargues-Fontaine curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi X
                    %mi C
                    %mi sch
                %annotation{:encoding => "application/x-tex"} X_{C}^{sch}
            is defined to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi X
                    %mi C
                    %mi sch
                  %mo =
                  %mi{:mathvariant => "normal"} Proj
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ⊕
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                  %msubsup
                    %mi B
                    %mi C
                    %mrow
                      %mi ϕ
                      %mo =
                      %msup
                        %mi p
                        %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} X_{C}^{sch}=\mathrm{Proj}(\oplus_{n\in\mathbb{N}} B_{C}^{\phi=p^{n}}).
          %h2#vector_bundles_on_the_farguesfontaine_curve Vector Bundles on the Fargues-Fontaine Curve
          %p
            %span.newWikiWord
              Vector bundles
              %a{:href => "/nlab/new/Vector+bundles"} ?
            on the Fargues-Fontaine curve admit a classification in terms of
            %em isocrystals
            (vector spaces over the field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            together with a semilinear action of Frobenius). More generally for a reductive group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-isocrystals" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            These also in turn correspond to extended pure inner forms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (which are all the inner forms if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is connected). It is believed that it should not just be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            together, which should appear in the geometric side of the
            %a.existingWikiWord{:href => "/nlab/show/local+Langlands+correspondence"} local Langlands correspondence
            (for instance inner forms have the same
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Langlands+dual+group"} Langlands dual group
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/p-adic+Hodge+theory"} p-adic Hodge theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+Langlands+correspondence"} local Langlands correspondence
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jared+Weinstein"}> Jared Weinstein
                ,
                %em
                  %a{:href => "https://galoisrepresentations.wordpress.com/2013/07/23/the-fundamental-curve-of-p-adic-hodge-theory-or-how-to-un-tilt-a-tilted-field/"} The Fundamental Curve of p-adic Hodge Theory, or How to Un-tilt a Tilted Field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jared+Weinstein"}> Jared Weinstein
                ,
                %em
                  %a{:href => "https://galoisrepresentations.wordpress.com/2013/08/12/the-fundamental-curve-of-p-adic-hodge-theory-part-ii/"} The Fundamental Curve of p-adic Hodge Theory, Part II
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"}> Dennis Gaitsgory
                ,
                = succeed "," do
