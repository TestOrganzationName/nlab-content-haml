                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,-)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %a.existingWikiWord{:href => "/nlab/show/coinductive+type"} coinductive type
            rather than an
            = succeed "." do
