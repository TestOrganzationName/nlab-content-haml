                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mo{:stretchy => "false"} ]
                      %mi c
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:\mathbb{2} \vdash c:C \quad \Gamma \vdash p:\mathbb{2}}{\Gamma \vdash \beta_\Pi(p):\lambda(x:\mathbb{2}).c(x)[p/x] =_{C[p/x]} c[p/x]}
          %p Uniqueness rules for product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi z
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
