                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo ≡
                      %mi B
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo ×
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A \vdash B \; \mathrm{type} \quad \Gamma, a:A, b:A \vdash B[a/x] \equiv B[b/x] \; \mathrm{type}}{\Gamma \vdash A \times B \; \mathrm{type}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo :
                      %mi A
                      %mo ,
                      %mi b
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo ≡
