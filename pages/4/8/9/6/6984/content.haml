                      %mo :
                      %mi 𝟚
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \times B \coloneqq C(0) \times C(1) \coloneqq \prod_{x:\mathbb{2}} C(x)
          %p and is given by the following rules:
          %p Formation rules for product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi 𝟚
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:\mathbb{2} \vdash C \; \mathrm{type}}{\Gamma \vdash C(0) \times C(1) \; \mathrm{type}}
          %p Introduction rules for product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi 𝟚
                      %mo ⊢
                      %mi c
                      %mo :
                      %mi C
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi 𝟚
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:\mathbb{2} \vdash c:C}{\Gamma \vdash \lambda(x:\mathbb{2}).c(x):C(0) \times C(1)}
          %p Elimination rules for product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi z
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi 𝟚
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi z
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash z:C(0) \times C(1) \quad \Gamma \vdash p:\mathbb{2}}{\Gamma \vdash z(p):C[p/x]}
          %p Computation rules for product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi 𝟚
                      %mo ⊢
                      %mi c
                      %mo :
                      %mi C
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi 𝟚
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi β
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi 𝟚
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
