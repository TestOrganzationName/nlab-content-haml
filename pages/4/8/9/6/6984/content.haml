                  %annotation{:encoding => "application/x-tex"} A\times B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi B
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi B
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                %annotation{:encoding => "application/x-tex"} \frac{p \colon A\times B}{\pi_1 p\colon A} \qquad \frac{p\colon A\times B}{\pi_2 p\colon B}
          %p
            This then determines the form of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/term+introduction+rule"} constructors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\times B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (to be the value of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \pi_1 p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (to be the value of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \pi_2 p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mspace{:width => "2em"}
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"} \frac{a\colon A \qquad b\colon B}{(a,b)\colon A\times B}
          %p
            Finally, we have
            %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            which say that the relationship between the constructors and the eliminators is as we hoped. We always have
            %a.existingWikiWord{:href => "/nlab/show/beta+reduction"} beta reduction
            rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi β
                  %mi a
                  %mspace{:width => "2em"}
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi β
                  %mi b
                %annotation{:encoding => "application/x-tex"} \pi_1(a,b) \to_\beta a \qquad \pi_2(a,b) \to_\beta b
          %p
            and we may or may not choose to have an
            %a.existingWikiWord{:href => "/nlab/show/eta+reduction"} eta reduction
            rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %mi p
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi η
                  %mi p
                %annotation{:encoding => "application/x-tex"} (\pi_1 p, \pi_2 p) \to_\eta p
          %h4#as_a_positive_type_2 As a positive type
          %p
            When presented positively, primacy is given to the constructors. We specify that the way to construct something of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\times B
            is to give something of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and something of type
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mspace{:width => "2em"}
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"} \frac{a\colon A \qquad b\colon B}{(a,b)\colon A\times B}
          %p
            Of course, this is the same as the constructor obtained from the negative presentation. However, the eliminator is different. Now, in order to say how to
            %em use
            something of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\times B
            %em assuming
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            were of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi B
                      %mspace{:width => "2em"}
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ,
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo ⊢
                      %mi c
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                    %mrow
                      %mi let
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mi in
                      %mi c
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                %annotation{:encoding => "application/x-tex"} \frac{p\colon A\times B \qquad x\colon A, y\colon B \vdash c\colon C}{let (x,y) = p in c \;\colon C}
          %p
            We need a term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in the context of two variables of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y)
            in the destructor is just a part of the syntax; it is not an instance of the
            %em constructor
            ordered pair. In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to depend on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\times B
          %p
            Now we have
            %a.existingWikiWord{:href => "/nlab/show/beta+reduction"} beta reduction
            rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi in
                  %mi c
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} let (x,y) = (a,b) \,in c \;\to_\beta\; c[a/x, b/y]
          %p
            In other words, if we build an ordered pair and then break it apart, what we get is just the things we put into it. (The notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} c[a/x, b/y]
            means to substitute
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            in the term
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            And (if we wish) the
            %a.existingWikiWord{:href => "/nlab/show/eta+reduction"} eta reduction
            rule, which is a little more subtle:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mi in
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} let (x,y) = p in c[(x,y)/z] \;\to_\eta\; c[p/z]
          %p
            This says that if we break something of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\times B
            into its components, but then we only use those two components by way of putting them back together into an ordered pair, then we might as well just not have broken it down in the first place.
          %p
            Positively defined products are naturally expressed as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            syntax we have
          %pre
            %code
              :preserve
                Inductive prod (A B:Type) : Type :=
                | pair : A -> B -> prod A B.          %p
            (Coq then implements beta-reduction, but not eta-reduction. However, eta-equivalence is provable with the internally defined
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %p
            Arguably, negatively defined products should be naturally expressed as
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/coinductive+type"} coinductive type
          %h4#positive_versus_negative Positive versus negative
          %p In ordinary “nonlinear” type theory, the positive and negative product types are equivalent. They manifestly have the same constructor, while we can define the eliminators in terms of each other as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi x
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi y
                      %mtr
                        %mtd
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi c
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mo ,
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi y
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\pi_1 p &amp;\;\coloneqq\; let (x,y) = p in x\\
                  \\pi_2 p &amp;\;\coloneqq\; let (x,y) = p in y\\
                  let (x,y) = p in c &amp;\;\coloneqq\; c[\pi_1 p / x, \pi_2 p / y]
                  \\end{aligned}
          %p
            It is obvious that the
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            = succeed "-conversion." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %p
            In dependent type theory, in order to recover the
            %em dependent
            eliminator for the positive product type from the eliminators for the negative product type, we need the latter to satisfy the
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "-conversion)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "." do
              %a{:href => "/nlab/show/eta-conversion#Propositional"} propositional eta-conversions
          %p
            Now from
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi c
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi z
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                          %mo ,
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi z
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo →
                            %mi η
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo{:stretchy => "false"} [
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi z
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  let (x,y) = p in c[(x,y)/z]
                  \&amp;\;\coloneqq\; c[(\pi_1 p,\pi_2 p)/z]\\
                  \&amp;\;\to_\eta\; c[p/z]
                  \\end{aligned}
          %p
            so the defined positive product also satisfies its
            = succeed "-conversion," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %p
            On the other hand, if the positive product has a definitional
            = succeed "-conversion," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                          %mo ,
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi x
                          %mo ,
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ←
                            %mi η
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mi in
                          %mi x
                          %mo ,
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mi in
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo →
                            %mi β
                          %mspace{:width => "thickmathspace"}
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo →
                            %mi η
                          %mspace{:width => "thickmathspace"}
                          %mi p
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  (\pi_1 p, \pi_2 p)
                  \&amp;\;\coloneqq\; (let (x,y) = p in x, let (x,y) = p in y)\\
                  \&amp;\;\leftarrow_\eta\; (let (x',y') = p in \;( let (x,y) = (x',y') in x , let (x,y) = (x',y') in y )\\
                  \&amp;\;\to_\beta\; let (x',y') = p in (x',y')\\
                  \&amp;\;\to_\eta\; p
                  \\end{aligned}
          %p
            Note that this involves a beta-reduction step and also a “backwards”
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            %em reduction
            we cannot derive negative
            = succeed "-reduction," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "-equivalence." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            = succeed "-reduction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %p In conclusion, we have:
          %ul
            %li
              %p
                In non-dependent type theory, positive and negative products are equivalent, as are their definitional
                = succeed "-reduction" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
            %li
              %p
                In dependent type theory with
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
                %em dependent
                eliminator is equivalent to asserting
                %a{:href => "/nlab/show/eta-conversion#Propositional"} propositional
                versions of either
                = succeed "-conversion" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
            %li
              %p
                In any case, the two
                %em definitional
                = succeed "-conversion" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
          %p
            It is of importance to note that these translations require the
            %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction rule
            and the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening rule
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            these rules are disallowed, and therefore the positive and negative products become different. The positive product becomes “tensor”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\otimes B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi &amp;
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \&amp; B
          %h2#categorical_interpretation Categorical interpretation
          %p
            Under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %ul
            %li
              %p categorical products may be used to interpret product types that validate both beta and eta rules, while
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
                of a type theory with product types has categorical products, as long as the type theory satisfies both beta and eta rules.
          %p
            Of course, the categorical notion of product matches the
            %em negative
            definition of a product most directly. In linear logic, therefore, the categorical product interprets “with”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi &amp;
                  %annotation{:encoding => "application/x-tex"} \&amp;
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal structure
            interprets “tensor”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+multicategory"} cartesian multicategory
            %em positive
            definition.
          %p
            There is also another interpretation in category theory of the product type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/initial"} initial
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
            with
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \times B
            with a family of morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{in}_A(x):B \to A \times B
          %p
            such that for any other object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with a family of morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f(x):B \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi C
                  %mo :
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} u_C:A \times B \to C
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi C
                  %mo ∘
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u_C \circ \mathrm{in}_A(x) = f(x)
          %p This corresponds to the positive product types.
