                    %msub
                      %mo =
                      %mi 𝒰
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:A =_\mathcal{U} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{canonical}_\simeq(A, A)
            maps the identity function of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒯
                    %mi 𝒰
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo →
                    %mi 𝒰
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{T}_\mathcal{U}(A \to_\mathcal{U} A)
            to the identity function of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒯
                      %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝒯
                      %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}_\mathcal{U}(A) \to \mathcal{T}_\mathcal{U}(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒯
                    %mi 𝒰
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo →
                    %mi 𝒰
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{T}_\mathcal{U}(A \to_\mathcal{U} A)
            is just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{canonical}_\simeq^{-1}(A, A)(id_A)
            the above statement is always true. Thus, the second definition of a univalent universe is equivalent to the definition by transport.
          %p
            These results apply to strictly Tarski universes as well, which are strictly closed rather than weakly closed (the equivalences become
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/definitional+equality"} definitional equality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≡
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \equiv B
            implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            for types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h3#relation_to_parallel_transport Relation to parallel transport
          %p
          #RelationToParallelTransport.num_remark
            %h6 Remark
            %p
              %strong
                (relation to parallel transport –
                = succeed "," do
                  %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} dcct §3.8.5
                = succeed ")" do
                  %a{:href => "cohesive+homotopy+type+theory#SchreiberShulman2012"} ScSh12 §3.1.2
              %br/
              In
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
              the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %annotation{:encoding => "application/x-tex"} \esh
              has the
              %a.existingWikiWord{:href => "/nlab/show/shape+via+cohesive+path+%E2%88%9E-groupoid"} interpretation
              of turning any cohesive type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into its
              %a.existingWikiWord{:href => "/nlab/show/path+infinity-groupoid"}
                path
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \esh X
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo =
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mi X
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \colon (x =_{\esh X} y)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \esh X
              have the
              %a.existingWikiWord{:href => "/nlab/show/shape+via+cohesive+path+%E2%88%9E-groupoid"} interpretation
              of being (whatever identities existed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              composed with) cohesive (e.g.
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              %em
                %a.existingWikiWord{:href => "/nlab/show/paths"} paths
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Accordingly, an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \esh X
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              has the interpretation of being a “
              %a.existingWikiWord{:href => "/nlab/show/local+system"}> local system
              ” of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(x)
              %a.existingWikiWord{:href => "/nlab/show/fiber+infinity-bundle"}
                fiber
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              equipped with a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connection"}
                  flat
                  = succeed "-connection" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
            %p
              In this case, the identity transport
              %a.maruku-eqref{:href => "#eq:TheTransportFunctions"} (1)
              along paths in
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \esh X
              has the interpretation of being the
              %em
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              (in the original sense of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
              %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connection"}
                flat
                = succeed "-connection" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (and the
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              when applied to paths-of-paths).
          %h2#see_also See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+identity+type"} dependent identity type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/identity+of+indiscernibles"} identity of indiscernibles
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
          %h2#references References
          %p
            The traditional notion of the “transport” in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            (via the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
            and more generally via the notion of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
          %ul
            %li#tomDieck2008
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              , §3.2 and §5.6 in:
              = succeed "," do
                %em Algebraic topology
              = succeed "," do
                %a{:href => "https://www.ems-ph.org/books/book.php?proj_nr=86"} doi:10.4171/048
              = succeed "&rbrack;" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/diecktop.pdf"} pdf
          %p
            The notion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> UVP
                ,
                %a{:href => "https://hottheory.files.wordpress.com/2013/03/hott-online-323-g28e4374.pdf#page=81"} §2.3 “Type families and fibrations”
                in:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+%E2%80%93+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
                (2013)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
                \: §5.4 in:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Homotopy+Type+Theory"} Introduction to Homotopy Type Theory
                Cambridge University Press (2023) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2212.11082"}> arXiv:2212.11082
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
                , pp. 18 in:
                %em Homotopy Type Theory
                (2012) &amp;lbrack;
                %a{:href => "https://studenttheses.uu.nl/bitstream/handle/20.500.12932/11704/hott.pdf?sequence=1"}> pdf
                \&amp;rbrack;
          %p
            and in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cyril+Cohen"}> Cyril Cohen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Huber"} Simon Huber
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Anders+M%C3%B6rtberg"} Anders Mörtberg
                %em Cubical Type Theory: a constructive interpretation of the univalence axiom
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1611.02108"}> arXiv:1611.02108
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"}> Thierry Coquand
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Huber"} Simon Huber
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Anders+M%C3%B6rtberg"} Anders Mörtberg
                %em On Higher Inductive Types in Cubical Type Theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1802.01170"}> arXiv:1802.01170
                \&amp;rbrack;
          %p
            Implementation in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+H%C3%B6tzel+Escard%C3%B3"} Martín Hötzel Escardó
              pp 20 in:
              %em Introduction to Univalent Foundations of Mathematics with Agda
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1911.00580"}> arXiv:1911.00580
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.cs.bham.ac.uk/~mhe/HoTT-UF-in-Agda-Lecture-Notes/"} webpage
          %p
            and in
            = succeed ":" do
              %a{:href => "Agda#CubicalAgda"} cubical Agda
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/1lab"}> 1lab
                ,
                %em Transport
                \&amp;lbrack;
                %a{:href => "https://1lab.dev/1Lab.Path.html#12111"}> #12111
                \&amp;rbrack;
            %li#MyersRiley24
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Jaz+Myers"}> David Jaz Myers
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mitchell+Riley"} Mitchell Riley
                %a{:href => "https://github.com/CQTS/introduction-to-cubical/blob/master/lectures/2--Paths-and-Identifications/2-5--Transport.lagda.md"} lecture 2.5
                of course notes for
                %em Introduction to Cubical Agda
                at
                %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
                @ NYU Abu Dhabi (2023, 24) &amp;lbrack;
                %a{:href => "https://github.com/CQTS/introduction-to-cubical/tree/master/lectures"}> github
                \&amp;rbrack;
          %p
            %a.existingWikiWord{:href => "/nlab/show/Gottfried+Leibniz"}> Leibniz
            ‘s original paragraph (from an unpublished manuscript probably written after 1683) is reproduced in the Latin original in:
          %ul
            %li#Gerhard1890
              K. Gerhard (ed.), Section XIX,
              %a{:href => "https://archive.org/details/diephilosophisc00gerhgoog/page/228/mode/2up"} p. 228
              in:
              = succeed "," do
                %em Die philosophischen Schriften von Gottfried Wilhelm Leibniz
              = succeed "&rbrack;" do
                %a{:href => "https://archive.org/details/diephilosophisc00gerhgoog/page/n7/mode/2up"} archive.org
          %p and in English translation in:
          %ul
            %li#Lewis18
              %a.existingWikiWord{:href => "/nlab/show/Clarence+I.+Lewis"}> Clarence I. Lewis
              , Appendix (p. 373) of:
              = succeed "," do
                %em A Survey of Symbolic Logic
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/LewisAppendix-LeibnizIndiscernibles.pdf", :title => "pdf"} pdf
          %p and further discussed in:
          %ul
            %li#Cartwright71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Cartwright"}> Richard Cartwright
                ,
                = succeed "," do
                  %em Identity and Substitutivity
                = succeed "," do
                  %em Identity and Individuation
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Cartwright-IdentityAndSubstitutivity.pdf", :title => "pdf"} pdf
            %li#GriesSchneider98
              %p
                David Gries, Fred Schneider,
                %em Formalizations Of Substitution Of Equals For Equals
                (1998) &amp;lbrack;
                %a{:href => "https://ecommons.cornell.edu/bitstream/handle/1813/7340/98-1686.pdf?sequence=1&isAllowed=y"}> pdf
                ,
                %a{:href => "https://ecommons.cornell.edu/handle/1813/7340"} ecommons:1813/7340
          %p
            The understanding of transport in HoTT as expressing
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Leibniz"} Leibniz
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/indiscernibility+of+identicals"} indiscernibility of identicals
          %ul
            %li#LadymanPresnell15
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Ladyman"}> James Ladyman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stuart+Presnell"} Stuart Presnell
                = succeed "," do
                  %em Identity in Homotopy Type Theory, Part I: The Justification of Path Induction
                %strong 23
                3 (2015) 386–406 &amp;lbrack;
                %a{:href => "https://doi.org/10.1093/philmat/nkv014"}> doi:10.1093/philmat/nkv014
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://philsci-archive.pitt.edu/11079/1/Identity_in_HTT_public.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benedikt+Ahrens"}> Benedikt Ahrens
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paige+Randall+North"} Paige Randall North
                = succeed "," do
                  %em Univalent foundations and the equivalence principle
                = succeed "," do
                  %em Reflections on the Foundations of Mathematics
                %strong 407
                Springer (2019) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2202.01892"}> arXiv:2202.01892
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-030-15655-8"} doi:10.1007/978-3-030-15655-8
          %p
            The converse implication of
            %a.existingWikiWord{:href => "/nlab/show/path+induction"} path induction
            from transport (together with the uniqueness principle for id-types) is made explicit in:
          %ul
            %li
              %p
                %a{:href => "#LadymanPresnell15"} Ladyman &amp; Presnell 2015, §6.3
            %li
              %p
                Lennard Götz, §4.2 of:
                = succeed "," do
                  %em Martin-Löf’s J-rule
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.lmu.de/~petrakis/Goetz.pdf"} pdf
          %p
            For the role of transport in defining an equivalent notion of
            %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weakly+Tarski+universes"} weakly Tarski universes
          %ul
            %li
              Madeleine Birchfield, Valery Isaev,
              = succeed "," do
                %em Univalence for weakly Tarski universes
              = succeed ")" do
                %a{:href => "https://mathoverflow.net/q/431723"} web
