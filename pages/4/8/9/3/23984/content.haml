                %annotation{:encoding => "application/x-tex"} \mathrm{tr}_{\underline{ }.B(-)}^{(x, x, \mathrm{refl}_A(x))} \equiv \mathrm{id}_{B(x)}^{\simeq}:B(x) \simeq B(x)
          %h4#using_function_application_and_russell_universes_2 Using function application and Russell universes
          %p
            Suppose that the dependent type theory uses a sequence of
            %a.existingWikiWord{:href => "/nlab/show/Russell+universes"} Russell universes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            to define types, instead of a separate type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p:a =_A b
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            across the type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mi A
                  %mo →
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} B:A \to U_i
            can be defined as the evaluation of the inductively defined function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}(B(a), B(b)):(B(a) =_{U_i} B(b)) \to (B(a) \simeq B(b))
          %p
            at the function application of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to the identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{U_i}(B, a, b, p):B(a) =_{U_i} B(b)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} transport
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{transport}(B, a, b, p) \equiv \mathrm{idtoequiv}(B(a), B(b))(\mathrm{ap}_{U_i}(B, a, b, p)):B(a) \simeq B(b)
          %h2#properties Properties
          %h3#transport_across_paths_2 Transport across paths
          %p
            The type of families of transport functions on a
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            is given by the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mi x
                  %msubsup
                    %mo =
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi p
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{p:\mathbb{I} \to A} \sum_{f:B(p(0)) \to B(p(1))} \prod_{x:B(p(0))} x =_{x:A.B(x)}^{p} f(x)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msubsup
                    %mo =
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi p
                  %mi y
                %annotation{:encoding => "application/x-tex"} x =_{x:A.B(x)}^{p} y
            is an
            %a.existingWikiWord{:href => "/nlab/show/indexed+heterogeneous+identity+type"} indexed heterogeneous identity type
            defined using paths.
          %p In general, a family of transport functions is an element of this type. However, any element of the type of families of transport functions is unique up to identification:
          %p
          .num_theorem
            %h6 Theorem
            %p The type of families of transport functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mo :
                        %mi 𝕀
                        %mo →
                        %mi A
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi x
                    %msubsup
                      %mo =
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi p
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{p:\mathbb{I} \to A} \sum_{f:B(p(0)) \to B(p(1))} \prod_{x:B(p(0))} x =_{x:A.B(x)}^{p} f(x)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
          %p
          .proof
            %h6 Proof
            %p We first show that the type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi x
                    %msubsup
                      %mo =
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi p
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{f:B(p(0)) \to B(p(1))} \prod_{x:B(p(0))} x =_{x:A.B(x)}^{p} f(x)
            %p
              is contractible for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p:\mathbb{I} \to A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/path+induction"} path induction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi x
                    %msubsup
                      %mo =
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %mi 𝕀
                        %mo .
                        %mi a
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{f:B(a) \to B(a)} \prod_{x:B(a)} x =_{x:A.B(x)}^{\lambda i:\mathbb{I}.a} f(x)
            %p
              is contractible for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msubsup
                      %mo =
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %mi 𝕀
                        %mo .
                        %mi a
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo =
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x =_{x:A.B(x)}^{\lambda i:\mathbb{I}.a} f(x)) \simeq (x =_{B(a)} f(x))
            %p and thus by the typal congruence rules for dependent function types and dependent pair types, there is an equivalence of types
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi f
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi x
                      %msubsup
                        %mo =
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                          %mo .
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi λ
                          %mi i
                          %mo :
                          %mi 𝕀
                          %mo .
                          %mi a
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi f
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi x
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left(\sum_{f:B(a) \to B(a)} \prod_{x:B(a)} x =_{x:A.B(x)}^{\lambda i:\mathbb{I}.a} f(x)\right) \simeq \left(\sum_{f:B(a) \to B(a)} \prod_{x:B(a)} x =_{B(a)} f(x)\right)
            %p Now,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi x
                    %msub
                      %mo =
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{f:B(a) \to B(a)} \prod_{x:B(a)} x =_{B(a)} f(x)
            %p
              is just the
              %a.existingWikiWord{:href => "/nlab/show/type+of+identity+functions"} type of identity functions
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(a)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi x
                    %msubsup
                      %mo =
