          %h3#affine_serres_theorem Affine Serre’s theorem
          %p
            %a.existingWikiWord{:href => "/nlab/show/affine+Serre%27s+theorem"} Affine Serre's theorem
          %p
            Given a commutative unital ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            there is an equivalence of categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi R
                  %mi Mod
                  %mo →
                  %mi Qcoh
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {}_R Mod\to Qcoh(Spec R)
            between the category of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi Spec
                        %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{Spec R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ↦
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} M\mapsto \tilde{M}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde{M}
            is the unique sheaf such that the restriction on the principal Zariski open subsets is given by the localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo ⊗
                    %mi R
                  %mi M
                %annotation{:encoding => "application/x-tex"} \tilde{M}(D_f) = R[f^{-1}]\otimes_R M
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi f
                %annotation{:encoding => "application/x-tex"} D_f
            is the principal Zariski open set underlying
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Spec R[f^{-1}]\subset Spec R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi Spec
                      %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{Spec R}
            is defined using a similar description of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi Spec
                        %mi R
                    %mo =
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{Spec R} = \tilde{R}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ↦
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}\mapsto\mathcal{F}(Spec R)
