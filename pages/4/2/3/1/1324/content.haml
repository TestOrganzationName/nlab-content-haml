          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{K(n)\}
            be the sequence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associahedron"} Stasheff associahedra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            enriched over
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            called the
            %strong topological Stasheff associahedra operad
            or simply the
            = succeed "." do
              %strong Stasheff operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(n)
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad.
          %p
            The original article that defines associahedra, and in which the operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is used implicitly to define
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed ")." do
              %a{:href => "#Stasheff"} Stasheff
          %p
            A textbook discussion (slightly modified) is in
            %a{:href => "#MarklShniderStasheff"} MarklShniderStasheff, section 1.6
          %h3#properties Properties
          %p
            Stasheff’s
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/Boardman-Vogt+resolution"} Boardman-Vogt resolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi I
                    %mo *
                  %mo →
                  %mi Assoc
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W([0,1], I_* \to Assoc)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mo *
                %annotation{:encoding => "application/x-tex"} I_*
            is the operad for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            = succeed "." do
              %a{:href => "#BergerMoerdijk"} BergerMoerdijk
          %h2#the_little_cubes_operad
            The little
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒞
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_1(n)
            denote the configuration space of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            disjoint intervals linearly embedded in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi 𝒞
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\mathcal{C}_1(n)\}
            an operad structure, called the
            = succeed ";" do
              %strong little 1-cubes operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad. This is a special case of the
            %a.existingWikiWord{:href => "/nlab/show/little+n-cubes+operad"} little n-cubes operad
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-n+operad"} operad
          %p
            The little
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a{:href => "#May"} The geometry of iterated loop spaces
          %h2#the_standard_dg_operad
            The standard dg-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad
          %p
            The
            %strong
              standard dg-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
              operad
            is the dg-operad (that is, operad enriched in
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch^\bullet(Vect)
          %ul
            %li
              %p
                freely generated from one
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n \geq 1
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo −
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 2 - n
            %li
              %p
                with the differential of the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi j
                          %mo +
                          %mi p
                          %mo +
                          %mi q
                          %mo =
                          %mi n
                        %mrow
                          %mn 1
                          %mo &lt;
                          %mi p
                          %mo &lt;
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi j
                          %mi p
                          %mo +
                          %mi q
                      %msub
                        %mi a
                        %mrow
                          %mi p
                          %mo ,
                          %mi j
                          %mo ,
                          %mi n
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \-
                      \\sum_{j+p+q = n}^{1 \lt p \lt n} (-1)^{j p + q} a_{p,j,n} ,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi p
                          %mo ,
                          %mi j
                          %mo ,
                          %mi n
                    %annotation{:encoding => "application/x-tex"} a_{p,j,n}
                is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi p
                    %annotation{:encoding => "application/x-tex"} f_p
                attached to the
                = succeed "st" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (j+1)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %mi n
                            %mo −
                            %mi p
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} f_{n-p+1}
          %p
            This can be shown to be a standard free resolution of the linear associative operad in the context of dg-operads; see
            = succeed "," do
              %a{:href => "http://arxiv.org/abs/hep-th/9411208"} Markl 94
            = succeed ";" do
              %a{:href => "http://arxiv.org/PS_cache/hep-th/pdf/9411/9411208v1.pdf#page=13"} proposition 3.3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad.
          %p
            It can also be shown to be
            %em isomorphic
            to the operad of top-dimensional (cellular) chains on the topological Stsheff associahedra operad. This is discussed on
            %a{:href => "http://arxiv.org/PS_cache/hep-th/pdf/9411/9411208v1.pdf#page=26"} pages 26-27
            of
            %a{:href => "http://arxiv.org/abs/hep-th/9411208"} Markl 94
          %p
            In the dg-context it is especially common to say ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            \-algebra’ and ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            \-category’ to mean specifically algebras and categories over
            %em this
            operad. The explicit description of this operad given above means that such
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p In addition to
          %ul
            %li
              Martin Markl,
              %em Models for operads
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9411208"}> arXiv
              )
          %p another reference is section 1.18 of
          %ul
            %li
              Yu. Bespalov, V. Lyubashenko, O. Manzyuk,
              = succeed "," do
                %em
                  Pretriangulated
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
              = succeed ")" do
                %a{:href => "http://www.math.ksu.edu/~lub/cmcMonad.gz"} ps.gz
          %p
            A relation of the linear dg-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad to the Stasheff associahedra is in the proof of proposition 1.19 in Bespalov et al.
          %h2#the_standard_categorical__operad
            The standard categorical
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            be the operad in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            freely generated by a single binary operation and a single nullary operation. Thus, the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            are ways to associate, and add units to, a product of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            things. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(n)
            be the
            %a.existingWikiWord{:href => "/nlab/show/indiscrete+category"} indiscrete category
            on the set
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            operad in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal categories
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategories
          %p
            If instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            we use the
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %em unbiased
            monoidal categories and bicategories.
