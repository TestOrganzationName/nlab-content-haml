          %h2#idea Idea
          %p
            A simulation is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebras for an endofunctor
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F\colon C \to C
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta\colon X \to F(X)
          .un_defn
            %h6#definition_2 Definition
            %p
              Given two coalgebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X, X'
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %strong simulation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X'
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} s\colon X \to X'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi θ
                      %mo =
                      %mi θ
                      %mo ′
                      %mo ∘
                      %mi s
                    %annotation{:encoding => "application/x-tex"} F(s) \circ \theta = \theta' \circ s
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commutative+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi θ
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi s
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi X
                            %mo ′
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi θ
                                %mo ′
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array {
                    X &amp; \overset{\theta}\to &amp; F(X) \\
                    \\llap{s}\downarrow &amp; &amp; \downarrow\rlap{F(s)} \\
                    X' &amp; \underset{\theta'}\to &amp; F(X')
                    }
          %p
            The terminology comes from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
          %h2#examples Examples
          %h3#relations Relations
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            and the (covariant)
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta\colon X \to \mathcal{P}(X)
            %a.existingWikiWord{:href => "/nlab/show/binary+relation"} binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≺
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \prec b
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            %strong precedes
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in \theta(b)
          %p
            Then in concrete terms, a simulation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ′
                %annotation{:encoding => "application/x-tex"} X'
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi X
                  %mo ′
                %annotation{:encoding => "application/x-tex"} s\colon X \to X'
            such that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ≺
                    %mo ′
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(a) \prec' s(b)
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≺
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \prec b
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t = s(a)
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≺
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \prec b
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ≺
                      %mo ′
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t \prec' s(b)
          %p
            Simulations are commonly used as morphisms between sets equipped with
            %a.existingWikiWord{:href => "/nlab/show/well+founded+relation"} well-founded
            or
            %a.existingWikiWord{:href => "/nlab/show/extensional+relation"} extensional
            relations. In particular, between
            %a.existingWikiWord{:href => "/nlab/show/well-ordered+sets"} well-ordered sets
            (sets equipped with relations that are both well-founded and extensional, as well as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            %a.existingWikiWord{:href => "/nlab/show/poset"} ordered
            %a.existingWikiWord{:href => "/nlab/show/proper+class"} class
            of
            %a.existingWikiWord{:href => "/nlab/show/ordinal+numbers"} ordinal numbers
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin category
          %h3#open_maps_in_algebraic_set_theory Open maps in algebraic set theory
          %p
            In their book
            = succeed "," do
              %em Algebraic Set Theory
          %p
            The
            %span.newWikiWord
              category of forests
              %a{:href => "/nlab/new/category+of+forests"} ?
            is by definition the
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} category of presheaves
            over the first infinite ordinal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a diagram of sets and functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mi n
                  %mo →
                  %mi …
                  %mo →
                  %msub
                    %mi F
                    %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} \ldots \to F_{n+1} \to F_n \to \ldots \to F_1 \to F_0.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %msub
                    %mi F
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} y \in F_{n+1}
            maps to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in F_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            a
            %strong predecessor
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            The successor map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi ω
                  %mo →
                  %mi ω
                %annotation{:encoding => "application/x-tex"} s: \omega \to \omega
            induces a pullback functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mo *
                  %mo =
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi s
                        %mi op
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi ω
                        %mi op
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi ω
                        %mi op
                  %mo .
                %annotation{:encoding => "application/x-tex"} s^\ast = Set^{s^{op}}: Set^{\omega^{op}} \to Set^{\omega^{op}}.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            be the covariant power-object functor on the presheaf
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            carries a canonical coalgebra structure over the endofunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msup
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P s^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mi F
                  %mo →
                  %mi P
                  %msup
                    %mi s
                    %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} \theta_F \to P s^\ast F
            that corresponds to the subobject
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ↪
                  %mi F
                  %mo ×
                  %msup
                    %mi s
                    %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} R \hookrightarrow F \times s^\ast F
          %p
            where the subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi n
                %annotation{:encoding => "application/x-tex"} R_n
            is the set of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi F
                    %mi n
                  %mo ×
                  %msub
                    %mi F
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} (x, y) \in F_n \times F_{n+1}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is an immediate predecessor of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \phi: F \to G
            is a map of forests, in other words if the functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi n
                  %mo :
                  %msub
                    %mi F
                    %mi n
                  %mo →
                  %msub
                    %mi G
                    %mi n
                %annotation{:encoding => "application/x-tex"} \phi_n: F_n \to G_n
            collectively preserve the predecessor relation, then we have an inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mover
                            %mo →
                            %mi ϕ
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi θ
                                  %mi F
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ≤
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi θ
                                  %mi G
                      %mtr
                        %mtd
                          %mi P
                          %msup
                            %mi s
                            %mo *
                          %mi F
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi P
                              %msup
                                %mi s
                                %mo *
                              %mi ϕ
                        %mtd
                          %mi P
                          %msup
                            %mi s
                            %mo *
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F &amp; \stackrel{\phi}{\to} &amp; G \\
                  ^\mathllap{\theta_F} \downarrow &amp; \leq &amp; \downarrow^\mathrlap{\theta_G} \\
                  P s^\ast F &amp; \underset{P s^\ast \phi}{\to} &amp; P s^\ast G
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            comes from the internal poset structure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msup
                      %mi s
                      %mo *
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P s^\ast G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is a coalgebra map or simulation over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msup
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P s^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is
            = succeed "." do
              %em open
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is open if the maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \phi_n
            collectively preserve and reflect the predecessor relation.
          %p
            Pursuing this more concretely: the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mi G
                  %mo ∘
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \theta_G \circ \phi
            corresponds to the subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ×
                  %msup
                    %mi s
                    %mo *
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \times s^\ast G
            occurring in the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi S
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi R
                            %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi F
                          %mo ×
                          %msup
                            %mi s
                            %mo *
                          %mi G
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi ϕ
                              %mo ×
                              %mn 1
                        %mtd
                          %mi G
                          %mo ×
                          %msup
                            %mi s
                            %mo *
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S &amp; \to &amp; R_G \\
                  \\downarrow &amp; &amp; \downarrow \\
                  F \times s^\ast G &amp; \underset{\phi \times 1}{\to} &amp; G \times s^\ast G
                  }
          %p
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                  %mo ⊆
                  %msub
                    %mi F
                    %mi n
                  %mo ×
                  %msub
                    %mi G
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S_n \subseteq F_n \times G_{n+1}
            consists of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is a predecessor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi_n(x)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msup
                    %mi s
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mi θ
                    %mi F
                %annotation{:encoding => "application/x-tex"} P s^\ast(\phi) \circ \theta_F
            corresponds to the subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ×
                  %msup
                    %mi s
                    %mo *
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \times s^\ast G
            occurring in an image factorization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi R
                            %mi F
                        %mtd
                          %mo ↠
                        %mtd
                          %mi S
                          %mo ′
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi F
                          %mo ×
                          %msup
                            %mi s
                            %mo *
                          %mi F
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mn 1
                              %mo ×
                              %msup
                                %mi s
                                %mo *
                              %mi ϕ
                        %mtd
                          %mi F
                          %mo ×
                          %msup
                            %mi s
                            %mo *
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  R_F &amp; \twoheadrightarrow &amp; S' \\
                  \\downarrow &amp; &amp; \downarrow \\
                  F \times s^\ast F &amp; \underset{1 \times s^\ast \phi}{\to} &amp; F \times s^\ast G
                  }
          %p
            so that (taking advantage of the fact that image factorizations in a presheaf topos are computed objectwise)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                  %mo ′
                  %mo ⊆
                  %msub
                    %mi F
                    %mi n
                  %mo ×
                  %msub
                    %mi G
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S_{n}' \subseteq F_n \times G_{n+1}
            consists of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo ,
                  %mi y
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x', y')
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ′
                  %mo =
                  %msub
                    %mi ϕ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi y
                %annotation{:encoding => "application/x-tex"} y' = \phi_{n+1} y
            for some predecessor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
