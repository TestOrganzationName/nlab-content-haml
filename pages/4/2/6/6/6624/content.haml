          %title Simulations
          %h1#simulations Simulations
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#relations"} Relations
                %li
                  %a{:href => "#open_maps_in_algebraic_set_theory"} Open maps in algebraic set theory
              %li
