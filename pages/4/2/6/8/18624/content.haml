                    %mo ×
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} ev \colon  [\Sigma, X] \times \Sigma \to X
              with
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          #EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces.num_prop
            %h6#proposition Proposition
            %p
              The two definitions of transgression of differential forms to mapping spaces from def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpaces"}
              and def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              are equivalent.
          .proof
            %h6#proof Proof
            %p
              We need to check that for all plots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma \colon U \to [\Sigma, X]
              the pullbacks of the two forms to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              coincide.
            %p
              For def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi γ
                      %mo *
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi Σ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma^\ast \int_\Sigma \mathrm{ev}^\ast A
                    \=
                    \\int_\Sigma (\gamma,\mathrm{id}_\Sigma)^\ast \mathrm{ev}^\ast A
                    \\;
                    \\in \Omega^n(U)
            %p
              Here we recognize in the integrand the pullback along the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
