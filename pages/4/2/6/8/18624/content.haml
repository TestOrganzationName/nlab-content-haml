          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            on some
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and given a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \tau_\Sigma \omega
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo −
                  %mi k
                %annotation{:encoding => "application/x-tex"} n-k
            on the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
            of smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Phi_u \colon \Sigma \to X
            is the result of first forming the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
            and then forming the
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            of the result over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tau_{\Sigma} \omega\vert_{\Phi_{(-)}}
                  \\coloneqq
                  \\int_\Sigma (\Phi_{(-)})^\ast \omega
                  \\,.
          %p
            This differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \tau_\Sigma \omega
            on the mapping space is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            This construction has a variety of immediate generalizations, for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            may have
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} corners
            %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            and/or a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/formal+manifold"} formal manifold
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            may be generalized to a
            %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            of a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %p
            Important examples of transgression of differential forms appear in
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            (in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian form
            on the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a.existingWikiWord{:href => "/nlab/show/jet+prolongations"} jet prolongations
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange variational derivative
            is the 1-form whose vanishing is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            and the transgression of the induced
            %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+current"} pre-symplectic current
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+form"} pre-symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            of the field theory. These examples are discussed below at
            = succeed "." do
              %em
                %a{:href => "#TransgressionOfVariationalDifferentialForms"} Transgression of variational differential forms
          %h2#definition Definition
          %p
            There are two definitions of transgression of differential forms: A traditional formulation is def.
            %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
            below, which transgresses by
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            along the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
          %p
            Another definition is useful, which makes more use of the existence of smooth classifying spaces for differential forms in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.maruku-ref{:href => "#ParameterizedIntegrationOfDifferentialForms"}
            below.
          %p
            That these two definitions are indeed equivalent is the content of prop.
            %a.maruku-ref{:href => "#EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces"}
            below
          %h3#preliminaries_on_smooth_sets Preliminaries on smooth sets
          %p
            Since the concept of transgression of differential forms involves
            %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            between, in particular,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+spaces"} generalized smooth spaces
            called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            as introduced in
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} geometry of physics – smooth sets
            %li
              %p
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+differential+forms"} geometry of physics – differential forms
                \.
          %p
            (This entry itself here overlaps with
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+integration"} geometry of physics – integration
          %p
            Recall form the discussion there that a
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em defined
            by specifying, in a consistent way, what counts as a smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \to X
            from a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (a “plot” of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            then a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
            is a function that takes plots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mover
                    %mo →
                    %mi ϕ
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \overset{\phi}{\to} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to plots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \circ \phi \colon U \to Y
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            A key example of a smooth set which is in general not a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,Y]
            between two smooth sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            equipped with a smooth structure itself. Namely a plot
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi_{(-)} \colon U \to [X,Y]
            is defined to be a smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo ×
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \phi_{(-)}(-) \colon U \times X \to Y
            out of the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            An example of a smooth set which is far from being a smooth manifold is for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            the smooth set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^n
            which is the “smooth
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
