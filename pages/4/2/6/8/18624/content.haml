                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (-)\times \Sigma \dashv [\Sigma,-])
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
