                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \tau_{\Sigma}\omega\vert_{\phi_(-)}
                    \&amp; =
                    d_U \int_\Sigma (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    (-1)^k \int_\Sigma d_U (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    (-1)^k \int_\Sigma (d - d \Sigma) (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    (-1)^k \int_\Sigma d (\phi_{(-)}(-))^\ast \omega
                    \-
                    (-1)^k \int_\Sigma d_\Sigma (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    (-1)^k \int_\Sigma (\phi_{(-)}(-))^\ast \underset{= 0}{\underbrace{d \omega}}
                    \-
                    (-1)^k \int_\Sigma d_\Sigma (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    \-
                    (-1)^k \int_\Sigma d_\Sigma (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    \-(-1)^k \int_{\partial \Sigma} (\phi_{(-)}(-))^\ast \omega
                    \\\
                    \&amp; =
                    \-(-1)^k \tau_{\partial \Sigma} \omega \vert_{\phi_{(-)}}
                    \\end{aligned}
            %p
              where in the second but last step we used
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
          %h3#variational_transgression_picks_out_the_vertical_differential_forms Variational transgression picks out the vertical differential forms
          .num_example
            %h6#example Example
            %p
              %strong (some transgressions of variational differential forms)
            %p
              We spell out the result transgression of variational differential forms (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of a trivial vector field bundle to the
              %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              of fields (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Fields"}
            %p We describe the resulting transgressed differential forms restricted to any smooth family of field configurations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_{(-)} \;\colon\; U \times \Sigma \longrightarrow E
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\Sigma)
              be any
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              on spacetime. Its product with the
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              (as in example
              = succeed ")" do
                %a.maruku-ref{:href => "#BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle"}
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    b dvol_\Sigma \in \Omega^{0,0}_{\Sigma,cp}(E)
            %p
              The transgression of this 0-form to the
              %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
              of fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma (b dvol_\Sigma) \in \Omega^0( \Gamma_\Sigma(E) )
            %p
              is the differential form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              which restricted to the given family of field configurations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi u
                    %mo ↦
                    %msub
                      %mi Φ
                      %mi u
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)} \colon u \mapsto \Phi_u
              yields the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi Φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi u
                    %mo ↦
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma (b dvol_\Sigma)\vert_\Phi \colon u \mapsto \int_\Sigma b dvol_\Sigma
            %p
              which is simply the constant function with value the integral of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              against the given volume form.
            %p
              The constancy of this function is due to the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} b dvol_\Sigma
              does not depend on the field variables. So consider next the horizontal
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^a \, b dvol_\Sigma \; \in \Omega^{p+1,0}( E )
                    \\,.
            %p Its transgression is the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi u
                      %mo ↦
                      %msub
                        %mo ∫
                        %mi Σ
                      %msubsup
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma( \phi^a \, b dvol_\Sigma  )_\Phi
                    \\;=\;
                    \\left(
                    u
                    \\mapsto
                    \\int_\Sigma \Phi^a_{(u)}(x)  b(x) dvol_\Sigma(x)
                    \\right)
            %p
              which assigns to a given field configuration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi u
                  %annotation{:encoding => "application/x-tex"} \Phi_{u}
              in the family the value its
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} b dvol_\Sigma
            %p
              Similarly the transgression of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \phi^a_{,\mu}
              is the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi u
                      %mo ↦
                      %msub
                        %mo ∫
                        %mi Σ
                      %mfrac
                        %mrow
                          %mo ∂
                          %msubsup
                            %mi Φ
                            %mi u
                            %mi a
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma( \phi^a_{,\mu} \, b dvol_\Sigma  )_\Phi
                    \\;=\;
                    \\left(
                    u
                    \\mapsto
                    \\int_\Sigma \frac{\partial \Phi^a_{u}}{\partial x^\mu}  b(x) dvol_\Sigma(x)
                    \\right)
            %p
              which assigns to a field configuration the integral of the value of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} b dvol_\Sigma
            %p Next consider a horizontally exact variational form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi α
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \alpha \in \Omega^{p+1,s}_{\Sigma,cp}(E)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
              the pullback of this form along the jet prolongation of fields is exact in the
              = succeed "-direction:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi α
                    %mo ∧
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi d
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi α
                    %mo ∧
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (j^\infty_\Sigma\Phi_{(-)})^\ast(d \alpha  \wedge b dvol_\Sigma) = d_\Sigma (j^\infty_\Sigma\Phi_{(-)})^\ast\alpha \wedge b dvol_\Sigma
                    \\,,
            %p
              (where we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mo +
                    %msub
                      %mi d
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} d = d_U + d_\Sigma
              for the de Rham differential on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} U \times \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              vanishes.
            %p Now let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi α
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \alpha \phi^a_{,\mu_1 \cdots \mu_k} \, b dvol_\Sigma
                    \\in
                    \\Omega^{p+1,1}_\Sigma(E)
            %p
              be a variational (vertical) differential 1-form. Its
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo →
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma(\Phi_{(-)}) \colon U \times \Sigma \to J^\infty_\Sigma(E)
              has two contributions: one from the variation along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
              %em fixed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} u \in U
              the pullback along the jet prolongation vanishes.
            %p
              On the other hand, for fixed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} s \in \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msubsup
                      %mi ϕ
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \mathbf{d} \phi^a_{\mu_1\cdots \mu_k}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi U
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mi k
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msup
                              %mi μ
                              %mn 1
                        %mi ⋯
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mi k
                  %annotation{:encoding => "application/x-tex"}
                    d_U \frac{ \partial^k \Phi_{(-)}}{\partial x^{\mu^1} \cdots \partial x^{\mu_k}}
            %p
              while the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msubsup
                      %mi ϕ
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                  %annotation{:encoding => "application/x-tex"} d \phi^a_{\mu_1\cdots \mu_k}
              vanishes at fixed
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p This means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mrow
                        %msub
                          %mo
                          %mi μ
                        %msub
                          %mo
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma( \delta \phi^a_{,\mu_1 \cdots \mu_k} )
                    \=
                    d \tau_{\Sigma}( \phi^a_{_\mu_1 \cdots \mu_k} )
            %p
              is the de Rham differential (on
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p In conclusion:
            %p
              Under transgression the variational (vertical) derivative on the jet bundle turns into the ordinary de Rham derivative on the
              %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
              of fields.
          %h2#examples Examples
          %p We discuss some examples and applications:
          %ul
            %li
              %p
                %a{:href => "#GaugeCouplingActionFunctionalOfChargedParticle"} Gauge coupling action functional of charged particle
            %li
              %p
                %a{:href => "#TransgressionOfKillingFormToSymplecticFormOfChernSimons"} Transgression of Killing form to symplectic form of Chern-Simons theory
          %h3#GaugeCouplingActionFunctionalOfChargedParticle Gauge coupling action functional of charged particle
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            and consider a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}U(1)_{conn}
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a{:href => "#DiracChargeQuantizationAndElectromagneticField"} Dirac charge quantization and the electromagnetic field
            above this encodes an
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            is trivialized, so that then the connection is equivalently given by a differential 1-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo =
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\nabla = A \;\colon\; X \to \mathbf{\Omega}^1
                  \\,,
          %p
            the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+potential"} electromagnetic potential
          %p
            Let then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma = S^1
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the electromagnetic potential to the
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi S
                        %mn 1
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                  %msup
                    %mi Ω
                    %mn 0
                  %mo ≃
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\int_{S^1} [S^1, A]
                  \\;\colon\;
                  [S^1, X]
                  \\stackrel{[S^1, A]}{\to}
                  [S^1 , \Omega^1]
                  \\stackrel{\int_{S^1}}{\to}
                  \\Omega^0
                  \\simeq
                  \\mathbb{R}
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for an
            %a.existingWikiWord{:href => "/nlab/show/electron"} electron
            or other electrically charged
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            in the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi em
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S_{em} = \int_{S^1} [S^1, A]
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variation
            of this contribution in addition to that of the
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            of the electron gives the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
            law describing the
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            exerted by the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            on the electron.
          %h3#TransgressionOfKillingFormToSymplecticFormOfChernSimons Transgression of Killing form to symplectic form of Chern-Simons theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            with binary
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⊗
                    %mi 𝔤
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle \colon \mathfrak{g} \otimes \mathfrak{g} \to \mathbb{R}
          %p
            For instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            could be a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo =
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathfrak{su}(n)
            is a
            %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
            such as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+Lie+algebra"} special unitary Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            of the product of two matrices.
          %p
            This pairing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            defines a differential 4-form on the
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued 1-forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo ⊗
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                  %msup
                    %mi Ω
                    %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_{(-)} \wedge F_{(-)} \rangle
                  \\colon
                  \\Omega^1(-,\mathfrak{g})
                  \\stackrel{F_{(-)}}{\to}
                  \\Omega^2(-, \mathfrak{g})
                  \\stackrel{(-)\wedge (-)}{\to}
                  \\Omega^4(-, \mathfrak{g}\otimes \mathfrak{g})
                  \\stackrel{\langle-,-\rangle}{\to}
                  \\Omega^4
          %p
            Over a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+patch"} coordinate patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            this sends a differential 1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U)
            to the differential 4-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \wedge F_A \rangle \in \Omega^4(U)
                  \\,.
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, - \rangle
            is indeed an
            %em
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            means that this indeed extends to a 4-form on the smooth
            %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra+valued+forms"} groupoid of Lie algebra valued forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mi Ω
                    %mn 4
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_{(-)} \wedge F_{(-)}\rangle
                  \\colon
                  \\mathbf{B}G_{conn}
                  \\to
                  \\Omega^4
                  \\,.
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the above 4-form to the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            yields the 2-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟩
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ∫
                        %mi Σ
                  %msup
                    %mi Ω
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\omega
                  \\coloneqq
                  \\int_{\Sigma} \langle F_{(-)}\wedge F_{(-)}\rangle
                  \\colon
                  \\mathbf{\Omega}^1(\Sigma,\mathfrak{g})
                  \\hookrightarrow
                  [\Sigma, \mathbf{B}G_{conn}]
                  \\stackrel{[\Sigma, \langle F_{(-)}\wedge F_{(-)}\rangle]}{\to}
                  [\Sigma, \Omega^4]
                  \\stackrel{\int_{\Sigma}}{\to}
                  \\Omega^2
          %p
            to the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued 1-forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            Over a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U = \mathbb{R}^n \in
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \mathbf{\Omega}^1(\Sigma,\mathfrak{g})(\mathbb{R}^n)
            is a
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %mi U
                %annotation{:encoding => "application/x-tex"} \Sigma \times U
            with no leg along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form therefore decomposes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mo =
                  %msubsup
                    %mi F
                    %mi A
                    %mi Σ
                  %mo +
                  %mi δ
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F_A = F_A^{\Sigma} + \delta A
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi F
                    %mi A
                    %mi Σ
                %annotation{:encoding => "application/x-tex"} F_A^{\Sigma}
            is the curvature component with all legs along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mi A
                  %mo ≔
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mi A
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  \\delta A
                  \\coloneqq
                  \- \sum_{i = 1}^n \frac{\partial}{\partial x^i} A \wedge \mathbf{d}x^i
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational
            derivative of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p This means that in the 4-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msubsup
                    %mi F
                    %mi A
                    %mi Σ
                  %mo ∧
                  %msubsup
                    %mi F
                    %mi A
                    %mi Σ
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %msubsup
                    %mi F
                    %mi A
                    %mi Σ
                  %mo ∧
                  %mi δ
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mo{:stretchy => "false"} ⟨
                  %mi δ
                  %mi A
                  %mo ∧
                  %mi δ
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \wedge F_A\rangle
                  \=
                  \\langle F_A^\Sigma \wedge F_A^\Sigma \rangle
                  +
                  2 \langle F_A^\Sigma \wedge \delta A\rangle
                  +
                  \\langle \delta A \wedge \delta A\rangle
                  \\in
                  \\Omega^4(\Sigma \times U)
          %p
            only the last term gives a 2-form contribution on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} ⟨
                  %mi δ
                  %mi A
                  %mo ∧
                  %mi δ
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega = \int_\Sigma \langle \delta A \wedge \delta A\rangle
                  \\colon
                  \\mathbf{\Omega}^1(\Sigma, \mathfrak{g})
                  \\to
                  \\Omega^2
                  \\,.
          %p When restricted further to flat forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %msup
                          %mi Ω
                          %mn 1
                    %mi flat
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\Omega^1}_{flat}(\Sigma,\mathfrak{g})
                  \\hookrightarrow
                  \\mathbf{\Omega^1}(\Sigma,\mathfrak{g})
          %p
            which is the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            (by the discussion at
            = succeed ")." do
              %em
                %a{:href => "Chern-Simons+theory#CovariantPhaseSpace"} Chern-Simons theory – covariant phase space
