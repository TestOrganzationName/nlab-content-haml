                    \\mathbf{H}(U,[\Sigma,X])
                    \&amp;
                    \\overset{\mathbf{H}(U,[\Sigma,A])}{\longrightarrow}
                    \&amp;
                    \\mathbf{H}(U,[\Sigma,\mathbf{\Omega}^{n+k}])
                    \&amp;
                    \\overset{\mathbf{H}(U,\int_\Sigma)}{\longrightarrow}
                    \&amp;
                    \\mathbf{H}(U,\mathbf{\Omega}^n)
                    }
            %p
              (here we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(-,-)
              for the
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
              of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
          %h3#TransgressionOfVariationalDifferentialForms Transgression of variational differential forms
          %p
            An important variant of transgression of differential forms is the transgression of
            %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational differential forms
            along
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
          %p
            In the following let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a fixed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          #Fields.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                and their
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %em
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                of fields
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                        %mtr
                          %mtd
                            %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{E \\ \downarrow^{\mathrlap{fb}} \\ \Sigma }
            %p
              called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %p
              Given a type of fields on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              this way, then a
              %em
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
              (or
              = succeed ")" do
                %em field history
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a smooth
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi \colon \Sigma \longrightarrow E
            %p
              such that composed with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map it is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fb
                    %mo ∘
                    %mi Φ
                    %mo =
                    %mi id
                    %mphantom
                      %mi AAAAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi Φ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                        %mtr
                          %mtd
                            %mi Σ
                          %mtd
                            %mo =
                          %mtd
                            %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    fb \circ \Phi = id
                    \\phantom{AAAAAAA}
                    \\array{
                    \&amp;&amp; E
                    \\\
                    \&amp; {}^{\mathllap{\Phi}}\nearrow &amp; \downarrow^{\mathrlap{fb}}
                    \\\
                    \\Sigma &amp; = &amp; \Sigma
                    }
                    \\,.
            %p
              The corresponding
              %em
                field
                %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
              is the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of all these
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_\Sigma(E) \in \mathbf{H}
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              by declaring that a smooth family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              of field configurations, parameterized over any
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi Φ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Φ
                              %mi u
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times \Sigma &amp;\overset{\Phi_{(-)}(-)}{\longrightarrow}&amp; E
                    \\\
                    (u,x) &amp;\mapsto&amp; \Phi_u(x)
                    }
            %p
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} u \in U
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %msub
                        %mi Φ
                        %mi u
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi id
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} p \circ \Phi_{u}(-) = id_\Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Φ
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 2
                          %mtd
                            %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; E
                    \\\
                    \&amp; {}^{\mathllap{\Phi_{(-)}(-)}}\nearrow &amp; \downarrow^{\mathrlap{fb}}
                    \\\
                    U \times \Sigma &amp;\underset{pr_2}{\longrightarrow}&amp; \Sigma
                    }
                    \\,.
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              of spacetime. We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} N_\Sigma(S) \hookrightarrow \Sigma
              for its
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              then the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/space+of+histories"} space of histories
                  of fields restricted to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi N
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi N
                          %mi Σ
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{S}(E) \coloneqq \Gamma_{N_\Sigma(S)}( E\vert_{N_\Sigma S} ) \in \mathbf{H}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              restricted to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N_\Sigma(S)
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            #eq:FieldEvaluation.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mi Σ
                    %mi S
                    %mo ×
                    %msub
                      %mi Γ
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    ev_S
                    \\;\colon\;
                    N_\Sigma S \times \Gamma_{S}(E)
                    \\longrightarrow
                    E
            %p
              which takes a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              consisting of an
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} element
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi Σ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} N_\Sigma S
              and a field configuration to the value of the field configuration at that point.
          #SpacetimeSupport.num_defn
            %h6#definition_6 Definition
            %p
              %strong (spacetime support)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \subset \Sigma
              let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi S
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %msub
                                  %mi ι
                                  %mi S
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J^\infty_\Sigma(E)\vert_S
                    \&amp;\overset{\iota_S}{\hookrightarrow}&amp;
                    J^\infty_\Sigma(E)
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    S &amp;\hookrightarrow&amp; \Sigma
                    }
            %p
              be the corresponding restriction of the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              The
              %em spacetime support
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi supp
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp_\Sigma(A)
              of a
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^\bullet(J^\infty_\Sigma(E))
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of the maximal subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \subset \Sigma
              such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the jet bundle restrited to this subset vanishes:
            .maruku-equation
