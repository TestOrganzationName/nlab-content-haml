          %h3#via_pullback_along_the_evaluation_map Via pullback along the evaluation map
          #TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap.num_defn
            %h6#definition_4 Definition
            %p
              %strong (transgression of differential forms to mapping space via evaluation map)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              Then the operation of
              %em
                transgression of differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi ev
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi ev
                          %mo *
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∫
                          %mi Σ
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma
                    \\coloneqq
                    \\int_\Sigma ev^\ast
                    \\;\colon\;
                    \\Omega^n(X)
                    \\overset{ev^\ast}{\longrightarrow}
                    \\Omega^n(\Sigma \times [\Sigma, X])
                    \\overset{\int_\Sigma}{\longrightarrow}
                    \\Omega^{n-k}([\Sigma,X])
            %p
              from differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              which is the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              of forming the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
