                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                  denote the left and right
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (Terminology)
              %br/
              Unfortunately, conventions on left and right vary and sometimes contradict their use for adjoints. A common convention is that a
              %em right dual
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A^*
              equipped with a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              (or
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coevaluation"} coevaluation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝟙
                    %mo →
                    %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    i \,\colon\, \mathbb{1} \to A \otimes A^*
            %p
              and
              %strong counit
              (or
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi A
                      %mo *
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"}
                    e \,\colon\, A^* \otimes A \to \mathbb{1}
            %p
              satisfying the ‘
              %a.existingWikiWord{:href => "/nlab/show/triangle+identities"}> triangle identities
              ’ familiar from
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            %p
              With this convention, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is interpreted as composition in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} C
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagrammatic+order"} diagrammatic order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              are the same as right adjoints in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}C
              — whereas if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is interpreted as composition in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} C
              in classical ‘Leibnizian’ order, then right duals in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              are the same as
              %em left
              adjoints in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} C
            %p
              Of course, in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          %p
          .num_remark
            %h6 Remark
            %p
              There are various equivalent definitions of dualizability, some of which are apparently weaker than the explicit definition in terms of both unit and counit, or which assume only one of them together with a
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              for it.
            %p
              Regarding the equivalent characterization via adjointable tensor products, beware Rem.
              %a.maruku-ref{:href => "#TensorAdjunctabilityDoesNotImplyDualizability"}
              below.
            %p
          #InvertibleObject.num_defn
            %h6#definition_3 Definition
            %p
              A dualizable object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#DualizableObject"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A \otimes A^\ast
              and the
              %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
              are
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              is called an
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/invertible+object"} invertible object
          #RigidAndCompactClosed.num_defn
            %h6#definition_4 Definition
            %p
              If every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has a left and right dual, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is called a
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
              or an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/autonomous+monoidal+category"} autonomous monoidal category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/category+with+duals"} category with duals
            for more discussion.
          .num_defn
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              between two dualizable objects in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Y
                      %mo *
                    %mo →
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \colon Y^\ast \to X^\ast
            %p
              is the one obtained by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              by composing the duality unit, the counit and the
              = succeed "\u2026" do
                %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
          %h3#Examples Examples
          %p
          #FiniteDimensionalVectorSpaces.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+spaces"}> finite-dimensional vector spaces
                )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional vector space
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo *
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V^* = Hom(V,k)
              be its usual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi V
                      %mo *
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \varepsilon\colon V^* \otimes V \to k
              to be the obvious pairing. If we also choose a finite basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{v_i\}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi v
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{v_i^*\}
              be the
              %a.existingWikiWord{:href => "/nlab/show/dual+basis"} dual basis
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mo *
                    %annotation{:encoding => "application/x-tex"} V^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi k
                    %mo →
                    %mi V
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \eta\colon k \to V\otimes V^*
              by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi v
                        %mi i
                      %mo ⊗
                      %msubsup
                        %mi v
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \sum_i v_i \otimes v_i^*
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V^*
              is a dual of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Vect
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Vect_k
          %p
          #DualizableModules.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/dualizable+modules"}> dualizable modules
                )
              %br/
              More generally, in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
              = succeed "&rbrack;." do
                %a{:href => "#DoldPuppe84"} Dold &amp; Puppe 1984, Ex. 1.4
              %em
                %a.existingWikiWord{:href => "/nlab/show/dualizable+module"} dualizable module
              for more.
          %p
          #DualizableChainComplexes.num_remark
            %h6 Example
            %p
              %strong
                (dualizable
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              Yet more generally, in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              of
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              %a.existingWikiWord{:href => "/nlab/show/bounded+chain+complex"} bounded chain complex
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dualizable+modules"} dualizable modules
              = succeed ")" do
                %a.maruku-ref{:href => "#DualizableModules"}
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
              \&amp;lbrack;
              %a{:href => "#DoldPuppe84"}> Dold &amp; Puppe 1984, Prop. 1.6
              \&amp;rbrack;.
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+duality"}> Spanier-Whitehead duality
                )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a finite-dimensional
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/Whitney+embedding+theorem"} choose
              an
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} M\hookrightarrow \mathbb{R}^n
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(N X)
              be the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              of the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              of this embedding. Then the
              %a.existingWikiWord{:href => "/nlab/show/Thom+collapse"} Thom collapse
              map defines an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(N X)
              as a dual of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mo +
                      %mn ∞
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \Sigma_+^\infty M
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %em
                %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+duality"}> Spanier-Whitehead duality
                \.
          %p
          #AdjointEndofunctors.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
              %br/
              Given any
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathscr{C}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endo
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mtext Fun
                    %mo{:stretchy => "false"} (
                    %mi.mathscript 𝒞
                    %mo ,
                    %mi.mathscript 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(\mathcal{C}) \,\coloneqq\, \text{Fun}(\mathscr{C},\mathscr{C})
              canonically becomes a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              given by
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              and
              %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
              of
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              (
              %em>
                %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
              ).
            %p
              Under this identification, an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(\mathcal{C})
              is dualizable iff it is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              and
              %a.existingWikiWord{:href => "/nlab/show/co-evaluation"} co-evaluation
              given by the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+the+adjunction"} counit of the adjunction
              and the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+the+adjunction"} unit of the adjunction
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebras"}> Poincaré duality algebras
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
              if it is a dualizable object in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK
              with dual its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/opposite+algebra"} opposite algebra
            %p
              See at
              = succeed "." do
                %em
                  %a{:href => "KK-theory#PoincareDualityAndThomIsomorphism"} KK-theory – Poincare duality
          %p
          .num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-modules"} (∞,1)-category of (∞,1)-modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} E Mod
              the dualizable objects coincide with the
              %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perfect+objects"} perfect objects
            %p
              See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-modules"} (∞,1)-category of (∞,1)-modules
                –
                = succeed "-category+of+(\u221E,1)-modules#CompactGeneration)" do
                  %a{:href => "(∞,1\\"} Compact generation
              for more.
          %p
          .num_remark
            %h6 Example
            %p
              (
              %a{:href => "#Coulembier"}> Coulembier, Theorem 2.1.1
              \.) If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n\ge0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo !
                  %annotation{:encoding => "application/x-tex"} n!
              is invertible,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Lambda^n X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/invertible+object"} invertible object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is dualizable, with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo *
                      %mo ≅
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Λ
                        %mi n
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ⊗
                      %msup
                        %mi Λ
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X^*\cong(\Lambda^n X)^* \otimes \Lambda^{n-1}X
          %h3#properties Properties
          %h4#relation_to_adjunctable_tensor_products Relation to adjunctable tensor products
          %p
          #RelationToAdjunctableTensorProducts.num_prop
            %h6 Proposition
            %p
              In a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %ul
              %li
                %p
                  an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is dual to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mo *
                      %annotation{:encoding => "application/x-tex"} A^\ast
                  in the sense of Def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#DualizableObject"}
                  %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ev
                          %mi A
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi A
                          %mo *
                        %mo ⊗
                        %mi A
                        %mo →
                        %mi 𝟙
                      %annotation{:encoding => "application/x-tex"} ev_A \,\colon\, A^\ast \otimes A \to \mathbb{1}
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:EvaluationMap"} (1)
              %li
                %p the map
                #eq:HomIsoInducedByDualizability.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo ⊗
                        %msup
                          %mi A
                          %mo *
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mtext -
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi A
                            %mspace{:width => "thickmathspace"}
                        %mi Hom
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ⊗
                        %mi A
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo ⊗
                        %msup
                          %mi A
                          %mo *
                        %mo ⊗
                        %mi A
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi id
                              %mi Y
                            %mo ⊗
                            %msub
                              %mi ev
                              %mi A
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %mtext -
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                        %mi Hom
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ⊗
                        %mi A
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom\big( X,\, Y \otimes A^\ast \big)
                        \\xrightarrow{\;
                        (\text{-}) \otimes A
                        \\;}
                        Hom\big( X \otimes A ,\, Y \otimes A^\ast \otimes A \big)
                        \\xrightarrow{\;
                        id_Y \otimes ev_A \circ (\text{-})
                        \\;}
                        Hom\big( X \otimes A ,\, Y \big)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  (a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/hom+sets"} hom sets
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
            %p
          This is
          = succeed "." do
            %a{:href => "#DoldPuppe84"} Dold &amp; Puppe 1984, Thm. 1.3 (b) and (c)
          %p
          .num_remark
            %h6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#RelationToAdjunctableTensorProducts"}
              says
              %em in particular
              that for dual objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A^\ast
              the map
              %a.maruku-eqref{:href => "#eq:HomIsoInducedByDualizability"} (3)
              exhibits the tensor product
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (\text{-}) \otimes A^\ast
              as a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (\text{-}) \otimes A
              (hence: an
              = succeed "-functor):" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\text{-}) \otimes A
                    \\;\;
                    \\dashv
                    \\;\;
                    (\text{-}) \otimes A^\ast
                    \\,.
            %p
              If the ambient category is indeed
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal
              with
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              and unit denoted by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟙
                    %annotation{:encoding => "application/x-tex"} \mathbb{1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mtext -
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\text{-}) \otimes A^\ast \,\simeq\, [A,\text{-}]
              (by
              = succeed ")" do
                %a{:href => "adjoint+functor#UniquenessOfAdjoints"} essential uniqueness of adjoints
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝟙
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi 𝟙
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^\ast
                    \\;\simeq\;
                    \\mathbb{1} \otimes A^\ast
                    \\,\simeq\,
                    [A,\mathbb{1}]
                    \\,.
            %p
              But since (by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A \,\simeq\, (A^{\ast})^\ast
              is also the dual object to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A^\ast
            %ol
              %li
                %p
                  a
                  %em further
                  right adjoint to the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  (an “
                  %a.existingWikiWord{:href => "/nlab/show/amazing+right+adjoint"}> amazing right adjoint
                  ”)
              %li
                %p
                  which coincides with the left adjoint to make an
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\text{-}) \otimes A
                    \\;\;
                    \\dashv
                    \\;\;
                    (\text{-}) \otimes A^\ast
                    \\;\;
                    \\dashv
                    \\;\;
                    (\text{-}) \otimes A
                    \\,.
            %p
          %p
          #TensorAdjunctabilityDoesNotImplyDualizability.num_remark
            %h6 Remark
            %p
              %strong (Tensor-adjunctability does not imply dualizability)
              %br/
              Prop.
              %a.maruku-ref{:href => "#RelationToAdjunctableTensorProducts"}
              does
              %em not
              claim that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to be dualizable it is sufficient that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (\text{-}) \otimes A
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/counterexample"} counterexample
              is indicated by
              %a.existingWikiWord{:href => "/nlab/show/Noah+Snyder"} Noah Snyder
              in
              = succeed "," do
                %a{:href => "https://math.stackexchange.com/a/692318/58526"} math.SE:a/692318
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/1406.4204"} arXiv:1406.4204
              = succeed "." do
                %a{:href => "https://golem.ph.utexas.edu/category/2008/02/logicians_needed_now.html#c018187"} this n-Café discussion
          %h4#trace Trace
          %p
            Dualizable objects support a good abstract notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
          %h4#relation_to_cobordism_hypothesis Relation to cobordism hypothesis
          %p
            Dualizable objects in an
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            are already
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} fully dualizable objects
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            implies that there is a canonical
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} O(1) \simeq \mathbb{Z}/2\mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of dualizable objects, and this is just the dualizing operation. See at
            = succeed "." do
              %em
                %a{:href => "cobordism+hypothesis#TheCanonicalOnAction"} cobordism hypothesis – Framed version – Implications: Canonical O(n)-action
          %h2#in_a_closed_category In a closed category
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, [-,-], 1)
            the (weak) dual to an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
            is defined to be the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            into the
            %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
          #eq:DualityInClosedCategory.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔻
                  %mi X
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{D}X \coloneqq [X,1]
                  \\,.
          %h2#in_a_closed_monoidal_category In a closed monoidal category
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔻
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbb{D}X
            %a.maruku-eqref{:href => "#eq:DualityInClosedCategory"} (4)
            is also called the
            %em weak dual
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            \&amp;lbrack;
            %a{:href => "#BeckerGottlieb"}> Becker &amp; Gottlieb, p. 5
            \&amp;rbrack; (in contrast with the monoidal dual of Def.
            = succeed "," do
              %a.maruku-ref{:href => "#DualizableObject"}
            %em strong dual
            \&amp;lbrack;
            %a{:href => "#DoldPuppe84"}> Dold &amp; Puppe 1984 Def. 1.2
            \&amp;rbrack;).
          %p
          #ReflexiveDualizableObject.num_defn
            %h6 Definition
            %p
              %strong (reflexive dualizable object)
              %br/
              If the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi 𝔻
                    %mi 𝔻
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \mathbb{D}\mathbb{D}X
            %p of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mi 𝔻
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi σ
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi 𝔻
                    %mi X
                    %mo ⊗
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi ev
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"}
                    X \otimes \mathbb{D}X
                    \\xrightarrow{\;\; \sigma \;\;}
                    \\mathbb{D}X \otimes X
                    \\xrightarrow{\;\; ev \;\;}
                    \\mathbb{1}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (identifying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with its double dual) then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em reflexive
              as a weak dualizable object. &amp;lbrack;
              %a{:href => "#DeligneMilne82"}> Deligne &amp; Milne 1982 p 111
              ,
              = succeed "&rbrack;" do
                %a{:href => "#DoldPuppe84"} Dold &amp; Puppe 1984 Def. 1.2
          %p
          .num_remark
            %h6 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
              = succeed "," do
                %a.maruku-ref{:href => "#RigidAndCompactClosed"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}X
              is also
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              strong dual object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^\ast
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the above monoidal sense. Here dualization exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as a
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous category
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}(-) = (-)^\ast
              is the star-operation).
          %p
          .num_remark
            %h6 Remark
            %p
              The property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              being dualizable can be expressed as a property of the weak dual, namely that the induced map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mi X
                    %mo ⊗
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}X \otimes X \to [X,X]
              is an isomorphsim.
          %h2#in_a_symmetric_monoidal_category
            In a symmetric monoidal
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          .num_defn
            %h6#definition_6 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              in a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is called
              %strong dualizable
              if it is so as an object in the ordinary
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(C)
          %p
            This appears as (
            %a{:href => "#Lurie"}> Lurie, def. 2.3.5
            ).
          .num_remark
            %h6#remark_2 Remark
            %p
              This means that an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is dualizable if there exists unit and counit 1-morphism that satisfy the
              %a.existingWikiWord{:href => "/nlab/show/triangle+identity"} triangle identity
              up to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %a.existingWikiWord{:href => "/nlab/show/coherent"} coherent
              (that it satisfies itself higher order relations up to higher order
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %p
              If the structure morphisms of the adjunction of a dualizable object
              %em have
              themselves all adjoints, then the object is called a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable object
          .num_remark
            %h6#remark_3 Remark
            %p
              As before, we may equivalently state this after
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              the monoidal structure and passing to the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has duals for objects precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}C
              has all adjoints.
          %h2#in_a_linearly_distributive_category In a linearly distributive category
          %p
            In a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+category"} linearly distributive category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ⊗
                  %mo ,
                  %mo ⊤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\otimes,\top)
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⅋
                    %mo ,
                    %mo ⊥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\parr,\bot)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mo ⊤
                  %mo →
                  %mi A
                  %mo ⅋
                  %msup
                    %mi A
                    %mo *
                %annotation{:encoding => "application/x-tex"} i : \top \to A \parr A^*
            and the counit is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo :
                    %msup
                      %mi A
                      %mo *
                    %mo ⊗
                    %mi A
                    %mo →
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} ev:A^* \otimes A \to \bot
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≅
                  %mo ⊤
                  %mo ⊗
                  %mi A
                  %mover
                    %mo →
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⅋
                  %msup
                    %mi A
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mover
                    %mo →
                    %mi δ
                  %mi A
                  %mo ⅋
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ev
                  %mi A
                  %mo ⅋
                  %mo ⊥
                  %mo ≅
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \cong \top \otimes A \xrightarrow{i} (A \parr A^*) \otimes A \xrightarrow{\delta} A \parr (A^* \otimes A) \xrightarrow{ev} A \parr \bot \cong A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo *
                  %mo ≅
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %mo ⊤
                  %mover
                    %mo →
                    %mi i
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⅋
                  %msup
                    %mi A
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi δ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo *
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⅋
                  %msup
                    %mi A
                    %mo *
                  %mover
                    %mo →
                    %mi ev
                  %mo ⊥
                  %mo ⅋
                  %msup
                    %mi A
                    %mo *
                  %mo ≅
                  %msup
                    %mi A
                    %mo *
                  %mo .
                %annotation{:encoding => "application/x-tex"} A^* \cong A^* \otimes \top \xrightarrow{i} A^* \otimes (A \parr A^*) \xrightarrow{\delta} (A^* \otimes A) \parr A^* \xrightarrow{ev} \bot \parr A^* \cong A^*.
          %p
            A symmetric linearly distributive category is (symmetric)
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous
            if and only if all objects have duals in this sense. The same is true in the non-symmetric case if we require both left and right duals.
          %p
            This notion of duality generalizes to that of
            %a.existingWikiWord{:href => "/nlab/show/linear+adjoints"} linear adjoints
            in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+bicategory"} linear bicategory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polycategory"} polycategory
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dualizable+module"} dualizable module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dualizing+object"} dualizing object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/self-dual+object"} self-dual object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"}> rigid monoidal category
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous category
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/finite+objects"}> finite objects
                \:
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/perfect+module"} perfect module
                  %td{:style => "text-align: left;"}
                    (
                    %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"}> fully
                    \-)
                    %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
          %h2#references References
          %p
            The strong-duality of
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+spaces"} finite-dimensional vector spaces
            is the lead-in example used in
          %ul
            %li#EilenbergMacLane45
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/General+Theory+of+Natural+Equivalences"} General Theory of Natural Equivalences
              %strong 58
              2 (1945) 231-294 &amp;lbrack;
              %a{:href => "https://doi.org/10.1090/S0002-9947-1945-0013131-6"}> doi:10.1090/S0002-9947-1945-0013131-6
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.jstor.org/stable/1990284"} jstor:1990284
          %p
            to motivate
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            in the first place.
          %p
            Further original articles with dedicated discussion of the notion of dualizable objects in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
          %ul
            %li#Pareigis76
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bodo+Pareigis"}> Bodo Pareigis
                , p. 113 in:
                = succeed "," do
                  %em Non-additive ring and module theory IV: The Brauer group of a symmetric monoidal category
                %strong 549
                (1976) &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BFb0077339"}> doi:10.1007/BFb0077339
                \&amp;rbrack;
              %blockquote
                %p (calls dualizable objects “finite objects”)
            %li
              %p
                Thomas S. Ligon,
                = succeed "," do
                  %em Galois-Theorie in monoidalen Kategorien
                = succeed "," do
                  %a{:href => "https://edoc.ub.uni-muenchen.de/14958/1/Ligon_Thomas.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.5282/edoc.14958"} doi:10.5282/edoc.14958
              %p
                transl:
                %em Galois theory in monoidal categories
                (2019) &amp;lbrack;
                %a{:href => "https://edoc.ub.uni-muenchen.de/24952/7/Ligon_Thomas.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.5282/edoc.24952"} doi:10.5282/edoc.24952
              %blockquote
                %p
                  (follows
                  = succeed ")" do
                    %a{:href => "#Pareigis76"} Pareigis 1976
            %li#Lindner78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Harald+Lindner"}> Harald Lindner
                ,
                = succeed "," do
                  %em Adjunctions in monoidal categories
                %strong 26
                1-2 (1978) 123-139 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01167969"}> doi:10.1007/BF01167969
                \&amp;rbrack;
              %blockquote
                %p
                  (discusses dual objects in a monoidal category as
                  %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
                  in its
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %li#DeligneMilne82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/James+Milne"} James Milne
                = succeed "," do
                  %em Tannakian categories
                = succeed "," do
                  %em Hodge Cycles, Motives, and Shimura Varieties
                = succeed "," do
                  %strong 900
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-540-38955-2_4"} doi:10.1007/978-3-540-38955-2_4
                = succeed "&rbrack;" do
                  %a{:href => "http://www.jmilne.org/math/xnotes/tc.html"} webpage
            %li#DoldPuppe84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"} Dieter Puppe
                = succeed "," do
                  %em Duality, Trace and Transfer
                %strong 154
                (1984) 85–103 &amp;lbrack;
                %a{:href => "http://mi.mathnet.ru/tm2435"}> mathnet:tm2435
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/doldpup2.pdf"} pdf
          %p
            Early history with an eye towards formulating
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Becker-Gottlieb+transfer"} Becker-Gottlieb transfer
          %ul
            %li#BeckerGottlieb
              %a.existingWikiWord{:href => "/nlab/show/James+Becker"}> James Becker
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Gottlieb"} Daniel Gottlieb
