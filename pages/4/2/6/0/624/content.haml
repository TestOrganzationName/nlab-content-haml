                                          %msup
                                            %mi A
                                            %mo *
                                        %mrow
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msubsup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mo ≃
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msubsup
                                        %mi ℓ
                                        %mrow
                                          %msup
                                            %mi A
                                            %mo *
                                        %mrow
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                      %mo ∘
