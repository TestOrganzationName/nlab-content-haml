                                    %mo ⊗
                                    %msub
                                      %mi i
                                      %mi A
                              %mtd
                                %msup
                                  %mi A
                                  %mo *
                                %mo ⊗
                                %mi 𝟙
                            %mtr
                              %mtd
                                %msubsup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mo ≃
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msubsup
                                        %mi α
                                        %mrow
                                          %msup
