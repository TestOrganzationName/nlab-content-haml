                                  %mi A
                                  %mo *
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        A^\ast \otimes (A \otimes A^\ast)
                        \&amp;\overset{id_{A^\ast} \otimes i_A}{\longleftarrow}&amp;
