          %h2#alexander_kahle_superconnections_and_index_theory Alexander Kahle: superconnections and index theory
          %ul
            %li
              %p 1) superconnections
            %li
              %p 2) index theory
            %li
              %p 3) sketch some proofs
          %h3#1_superconnections 1) superconnections
          %p
            %strong definition
            A
            %strong superconnection
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi s
                %annotation{:encoding => "application/x-tex"} \nabla_s
            on a
            = succeed "-graded" do
              %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} V \to M
            is an odd derivation on
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(M,V)
          %p
            superconnections form an affine space modeled on
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi odd
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(M, End(V))^{odd}
          .maruku-equation
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  End(V)
          .maruku-equation
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_7.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi s
                  %mo =
                  %msub
                    %mi ω
                    %mn 0
                  %mo +
                  %mo ∇
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msub
                    %mi ω
                    %mn 2
                  %mo +
                  %msub
                    %mi ω
                    %mn 3
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_s = \omega_0 + \nabla + \omega_2 + \omega_3
          %p
            class in
            = succeed "-theory" do
              %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mover
                    %mo →
                    %mi f
                  %mi W
                %annotation{:encoding => "application/x-tex"} V \stackrel{f}{\to} W
          %p
            unitary superconnection on
            = succeed "-graded" do
              %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            with map as a above look like
          .maruku-equation
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_12.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi s
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi f
                              %mo *
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                    %mo )
                  %mo +
                  %mo ∇
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_s
                  \=
                  \\left(
                  \\array{
                  \&amp; f^*
                  \\\
                  f &amp;
                  }
                  \\right)
                  + \nabla
          %p
            %strong Chern character
            by the usual formulas
          .maruku-equation
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_13.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∇
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi sTr
                  %msup
                    %mi e
                    %mrow
                      %msup
                        %mo ∇
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  ch(\nabla_s) := sTr e^{\nabla^2}
          %h3#2_index_theory 2) index theory
          %p
            %strong definition
            Let
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be smooth Riemannian and
            = succeed "," do
              %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} Spin
            %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo →
                  %mi M
                  %mo ,
                  %msub
                    %mo ∇
                    %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V \to M, \nabla_s)
            is defined by
          %ul
            %li
              %ul
                %li
                  .maruku-equation
                    %math#mathml_9bb44436969d5121ebd35a6fcdb5b6ac034e70f0_17.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∇
                            %mi s
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ⊗
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∇
                                %mi s
                              %mo ⊗
                              %mn 1
                              %mo ⊕
                              %mn 1
                              %mo ⊗
                              %msub
                                %mo ∇
                                %mi s
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo ,
                          %mi S
                          %mo ⊗
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mrow
                              %mi c
                              %mo{:stretchy => "false"} (
                              %mo .
