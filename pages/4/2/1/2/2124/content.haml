                    gauged supergravity
                %strong 79
                3343&amp;-3346 (1997) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9707176"}> hep-th/9707176
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Weinberg"}> Steven Weinberg
                ,
                = succeed "," do
                  %em The quantum theory of fields
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tudor+Dimofte"}> Tudor Dimofte
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"} Sergei Gukov
                = succeed "," do
