                %a{:href => "https://arxiv.org/abs/0711.3899"} arXiv:0711.3899
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Reineke"}> Markus Reineke
                ,
                = succeed "," do
                  %em Cohomology of quiver moduli, functional equations, and integrality of Donaldson-Thomas type invariants
                = succeed ":3" do
                  %strong 147
                %a{:href => "https://doi.org/10.1112/S0010437X1000521X"} doi
                %a{:href => "https://arXiv.org/abs/0903.0261"} arXiv:0903.0261
            %li
              %p
                Duiliu-Emanuel Diaconescu,
                = succeed "," do
                  %em Moduli of ADHM sheaves and local Donaldson-Thomas theory
                = succeed ":4" do
                  %strong 62
                %a{:href => "https://arXiv.org/abs/0801.0820"} arXiv:0801.0820
                f
                %a{:href => "https://doi.org/10.1016/j.geomphys.2011.12.018"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Bridgeland"}> Tom Bridgeland
                ,
                = succeed "," do
                  %em Stability conditions on triangulated categories
                %a{:href => "https://arxiv.org/abs/math/0212237"} math.AG/0212237
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yan+Soibelman"} Yan Soibelman
                = succeed "," do
                  %em Stability structures, motivic Donaldson-Thomas invariants and cluster transformations
                %a{:href => "https://arxiv.org/abs/0811.2435"} arXiv:0811.2435
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yan+Soibelman"} Yan Soibelman
                = succeed "," do
                  %em Motivic Donaldson-Thomas invariants: summary of results
                %strong 527
                (2010)
                %a{:href => "https://doi.org/10.1090/conm/527/10400"} doi
