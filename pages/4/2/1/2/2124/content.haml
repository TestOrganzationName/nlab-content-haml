            %a{:href => "#Stelle98"} Stelle 98, section 3
            = succeed "):" do
              %a{:href => "#EHKNT07"} EHKNT 07
          %ul
            %li
              %p
                the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %li
              %p
                the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            %li
              %p
                the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/M-wave"} M-wave
            %li
              %p
                the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+monopole"} Kaluza-Klein monopole
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bridgeland+stability+condition"} Bridgeland stability condition
            %li
              %p
