                , Y. Song,
                = succeed "," do
                  %em A theory of generalized Donaldson-Thomas invariants
                %a{:href => "https://arxiv.org/abs/0810.5645"} arxiv/0810.5645
          %h3#IntroductoryReferences Introductions, surveys and lectures
          %p An introduction that starts at the beginning and then covers much of the ground in some detail is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"}> Greg Moore
              ,
              %em
                PiTP Lectures on BPS states and wall-crossing in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} d = 4
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒩
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{N} = 2
                theories
              (
              %a{:href => "http://www.physics.rutgers.edu/~gmoore/PiTP_July26_2010.pdf"}> pdf
              )
          %p A survey of progress on the most general picture is in
          %ul
            %li
              Katzutoshi Ohta,
              %em BPS state counting and related physics
              (2005) (
              %a{:href => "http://www2.yukawa.kyoto-u.ac.jp/~qft/2005/slides/ohta.pdf"}> pdf
              )
          %h3#in_supergravity_2 In supergravity
          %p
            Discussion of extremal/BPS
            %a.existingWikiWord{:href => "/nlab/show/black+branes"} black branes
            in
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            (especially in
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            and 10d
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
          %ul
            %li#Stelle98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kellogg+Stelle"}> Kellogg Stelle
                ,
                = succeed "," do
                  %em BPS Branes in Supergravity
                = succeed "," do
                  %em Quantum Field Theory: Perspective and Prospective
                = succeed "," do
                  %strong 530
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/hep-th/9803116"} arXiv:hep-th/9803116
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-94-011-4542-8_12"} doi:10.1007/978-94-011-4542-8_12
            %li#GauntlettHull99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"}> Jerome Gauntlett
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"} Chris Hull
                = succeed "," do
                  %em BPS states with extra supersymmetry
                %a{:href => "https://arxiv.org/abs/hep-th/9909098"} arXiv:hep-th/9909098
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2000/01/004"} doi:10.1088/1126-6708/2000/01/004
            %li#EHKNT07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francois+Englert"}> Francois Englert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Laurent+Houart"} Laurent Houart
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Axel+Kleinschmidt"} Axel Kleinschmidt
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em
                    An
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 9
                        %annotation{:encoding => "application/x-tex"} E_9
                    multiplet of BPS states
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0703285"} arXiv:hep-th/0703285
            %li
              %p
                Andrew Callister,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Douglas+Smith"} Douglas Smith
                = succeed "," do
                  %em Topological BPS charges in 10 and 11-dimensional supergravity
                %strong 78
                065042 (2008) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0712.3235"}> arXiv:0712.3235
                \&amp;rbrack;
            %li
              %p
                Andrew Callister,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Douglas+Smith"} Douglas Smith
                = succeed "," do
                  %em
                    Topological charges in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{R})
                    covariant massive 11-dimensional and Type IIB SUGRA
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0907.3614"} arXiv:0907.3614
            %li
              %p
                Andrew Callister,
                = succeed "," do
                  %em Topological BPS charges in 10- and 11-dimensional supergravity
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/1221591?ln=en"} spire
            %li
              %p
                Cristine N. Ferreira,
                %em BPS solution for eleven-dimensional supergravity with a conical defect configuration
                (
                %a{:href => "https://arxiv.org/abs/1312.0578"}> arXiv:1312.0578
                )
          %p
            Specifically for
            = succeed "-BPS" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi n
                  %annotation{:encoding => "application/x-tex"} 1/2^n
            %a.existingWikiWord{:href => "/nlab/show/M-branes"} M-branes
            in 11d there is discussion in
          %ul
            %li#Tseytlin96
              %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"}> Arkady Tseytlin
              ,
              = succeed "," do
                %em Harmonic superpositions of M-branes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9604035"} arXiv:hep-th/9604035
              %a.existingWikiWord{:href => "/nlab/show/Mike+Duff"} Mike Duff
              (ed.) chapter 5 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/The+World+in+Eleven+Dimensions"} The World in Eleven Dimensions
          %p see also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"}> Jerome Gauntlett
                ,
                %em Intersecting Branes
                (
                %a{:href => "https://arxiv.org/abs/hep-th/9705011"}> hep-th/9705011
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"} José de Azcárraga
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Izquierdo"} José Izquierdo
                = succeed "," do
                  %span.newWikiWord
                    Jerzy Lukierski
                    %a{:href => "/nlab/new/Jerzy+Lukierski"} ?
                = succeed "," do
                  %em BPS states in M-theory and twistorial constituents
                %strong 86
                (2001) 4451-4454 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/0101113"}> arXiv:hep-th/0101113
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Gran"}> Ulf Gran
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Gutowski"} Jan Gutowski
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/George+Papadopoulos"} George Papadopoulos
                %em Classification, geometry and applications of supersymmetric backgrounds
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1808.07879"}> arXiv:1808.07879
                \&amp;rbrack;
          %p Semiclassical approach:
          %ul
            %li
              T. Daniel Brennan,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+W.+Moore"} Gregory W. Moore
              = succeed "," do
                %em A note on the semiclassical formulation of BPS states in four-dimensional N = 2 theories
              %a{:href => "https://doi.org/10.1093/ptep/ptw159"} doi
          %p
            Discussion in the context of multiple
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            in the
            %a.existingWikiWord{:href => "/nlab/show/BLG+model"} BLG model
            is in
          %ul
            %li#BaggerLambert12
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Bagger"}> Jonathan Bagger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"} Neil Lambert
              %em Multiple Membranes in M-theory
              (
              %a{:href => "https://arxiv.org/abs/1203.3546"}> arXiv:1203.3546
              )
          %p
            Discussion for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/4d+supergravity"} 4d supergravity
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            on a
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
            is due to
          %ul
            %li#Denef00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frederik+Denef"}> Frederik Denef
                ,
                = succeed "," do
                  %em Supergravity flows and D-brane stability
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0005049"} arXiv:hep-th/0005049
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frederik+Denef"}> Frederik Denef
                ,
                = succeed "," do
                  %em Quantum Quivers and Hall/Hole Halos
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0206072"} arXiv:hep-th/0206072
          %p
            Discussion of more general classification of solutions to
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            preserving some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/Killing+spinors"} Killing spinors
            includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"}> Jerome Gauntlett
                , Stathis Pakis,
                = succeed "," do
                  %em
                    The Geometry of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} D=11
                    Killing Spinors
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0212008"} arXiv:hep-th/0212008
            %li#HEGKS08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+D%27Hoker"}> Eric D'Hoker
                , John Estes, Michael Gutperle, Darya Krym, Paul Sorba,
                = succeed "," do
                  %em Half-BPS supergravity solutions and superalgebras
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0810.1484"} arXiv:0810.1484
                = succeed "&rbrack;" do
                  %a{:href => "https://iopscience.iop.org/article/10.1088/1126-6708/2008/12/047"} doi:10.1088/1126-6708/2008/12/047
          %p
            The conceptual identification of the relevant brane-charge extension of the
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            algebra as that of the
            %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
            of the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+super+p-brane+sigma+models"} Green-Schwarz super p-brane sigma models
            for branes is due to
          %ul
            %li#AGIT89
              %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"}> José de Azcárraga
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"} Jerome Gauntlett
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Izquierdo"} J. M. Izquierdo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em Topological extensions of the supersymmetry algebra for extended objects
              %strong 63
              (1989) 2443 &amp;lbrack;
              %a{:href => "https://inspirehep.net/record/26393?ln=en"}> spire
              \&amp;rbrack;
          %p reviewed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"}> José de Azcárraga
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Izquierdo"} José M. Izquierdo
              %em Lie groups, Lie algebras, cohomology and some applications in physics
              , Cambridge monographs of mathematical physics (1995)
          %p
            This is for branes in the old
            %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
            (
            %a.existingWikiWord{:href => "/nlab/show/strings"}> strings
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/membranes"} membranes
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %p
            The generalization oft this perspective to the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            is discussed in
          %ul
            %li#SorokinTownsend97
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"}> Dmitri Sorokin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em M-theory superalgebra from the M-5-brane
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9708003"} arXiv:hep-th/9708003
          %p
            and the generalization to
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            is discussed in
          %ul
            %li#Hammer97
              Hanno Hammer,
              = succeed "," do
                %em Topological Extensions of Noether Charge Algebras carried by D-p-branes
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9711009"} arXiv:hep-th/9711009
          %p Detailed discussion of examples for various backgrounds is in
          %ul
            %li
              Takeshi Sato,
              = succeed "," do
                %em Superalgebras in Many Types of M-Brane Backgrounds and Various Supersymmetric Brane Configurations
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9812014"} arXiv:hep-th/9812014
          %p
            Discussion of this in
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            via the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
            is in
          %ul
            %li#SatiSchreiber15
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Lie+n-algebras+of+BPS+charges"} Lie n-algebras of BPS charges
              %strong 2017
              87 (2017) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1507.08692"}> arXiv:1507.08692
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://link.springer.com/article/10.1007/JHEP03(2017)087"} doi:10.1007/JHEP03(2017)087
          %p
            Discussion of relation of
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            BPS states to
            %a.existingWikiWord{:href => "/nlab/show/knot+invariants"} knot invariants
            includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                %em Fivebranes and Knots
                (
                %a{:href => "http://arxiv.org/abs/1101.3216"}> arXiv:1101.3216
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                , Marko Stošić,
                = succeed "," do
                  %em Homological algebra of knots and BPS states
                %strong 18
                (2012) 309–367 (
                %a{:href => "https://arxiv.org/abs/1112.0030"} arXiv:1112.0030
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2140/gtm.2012.18.309"} doi
            %li
              %p
                Ross Elliot,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"} Sergei Gukov
                %em Exceptional knot homology
                (
                %a{:href => "https://arxiv.org/abs/1505.01635"}> arXiv:1505.01635
                )
          %h3#SpectralNetworksReferences Spectral networks
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Neitzke"} Andrew Neitzke
              %em Spectral networks
              (
              %a{:href => "http://arxiv.org/abs/1204.4824"}> arXiv:1204.4824
              ,
              %p
                %a{:href => "http://www.ma.utexas.edu/users/neitzke/spectral-network-movies/"}> illustrating animations
                )
