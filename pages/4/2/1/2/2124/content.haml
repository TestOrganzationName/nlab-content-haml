                %a{:href => "http://arXiv.org/abs/0904.1420"} arXiv:0904.1420
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                = succeed "," do
