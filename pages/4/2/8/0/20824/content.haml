                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/494174"} spire:494174
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(99)00315-9"} doi:10.1016/S0370-2693(99)00315-9
          %h4#D6D8BoundStates D6-D8-brane bound states
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/D6-D8-brane+bound+states"} D6-D8-brane bound states
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+string+theory"} massive type IIA string theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Harvendra+Singh"}> Harvendra Singh
                ,
                = succeed "," do
                  %em
                    Duality symmetric massive type II theories in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 8
                        %annotation{:encoding => "application/x-tex"} D=8
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
