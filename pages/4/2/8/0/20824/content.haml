                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0212103"} arXiv:hep-th/0212103
            %li
              %p
                Fabio Apruzzi,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marco+Fazzi"} Marco Fazzi
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alessandro+Tomasiello"} Alessandro Tomasiello
                = succeed "," do
                  %em
                    All
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 7
                        %annotation{:encoding => "application/x-tex"} AdS_7
                    solutions of type II supergravity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1309.2949"} arxiv:1309.2949
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Fazzi"}> Marco Fazzi
                ,
                %em Higher-dimensional field theories from type II supergravity
                (
                %a{:href => "https://arxiv.org/abs/1712.04447"}> arxiv:1712.04447
                )
          %p
            With emphasis on
            %a.existingWikiWord{:href => "/nlab/show/charge+quantization"} charge quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            %a.existingWikiWord{:href => "/nlab/show/flux"} flux
            forms via
            = succeed ":" do
