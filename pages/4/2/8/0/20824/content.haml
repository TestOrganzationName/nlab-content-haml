              %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+string+theory"} massive type IIA string theory
            %a.existingWikiWord{:href => "/nlab/show/defect+QFT"} defect
            %a.existingWikiWord{:href => "/nlab/show/D2-D6-brane+bound+states"} D2-D6-brane bound states
            inside them realizing
            %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2"} AdS3-CFT2
            “inside”
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/AdS7-CFT6"} AdS7-CFT6
          %ul
            %li#DibitettoPetri18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"}> Giuseppe Dibitetto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicol%C3%B2+Petri"} Nicolò Petri
                = succeed "," do
                  %em Surface defects in the D4 − D8 brane system
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1807.07768"} arxiv:1807.07768
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"}> Giuseppe Dibitetto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicol%C3%B2+Petri"} Nicolò Petri
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
