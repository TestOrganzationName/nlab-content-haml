                  %annotation{:encoding => "application/x-tex"}
                    \\omega \in \Omega^2\left(  \Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L}} = 0 \right)
            %p
              on the genuine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
