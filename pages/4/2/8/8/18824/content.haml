                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{\Sigma_{tra}}(d \Omega_{BFV}) = 0
                    \\,.
            %p
              But then the claim follows with prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
