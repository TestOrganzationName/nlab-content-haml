                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left( (-)\vert_{in}\right)^\ast\left( \omega_{in}\right)
                    \\;-\;
                    \\left( (-)\vert_{out} \right)^\ast \left( \omega_{out} \right)
                    \=
                    \\tau_{\mathbb{D} \times \Sigma_{tra}} ( s \Omega_{BV} )
                    \\phantom{AAAA}
                    \\in
                    \\Omega^2
                    \\left(
                    \\Gamma_{\Sigma_{tra}}(E)_{\delta_{EL} \mathbf{L} = 0}
                    \\right)
                    \\,.
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/homological+resolution"} homological resolution
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
              that exhibits the “covariance” of the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CovariantPhaseSpace"}
              %em BV-BFV relation
              (
              %a{:href => "BV-BRST+formalism#CattaneoMnevReshetikhin12"}> Cattaneo-Mnev-Reshetikhin 12 (9)
              ).
          .proof
            %h6#proof_3 Proof
            %p For the first statement we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi s
                            %msub
                              %mi Ω
                              %mi BV
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi s
                            %msubsup
                              %mi ϕ
                              %mi a
                              %mo ‡
                            %mo{:stretchy => "false"} )
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                            %mo ∧
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %mfrac
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi L
                              %mrow
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %msub
                              %mi Ω
                              %mi BFV
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    s \Omega_{BV}
                    \&amp; =
                    \- \delta (s \phi^{\ddagger}_a) \delta \phi^a \wedge dvol_{\Sigma}
                    \\\
                    \&amp; =
                    \- \delta \frac{\delta_{EL}L }{\delta \phi^a}  \delta \phi^a dvol_{\Sigma}
                    \\\
                    \&amp; =
                    \- \delta \delta_{EL}\mathbf{L}
                    \\\
                    \&amp; =
                    d \Omega_{BFV}
                    \\,,
                    \\end{aligned}
            %p
              where the first steps simply unwind the definitions, and where the last step is prop.
              = succeed "." do
                %a.maruku-ref{:href => "#HorizontalDerivativeOfPresymplecticCurrentVanishesOnShell"}
            %p
              With this the second statement follows by immediate generalization of the proof of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CovariantPhaseSpace"}
          #DerivedPresymplecticCurrentOfRealScalarField.num_example
            %h6#example_7 Example
            %p
              %strong
                (derived
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+transformations"} infinitesimal gauge transformations
              (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#ImplicitInfinitesimalGaugeSymmetry"}
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
            %p
              Inside its
              %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ω
                          %mi BFV
                      %annotation{:encoding => "application/x-tex"} \Omega_{BFV}
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FreeScalarFieldEOM"}
              %li
                %p
                  the BF-presymplectic current
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ω
                          %mi BV
                      %annotation{:encoding => "application/x-tex"} \Omega_{BV}
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#BVPresymplecticCurrent"}
            %p This yields a vertical 2-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ω
                      %mi BV
                    %mo +
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi ℰ
                          %mi BV
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega \;\coloneqq\; \Omega_{BV} + \Omega_{BFV} \;\; \in \Omega^{p,2}_\Sigma(E)\vert_{\mathcal{E}_{BV}}
            %p
              which might be called the
              = succeed "." do
                %em derived presymplectic current
            %p
              Similarly we may form the linear combination of 1. the presymplectic potential current
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              %a.maruku-eqref{:href => "#eq:dLDecomposition"} (?)
            %ol
              %li
                %p
                  the BF-presymplectic potential current
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Θ
                          %mi BV
                      %annotation{:encoding => "application/x-tex"} \Theta_{BV}
                  %a.maruku-eqref{:href => "#eq:BVPresymplecticPotential"} (10)
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                      %annotation{:encoding => "application/x-tex"} \mathbf{L}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Θ
                      %mi BV
                    %mo +
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi Θ
                            %mi BFV
                          %mo +
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                        %mo ⏟
                      %mi Lepage
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta \;\coloneqq\; \Theta_{BV} + \underset{Lepage}{\underbrace{ \Theta_{BFV} + \mathbf{L} }}
            %p
              (where the sum of the two terms on the right is the
              %a.existingWikiWord{:href => "/nlab/show/Lepage+form"} Lepage form
              = succeed ")." do
                %a.maruku-eqref{:href => "#eq:TheLepage"} (?)
              = succeed "." do
                %em derived presymplectic potental current
            %p We then have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi Ω
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    (\delta + (d-s))\Omega \;=\; 0
            %p and in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi Θ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\delta + (d-s))\Theta \;=\; \Omega
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p Of course the first statement follows from the second, but in fact the two contributions of the first statement even vanish separately:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi Ω
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAAA
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mi Ω
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \Omega = 0
                    \\,,
                    \\phantom{AAAA}
                    (d-s)\Omega = 0
                    \\,.
            %p
              The statement on the left is immediate from the definitions, since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo =
                      %mi δ
                      %mi Θ
                    %annotation{:encoding => "application/x-tex"} \Omega = \delta \Theta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Ω
                              %mi BV
                            %mo +
                            %msub
                              %mi Ω
                              %mi BFV
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mi d
                                  %msub
                                    %mi Ω
                                    %mi BFV
                                  %mo −
                                  %munder
                                    %munder
                                      %mrow
                                        %mi s
                                        %msub
                                          %mi Ω
                                          %mi BV
                                      %mo ⏟
                                    %mrow
                                      %mo =
                                      %mn 0
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mi d
                                  %msub
                                    %mi Ω
                                    %mi BV
                                  %mo −
                                  %mi s
                                  %msub
                                    %mi Ω
                                    %mi BFV
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (d - s) (\Omega_{BV} + \Omega_{BFV})
                    \&amp; =
                    \\underset{= 0}{\underbrace{d \Omega_{BFV}
                    \-
                    \\underset{ = 0 }{\underbrace{ s \Omega_{BV}}}  }}
                    +
                    \\underset{ = 0}{\underbrace{ d \Omega_{BV} - s \Omega_{BFV} }}
                    \\\
                    \&amp; = 0
                    \\end{aligned}
            %p
              Here the first term vanishes via the local BV-BFV relation (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ResolutionOfCovariantPhaseSpaceCorrespondence"}
            %p Similarly for the second statement we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi δ
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mi Θ
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mi δ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi Θ
                                    %mi BV
                                  %mo +
                                  %msub
                                    %mi Θ
                                    %mi BFV
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi Ω
                                  %mi BV
                                %mo +
                                %msub
                                  %mi Ω
                                  %mi BFV
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi d
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                %mo ⏟
                              %mrow
                                %mo =
                                %mi δ
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi d
                                  %mo −
                                  %mi s
                                  %mo{:stretchy => "false"} )
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Θ
                              %mi BV
                            %mo +
                            %msub
                              %mi Θ
                              %mi BFV
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Ω
                              %mi BV
                            %mo +
                            %msub
                              %mi Ω
                              %mi BFV
                            %mo +
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mi d
                                  %msub
                                    %mi Θ
                                    %mi BV
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo −
                            %munder
                              %munder
                                %mrow
                                  %mi s
                                  %msub
                                    %mi Θ
                                    %mi BV
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mi d
                                  %msub
                                    %mi Θ
                                    %mi BFV
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo −
                                %mi δ
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                            %mo −
                            %munder
                              %munder
                                %mrow
                                  %mi s
                                  %msub
                                    %mi Θ
                                    %mi BFV
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Ω
                              %mi BV
                            %mo +
                            %msub
                              %mi Ω
                              %mi BFV
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\delta + (d - s) ) \Theta
                    \&amp; =
                    \\underset{ = \Omega_{BV}  + \Omega_{BFV}}{\underbrace{ \delta (\Theta_{BV} + \Theta_{BFV}) }}
                    +
                    \\underset{ = \delta \mathbf{L}}{\underbrace{\mathbf{d} \mathbf{L}}}
                    +
                    \\underset{ = 0 }{\underbrace{  (d-s) \mathbf{L}  }}
                    +
                    (d-s)(\Theta_{BV} + \Theta_{BFV})
                    \\\
                    \&amp; =
                    \\Omega_{BV} +  \Omega_{BFV}
                    +
                    \\delta \mathbf{L}
                    +
                    \\underset{ = 0}{\underbrace{d \Theta_{BV}}}
                    \-
                    \\underset{ = \delta_{EL} \mathbf{L} }{\underbrace{ s \Theta_{BV}}}
                    +
                    \\underset{ = \delta_{EL}\mathbf{L} - \delta \mathbf{L} }{\underbrace{ d \Theta_{BFV} } }
                    \-
                    \\underset{ = 0 }{\underbrace{ s \Theta_{BFV} }}
                    \\\
                    \&amp; =
                    \\Omega_{BV} + \Omega_{BFV}
                    \\end{aligned}
                    \\,.
            %p
              Here the direct vanishing of various terms is again by simple degree reasons, and otherwise we used the definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              and, crucially, the variational identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo −
                    %mi d
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \delta \mathbf{L} = \delta_{EL}\mathbf{L} - d \Theta_{BFV}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:dLDecomposition"} (?)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#HamiltonianLocalObservablesOnACauchySurface
            %strong Hamiltonian local observables
          %p
            We have defined the
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#LocalObservables"}
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgressions
            of horizontal
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma}(E)_{\delta_{EL}\mathbf{L} = 0}
            over all of
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed "." do
              %em spacetime local observables
          %p
            But with every choice of
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi p
                  %mo ↪
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#CauchySurface"}
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgressions
            of horizontal
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-forms)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            restricted to the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            of that Cauchy surface (def.
            = succeed "):" do
              %a.maruku-ref{:href => "#FieldHistoriesOnInfinitesimalNeighbourhoodOfSubmanifoldOfSpacetime"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma_p}(E)_{\delta_{EL} \mathbf{L} = 0}
            = succeed "," do
              %em spatially local observables
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
          %p
            Among these spatially local observables are the
            %em Hamiltonian local observables
            (def.
            %a.maruku-ref{:href => "#HamiltonianLocalObservables"}
            below) which are
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgressions
            specifically of the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian forms
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#HamiltonianForms"}
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#LocalPoissonBracket"}
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            on Hamiltonian local observables (def.
            %a.maruku-ref{:href => "#PoissonBracketOnHamiltonianLocalObservables"}
            below). This is known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
            (example
            %a.maruku-ref{:href => "#PoissonBracketForRealScalarField"}
            below).
          #HamiltonianLocalObservables.num_defn
            %h6#definition_3 Definition
            %p
              %strong (Hamiltonian local observables)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                    %mo ⟶
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma(A)
                    \\;\colon\;
                    \\Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L} = 0}
                    \\longrightarrow
                    \\mathbb{C}
                    \\,,
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of a variational horizontal
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^{p+1,0}_{\Sigma,cp}(E)
              of compact spacetime support.
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchySurface"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_\Sigma (A)
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              if it is also the transgression of a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#HamiltonianForms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi Ham
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (H,v) \in \Omega^{p,0}_{\Sigma, Ham}(E)
            %p
              whose transgression over the Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma_p
              equals the transgression of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              over all of spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.maruku-eqref{:href => "#eq:CauchySurfaceIsomorphismOnHistorySpace"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo =
                                %mn 0
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi N
                                      %mi Σ
                                    %msub
                                      %mi Σ
                                      %mi p
                          %mtd
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi τ
                                      %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi τ
                                    %mrow
                                      %msub
                                        %mi Σ
                                        %mi p
                                  %mo{:stretchy => "false"} (
                                  %mi H
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(E)_{\delta_{EL} \mathbf{L} = 0 }
                    \&amp;&amp; \underoverset{\simeq}{(-)\vert_{N_\Sigma \Sigma_p}}{\longrightarrow} &amp;&amp;
                    \\Gamma_{\Sigma_p}(E)_{\delta_{EL}\mathbf{L} = 0}
                    \\\
                    \&amp; {}_{\mathllap{\tau_\Sigma}(A)}\searrow &amp;&amp; \swarrow_{\mathrlap{ \tau_{\Sigma_p}(H) }}
                    \\\
                    \&amp;&amp; \mathbf{\Omega}^2
                    }
          %p
            Beware that the
            %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p}(H)
            defined by a
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mrow
                      %mi Σ
                      %mo ,
                      %mi Ham
                    %mrow
                      %mi p
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \in \Omega^{p,0}_{\Sigma,Ham}(E)
            as in def.
            %a.maruku-ref{:href => "#HamiltonianLocalObservables"}
            does in general depend not just on the choice of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \Sigma_p
            of the Cauchy surface. The exception are those Hamiltonian forms which are
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
          #ConservedCharge.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/conserved+charges"} conserved charges
                –
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi Ham
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J \in \Omega^{p,0}_{\Sigma,Ham}(E)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HamiltonianForms"}
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
              vanishes
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi J
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d J \vert_{\mathcal{E}} \;= \; 0
            %p
              then the induced Hamiltonian
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p}(J)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HamiltonianLocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma_p
              (def
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchySurface"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ,
                    %mi Σ
                    %msub
                      %mo ′
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_p, \Sigma'_p \hookrightarrow \Sigma
              any two Cauchy surfaces which are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi τ
                      %mrow
                        %mi Σ
                        %msub
                          %mo ′
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{\Sigma_p}(J) = \tau_{\Sigma'_p}(J)
                    \\,.
            %p
              The resulting
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/conserved+charge"} conserved charge
              of the conserved current, traditionally denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Q \;\coloneqq\; \tau_{\Sigma_p}(J)
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              By definition the
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi J
                  %annotation{:encoding => "application/x-tex"} d J
              vanishes on the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#StokesTheorem"}
          #PoissonBracketOnHamiltonianLocalObservables.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
                of
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
            %p
              We say that the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              on Hamiltonian local observables (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HamiltonianLocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPoissonBracket"}
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPoissonBracket"}
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CovariantPhaseSpace"}
            %p
              Explicitly: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
              a choice of
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchySurface"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi i
                    %mo ,
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p}((H_i, v_i))
              is
            #eq:PoissonBracketTransgressedToCauchySurface.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 2
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\tau_{\Sigma_p}((H_1, v_1))
                    \\,,\,
                    \\tau_{\Sigma_p}( (H_2, v_2) )
                    \\right\}
                    \\;\coloneqq\;
                    \\tau_{\Sigma_p}( \, \{ (H_1, v_1), (H_2, v_2) \} \, )
                    \\,,
            %p
              where on the right we have the transgression of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(H_1, v_1), (H_2, v_2)\}
              of
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LocalPoissonBracket"}
          .proof
            %h6#proof_6 Proof
            %p
              We need to see that equation
              %a.maruku-eqref{:href => "#eq:PoissonBracketTransgressedToCauchySurface"} (11)
              is well defined, in that it does not depend on the choice of Hamiltonian form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi i
                    %mo ,
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H_i, v_i)
              representing the local Hamiltonian observable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p}(H_i)
            %p
              It is clear that all the transgressions involved depend only on the restriction of the Hamiltonian forms to the pullback of the jet bundle to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi Σ
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} N_\Sigma \Sigma_p
              %a.maruku-eqref{:href => "#eq:LocalPoissonLieBracket"} (?)
              clearly respects this restriction.
            %p
              If a Hamiltonian differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the transgression map relative to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)} \colon U \to \Gamma_{\Sigma_p}(E)_{\delta_{EL}\mathbf{L} = 0}
              of field histories (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma_p} j^\infty_\Sigma(\Phi_{(-)})^\ast H  \;= \;0
                    \\;\;\;
                    \\in \Omega^p(U)
            %p
              then the fact that the
              %em
                %a.existingWikiWord{:href => "/nlab/show/kernel+of+integration+is+the+exact+differential+forms"} kernel of integration is the exact differential forms
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi H
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma(\Phi_{(-)})^\ast H \in \Omega^p(U \times \Sigma)
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} d_\Sigma
              %a.existingWikiWord{:href => "/nlab/show/exact+differential+form"} exact
              and hence in particular
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} d_\Sigma
              %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed
              for all
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi Σ
                    %msup
                      %mi j
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_\Sigma j^\infty(\Phi_{(-)})^\ast H \;=\; 0
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
              this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    j^\infty(\Phi_{(-)})^\ast ( d H ) \;= \; 0
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in \Omega^{p,0}_\Sigma(E)
              is horizontal, the same proposition (see also example
              = succeed ")" do
                %a.maruku-ref{:href => "#BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is horizontally closed:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d H \;=\; 0
                    \\,.
            %p
              Now since the field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              is
              %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
              by assumption, prop.
              %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
              applies and says that this horizontally closed form on the jet bundle is in fact horizontally exact.
            %p
              In conclusion this shows that the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mrow
                      %mo (
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p} \;\colon\; \Omega^{p,0}_\Sigma(E) \to C^\infty\left( \Gamma_{\Sigma_p}(E)\right)
              is precisely the space of horizontally exact horizontal
              = succeed "-forms." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Therefore the claim now follows with the statement that horizontally exact
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/Lie+ideal"} Lie ideal
              for the local Poisson bracket on the jet bundle; this is lemma
              = succeed "." do
                %a.maruku-ref{:href => "#HorizontallyExactFormsDropOutOfLocalLieBracket"}
          #PoissonBracketForRealScalarField.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x^0 = 0
            %p
              By example
              %a.maruku-ref{:href => "#LocalPoissonBracketForRealScalarField"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
              of the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+forms"} Hamiltonian forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ≔
                    %mi ϕ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q \coloneqq \phi \iota_{\partial_0} dvol_\Sigma \in \Omega^{p,0}(E)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \coloneqq \eta^{\mu \nu} \phi_{,\mu} \iota_{\partial_\nu} dvol_{\Sigma} \in \Omega^{p,0}(E)
                    \\,.
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Q
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi Q
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi P
                    %mi ω
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
