                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi reg
                  %annotation{:encoding => "application/x-tex"} \alpha^\ast, \beta^\ast \in \Gamma_{\Sigma,cp}(E^\ast) \simeq LinObs(E_{scp},\mathbf{L})^{reg}
            %p
              Hence under the given assumptions, for every Cauchy surface the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              associated with that Cauchy surface equals the invariantly (“covariantly”) defined
              %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo =
                    %mo{:stretchy => "false"} {
