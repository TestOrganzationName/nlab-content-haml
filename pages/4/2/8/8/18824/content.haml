              %a.existingWikiWord{:href => "/nlab/show/presymplectic+smooth+space"} presymplectic smooth space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
