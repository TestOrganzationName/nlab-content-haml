          .proof
            %h6#proof Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#HorizontalDerivativeOfPresymplecticCurrentVanishesOnShell"}
              the total spacetime derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi Ω
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} d \Omega_{BFV}
              of the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              vanishes
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi Ω
                      %mi BFV
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi δ
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"}
                    d \Omega_{BFV} = - \delta \delta_{EL} \mathbf{L}
            %p
              in that the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PullbackOfDifferential1FormsOnCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi i
                          %mi ℰ
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \overset{i_{\mathcal{E}}}{\hookrightarrow} J^\infty_\Sigma(E)
              %a.maruku-eqref{:href => "#eq:ShellInJetBundle"} (?)
              vanishes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
