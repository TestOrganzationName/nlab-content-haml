                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Phi}^a(x)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PointEvaluationObservables"}
              = succeed ")," do
                %a.maruku-ref{:href => "#RegularLinearFieldObservables"}
              %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              %a.maruku-eqref{:href => "#eq:CausalPropagatorPPeierlsBracket"} (5)
              is induced from the following distributional bracket between them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Φ
                        %mi a
