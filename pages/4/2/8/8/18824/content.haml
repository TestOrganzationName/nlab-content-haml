                                      %mi δ
                                      %mi EL
                                    %mstyle{:mathvariant => "bold"}
                                      %mi L
                                    %mo )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (i_{\mathcal{E}})^\ast
                    \\left(
                    d \Omega_{BFV}
                    \\right)
                    \&amp; =
                    \- (i_{\mathcal{E}})^\ast
                    \\left(
                    \\delta \delta_{EL} \mathcal{L}
                    \\right)
                    \\\
