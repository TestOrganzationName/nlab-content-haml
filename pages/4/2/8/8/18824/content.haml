                              %mi ℰ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mrow
                              %mo (
                              %mi d
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mi ℰ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mrow
                              %mo (
                              %mi δ
                              %msub
                                %mi δ
                                %mi EL
                              %mi ℒ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi δ
                            %munder
                              %munder
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi i
                                    %mi ℰ
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mo *
