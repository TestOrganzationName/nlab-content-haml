                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Φ
                        %mi b
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Δ
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbf{\Phi}^a(x)
                    ,
                    \\mathbf{\Phi}^b(y)
                    \\right\}
                    \\;=\;
                    \\Delta^{a b}(x,y)
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %a.maruku-eqref{:href => "#eq:CausalPropagator"} (?)
              on the right, in that with the identification
              %a.maruku-eqref{:href => "#eq:AverageOfFieldObservableIsRegularLinearObservables"} (?)
              the
              %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              on regular linear observables arises as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %munder
                                %mo ∫
                                %mi Σ
                              %msubsup
                                %mi α
                                %mi a
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi Φ
                                %mi a
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %munder
                                %mo ∫
                                %mi Σ
                              %msubsup
                                %mi β
                                %mi b
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi Φ
                                %mi b
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo }
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mi Σ
                            %munder
                              %mo ∫
                              %mi Σ
                            %msubsup
                              %mi α
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %munder
                              %munder
                                %mrow
                                  %mo {
                                  %msup
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Φ
                                    %mi a
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %msup
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Φ
                                    %mi b
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo{:stretchy => "false"} )
                                  %mo }
                                %mo ⏟
                              %mrow
                                %mo =
                                %msup
                                  %mi Δ
                                  %mrow
                                    %mi a
                                    %mi b
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi y
                                %mo{:stretchy => "false"} )
                            %msubsup
                              %mi β
                              %mi b
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mi Σ
                            %munder
                              %mo ∫
                              %mi Σ
                            %msubsup
                              %mi α
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi Δ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %msubsup
                              %mi β
                              %mi b
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left\{
                    \\underset{\Sigma}{\int} \alpha^\ast_a(x) \mathbf{\Phi}^a(x) \, dvol_\Sigma(x)
                    \\,,\,
                    \\underset{\Sigma}{\int} \beta^\ast_b(y) \mathbf{\Phi}^b(y) \, dvol_\Sigma(y)
                    \\right\}
                    \&amp; =
                    \\underset{\Sigma}{\int} \underset{\Sigma}{\int}
                    \\alpha^\ast_a(x)
                    \\underset{= \Delta^{a b}(x,y)}{
                    \\underbrace{
                    \\left\{
                    \\mathbf{\Phi}^a(x),
                    \\mathbf{\Phi}^b(y)
                    \\right\}
                    }
                    }
                    \\beta^\ast_b(y)
                    \\, dvol_\Sigma(x)\, dvol_\Sigma(y)
                    \\\
                    \&amp; =
                    \\underset{\Sigma}{\int} \underset{\Sigma}{\int}
                    \\alpha^\ast_a(x)
                    \\Delta^{a b}(x,y)
                    \\beta^\ast_b(y)
                    \\, dvol_\Sigma(x)\, dvol_\Sigma(y)
                    \\end{aligned}
          %p
            (
            %a{:href => "Green+hyperbolic+partial+differential+equation#Khavkine14"}> Khavkine 14, lemma 2.5
            )
          .proof
            %h6#proof_2 Proof
            %p
              Consider two more Cauchy surfaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Σ
                        %mi p
                        %mo ±
                      %mo ↪
                      %msup
                        %mi I
                        %mo ±
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_p^\pm \hookrightarrow I^\pm(\Sigma) \hookrightarrow \Sigma
              %a.existingWikiWord{:href => "/nlab/show/future"} future
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo +
                  %annotation{:encoding => "application/x-tex"} I^+
              and in the
              %a.existingWikiWord{:href => "/nlab/show/past"} past
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo −
                  %annotation{:encoding => "application/x-tex"} I^-
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              consisting of two elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi χ
                      %mo ±
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi^\pm \in C^\infty(\Sigma)
              with
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              bounded by these Cauchy surfaces:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi χ
                        %mo ±
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi I
                        %mo ±
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Σ
                        %mo ∓
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} supp(\chi_\pm) \subset I^\pm(\Sigma^{\mp})
            %p Then define
            #eq:SplittingOfGreenExactSequenceType.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi χ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi scp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P_\chi
                    \\;\colon\;
                    \\Gamma_{\Sigma,scp}(E)
                    \\longrightarrow
                    \\Gamma_{\Sigma,cp}(E^\ast)
            %p by
            #eq:SplittingOfGreenExactSequence.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi P
                              %mi χ
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mphantom
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi χ
                              %mo +
                            %mi Φ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi χ
                              %mo −
                            %mi Φ
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    P_\chi(\Phi)
                    \&amp; \coloneqq
                    \\phantom{-} P(\chi_+ \Phi)
                    \\\
                    \&amp; =
                    \-
                    P(\chi_- \Phi)
                    \\,.
                    \\end{aligned}
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              of the partitioned field history is in the compactly sourced future/past cone
            #eq:ChipmPhiIsSupportedInPastFuture.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mo ±
                    %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mo ±
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_\pm  \Phi
                    \\;\in\;
                    \\Gamma_{\Sigma,\pm cp}(E)
            %p
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is supported in the compactly sourced causal cone, but that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mo ±
                    %mi Φ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(\chi_\pm \Phi)
              indeed has
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              as required by
