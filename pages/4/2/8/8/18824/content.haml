                    \\array{
                    LinObs(E_{scp},\mathbf{L})^{reg} \otimes LinObs(E_{scp},\mathbf{L})^{reg}
                    \&amp;\overset{\{-,-\}}{\longrightarrow}&amp;
                    \\mathbb{R}
                    \\\
                    (\alpha^\ast, \beta^\ast)
                    \&amp;\mapsto&amp;
                    \\underset{\Sigma}{\int}
