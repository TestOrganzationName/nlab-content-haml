                                %mo ∂
                                %msub
                                  %mi Σ
                                  %mi tra
                            %msub
                              %mi Ω
                              %mi BFV
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    0
                    \&amp; =   \tau_{\Sigma_{tra}}(d \Omega_{BFV})
                    \\\
                    \&amp; = ((-)\vert_{\Sigma_{tra}})^\ast \tau_{\partial \Sigma_{tra}} \Omega_{BFV}
                    \\,.
                    \\end{aligned}
          #PPeierlsBracket.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/polynomial+Poisson+algebra"} polynomial Poisson bracket
                on
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                – the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %ol
              %li
                %p
                  it is a
                  %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FreeFieldTheory"}
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                  %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mi Φ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} P \Phi = 0
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
                %ol
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally self-adjoint
                      or
                      %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally anti self-adjoint
                      (def.
                      = succeed ")" do
                        %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
                    %ul
                      %li
                        the integral over the witness
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi K
                            %annotation{:encoding => "application/x-tex"} K
                        %a.maruku-eqref{:href => "#eq:FormallyAdjointDifferentialOperatorWitness"} (?)
                        is the
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
                      = succeed ":" do
                        %a.maruku-eqref{:href => "#eq:TransgressionOfPresymplecticCurrentToCauchySurface"} (2)
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi ω
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi p
                              %mo =
                              %munder
                                %mo ∫
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi p
                              %mi K
                            %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p} = \underset{\Sigma_p}{\int} K
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic
                      (def.
                      = succeed ")." do
                        %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi scp
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} G
                          %mi P
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi scp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{G}_P
                    \\;\colon\;
                    LinObs(E_{scp},\mathbf{L})^{reg}
                    \\overset{\mathrm{G}_P}{\longrightarrow}
                    \\Gamma_{\Sigma,scp}(E)_{\delta_{EL}\mathbf{L} = 0}
            %p
              for the linear map from regular linear field observables (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RegularLinearFieldObservables"}
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              with spatially compact support (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              %a.maruku-eqref{:href => "#eq:RegularLinearObservablesAreCompactlySupportedSectionsModuloImageOfP"} (?)
              by the
              %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathrm{G}_P
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
            %p
              Then for every
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchySurface"}
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PhaseSpaceAssociatedWithCauchySurface"}
              = succeed "," do
                %a.maruku-ref{:href => "#EvaluationOfTransgressedVariationalFormsOnTangentVectorsForFreeFieldTheory"}
            #eq:ForGreenHyperbolicFreeFieldTheoryCausalGreenFunctionIsInverseToPresymplecticFormOnRegularLinearObservables.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi ω
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi{:mathvariant => "normal"} G
                              %mi P
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi ev
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi LinObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mi scp
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi reg
                          %mtd
                            %mo ⊗
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi scp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi A
                          %mtd
                            %mo ,
                          %mtd
                            %mi Φ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi Φ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\omega_{\Sigma_p}(\mathrm{G}_P(-),(-))
                    \\;=\;
                    ev
                    \&amp;\colon&amp;
                    LinObs(E_{scp},\mathbf{L})^{reg} &amp;\otimes&amp; \Gamma_{\Sigma,scp}(E)
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    \&amp;&amp; (A &amp;,&amp; \Phi) &amp;\mapsto&amp; A(\Phi)
                    }
            %p
              equals the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              of observables on field histories.
            %p
              This means that for every
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma_p
              the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p}
              restricts to a
              %em
                %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on regular linear observables. The corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo }
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi scp
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo ⊗
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi scp
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo ⟶
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \-,-
                    \\right\}_{\Sigma_p}
                    \\;\coloneqq\;
                    \\omega_{\Sigma_p}(\mathrm{G}_P(-), \mathrm{G}_P(-))
                    \\;\;\colon\;\;
                    LinObs(E_{scp},\mathbf{L})^{reg} \otimes LinObs(E_{scp},\mathbf{L})^{reg}
                    \\longrightarrow
                    \\mathbb{R}
                    \\,.
            %p
              Moreover, equation
              %a.maruku-eqref{:href => "#eq:ForGreenHyperbolicFreeFieldTheoryCausalGreenFunctionIsInverseToPresymplecticFormOnRegularLinearObservables"} (3)
              implies that this is the
              %em
                covariant
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              in the sense of the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CovariantPhaseSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
            %p
              An equivalent expression for the Poisson bracket that makes its independence from the choice of Cauchy surface manifest is the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                \-
                %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
              given by
            #eq:ThePPeierlsBracket.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
