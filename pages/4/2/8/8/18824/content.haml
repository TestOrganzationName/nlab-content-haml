                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi in
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
