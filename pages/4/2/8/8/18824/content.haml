              %a.maruku-eqref{:href => "#eq:CausalPropagator"} (?)
              the covariant
              %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              is given in
              = succeed "-notation" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            #eq:CausalPropagatorPPeierlsBracket.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
