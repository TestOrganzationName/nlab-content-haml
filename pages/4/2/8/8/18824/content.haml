              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with two boundary components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi Σ
                      %mi tra
                    %mo =
                    %msub
                      %mi Σ
                      %mi in
                    %mo ⊔
                    %msub
                      %mi Σ
                      %mi out
                  %annotation{:encoding => "application/x-tex"} \partial \Sigma_{tra} = \Sigma_{in} \sqcup \Sigma_{out}
              , both of which are
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CauchySurface"}
            %p Then the corresponding inclusion diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
