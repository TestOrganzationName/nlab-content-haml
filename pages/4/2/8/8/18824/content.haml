                      %mo *
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mi Σ
                    %munder
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi α
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
