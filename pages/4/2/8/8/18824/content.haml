            %p
              in that the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of the two
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+forms"} presymplectic forms
              %a.maruku-eqref{:href => "#eq:TransgressionOfPresymplecticCurrentToCauchySurface"} (2)
              coincides on the space of field histories:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
