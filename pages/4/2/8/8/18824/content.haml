                    \\,.
            %p
              Hence there is a well defined
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mrow
                      %mo (
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
