                          %mtd
                          %mtd
                            %msup
                              %mo ↖
                              %mi{:mathvariant => "normal"} out
                        %mtr
                          %mtd
                            %msub
                              %mi Σ
                              %mi in
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Σ
                              %mi out
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \Sigma_{tra}
                    \\\
                    \&amp; {}^{\mathllap{in}}\nearrow &amp;&amp; \nwarrow^{\mathrm{out}}
                    \\\
