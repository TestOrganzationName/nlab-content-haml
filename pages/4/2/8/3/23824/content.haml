          %h2#decidable_subtypes Decidable subtypes
          %p
            Given a Russell type of propositions, a
            %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} P:A \to \mathrm{Prop}
            is a
            %strong decidable subtype
            if for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            satisfies the
            %a.existingWikiWord{:href => "/nlab/show/law+of+excluded+middle"} law of excluded middle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isDecidable
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo ¬
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isDecidable}(P) \equiv \prod_{x:A} P(x) \vee \neg P(x)
          %p
            Similarly, given a Tarski type of propositions, a
            %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} P:A \to \mathrm{Prop}
            is a
            %strong decidable subtype
            if for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            satisfies the
            %a.existingWikiWord{:href => "/nlab/show/law+of+excluded+middle"} law of excluded middle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isDecidable
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo ¬
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isDecidable}(P) \equiv \prod_{x:A} \mathrm{El}(P(x) \vee \neg P(x))
          %p
            For all types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the type of
            %a.existingWikiWord{:href => "/nlab/show/boolean-valued+functions"} boolean-valued functions
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} toDecidSub
                  %mo :
                  %mrow
                    %mo (
                    %mi A
                    %mo →
                    %mi{:mathvariant => "normal"} Bool
                    %mo )
                  %mo ≃
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi P
                        %mo :
                        %mi A
                        %mo →
                        %mi{:mathvariant => "normal"} Prop
                    %mi{:mathvariant => "normal"} isDecidable
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{toDecidSub}:\left(A \to \mathrm{Bool}\right) \simeq \left(\sum_{P:A \to \mathrm{Prop}} \mathrm{isDecidable}(P)\right)
          %p The membership relation of decidable subsets is defined by whether the boolean-valued function evaluations is true
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi P
                  %mo ≔
                  %msup
                    %mi{:mathvariant => "normal"} toDecidSub
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} x \in P \coloneqq \mathrm{toDecidSub}^{-1}(P)(x) =_\mathrm{true}
          %p Decidable subtypes are closed under the empty subtype, the improper subtype, and unions with a disjoint singleton subtype:
          %p The empty subtype and improper subtype are given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ∅
                    %mi A
                  %mo ≔
                  %mi{:mathvariant => "normal"} toDecidSub
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi{:mathvariant => "normal"} false
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mi A
                  %mo ≔
                  %mi{:mathvariant => "normal"} toDecidSub
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi{:mathvariant => "normal"} true
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \emptyset_A \coloneqq \mathrm{toDecidSub}(\lambda x:A.\mathrm{false}) \qquad \im_A \coloneqq \mathrm{toDecidSub}(\lambda x:A.\mathrm{true})
          %p
            Singleton subtypes correspond to boolean-valued functions for which
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} there exists a unique
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            is true, and is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi{:mathvariant => "normal"} bool
                  %mo ∃
                  %mo !
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} bool
                  %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \sum_{f:A \to \mathrm{bool}} \exists!x:A.f(x) =_\mathrm{bool} \mathrm{true}
          %p Unions of decidable subtypes correspond to lambda abstraction of the disjunction of boolean-valued function evaluations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∪
                  %mi Q
                  %mo ≔
                  %mi{:mathvariant => "normal"} toDecidSub
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %msup
                    %mi{:mathvariant => "normal"} toDecidSub
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %msup
                    %mi{:mathvariant => "normal"} toDecidSub
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P \cup Q \coloneqq \mathrm{toDecidSub}(\lambda x:A.\mathrm{toDecidSub}^{-1}(P)(x) \vee \mathrm{toDecidSub}^{-1}(Q)(x))
          %p and intersections of decidable subtypes correspond to lambda abstraction of the conjunction of boolean-valued function evaluations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∩
                  %mi Q
                  %mo ≔
                  %mi{:mathvariant => "normal"} toDecidSub
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %msup
                    %mi{:mathvariant => "normal"} toDecidSub
                    %mrow
