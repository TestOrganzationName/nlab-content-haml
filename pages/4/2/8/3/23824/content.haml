                %annotation{:encoding => "application/x-tex"} A \colon Type
            may be simply be identified with the
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prop
                  %annotation{:encoding => "application/x-tex"} Prop
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Prop
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo →
                  %mi Prop
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo →
                  %mi Ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sub(A)
                  \\;\;
                  \=
                  \\;\;
                  Prop_A
                  \\;\;
                  \\equiv
                  \\;\;
                  A \to Prop
                  \\;\;
                  \\equiv
                  \\;\;
                  A \to \Omega
                  \\,.
          %p
            In
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics+of+dependent+type+theory"} semantics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prop
                %annotation{:encoding => "application/x-tex"} Prop
            is interpreted as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            and subtypes as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
          %p
            Notice that with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prop
                %annotation{:encoding => "application/x-tex"} Prop
            itself being a subtype of a
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} Type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are thus a special case of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Type
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo →
                  %mi Type
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Type_A
                  \\;\;
                  \\equiv
                  \\;\;
                  A \to Type
                  \\,,
          %p
            namely those whose
            %a.existingWikiWord{:href => "/nlab/show/fiber+type"} fiber type
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \colon A
            is the proposition asserting that “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is contained in the subtype”.
          %p This is equivalent to other definitions of subtypes, which one can make sense of also in the absence of a Prop-universe.
          %p
            Notice here that in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
          %ul
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                with the property that for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} x \in B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x \in A
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
                in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ∈
                        %mi 𝒫
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B \in \mathcal{P}(A)
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                with an
                %a.existingWikiWord{:href => "/nlab/show/injection"} injection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mo ↪
                        %mi A
                      %annotation{:encoding => "application/x-tex"} i \colon B \hookrightarrow A
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %em material subtypes
            and
            = succeed "." do
              %em structural subtypes
          %h2#definition Definition
          %h3#material_subtypes Material subtypes
          %p
            We work with a
            %a.existingWikiWord{:href => "/nlab/show/Russell+type+of+all+propositions"} Russell type of all propositions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
          %p
          .num_defn
            %h6 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
              of a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is defined as the function type from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the Russell type of all propositions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi A
                      %mo →
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}(A) \coloneqq A \to \Omega
          %p
            The power set of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is always a set because its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/propositional+extensionality"} propositional extensionality
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong material subtype
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an element of the power set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo :
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B:\mathcal{P}(A)
          %p
          .num_defn
            %h6 Definition
            %p
              The
              %strong local membership relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∈
                      %mi A
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x \in_A B
              between elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and material subtypes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B:\mathcal{P}(A)
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∈
                      %mi A
                    %mi B
                    %mo ≔
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in_A B \coloneqq B(x)
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and a
              %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo :
                      %mi A
                      %mo →
                      %mi{:mathvariant => "normal"} Prop
                    %annotation{:encoding => "application/x-tex"} P:A \to \mathrm{Prop}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 0
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} [P]_0:[A] \to \mathrm{Prop}
              of the
              %a.existingWikiWord{:href => "/nlab/show/set+truncation"} set truncation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi P
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi x
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(x) = [P]_0([x]_0)
          %p
          .proof
            %h6 Proof
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/propositional+extensionality"} propositional extensionality
              %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of propositions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
              is a set, and by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+property+of+set+truncations"} universal property of set truncations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} unique
              function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 0
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} u:[A]_0 \to B
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi x
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x) = u([x]_0)
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              is the set of propositions.
          %h3#structural_subtypes Structural subtypes
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong structural subtype
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              with an embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi B
                      %mo ↪
                      %mi A
                    %annotation{:encoding => "application/x-tex"} i:B \hookrightarrow A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong supertype
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %h3#comparison_between_material_subtypes_structural_subtypes_and_predicates Comparison between material subtypes, structural subtypes, and predicates
          %table
            %thead
              %tr
                %th material subtype
                %th predicate
                %th structural subtype
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo :
                        %mi 𝒫
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B:\mathcal{P}(A)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi x
                        %msub
                          %mo ∈
                          %mi A
                        %mi B
                        %mo ≔
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x:A \vdash x \in_A B \coloneqq B(x)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi x
                        %msub
                          %mo ∈
                          %mi A
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \sum_{x:A} x \in_A B
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mi x
                        %mo :
                        %mi A
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi 𝒫
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda x:A.B(x):\mathcal{P}(A)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
