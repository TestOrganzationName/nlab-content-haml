            is an element of this frame.
          %h3#structural_dedekind_cuts Structural Dedekind cuts
          %p
            There is a structural version of Dedekind cuts in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
            %em structural subset
            of the rational numbers is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo :
                    %mi A
                    %mo ↪
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} i_A:A \hookrightarrow \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            belongs to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            if there exists an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                  %annotation{:encoding => "application/x-tex"} i_A(x) = q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mo ∈
                  %mi A
                  %mo .
                  %msub
                    %mi i
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi q
                %annotation{:encoding => "application/x-tex"} \exists x \in A.i_A(x) = q
          %p
            A
            %strong structural Dedekind cut
            consists of two structural subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %msub
                    %mi i
                    %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L, i_L)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi i
                    %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, i_U)
            with
            %a.existingWikiWord{:href => "/nlab/show/injections"} injections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
