          %p The original article:
          %ul
            %li#Dedekind1872
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Dedekind"}> Richard Dedekind
                ,
                %em Stetigkeit und irrationale Zahlen
                (1872) &amp;lbrack;
                %a{:href => "http://books.google.com/books?id=AO4GAAAAYAAJ"}> Google Books
                , retyped:
                = succeed "&rbrack;" do
                  %a{:href => "http://www.math.ru.nl/werkgroepen/gmfw/bronnen/dedekind2.html"} web
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Dedekind"} Richard Dedekind
                (transl. by W. Beman),
                = succeed "," do
                  %em Continuity and irrational numbers
                = succeed "," do
                  %em Essays on the Theory of Numbers
                = succeed "," do
                  %a{:href => "http://www.gutenberg.org/ebooks/21016"} Project Gutenberg
                = succeed "&rbrack;" do
                  %a{:href => "https://www.gutenberg.org/files/21016/21016-pdf.pdf"} pdf
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+Schechter"}> Eric Schechter
              , 4.31-4.39 in
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Analysis+and+its+Foundations"} Handbook of Analysis and its Foundations
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/B978-0-12-622760-4.X5000-6"} doi:10.1016/B978-0-12-622760-4.X5000-6
          %p
            Discussion in
            = succeed "-theory:" do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
          %ul
            %li#Vickers15
              %a.existingWikiWord{:href => "/nlab/show/Steve+Vickers"}> Steve Vickers
              ,
              = succeed "," do
                %em Localic Completion Of Generalized Metric Spaces I
              %strong 14
              15 (2005) 328-356 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/14/15/14-15abs.html"}> tac:14-15
              \&amp;rbrack;
          %p
            Discussion via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/abstract+Stone+duality"} abstract Stone duality
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"}> Paul Taylor
                ,
                %em
                  %a{:href => "http://www.paultaylor.eu/ASD/dedras/classical"} Dedekind cuts
                (2007-2009?)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"} Paul Taylor
                = succeed "," do
                  %em The Dedekind reals in abstract Stone duality
                %strong 19
                4 (2009) 757-838 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0960129509007695"}> doi:10.1017/S0960129509007695
                \&amp;rbrack;
          %p review in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
              ,
              = succeed "," do
                %em Efficient Computation with Dedekind Reals
              %em
                %a{:href => "https://math.andrej.com/2008/08/24/efficient-computation-with-dedekind-reals/"} Computability and complexity in analysis 2008
              and at
              %em
                %a{:href => "http://cdsagenda5.ictp.trieste.it/full_display.php?smr=0&ida=a07167"} Mathematics, Algorithms and Proofs 2008
              (2008) &amp;lbrack;
              %a{:href => "https://math.andrej.com/2008/08/24/efficient-computation-with-dedekind-reals/"}> web
              , slides:
              = succeed "," do
                %a{:href => "https://math.andrej.com/wp-content/uploads/2008/08/slides-map2008.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://math.andrej.com/wp-content/uploads/2008/08/abstract-cca2008.pdf"} pdf
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+topology"} synthetic topology
          %ul
            %li
              Davorin Lešnik, Synthetic Topology and Constructive Metric Spaces &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2104.10399"}> arxiv:2104.10399
              \&amp;rbrack;
          %p
            Formalization in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#UFP13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
                , §11.2
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
                (2013) &amp;lbrack;
