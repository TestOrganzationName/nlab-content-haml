                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
              are rational numbers with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
