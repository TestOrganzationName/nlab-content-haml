                        f^{-1}(V_j)
                        \\overset{f}{\longrightarrow}
                        V_j
                        \\overset{\psi_j^{-1}}{\longrightarrow}
                        \\mathbb{R}^{n'}
                %p
                  is a
                  = succeed "-fold" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                  between open subsets of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %p
              (Notice that this in in general a non-trivial condition even if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Y
