                    d(g \circ f)_x = d g_{f(x)} \circ d f_x
                    \\,.
          %h3#DifferentiableManifolds Differentiable manifolds
          #DifferentiableManifold.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N} \cup \{\infty\}
              then a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              or
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
