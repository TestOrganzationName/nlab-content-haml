                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          #CategoryDiff.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            %p
              In analogy to remark
              %a.maruku-ref{:href => "#TopCategory"}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              called
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi p
                  %annotation{:encoding => "application/x-tex"} {}_p
              (or similar) whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              and whose
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N} \cup \{\infty\}
          %p
            The analog of the concept of
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Homeomorphism"}
          #Diffeomorphism.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"}> diffeomorphism
                )
            %p
              Given
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              is called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟵
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    X \longleftarrow Y \;\colon\; g
            %p
              which is also a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} {}_\infty
              from remark
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryDiff"}
          %p
            Here it is important to note that while being a
            %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            is just a
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            carries
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            encoded in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
          #SmoothStructure.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"}> smooth structure
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %mo )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %msub
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msub
                              %mi ψ
                              %mi j
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo )
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\longrightarrow} U_i \subset X
                    \\right)_{i \in I}
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\left(
                    \\mathbb{R}^{n} \underoverset{\simeq}{\psi_j}{\longrightarrow} V_j \subset X
                    \\right)_{j \in J}
            %p
              be two
              %a.existingWikiWord{:href => "/nlab/show/atlases"} atlases
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Charts"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diffeomorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi ℝ
                            %mi n
                          %munderover
                            %mo ⟶
                            %mo ≃
                            %mrow
                              %msub
                                %mi ϕ
                                %mi i
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %mi X
                          %mo )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mrow
                      %mo (
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi ℝ
                            %mi n
                          %munderover
                            %mo ⟶
                            %mo ≃
                            %mrow
                              %msub
                                %mi ψ
                                %mi j
                          %msub
                            %mi V
                            %mi j
                          %mo ⊂
                          %mi X
                          %mo )
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    \\left(
                    X
                    \\;,\;
                    \\left(
                    \\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\longrightarrow} U_i \subset X
                    \\right)_{i \in I}
                    \\right)
                    \\overset{\simeq}{\longrightarrow}
                    \\left(
                    X\;,\;
                    \\left(
                    \\mathbb{R}^{n} \underoverset{\simeq}{\psi_j}{\longrightarrow} V_j \subset X
                    \\right)_{j \in J}
                    \\right)
            %p
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              constitutes such a diffeomorphism. (Because if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a diffeomorphism, then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1}\circ f = id_X
              is a diffeomorphism.)
            %p
              That the identity function is a diffeomorphism between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with these two atlases means, by definition
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mrow
                          %mrow
                            %mi j
                            %mo ∈
                            %mi J
                    %mrow
                      %mo (
                      %msubsup
                        %mi ϕ
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                      %msub
                        %mi V
                        %mi j
                      %mover
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi ψ
                            %mi j
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %msup
                        %mi ℝ
                        %mi n
                      %mphantom
                        %mi AA
                      %mtext is smooth
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{{i \in I} \atop {j \in J}}{\forall}
                    \\left(
                    \\phi_i^{-1}(V_j) \overset{\phi_i}{\longrightarrow} V_j \overset{\psi_j^{-1}}{\longrightarrow} \mathbb{R}^n
                    \\phantom{AA}
                    \\text{is smooth}
                    \\right)
                    \\,.
            %p Notice that the functions on the right may equivalently be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊃
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi V
                      %mi j
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi ψ
                          %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msubsup
                      %mi ψ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \supset
                    \\,
                    \\phi_i^{-1}(U_i \cap U_j)
                    \\overset{\phi_i}{\longrightarrow}
                    U_i \cap V_j \overset{\psi_j^{-1}}{\longrightarrow} \psi_j^{-1}(U_i \cap V_j) \; \subset \mathbb{R}^n
            %p showing their analogy to the glueing functions within a single atlas spring.
            %p
              Hence diffeomorphism induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the set of smooth atlases that exist on a given
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              with respect to this equivalence relation is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h2#as_tale_spaces As Étale Spaces
          %p
            Differentiable manifolds can be viewed as akin to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+spaces"} étale spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            and
            %a.existingWikiWord{:href => "/nlab/show/complex+manifolds"} complex manifolds
            the requisite atlas conditions can be stated in terms of a particular structure sheaf. More precisely, this definition yields an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            between the category of smooth manifolds as in
            %a.maruku-ref{:href => "#Charts"}
            and the category of locally ringed spaces modeled on domains of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{R}^n
            with a sheaf of germs of smooth functions. The same goes for topological and complex manifolds, where the local models are domains with sheafs of germs of continuous and holomorphic functions respectively. Here we illustrate the differentiable case. For any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A \subset {\mathbf R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒟
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_A
            for the sheaf of germs of functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^{\infty}(A, \mathbf{R} )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒟
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_A
            is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒟
                    %mi A
                  %mo :
                  %mtext Open
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ring
                    %mtext op
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_A :  \text{Open} (A) \rightarrow {\mathbf Ring}^{\text{op}}
            s.t.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒟
                    %mi A
                  %mo :
                  %mi B
                  %mo ↦
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_A  : B \mapsto C^{\infty}(B, {\mathbf R})
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mi A
                    %mo :
                    %mi B
                    %mo ⊂
                    %mi B
                    %mo ′
                    %mo ↦
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_A  : B \subset B' \mapsto  C^{\infty}(B, {\mathbf R}) \hookrightarrow C^{\infty}(B', {\mathbf R})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi 𝒟
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \mathcal{D}_A)
            into a ringed space, and any ringed space modeled on one of this kind can be regarded as a differentiable (by which is always meant “real”) manifold. More precisely, given a ringed space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi D
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, D_X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊂
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi n
                %annotation{:encoding => "application/x-tex"} A \subset {\mathbf R}^n
            and local isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f, f_*)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f: A \rightarrow X
            is a continuous function with sheaf pushfoward
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi A
                    %mo →
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_* : (\mathcal{O}_A \rightarrow \mathcal{O}_X )
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} F : X \rightarrow Y
              be a continuous surjection. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be a sheaf of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (here we let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be any ring). Consider an open
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U \subset Y
              and define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi R
                      %mi U
                  %annotation{:encoding => "application/x-tex"} Q(U) \subset R^U
              to be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo :
                    %mi U
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi F
                      %mo *
                    %mi f
                    %mo =
                    %mi f
                    %mo ∘
                    %mi F
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ f : U \rightarrow R  | F^{*} f = f \circ F|_{f^{-1}(U)} \in P(F^{-1}(U)) \}
              i.e. those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              s.t. the pullback of each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi F
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(F^{-1}(U))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is a sheaf on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          %p
            We can phrase the example of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %msup
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{R}P^n
            in this language.
          #DifferentiableManifoldCartesianSpace.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
                as a
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                in this
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+map"} étale map
                sense)
            %p
              We need only show that the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi V
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %msup
                      %mi P
                      %mi n
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f : V \subset {\mathbf R}P^n \rightarrow {\mathbf R}^n
              which are smooth when composed with the canonical projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \pi : {\mathbf R}^{n+1}/\{ 0 \} \rightarrow {\mathbf R }P^n
              form a sheaf on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %mi n
                    %annotation{:encoding => "application/x-tex"} {\mathbf R}^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi R
                          %msup
                            %mi P
                            %mi n
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_{{\mathbf R}P^n}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {\mathbf R}P^n
              is a real topological manifold. To establish its differentiable structure we take for each chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, \varphi)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {\mathbf R}P^n
              the ringed space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi φ
                      %mo *
                    %msub
                      %mi 𝒪
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %msup
                          %mi P
                          %mi n
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\varphi(U), \varphi_* \mathcal{O}_{{\mathbf R}P^n}|_U )
              obtained from restriction and then pushforward, a local isomorphism of locally ringed spaces by construction. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %msup
                          %mi P
                          %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ({\mathbf R}P^n, \mathcal{O}_{{\mathbf R}P^n})
              is a smooth manifold.
          %h2#Examples Examples
          #DifferentiableManifoldCartesianSpace.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              consisting of the single
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mi id
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \overset{id}{\to} \mathbb{R}^n
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            %p
              Similarly the
              %a.existingWikiWord{:href => "/nlab/show/open+disk"} open disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              when equipped with the atlas whose single chart is the
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo →
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \to D^n
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} n = 4
              there are
              %em other
              smooth structures on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structures"} exotic smooth structures
          .num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              becomes a smooth manfold, with
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              consisting of the two
              %a.existingWikiWord{:href => "/nlab/show/local+charts"} local charts
              that are given by the
              %a.existingWikiWord{:href => "/nlab/show/inverse+functions"} inverse functions
              of the
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              from the two poles of the sphere onto the
              %a.existingWikiWord{:href => "/nlab/show/equator"} equatorial
              hyperplane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi σ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %msup
                          %mi S
                          %mi n
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n
                    \\underoverset{\simeq}{\sigma^{-1}_i}{\longrightarrow}
                    S^n
                    \\right\}_{i \in \{+,-\}}
                    \\,.
            %p
              By the formulas given in
              %a{:href => "stereographic+projection#StandardStereographicProjection"} this prop.
              the induced
              %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo \
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo \
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \backslash \{0\} \to \mathbb{R}^n \backslash \{0\}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %p
              Finally the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+topological+space"} paracompact Hausdorff topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} S^n \subset \mathbb{R}^{n+1}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+subspace"} compact subspace
                  by the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
                  %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                  of Hausdorff spaces are Hausdorff;
              %li
                %p
                  The
                  = succeed "-sphere" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/CW-complexes+are+paracompact+Hausdorff+spaces"} CW-complexes are paracompact Hausdorff spaces
          .num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                        %msup
                          %mi P
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}P^n
                  has the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                        %msup
                          %mi P
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
                  has the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of (real)
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi n
                        %annotation{:encoding => "application/x-tex"} 2n
            %p
              where in both cases the
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              is given by the standard open cover (
              %a{:href => "projective+space#TopologicalProjectiveSpaceStandardOpenCover"}> this def.
              ).
          %p
            By
            = succeed "." do
              %a{:href => "projective+space#SmoothManifoldRealComplexProjectiveSpace"} this prop.
          %p We now discuss some general mechanisms by which new differentiable manifolds arise from given ones:
          #ProductManifold.num_example
            %h6#example_5 Example
            %p
              %strong (product manifold)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be two differentiable manifolds with
              %a.existingWikiWord{:href => "/nlab/show/atlases"} atlases
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n\underoverset{\simeq}{\phi_i}{\to} U_i \subset X\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo ′
                      %munderover
                        %mo →
                        %mo ≃
                        %mrow
                          %msub
                            %mi ψ
                            %mi j
                      %msub
                        %mi V
                        %mi j
                      %mo ⊂
                      %mi Y
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^{n'}\underoverset{\simeq}{\psi_j}{\to} V_j \subset Y\}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              becomes an differentiable manifold with respect to the atlas
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo ⋅
                            %mi n
                            %mo ′
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                            %mo ×
                            %msub
                              %mi ψ
                              %mi j
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo ×
                        %mi Y
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi I
                        %mo ×
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^{n \cdot n'}
                    \\underoverset{\simeq}{\phi_i \times \psi_j}{\to}
                    U_i \times V_j
                    \\subset
                    X \times Y
                    \\right\}_{(i,j) \in I \times J}
          #OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                of differentiable manifolds are differentiable manifolds)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              carries the structure of a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+differentiable+manifolds"} embedding of differentiable manifolds
          .proof
            %h6#proof Proof
            %p
              Since the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              (
              %a{:href => "topological+manifold#LocalPropertiesOfLocallyEuclideanSpace"}> this prop.
              ) it is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (
              %a{:href => "locally+connected+topological+space#AlternativeCharacterizationsOfLocalConnectivity"}> this prop.
              ).
            %p
              Therefore we are reduced to showing the statement for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a single
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              %a{:href => "topological+manifold#RegularityConditionsForTopologicalManifoldsComparison"} this prop
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/second-countable+topological+space"} second-countable topological space
            %p
              Now a
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of a second-countable Hausdorff space is clearly itself second countable and Hausdorff.
            %p
              Similarly it is immediate that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is still
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is locally Euclidean every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in S \subset X
              has a Euclidean neighbourhood in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is open there exists an open ball in that (itself
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to Euclidean space) which is a Euclidean neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              For the differentiable structure we pick these Euclidean neighbourhoods from the given atlas. Then the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              for the Euclidean charts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"}> general linear group
                )
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gl(n,\mathbb{R})
              is a smooth manifold (as an
              %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi Mat
                        %mrow
                          %mi n
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi n
                            %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{R}) \subset Mat_{n \times n}(\mathbb{R}) \simeq \mathbb{R}^{(n^2)}
              %a.maruku-ref{:href => "#OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds"}
              and example
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            %p
              The group operations are
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              with respect to this smooth manifold structure, and thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{R})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
