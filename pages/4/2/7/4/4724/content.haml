                  %mrow
                    %msup
                      %mi C
                      %mi p
                  %annotation{:encoding => "application/x-tex"} C^p
              differentiable for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
