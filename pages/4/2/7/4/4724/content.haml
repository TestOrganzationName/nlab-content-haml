                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  times continuously
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable
            %p
              A
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              between
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi ℝ
                        %mi n
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mi f
                        %mphantom
                          %mi AA
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo ′
                      %mover
                        %mo →
                        %mrow
                          %msub
