                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mi f
                        %msub
                          %mi V
                          %mi j
                        %mover
                          %mo ⟶
                          %mrow
                            %msubsup
                              %mi ψ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
