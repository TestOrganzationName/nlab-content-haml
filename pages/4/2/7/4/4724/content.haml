          %h3#DifferentiableFunctionsBetweenCartesianSpaces Differentiable functions between Cartesian spaces
          %p
            For convenience we recall the definition of
            %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
          #DifferentiableFunctionBetweenCartesianSpaces.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}^n
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; U \longrightarrow \mathbb{R}
              is called
              %strong differentiable
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mo :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} d f_x : \mathbb{R}^n \to \mathbb{R}
              such that the following
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              exists as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              approaches zero “from all directions at once”:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi h
                        %mo →
                        %mn 0
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi d
                        %msub
                          %mi f
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi h
                        %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_{h\to 0} \frac{f(x+h)-f(x) - d f_x(h)}{\Vert h\Vert} = 0.
            %p
              This means that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon \in (0,\infty)
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V\subseteq U
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi h
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x+h\in V
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo +
                          %mi h
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi d
                          %msub
                            %mi f
                            %mi x
                          %mo{:stretchy => "false"} (
                          %mi h
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi h
                          %mo{:stretchy => "false"} ‖
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \frac{f(x+h)-f(x) - d f_x(h)}{\Vert h\Vert} \lt \epsilon
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em differentiable on
              a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is differentiable at every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x\in I
              %em differentiable
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is differentiable on all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em continuously differentiable
              if it is differentiable and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                  %annotation{:encoding => "application/x-tex"} d f_x
              is called the
              %strong derivative
              or
              = succeed "." do
                %strong
                  differential of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} U\subseteq \mathbb{R}^{n_1}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; U \longrightarrow \mathbb{R}^{n_2}
              is
              %em differentiable
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, n_2\}
              the component function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mover
                      %mo ⟶
                      %mi f
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi pr
                          %mi u
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f_i \;\colon\; U \overset{f}{\longrightarrow} \mathbb{R}^{n_2} \overset{pr_u}{\longrightarrow}  \mathbb{R}
            %p is differentiable in the previous sense
            %p
              In this case, the derivatives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} d f_i \colon \mathbb{R}^n \to \mathbb{R}
              of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              assemble into a linear map of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d f_x \;\colon\; \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                    \\,.
            %p
              If the derivative exists at each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} x \in U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msub
                      %mi Hom
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ,
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ⋅
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    d f \;\colon\; U \longrightarrow Hom_{\mathbb{R}}(\mathbb{R}^{n_1} , \mathbb{R}^{n_2}) \simeq \mathbb{R}^{n_1 \cdot n_2}
            %p
              to the space of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em twice continuously differentiable
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
              is continuously differentiable.
            %p
              Generally then, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is called
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-fold continuously differentiable
              or
              %em
                of class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi k
                    %annotation{:encoding => "application/x-tex"} C^k
              if the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mi k
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d^k f
              exists and is a continuous function.
            %p
              Finally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              then it is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              or
              = succeed "." do
                %em
                  of class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            Of the various properties satisfied by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
          #ChainRuleOnEuclideanSpace.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                for
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ,
                    %msub
                      %mi n
                      %mn 3
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2, n_3 \in \mathbb{N}
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mover
                      %mo ⟶
                      %mi g
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{n_1}
                    \\overset{f}{\longrightarrow}
                    \\mathbb{R}^{n_2}
                    \\overset{g}{\longrightarrow}
                    \\mathbb{R}^{n_3}
            %p
              be two
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableFunctionBetweenCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of their
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              is the composite of their derivatives:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d(g \circ f) = (d g) \circ (d f)
            %p
              hence for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
