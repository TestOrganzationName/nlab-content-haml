                %strong VIII
                (1873) 183-184 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/978-3-319-26042-6"}> doi:10.1007/978-3-319-26042-6
                \&amp;rbrack;
          %p Monographs:
          %ul
            %li
