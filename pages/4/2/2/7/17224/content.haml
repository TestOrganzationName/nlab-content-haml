          %h2#idea Idea
          %p
            A
            %em Serre long exact sequence
            of a
            %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            is a
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            groups associated with a
            %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            with sufficiently highly connected base and fibers. It arises as a special case of the information contained in the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
          %h2#statement Statement
          #SerreLongExactSequenceForHighlyConnectedBaseAndFiber.num_prop
            %h6#proposition Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F &amp;\overset{i}{\longrightarrow}&amp; X
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \&amp;&amp; B
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              such that
            %ol
              %li
                %p
                  the base space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi n
                            %mn 1
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n_1-1)
                  %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"} connected
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo ≥
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n_1 \geq 2
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  = succeed "-connected," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi n
                            %mn 2
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n_2-1)
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo ≥
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n_1 \geq 1
            %p
              then for every
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              there is a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mo *
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi τ
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{n_1 + n_2 - 1}(F,A)
                    \\overset{i_\ast}{\longrightarrow}
                    H_{n_1 + n_2 - 1}(X,A)
                    \\overset{p_\ast}{\longrightarrow}
                    H_{n_1 + n_2 - 1}(B,A)
                    \\overset{\tau}{\longrightarrow}
                    H_{n_1 + n_2 - 2}(F,A)
                    \\overset{i_\ast}{\longrightarrow}
                    \\cdots
                    \\overset{i_\ast}{\longrightarrow}
                    H_1(X,A)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Consider the homology
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
              of the given fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo =
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_2 = H_q(B, H_p(F,A)) \;\Rightarrow\; H_\bullet(X,A)
                    \\,.
            %p
              By the connectedness assumptions and the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mn 0
                        %mo &lt;
                        %mo •
                        %mo &lt;
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_{0 \lt \bullet \lt n_1}(B,-) = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mn 0
                        %mo &lt;
                        %mo •
                        %mo &lt;
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_{0 \lt \bullet \lt n_2}(F,-) = 0
            %p
              and hence the only possibly non-vanishing groups on the second page of the spectral sequence (hence on every higher page) in total degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %msub
                      %mi n
                      %mn 1
                    %mo +
                    %msub
                      %mi n
                      %mn 2
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \leq n_1 + n_2 - 1
              are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{k,0}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mn 0
                          %mo ,
                          %mi k
                        %mi r
                    %annotation{:encoding => "application/x-tex"} E^r_{0,k}
            %p On the second page these groups are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mn 2
                    %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^2_{k,0} \simeq H_k(B,H_0(F,A)) \simeq H_k(B,A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                      %mn 2
                    %mo ≃
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^2_{0,k} \simeq H_0(B,H_k(F,A)) \simeq H_k(F,A)
            %p
              by the fact that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              are connected by assumption.
            %p
              Now, since the differentials on the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi r
                      %mo ,
                      %mi r
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-r,r+1)
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %msub
                      %mi n
                      %mn 1
                    %mo +
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} k \leq n_1 + n_2
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mi k
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                        %mo −
                        %mn 1
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_k
                    \\;\colon\;
                    E^k_{k,0}
                    \\longrightarrow
                    E^k_{0,k-1}
                    \\,.
            %p
              This being so, it follows that the above non-vanishing groups on the
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              remain intact up to these pages, hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mi k
                    %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                        %mo −
                        %mn 1
                      %mi k
                    %mo ≃
                    %msub
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^k_{k,0} \simeq H_k(B,A)
                    \\;\;\;\;\;
                    \\,,
                    \\;\;\;\;\;
                    E^k_{0,k-1} \simeq H_{k-1}(F,A)
                    \\,.
            %p
              Moreover, by convergence of the spectral sequence there are
              %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mn ∞
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mi k
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi k
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                        %mo −
                        %mn 1
                      %mi k
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                        %mo −
                        %mn 1
                      %mn ∞
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    E^\infty_{k,0}
                    \\longrightarrow
                    E^k_{k,0}
                    \\overset{\partial_k}{\longrightarrow}
                    E^k_{0,k-1}
                    \\longrightarrow
                    E^\infty_{0,k-1}
                    \\to
                    0
                    \\,,
            %p hence, by the previous statement, of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mn ∞
                    %mo ⟶
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi k
                    %msub
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                        %mo −
                        %mn 1
                      %mn ∞
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    E^\infty_{k,0}
                    \\longrightarrow
                    H_k(B,A)
                    \\overset{\partial_k}{\longrightarrow}
                    H_{k-1}(F,A)
                    \\longrightarrow
                    E^\infty_{0,k-1}
                    \\to
                    0
                    \\,,
            %p
              Finally, by convergence and the
              %a.existingWikiWord{:href => "/nlab/show/filtering"} filtering
              condition, the only non-vanishing filter contributions to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_k(X,A)
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %msub
                      %mi n
                      %mn 1
                    %mo +
                    %msub
                      %mi n
                      %mn 2
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \leq n_1 + n_2 - 1
              are in filtering degree 0 and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              gives a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mn 0
                        %mo ,
                        %mi k
                      %mn ∞
                    %mo ⟶
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mn 0
                      %mn ∞
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    E^\infty_{0,k}
                    \\longrightarrow
                    H_k(X,A)
                    \\longrightarrow
                    E^\infty_{k,0}
                    \\to
                    0
                    \\,.
            %p Splicing together the exact sequences thus obtained yields the long exact sequence in question:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi H
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %msub
                              %mi H
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %msub
                              %mi H
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi H
                              %mrow
                                %mi k
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mn 0
                                %mo ,
                                %mi k
                              %mn ∞
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mi k
                                %mo ,
                                %mn 0
                              %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \&amp;\to&amp;
                    H_k(F,A)
                    \&amp;&amp; \longrightarrow &amp;&amp;
                    H_k(X,A)
                    \&amp;&amp; \longrightarrow &amp;&amp;
                    H_k(B,A)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    H_{k-1}(F,A)
                    \&amp;\to&amp;
                    \\cdots
                    \\\
                    \&amp;&amp;
                    \&amp;
                    \\searrow
                    \&amp;&amp; \nearrow
                    \&amp;
                    \&amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp;
                    \&amp;&amp;
                    E^\infty_{0,k}
                    \&amp;&amp;
                    \&amp;&amp; E^\infty_{k,0}
                    }
          %h2#examples_and_applications Examples and Applications
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"} n-connected topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq 2n
              there are
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_k(X) \simeq H_{k-1}(\Omega X)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and the ordinary homology of the
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k-1
          .proof
            %h6#proof_2 Proof
            %p
              The Serre long exact sequence from prop.
              %a.maruku-ref{:href => "#SerreLongExactSequenceForHighlyConnectedBaseAndFiber"}
              applied to the based
              %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi X
                    %mo ⟶
                    %msub
                      %mi Path
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega X \longrightarrow Path_\ast(X) \longrightarrow X
            %p is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %msub
                      %mi H
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Path
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mo *
                    %msub
                      %mi H
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi τ
                    %msub
                      %mi H
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{2n}(\Omega X)
                    \\overset{i_\ast}{\longrightarrow}
                    H_{2n}(Path_\ast(X))
                    \\overset{p_\ast}{\longrightarrow}
                    H_{2n}(X)
                    \\overset{\tau}{\longrightarrow}
                    H_{2n-1}(\Omega X)
                    \\overset{i_\ast}{\longrightarrow}
                    \\cdots
                    \\overset{i_\ast}{\longrightarrow}
                    H_1(X)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Path
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path_\ast(X)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau \colon H_k(X) \simeq H_{k-1}(\Omega X)
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \leq 2n
