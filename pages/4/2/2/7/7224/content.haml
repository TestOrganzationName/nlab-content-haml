            %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
            , for a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo ⟶
                  %mi E
                %annotation{:encoding => "application/x-tex"} L \colon C \longrightarrow E
            to have a
            %em
              right
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            (or
            = succeed ")" do
              %em
                right
                = succeed "-coadjoint" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⟶
                  %mi C
                %annotation{:encoding => "application/x-tex"} R \colon A \longrightarrow C
            means that there is a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  E\big(L(-), J(-)\big)
                  \\;\simeq\;
                  C\big(-, R(-)\big)
          %p
            Such a situation is called a
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              \-relative coadjunction
            and is denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %msub
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mspace{:width => "thinmathspace"}
                      %mi J
                    %mspace{:width => "negativethinmathspace"}
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L {\,\,}_J\!\dashv R
