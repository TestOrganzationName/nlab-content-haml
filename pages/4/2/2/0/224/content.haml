                  %mi Vect
                %annotation{:encoding => "application/x-tex"} pt \to 2Vect
            maps to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
