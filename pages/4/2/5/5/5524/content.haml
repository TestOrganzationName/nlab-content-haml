            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            of formal smooth
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
            factors through a version relative to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+singular+simplicial+complex"} infinitesimal path ∞-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{inf}(X)
            %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            and the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+space"} de Rham space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+%E2%88%9E-stack"} quasicoherent ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi inf
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{inf}(X)
            are
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/D-module"} D-module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#definition Definition
          %p
            We consider
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            over a “twisted semidirect product”
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            or
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            of
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                with
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                between them as for
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
            %li
              %p
                and a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                or
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
          %p First in
          %ul
            %li
              %a{:href => "#Localic"} 1-localic definition
          %p we consider the 1-site, then in
          %ul
            %li
              %a{:href => "#DerivedDefinition"} ∞-localic definition
          %p
            we consider the
            = succeed "-site." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#Localic 1-localic definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo :
                    %mo =
                  %annotation{:encoding => "application/x-tex"} T :=
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
              be the
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
              of
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothAlg
                    %mo :
                    %mo =
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"}
                    SmoothAlg := T Alg
            %p
              for its category of
              %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+Lawvere+theory"} T-algebras
              – the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              = succeed "-rings)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi InfPoint
                    %mo ↪
                    %msup
                      %mi SmoothAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    InfPoint \hookrightarrow SmoothAlg^{op}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on the
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ⊕
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \oplus V
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a finite-
              %a.existingWikiWord{:href => "/nlab/show/dimension"}> dimension
              al real
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              and nilpotent in the algebra structure.
          .num_defn
            %h6#definition_3 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalCartSp
                    %mo ↪
                    %mi SmoothLoc
                  %annotation{:encoding => "application/x-tex"}
                    FormalCartSp \hookrightarrow SmoothLoc
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the category of
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
              on the objects of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    U = \mathbb{R}^n \times D
            %p
              that are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ∈
                      %mi InfPoint
                    %annotation{:encoding => "application/x-tex"} D \in InfPoint
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/FormalCartSp"} FormalCartSp
            %p
              Equip this category with the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              where a family of morphisms is
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              precisely if it is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mi D
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi i
                        %mo ,
                        %msub
                          %mi Id
                          %mi D
                        %mo{:stretchy => "false"} )
                    %mi U
                    %mo ×
                    %mi D
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \times D \stackrel{(f_i, Id_D)}{\to} U \times D\}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo :
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f_i : U_i \to U\}
              a covering in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
              (a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          %p This appears as ([Kock 86, (5.1)]).
          .num_remark
            %h6#note Note
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              over
              %a.existingWikiWord{:href => "/nlab/show/FormalCartSp"} FormalCartSp
              is (
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to) the
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              known as the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
              %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
              that constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} well adapted model
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
              for further references.
          .num_defn
            %h6#definition_4 Definition
            %p
              We say the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of
              %strong
                formal smooth
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi FormalCartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    FormalSmooth \infty Grpd := Sh_{(\infty,1)}(FormalCartSp)
            %p
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalCartSp
                    %annotation{:encoding => "application/x-tex"} FormalCartSp
          %h3#DerivedDefinition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-localic
          %p
            We now generalize the 1-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi InfPoint
                %annotation{:encoding => "application/x-tex"} InfPoint
            of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
            to the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi InfPoint
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} InfPoint_\infty
            of “derived infinitesimally thickened points”, the formal dual of “small commutative
            = succeed "-algebras\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a{:href => "#Hinich"} Hinich
            = succeed ")." do
              %a{:href => "#Lurie"} Lurie
          %p (…)
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth \infty Grpd
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          .proof
            %h6#proof Proof
            %p
              Because
              %a.existingWikiWord{:href => "/nlab/show/FormalCartSp"} FormalCartSp
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
          .num_defn
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmoothMfd
                    %mo ↪
                    %msup
                      %mi SmoothAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} FormalSmoothMfd \hookrightarrow SmoothAlg^{op}
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
              on the
              = succeed ":" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifolds"} formal smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/FormalCartSp"} FormalCartSp
              equipped with the evident
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          #CartSpAsDenseSubOfFSmoothMfd.num_prop
            %h6#observation Observation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalCartSp
                  %annotation{:encoding => "application/x-tex"} FormalCartSp
              is a
              %a.existingWikiWord{:href => "/nlab/show/dense+sub-site"} dense sub-site
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalSmoothMfd
                    %annotation{:encoding => "application/x-tex"} FormalSmoothMfd
          #EquivalenceToToposOverSoothSynthMfd.num_prop
            %h6#proposition_2 Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                    %mo ≃
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi FSmoothMfd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    FormalSmooth\infty Grpd \simeq \hat Sh_{(\infty,1)}(FSmoothMfd)
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FSmoothMfd
                    %annotation{:encoding => "application/x-tex"} FSmoothMfd
          .proof
            %h6#proof_2 Proof
            %p
              With the
              %a{:href => "#CartSpAsDenseSubOfFSmoothMfd"} above observation
              this is directly analogous to the corresponding proof at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
          .num_defn
            %h6#definition_6 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi CartSp
                      %mi smooth
                    %mo ↪
                    %mi FormalCartSp
                  %annotation{:encoding => "application/x-tex"} i : CartSp_{smooth} \hookrightarrow FormalCartSp
              for the canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} embedding
          #CohesivenessUnderSmoothInfGrpd.num_prop
            %h6#proposition_3 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^*
              given by restriction along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth\infty Grpd
              as an
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#LieTheory"} infinitesimal cohesive neighbourhood
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
