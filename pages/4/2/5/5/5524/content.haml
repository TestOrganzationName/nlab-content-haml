                  %annotation{:encoding => "application/x-tex"} x \in X
              there is a bijection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi x
                      %mi X
                      %mo ≃
                      %msub
                        %mi T
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} T_x X \simeq T_{f(x)}Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              being a local diffeo is necessary for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              being formally étale with respect to the given notion of infinitesimal cohesion.
            %p
              To see that this is also sufficient notice that this is evident for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in fact a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          .num_prop
            %h6#proposition_14 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+groupoid"} étale groupoid
              in the traditional sense, precisely if regarded as an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                  %annotation{:encoding => "application/x-tex"} i :
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %a.existingWikiWord{:href => "/nlab/show/FormalSmooth%E2%88%9EGrpd"} FormalSmooth∞Grpd
              it is an
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion#EtaleObjects"} cohesive étale ∞-groupoid
          .proof
            %h6#proof_12 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo →
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \to \mathcal{G}
              be the inclusion of the smooth manifold of objects. This is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28infinity%2C1%29-category"} effective epimorphism
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion#FormallySmoothEtaleUnramified"} formally étale
              with respect to the given cohesive neighbourhood.
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              we may compute the characteristic
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              that presents
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 0
                      %mo →
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \to \mathcal{G}
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              such is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒢
                      %mi I
                    %msub
                      %mo ×
                      %mi 𝒢
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo →
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}^I \times_{\mathcal{G}} \mathcal{G}_0 \to \mathcal{G}
                    \\,.
            %p By inspection one see that this morphism is
            %ul
              %li
                %p
                  in degree 0 the target-map
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo :
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi 𝒢
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mi 𝒢
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} t : Mor(\mathcal{G}) \to \mathcal{G}_0
              %li
                %p
                  in degree 1 the projection
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi 𝒢
                          %mo{:stretchy => "false"} )
                          %msub
                            %mrow
                            %mi t
                          %msub
                            %mo ×
                            %mi s
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi 𝒢
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi 𝒢
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Mor(\mathcal{G}) {}_t\times_{s} Mor(\mathcal{G}) \to Mor(\mathcal{G})
            %p
              By prop.
              %a.maruku-ref{:href => "#RecoveringLocalDiffeomorphisms"}
              both of these need to be
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+maps"} étale maps
              in the ordinary sense. By definition, this is the case precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+groupoid"} étale groupoid
          %h3#formally_smooth__formally_unramified_morphisms Formally smooth / formally unramified morphisms
          %p
            As a direct consequence of prop.
            %a.maruku-ref{:href => "#RecoveringLocalDiffeomorphisms"}
            we have the following
          .num_prop
            %h6#proposition_15 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/submersion"} submersion
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalSmooth
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} FormalSmooth \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formally smooth morphism
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formally+unramified+morphism"} formally unramified morphism
          .proof
            %h6#proof_13 Proof
            %p
              As in the proof of prop.
              %a.maruku-ref{:href => "#RecoveringLocalDiffeomorphisms"}
              we find that the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi i
                          %mo *
                        %mi Y
                    %msub
                      %mi i
                      %mo !
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i_* X \times_{i_* Y} i_! Y
              is over the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+interval"} infinitesimal interval
              isomorphic to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X \times_Y T Y
            %p
              and the canonical morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_! X
              into this pullback is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi T
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T X \to X \times_Y T Y
                    \\,.
          %h3#LieDifferentiation Lie differentiation
          %p
            We indicate how to formalize
            %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
            in the context of formal smooth
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inf
                  %mo :
                  %msub
                    %mi InfPoint
                    %mn ∞
                  %mo ↪
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  inf : InfPoint_\infty \hookrightarrow \mathbf{H}^{*/}
          %p
            be the canonical inclusion. By (
            %a{:href => "#Lurie"}> Lurie, theorem 0.0.13, remark 0.0.15
            , also
            = succeed ")" do
              %a{:href => "#Formal+Moduli+Problems+and+DG-Lie+Algebras#Pridham"} Pridham 07
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lie
                    %mn ∞
                  %mo ↪
                  %msub
                    %mi Sh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi InfPoint
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Lie_\infty \hookrightarrow Sh_\infty(InfPoint_\infty)
          %p
            on those objects whose space of global sections is contractible and which are
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-presheaf+on+E-%E2%88%9E+rings"} infinitesimally cohesive
            (for a somewhat different notion of “infinitesimal cohesion”, beware the terminology). Consider then the
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mover
                    %mo →
                    %mi yoneda
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi inf
                        %mo *
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi InfPoint
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Grp(\mathbf{H})
                  \\simeq
                  \\mathbf{H}^{*/}_{\geq 1}
                  \\stackrel{yoneda}{\to}
                  PSh_\infty( \mathbf{H}^{*/})
                  \\stackrel{inf^*}{\to}
                  PSh_\infty(InfPoint_\infty)
          %p
            which sends a pointed connected formal smooth
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            to the
            = succeed "-presheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi pt
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{pt} \to \mathbf{B}G
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi pt
                    %mo ∈
                    %msub
                      %mi InfPoint
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbf{pt} \in InfPoint_\infty
          %p
            By assumption that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is connected (and we need to assume that it is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-stack"} geometric
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Artin-Lurie+representability+theorem"} Artin-Lurie representability theorem
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mover
                    %mo →
                    %mi Lie
                  %msub
                    %mi Lie
                    %mn ∞
                  %mo ↪
                  %msub
                    %mi Sh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi InfPoint
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{*/}_{\geq 1}
                  \\stackrel{Lie}{\to}
                  Lie_\infty
                  \\hookrightarrow
                  Sh_\infty(InfPoint_\infty)
                  \\,.
          %p
            The resulting
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lie
                  %mo :
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo →
                  %msub
                    %mi Lie
                    %mn ∞
                %annotation{:encoding => "application/x-tex"}
                  Lie : Grp(\mathbf{H}) \simeq \mathbf{H}^{*/}_{\geq 1} \to Lie_\infty
          %p is Lie differentiation.
          %p
            For differentiation of smooth groupoids with
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \to X
            to
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroids"} L-infinity algebroids
            this happens under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{U/}
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean-topological+%E2%88%9E-groupoid"} Euclidean-topological ∞-groupoid
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometries of physics
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                    (
                    %a.existingWikiWord{:href => "/nlab/show/higher+geometry"}> higher
                    )
                    %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                    %a.existingWikiWord{:href => "/nlab/show/site"} site
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                    %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
