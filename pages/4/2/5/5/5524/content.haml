              be the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+algebras"} projective model structure on cosimplicial smooth algebras
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi SmoothAlg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi FormalCartSp
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} j : (SmoothAlg^{\Delta})^{op} \to [FormalCartSp, sSet]
              be the prolonged external
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %ol
              %li
                %p
                  This constitutes the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo ⊣
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi SmoothAlg
                          %mi Δ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mover
                          %munder
                            %mo →
                            %mi j
                          %mover
                            %mo ←
                            %mi 𝒪
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi FSmoothMfd
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
