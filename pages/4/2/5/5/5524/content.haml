                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (\mathcal{O} \dashv j)
                        
                        \:
                        (SmoothAlg^\Delta)^{op}
                        \\stackrel{\overset{\mathcal{O}}{\leftarrow}}{\underset{j}{\to}}
                        [FSmoothMfd^{op}, sSet]_{proj,loc}
                        \\,.
              %li
                %p
                  Restricted to
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formal smooth manifold
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi FSmoothMfd
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                        %mo ↪
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi SmoothAlg
                          %mi Δ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"}
                        FSmoothMfd^{\Delta^{op}}
                        \\hookrightarrow
                        (SmoothAlg^\Delta)^{op}
                %p
                  the right
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
                  that factors through the
                  %a.existingWikiWord{:href => "/nlab/show/cohomology+localization"} cohomology localization
                  and thus identifies a full
                  %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi FSmoothMfd
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ∘
                        %mo ↪
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mi sdiff
                        %mo ↪
                        %mi FormalSmooth
                        %mn ∞
                        %mi Grpd
                      %annotation{:encoding => "application/x-tex"}
                        (FSmoothMfd^{\Delta^{op}})^\circ
                        \\hookrightarrow
                        \\mathbf{L}_{sdiff}
                        \\hookrightarrow
                        FormalSmooth\infty Grpd
              %li
                %p
                  The intrinsic
                  = succeed "-cohomology" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi FormalSmooth
                        %mn ∞
                        %mi Grpd
                      %annotation{:encoding => "application/x-tex"} X \in FormalSmooth\infty Grpd
                  is computed by the ordinary
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore cochain complex
                  underlying the cosimplicial abelian group of the image under the left
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝕃
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathbb{L}\mathcal{O})(X)
                  under the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi H
                          %mi fSmooth
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msubsup
                          %mi H
                          %mi cochain
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi N
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝕃
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H_{fSmooth}^n(X)
                        \\simeq
                        H^n_{cochain}(N^\bullet(\mathbb{L}\mathcal{O})(X))
                        \\,.
          .proof
            %h6#proof_6 Proof
            %p
              First a remark on the sites. By the
              %a{:href => "#EquivalenceToToposOverSoothSynthMfd"} above proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth\infty Grpd
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
              over
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formal smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
              by the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [FSmoothMfd^{op}, sSet]_{proj,loc}
              at the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected"} ∞-connected
              morphisms. But a fibrant object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [FSmoothMfd^{op}, sSet]_{proj,loc}
              that is also
              %a.existingWikiWord{:href => "/nlab/show/n-truncated"} n-truncated
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              is also fibrant in the hyperlocalization (only for the untruncated object there is an additional condition). Therefore the right Quillen functor claimed above indeed lands in truncated objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FormalSmooth
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} inftyGrpd
                    %annotation{:encoding => "application/x-tex"} FormalSmooth \inftyGrpd
            %p
              The proof of the above statements is given in (
              %a{:href => "#Stel"}> Stel
              ), following (
              %a{:href => "#Toen"}> Toën
              ). Some details are spelled out at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
          %h4#cohomology_of_lie_groups Cohomology of Lie groups
          #RealCohomologyOfCompactLieGroup.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi SmoothMfd
                    %mo ↪
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} G \in SmoothMfd \hookrightarrow Smooth\infty Grpd \hookrightarrow FormalSmooth\infty Grpd
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %p
              Then the intrinsic group cohomology in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              and in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth\infty Grpd
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              coincides with
              = succeed "\u2018s" do
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Segal
              %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
              (
              %a{:href => "#Segal"}> Segal
              ,
              = succeed ")." do
                %a{:href => "#Brylinski"} Brylinski
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi smooth
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi fsmooth
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi Segal
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{smooth}(\mathbf{B}G, \mathbb{R})
                    \\simeq
                    H^n_{fsmooth}(\mathbf{B}G, \mathbb{R})
                    \\simeq
                    H^n_{Segal}(G,\mathbb{R})
                    \\,.
          %p
            For the full proof please see
            %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} here, section 3.4
            for the moment.
          .num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              we have for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi smooth
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi top
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{smooth}(G,U(1))
                    \\simeq H_{top}^{n+1}(B G, \mathbb{Z})
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              This follows from applying the
              %a{:href => "#RealCohomologyOfCompactLieGroup"} above result
              to the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              induced by the sequence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo →
                      %mi ℝ
                      %mo →
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to \mathbb{R} \to \mathbb{R}/\mathbb{Z} = U(1)
          .num_note
            %h6#note_2 Note
            %p
              This means that the intrinsic cohomology of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth\infty Grpd
              coincides for these coefficients with the Segal-Blanc-Brylinski refined Lie group cohomology (
              %a{:href => "#Brylinski"}> Brylinski
              ).
          %h4#CohomologyOfLieAlgebroids
            Cohomology of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          #IntrinsicRealCohomologyByCECohomology.num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %mi{:mathvariant => "normal"} Algd
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} \in L_\infty \mathrm{Algd}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} FormalSmooth
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                  %annotation{:encoding => "application/x-tex"} \mathrm{FormalSmooth}\infty \mathrm{Grpd}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi{:mathvariant => "normal"} FormalSmooth
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n(\mathfrak{a}, \mathbb{R})
                    \:=
                    \\pi_0 \mathrm{FormalSmooth}\infty \mathrm{Grpd}(\mathfrak{a}, \mathbf{B}^n \mathbb{R})
            %p
              coincides with its ordinary
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+cohomology"} L-∞ algebroid cohomology
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n(\mathfrak{a}, \mathbb{R})
                    \\simeq
                    H^n(\mathrm{CE}(\mathfrak{a}))
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              By the
              %a{:href => "#PresentationOfCohomologyLocalization"} above propoposition
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %msup
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n(\mathfrak{a}, \mathbb{R}) \simeq
                    H^n N^\bullet(\mathbb{L}\mathcal{O})(i(\mathfrak{a}))
                    \\,.
            %p
              By
              %a{:href => "http://ncatlab.org/nlab/source/Lie+infinity-algebroid#CofibrantResolutionOfLinfinityAlgebroid"} this lemma
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %msup
                      %mi N
                      %mo •
                    %mrow
                      %mo (
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    H^n N^\bullet
                    \\left(
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot \mathcal{O}(i(\mathfrak{a})_k)
                    \\right)
                    \\,.
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\mathfrak{a})_\bullet
              is cofibrant in the Reedy model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi{:mathvariant => "normal"} op
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} SmoothAlg
                      %mi{:mathvariant => "normal"} proj
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} op
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi{:mathvariant => "normal"} Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{\mathrm{op}}, (\mathrm{SmoothAlg}^\Delta_{\mathrm{proj}})^{\mathrm{op}}]_{\mathrm{Reedy}}
              relative to the opposite of the projective model structure on cosimplicial algebras:
              %br>/
              the map from the latching object in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} SmoothAlg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} \mathrm{SmoothAlg}^\Delta)^{\mathrm{op}}
              is dually in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} SmoothAlg
                    %mo ↪
                    %msup
                      %mi{:mathvariant => "normal"} SmoothAlg
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathrm{SmoothAlg} \hookrightarrow \mathrm{SmoothAlg}^\Delta
              the projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mi{:mathvariant => "normal"} CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %msubsup
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi{:mathvariant => "normal"} CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{i = 0}^n \mathrm{CE}(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
                    \\to
                    \\oplus_{i = 0}^{n-1} \mathrm{CE}(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
            %p
              hence is a surjection, hence a fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} SmoothAlg
                      %mi{:mathvariant => "normal"} proj
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathrm{SmoothAlg}^\Delta_{\mathrm{proj}}
              and therefore indeed a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi{:mathvariant => "normal"} SmoothAlg
                        %mi{:mathvariant => "normal"} proj
                        %mi Δ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi{:mathvariant => "normal"} op
                    %annotation{:encoding => "application/x-tex"} (\mathrm{SmoothAlg}^\Delta_{\mathrm{proj}})^{\mathrm{op}}
            %p
              Therefore using the Quillen bifunctor property of the coend over the tensoring in reverse to
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/source/Lie+infinity-algebroid#CofibrantResolutionOfLinfinityAlgebroid"} this lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %msup
                      %mi N
                      %mo •
                    %mrow
                      %mo (
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\simeq
                    H^n N^\bullet
                    \\left(
                    \\int^{[k] \in \Delta} \Delta[k] \cdot \mathcal{O}(i(\mathfrak{a})_k)
                    \\right)
            %p with the fat simplex replaced again by the ordinary simplex. But in brackets this is now by definition the image under the monoidal Dold-Kan correspondence of the Chevalley-Eilenberg algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mo •
                    %mi Ξ
                    %mi{:mathvariant => "normal"} CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\simeq
                    H^n( N^\bullet \Xi \mathrm{CE}(\mathfrak{a}) )
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              we have hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    H^n(\mathrm{CE}(\mathfrak{a}))
                    \\,.
          %p
            It follows that a degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            is presented by a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi 𝔞
                  %mo →
                  %msup
                    %mi b
                    %mi n
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mu : \mathfrak{a} \to b^n \mathbb{R}
                  \\,,
          %p
            where on the right we have the
            = succeed "-algebroid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} CE
                  %annotation{:encoding => "application/x-tex"} \mathrm{CE}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo =
                  %mi b
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} = b \mathfrak{g}
            is the delooping of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            this is equivalently a morphism of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu : \mathfrak{g} \to b^{n-1} \mathbb{R}
                  \\,.
          %h4#de_rham_theorem de Rham theorem
          %blockquote
            %p under construction
          %p
            We consider the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth \infty Grpd
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mrow
                      %mi dR
                      %mo ,
                      %mi inf
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi FormalSmooth
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi inf
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{dR,inf}^n(X) := \pi_0 FormalSmooth \infty Grpd(X, \mathbf{\flat}_{inf} \mathbf{B}^n \mathbb{R})
                  \\,.
          #deRhamTheorem.num_prop
            %h6#proposition_10 Proposition
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi inf
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{inf} \mathbf{B}^n \mathbb{R}
                    \\to
                    \\mathbf{\flat} \mathbf{B}^n \mathbb{R}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          %p
            This means that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            the infinitesimal de Rham cohomology coincides with the ordinary real cohomology of the geometric realization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mrow
                      %mi dR
                      %mo ,
                      %mi inf
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n_{dR, inf}(X)
                  \\simeq
                  H^n(|X|, \mathbb{R})
                  \\,.
          .proof
            %h6#proof_9 Proof
            %p Since all representables are formally smooth, we have a colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Π
                          %mi inf
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi U
                    %mover
                      %mo →
                      %mo →
                    %mi U
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U \times_{\mathbf{\Pi}_{inf}(U)} U
                    \\stackrel{\to}{\to}
                    U
                    \\stackrel{}{\to}
                    \\mathbf{\Pi}_{inf}(U)
                    \\,.
            %p In the presentation over the site we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Π
                          %mi inf
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo :
                    %mi K
                    %mo ×
                    %mi D
                    %mo ↦
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi K
                    %mo ×
                    %mi D
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} |
                    %mi K
                    %mo →
                    %mi K
                    %mo ×
                    %mi D
                    %mover
                      %mo →
                      %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \times_{\mathbf{\Pi}_{inf}(X)} X :
                    K \times D \mapsto
                    \\{
                    f,g : K \times D \to U | K \to K \times D \stackrel{\to}{\to} U
                    \\}
                    \\,.
            %p
              Therefore a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{inf}(U) \to  \mathbb{R}
              is equivalently a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi U
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \phi : U \to \mathbb{R}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mi D
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} K \times D \to U
              that coincide on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              we have that all the composites
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mi D
                    %mo →
                    %mi U
                    %mover
                      %mo →
                      %mi ϕ
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    K \times D \to U \stackrel{\phi}{\to} \mathbf{B}^n \mathbb{R}
            %p
              are equals. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is the point, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is necessarily constant. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is not the point, there is one nontrivial tangent vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_*(v)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              must be constant.
          %p
            This kind of argument is indicated in (
            %a{:href => "#SimpsonTeleman"}> Simpson-Teleman, prop. 3.4
            ).
          #PiInfAndTangents.num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi inf
                          %mo •
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi formalsmooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X^{\Delta^\bullet_{inf}} \in [CartSp_{formalsmooth}^{op}, sSet]
              for the
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              regarded as a simplicial object (see
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroid"} L-infinity algebroid
              for the details).
            %p
              Then there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi inf
                          %mo •
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\Delta^\bullet_{inf}} \to \mathbf{\Pi}_{inf}(X)
              which is an equivalence in
              = succeed "-cohomology." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p (…)
          %h3#StructureSheaves
            Formally étale morphisms and cohesive étale
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss
            %a{:href => "#http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion#FormallySmoothEtaleUnramified"} formally étale morphisms
            and
            %a{:href => "#"} étale objects
            with respect to the cohesive infinitesimal neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                %annotation{:encoding => "application/x-tex"} i :
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow FormalSmooth\infty Grpd
          .num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a degreewise smooth
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+manifold"} simplicial manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} j_! X_\bullet
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} FormalSmooth \infty Grpd
              is presented by the same simplicial manifold.
          .proof
            %h6#proof_10 Proof
            %p
              First consider an ordinary smooth paracompact manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              and the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mi in
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) in [CartSp_{smooth}^{op}, sSet]_{proj}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
              is computed on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by evaluating the corresponding simplicial functor (of which it is the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\{U_i\})
            %p Since the simplicial functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi formalsmooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"}
                    j_!
                    \:
                    [CartSp_{smooth}^{op}, sSet]_{proj, loc}
                    \\to
                    
                    [CartSp_{formalsmooth}^{op}, sSet]_{proj, loc}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              (indeed a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              and
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              that the Cech nerve is built from:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi j
                              %mo !
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi j
                              %mo !
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                            %msub
                              %mi j
                              %mo !
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi i
                                  %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    j_! C(\{U_i\})
                    \&amp; =
                    j_! \int^{[n] \in \Delta} \Delta[n] \cdot \coprod_{i_0, \cdots, i_n}
                    U_{i_0, \cdots, i_n}
                    \\\
                    \&amp; =
                    \\int^{[n] \in \Delta} \Delta[n] \cdot \coprod_{i_0, \cdots, i_n}
                    j_! (U_{i_0, \cdots, i_n})
                    \\\
                    \&amp; =
                    \\int^{[n] \in \Delta} \Delta[n] \cdot \coprod_{i_0, \cdots, i_n}
                    U_{i_0, \cdots, i_n}
                    \\end{aligned}
                    \\,.
            %p
              Here we used that, by assumption on a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi n
                  %annotation{:encoding => "application/x-tex"} U_{i_0, \cdots, i_n}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
              coincides on
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              with the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mi smooth
                      %mo ↪
                      %msub
                        %mi CartSp
                        %mi formalsmooth
                    %annotation{:encoding => "application/x-tex"} CartSp_{smooth} \hookrightarrow CartSp_{formalsmooth}
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a general simplicial manifold. Assume that in each degree there is a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mrow
