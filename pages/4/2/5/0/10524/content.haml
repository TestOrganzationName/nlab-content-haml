            %a.existingWikiWord{:href => "/nlab/show/quantum+spin+Hall+effect"} quantum spin Hall effect
            in graphene:
          %ul
            %li#KaneMele05a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Kane"}> Charles Kane
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eugene+Mele"} Eugene Mele
                = succeed "," do
