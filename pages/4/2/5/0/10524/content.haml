              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+K.+Geim"} Andre K. Geim
              = succeed "," do
                %em The electronic properties of graphene
              %strong 81
              (2009) 109 &amp;lbrack;
              %a{:href => "https://doi.org/10.1103/RevModPhys.81.109"}> doi:10.1103/RevModPhys.81.109
              \&amp;rbrack;
          %p
            Computation of the (tiny)
            %a.existingWikiWord{:href => "/nlab/show/spin-orbit+coupling"} spin-orbit coupling
            in graphene:
          %ul
            %li#MHSSKM06
              Hongki Min, J. E. Hill,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nikolai+A.+Sinitsyn"} Nikolai A. Sinitsyn
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Allan+H.+MacDonald"} Allan H. MacDonald
              = succeed "," do
                %em Intrinsic and Rashba spin-orbit interactions in graphene sheets
              %strong 74
              (2006) 165310 &amp;lbrack;
              %a{:href => "https://doi.org/10.1103/PhysRevB.74.165310"}> doi:10.1103/PhysRevB.74.165310
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/cond-mat/0606504"} arXiv:cond-mat/0606504
          %p
            Observation that the
            %a.existingWikiWord{:href => "/nlab/show/spin-orbit+coupling"} spin-orbit coupling
            in graphene should open the gap at the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+points"} Dirac points
