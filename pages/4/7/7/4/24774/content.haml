          %title
          %p This page compiles pointers to material contained in the book collection:
          %p
            %br/
          %ul
            %li
              %p
                Cosimo Bambi, Leonardo Modesto,
                %a.existingWikiWord{:href => "/nlab/show/Ilya+L.+Shapiro"} Ilya L. Shapiro
                (eds.):
              %p
                %br/
              %p
                %strong
                  %a{:href => "https://link.springer.com/referencework/9789819976805"} Handbook of Quantum Gravity
              %p
                %br/
              %p Springer (2025)
              %p
                %a{:href => "https://doi.org/10.1007/978-981-19-3079-9"} doi:10.1007/978-981-19-3079-9
          %p
            on aspects of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
          %p
            %br/
          %p
            %strong Contents:
          %blockquote
            %p for the time being in no particular order
          %p
            %br/
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+gravity"} perturbative quantum gravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ilya+L.+Shapiro"}> Ilya L. Shapiro
              ,
              = succeed "," do
                %em The background information about perturbative quantum gravity
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2210.12319"} arXiv:2210.12319
          %p
            %br/
          %p
            Viewed as an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} effective quantum field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+F.+Donoghue"}> John F. Donoghue
              ,
              = succeed "," do
                %em Quantum General Relativity and Effective Field Theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2211.09902"} arXiv:2211.09902
          %p
            %br/
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+gravity"} perturbative quantum gravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Petr+M.+Lavrov"}> Petr M. Lavrov
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ilya+Shapiro"} Ilya Shapiro
              = succeed "," do
                %em Gauge invariant renormalizability of quantum gravity
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2210.09271"} arXiv:2210.09271
          %p
            %br/
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            of
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+gravity"} perturbative quantum gravity
            with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
          %ul
            %li
              Nobuyoshi Ohta,
              = succeed "," do
                %em One-loop divergences in higher-derivative gravity
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2210.02583"} arXiv:2210.02583
          %p
            %br/
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/gravitational+waves"} gravitational waves
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
          %ul
            %li
              Amaury Micheli, Patrick Peter,
              = succeed "," do
                %em Quantum cosmological gravitational waves?
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2211.00182"} arXiv:2211.00182
          %p
            %br/
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/black+hole+thermodynamics"} black hole thermodynamics
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+gravity"} perturbative quantum gravity
          %ul
            %li
              Dmitri V. Fursaev,
              = succeed "," do
                %em Black Hole Thermodynamics and Perturbative Quantum Gravity
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2210.06081"} arXiv:2210.06081
          %p
            %br/
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/soft+graviton+theorem"} soft graviton theorem
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Martin+Beneke"}> Martin Beneke
              , Patrick Hager, Robert Szafron,
              = succeed "," do
                %em Soft-Collinear Gravity and Soft Theorems
              %em Effective Quantum Gravity
              of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2210.09336"} arXiv:2210.09336
          %p
            %br/
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Constantin+Bachas"}> Constantin Bachas
              \:
              = succeed "," do
                %em D-branes
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/2311.18456"} arXiv:2311.18456
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-981-19-3079-9"} doi:10.1007/978-981-19-3079-9
          %p
            %br/
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlo+Angelantonj"}> Carlo Angelantonj
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ioannis+Florakis"} Ioannis Florakis
              = succeed "," do
                %em A Lightning Introduction to String Theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2406.09508"} arXiv:2406.09508
          %p
            %br/
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/pure+spinor"} pure spinor
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Berkovits+superstring"} Berkovits superstring
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathan+Berkovits"}> Nathan Berkovits
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Carlos+R.+Mafra"} Carlos R. Mafra
              = succeed "," do
                %em Pure spinor formulation of the superstring and its applications
              %em
                %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              (2023) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2210.10510"}> arXiv:2210.10510
              \&amp;rbrack;
          %p
            %br/
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Liam+McAllister"}> Liam McAllister
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fernando+Quevedo"} Fernando Quevedo
              = succeed "," do
                %em Moduli Stabilization in String Theory
              %em
                %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2310.20559"}> arXiv:2310.20559
              \&amp;rbrack;
          %p
            %br/
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"}> Ergin Sezgin
              ,
              = succeed "," do
                %em Survey of supergravities
              %em
                %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Gravity"} Handbook of Quantum Gravity
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2312.06754"}> arXiv:2312.06754
              \&amp;rbrack;
          %p
            %br/
          %p
            On the usage of
            %a.existingWikiWord{:href => "/nlab/show/pure+spinor"} pure spinor
            %a.existingWikiWord{:href => "/nlab/show/superfields"} superfields
            in maximal
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
              ,
