                %annotation{:encoding => "application/x-tex"} x
            in the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi b
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} g(x) \gt -\frac{b}{2a}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi b
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} h(x) \lt -\frac{b}{2a}
          %p
            Since this differential equation is separable, one could use separation of variables to see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            satisfy the
            %a.existingWikiWord{:href => "/nlab/show/functional+equations"} functional equations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo +
                  %mi b
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi c
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} a g(x)^2 + b g(x) + c = x
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mi b
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi c
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} a h(x)^2 + b h(x) + c = x
          %p
            If the discriminant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo =
                  %msup
                    %mi b
                    %mn 2
                  %mo −
                  %mn 4
                  %mi a
                  %mi c
                %annotation{:encoding => "application/x-tex"} \Delta = b^2 - 4 a c
            is greater than zero
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has two zeroes apart from each other. The larger of the two zero of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            is at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g(0)
            and the smaller zero of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            is at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(0)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \leq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          %h3#square_roots Square roots
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a = 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f(x) \coloneqq x^2
            %a.existingWikiWord{:href => "/nlab/show/continuous+principal+square+root"} continuous principal square root
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} sqrt
                      %mi{:mathvariant => "normal"} cont
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathrm{sqrt}_\mathrm{cont}:(0, \infty) \to \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msub
                    %mi{:mathvariant => "normal"} sqrt
                    %mi{:mathvariant => "normal"} cont
                  %mo{:stretchy => "false"} )
                  %mfrac
                    %mrow
                      %mi d
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} cont
                    %mrow
                      %mi d
                      %mi x
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (2 \mathrm{sqrt}_\mathrm{cont}) \frac{d \mathrm{sqrt}_\mathrm{cont}}{d x} = 1
          %p
            with initial condition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} sqrt
                      %mi{:mathvariant => "normal"} cont
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathrm{sqrt}_\mathrm{cont}(1) = 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi{:mathvariant => "normal"} sqrt
                      %mi{:mathvariant => "normal"} cont
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} -\mathrm{sqrt}_\mathrm{cont}:(0, \infty) \to \mathbb{R}
          %h3#quadratic_formula Quadratic formula
          %p
            For any quadratic function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo +
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} cont
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mi ax
                      %mo +
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 4
                      %mi ac
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} g(x) = \frac{-b + \mathrm{sqrt}_\mathrm{cont}(4ax + b^2 - 4ac)}{2a}
          %p and the reflected branch has a canonical definition in terms of the continuous principal square root as well:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo −
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} cont
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mi ax
                      %mo +
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 4
                      %mi ac
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} h(x) = \frac{-b - \mathrm{sqrt}_\mathrm{cont}(4ax + b^2 - 4ac)}{2a}
          %p
            The
            %strong continuous quadratic formula
            is the evaluation of the two branches at zero, if zero is in the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo +
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} cont
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 4
                      %mi ac
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} g(0) = \frac{-b + \mathrm{sqrt}_\mathrm{cont}(b^2 - 4ac)}{2a}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo −
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} cont
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 4
                      %mi ac
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} h(0) = \frac{-b - \mathrm{sqrt}_\mathrm{cont}(b^2 - 4ac)}{2a}
          %p
            The continuous quadratic formula is only valid for real quadratic functions with positive discriminant, unlike the
            %a.existingWikiWord{:href => "/nlab/show/quadratic+formula"} quadratic formula
            in the
            %a.existingWikiWord{:href => "/nlab/show/discrete+field"} discrete field
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quadratic+irrational+numbers"} quadratic irrational numbers
            %a.existingWikiWord{:href => "/nlab/show/quadratic+functions"} quadratic functions
            with
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            and a non-negative discriminant. But there’s an analytic reason for why the quadratic formula should be restricted to real quadratic functions with positive discriminant: for any real quadratic function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            with a non-positive discriminant
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \leq 0
            %a.existingWikiWord{:href => "/nlab/show/intermediate+value+theorem"} intermediate value theorem
            are fulfilled: if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \geq 0
            for all real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \lt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \leq 0
            for all real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %h3#negative_and_zero_discriminant Negative and zero discriminant
          %p
            As stated above, when a real quadratic function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has a non-positive discriminant,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \leq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \geq 0
            for all real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \lt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \leq 0
            for all real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has a negative discriminant,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \lt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is provably always
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} apart
            from zero: if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \gt 0
            for all real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \lt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) \lt 0
            for all real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has no zeroes in the real numbers if the determinant of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is negative.
          %p
            Now, suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has zero discriminant. This means that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mo −
                    %mn 4
                    %mi ac
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b^2 - 4ac = 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/completing+the+square"} completing the square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %msup
                    %mrow
                      %mo (
                      %mi x
                      %mo +
                      %mfrac
                        %mi b
                        %mrow
                          %mn 2
                          %mi a
                      %mo )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f(x) = a \left(x + \frac{b}{2a}\right)^2
          %p
            By definition of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered field
            %a.existingWikiWord{:href => "/nlab/show/nilpotent+elements"} nilpotent elements
            in the real numbers whose absolute value is greater than zero, and thus every nilpotent element is equal to zero. As a result,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %msup
                    %mrow
                      %mo (
                      %mi x
                      %mo +
                      %mfrac
                        %mi b
                        %mrow
                          %mn 2
                          %mi a
                      %mo )
                    %mn 2
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) = a \left(x + \frac{b}{2a}\right)^2 = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo (
                      %mi x
                      %mo +
                      %mfrac
                        %mi b
                        %mrow
                          %mn 2
                          %mi a
                      %mo )
                    %mn 2
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \left(x + \frac{b}{2a}\right)^2 = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo +
                  %mfrac
                    %mi b
                    %mrow
                      %mn 2
                      %mi a
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x + \frac{b}{2a} = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi b
                    %mrow
                      %mn 2
                      %mi a
                %annotation{:encoding => "application/x-tex"} x = -\frac{b}{2a}
          %p
            There is only one zero, which occurs at the
            %a.existingWikiWord{:href => "/nlab/show/extremum"} extremum
            of the real quadratic function.
          %h3#in_constructive_mathematics_2 In constructive mathematics
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/law+of+trichotomy"} law of trichotomy
            holds in the real numbers, so the three cases above cover every real number. However, in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            such that one cannot decide whether the discriminant of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is positive, negative, or zero. As a result, there exist real quadratic functions where one cannot decide the number of zeroes the function has. Furthermore, one cannot prove that a real quadratic function with positive determinant has exactly two zeroes.
          %h2#newtons_method Newton’s method
          %p
            Given a real quadratic function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi a
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi b
                  %mi x
                  %mo +
                  %mi c
                %annotation{:encoding => "application/x-tex"} f(x) \coloneqq a x^2 + b x + c
            for real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \vert a \vert \gt 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Newton%27s+method"} Newton's method
            which would allow us to do so. The real quadratic function has
            %a.existingWikiWord{:href => "/nlab/show/discriminant"} discriminant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo =
                  %msup
                    %mi b
                    %mn 2
                  %mo −
                  %mn 4
                  %mi a
                  %mi c
                %annotation{:encoding => "application/x-tex"} \Delta = b^2 - 4 a c
            and has 2 zeroes if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \gt 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \lt 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          %p
            Assume that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} x_0 \in \mathbb{R}
            as the initial guess, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi a
                  %msub
                    %mi x
                    %mn 0
                  %mo +
                  %mi b
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 2 a x_0 + b \gt 0
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi a
                    %msub
                      %mi x
                      %mn 0
                    %mo +
                    %mi b
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 2 a x_0 + b \lt 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo =
                  %msub
                    %mi x
                    %mi i
                  %mo −
                  %mfrac
                    %mrow
                      %mi a
                      %msubsup
                        %mi x
                        %mi i
                        %mn 2
                      %mo +
                      %mi b
                      %msub
                        %mi x
                        %mi i
                      %mo +
                      %mi c
                    %mrow
                      %mn 2
                      %mi a
                      %msub
                        %mi x
                        %mi i
                      %mo +
                      %mi b
                %annotation{:encoding => "application/x-tex"} x_{i+1} = x_i - \frac{a x_i^2 + b x_i + c}{2 a x_i + b}
          %p
            Newton’s method isn’t valid when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi a
                  %msub
                    %mi x
                    %mn 0
                  %mo +
                  %mi b
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 2 a x_0 + b = 0
            because of division by zero. When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi a
                    %msub
                      %mi x
                      %mn 0
                    %mo +
                    %mi b
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 2 a x_0 + b \gt 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &gt;
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mi b
                      %mrow
                        %mn 2
                        %mi a
                  %annotation{:encoding => "application/x-tex"} x \gt -\frac{b}{2a}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi a
                    %msub
                      %mi x
                      %mn 0
                    %mo +
                    %mi b
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 2 a x_0 + b \lt 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mi b
                      %mrow
                        %mn 2
                        %mi a
                  %annotation{:encoding => "application/x-tex"} x \lt -\frac{b}{2a}
