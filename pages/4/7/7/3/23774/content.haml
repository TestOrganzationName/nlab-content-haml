                    %mrow
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 4
                      %mi a
                      %mi c
                    %mrow
                      %mn 4
                      %mi a
                %annotation{:encoding => "application/x-tex"}
                  f(x) = a \left(x + \frac{b}{2a}\right)^2 - \frac{b^2 - 4 a c}{4a}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/extremum"} extremum
