                    %mo +
                    %mi b
                    %mi x
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} f(x) \coloneqq a x^2 + b x + c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
