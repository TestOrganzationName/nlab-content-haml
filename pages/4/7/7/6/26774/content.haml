          %h2#idea Idea
          %p
            An
            %strong indexing system
            is a combinatorial datum which uniquely determines an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/N-%E2%88%9E+operad"} N-∞ operad
          %h2#definitions Definitions
          %h3#indexing_systems Indexing systems
          %p
            In the following definition, fix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            an
            %a.existingWikiWord{:href => "/nlab/show/orbital+%E2%88%9E-category"} orbital ∞-category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi 𝒯
                  %mo ≔
                  %msup
                    %mi 𝒯
                    %mo ⨿
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{\mathcal{T}} \coloneqq \mathcal{T}^{\amalg}
            its
            %a.existingWikiWord{:href => "/nlab/show/finite+coproduct"} finite-coproduct
            closure.
          %p
            For instance,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            may be the
            %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi G
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{\mathcal{O}_G}
            is the category of
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
          %p
          .num_defn
            %h6 Definition
            %p
              A full
              = succeed "-subcategory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi 𝔽
                        %mo ̲
                      %mi I
                    %mo ⊂
                    %msub
                      %munder
                        %mi 𝔽
                        %mo ̲
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_I \subset \underline{\mathbb{F}}_{\mathcal{T}}
              is called a
              %strong weak indexing system
              if
            %ol
              %li
                %p
                  (objects) whenever the
                  = succeed "-value" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mrow
                            %mi I
                            %mo ,
                            %mi V
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_{I,V}
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/inhabited"} nonempty
                  = succeed "-set" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo *
                            %mi V
                        %annotation{:encoding => "application/x-tex"} *_V
              %li
                %p
                  (composition) for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo ∈
                          %msub
                            %munder
                              %mi 𝔽
                              %mo ̲
                            %mi I
                        %annotation{:encoding => "application/x-tex"} S \in \underline{\mathbb{F}}_I
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mi I
                        %mo ⊂
                        %msub
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mi 𝒯
                      %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_I \subset \underline{\mathbb{F}}_{\mathcal{T}}
                  is closed under
                  = succeed "-indexed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_I
                  is called an
                  %strong indexing system
                  if, additionally,
              %li
                %p
                  (coproducts) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo ∈
                          %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} V \in \mathcal{T}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ⋅
                        %msub
                          %mo *
                          %mi V
                        %mo ∈
                        %msub
                          %mi 𝔽
                          %mrow
                            %mi I
                            %mo ,
                            %mi V
                      %annotation{:encoding => "application/x-tex"} n \cdot *_V \in \mathbb{F}_{I,V}
            %p
          %h3#indexing_categories Indexing categories
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %msub
                      %mi 𝔽
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} I \subset \mathbb{F}_{\mathcal{T}}
              is called a
              %strong weak indexing category
              if it satisfies the following conditions:
            %ol
              %li
                %p
                  (restriction-stability) morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  is stable under
                  %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                  along arbitrary maps in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔽
                            %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} \mathbb{F}_{\mathcal{T}}
              %li
                %p
                  (Segal condition) A pair of maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo →
                        %mi S
                      %annotation{:encoding => "application/x-tex"} T \rightarrow S
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ′
                        %mo →
                        %mi S
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} T' \rightarrow S'
                  are in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  if and only if their coproduct
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ⊔
                        %mi T
                        %mo ′
                        %mo →
                        %mi S
                        %mo ⊔
                        %mi S
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} T \sqcup T' \rightarrow S \sqcup S'
                  is in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  \-action)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  contains all
                  %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                  of its objects.
            %p
              A weak indexing category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %msub
                      %mi 𝔽
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} I \subset \mathbb{F}_{\mathcal{T}}
              is called an
              %strong indexing category
              if it contains the fold map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ⋅
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} n \cdot V \rightarrow V
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} cT
                  %annotation{:encoding => "application/x-tex"} V \in \cT
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            a weak indexing category, we may define a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %munder
                      %mi 𝔽
                      %mo ̲
                    %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi V
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi S
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                    %mi V
                    %mi 𝒯
                  %mi S
                  %mo →
                  %mi V
                  %mo ∈
                  %mi I
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %msub
                    %mi 𝔽
                    %mi V
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\underline{\mathbb{F}}_I)_V \coloneqq \{S \mid \Ind_V^{\mathcal{T}} S \rightarrow V \in I\} \subset \mathbb{F}_{V}.
          %p
          .num_theorem
            %h6 Theorem
            %p
              The assignment
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ↦
                    %msub
                      %munder
                        %mi 𝔽
                        %mo ̲
                      %mi I
                  %annotation{:encoding => "application/x-tex"} I \mapsto \underline{\mathbb{F}}_I
              furnishes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              between the
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              of weak indexing categories and weak indexing systems; this restricts to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              between indexing categories and indexing systems.
          %h3#unitality_conditions Unitality conditions
          %p
          .num_defn
            %h6 Definition
            %p
            %ol
              %li
                %p
                  A weak indexing system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_I
                  is
                  %strong almost essentially unital
                  (or aE-unital) if for all non-contractible
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo ∈
                          %msub
                            %mi 𝔽
                            %mrow
                              %mi I
                              %mo ,
                              %mi V
                        %annotation{:encoding => "application/x-tex"} S \in \mathbb{F}_{I,V}
                  = succeed "-set" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ∅
                          %mi V
                      %annotation{:encoding => "application/x-tex"} \emptyset_V
                  is in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔽
                            %mrow
                              %mi I
                              %mo ,
                              %mi V
                        %annotation{:encoding => "application/x-tex"} \mathbb{F}_{I,V}
              %li
                %p
                  A weak indexing system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_I
                  is
                  %strong unital
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ∅
                          %mi V
                        %mo ∈
                        %msub
                          %mi 𝔽
                          %mrow
                            %mi I
                            %mo ,
                            %mi V
                      %annotation{:encoding => "application/x-tex"} \emptyset_V \in \mathbb{F}_{I,V}
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo ∈
                          %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} V \in \mathcal{T}
            %p
          %h3#transfer_systems Transfer systems
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Sub
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Sub}(G)
            be the
            %a.existingWikiWord{:href => "/nlab/show/subgroup+lattice"} subgroup lattice
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊂
                  %mi{:mathvariant => "normal"} Sub
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R \subset \mathrm{Sub}(G)
            is a
            %em transfer system
            if it is closed under
            %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊂
                  %msub
                    %mi 𝔽
                    %mi G
                %annotation{:encoding => "application/x-tex"} I \subset \mathbb{F}_G
            an indexing system, we let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi{:mathvariant => "normal"} Sub
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(I) \subset \mathrm{Sub}(G)
            denote the subposet consisting of inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⊂
                  %mi H
                %annotation{:encoding => "application/x-tex"} K \subset H
            such that the corresponding map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/K \rightarrow G/H
            is in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a{:href => "#Rubin17"} Rubin 2017
            and by
            = succeed "." do
              %a{:href => "#Balchin19"} Balchin, Barnes &amp; Roitzheim 2019
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(I)
              is a transfer system, and this furnishes an equivalence of posets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Index
                      %mi G
                    %mo ≃
                    %msub
                      %mi{:mathvariant => "normal"} Transfer
                      %mi G
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Index}_{G} \simeq \mathrm{Transfer}_G.
            %p
          %p
            It is not clear how to generalize the subgroup lattice to orbital
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            implies that a transfer system only depends on its image under the
            %a.existingWikiWord{:href => "/nlab/show/coset"} homogeneous G-set
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Sub
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝒪
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathrm{Sub}(G) \rightarrow \mathcal{O}_G
          %p
          .num_defn
            %h6 Definition
            %p
              A
              = succeed "-containing" do
                %a.existingWikiWord{:href => "/nlab/show/core"} core
              %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒯
                      %mo ≃
                    %mo ⊂
                    %mi R
                    %mo ⊂
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}^{\simeq} \subset R \subset \mathcal{T}
              is a \emph{transfer system} if, for all diagrams
              %svg{:height => "85.934pt", :version => "1.2", :viewbox => "0 0 110.19 85.934", :width => "110.19pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
                %defs
                  %g
                    %symbol{:id => "RZOsvLCq0rEYHervd8YHVdRDvJk=-glyph0-0", :overflow => "visible"}
