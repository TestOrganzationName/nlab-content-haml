                      %mo ×
                      %mi V
                    %mi V
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} U' \rightarrow U \times_V V'
              is a summand inclusion, the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            Note that closure under summands implies that, whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a unital weak indexing category, its intersection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi I
                  %mo ∩
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathfrak{R}(I) \coloneqq I \cap \mathcal{T}
            is a transfer system.
            %a{:href => "#Nardin22"} Nardin-Shah 22
            generalized the correspondence between indexing systems and transfer systems to orbital
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a{:href => "#Stewart24"} Stewart 24
            generalized this to weak indexing systems as the following.
          %p
          .num_prop
            %h6 Proposition
            %p
              The monotone map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi{:mathvariant => "normal"} wIndex
                      %mi 𝒯
                      %mi{:mathvariant => "normal"} uni
                    %mo →
                    %msub
                      %mi{:mathvariant => "normal"} Transf
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathfrak{R}\colon \mathrm{wIndex}_{\mathcal{T}}^{\mathrm{uni}} \rightarrow \mathrm{Transf}_{\mathcal{T}}
              has a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              whose
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              is spanned by the
              = succeed "-indexing" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
          %h2#properties Properties
          %h3#operads
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} N_\infty
            \-operads.
          %p
            The poset of subcommutative
            %a.existingWikiWord{:href => "/nlab/show/G-%E2%88%9E+operads"} G-∞ operads
            containing
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+operad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_\infty
            corresponds with
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Index
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathrm{Index}_G
            %em
              %a.existingWikiWord{:href => "/nlab/show/N-%E2%88%9E+operads"} N-∞ operads
            (see there for details).
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G-operad"}> G-operad
                ,
                %a.existingWikiWord{:href => "/nlab/show/N-%E2%88%9E+operad"} N-∞ operad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+symmetric+monoidal+category"} G-symmetric monoidal category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G-semiadditivity"} G-semiadditivity
          %h2#references References
          %p Original discussion:
          %ul
            %li#Blumberg13
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hill"} Michael Hill
              = succeed "," do
                %em Operadic multiplications in equivariant spectra, norms, and transfers
              %strong 285
              (2015) 658-708 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1309.1750"}> arXiv:1309.1750
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.aim.2015.07.013"} doi:10.1016/j.aim.2015.07.013
          %p Further characterization:
          %ul
            %li#Blumberg16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hill"} Michael Hill
                = succeed "," do
                  %em Incomplete Tambara functors
                %strong 18
                (2018) 723-766 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1603.03292"}> arXiv:1603.03292
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2018.18.723"} doi:10.2140/agt.2018.18.723
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rubin"}> Jonathan Rubin
                ,
                %em
                  Combinatorial
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} N_\infty
                  operads
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1705.03585v3"}> arXiv:1705.03585v3
                \&amp;rbrack;
          %p On those coming from equivariant linear isometries operads:
          %ul
            %li#Rubin17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rubin"}> Jonathan Rubin
                ,
                %em Characterizations of equivariant Steiner and linear isometries operads
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1903.08723v2"}> arXiv:1903.08723v2
                \&amp;rbrack;
            %li
              %p
                Usman Hafeez, Peter Marcus, Kyle Orbsby,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ang%C3%A9lica+Osorno"} Angélica Osorno
                = succeed "," do
                  %em
                    Saturated and linear isometric transfer systems for cyclic groups of order
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi p
                            %mi m
                          %msup
                            %mi q
                            %mi n
                        %annotation{:encoding => "application/x-tex"} p^m q^n
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2109.08210"} arXiv:2109.08210
            %li
              %p
