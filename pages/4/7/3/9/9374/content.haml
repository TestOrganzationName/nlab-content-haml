          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Verlinde+formula"} Verlinde formula
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/logarithmic+CFTs"} logarithmic CFTs
          %ul
            %li
