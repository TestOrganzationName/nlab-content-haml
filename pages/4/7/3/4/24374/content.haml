                %em clocked cubical type theory
                (
                %a{:href => "#KMV2022"}> KMV2022
                ), an
                %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
                extending
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
          %p
            %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
            includes an implementation of some portions of clocked cubical type theory under the name
            = succeed "." do
              %em
                %a{:href => "#guardedcubical"} Guarded Cubical Agda
