          %h2#idea Idea
          %p
            The collection of
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            forms an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo =
                %annotation{:encoding => "application/x-tex"} Sp(\infty Grpd) =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spectra"} Spectra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            of the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            of the category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            at the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sp(\infty Grpd)
            plays a role in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            analogous to the role played by the 1-
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet(Ab)
            of abelian groups.
          %h2#definition Definition
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (∞,1)-categories
            a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            is a
            %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi whe
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} L_{whe} Top_*
            of pointed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %p
            Recall that
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            form a
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(C)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi whe
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} L_{whe} Top_*
            is the
            %strong
              stable
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mi whe
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mi whe
                  %msub
                    %mi Top
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Stab(L_{whe}Top) := Sp(L_{whe}Top_*)
                  \\,.
