          %h3#over_formal_duals_of_nonpositively_graded_cdgalgebras Over formal duals of non-positively graded cdg-algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
