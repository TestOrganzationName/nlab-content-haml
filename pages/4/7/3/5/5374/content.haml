          %h2#idea Idea
          %p
            This entry describes the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            %a.existingWikiWord{:href => "/nlab/show/derived+geometry"} derived geometry
            modeled on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0.
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is the context for classical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
            over
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
            of algebras and dg-algebras arises naturally as the function
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
