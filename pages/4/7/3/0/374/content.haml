          %h1#topological_spaces Topological spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#Definitions"} Definitions
              %ul
                %li
                  %a{:href => "#StandardDefinition"} Standard definition
                %li
                  %a{:href => "#AlternateDefinitions"} Alternate equivalent definitions
                %li
