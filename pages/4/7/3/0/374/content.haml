                %li
                  %a{:href => "#DependentTypeTheory"}  In dependent type theory
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#special_cases"} Special cases
                %li
                  %a{:href => "#specific_examples"} Specific examples
              %li
                %a{:href => "#related_concepts"} Related concepts
