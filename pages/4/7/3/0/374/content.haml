                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mrow
                        %mo [
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \exists x:A.B(x) \coloneqq \left[\sum_{x:A} B(x)\right]
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
                of a
                %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [T]
                is the propositional truncation of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} El
                      %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, \mathrm{El}_U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            represent
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+types"} small types
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/open+sets"} open sets
            being closed under arbitrary unions, the open sets are only closed under all
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %mrow
                      %mi i
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} El
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigcup_{i:\mathrm{El}_U(I)} B(i)
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} I:U
          %p
          .num_defn
            %h6 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
