            %p
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#ComplexBVBRSTGlobal"}> this def.
              ).
            %p Let moreover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int}
                    \\;\in\;
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [ \hbar , g  ] ]
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              (regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              non-point-
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi g
                    %msub
                      %mi S
                      %mi int
                  %annotation{:encoding => "application/x-tex"} S' + g S_{int}
              satisfies the
              %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
              (
              %a{:href => "quantum+master+equation#QuantumMasterEquation"}> this prop.
              ); and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
