                    \\phantom{AAA}
                    \\in
                    \\Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})
                    \\end{aligned}
            %p
              (by
              = succeed ")," do
                %a{:href => "A+first+idea+of+quantum+field+theory#eq:CurrentNoetherConservation"} this equation
              = succeed ")" do
                %a{:href => "A+first+idea+of+quantum+field+theory#eq:EulerLagrangeEquationGeneral"} this equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
