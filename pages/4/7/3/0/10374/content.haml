                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J_{\hat v} \in \Omega^{p,0}_\Sigma(E_{\text{BV-BRST}})
              the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#NoethersFirstTheorem"}> this prop.
              ), so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
