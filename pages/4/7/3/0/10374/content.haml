            %p
              (by
              = succeed ")." do
                %a{:href => "A+first+idea+of+quantum+field+theory#BVDifferentialGlobal"} this example
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo (
                      %msub
                        %mrow
                          %mo {
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ′
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi g
                          %msub
                            %mi S
                            %mi int
