              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g \to 0
              (noticing that in this limit
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℛ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %mi id
                    %annotation{:encoding => "application/x-tex"} \mathcal{R}^{-1} = id
              %a.existingWikiWord{:href => "/nlab/show/quantum+master+Ward+identity"} quantum master Ward identity
              %a.maruku-eqref{:href => "#eq:OnRegularObservablesQuantumMasterWardIdentityViaTimeOrdered"} (1)
