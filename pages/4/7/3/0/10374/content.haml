                      %mi Σ
                      %mi ev
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma^{ev}_\Sigma(T_\Sigma(E_{\text{BRST}}))
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
