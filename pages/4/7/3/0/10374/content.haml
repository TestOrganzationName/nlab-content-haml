                    \\;\in \Omega^{0,0}_\Sigma(E_{\text{BV-BRST}})
            %p and re-arranged suggestively.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
