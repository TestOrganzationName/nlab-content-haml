                    \\;\coloneqq\;
                    \\mathcal{S}(g S_{int})^{-1}
                    \\star_H
                    (\mathcal{S}(g S_{int}) \star_F (-))
            %p
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quantum+M%C3%B8ller+operator"} quantum Møller operator
              (
              %a{:href => "quantum+master+equation#MollerOperatorOnRegularPolynomialObservables"}> this def.
              ).
            %p
              Then by
              %a{:href => "quantum+master+equation#QuantumMasterEquation"} this prop.
              we have
            #eq:OnRegularObservablesQuantumMasterWardIdentityViaTimeOrdered.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ∘
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
