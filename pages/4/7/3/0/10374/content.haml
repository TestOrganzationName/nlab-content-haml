          %p
            (
            %a{:href => "#Rejzner13"}> Rejzner 13, (37)
            )
          #QuantumMasterEuqationRelatesQuantumInteractingELEquationsToClassicalFreeELEquations.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quantum+master+Ward+identity"} quantum master Ward identity
                relates
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} EOMs
                to
                %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} EOMs
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A \in PolyObs(E_{\text{BV-BRST}})_{reg}[ [ \hbar, g] ]
              the
              %a.existingWikiWord{:href => "/nlab/show/quantum+master+Ward+identity"} quantum master Ward identity
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              %a.maruku-eqref{:href => "#eq:OnRegularObservablesQuantumMasterWardIdentityViaTimeOrdered"} (1)
              reads
            #eq:RearrangedMasterQuantumWard.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo (
                      %msub
                        %mrow
                          %mo {
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ′
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi A
                          %mo }
                        %mi 𝒯
                      %mo −
                      %mi i
                      %mi ℏ
                      %msub
                        %mi Δ
                        %mi BV
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{R}^{-1}
                    \\left(
                    \\left\{ -(S' + g S_{int}) \,,\, A \right\}_{\mathcal{T}}
                    \-
                    i \hbar   \Delta_{BV}(A)
                    \\right)
                    \\;=\;
                    \\{-S', \mathcal{R}^{-1}(A) \}
            %p
              The term on the right is manifestly in the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the global
              %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-S',-\}
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#ComplexBVBRSTGlobal"}> this def.
              ) and hence vanishes when passing to
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              observables along the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#eq:OnShellPolynomialObservablesAsBVCohomology"}> this equation
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
