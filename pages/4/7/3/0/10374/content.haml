                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi PolyObs
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi def
                              %mo{:stretchy => "false"} (
                              %mi af
                              %mo =
                              %mn 0
                              %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mtext off-shell
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
