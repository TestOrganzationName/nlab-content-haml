          #NoetherCurrentConservationQuantumCorrection.num_example
            %h6#example_3 Example
            %p
              %strong
                (quantum correction to
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether current
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conservation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msubsup
