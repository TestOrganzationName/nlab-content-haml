                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi D
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Φ
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi ⋯
                                  %mo{:stretchy => "false"} )
