                    Cl_1^{\mathbb{C}}
                    \\otimes_{\mathbb{C}}
                    Cl_1^{\mathbb{C}}
                    \\stackrel{\simeq}{\to}
                    Cl_1^{\mathbb{C}}
                    \\otimes_{\mathbb{C}}
                    Cl_1^{\mathbb{C}}
            %p given by the algebra homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mn 1
                            %mo ⊗
                            %mn 1
                          %mtd
                            %mo ↦
                            %mn 1
                            %mo ⊗
                            %mn 1
                        %mtr
                          %mtd
                            %mi e
                            %mo ⊗
                            %mi e
                          %mtd
                            %mo ↦
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi e
                            %mo ⊗
                            %mi e
                        %mtr
                          %mtd
                            %mn 1
                            %mo ⊗
                            %mi e
                          %mtd
                            %mo ↦
                            %mi e
                            %mo ⊗
                            %mn 1
                        %mtr
                          %mtd
                            %mi e
                            %mo ⊗
                            %mn 1
                          %mtd
                            %mo ↦
                            %mn 1
                            %mo ⊗
                            %mi e
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    1 \otimes 1 &amp; \mapsto 1 \otimes 1
                    \\\
                    e \otimes e &amp; \mapsto - e \otimes e
                    \\\
                    1 \otimes e &amp; \mapsto e \otimes 1
                    \\\
                    e \otimes 1 &amp; \mapsto 1 \otimes e
                    \\end{aligned}
            %p (exchange the tensor factors and introduce a sign when exchanging two odd graded ones).
          %p
            For instance (
            %a{:href => "#Freed12"}> Freed 12, 1.42
            ).
          #SecondKInvariant.num_prop
            %h6#proposition_5 Proposition
            %p
              The second
              %a.existingWikiWord{:href => "/nlab/show/k-invariant"} k-invariant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 4
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{Z}_2 \to \mathbf{B}^4 \mathbb{Z}
            %p
              is the delooping of that of super lines
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi sLine
                    %annotation{:encoding => "application/x-tex"} \mathbf{sLine}
              %a.existingWikiWord{:href => "/nlab/show/Bockstein+homomorphism"} Bockstein homomorphism
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{Z}_2 \to \mathbf{B}^3 U(1)
            %p
              which sends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ×
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ×
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo →
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ↪
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \times \mathbb{Z}_2 \times \mathbb{Z}_2 \to \mathbb{Z}_2 \hookrightarrow U(1)
            %p (…)
          %p
            For instance (
            %a{:href => "#Freed12"}> Freed 12, 1.44
            ).
          .num_remark
            %h6#remark_4 Remark
            %p
              Comparison with the notation and terminology of (
              %a{:href => "#FreedHopkinsTeleman"}> Freed-Hopkins-Teleman 07
              ):
            %p
              the “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℬ
                    %msup
                      %mi 𝕋
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}\mathbb{T}^{\pm}
              ” on the top of p. 14 there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega (2\mathbf{sLine})
              here; a graded line bundle over some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there is a map of stacks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \Omega (2\mathbf{sLine})
              here.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              1-truncated, hence a groupoid, a graded central extension in the sense there is a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                  %annotation{:encoding => "application/x-tex"} X \to 2\mathbf{sLine}
              which factors as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Ω
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mstyle{:mathvariant => "bold"}
                        %mi sLine
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn 2
                      %mstyle{:mathvariant => "bold"}
                        %mi sLine
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}\Omega (2\mathbf{sLine}) \to 2\mathbf{sLine}
          %h3#RelationToUnconnectedDeloopingOfUnitsOfKU
            Relation to the unconnected delooping of the
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                %annotation{:encoding => "application/x-tex"} KU
          %p
            In (
            %a{:href => "#Sagave11"}> Sagave 11
            ) is introduced a “non-connected delooping”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi bgl
                    %mn 1
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} bgl_1^\ast(E)
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gl_1(E)
            of an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi gl
                    %mn 1
                    %mi J
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝕊
                  %mo →
                  %msubsup
                    %mi bgl
                    %mn 1
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  gl_1(E) \to gl_1^J(E) \to \mathbb{S} \to bgl_1^\ast(E)
                  \\,.
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "infinity-group+of+units#AugmentedDefinition"} ∞-Group of units – Augmented definition
          %p
            By (
            %a{:href => "#Sagave11"}> Sagave 11, theorem 12 and example 4.10
            ) and comparing to the above discussion we have an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                    %mo{:stretchy => "false"} |
                  %mo ≃
                  %msubsup
                    %mi bgl
                    %mn 1
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi KU
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟨
                  %mn 0
                  %mo ,
                  %mo .
                  %mo .
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  {\vert 2\mathbf{sLine}\vert}
                  \\simeq
                  bgl_1^\ast(KU) \langle0,..,4\rangle
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of the super-2-stack of super line 2-bundles with the
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28infinity%2C1%29-category"} 4-truncation
            of the connected delooping of the
            %a.existingWikiWord{:href => "/nlab/show/infinity-group+of+units"} infinity-group of units
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
          %p
            hitting the Donovan-Karoubi twists of K-theory. This is what in (
            %a{:href => "#Precis"}> Freed-Distler-Moore
            ,
            = succeed ")" do
              %a{:href => "#Freed12"} Freed
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} R^{-1}
          %p (…)
          %h2#references References
          %p
            Line 2-bundles in
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            as a model for the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            and
            %a.existingWikiWord{:href => "/nlab/show/orientifolds"} orientifolds
            are discussed (even if not quite explicitly in the language of higher bundles) in
          %ul
            %li#Freed12
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              ,
              = succeed "," do
                %em Lectures on twisted K-theory and orientifolds
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/FreedESI2012.pdf", :title => "pdf"} pdf
          %p
            based on the old results about the
            %a.existingWikiWord{:href => "/nlab/show/Picard+2-groupoid"} Picard 2-groupoid
            of complex
            %a.existingWikiWord{:href => "/nlab/show/super+algebras"} super algebras
          %ul
            %li#Wall
              %a.existingWikiWord{:href => "/nlab/show/C.+T.+C.+Wall"}> C. T. C. Wall
              ,
              = succeed "," do
                %em Graded Brauer groups
          %p
            and based on the discussion of
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            in
          %ul
            %li#DonovanKaroubi
              %a.existingWikiWord{:href => "/nlab/show/Peter+Donovan"}> Peter Donovan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"} Max Karoubi
              = succeed "," do
                %em
                  Graded Brauer groups and
                  = succeed "-theory" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item?id=PMIHES_1970__38__5_0"} numdam
          %p as refined in
          %ul
            %li#FreedHopkinsTeleman
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              = succeed "," do
                %em Loop groups and twisted K-theory I
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0711.1906"} arXiv:0711.1906
          %p and developing constructions in
          %ul
            %li#Precis
              %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"}> Jacques Distler
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"} Dan Freed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
              %em Orientifold Précis
              in:
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              (eds.)
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
              Proceedings of Symposia in Pure Mathematics, AMS (2011) (
              %a{:href => "http://arxiv.org/abs/0906.0795"}> arXiv:0906.0795
              ,
              = succeed ")" do
                %a{:href => "http://www.ma.utexas.edu/users/dafr/bilbao.pdf"} slides
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tadeusz+J%C3%B3zefiak"}> Tadeusz Józefiak
              ,
              = succeed "," do
                %em Semisimple Superalgebras
          %p Similar comments appear earlier on p. 8 and following of
          %ul
            %li#FreedHopkinsTeleman07
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              %em Consistent Orientation of Moduli Spaces
              (
              %a{:href => "http://arxiv.org/abs/0711.1909"}> arXiv:0711.1909
              ), chapter XIX, pages 395-419 in: Oscar Garcia-Prada, Jean Pierre Bourguignon, Simon Salamon (eds.)
              = succeed "," do
                %em The Many Facets of Geometry: A Tribute to Nigel Hitchin
              = succeed ")" do
                %a{:href => "http://www.oxfordscholarship.com/view/10.1093/acprof:oso/9780199534920.001.0001/acprof-9780199534920"} doi:10.1093/acprof:oso/9780199534920.001.0001
          %p The above higher supergeometric story is made explicit in
          %ul
            %li#FSS
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/A+higher+stacky+perspective+on+Chern-Simons+theory"} A higher stacky perspective on Chern-Simons theory
          %p
            The “unconnected delooping” of the
            %a.existingWikiWord{:href => "/nlab/show/infinity-group+of+units"} infinity-group of units
            of an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is introduced in
          %ul
            %li#Sagave11
              %a.existingWikiWord{:href => "/nlab/show/Steffen+Sagave"}> Steffen Sagave
              ,
              %em Spectra of units for periodic ring spectra
              (
              %a{:href => "http://arxiv.org/abs/1111.6731"}> arXiv:1111.6731
              )
          %p
            and the specific example for the case of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi KU
                %annotation{:encoding => "application/x-tex"} E = KU
            is in example 4.10 there.
