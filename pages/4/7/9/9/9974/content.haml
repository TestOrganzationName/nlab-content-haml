          %h2#idea Idea
          %p
            A
            %em super line 2-bundle
            is a
            %a.existingWikiWord{:href => "/nlab/show/line+2-bundle"} line 2-bundle
            in (
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"}> higher
            )
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          %p
            We discuss line 2-bundles in
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            and their relation to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            = succeed ")," do
              %a{:href => "#Freed12"} Freed
            = succeed ")" do
              %a{:href => "#DonovanKaroubi"} Donovan-Karoubi
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            and (
            %a{:href => "#Wall"}> Wall
            ) on
            = succeed "." do
              %em
                %a{:href => "super+algebra#Picard2Groupoid"} Picard 2-groupoids of superalgebras
            = succeed ")" do
              %a{:href => "#FSS"} Fiorenza-Sati-Schreiber 12
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} higher stack
            on
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mstyle{:mathvariant => "bold"}
                    %mi sLine
                %annotation{:encoding => "application/x-tex"} 2\mathbf{sLine}
            of super line 2-bundles. This is a supergeometric refinement of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+infinity-stack"} moduli 2-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^2\mathbb{C}^\times
            for bare complex line 2-bundles,
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≔
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \coloneqq
              %a.existingWikiWord{:href => "/nlab/show/SmoothSuper%E2%88%9EGrpd"} SmoothSuper∞Grpd
              be the
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SmoothSuper%E2%88%9EGrpd"} smooth super-∞-groupoids
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi th
                  %annotation{:encoding => "application/x-tex"} {}_{th}
              the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              given by the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the category of
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              on those of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{N}
              this is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothSuper
                    %mn ∞
                    %mi Grpd
                    %mo ≃
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SmoothSuper\infty Grpd \simeq Sh_\infty(CartSp_{th})
            %p
              This is cohesive over
              %a.existingWikiWord{:href => "/nlab/show/Super%E2%88%9EGrpd"} Super∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi SuperPoints
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \simeq Sh_\infty(SuperPoints)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi SmoothSuper
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mi Super
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \colon SmoothSuper\infty Grpd  \to Super \infty Grpd
                    \\,.
          .num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \mathbf{H}
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ↦
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi p
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi ℂ
                      %mi q
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{K} \colon \mathbb{R}^{p|q} \mapsto C^\infty(\mathbb{R}^p, \mathbb{C})\otimes (\wedge^\bullet \mathbb{C}^q)_{even}
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
              we have that
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma(\mathbb{K})
              %a.existingWikiWord{:href => "/nlab/show/Super%E2%88%9EGrpd"} Super∞Grpd
              are, externally, superalgebras over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
          .num_defn
            %h6#defintion Defintion
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sVect
                    %mo ∈
                    %mi SmoothSuper
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    2\mathbf{sVect} \in SmoothSuper \infty Grpd
            %p
              for the object which over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
              is the
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              whose
            %ul
              %li
                %p
                  objects are semisimple
                  = succeed "-algebras;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mi p
                              %mo{:stretchy => "false"} |
                              %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{K}(\mathbb{R}^{p|q})
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are invertible
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are invertible bimodule homomorphisms.
            %p
              This is naturally a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+2-category"} braided monoidal 2-category
              object. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                    %mo ∈
                    %mi SmoothSuper
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    2 \mathbf{sLine} \in SmoothSuper \infty Grpd
            %p
              for the maximal
              %a.existingWikiWord{:href => "/nlab/show/braided+3-group"} braided 3-group
              inside this on the invertible objects.
          %h2#properties Properties
          %p
            We now want to analyse the super 2-stack
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mstyle{:mathvariant => "bold"}
                      %mi sLine
                  %annotation{:encoding => "application/x-tex"} 2 \mathbf{sLine}
            %a.existingWikiWord{:href => "/nlab/show/Picard+3-group"} Picard 3-group
            of superalgebras.
          %h3#TheBrauer3Group The Brauer 3-group of superalgebras
          #AzumayaAreCentralSimple.num_theorem
            %h6#theorem Theorem
            %p
              A superalgebra is invertible/Azumaya (see
              = succeed ")" do
                %a{:href => "super+algebra#Azumaya"} here
              = succeed ")." do
                %a{:href => "super+algebra#CentralSimple"} here
          %p
            This is due to (
            %a{:href => "#Wall"}> Wall
            ).
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer group
              of superalgebras over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              is cyclic of order 8:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    sBr(\mathbb{C}) \simeq \mathbb{Z}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 8
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sBr(\mathbb{R}) \simeq \mathbb{Z}_8
                    \\,.
            %p
              The non-trivial element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sBr(\mathbb{R})
              is that presented by the superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo ⊕
                    %mi ℂ
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} \oplus \mathbb{C} u
              of the example
              = succeed "," do
                %a{:href => "super+algebra#ComplexCl1"} here
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⋅
                      %mi u
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} u \cdot u = 1
          %p
            This is due to (
            %a{:href => "#Wall"}> Wall
            ).
          %p
            The following generalizes this to the higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/braided+3-group"} braided 3-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sAlg
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} sAlg^\times
              of Azumaya superalgebra are
            %table
              %thead
                %tr
                  %th
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi sAlg
                            %mi ℂ
                            %mo ×
                        %annotation{:encoding => "application/x-tex"} sAlg^\times_{\mathbb{C}}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi sAlg
                            %mi ℝ
                            %mo ×
                        %annotation{:encoding => "application/x-tex"} sAlg^\times_{\mathbb{R}}
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \pi_2
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℂ
                            %mo ×
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
                  %td{:style => "text-align: left;"}
