          %p
          .num_defn
            %h6 Definition
            %p
              An
              %em event structure with symmetry
              is an event structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              equipped with an internal
              = succeed "," do
                %a{:href => "congruence"} equivalence relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⟵
                    %mi R
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E \longleftarrow R \longrightarrow E
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/jointly+monic+morphisms"} jointly monic
              maps, which is reflexive, symmetric and transitive (this definition uses the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi ES
                  %annotation{:encoding => "application/x-tex"} \mathbf{ES}
              has pullbacks), and such that the two legs of the span are open maps.
          %p
            This can be defined more concretely: an event structure with symmetry is an event structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            equipped with a collection of set-theoretic bijections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi x
                  %mo ≅
                  %mi y
                %annotation{:encoding => "application/x-tex"} \theta : x \cong y
            between configurations of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒞
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathscr{C}(E)
            of configurations becomes a subcategory of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} \theta : x \to y
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathscr{C}(E)
          %ul
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                      %mo ⊆
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x' \subseteq x
                for some configuration
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} x'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x'
                is also in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi.mathscript 𝒞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathscr{C}(E)
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⊆
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x \subseteq x'
                for some configuration
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} x'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
                to some bijection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo ′
                      %mo :
                      %mi x
                      %mo ′
                      %mo →
                      %mi y
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \theta' : x' \to y'
                in the symmetry.
          %p
            We say a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi E
                  %mo ′
                %annotation{:encoding => "application/x-tex"} E \to E'
            preserves symmetry if, for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi x
                  %mo ≅
                  %mi y
                %annotation{:encoding => "application/x-tex"} \theta : x \cong y
            in the symmetry of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi x
                  %mo ≅
                  %mi x
                  %mo ≅
                  %mi y
                  %mo ≅
                  %mi f
                  %mi y
                %annotation{:encoding => "application/x-tex"}
                  f x \cong x \cong y \cong f y
          %p
            (determined by the injectivity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            on configurations) is in the symmetry of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ESS
                %annotation{:encoding => "application/x-tex"} \mathbf{ESS}
            of event structures with symmetry.
          %p
          .num_defn
            %h6 Definition
            %p
              Two parallel maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi E
                    %mo →
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f, g : E \to E'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi ESS
                  %annotation{:encoding => "application/x-tex"} \mathbf{ESS}
              are homotopic (written
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∼
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \sim g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi.mathscript 𝒞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in \mathscr{C}(E)
              the bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi x
                    %mo ≅
                    %mi x
                    %mo ≅
                    %mi g
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f x \cong x \cong g x
              (determined by the injectivity on configurations of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} E'
          %h3#event_structures_with_symmetry_and_presheaves Event structures with symmetry and presheaves
          %p
            It is shown in
            %a{:href => "#StatonWinskel"} Staton &amp; Winskel
            that with the introduction of symmetry, event structures represent all presheaves over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ESS
                  %mo →
                  %mi{:mathvariant => "normal"} PSh
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{ESS} \to \mathrm{PSh}(\mathbf{P})
            takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            to the presheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↦
                    %mstyle{:mathvariant => "bold"}
                      %mi ESS
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo ~
                  %annotation{:encoding => "application/x-tex"} P \mapsto \mathbf{ESS}(P, E)/~
          %h2#relationship_with_petri_nets Relationship with Petri nets
          %p
            Since they were first described (
            %a{:href => "#NPW81"}> NPW 81
            ), event structures have been associated with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Petri+nets"} Petri nets
            = succeed ")." do
              %a{:href => "#GlabbeekPlotkin"} van Glabbeek &amp; Plotkin
          %h2#references References
          %p Event structures were introduced in:
          %ul
            %li#NPW81
              M. Nielsen, G. D. Plotkin, and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"} G. Winskel
              = succeed "," do
                %em Petri nets, event structures and domains, part I
              %a{:href => "https://doi.org/10.1016/0304-3975%2881%2990112-2"} doi:10.1016/0304-3975(81)90112-2
          %p Other papers on event structures:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"}> G. Winskel
                ,
                = succeed "," do
                  %em Event Structures
                = succeed "." do
                  %em Advances in Petri Nets 1986
                = succeed ")." do
                  %a{:href => "https://www.cl.cam.ac.uk/~gw104/Winskel1987_Chapter_EventStructures.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"} G. Winskel
                and M. Nielsen, Models for concurrency. vol. 3, Handbook of Logic in Computer Science, pages 100 - 200, Oxford Univ. Press, 1994. (see also
                = succeed ")." do
                  %a{:href => "http://www.daimi.au.dk/PB/463/PB-463.pdf"} online technical report
            %li#Representation
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"}> G. Winskel
                ,
                %em Event Structures as Presheaves – Two Representation Theorems
                %a.existingWikiWord{:href => "/nlab/show/BRICS"} BRICS
                (1999) &amp;lbrack;
                %a{:href => "https://www.brics.dk/RS/99/7/BRICS-RS-99-7.pdf"}> pdf
                \&amp;rbrack;
            %li#Symmetry
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"}> G. Winskel
                ,
                %em Event Structures with Symmetry
                %a{:href => "https://www.cl.cam.ac.uk/~gw104/EvStrswSymm-Corrected.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"}> G. Winskel
                ,
                = succeed "," do
                  %em Events, causality, and symmetry
                = succeed ")." do
                  %a{:href => "http://www.cl.cam.ac.uk/~gw104/CJVision-Revised.pdf"} online version
            %li#StatonWinskel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sam+Staton"} Sam Staton
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/G.+Winskel"} G. Winskel
                %a{:href => "http://www.cl.cam.ac.uk/~gw104/lics2010final.pdf"} LICS 2010
            %li#GlabbeekPlotkin
              %p
                R.J. van Glabbeek,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Plotkin"} Gordon Plotkin
                %em Configuration Structures, Event Structures and Petri Nets
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0912.4023"}> arXiv:0912.4023
                \&amp;rbrack;
