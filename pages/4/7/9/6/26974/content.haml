                  %mi X
                %annotation{:encoding => "application/x-tex"} k_m:X\to X
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi k
