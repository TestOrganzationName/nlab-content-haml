          %h2#definitions Definitions
          %h3#abstract_algebras
            Abstract
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          .num_defn
            %h6#definition Definition
            %p
              A
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo −
                      %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, {\|-\|})
              over a
              %a.existingWikiWord{:href => "/nlab/show/topological+field"} topological field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              (often the field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≔
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} K \coloneqq \mathbb{C}
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/anti-involution"} anti-involution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              compatible with
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              if appropriate (that is: a Banach
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
                \-identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi A
                          %mo *
                        %mi A
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi A
                          %mo *
                      %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi A
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"}
                    {\|{A^* A}\|} = {\|{A^*}\|} \, {\|{A}\|}
            %p
              or equivalently the
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mo *
                    %annotation{:encoding => "application/x-tex"} B^*
                \-identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %msup
                          %mi A
                          %mo *
                        %mi A
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\|{A^* A}\|} = {\|{A}\|^2}
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              homomorphism.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              \-algebras with these homomorphisms form a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/C%2AAlg"} C*Alg
          .num_remark
            %h6#remark Remark
            %p
              Often one sees the definition without the clause (which should be in the definition of Banach
              = succeed "-algebra)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
              (so that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msup
                          %mi A
                          %mo *
                        %mo{:stretchy => "false"} ‖
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi A
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|A^*\|} = {\|A\|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo *
                  %annotation{:encoding => "application/x-tex"} B^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
              identities). This follows easily from the
              = succeed "-identity," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mo *
                    %annotation{:encoding => "application/x-tex"} B^*
              = succeed "-identity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
          .num_remark
            %h6#remark_2 Remark
            %p
              There are different concepts for the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spatial+tensor+product"} spatial tensor product
          .num_remark
            %h6#remark_3 Remark
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
              \-algebras equipped with the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              by
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
              of the algebra are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/C-star-systems"} C-star-systems
              \.
          %h3#concrete_algebras_and_representations
            Concrete
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "-representations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          .num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %strong
                %a.existingWikiWord{:href => "/nlab/show/concrete+structure"} concrete
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
