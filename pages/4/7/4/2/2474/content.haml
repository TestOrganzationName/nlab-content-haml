                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %a.existingWikiWord{:href => "/nlab/show/subalgebra"} subalgebra
              of the algebra of
              %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              that is
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/norm+topology"} norm topology
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/representation+of+a+C-star+algebra"} representation
              of a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              on a
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a
              = succeed "-homomorphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the algebra of
              %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
          .num_remark
            %h6#remark_4 Remark
            %p
              It is immediate that concrete
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %a.existingWikiWord{:href => "/nlab/show/faithful+representations"} faithful representations
              of abstract
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %em every
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a concrete
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
          .num_remark
            %h6#remark_5 Remark
            %p
              The original definition of the term ‘
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
              \-algebra’ was in fact the concrete notion; the ‘C’ stood for ‘closed’. Furthermore, the original term for the abstract notion was ‘
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo *
                  %annotation{:encoding => "application/x-tex"} B^*
              \-algebra’ (where the ‘B’ stood for ‘Banach’). However, we now usually interpret ‘
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
              \-algebra’ abstractly. (Compare ‘
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
              \-algebra’ and ‘
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"}> von Neumann algebra
              ’.)
          %h3#DaggerFormulation
            In
            = succeed "-compact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %p
            The notion of
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%E2%80%A0-categories"} symmetric monoidal †-categories
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics+in+terms+of+%E2%80%A0-compact+categories"} quantum mechanics in terms of †-compact categories
          %p
            For a discussion of this in the finite-dimensional case see for instance (
            %a{:href => "#Vicary"}> Vicary
            ).
          %h2#Properties Properties
          %h3#category_theoretic_properties Category theoretic properties
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo *
                %annotation{:encoding => "application/x-tex"} C^*
            \-algebras are
            %a.existingWikiWord{:href => "/nlab/show/monadic"} monadic
            over sets. More precisely, the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %msup
                        %mi C
                        %mo *
                      %mi Alg
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{C^*Alg}\to\mathbf{Set}
            that assigns to each algebra the set of points in its unit ball is monadic. See
            = succeed "." do
              %a{:href => "#PelletierRosicky93"} Pelletier &amp; Rosicky (1993)
          %p
            See also
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/operator+algebras"} operator algebras
          %h3#PartialOrderAndPositiveElements Partial order and positive elements
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+elements"} self-adjoint elements
            in a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Herm
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒜
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi A
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo =
