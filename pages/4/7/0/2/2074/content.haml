                        %mo{:stretchy => "false"} ]
                        %mn 1
                      %mo →
                      %msub
                        %mi Y
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1 \times \Delta[1]_1 \rightarrow Y_1
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E \times \Delta[1]_1
                factors though the marked edges of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times \Delta[1] \rightarrow Y
                to a marked edge of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
