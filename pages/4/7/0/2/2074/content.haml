                        %msubsup
                          %mi Map
                          %mi S
                          %mo ♯
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msup
                          %mi Y
                          %mo ♮
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Map_S^\sharp(X, Y^\natural)
                  is its
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/core"} core
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                  inside it.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark 3.1.3.1
          .proof
            %h6#proof_5 Proof
            %p
              The
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Y
                      %mo ♮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map_S^\flat(X,Y^\natural)
              are morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
