          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi SSet
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} SSet^+/S
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} marked simplicial set
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi SSet
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} SSet^+/S
            are precisely the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Notably for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} S = {*}
            this is a presentation of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            this is
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            (i.e. enriched over the ordinary
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            that models
            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            The
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            that exhibits the correspondence between
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaves
            is in turn modeled by a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the model structure on marked simplicial over-sets and the projective
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+simplicial+presheaves"} global model structure on simplicial presheaves
          %h2#marked_simplicial_sets Marked simplicial sets
          %p
            Marked simplicial sets are
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
          %h3#definition Definition
          %h4#in_components In components
          .un_def
            %h6#definition_2 Definition
            %p
              A
              %strong marked simplicial set
              is
            %ul
              %li
                %p
                  a pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ,
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (S,E)
                  consisting of
                %ul
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi S
                          %annotation{:encoding => "application/x-tex"} S
                  %li
                    %p
                      and a subset
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi E
                            %mo ⊂
                            %msub
                              %mi S
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} E \subset S_1
                      of edges of
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi S
                            %annotation{:encoding => "application/x-tex"} S
                      = succeed "," do
                        %em marked edges
              %li
                %p such that
                %ul
                  %li all degenerate edges are marked edges.
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ′
                    %mo ,
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,E) \to (S',E')
              of marked simplicial sets is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : S \to S'
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f(E) \subset E'
          .un_def
            %h6#notation Notation
            %ul
              %li
                %p
                  The category of marked simplicial sets is denoted
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi sSet
                            %mo +
                        %annotation{:encoding => "application/x-tex"} sSet^+
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  a
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  let
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mo ♭
                          %annotation{:encoding => "application/x-tex"} S^\flat
                      or
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mi min
                          %annotation{:encoding => "application/x-tex"} S^{min}
                      be the minimally marked simplicial set: only the degenerate edges are marked;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mo ♯
                          %annotation{:encoding => "application/x-tex"} S^\sharp
                      or
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mi max
                          %annotation{:encoding => "application/x-tex"} S^{max}
                      be the maximally marked simplicial set: every edge is marked.
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi X
                        %mo →
                        %mi S
                      %annotation{:encoding => "application/x-tex"} p : X \to S
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                  of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mo ♮
                        %annotation{:encoding => "application/x-tex"} X^\natural
                    or
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mi cart
                        %annotation{:encoding => "application/x-tex"} X^{cart}
                    be the cartesian marked simplicial set: precisely the
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/cartesian+morphism"} cartesian morphism
          %h4#as_a_quasitopos As a quasi-topos
          %p
            Simple as the above definition is, for seeing some of its properties it is useful to think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                %annotation{:encoding => "application/x-tex"} sSet^+
            in a more abstract way.
          .un_def
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Delta^+
              be the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              defined as the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1^+]
              that factors the unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1] \to [0]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo =
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ←
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mn 1
                              %mo +
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0] &amp;\stackrel{\to}{\to}&amp; [1]
                    \\\
                    {}^{\mathllap{=}}\downarrow &amp;\swarrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    [0] &amp;\leftarrow&amp; [1^+]
                    }
                    \\,.
            %p
              Equip this category with a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              whose only non-trivial covering family is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi p
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo +
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{p : [1] \to [1]^+\}
          #Quasitopos.un_lemma
            %h6#observation Observation
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is the
              %a.existingWikiWord{:href => "/nlab/show/quasi-topos"} quasi-topos
              of
              %a.existingWikiWord{:href => "/nlab/show/separated+presheaves"} separated presheaves
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \Delta^+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo ≃
                    %mi SepPSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sSet^+ \simeq SepPSh(\Delta^+)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X : (\Delta^+)^{op} \to Set
              is separated precisely if the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %msup
                          %mn 1
                          %mo +
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X(p) : X_{1^+} \to X_1
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %msup
                          %mn 1
                          %mo +
                  %annotation{:encoding => "application/x-tex"} X_{1^+}
              is a subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi σ
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %msup
                                  %mn 1
                                  %mo +
                          %mtd
                            %mo ↪
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_0
                    \\\
                    \\downarrow &amp; \searrow^{\mathrlap{\sigma}}
                    \\\
                    X_{1^+} &amp;\hookrightarrow&amp; X_1
                    }
                    \\,.
            %p
              Therefore we may naturally identify
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a simplicial set equipped with a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              that contains all degenerate 1-cells.
            %p
              Moreover, a morphism of separated preseheaves on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Delta^+
              is by definition just a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between them, which means it is under this interpretation precisely a morphism of simplicial sets that respects the marked 1-simplices.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                %annotation{:encoding => "application/x-tex"} sSet^+
            is a genuine quasi-topos:
          .un_lemma
            %h6#observation_2 Observation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is not a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          .proof
            %h6#proof_2 Proof
            %p
              The canonical morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo ♭
                    %mo →
                    %msup
                      %mi X
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"} X^\flat \to X^\sharp
              are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is not a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/balanced+category"} balanced category
          %h3#CartesianClosure Cartesian closure
          .un_lemma
            %h6#lemma Lemma
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
          .proof
            %h6#proof_3 Proof
            %p
              This is an immediate consequence of the above
              %a{:href => "#Quasitopos"} observation
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
            %p
              By the general logic of the
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\Delta^+)
              is cartesian closed. It remains to check that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,Y \in PSh(\Delta^+)
              are marked simplicial sets in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %msup
                          %mn 1
                          %mo +
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{1^+} \to X_1
              is a monomorphism and similarly for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              has this property.
            %p
              We find that the marked edges of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Y
                      %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mn 1
                          %mo +
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mo +
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msup
                      %mi Y
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mo +
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Y^X)_{1^+} \simeq
                    Hom_{PSh(\Delta^+)}([1^+], Y^X) \simeq Hom_{PSh(\Delta^+)}([1^+] \times X, Y)
            %p
              and the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Y
                      %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mn 1
                          %mo +
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Y
                      %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} (Y^X)_{1^+} \to (Y^X)_1
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi η
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times [1^+] \stackrel{\eta}{\to} Y
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Id
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi η
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \times [1] \stackrel{(Id,p)}{\to} X \times [1^+]
                    \\stackrel{\eta}{\to} Y
                    \\,.
            %p
              Now, by construction, every non-identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U \to [1^+]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Delta^+
              factors through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} U \to [1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi η
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p^* \eta_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi η
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p^* \eta_2
              coincide on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ≠
                      %mo{:stretchy => "false"} [
                      %msup
                        %mn 1
                        %mo +
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} U \neq [1^+]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \eta_2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              coincided. By assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the values of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \eta_2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mn 1
                      %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U = [1^+]
              are already fixed, due to the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %msup
                            %mn 1
                            %mo +
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %msup
                        %mn 1
                        %mo +
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %msup
                            %mn 1
                            %mo +
                      %mo ↪
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %msup
                        %mn 1
                        %mo +
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{1^+} \times [1^+]_{1^+} \hookrightarrow X_{1} \times [1^+]_{1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              is injective, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              formed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\Delta^+)
              is itself a marked simplicial set.
          .un_def
            %h6#definition_4 Definition
            %ul
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  marked simplicial sets let
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Map
                              %mo ♭
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Map^\flat(X,Y)
                      be the
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                      underlying the
                      %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian
                      %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Y
                              %mi X
                            %mo ∈
                            %msup
                              %mi sSet
                              %mo +
                          %annotation{:encoding => "application/x-tex"} Y^X \in sSet^+
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Map
                              %mo ♯
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Map^\sharp(X,Y)
                      the simplicial set consisting of all simplices
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi σ
                            %mo ∈
                            %msup
                              %mi Map
                              %mo ♭
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \sigma \in Map^\flat(X,Y)
                      such that every edge of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi σ
                          %annotation{:encoding => "application/x-tex"} \sigma
                      is a marked edge of
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi Y
                                %mi X
                            %annotation{:encoding => "application/x-tex"} Y^X
          .un_corolary
            %h6#corollary Corollary
            %p These mapping complexes are characterized by the fact that we have natural bijections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msup
                      %mi Map
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi K
                      %mo ♭
                    %mo ,
                    %msup
                      %mi Y
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi K
                      %mo ♭
                    %mo ×
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{sSet}(K, Map^\flat(X,Y))
                    \\simeq
                    Hom_{sSet^+}(K^\flat, Y^X)
                    \\simeq
                    Hom_{sSet^+}(K^\flat \times X, Y)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msup
                      %mi Map
                      %mo ♯
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi K
                      %mo ♯
                    %mo ,
                    %msup
                      %mi Y
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi K
                      %mo ♯
                    %mo ×
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{sSet}(K, Map^\sharp(X,Y))
                    \\simeq
                    Hom_{sSet^+}(K^\sharp, Y^X)
                    \\simeq
                    Hom_{sSet^+}(K^\sharp \times X, Y)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} K \in sSet
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %msup
                        %mi sSet
                        %mo +
                    %annotation{:encoding => "application/x-tex"} X,Y \in sSet^+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Map
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ♭
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Map^\flat(X,Y)_n = Hom_{sSet^+}(X \times \Delta[n]^\flat, Y)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Map
                      %mo ♯
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ♯
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Map^\sharp(X,Y)_n = Hom_{sSet^+}(X \times \Delta[n]^\sharp, Y)
                    \\,.
          %p In words we have
          %ul
            %li
              %p
                The
                = succeed "-simplices" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mi X
                    %annotation{:encoding => "application/x-tex"} Y^X
                are simplicial maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times \Delta[n] \rightarrow Y
                such that when you restrict
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 1
                      %mo →
                      %msub
                        %mi Y
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1 \times \Delta[n]_1 \rightarrow Y_1
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} E \times \Delta[n]_0
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is the set of marked edges of
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %li
              %p
                The marked edges of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mi X
                    %annotation{:encoding => "application/x-tex"} Y^X
                are those simplicial maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times \Delta[1] \rightarrow Y
                such that the restriction of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
