          .un_prop
            %h6#proposition Proposition
            %p
              We have a sequence of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
