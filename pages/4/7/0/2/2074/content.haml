                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{\flat} \dashv (-)_{\flat} \dashv (-)^{\sharp} \dashv (-)_{\sharp}
                    \:
                    \\array{
                    \&amp; \stackrel{(-)^{\flat}}{\to} &amp;
                    \\\
                    \&amp; \stackrel{(-)_{\flat}}{\leftarrow} &amp;
                    \\\
                    sSet &amp; \stackrel{(-)^{\sharp}}{\to} &amp; sSet^+
                    \\\
                    \&amp; \stackrel{(-)_{\sharp}}{\leftarrow} &amp;
                    }
          %h2#model_structure_on_marked_simplicial_sets Model structure on marked simplicial sets
          %h3#cartesian_weak_equivalences Cartesian weak equivalences
          %p
            Observe that weak equivalences in the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            may be characterized as follows.
          .un_lemma
            %h6#lemma_2 Lemma
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              between simplicial sets that are
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              is a weak equivalence in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              precisely if the following equivalent coditions hold:
            %ul
              %li
                %p
                  For every simplicial set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} sSet(K,f) : sSet(K,C) \to sSet(K,D)
                  is a weak equivalence in the model structure for quasi-categories.
              %li
                %p
                  For every simplicial set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Core(sSet(K,f)) : Core(sSet(K,C)) \to Core(sSet(K,D))
                  on the
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/core"} core
                  = succeed "es" do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          .proof
            %h6#proof_6 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 3.1.3.2
          %p This may be taken as motivation for the following definition.
          .un_def
            %h6#definitionproposition Definition/Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Z \to S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Z
                      %mo ♮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Map_S^\flat(X, Z^{\natural})
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♯
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Z
                      %mo ♮
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Z
                      %mo ♮
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Map_S^\sharp(X,Z^\natural) = Core(Map_S^\flat(X,Z^\natural))
            %p is the maximal Kan complex inside it.
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} sSet^+/S
              is a
              %strong Cartesian equivalence
              if for every Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              we have
            %ul
              %li
                The induced morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Map
                        %mi S
                        %mo ♭
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msup
                        %mi Z
                        %mo ♮
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi Map
                        %mi S
                        %mo ♭
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mi Z
                        %mo ♮
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map_S^\flat(Y,Z^{\natural}) \to Map_S^\flat(X,Z^{\natural})
                is an
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence of quasi-categories
            %p Or equivalently:
            %ul
              %li
                The induced morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Map
                        %mi S
                        %mo ♯
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msup
                        %mi Z
                        %mo ♮
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi Map
                        %mi S
                        %mo ♯
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mi Z
                        %mo ♮
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map_S^\sharp(Y,Z^{\natural}) \to Map_S^\sharp(X,Z^{\natural})
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} weak equivalence of Kan complexes
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 3.1.3.3
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark 3.1.3.1
          .un_prop
            %h6#proposition_2 Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\stackrel{p}{\to}&amp;&amp; Y
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; S
                    }
            %p
              be a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} sSet/S
              such that both vertical maps to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are Cartesian fibrations. Then the following are equivalent:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              %li
                %p
                  The induced morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mo ♮
                        %mo →
                        %msup
                          %mi Y
                          %mo ♮
                      %annotation{:encoding => "application/x-tex"} X^\natural \to Y^\natural
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} sSet^+/S
                  is a Cartesian equivalence.
              %li
                %p
                  The induced morphism on each fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                        %mo →
                        %msub
                          %mi Y
                          %mrow
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X_s \to Y_{p(s)}
                  is a weak equivalence in the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
          .proof
            %h6#proof_7 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 3.1.3.5
          %h3#the_model_structure The model structure
          %p
            The
            %strong model structure on marked simplicial over-sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} Set^+/S
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %mi SSet
                %annotation{:encoding => "application/x-tex"} S \in SSet
            – also called the
            %strong Cartesian model structure
            since it models
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
          .un_def
            %h6#definitionproposition_2 Definition/Proposition
            %p
              %strong
                (Cartesian model structure on
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} sSet^+/S
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi SSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} SSet^+/S
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} marked simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              carries a structure of a
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
              defined as follows.
            %p
              The
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♯
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sSet^+/S(X,Y) := Map_S^\sharp(X,Y)
                    \\,.
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : X \to X'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi SSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} SSet^+/S
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} marked simplicial set
            %ul
              %li
                %p
                  a
                  %em cofibration
                  precisely if underlying morphism of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  (i.e. a
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                %p
                  (def. 3.1.2.2 of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
              %li
                %p a weak equivalences precisely if it is a Cartesian equivalence, as defined above.
          .proof
            %h6#proof_8 Proof
            %p
              The model structure is proposition 3.1.3.7 in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
          .un_remark
            %h6#remark Remark
            %p
              Using
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Map
                      %mi S
                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map_S^\flat(X,Y)
              for the mapping objects makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} sSet^+/S
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Joyal
                    %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              (i.e. enriched in the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark 3.1.4.5
          %p
            Notice that trivially every object in this model structure is cofibrant. The following proposition shows that the above model structure indeed presents the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CartFib
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CartFib(S)
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
          #FibrantObjects.num_prop
            %h6#proposition_3 Proposition
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : X \to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} sSet^+/S
              is
              %em fibrant
              with respect to the above model structure precisely if it is isomorphic to an object of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mo ♮
                    %annotation{:encoding => "application/x-tex"} Y^\natural
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Y \to S
              a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          .proof
            %h6#proof_9 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 3.1.4.1
          %p
            In particular, the fibrant objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                  %mo ≅
                  %msup
                    %mi sSet
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mo *
                %annotation{:encoding => "application/x-tex"} sSet^+ \cong sSet^+/*
            are precisely the quasicategories in which the marked edges are precisely the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} sSet^+/S
            is
            %em not
            the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+over+category"} model structure on an over category
            induced on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} sSet^+/S
            from the Cartesian model structure on
            = succeed "!" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
          .un_def
            %h6#definitionproposition_3 Definition/Proposition
            %p
              %strong
                (coCartesian model structure on
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} sSet^+/S
            %p
              There is another such model structure, with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %strong coCartesian fibrations.
          %h3#MarkedAnodyne Marked anodyne morphisms
          %p
            A class of morphisms with
            %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
            again some class of fibrations is usually called
            %em anodyne
            \. For instance a left/right/inner anodyne morphism of simplicial sets is one that has the left lifting property against all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/left+fibration"} left/right fibration
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
          %p
            The class of
            %em marked anodyne
            morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                %annotation{:encoding => "application/x-tex"} sSet^+
            as defined in the following is something that comes close to having the left lifting property against all Cartesian fibrations. It does not quite, but is still useful for various purposes.
          .un_defn
            %h6#definition_
              Definition (
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, Def 3.1.1.1
              )
            %p
              The collection of
              %strong marked anodyne morphisms
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi SSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} SSet^+/S
              is the class of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi An
                      %mo +
                    %mo =
                    %mi LLP
                    %mo{:stretchy => "false"} (
                    %mi RLP
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi An
                      %mn 0
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} An^+ = LLP(RLP(An^+_0))
              where the generating set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi An
                      %mn 0
                      %mo +
                  %annotation{:encoding => "application/x-tex"} An^+_0
              consists of
            %ul
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo &lt;
                        %mi i
                        %mo &lt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 0 \lt i \lt n
                  the minimally marked
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                  inclusions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ♭
                        %mo →
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mo ♭
                      %annotation{:encoding => "application/x-tex"}
                        (\Lambda[n]_i)^\flat \to \Delta[n]^\flat
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo =
                        %mi n
                      %annotation{:encoding => "application/x-tex"} i = n
                  the horn inclusion with the last edge marked:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi n
                        %mo ,
                        %mi ℰ
                        %mo ∩
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi n
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi ℰ
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (\Lambda[n]_n, \mathcal{E} \cap (\Lambda[n]_n)_1)
                        \\to
                        (\Delta[n], \mathcal{E} )
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is the union of all degenerate edges in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[n]
                  together with the edge
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Δ
                            %mrow
                              %mo{:stretchy => "false"} {
                              %mi n
                              %mo −
                              %mn 1
                              %mo ,
                              %mi n
                              %mo{:stretchy => "false"} }
                          %mo →
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \Delta^{\{n-1,n\}} \to \Delta[n]
              %li
                %p the inclusion
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ♯
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ♭
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ♭
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ♯
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (\Lambda[2]_1)^\sharp \coprod_{(\Lambda[2]_1)^\flat}
                        (\Delta[2])^\flat
                        \\to
                        (\Delta[2])^\sharp
                        \\,.
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  the morphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi K
                            %mo ♭
                          %mo →
                          %msup
                            %mi K
                            %mo ♯
                        %annotation{:encoding => "application/x-tex"} K^\flat \to K^\sharp
          %p The crucial property of marked anodyne morphisms is the following characterization of morphisms that have the right lifting property with respect to them.
          .un_prop
            %h6#proposition_4 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : X \to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi SSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} SSet^+
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              with respect to the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi An
                      %mo +
                  %annotation{:encoding => "application/x-tex"} An^+
              of marked anodyne maps precisely if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              %li
                %p
                  an edge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                      %annotation{:encoding => "application/x-tex"} e
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is marked precisely if it is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p(e)
                  is marked in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and every marked edge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi e
                          %mo{:stretchy => "false"} ¯
                        %mo :
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ¯
                        %mo →
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \bar e : \bar x \to p(y)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  there exists a marked edge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} e : x \to y
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  with
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mover
                            %mi e
                            %mo{:stretchy => "false"} ¯
                        %annotation{:encoding => "application/x-tex"} p(e) = \bar e
          .proof
            %h6#proof_10 Proof
            %p
              This is
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 3.1.1.6
          .un_remark
            %h6#remark_2 Remark
            %p
              Thus, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %msub
                      %mi E
                      %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, E_X) \to (S,E_S)
              is a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              with RLP against marked anodyne morphisms, then its underlying morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X\to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              is almost a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi S
                    %annotation{:encoding => "application/x-tex"} E_S
            %p
              However, if
              %em all
              morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are marked, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi S
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"} (X,E_X) \to S^\sharp
              has the RLP against marked anodyne morphisms precisely when the underlying morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X\to S
              is a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              and exactly the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi X
                      %mo ♮
                  %annotation{:encoding => "application/x-tex"} (X,E_X) = X^\natural
              — in other words, precisely if it is a fibrant object in the model structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi sSet
                        %mo +
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} sSet^+/S
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark. 3.1.1.11
          %p
            The following stability property of marked anodyne morphisms is important in applications. Recall that a cofibration in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mo +
                %annotation{:encoding => "application/x-tex"} sSet^+
            is a morphism whose underlying morphism in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          .un_prop
            %h6#proposition_5 Proposition
            %p
              %strong (stability under smash product with cofibrations)
            %p
              Marked anodyne morphisms are stable under “
              %a.existingWikiWord{:href => "/nlab/show/smash+product"}> smash product
              ” with cofibrations:
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : X \to X'
              marked anodyne, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g : Y \to Y'
              a cofibration, the induced morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ′
                    %mo ×
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    (X \times Y') \coprod_{X \times Y} (X' \times Y)
                    \\to
                    X' \times Y'
            %p
              out of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              is marked anodyne.
          .proof
            %h6#proof_11 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 3.1.2.3
          %h3#as_a_model_for_the_category_of_categories
            As a model for the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The Joyal
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sSet
                    %mi Joyal
                %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
            is an
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            enriched over itself. So it is
            %em not
            a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            in the standard sense, which means
            = succeed "-enriched." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
          %p
            Indeed, the full sSet-enriched subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi sSet
                    %mi Joyal
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} (sSet_{Joyal})^\circ
            on fibrant-cofibrant objects is a model for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
            inside that, obtained by taking in each
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            the maximal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p
            The resulting
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            should have a presentation by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+dendroidal+Cartesian+fibrations"} model structure for dendroidal Cartesian fibrations
          %h2#references References
          %p Marked simplicial sets are introduced in section 3.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p The model structure on marked simplicial oversets is described in section 3.1.3
