                      %mi Y
                      %mo ♮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map_S^\sharp(X,Y^\natural)
              are morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
