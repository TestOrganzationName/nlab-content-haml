                      %mo ♭
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi Map
                      %mo ♭
                    %mo{:stretchy => "false"} (
