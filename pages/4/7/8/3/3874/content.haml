                  %a{:href => "http://en.wikipedia.org/wiki/Atiyah%E2%80%93Singer_index_theorem"} Atiyah-Singer index theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Baum"}> Paul Baum
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Erik+van+Erp"} Erik van Erp
                = succeed "," do
                  %em
