          %h3#foundational_status Foundational status
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+pairing"} axiom of pairing
            and the axiom of
            %span.newWikiWord
              weak replacement
              %a{:href => "/nlab/new/weak+replacement"} ?
            (which is very weak). In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
            = succeed "." do
              %strong axiom of products
            %a.existingWikiWord{:href => "/nlab/show/ordered+pair"} ordered pair
            for more details.
