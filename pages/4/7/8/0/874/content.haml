                  (f_i)_{i \in I}
                  \\;\colon\;
                  Q \longrightarrow \underset{i \in I}{\prod} X_i
          %p
            which factors the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_i
            through the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Q
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mi i
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi X
                            %mi i
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi p
                                %mi i
                        %mtd
                          %msub
                            %mi X
                            %mi i
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Q
                  \\\
                  {}^{\mathllap{(f_i)_{i \in I}}}\downarrow &amp; \searrow^{\mathrlap{f_i}}
                  \\\
                  \\underset{i \in I}{\prod} X_i &amp;\underset{p_i}{\longrightarrow}&amp; X_i
                  }
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
          %p
            In the case of a binary product it is also denoted by “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)\times(-)
            ”:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Q
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mo !
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                          %mover
                            %mo ⟵
                            %mrow
                              %msub
                                %mi p
                                %mn 1
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                          %mo ×
                          %msub
                            %mi X
                            %mn 2
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi p
                                %mn 2
                        %mtd
                          %msub
                            %mi X
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Q
                  \\\
                  \&amp; \swarrow &amp;\downarrow^{\mathrlap{\exists !}}&amp; \searrow
                  \\\
                  X_1 &amp;\overset{p_1}{\longleftarrow}&amp; X_1 \times X_2 &amp;\overset{p_2}{\longrightarrow}&amp; X_2
                  }
                  \\,.
          %p
            An important special case is a
            %a.existingWikiWord{:href => "/nlab/show/power"} power
            of an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} X_i
            to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi I
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mi X
                %annotation{:encoding => "application/x-tex"} X^I = \prod_{i \in I} X
          %p
            Referring to notation above, if we take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} Q = X
            and all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %mi Q
                  %mo →
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_i: Q \to X_i
            to be the
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} 1_X: X \to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi X
                    %mi I
                %annotation{:encoding => "application/x-tex"} (f_i)_{i \in I} = (1_X)_{i \in I}: X \to X^I
          %p
            is called the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \delta_X
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta_X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} \delta_X: X \to X \times X
          %p for binary products.
          %h3#as_a_functor As a functor
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            admits
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi I
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo :
                  %msup
                    %mi C
                    %mi I
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \prod_I = \prod_{i \in I}: C^I \to C
          %p
            can be defined, taking a collection of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (c_i)_{i \in I}
            to their product, and taking a collection of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %msub
                    %mi c
                    %mi i
                  %mo →
                  %msub
                    %mi d
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (f_i: c_i \to d_i)_{i \in I}
            to a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi c
                    %mi i
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi d
                    %mi i
                %annotation{:encoding => "application/x-tex"} \prod_{i \in I} f_i: \prod_{i \in I} c_i \to \prod_{i \in I} d_i
          %p
            defined to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %mo ∘
                    %msub
                      %mi p
                      %mi i
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi c
                      %mi i
                    %mo →
                    %msub
                      %mi d
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (f_i \circ p_i: \prod_{i \in I} c_i \to d_i)_{i \in I}
            %a.existingWikiWord{:href => "/nlab/show/Cat"} category of (small) categories
            has itself small products, and the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi I
                %annotation{:encoding => "application/x-tex"} C^I
            makes reference to this fact. With some care, we can remove the restriction to
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
          %p
            As a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi I
                  %mo :
                  %msup
                    %mi C
                    %mi I
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \prod_I: C^I \to C
            is
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the diagonal functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mi C
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \Delta: C \to C^I
            %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit of the adjunction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi C
                    %mo →
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} 1_C \to \prod \Delta
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in Ob(C)
            %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi c
                  %mo :
                  %mi c
                  %mo →
                  %msup
                    %mi c
                    %mi I
                %annotation{:encoding => "application/x-tex"} \delta_c: c \to c^I
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/counit"} counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                  %mo →
                  %msub
                    %mn 1
                    %mrow
                      %msup
                        %mi C
                        %mi I
                %annotation{:encoding => "application/x-tex"} \Delta \prod \to 1_{C^I}
            is the
            = succeed "-tuple" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi i
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi c
                    %mi i
                  %mo →
                  %msub
                    %mi c
                    %mi i
                %annotation{:encoding => "application/x-tex"} p_i: \prod_{i \in I} c_i \to c_i
          %p
            Following the yoga of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo :
                  %mi Q
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi X
                        %mi i
                %annotation{:encoding => "application/x-tex"} (f_i)_{i \in I}: Q \to \prod_{i \in X_i}
            in terms of the product functor and the unit/diagonal map:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo =
                  %mrow
                    %mo (
                    %mi Q
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi δ
                          %mi Q
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi Q
                    %mover
                      %mo →
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi f
                          %mi i
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo )
                %annotation{:encoding => "application/x-tex"} (f_i)_{i \in I} = \left(Q \stackrel{\delta_Q}{\to} \prod_{i \in I} Q \stackrel{\prod_{i \in I} f_i}{\to} \prod_{i \in I} X_i\right)
          %p
            while in the other direction, as stated in the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            above, we can retrieve the components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %mi Q
                  %mo →
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_i: Q \to X_i
            of a general map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Q
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} f: Q \to \prod_{i \in I} X_i
            in terms of the diagonal functor and the counit/projection maps. It boils down to saying
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo =
                  %mrow
                    %mo (
                    %mi Q
                    %mover
                      %mo →
                      %mi f
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo )
                %annotation{:encoding => "application/x-tex"} f_i = \left(Q \stackrel{f}{\to} \prod_{i \in I} X_i \stackrel{p_i}{\to} X_i\right)
          %h2#examples Examples
          %h3#products_of_sets Products of sets
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B)
            is written
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            are called
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/ordered+pairs"} ordered pairs
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (a,b) = \{\{a\},\{a,b\}\}
          %p rather than as a function so that ordered pairs can then be used in the definition of function. From a structural perspective, however, this is unnecessary.)
          %p
            Given sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} A_1
            through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A_1,\ldots,A_n)
            is written
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_{i=1}^n A_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_1,\ldots,a_n)
            are called
            = succeed "." do
              %strong
                ordered
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
          %p
            Given sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A_1,A_2,\ldots)
            is written
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_{i=1}^\infty A_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a_1,a_2,\ldots,)
            are called
            = succeed "." do
              %strong
                infinite
                %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
          %p
            Given a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A)
            may be identified with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself; that is, we identify the
            %strong
              ordered
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
            The cartesian product of the empty family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ()
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
            %strong
              %a.existingWikiWord{:href => "/nlab/show/empty+list"} empty list
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} pt
                  %annotation{:encoding => "application/x-tex"} \pt
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %h3#further_examples Further examples
          %ul
            %li
              In categories of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/algebraic+categories"} algebraic categories
            like
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
          %ul
            %li
              %p
                For a non-example: The category
                %a.existingWikiWord{:href => "/nlab/show/Field"} Field
                of
                %a.existingWikiWord{:href => "/nlab/show/fields"} fields
                does not admit
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/products"} products
            %li
              %p
                In categories of topological type, products are again constructed in a common sense manner; see for instance
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                for a prototype.
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+categories"} topological categories
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Preord"} Preord
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          %p
            This principle continues to hold even for
            %em infinitary
            products, where the correct structure might not be obvious without guidance from categorical considerations. For example, for topological spaces, for an infinite product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_{i \in I} X_i
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
            %a.existingWikiWord{:href => "/nlab/show/box+topology"} box topology
            which might be the first thing one would try.
          %ul
            %li
              %p
                In any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Set^C
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ×
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (F \times G)(c) = F(c) \times G(c)
                with the pointwise product projection maps. This even works if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is
                %a.existingWikiWord{:href => "/nlab/show/large+category"} large
                (making
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Set^C
                ‘very large’).
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                has products and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C \hookrightarrow D
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                exist and are calculated as they are in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                on a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                forming a reflective subcategory of a category of presheaves (on the underlying category of the site).
              %ul
                %li
                  For instance, the category
                  %a.existingWikiWord{:href => "/nlab/show/Pos"} Pos
                  of
                  %a.existingWikiWord{:href => "/nlab/show/posets"} posets
                  is a reflective subcategory of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Preord"} Preord
                %li
                  Any
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                  can be exhibited as a reflective subcategory of a presheaf topos; as such we know how to calculate products there.
            %li
              %p
                Generalizing the last example still further, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo :
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U: A \to X
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic functor
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                are created (or
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflected
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T: X \to X
                are given by products in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                has products and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} i: C \hookrightarrow D
                is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
                subcategory, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                has a right adjoint (co-reflector)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                can be formed by taking products in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                and then applying
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
              %ul
                %li
                  For example, the category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CG
                      %annotation{:encoding => "application/x-tex"} CG
                  of
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+spaces"} compactly generated spaces
                  is coreflective in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CG
                      %annotation{:encoding => "application/x-tex"} CG
                  does not coincide in general with the topological product: one may have to add to the product topology still more sets, just enough to ensure that the topology is compactly generated.
            %li
              %p
                Products in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
                are given by
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              %ul
                %li
                  %p
                    In some cases, this formal tautology gives the only sensible way to construct products. For example, to form products
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ×
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X \times Y
                    in the category
                    %a.existingWikiWord{:href => "/nlab/show/Loc"} Loc
                    of
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/locales"} locales
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \mathcal{O}(X) \otimes \mathcal{O}(Y)
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/frames"} frames
                %li
                  %p
                    Similarly, the product of two
                    %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
                    is the formal dual of the coproduct of their corresponding coordinate rings, again given by a tensor product.
            %li
              %p
                Relative to a
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                with monoidal product
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
                %a.existingWikiWord{:href => "/nlab/show/cocommutative+comonoids"} cocommutative comonoids
                are given by the tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \otimes Y
                in the underlying smc category.
              %ul
                %li
                  For instance, this is how products of
                  %a.existingWikiWord{:href => "/nlab/show/cocommutative+coalgebras"} cocommutative coalgebras
                  are formed. This applies for instance to cocommutative
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
                %li
                  In a
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+bicategory"} cartesian bicategory
                  such as
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Rel
                        %annotation{:encoding => "application/x-tex"} Rel
                  %em maps
                  (= left adjoint 1-cells) coincides with the category of cocommutative comonoids and comonoid maps between them (which is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                  in the case of
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Rel
                        %annotation{:encoding => "application/x-tex"} Rel
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Rel
                      %annotation{:encoding => "application/x-tex"} Rel
                  coincides with the cartesian product in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} Set
            %li
              %p
                For categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                enriched in the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                are
                %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
                and hence coincide with coproducts in a controlled fashion (via
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/absolute+limits"} absolute limits
            %li
              %p
                In the category
                %a.existingWikiWord{:href => "/nlab/show/SupLat"} SupLat
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sup-lattices"} sup-lattices
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↦
                      %msup
                        %mi X
                        %mi op
                    %annotation{:encoding => "application/x-tex"} X \mapsto X^{op}
                that takes a sup-lattice to its posetal opposite is part of a perfect duality
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi SupLat
                          %mi op
                        %mo →
                        %mi SupLat
                      %annotation{:encoding => "application/x-tex"} SupLat^{op} \to SupLat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f: X \to Y
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mi op
                      %mo :
                      %msup
                        %mi Y
                        %mi op
                      %mo →
                      %msup
                        %mi X
                        %mi op
                    %annotation{:encoding => "application/x-tex"} g^{op}: Y^{op} \to X^{op}
                where
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ⊣
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \dashv g
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                itself, so we conclude that products in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                are actually given by coproducts in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
                which in turn are given by coproducts in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/product+of+simplices"} product of simplices
            %li
              %p
                In the
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                the cartesian product is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/product+of+categories"} product of categories
            %li
              %p
                If either
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                out of a Cartesian product is regarded as a (
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"}> fiber
                )
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                map, it is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/trivial+fiber+bundle"} trivial fiber bundle
          %h2#properties Properties
          %h3#relation_to_type_theory Relation to type theory
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/relation+between+category+theory+and+type+theory"} relation between category theory and type theory
            products in a category correspond to
            %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
