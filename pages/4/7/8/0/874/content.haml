              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi j
                %annotation{:encoding => "application/x-tex"} f_j
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi j
                %annotation{:encoding => "application/x-tex"} A_j
            for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            As stated, the
            %a.existingWikiWord{:href => "/nlab/show/target"} target
            of such a function depends on the argument, which is natural in dependent
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} \prod_i A_i
            to be the set of those functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            to the
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨄
                    %mi i
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} \biguplus_i A_i
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi j
                  %mo ∈
                  %msub
                    %mi A
                    %mi j
                %annotation{:encoding => "application/x-tex"} f_j \in A_j
            (treating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi j
                %annotation{:encoding => "application/x-tex"} A_j
            as a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨄
                    %mi i
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} \biguplus_i A_i
            as usual) for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            In traditional forms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to be the
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %mi i
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} \bigcup_i A_i
            or even the class of all objects (equivalently, leave it unspecified).
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
