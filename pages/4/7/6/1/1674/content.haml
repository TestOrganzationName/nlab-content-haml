              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                      %mo ≰
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} |\alpha| \nleq \kappa
          %p
            The axiom of choice also implies the well-ordering theorem, that any set can be well-ordered. Thus with choice,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi κ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \kappa^+
            is (now as a cardinal again) the smallest cardinal number greater than
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi κ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \kappa^+
          %h3#gch_implies_ac GCH implies AC
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/ZF"} ZF
            (without C, the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            can be well-ordered if there is an injection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi X
                    %mo →
                    %mi ℵ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i: X \to \aleph(X)
            = succeed ":" do
              %a{:href => "#Gill"} Gillman
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If the generalized
              %a.existingWikiWord{:href => "/nlab/show/continuum+hypothesis"} continuum hypothesis
              holds, then the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              holds, i.e., ZF + GCH implies AC.
          %p
            (Recall the GCH as formulated in ZF: for infinite sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ,
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Y, Z
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} |
                    %mo ≤
                    %mo{:stretchy => "false"} |
                    %mi Z
                    %mo{:stretchy => "false"} |
                    %mo ≤
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |Y| \leq |Z| \leq |P(Y)|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} |
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mi Z
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |Y| = |Z|
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Z
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |Z| = |P(Y)|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |Y|
            denote the cardinality as usual and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
