                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi κ
                        %mi x
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \dom(R) = \kappa_x^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is onto, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi op
                  %annotation{:encoding => "application/x-tex"} R^{op}
              witnesses
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ≤
                      %msubsup
                        %mi κ
                        %mi x
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \alpha \leq \kappa_x^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
