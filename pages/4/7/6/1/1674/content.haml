                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              by definition of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
