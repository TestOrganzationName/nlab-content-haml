                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %em PS de Rham complex
              (“piecewise smooth”) is the
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{dR}(\Delta^\bullet)
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:SmoothDifferentialFormsOnSimplices"} (7)
              %a.existingWikiWord{:href => "/nlab/show/end"} end
              in
