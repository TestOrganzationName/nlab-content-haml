            %li
              %p
                there is a
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                of
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi i
                          %mphantom
                            %mi AA
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Sing
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mrow
                        %mo |
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo |
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      S(X)
                      \\overset{ \phantom{AA} i \phantom{AA} }{\hookrightarrow}
                      Sing(X)
                      \=
                      Sing\big( \left\vert S(X)\right\vert \big)
              %p
                into the
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+set"} singular simplicial set
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (this being the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                of the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo |
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo |
                      %mo ⊣
                      %mi Sing
                    %annotation{:encoding => "application/x-tex"} \left\vert - \right\vert \dashv Sing
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                between the
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                and the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo |
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo |
                    %annotation{:encoding => "application/x-tex"} \left\vert -\right\vert
                preserves all weak equivalences, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                    %annotation{:encoding => "application/x-tex"} Sing
                those between CW-complexes, by
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
          #PLdeRhamComplex.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex+of+smooth+manifold+is+equivalent+to+de+Rham+complex"}> PL de Rham complex of smooth manifold is equivalent to de Rham complex
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              We have the following
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              between the
              %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex"} PL de Rham complex
              of (the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              underlying)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the smooth
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi PLdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi dR
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi i
                                    %mo *
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi poly
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mo *
                            %mo ↙
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msubsup
                                  %mi Ω
                                  %mi PLdR
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mspace{:width => "thickmathspace"}
                                %mo =
                                %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi Ω
                              %mi PLdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi PSdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
