              %a.maruku-eqref{:href => "#eq:PSdERhamComplexOfSimplicialSet"} (8)
          #eq:InclusionOfPolynomialFormsIntoSmoothFormsOnSimplices.maruku-equation
            %span.maruku-eq-number (9)
