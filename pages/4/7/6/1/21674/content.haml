                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    \\Omega^\bullet_{PLdR}
                    \\big(
                    S(X)
                    \\big)
                    \&amp;&amp;
                    \&amp;&amp;
                    \\Omega^\bullet_{dR}(X)
                    \\\
                    \&amp;
                    {}^{
                    \\mathllap{
                    i^\ast
                    }
                    }
                    \\nearrow
                    \&amp; &amp;
                    \\searrow^{
                    \\mathrlap{
                    i_{poly}
                    }
                    }
                    \&amp; &amp;
                    {}^{
                    \\mathllap{
                    p^\ast
                    }
                    }
                    \\swarrow
                    \\\
                    \\mathllap{
                    \\Omega^\bullet_{PLdR}(X)
                    \\;=\;
                    }
                    \\Omega^\bullet_{PLdR}
                    \\big(
                    Sing(X)
                    \\big)
                    \&amp;&amp; &amp;&amp;
                    \\Omega^\bullet_{PSdR}
                    \\big(
                    S(X)
                    \\big)
                    }
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complex
              corresponding to any smooth
              %a.existingWikiWord{:href => "/nlab/show/triangulation"} triangulation
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_2 Proof
            %p
              For the two morphisms on the right this is
              = succeed "." do
                %a{:href => "#GriffithMorgan13"} Griffith-Morgan 13, Cor. 9.9
            %p
              For the morphism on the left this follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(X) \hookrightarrow Sing(X)
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              and since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi PLdR
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{PLdR}
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              preserves weak equivalences between
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              (where every simplicial set being cofibrant), by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
