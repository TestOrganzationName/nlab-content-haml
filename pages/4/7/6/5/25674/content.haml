          %h2#idea Idea
          %p
            The
            %em external direct sum
            or
            %em external Whitney sum
            of
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            is the operation which from a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒱
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \mathscr{V} \,\in\,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"} Vect(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒲
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \mathscr{W} \,\in\,
            %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Vect(Y)
            over possibly different base spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} X,\ Y \,\in\,
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            forms the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
            (“
            %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"}> Whitney sum
            ”)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)\bigoplus(-)
            of their
            %span.newWikiWord
              pullback
              %a{:href => "/nlab/new/pullback+of+a+bundle"} ?
            to the
            %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            of their base spaces:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Vect
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi Vect
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} oversey
                          %mo ⊞
                          %mo ⟶
                        %mtd
                          %mi Vect
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi.mathscript 𝒱
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi.mathscript 𝒲
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi pr
                            %mi X
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mi.mathscript 𝒱
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %msub
                            %mo ⊕
                            %mrow
                              %mi X
                              %mo ×
                              %mi Y
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi pr
                            %mi Y
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mi.mathscript 𝒲
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Vect(X) \times Vect(Y)
                  \&amp;\oversey{\boxplus}{\longrightarrow}&amp;
                  Vect(X\times Y)
                  \\\
                  \\big(
                  \\mathscr{V}
                  ,\,
                  \\mathscr{W}
                  \\big)
                  \&amp;\mapsto&amp;
                  \\big(
                  (pr_X)^\ast \mathscr{V}
                  \\big)
                  \\oplus_{X \times Y}
                  \\big(
                  (pr_Y)^\ast \mathscr{W}
                  \\big)
                  }
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊕
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi Vect
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Vect
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Vect
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \oplus \,\colon\, Vect(X \times Y) \times Vect(X \times Y) \longrightarrow Vect(X \times Y)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Vect(X \times Y)
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi X
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_{X} Vect(X)
            = succeed "." do
              %a{:href => "Grothendieck+construction#CartesianProductInGrothendieckConstruction"} there
