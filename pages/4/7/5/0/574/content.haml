          %h2#in_inner_product_spaces In inner product spaces
          %p
            Two elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                %annotation{:encoding => "application/x-tex"} x,y
            in an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
            %strong orthogonal
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normal+vectors"} normal vectors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⊥
                  %mi y
                  %mo ,
                %annotation{:encoding => "application/x-tex"} x \perp y,
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \langle x,y\rangle = 0
          %h2#in_category_theory In category theory
          %h3#definition Definition
          %p
            Two
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} e:A\to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} m:C\to D
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            are said to be
            = succeed "," do
              %strong orthogonal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⊥
                    %mi m
                  %annotation{:encoding => "application/x-tex"} e\perp m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            has the
            %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
            with respect to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %a.existingWikiWord{:href => "/nlab/show/commutative+diagram"} commutative square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi e
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %munder
                            %mo →
                            %mi m
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{ A &amp; \overset{e}{\to} &amp; B\\
                  \\downarrow &amp;&amp; \downarrow \\
                  C &amp; \underset{m}{\to} &amp; D}
          %p
            there exists a unique diagonal
            %a.existingWikiWord{:href => "/nlab/show/filler"} filler
            making both triangles commute:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi e
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %munder
                            %mo →
                            %mi m
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{ A &amp; \overset{e}{\to} &amp; B\\
                  \\downarrow &amp; \swarrow &amp; \downarrow \\
                  C &amp; \underset{m}{\to} &amp; D}
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi m
                  %mo{:stretchy => "false"} |
                  %mi e
                  %mo ⊥
                  %mi m
                  %mspace{:width => "thickmathspace"}
                  %mo ∀
                  %mi e
                  %mo ∈
                  %mi E
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{m | e\perp m \;\forall e\in E\}
            is denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo{:stretchy => "false"} ↓
                %annotation{:encoding => "application/x-tex"} E^{\downarrow}
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} E^\perp
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi e
                  %mo{:stretchy => "false"} |
                  %mi e
                  %mo ⊥
                  %mi m
                  %mspace{:width => "thickmathspace"}
                  %mo ∀
                  %mi m
                  %mo ∈
                  %mi M
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{e | e\perp m \;\forall m\in M\}
            is denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mo{:stretchy => "false"} ↑
                %annotation{:encoding => "application/x-tex"} M^{\uparrow}
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo ⊥
                    %mi M
                  %annotation{:encoding => "application/x-tex"} {}^\perp M
            %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            on the poset of classes of morphisms in the ambient category. In particular, we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mrow
                    %mo ⊥
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi E
                    %mo ⊥
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊥
                  %mo =
                  %msup
                    %mi E
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} ({}^\perp(E^\perp))^\perp = E^\perp
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo ⊥
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mrow
                      %mo ⊥
                    %mi M
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mrow
                      %mo ⊥
                    %mi M
                  %annotation{:encoding => "application/x-tex"} {}^\perp(({}^\perp M)^\perp) = {}^\perp M
          %p
            A pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo ⊥
                  %mo =
                  %mi M
                %annotation{:encoding => "application/x-tex"} E^\perp = M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %msup
                    %mrow
                    %mo ⊥
                  %mi M
                %annotation{:encoding => "application/x-tex"} E = {}^\perp M
            is sometimes called a
            = succeed "." do
              %strong prefactorization system
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-morphism," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} factorization system
          %h3#orthogonality_of_morphisms_to_objects Orthogonality of morphisms to objects
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} e:A\to B
            is said to be (left)
            %strong orthogonal
            to an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ⊥
                  %mi C
                %annotation{:encoding => "application/x-tex"} e\perp C
            (equivalently :
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is right orthgonal to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} A \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi e
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp; \overset{e}{\to} &amp; B
                  \\\
                  \\downarrow &amp;&amp;
                  \\\
                  C
                  }
          %p
            there exists a unique morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} B \to C
            making the following diagram commute:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi e
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↙
                        %mtd
                      %mtr
                        %mtd
                          %mi C
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp; \overset{e}{\to} &amp; B
                  \\\
                  \\downarrow &amp; \swarrow &amp;
                  \\\
                  C
                  \\mathrlap{\,.}
                  }
          %p
            If the category we are working with has a terminal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ⊥
                  %mo !
                %annotation{:encoding => "application/x-tex"} e \perp !
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo :
                  %mi C
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} ! : C \to 1
            is the unique morphism to the terminal object. Abusing notation, we often write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} E^\perp
            for the collection of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            which are right orthogonal to each morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} E^\perp
            as the (right)
            %strong orthogonal complement
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %h3#examples Examples
          %ul
            %li
              %p
                Of course, any
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
                gives plenty of examples. The ur-example is that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ⊥
                      %mi m
                    %annotation{:encoding => "application/x-tex"} e\perp m
                in
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                (or actually, any
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
                and injection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/strong+epimorphism"} strong epimorphism
                in any category is, by definition, an epimorphism in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mrow
                          %mo ⊥
                        %mo{:stretchy => "false"} (
                        %mi Mono
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} {}^\perp(Mono)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mono
                    %annotation{:encoding => "application/x-tex"} Mono
                is the class of monomorphisms. (If the category has equalizers, then every map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                        %mo ⊥
                      %mo{:stretchy => "false"} (
                      %mi Mono
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {}^\perp(Mono)
                is epic.) Dually, a
                %a.existingWikiWord{:href => "/nlab/show/strong+monomorphism"} strong monomorphism
                is a monomorphism in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Epi
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊥
                      %annotation{:encoding => "application/x-tex"} (Epi)^\perp
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is a category, interesting full subcategories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ⊆
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{D} \subseteq \mathcal{C}
                are often usefully characterized as the orthogonal complement of some collection of morphisms. In fact, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                is a
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo =
                      %msubsup
                        %mi E
                        %mo *
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{D} = E_\ast^\perp
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo *
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi C
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi η
                            %mi C
                      %mi iL
                      %mi C
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi C
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} E_\ast = \{ C \xrightarrow{\eta_C} iL C \mid C \in \mathcal{C}\}
                (where we write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} i : D \to C
                for the inclusion,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                for the left adjoint, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %msub
                        %mn 1
                        %mi 𝒞
                      %mo →
                      %mi iL
                    %annotation{:encoding => "application/x-tex"} \eta : 1_{\mathcal{C}} \to iL
                for the unit of the adjunction), but typically we already have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo =
                      %msup
                        %mi E
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{D} = E^\perp
                for some much smaller collection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ⊆
                        %msub
                          %mi E
                          %mo *
                      %annotation{:encoding => "application/x-tex"} E \subseteq E_\ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                in this way for some such well-chosen set
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                Conversely, the
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+subcategory+problem"} orthogonal subcategory problem
                for a
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                in a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                asks whether the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Sigma^\perp
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/orthogonal"} orthogonal
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⊥
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f \perp X
                to mean
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⊥
                      %mo !
                      %mo :
                      %mi X
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f \perp !: X \to 1
              %p
                The orthogonal subcategory problem is related to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Sigma^\perp
                is indeed a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo :
                      %mi C
                      %mo →
                      %msup
                        %mi Σ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} r: C \to \Sigma^\perp
                be the reflector (the
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                to the inclusion
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %msup
