              of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R/(x_1, \cdots, x_d)
          #KoszulResolutionForNoetherianRngAndElementsInJacobson.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (Koszul resolution detected in degree (-1))
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, \cdots, x_d)
              a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of elements in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Noetherian+ring"} Noetherian
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi i
                      %annotation{:encoding => "application/x-tex"} x_i
                  is contained in the
                  %a.existingWikiWord{:href => "/nlab/show/Jacobson+radical"} Jacobson radical
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
            %p then the following are equivalent:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  of the Koszul complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi x
                          %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(x_1, \cdots, x_d)
                  vanishes in degree
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} -1
              %li
                %p
                  the Koszul complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi x
                          %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(x_1, \cdots, x_d)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/free+resolution"} free resolution
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi x
                            %mi d
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} R/(x_1, \cdots, x_d)
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  vanishes in all degrees
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≤
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \leq -1
              %li
                %p
                  the sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi x
                          %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x_1, \cdots, x_d)
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/regular+sequence"} regular sequence
          %p
            A
            %strong proof
            is spelled out on
            %a{:href => "https://en.wikipedia.org/wiki/Koszul_complex#Properties_of_a_Koszul_homology"} Wikipedia - Properties of Koszul homology
          %h2#examples Examples
          #KoszulComplexForFormalPowerSeriesAlgebras.num_example
            %h6#example Example
            %p
              %strong (Koszul complex for formal power series algebras)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R = k[ [ X_1,\cdots, X_n ] ]
              be a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi f
                      %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_1, \cdots, f_r)
              be formal power series whose constant term vanishes. Then the Koszul complex is a homological resolution precisely already if its cohomology in degree -1 vanishes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi H
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi f
                        %mi r
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    H^{-1}(K(f_1, \cdots, f_n))
                    \= 0
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    K(f_1, \cdots, f_n)
                    \\overset{\simeq_{qi}}{\longrightarrow}
                    k[ [X_1, \cdots X_n] ]/(f_1, \cdots, f_r)
                    \\right)
                    \\,.
            %p
              This is because the assumptions of prop.
              %a.maruku-ref{:href => "#KoszulResolutionForNoetherianRngAndElementsInJacobson"}
              are met: A formal power series ring over a field is Noetherian (
              %a{:href => "noetherian+ring#PolynomialAlgebraOverNoetherianRingIsNoetherian"}> this example
              ) and an element of a formal power series algebra is in the Jacobson radical precisely if its constant term vanishes (
              %a{:href => "Jacobson+radical#JacobsonRadicalOfFormalPowerSeriesAlgebra"}> this example
              ).
