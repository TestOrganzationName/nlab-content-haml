              its
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              ).
            %p
              Then in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                      %mi ∅
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mo ⊣
                    %mo ♯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\flat \dashv \sharp)
              resolves, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Aufhebung"}
              %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} unity of opposites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo ⊣
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\emptyset \dashv \ast)
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                  %annotation{:encoding => "application/x-tex"} \flat
              in this case is given by forming
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              and re-embedding the resulting
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/constant+sheaf"} constant sheaf
            %p
              Since by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X\in \mathbf{H}
              any sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X \colon \mathcal{S}^{op}\to Set
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\flat X \simeq X(\ast)
            %p
              (where we may leave the constant re-embedding implicit, due to it being
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %p
              Moreover by assumption on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+sites"} cohesive sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U\in \mathcal{S}
              there exists a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} i \colon \ast \to U
              hence for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X\in \mathbf{H}
              and every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              there exists a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo ♭
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i^\ast \colon X(U)\to \flat X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \flat X \simeq \emptyset
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} X(U) \simeq \emptyset
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{S}
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} X\simeq \emptyset
              = succeed "." do
                %a.maruku-ref{:href => "#AufhebungOfBecomingMeansOnlyInitialObjectHasNoGlobalPoints"}
          #OverCohesiveSiteBecomingIsAufgehoben.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
              (or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh(\mathcal{S})
              its
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              with values in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              (or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh_\infty(S)
              its
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              ).
            %p
              Then in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              we have Aufhebung, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Aufhebung"}
              %a.existingWikiWord{:href => "/nlab/show/duality+of+opposites"} duality of opposites
              of
              %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊣
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset \dashv \ast
              (“
              %a.existingWikiWord{:href => "/nlab/show/Dasein"}> Dasein
              ”).
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ♭
                          %mtd
                            %mo ⊣
                          %mtd
                            %mo ♯
                        %mtr
                          %mtd
                            %mo ∨
                          %mtd
                            %mo ↗
                          %mtd
                            %mo ∨
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo ⊣
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat &amp;\dashv&amp; \sharp
                    \\\
                    \\vee &amp;\nearrow&amp; \vee
                    \\\
                    \\emptyset &amp;\dashv&amp; \ast
                    }
          .proof
            %h6#proof_3 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#OverCohesiveSiteBecomingIsResolved"}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mo ⊣
                    %mo ♯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\flat\dashv \sharp)
              resolves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo ⊣
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\emptyset \dashv \ast)
              and so it remains to see that it is the minimal
              %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} level
              with this property. But the
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp
              %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal types
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              which is clearly a
              %a.existingWikiWord{:href => "/nlab/show/two-valued+topos"} two-valued
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean topos
              %a{:href => "subtopos#BooleantoposesAreAtoms"} this proposition
              these are the
              %a.existingWikiWord{:href => "/nlab/show/atoms"} atoms
              in the
              %a.existingWikiWord{:href => "/nlab/show/subtopos+lattice"} subtopos lattice
              hence are minimal as non-trivial subtoposes and hence also as non-trivial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} levels
          #OnDoubleNegation.num_remark
            %h6#remark_5 Remark
            %p
              As mentioned above, the Aufhebung of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊣
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset\dashv \ast
              is necessarily given by a
              %em
                %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense
              subtopos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_j
              %a.existingWikiWord{:href => "/nlab/show/double+negation+topology"} double negation topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg\neg
              is the unique largest dense topology it follows in general that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo ⊆
                    %msub
                      %mi ℰ
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}\subseteq\mathcal{E}_j
              , in particular in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
              happens to be
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
              and hence happens to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} level
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi j
                    %mo =
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_j = \mathcal{E}_{\neg\neg}
              is, in particular, a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean topos
          %p
            A special case of this are toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
            is
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open
            whence essential in particular; these are called
            = succeed "-scattered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
          %p
            %strong Proposition.
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/scattered+topos"} scattered topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
            is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %p
            Another consequence is that the Aufhebung
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mi j
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_j
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
            is
            %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean
            precisely when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
            is essential e.g. for Boolean
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            this happens trivially and accordingly the Aufhebung of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv \ast
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            in this case.
          %p
            It also follows from the
            %a{:href => "#OverCohesiveSiteBecomingIsAufgehoben"} above proposition
            that for
            %a.existingWikiWord{:href => "/nlab/show/cohesive+sites"} cohesive sites
            over
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ¬
                      %mo ¬
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{\neg\neg}=Set
            i.e. the double negation topos coincides with the base.
          .num_example
            %h6#example_2 Example
            %p
              Examples of
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.maruku-ref{:href => "#OverCohesiveSiteBecomingIsAufgehoben"}
              and hence exhibiting Aufhebung of becoming include
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean-topological+%E2%88%9E-groupoids"} Euclidean-topological ∞-groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+%E2%88%9E-groupoids"} formal smooth ∞-groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/super+%E2%88%9E-groupoids"} super ∞-groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
            %p
              Here
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+%E2%88%9E-groupoid"} formal smooth ∞-groupoid
              has its
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
              further refined to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi id
                          %mtd
                            %mo ⊣
                          %mtd
                            %mi id
                        %mtr
                          %mtd
                            %mo ∨
                          %mtd
                          %mtd
                            %mo ∨
                        %mtr
                          %mtd
                            %mi ℜ
                          %mtd
                            %mo ⊣
                          %mtd
