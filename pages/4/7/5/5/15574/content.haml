          .num_example
            %h6#example Example
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mo →
                  %annotation{:encoding => "application/x-tex"} Set^{\to}
              with objects maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
