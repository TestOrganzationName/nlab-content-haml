                      %mi j
                    %mi X
                    %mo =
                    %msub
                      %mo ◯
                      %mi j
                    %msub
                      %mo □
                      %mi i
                    %mi X
                    %mo =
                    %msub
                      %mo □
                      %mi i
                    %mi X
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \bigcirc_j X =\bigcirc_j \Box_i X =\Box_i X =X
              i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
