                      %mi i
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} i\ll\bar{i}
              and for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
