                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mo ♭
                            %mi X
                            %mo ≃
                            %mi ∅
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (X \simeq \emptyset)
                    \&amp; \simeq
                    (X \to \emptyset)
                    \\\
                    \&amp; \simeq (X \to \sharp \emptyset)
                    \\\
                    \&amp; \simeq (\flat X \to \emptyset)
                    \\\
                    \&amp; \simeq (\flat X \simeq \emptyset)
                    \\end{aligned}
                    \\,.
            %p
              Conversely, assume that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ♭
                      %mi X
                      %mo ≃
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ≃
                      %mi ∅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\flat X \simeq \emptyset) \Leftrightarrow (X \simeq \emptyset)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
