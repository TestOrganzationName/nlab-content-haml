                    \\\
                    \\bigcirc_i &amp;\ll&amp; \bigcirc_{\bar i}
                    }
            %p
              iff it is a minimal level which resolves the opposites of level
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
