                            %mo ♭
                            %mi X
                            %mo →
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo →
                            %mo ♯
                            %mi ∅
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
