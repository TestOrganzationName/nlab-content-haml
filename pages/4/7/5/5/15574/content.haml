              its
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              (or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
