                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mo ♭
                            %mi X
                            %mo ≃
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
