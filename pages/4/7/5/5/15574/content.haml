                  %mrow
                    %msub
                      %mo ◯
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcirc_i
              one could think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi j
                    %msub
                      %mo □
                      %mi i
                    %mo =
                    %msub
                      %mo □
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcirc_j \Box_i=\Box_i
              as dialogical refinement of the opposition through a
              = succeed ":" do
                %em negation of the negation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcirc_i
              gets updated -
              %em sublated
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \bigcirc_j
              in order to absorb the ‘opponent’
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo □
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \Box_i
            %p
              Note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi j
                    %msub
                      %mo □
                      %mi i
                    %mo =
                    %msub
                      %mo □
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcirc_j \Box_i=\Box_i
              does not imply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo □
                      %mi j
                    %msub
                      %mo ◯
                      %mi i
                    %mo =
                    %msub
                      %mo ◯
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \Box_j \bigcirc_i =\bigcirc_i
              , e.g. in the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mo →
                  %annotation{:encoding => "application/x-tex"} Set^\to
              the level
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊣
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
              is resolved by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo ⊣
                    %mi ʃ
                  %annotation{:encoding => "application/x-tex"} \nabla\dashv &amp;#643;
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo ∘
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mo *
                  %annotation{:encoding => "application/x-tex"} (\nabla\circ\ast)\neq\ast
              (see
              = succeed ")." do
                %a{:href => "#SierpExample"} below
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              %em co-resolves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo □
                        %mi j
                      %msub
                        %mo ◯
                        %mi i
                      %mo =
                      %msub
                        %mo ◯
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \Box_j \bigcirc_i =\bigcirc_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              resolves and co-resolves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              we say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              bi-resolves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "-sheaves" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "-skeleta" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "-sheaves" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "-skeleta" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          .num_remark
            %h6#remark_2 Remark
            %p
              The Aufhebung of a level is the smallest level that resolves its opposites or contradictions. Such a level need not exist in general for every level but in certain cases like
              %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
              over
              %a.existingWikiWord{:href => "/nlab/show/graphic+category"} graphic categories
              or, more generally, over
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+regular+categories"} von Neumann regular categories
              (
              %a{:href => "#Law02"}> Lawvere 2002
              ), it does. The Aufhebungs relation is also called the
              %em jump operator
              in
              = succeed "." do
                %a{:href => "#Law09"} Lawvere (2009)
          .num_remark
            %h6#remark_3 Remark
            %p
              Comparing with
              %a.existingWikiWord{:href => "/nlab/show/Science+of+Logic"} WdL
              under Lawvere’s translation and identifing the
              %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} levels
              with logical categories of thinking in the ordinary sense (thought determinations -
              = succeed ")," do
                %em Gedankenbestimmungen
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊣
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
              corresponds to Hegel’s logical category of
              %em indeterminate being
              whereas the higher levels correspond to logical categories of
              %em determinate being
              \-
              = succeed "." do
                %em Bestimmtheit
            %p
              Furthermore one sees that the subtoposes corresponding to the levels trace out as
              %em mathematical
              categories the
              %em logical
              categories of thought as envisioned by Hegel thereby corroborating the terminological choices of Eilenberg and Mac Lane made in their 1945 paper!
          .num_remark
            %h6#remark_4 Remark
            %p We can use the definition to try to shed some light on the apparently rather odd contention by Hegel that the method of logic is analytic and synthetic at the same time:
            %blockquote
              %p
                Der Gang oder die Methode des absoluten Wissens ist ebensosehr analytisch als synthetisch. Die Entwicklung dessen, was im Begriff enthalten ist, die Analysis, ist das Hervorgehen verschiedener Bestimmungen, die im Begriff enthalten sind, somit zugleich synthetisch. (
                %a{:href => "#Begriff"}> Begriffslehre für die Mittelklasse (1809/10)
                , p.161)
            %p
              We can think of the inclusion of the sheaf category of a lower level into the higher sheaf category as an
              %em analytic
              relation between the concepts involved: when viewed as a relation between the
              %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
              classified by the respective subtoposes an inclusion relation corresponds indeed to an unpacking of the richer theory of the smaller subtopos e.g. the subtopos corresponding to the theory of
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local rings
              is included in the topos corresponding to the theory of rings which on the conceptual side is spelled out as
              = succeed "," do
                %em a local ring is a ring
            %p
              This analytic procedure seems close to the ‘analytical reading’ of Hegel’s dialectic as a refinement of meaning postulates proposed by F. Berto e.g. in (
              %a{:href => "#Berto07"}> Berto 2007
              ).
            %p
              Whereas on the
              %em synthetic
              side, by demanding
              %em essentiality
              of the subtoposes we get at each level skeletal ‘determinations’ corresponding to features
              %em not
              contained in the concept on the sheaf side which by the resolution condition nevertheless get synthesized into the sheaf side on the higher levels.
          %h2#examples Examples
          %h3#AufhebungOfBecoming Aufhebung of Becoming – Determinate being
          %h4#from_fausts_study From Faust’s study
          %p
            In the context of a
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/category+of+being"} category of being
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            and product preserving components functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi _0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\empty\dashv \ast
          %p
            between
            %em
              %a.existingWikiWord{:href => "/nlab/show/nothing"} non being
            (the
            %a.existingWikiWord{:href => "/nlab/show/idempotent+comonad"} idempotent comonad
            constant on the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %em
              %a.existingWikiWord{:href => "/nlab/show/being"} pure being
            (the idempotent comonad constant in the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed ")" do
              %a{:href => "#ExamplesBecomingFormalization"} below
            %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} opposition
            of
            %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mo ⊣
                  %mo ♯
                %annotation{:encoding => "application/x-tex"}
                  \\flat\dashv \sharp
          %p
            given by
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            %em non-becoming
            vs.
            %em pure becoming
            (cf. Lawvere 1989a, 1989b,
            = succeed ")" do
              %a{:href => "#Law91a"} 1991a
            = succeed "." do
              %sup#fnref:8
                %a{:href => "#fn:8", :rel => "footnote"} 8
            %a{:href => "Science+of+Logic#DaseinUberhaupt"} SoL § 191
            is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/determinate+being"} determinate being
            as it corresponds to localization at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg\neg
            and the double negation creates the determinateness of the ‘Etwasse’.
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            the Aufhebungs-condition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♯
                  %mi ∅
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
            says equivalently that the
            %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                  %annotation{:encoding => "application/x-tex"} \sharp
            %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense subtopos
          %p
            This lowest essential subtopos arises more generally for categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            with
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathcal{A}\to \{*\}
            that map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mo ⊣
                  %mo ♯
                %annotation{:encoding => "application/x-tex"} \flat\dashv \sharp
            can be viewed as intended to provide a specific resolution of the ‘identity’
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0=1
            %a.existingWikiWord{:href => "/nlab/show/syntax"} syntactically
            corresponds to the inconsistent
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
          %p
            Following Lawvere’s suggestive terminology and identifying a level with its sheaf part, we could somewhat more loosely say that
            %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
            is the Aufhebung of the opposition between
            %a.existingWikiWord{:href => "/nlab/show/nothing"} nothing
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/being"} being
            = succeed "." do
              %em becoming is the Aufhebung of being
          %p
            The Aufhebungs relation expresses precisely that the (positive) sheaf part of the higher level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            subsumes (the opposition between) the skeleton and the sheaf part of the lower level in a universal way - it is the smallest context in which negative and positive poles of the lower level can positively coexist. To elaborate this intuition somewhat, it is the minimal way to turn the negative part into a positive part yet retaining the positivity of its positive opposite.
          %p
            For more on the relevant
            %em metaphysical
            modalities see at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
          %h4#ExamplesBecomingFormalization Over cohesive sites
          %p
            We discuss Aufhebung of
            %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
            in the above sense in
            %a.existingWikiWord{:href => "/nlab/show/cohesive+toposes"} cohesive toposes
            (
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-toposes"}> cohesive (∞,1)-toposes
            ) with a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
            (
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"}> ∞-cohesive site
            ) of definition.
          %p
            (More general discussion is now also in
            = succeed "," do
              %a{:href => "#LawvereMenni15"} Lawvere-Menni 15, lemma 4.1, 4.2
            = succeed "," do
              %a{:href => "#Shulman15"} Shulman 15, section 3
            = succeed ")." do
              %a{:href => "points-to-pieces+transform#RelationToAufhebung"} pieces-to-points-transform – Relation to Aufhebung
          #AufhebungOfBecomingMeansOnlyInitialObjectHasNoGlobalPoints.num_prop
            %h6#proposition Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} level of a topos
              given by an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo □
                      %mo ⊣
                      %mo ◯
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mo ♭
                      %mo ⊣
                      %mo ♯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Box\dashv \bigcirc) \coloneqq (\flat \dashv \sharp)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi ∅
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ♭
                      %mi X
                      %mo ≃
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ≃
                      %mi ∅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\flat X \simeq \emptyset) \Leftrightarrow (X \simeq \emptyset)
          .proof
            %h6#proof Proof
            %p
              In a topos the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict initial object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ≃
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo →
                      %mi ∅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \simeq \emptyset) \simeq (X \to \emptyset)
            %p
              In one direction, assuming
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi ∅
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ≃
                            %mi ∅
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo →
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo →
                            %mo ♯
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mtr
