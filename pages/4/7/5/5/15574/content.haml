                          %mtd
                            %mo ∨
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi ∅
                          %mtd
                            %mo ⊣
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id &amp; \dashv &amp; id
                    \\\
                    \\vee &amp;&amp; \vee
                    \\\
                    \\Re &amp;\dashv&amp; &amp;#643;_{inf} &amp;\dashv&amp; \flat_{inf}
                    \\\
                    \&amp;&amp; \vee &amp;&amp; \vee
                    \\\
                    \&amp;&amp; &amp;#643; &amp;\dashv&amp; \flat &amp;\dashv&amp; \sharp
                    \\\
                    \&amp;&amp; &amp;&amp; \vee &amp;\nearrow&amp; \vee
                    \\\
                    \&amp;&amp; &amp;&amp; \emptyset &amp;\dashv&amp; \ast
                    }
          %h3#absolute_identity_and_selbstaufhebung
            Absolute identity and
            %em Selbstaufhebung
          %p
            Given a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            the highest level is always given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            yielding the trivial
            %a.existingWikiWord{:href => "/nlab/show/adjoint+string"} adjoint string
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                  %mo ⊣
                  %msub
                    %mi id
                    %mi ℰ
                  %mo ⊣
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}\dashv id_\mathcal{E}\dashv id_\mathcal{E}
            with no less trivial adjoint modalities
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi ℰ
                    %mo ⊣
                    %msub
                      %mi id
                      %mi ℰ
                  %annotation{:encoding => "application/x-tex"} id_\mathcal{E}\dashv id_\mathcal{E}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %em resolves every other level
            and suggests to view the ascension from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                  %mo ⊣
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}\dashv id_\mathcal{E}
            as a process of increasing stepwise the number of objects that are sheaves as well as skeleta at a given level. The definition of resolution ensures that a level inherits the objects in the intersection from lower levels but also that all non-sheaves from the lower levels will be henceforth in the intersection.
          %p
            Note that though
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            resolves every level it need not be the Aufhebung of any strictly lower level. This situation occurs e.g. in the examples from combinatorial topology discussed
            = succeed ":" do
              %a{:href => "#SimplicialAndCubicalSets"} below
            = succeed "&rbrack;" do
              %a{:href => "#Roy97"} Roy (1997)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            is always its own Aufhebung and we see, incidentally, that a level might be the Aufhebung of more than one level, namely e.g. itself and perhaps several other levels - this might happen with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            when the lattice of levels is finite e.g. in the
            %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mo →
                %annotation{:encoding => "application/x-tex"} Set^{\to}
            (see
            = succeed ")." do
              %a{:href => "#SierpExample"} below
          %p
            Though
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            is trivial from a mathematical point of view, paradoxically it nevertheless captures on the philosophical side one of the most enigmatic concepts of the early
            %em identity philosophy
            of Hegel and Schelling, namely the
            %strong absolute
            as the identity of identity and non-identity:
          %blockquote
            %p
              Das Absolute selbst aber ist darum die Identität der Identität und der Nichtidentität; Entgegensetzen und Einssein ist zugleich in ihm. (Hegel
              = succeed "," do
                %a{:href => "#Diff"} 1801
          %p
            We might call a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            with the property that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            is the Aufhebung of no other level than itself
            %em absolute
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            the absolute level. Note that these toposes will occasionally have infinitely many levels and are then from the perspective of the mature Hegel vulnerable to the charge of being a
            = succeed "." do
              %em ‘bad infinity’
          %p
            The discussion so far might suggest that being self-sublating is a property peculiar to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            but this is not the case. In fact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} id_\mathcal{E}
            is only an instance of a whole class of essential localizations enjoying this property:
          #quintessentialloc.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a finitely complete category. An
              %a.existingWikiWord{:href => "/nlab/show/level"} essential localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ⊣
                    %mi r
                    %mo ⊣
                    %mi i
                    %mo :
                    %mi ℒ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} l\dashv r\dashv i:\mathcal{L}\to\mathcal{C}
              is called
              %strong quintessential
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              is naturally isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          %p
            To say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo ⊣
                  %mi r
                  %mo ⊣
                  %mi i
                  %mo :
                  %mi ℒ
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} l\dashv r\dashv i:\mathcal{L}\to\mathcal{C}
            is a quintessential localization amounts to say in Lawvere’s terminology (
            %a{:href => "#07"}> 2007
            ) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi ℒ
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} i:\mathcal{L}\to\mathcal{C}
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            as a
            %a.existingWikiWord{:href => "/nlab/show/quality+type"} quality type
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                %annotation{:encoding => "application/x-tex"} \mathcal{L}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            providing the right adjoint to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≃
                  %mi l
                %annotation{:encoding => "application/x-tex"} i\simeq l
            (provided
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            are
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive
          %p The following is immediate:
          #quintAuf.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ⊣
                    %mi r
                    %mo ⊣
                    %mi i
                    %mo :
                    %mi ℒ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} l\dashv r\dashv i:\mathcal{L}\to\mathcal{C}
              be a quintessential localization. Then the corresponding
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ⋅
                    %mi r
                    %mo ⊣
                    %mi i
                    %mo ⋅
                    %mi r
                  %annotation{:encoding => "application/x-tex"} l\cdot r\dashv i\cdot r
              coincides up to natural isomorphism and provides its own Aufhebung.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▪
                  %annotation{:encoding => "application/x-tex"} \qed
          .num_example
            %h6#example_3 Example
            %p
              A simple
              %em example
              of a non-trivial quintessential localization is given by the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with objects pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, e)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a set and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo =
                    %msup
                      %mi e
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e=e^2
              an idempotent map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X\to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:(X_1, e_1)\to (X_2, e_2)
              is a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f:X_1\to X_2
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %msub
                        %mi e
                        %mn 1
                      %mo =
                      %msub
                        %mi e
                        %mn 2
                      %mo ⋅
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f\cdot e_1=e_2\cdot f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} e_1(x)=x
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi e
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(e_1(x))=f(x)=e_2(f(x))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} r:\mathcal{C}\to Set
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} r(X, e)=\{x\in X | e(x)=x \}
              is left as well as right adjoint to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi id
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(X)=(X, id_X)
              since an equivariant morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi id
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:(X,e)\to (Y,id_Y)
              is uniquely determined by its restriction to the fixpoints of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              and its values are given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(e(x))
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ⋅
                    %mi r
                    %mo ⊣
                    %mi i
                    %mo ⋅
                    %mi r
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} i\cdot r\dashv i\cdot r:\mathcal{C}\to\mathcal{C}
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ⊣
                    %mi r
                    %mo ⊣
                    %mi i
                    %mo :
                    %mi Set
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} i\dashv r\dashv i:Set\to\mathcal{C}
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,e)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi id
                        %mrow
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (r(X),id_{r(X)})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊣
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
              as well as itself whereas
