                      %mo ↪
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} F_x \hookrightarrow Y
              %ol
                %li
                  %p
                    is
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
