                      %mn 2
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha_i \in H^\bullet(Y,R)\;,\;\;\;\; i \in \{1, 2, \cdots, n\}
              %p
                in the
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
          %p such that
          %ul
            %li
              %p
                for each point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                the restriction (
                %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
                along
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                      %annotation{:encoding => "application/x-tex"} \iota
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \alpha_i
                to the
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
