                            %mn 1
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "stable cohomotopy#StableCohomotopyIsAlgebraicKTheoryOverFieldWithOneElement"} Segal 74
                        %annotation{:encoding => "application/x-tex"} K \mathbb{F}_1 \overset{\text{&lt;a href="stable cohomotopy#StableCohomotopyIsAlgebraicKTheoryOverFieldWithOneElement"&gt;Segal 74&lt;/a&gt;}}{\simeq}
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+sphere+spectrum"} S
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                    %br/
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_G(\ast) \simeq A(G)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Segal-Carlsson+completion+theorem"} Segal-Carlsson completion theorem
                    %br/
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "https://ncatlab.org/nlab/show/Burnside+ring+is+equivariant+stable+cohomotopy+of+the+point"} Segal 71
                          %msub
                            %mi 𝕊
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ⟶
                            %mtext compl.
                          %mover
                            %mrow
                              %msub
                                %mi 𝕊
                                %mi G
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                            %mo ^
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "https://ncatlab.org/nlab/show/Segal-Carlsson+completion+theorem"} Carlsson 84
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mi 𝕊
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A(G) \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Burnside+ring+is+equivariant+stable+cohomotopy+of+the+point"&gt;Segal 71&lt;/a&gt;}}{\simeq}  \mathbb{S}_G(\ast)  \overset{ \text{compl.} }{\longrightarrow} \widehat {\mathbb{S}_G(\ast)} \!\! \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Segal-Carlsson+completion+theorem"&gt;Carlsson 84&lt;/a&gt;}}{\simeq} \!\!\!\!\!\! \mathbb{S}(B G)
                    %br/
          %p
            More explicitly, this means that the Burnside ring of a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is isomorphic to the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi V
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mi V
                  %mo ,
                  %msup
                    %mi S
                    %mi V
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi G
                %annotation{:encoding => "application/x-tex"}
                  A(G) \simeq \underset{\longrightarrow}{\lim}_V [S^V,S^V]_G
          %p
            over
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            in a complete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/G-universe"} G-universe
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            from the
            %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi V
                %annotation{:encoding => "application/x-tex"} S^V
            to itself (
            %a{:href => "#GreenleesMay95"}> Greenlees-May 95, p. 8
            ).
          %h3#as_the_endomorphism_ring_of_the_additive_burnside_category As the endomorphism ring of the additive Burnside category
          #BurnsideRingIsEndomorphismRingInBurnsideCategory.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                is
                %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/additive+Burnside+category"} additive Burnside category
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
              (the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              equipped with the, necessarily,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
              %a.existingWikiWord{:href => "/nlab/show/additive+Burnside+category"} additive Burnside category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mi Burn
                      %mi ad
                  %annotation{:encoding => "application/x-tex"} G Burn_{ad}
              is the
              %em Burnside ring
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(G)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi End
                      %mrow
                        %mi G
                        %msub
                          %mi Burn
                          %mi ad
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    End_{G Burn_{ad}}(\ast, \ast)
                    \\;\simeq\;
                    A(G)
                    \\,.
          %h3#relation_to_representation_ring Relation to representation ring
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A(G)
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
                of the
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} G Set
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R(G)
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
                of the monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Rep
                    %annotation{:encoding => "application/x-tex"} G Rep
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
          %p
            Then then map that sends a G-set to the corresponding linear
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            is a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %mi G
                  %mi Rep
                %annotation{:encoding => "application/x-tex"}
                  G Set \overset{\mathbb{C}[-]}{\longrightarrow} G Rep
          %p
            and hence induces a
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(G) \overset{ \mathbb{C}[-] }{\longrightarrow} R(G)
          %p Under the identitification
          %ol
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                with the
                %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
                of the point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi 𝕊
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      A(G) \;\simeq\; \mathbb{S}_G(\ast)
              %p
                (as
                = succeed ")" do
                  %a{:href => "#AsTheEquivariantStableCohomotopyOfThePoint"} above
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
                with the
                %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
                of the point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi K
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      R(G) \;\simeq\; K_G(\ast)
              %p
                (see
                = succeed ")" do
                  %a{:href => "representation+ring#AsEquivariantKTheoryOfThePoint"} there
          %p
            this should be the image of the initial morphism of
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring+spectra"} E-infinity ring spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mo ⟶
                  %mi KU
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S} \longrightarrow KU
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %p
            For details on this comparison map see at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            = succeed "." do
              %a{:href => "permutation+representation#ExamplesVirtualPermutationRepresentations"} this section
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Segal+conjecture"} Segal conjecture
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/beta-ring"} beta-ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objective+number+theory"} objective number theory
          %h2#References References
          %p The Burnside product seems to first appear as equation (i) in:
          %ul
            %li#Burnside01
              %a.existingWikiWord{:href => "/nlab/show/William+Burnside"}> William Burnside
              ,
              = succeed "," do
                %em On the Representation of a Group of Finite Order as a Permutation Group, and on the Composition of Permutation Groups
              = succeed ")" do
                %a{:href => "https://doi.org/10.1112/plms/s1-34.1.159"} doi:10.1112/plms/s1-34.1.159
          %p
            (beware the terminology: a
            %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
            is called a “permutation group
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            is called a “compound” and the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p It is then included (not in the first but) in the second edition (Sections 184-185) of:
          %ul
            %li#Burnside1897
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Burnside"}> William Burnside
                ,
                = succeed "," do
                  %em Theory of Groups of Finite Order
                = succeed ")" do
                  %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/burnside1911.pdf"} pdf
              %p
                reprinted by Cambridge University Press 2012 (
                %a{:href => "https://doi.org/10.1017/CBO9781139237253"}> doi:10.1017/CBO9781139237253
                )
          %p
            The term “Burnside ring” as well as “Burnside algebra” is then due to (see
            %a{:href => "William+Burnside#NMT04"} NMT 04, Vol. 1 p. 60
            for historical comments)
          %ul
            %li#Solomon67
              %a.existingWikiWord{:href => "/nlab/show/Louis+Solomon"}> Louis Solomon
              ,
              = succeed "," do
                %em The Burnside algebra of a finite group
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/S0021-9800(67)80064-4"} doi:10.1016/S0021-9800(67)80064-4
          %p Modern textbook accounts and lecture notes:
          %ul
            %li
              %p
                Charles Curtis, Irving Reiner, chapter XI of
                = succeed "," do
                  %em Representation theory of finite groups and associative algebras
            %li#tomDieck79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Transformation+Groups+and+Representation+Theory"} Transformation Groups and Representation Theory
            %li#tomDieck87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                , Chapter IV of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Transformation+Groups"} Transformation Groups
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/9783110858372"} doi:10.1515/9783110858372
            %li#Bouc00
              %p
                Serge Bouc,
                = succeed "," do
                  %em Burnside rings
                %em Handbook of Algebra
                Volume 2, 2000, Pages 739-804 (
                %a{:href => "https://doi.org/10.1016/S1570-7954(00)80043-1"}> doi:10.1016/S1570-7954(00)80043-1
                )
            %li#tomDieck09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "," do
                  %em Representation theory
                = succeed ")" do
                  %a{:href => "http://www.uni-math.gwdg.de/tammo/rep.pdf"} pdf
            %li#Schwede15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                , section 6 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Lectures+on+Equivariant+Stable+Homotopy+Theory"} Lectures on Equivariant Stable Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.uni-bonn.de/people/schwede/equivariant.pdf"} pdf
          %p See also
          %ul
            %li#GreenleesMay95
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Equivariant stable homotopy theory
                %em Handbook of Algebraic Topology
                , pp. 279-325. 1995. (
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/Newthird.pdf"}> pdf
                )
            %li#Schanuel91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Schanuel"}> Stephen Schanuel
                , 1991,
                = succeed "," do
                  %em Negative sets have Euler characteristic and dimension
          %p
            Discussion in relation to
            %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Segal-Carlsson+completion+theorem"} Segal-Carlsson completion theorem
          %ul
            %li#Segal71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em Equivariant stable homotopy theory
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/SegalEquivariantStableHomotopyTheory.pdf", :title => "pdf"} pdf
            %li#Segal78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                , p. -2- of:
                %em Some results in equivariant homotopy theory
                (1978) &amp;lbrack;scan:
