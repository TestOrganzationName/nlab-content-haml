              (
              %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curves"}> derived elliptic curves
              ):
            %ul
              %li#GoerssHopkinsA
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                  = succeed "," do
                    %em Moduli spaces of commutative ring spectra
                  = succeed "," do
                    %em Structured ring spectra
                %p
                  Math. Soc. Lecture Note Ser., vol. 315, Cambridge Univ. Press, Cambridge, 2004, pp. 151-200. (
                  %a{:href => "http://www.math.northwestern.edu/~pgoerss/papers/sum.pdf"}> pdf
                  ,
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1017/CBO9780511529955.009"} doi:10.1017/CBO9780511529955.009
              %li#GoerssHopkinsB
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
