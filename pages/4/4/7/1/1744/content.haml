          %h3#Truncation Truncation and Postnikov towers
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of the adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \mathbf{cosk}_n(X)
            %p
              induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on all
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \lt n
          %p
            It follows from the above that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %munder
                    %mi lim
                    %mo ←
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi cosk
                    %mi n
                  %mi X
                  %mo →
                  %mi ⋯
                  %mo →
                  %msub
                    %mi cosk
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi X
                  %mo →
                  %msub
                    %mi cosk
                    %mi n
                  %mi X
                  %mo →
                  %mi ⋯
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  X = \underset{\leftarrow}{\lim}\; cosk_n X \to \cdots \to cosk_{n+1} X \to cosk_{n} X \to \cdots \to *
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            See also the discussion in
            = succeed "." do
              %a{:href => "#DwyerKan84"} Dwyer &amp; Kan 1984, p. 140, 141
          %p
            For the interpretation of this in terms of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            see
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28%E2%88%9E%2C1%29-category"} n-truncated object in an (∞,1)-category
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/n-truncated+object+of+an+(infinity%2C1)-category#InInfGrpd"} In ∞Grpd and Top
          %h2#Examples Examples
          %p
          #CoskeletalityOfSimplicialNervesOfCategories.num_remark
            %h6 Example
            %p
              %strong (coskeletality of simplicial nerves of categories)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (i.e. of a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              (
              %a{:href => "nerve#NerveOfACategoryIsTwoCoskeletal"}> this Prop.
              ): The unique filler of the
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"}
                boundary of an
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} n \geq 3
              encodes the
              = succeed "-condition" do
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-tuples
              of composable morphisms.
            %p
              Of course there is more to a category than its associativity condition, and hence the converse fails: Not every
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nerve+of+a+category"} nerve of a category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of the 2-simplex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \partial \Delta^2
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of the edges
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 0 \to 1 \to 2
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+horn"} inner horn
            %p
              In fact, a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              iff it has
              %em unique
              = succeed "-fillers" do
                %a.existingWikiWord{:href => "/nlab/show/inner+horn"}
                  inner
                  = succeed "-horn" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              (e.g.
              = succeed ")." do
                %a{:href => "nerve#sSetIsNerveOfCategoryIffAllInnerHornsHaveUniqueFillers"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletality
              already implies that all
              = succeed "-horns" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} k \geq 4
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k-1
              = succeed ")-cell." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              iff
            %ol
              %li
                %p
                  it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %li
                %p
                  all
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/inner+horn"} inner
                  2- and 3-
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  have unique fillers (encoding
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  and
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            %p
              Similarly for
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              (by
              = succeed "):" do
                %a{:href => "nerve#sSetIsNerveOfGroupoidIffAllHornsHaveUniqueFillers"} this Prop.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              iff
            %ol
              %li
                %p
                  it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %li
                %p
                  all 2- and 3-
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  have unique fillers.
            %p
              For better or worse, such a simplicial set has at times also been called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/1-hypergroupoid"} 1-hypergroupoid
              = succeed "-coskeletal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              with unique horn fillers as models for
              %a.existingWikiWord{:href => "/nlab/show/n-groupoids"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-groupoids
            %p
              Notice that a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              which is
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              but with possibly non-unique 2-horn fillers is still a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
              and may still be called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              in the sense of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/bigroupoid"} bigroupoid
              (2-
              %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"}> hypergroupoid
              ) which happens to be just a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
          %p Accordingly, essentially by definition:
          %ul
            %li
              A
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              that is
              = succeed "-coskeletal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of) an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-groupoid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-groupoid
          %p Also:
          %ul
            %li
              A 0-coskeletal simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is (-1)-
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              and hence either empty or a
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              ,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \stackrel{\simeq}{\to} *
              that is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X = N(C)
              of a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that has a
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} C \simeq *
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"}> Postnikov tower
                ,
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg+subcomplex"} Eilenberg subcomplex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"} hypergroupoid
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , Section II.8 of:
                = succeed "," do
                  %em Simplicial objects in algebraic topology
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/Simp.djvu"} djvu
                = succeed ")" do
                  %a{:href => "https://press.uchicago.edu/ucp/books/book/chicago/S/bo5956688.html"} ISBN:9780226511818
            %li#DwyerKan84
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"} Dan Kan
                = succeed "," do
                  %em An obstruction theory for diagrams of simplicial sets
                %strong 87
                2 (1984) 139-146 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/1385-7258(84)90015-5"}> doi:10.1016/1385-7258(84)90015-5
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"} J. F. Jardine
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-3-0346-0189-4"} doi:10.1007/978-3-0346-0189-4
          %p Also:
          %ul
            %li#Low13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Lin"}> Zhen Lin
                ,
                %a{:href => "http://math.stackexchange.com/a/597990/58526"} Math.SE:a/597990
            %li#Deflorin19
              %p
                Gian Deflorin, Section 10.2 of:
                = succeed "," do
                  %em The Homotopy Hypothesis
                = succeed "," do
                  %a{:href => "http://user.math.uzh.ch/cattaneo/deflorin.pdf"} 2019
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Deflorin_HomotopyHypothesis.pdf", :title => "pdf"} pdf
          %p
            The
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} level of a topos
          %ul
            %li#KRRZ10
              C. Kennett,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} E. Riehl
              %em Levels in the toposes of simplicial sets and cubical sets
              , JPAA
              %strong 215
              no.5 (2011) pp.949-961. (
              %a{:href => "http://arxiv.org/abs/1003.5944"}> arXiv:1003.5944
              )
