                    %annotation{:encoding => "application/x-tex"} y = (p,u) \in \Sigma \times X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msubsup
                      %mi T
                      %mi y
                      %mo *
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi Λ
