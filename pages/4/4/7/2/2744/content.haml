                        %mi T
                        %mo *
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \vol \in \Gamma(\Lambda^{n+1}T^\ast \Sigma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msup
                      %mi q
                      %mrow
                        %mi n
