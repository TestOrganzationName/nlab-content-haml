                    \\wedge
                    \\mathbf{d}q^{i+1}
                    \\wedge \cdots \wedge \mathbf{d}q^{n+1} \wedge \mathbf{d}u^a
                    \\,.
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi u
                      %mo{:stretchy => "false"} )
