                          %mn 1
                      %msubsup
                        %mi T
                        %mi p
                        %mo *
                      %mi Σ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi Λ
                        %mi n
                      %msubsup
                        %mi T
                        %mi p
