                            %mi i
                          %mo ∧
                          %msubsup
                            %mi dq
                            %mi i
                            %mi a
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathbf{d}u^a
                  \\wedge
                  \\iota_{\partial_i}
                  \\left(
                  \\frac{\partial}{\partial \phi^a_{,i}}L
                  \\right)
                  \&amp; =
                  p^i_a \wedge (\iota_{\partial_{\sigma^i}} vol) \wedge \mathbf{d}u^a
                  \\\
                  \&amp; =  p^i_a \wedge dq_i^a
                  \\,,
                  \\end{aligned}
          %p
            where in the last line we adopted the notation of remark
            = succeed "." do
              %a.maruku-ref{:href => "#CanonicalFormInGoodCoordinates"}
          %p
            This shows that the canonical
            %a.existingWikiWord{:href => "/nlab/show/multisymplectic+form"} multisymplectic form
            is the “covariant symplectic potential current density” which is induced by the free field Lagrangian.
          %p
            See also (
            %a{:href => "#ForgerRomero04"}> Forger Romero 04, section 3.2
            ).
          %h4#bosonic_particle_propagating_on_a_manifold Bosonic particle propagating on a manifold
          %blockquote
            %p scratch
          %p
            Ordinary point
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            %a.existingWikiWord{:href => "/nlab/show/mechanics"} mechanics
            on a
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
