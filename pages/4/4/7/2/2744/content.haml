                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda^{n+1}_1 T^*_y E
                    \\;\; \simeq\;\;
                    \\left(\Lambda^{n+1} T^*_p \Sigma \right)
                    \\; \oplus \;
                    \\left(\Lambda^{n} T^*_p \Sigma \otimes T^*_u X \right)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              also determines isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi Λ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msubsup
                      %mi T
                      %mi p
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} \overset{\simeq}{\longrightarrow}
                    \\Lambda^{n+1} T^*_p \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mi c
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                      %mi p
                  %annotation{:encoding => "application/x-tex"}
                    c \mapsto  c \, \vol_p
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi Σ
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi Λ
                      %mi n
                    %msubsup
                      %mi T
                      %mi p
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    T_p \Sigma   \overset{\simeq}{\longrightarrow}  \Lambda^{n} T^*_p \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ↦
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v      \mapsto     \iota_v \vol_p
                    \\,.
            %p We thus have obtained an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msubsup
                      %mi T
                      %mi y
                      %mo *
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi p
                    %mi Σ
                    %mo ⊗
                    %msubsup
                      %mi T
                      %mi u
                      %mo *
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda^{n+1}_1 T^*_y E \;\; \cong \;\; \mathbb{R} \; \oplus \;
                    T_p \Sigma \otimes T^*_u X
                    \\,.
            %p
              On the other hand, the trivialization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Σ
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E = \Sigma \times X
              gives an isomorphism of
              %a.existingWikiWord{:href => "/nlab/show/affine+spaces"} affine spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi y
                      %mn 1
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi T
                      %mi p
                      %mo *
                    %mi Σ
                    %mo ⊗
                    %msub
                      %mi T
                      %mi u
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    J^1_y E \; \; \cong \; \; T^*_p \Sigma \otimes T_u X
            %p
              which has the side-effect of exhibiting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi y
                      %mn 1
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^1_y E
              the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msubsup
                      %mi T
                      %mi p
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Lambda^{n+1} T^*_p \Sigma
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi y
                      %mn 1
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^1_y E
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msubsup
                      %mi T
                      %mi p
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Lambda^{n+1} T^*_p \Sigma
              is just an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %mi Σ
                    %mo ⊗
                    %msubsup
                      %mi T
                      %mi u
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_x \Sigma \otimes T^*_u X
              plus a constant. So, we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi y
                      %mn 1
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi p
                    %mi Σ
                    %mo ⊗
                    %msubsup
                      %mi T
                      %mi u
                      %mo *
                    %mi X
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (J^1_y E)^* \; \; \cong \; \; \mathbb{R} \; \oplus \;
                    T_p \Sigma \otimes T^*_u X .
            %p
              This gives a specific vector bundle isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi J
                        %mn 1
                      %mi E
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ≅
                      %msubsup
                        %mi Λ
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msup
                        %mi T
                        %mo *
                      %mi E
                    %annotation{:encoding => "application/x-tex"} (J^1 E)^* \cong \Lambda_1^{n+1} T^* E
          #CanonicalFormInGoodCoordinates.num_remark
            %h6#remark_4 Remark
            %p
              In practice it is better to use the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mo *
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                  %annotation{:encoding => "application/x-tex"} \pi^* \vol
              as a substitute for the coordinate-dependent
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi q
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi q
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}q^1 \wedge \cdots \wedge \mathbf{d}q^{n+1}
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              of sections of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Λ
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msup
                        %mi T
                        %mo *
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \Lambda_1^{n+1} T^* E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dQ
                    %mo ≔
                    %msup
                      %mi π
                      %mo *
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                  %annotation{:encoding => "application/x-tex"}
                    dQ \coloneqq \pi^* \vol
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi dQ
                      %mi i
                      %mi a
                    %mo ≔
                    %mrow
                      %mo (
                      %msup
                        %mi π
                        %mo *
                      %msub
                        %mi ι
                        %mrow
                          %mo ∂
                          %mo{:stretchy => "false"} /
                          %mo ∂
                          %msup
                            %mi q
                            %mi i
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                      %mo )
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi u
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dQ_i^a
                    \\coloneqq
                    \\left(\pi^* \iota_{\partial/\partial q^i} \vol\right)
                    \\wedge
                    \\mathbf{d}u^a
                    \\,.
            %p
              Corresponding to this
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              then there are local
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi P
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} P^i_a
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Λ
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msup
                        %mi T
                        %mo *
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \Lambda_1^{n+1} T^* E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} q^i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mi a
                  %annotation{:encoding => "application/x-tex"} u^a
              pulled back from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              give a local coordinate system on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Λ
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msup
                        %mi T
                        %mo *
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \Lambda_1^{n+1} T^* E
            %p
              In these
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              the canonical
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn 1
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ≅
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msup
                      %mi T
                      %mo *
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (J^1 E)^* \cong \Lambda_1^{n+1} T^* E
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mi P
                    %mo ∧
                    %mi dQ
                    %mo +
                    %msubsup
                      %mi P
                      %mi a
                      %mi i
                    %mo ∧
                    %msubsup
                      %mi dQ
                      %mi i
                      %mi a
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha = P \wedge dQ + P^i_a \wedge dQ_i^a,
            %p
              and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n+2
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+form"} multisymplectic form
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi P
                    %mo ∧
                    %mi dQ
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msubsup
                      %mi P
                      %mi a
                      %mi i
                    %mo ∧
                    %msubsup
                      %mi dQ
                      %mi i
                      %mi a
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = \mathbf{d}P \wedge dQ + \mathbf{d}P^i_a \wedge dQ_i^a.
          %h3#DonderWeylHamiltonFieldEquations De Donder-Weyl-Hamilton field equations
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations+of+motion"} Euler-Lagrange equations of motion
            of a
            %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local field theory
            expressed in multisymplectic geoemtry via
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+formalism"} de Donder-Weyl formalism
          #LocalLagrangian.num_defn
            %h6#definition_6 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \to \Sigma
              as above, a (first order)
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi J
                      %mn 1
                    %mi E
                    %mo ⟶
                    %msup
                      %mo ∧
                      %mi n
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} \;\colon\; J^1 E \longrightarrow \wedge^n T^\ast \Sigma
            %p
              on the first
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with values in
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/densities"} densities
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/volume+forms"} volume forms
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,0)
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
              grading.
          #LegendreTransform.num_defn
            %h6#definition_7 Definition
            %p
              Given a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
              = succeed "," do
                %a.maruku-ref{:href => "#LocalLagrangian"}
              %strong
                local
                %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
              is the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi J
                      %mn 1
                    %mi E
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn 1
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{F}\mathbf{L} \;\colon\;
                    J^1 E \longrightarrow (J^1 E)^\ast
            %p
              from first
              %a.existingWikiWord{:href => "/nlab/show/jets"} jets
              to the affine dual jet bundle, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DualFirstJetBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              to its first-order
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
          %p
            This definition was proposed in (
            %a{:href => "#ForgerRomero04"}> Forger-Romero 04, section 2.5
            ).
          #LegendreTransformInLocalCoordinates.num_prop
            %h6#proposition_2 Proposition
            %p
              In terms of the local
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              of remark
              %a.maruku-ref{:href => "#CanonicalFormInGoodCoordinates"}
              the Legendre transform of def.
              %a.maruku-ref{:href => "#LegendreTransform"}
              is the function with
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi P
                      %mi a
                      %mi i
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi q
                          %mrow
                            %mo ,
                            %mi i
                          %mi a
                  %annotation{:encoding => "application/x-tex"}
                    P^i_a = \frac{\partial \mathbf{L}}{\partial q^a_{, i}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo −
                    %mfrac
                      %mrow
                        %mo ∂
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi q
                          %mrow
                            %mo ,
                            %mi i
                          %mi a
                    %msubsup
                      %mi q
                      %mrow
                        %mo ,
                        %mi i
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P = \mathbf{L} - \frac{\partial \mathbf{L}}{\partial q^a_{,i}}q^a_{,i}
                    \\,.
          %p
            (
            %a{:href => "#ForgerRomero04"}> Forger-Romero 04, section 2.5 (41)
            ).
          .num_remark
            %h6#remark_5 Remark
            %p
              The second term in prop.
              %a.maruku-ref{:href => "#LegendreTransformInLocalCoordinates"}
              is what is traditionally called the Legendre transform in multisymplectic geometry/
              %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+formalism"}> de Donder-Weyl formalism
              \. Def.
              %a.maruku-ref{:href => "#LegendreTransform"}
              may be regarded as explaining the conceptual role of this expression, in particular in view of the following proposition.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                  %annotation{:encoding => "application/x-tex"} \omega_{\mathbf{L}}
              of the canonical
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+form"} pre-n-plectic form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              = succeed "," do
                %a.maruku-ref{:href => "#ExtendedCovariantPhaseSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔽
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}\mathbf{L}
              = succeed "," do
                %a.maruku-ref{:href => "#LegendreTransform"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              is the sum of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                  %annotation{:encoding => "application/x-tex"} EL_{\mathbf{L}}
              and the canonical symplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi v
                    %msub
                      %mi θ
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}_v \theta_{\mathbf{L}}
              from
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              formalism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ω
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                          %mtd
                            %mo ≔
                            %mi 𝔽
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %mo *
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi EL
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                            %mo +
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                              %mi v
                            %msub
                              %mi θ
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega_{\mathbf{L}}
                    \&amp; \coloneqq
                    \\mathbb{F}\mathbf{L}^\ast \omega
                    \\\
                    \&amp; =
                    EL_{\mathbf{L}} + \mathbf{d}_v \theta_{\mathbf{L}}
                    \\end{aligned}
                    \\,.
            %p It follows that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi v
                              %mi n
                        %mi ⋯
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi v
                              %mn 1
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi ω
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} (\iota_{v_n} \cdots \iota_{v_1})  \omega_{\mathbf{L}} = 0
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation+of+motion"} Euler-Lagrange equation of motion
                  in
                  = succeed "-form;" do
                    %a.existingWikiWord{:href => "/nlab/show/de+Donder-Weyl+formalism"} de Donder-Weyl-Hamilton
              %li
                %p
                  for any
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Σ
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \Sigma_{n-1}
                  %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mi Σ
                        %mo ≔
                        %msub
                          %mo ∫
                          %mrow
                            %msub
                              %mi Σ
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %msub
                          %mi ω
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                      %annotation{:encoding => "application/x-tex"} \omega_\Sigma \coloneqq \int_{\Sigma_{n-1}}\omega_{\mathbf{L}}
                  is the canonical pre-symplectic form on
                  %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
                  (as discussed there).
          %p
            This statement is essentially the content of (
            %a{:href => "#ForgerRomero04"}> Forger-Romero 04, equation (54) and theorem 1
            ). In the above form in terms of
            %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
            notions this statement has been amplified by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Igor+Khavkine"} Igor Khavkine
          %h3#examples Examples
          %h4#FreeFieldTheory Free field theory
          %p
            We write out the multisymplectic geometry corresponding to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ;
                      %mn 1
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma = (\mathbb{R}^{d-1;1}, \eta)
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi σ
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Σ
                  %mo ⟶
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sigma^i \;\colon\; \Sigma \longrightarrow \mathbb{R}
                  \\,.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %msup
                    %mi ℝ
                    %mi k
                %annotation{:encoding => "application/x-tex"} X \simeq \mathbb{R}^k
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi^a \;\colon\; X \longrightarrow \mathbb{R}
                  \\,.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Σ
                  %mo →
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} X \times \Sigma \to \Sigma
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            then has canonical coordinates
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi σ
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ϕ
                    %mi a
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi ϕ
                    %mrow
                      %mo ,
                      %mi i
                    %mi a
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi j
                    %mn ∞
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{ \sigma^i \}, \{\phi^a\}, \{\phi^a_{,i}\} \;\colon\; j_\infty^1(\Sigma \times X) \longrightarrow X
                  \\,.
          .num_defn
            %h6#definition_8 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
              for
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              with this
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≔
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mi η
                        %mrow
                          %mi a
                          %mi b
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi i
                        %mi a
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi j
                        %mi a
                      %mo )
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi σ
                      %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\coloneqq
                    \\left(
                    \\frac{1}{2} g^{i j} \eta_{a b} \phi^a_{,i} \phi^a_{,j}
                    \\right)
                    \\wedge
                    \\mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^d
                    \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi p
                            %mi a
                            %mi i
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mn 1
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mi d
                        %mtd
                          %mo ≔
                          %mfrac
                            %mo ∂
                            %mrow
                              %mo ∂
                              %msubsup
                                %mi u
                                %mi i
                                %mi a
                          %mi L
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mrow
                            %mo (
                            %msup
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %msub
                              %mi η
                              %mrow
                                %mi a
                                %mi b
                            %msubsup
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi j
                              %mi a
                            %mo )
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mn 1
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi σ
                            %mi d
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  p_a^i \wedge \mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^d
                  \&amp; \coloneqq
                  \\frac{\partial}{\partial u^a_i} L
                  \\\
                  \&amp; =
                  \\left(
                  g^{i j} \eta_{a b} \phi^a_{,j}
                  \\right)
                  \\wedge
                  \\mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^d
                  \\end{aligned}
          %p
            So the boundary term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            %a{:href => "covariant+phase+space#CanonicalThetaDensityInLocalCoordinates"} this remark
            at
            %em
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            ) is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi u
                            %mi a
                          %mo ∧
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mo ∂
                                %mi i
                          %mrow
                            %mo (
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mi i
                                  %mi a
                            %mi L
                            %mo )
                        %mtd
                          %mo =
                          %msubsup
                            %mi p
                            %mi a
                            %mi i
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mo ∂
                                %mrow
                                  %msup
                                    %mi σ
                                    %mi i
                          %mi vol
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi u
                            %mi a
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msubsup
                            %mi p
