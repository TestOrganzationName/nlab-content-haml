                    %mo ⊣
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi 𝒞
                      %mover
                        %mo ⟵
                        %mi ℒ
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{L} \dashv \mathcal{C})
                    \\;\colon\;
                    dgLieAlg_k
                    \\underoverset
                    {\underset{\mathcal{C}}{\longrightarrow}}
                    {\overset{\mathcal{L}}{\longleftarrow}}
                    {\bot}
                    dgCoCAlg_k
            %p
              between the category of
              = succeed "and" do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocommutative+coalgebras"} cocommutative coalgebras
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              sends a dg-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔤
                      %mo •
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{g}_\bullet, [-,-])
              to its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg coalgebra
              %a.existingWikiWord{:href => "/nlab/show/free+graded+co-commutative+coalgebra"} free graded co-commutative coalgebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}[1]
              and whose differential is given on the tensor product of two generators by the Lie bracket
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
          %p
            For (pointers to) the details, see at
            = succeed "." do
              %em
                %a{:href => "model%20structure%20on%20dg-Lie%20algebras#RelationToDgCoalgebras"} model structure on dg-Lie algebras – Relation to dg-coalgebras
          .num_theorem
            %h6#theorem Theorem
            %p
              There exists a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} dgCoCAlg_k
              for which
            %ul
              %li
                %p
                  the cofibrations are the (degreewise)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/injections"} injections
              %li
                %p
                  the weak equivalences are those morphisms that become
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
                  under the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℒ
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}
                  from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#TheCETangentAdjunction"}
            %p
              Moreover, this is naturally a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              structure.
          %p
            This is (
            %a{:href => "#Hinich98"}> Hinich98, theorem, 3.1
            ). More details on this are in the relevant sections at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-infinity+algebras"} model structure for L-infinity algebras
          %h2#properties Properties
          %h3#RelationTodgLieAlgbras Relation to dg-Lie algebras
          %p
            Throughout, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
          #CEfunctor.num_defn
            %h6#definition_2 Definition
            %p
              %strong (Chevalley-Eilenberg dg-coalgebra)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mo ⟶
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    CE
                    \\;\colon\;
                    dgLieAlg_{k}
                    \\longrightarrow
                    dgCoCAlg_k
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              functor. It sends a dg-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mo ∂
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, \partial, [-,-])
              to the
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mo ∂
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mo ∨
                        %mo •
                      %mi 𝔤
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi D
                      %mo =
                      %mo ∂
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g},\partial,[-,-])
                    \\;\coloneqq\;
                    \\left(
                    \\vee^\bullet \mathfrak{g}[1]
                    ,\;
                    D = \partial + [-,-]
                    \\right)
                    \\,,
            %p
              where on the right the extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              to graded
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
              is understood.
          %p
            For dg-Lie algebras concentrated in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \geq n \geq 1
            this is due to (
            %a{:href => "#Quillen"}> Quillen 69, appendix B, prop 6.2
            ). For unbounded dg-algebras, this is due to (
            %a{:href => "#Hinich98"}> Hinich 98, 2.2.2
            ).
          #LeftAdjointToCEfunctor.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (X,D) \in dgCoCAlg_k
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi X
                        %mo ¯
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mo ∂
                      %mo ≔
                      %mi D
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo −
                      %mn 1
                      %mo ⊗
                      %mi id
                      %mo −
                      %mi id
                      %mo ⊗
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}(X,D)
                    \\coloneqq
                    \\left(
                    F(\overline{X}[-1]),\;
                    \\partial \coloneqq D + (\Delta - 1 \otimes id - id \otimes 1)
                    \\right)
                    \\;\in dgLieAlg_k\;
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo ¯
                        %mo ≔
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \overline{X} \coloneqq ker(\epsilon)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/counit"} counit
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/free+Lie+algebra"} free Lie algebra
                  functor (as graded Lie algebras);
              %li
                %p
                  on the right we are extending
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo −
                        %mn 1
                        %mo ⊗
                        %mi id
                        %mo −
                        %mi id
                        %mo ⊗
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mover
                          %mi X
                          %mo ¯
                        %mo →
                        %mover
                          %mi X
                          %mo ¯
                        %mo ⊗
                        %mover
                          %mi X
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} (\Delta - 1 \otimes id - id \otimes 1) \colon \overline{X} \to \overline{X} \otimes \overline{X}
                  as a Lie algebra
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
          %p
            For dg-Lie algebras concentrated in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \geq n \geq 1
            this is due to (
            %a{:href => "#Quillen"}> Quillen 69, appendix B, prop 6.1
            ). For unbounded dg-algebras, this is due to (
            %a{:href => "#Hinich98"}> Hinich 98, 2.2.1
            ).
          #CEAdjunction.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              from def.
              %a.maruku-ref{:href => "#CEfunctor"}
              and def.
              %a.maruku-ref{:href => "#LeftAdjointToCEfunctor"}
              are
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
              to each other:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi CE
                      %mover
                        %mo ⟵
                        %mi ℒ
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dgLieAlg_k
                    \\underoverset
                    {\underset{CE}{\longrightarrow}}
                    {\overset{\mathcal{L}}{\longleftarrow}}
                    {\bot}
                    dgCoCAlg_k
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} X \in dgCoCAlg_k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ∈
                    %msub
                      %mi dgLieAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \in dgLieAlg_k
              then the adjoint
              %a.existingWikiWord{:href => "/nlab/show/hom+sets"} hom sets
              are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℒ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi MC
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo ¯
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathcal{L}(X), \mathfrak{g})
                    \\simeq
                    Hom(X, CE(\mathfrak{g}))
                    \\simeq
                    MC(Hom(\overline{X},\mathfrak{g}))
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+elements"} Maurer-Cartan elements
              in the Hom-dgLie algebra from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{X}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            For dg-Lie algebras concentrated in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \geq n \geq 1
            this is due to (
            %a{:href => "#Quillen"}> Quillen 69, appendix B, somewhere
            ). For unbounded dg-algebras, this is due to (
            %a{:href => "#Hinich98"}> Hinich 98, 2.2.5
            ).
          #QuillenAdjunctionCE.num_prop
            %h6#proposition_3 Proposition
            %p
              The adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℒ
                    %mo ⊣
                    %mi CE
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{L} \dashv CE)
              from prop.
              %a.maruku-ref{:href => "#CEAdjunction"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              between then projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
              as the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-coalgebras"} model structure on dg-coalgebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi CE
                      %mover
                        %mo ⟵
                        %mi ℒ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (dgLieAlg_k)_{proj}
                    \\underoverset
                    {\underset{CE}{\longrightarrow}}
                    {\overset{\mathcal{L}}{\longleftarrow}}
                    {\bot}
                    (dgCoCAlg_k)_{Quillen}
                    \\,.
          %p
            (
            %a{:href => "#Hinich98"}> Hinich 98, lemma 5.2.2, lemma 5.2.3
            )
          %p Moreover:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              In non-negatively graded dg-coalgebras, both
              %a.existingWikiWord{:href => "/nlab/show/Quillen+functors"} Quillen functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℒ
                    %mo ⊣
                    %mi CE
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{L} \dashv CE)
              from prop.
              %a.maruku-ref{:href => "#QuillenAdjunctionCE"}
              preserve all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              and the
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              are quasi-isomorphisms.
          %p
            For dg-algebras in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \geq n \geq 1
            this is (
            %a{:href => "#Quillen76"}> Quillen 76, theorem 7.5
            ). In unbounded degrees this is (
            %a{:href => "#Hinich98"}> Hinich 98, prop. 3.3.2
            )
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The Quillen adjunctin from prop.
              %a.maruku-ref{:href => "#QuillenAdjunctionCE"}
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi qu
                        %msub
                          %mo ≃
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mi CE
                      %mover
                        %mo ⟵
                        %mi ℒ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (dgLieAlg_k)_{proj}
                    \\underoverset
                    {\underset{CE}{\longrightarrow}}
                    {\overset{\mathcal{L}}{\longleftarrow}}
                    {{}_{\phantom{qu}}\simeq_{Qu}}
                    (dgCoCAlg_k)_{Quillen}
                    \\,.
          %p
            (
            %a{:href => "#Hinich98"}> Hinich 98, theorem 3.2
            ) using (
            %a{:href => "#Quillen76"}> Quillen 76 II 1.4
            )
