                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
              super-geometry
            is simply the
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+geometry"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
              \-geometry
            over
            %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/periodic+ring+spectra"} periodic ring spectra
          %h2#examples Examples
          %h3#SpectralSuperpoint Spectral superpoint
          %p
            The ordinary
            %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            over some
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the
            %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} spectrum of a commutative ring
            of the graded
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
            on a single odd generator (“graded
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔸
                    %mi k
                    %mrow
                      %mn 0
                      %mo{:stretchy => "false"} |
                      %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi Sym
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{A}_k^{0 \vert 1}
                  \\;\simeq\;
                  Spec( \,Sym_k (k[1])\, )
          %p
            Accordingly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            an
            %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/periodic+ring+spectrum"} periodic ring spectrum
            %em spectral superpoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mrow
                      %mn 0
                      %mo{:stretchy => "false"} |
                      %mn 1
                %annotation{:encoding => "application/x-tex"} R^{0 \vert 1}
            should be the
            %a.existingWikiWord{:href => "/nlab/show/spectral+scheme"} spectral scheme
            given by the
            %a.existingWikiWord{:href => "/nlab/show/spectral+symmetric+algebra"} spectral symmetric algebra
            on the
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi R
                            %mrow
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mn 1
                        %mtd
                          %mo ≔
                          %mi Spec
                          %mrow
                            %mo (
                            %msub
                              %mi Sym
                              %mi R
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi Spec
                          %mrow
                            %mo (
                            %mi R
                            %mo ∧
                            %msub
                              %mrow
                                %mo (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi n
                                    %mo ∈
                                    %mi ℕ
                                %mi B
                                %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi n
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %msub
                                      %mi τ
                                      %mi n
                                %mo )
                              %mo +
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi Spec
                          %mrow
                            %mo (
                            %mi R
                            %mo ∧
                            %msub
                              %mi Sym
                              %mi 𝕊
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  R^{0 \vert 1}
                  \&amp;\coloneqq
                  Spec
                  \\left(
                  Sym_R (\Sigma R)
                  \\right)
                  \\\
                  \&amp; \simeq
                  Spec\left(
                  R
                  \\wedge
                  \\left(
                  \\underset{n \in \mathbb{N}}{\coprod}
                  B \Sigma(n)^{\tau_n}
                  \\right)_+
                  \\right)
                  \\\
                  \&amp; \simeq
                  Spec\left(
                  R \wedge
                  Sym_{\mathbb{S}}(\Sigma \mathbb{S})
                  \\right)
                  \\end{aligned}
                  \\,.
          %p
            where on the right we have the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of the
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \tau_n
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            via the canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma(n)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            (see also at
            = succeed ")." do
              %a{:href => "permutation#ClassifyingSpaceAndThomSpace"} symmetric group – Classifying space and Thom space
          %h2#references References
          %p
            The proposal for spectral super-geometry
            %a{:href => "#Definition"} above
            invokes observations from
          %ul
            %li#Rezk09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                , section 2 of
                = succeed "," do
                  %em The congruence criterion for power operations in Morava E-theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0902.2499"} arXiv:0902.2499
            %li#SagaveSchlichtkrull11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Sagave"}> Steffen Sagave
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christian+Schlichtkrull"} Christian Schlichtkrull
                = succeed "," do
                  %em Diagram spaces and symmetric spectra
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1103.2764"} arXiv:1103.2764
          %p
            The proposal
            %a{:href => "#Definition"} above
            was originally motivated from the discussion of the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            in relation to
            %a.existingWikiWord{:href => "/nlab/show/super+algebra"} super algebra
            highlighted in
          %ul
            %li#Kapranov13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Categorification of supersymmetry and stable homotopy groups of spheres
                %em
                  %a{:href => "https://web.archive.org/web/20130617191515/http://mathserver.neu.edu/~bwebster/ACRT/"} Algebra, Combinatorics and Representation Theory: in memory of Andrei Zelevinsky (1953-2013)
                (April 2013) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Webster-ACRTAbstracts2013.pdf", :title => "pdf"}> pdf
                , video:
                %a{:href => "https://www.youtube.com/watch?v=WBsZrcYOrxI"}> YT
                \&amp;rbrack;
              %blockquote
                %p
                  %strong> Abstract:
                  \. The “minimal sign skeleton” necessary to formulate the
                  %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} Koszul sign rule
                  is a certain
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Picard+category"} Picard category
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                  with all
                  %a.existingWikiWord{:href => "/nlab/show/invertible+object"} objects
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/invertible+morphism"} morphisms invertible
                  = succeed "\u2018s" do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
                  %a.existingWikiWord{:href => "/nlab/show/n-truncation"} truncation
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} spherical spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  in degrees 0 and 1, so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\pm 1\}
                  appears as the
                  %a.existingWikiWord{:href => "/nlab/show/first+stable+homotopy+group+of+spheres"} first stable homotopy group of spheres
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_{n+1}(S^n)
                  = succeed "\u201D" do
                    %a.existingWikiWord{:href => "/nlab/show/higher+structures"} higher
                  %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
                  versions of
                  %a.existingWikiWord{:href => "/nlab/show/super-algebra"} super-mathematics
                  which utilize deeper structure of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi S
                          %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
                  version of the concept of a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/supercommutative+algebra"} supercommutative algebra
            %li#Kapranov15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Supergeometry in mathematics and physics
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gabriel+Catren"} Gabriel Catren
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mathieu+Anel"} Mathieu Anel
                %em
                  %a.existingWikiWord{:href => "/nlab/show/New+Spaces+for+Mathematics+and+Physics"} New Spaces for Mathematics and Physics
                (
                %a{:href => "http://arxiv.org/abs/1512.07042"}> arXiv:1512.07042
                )
            %li#Kapranov15b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Super-geometry
                = succeed "," do
                  %em
                    %a{:href => "http://ercpqg-espace.sciencesconf.org/program"} New Spaces for Mathematics &amp; Physics
                = succeed "&rbrack;" do
                  %a{:href => "https://www.youtube.com/watch?v=bjsNwKYT8JE"} video recording
          %p A closely related suggestion later appears in:
          %ul
            %li
              MathOverflow comment
              = succeed "," do
                %a{:href => "https://mathoverflow.net/a/403274/381"} MO:a/40327
