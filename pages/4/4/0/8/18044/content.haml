                      %annotation{:encoding => "application/x-tex"} E_\infty
                  \-geometry
                is
                %em already in itself
                a
                %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometric
                version of
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
