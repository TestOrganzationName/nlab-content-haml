          %title Cross products
          %h1#cross_products Cross products
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#classical"} Classical
                %li
                  %a{:href => "#binary"} Binary
                %li
                  %a{:href => "#counary"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-1)
                    \-ary
                %li
                  %a{:href => "#vectorvalued"} Vector-valued
                %li
                  %a{:href => "#tensorvalued"} Tensor-valued
              %li
