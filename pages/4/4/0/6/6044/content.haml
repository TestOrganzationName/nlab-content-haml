                %semantics
                  %mrow
                    %mi V
                    %mo ↦
                    %msup
                      %mi Λ
                      %mn 2
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V \mapsto \Lambda^2 V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ↦
                    %mi K
                  %annotation{:encoding => "application/x-tex"} V \mapsto K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Vect
            to be a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Vect
                    %mi K
                %annotation{:encoding => "application/x-tex"} Vect_K
            closed under the tensor product, such as
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fin
                    %msub
                      %mi Vect
                      %mi K
                  %annotation{:encoding => "application/x-tex"} Fin Vect_K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in exchange for fewer possibilities for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            Given an inner-product space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and a symmetric monoidal functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              \-valued cross product
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a multilinear function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⨉
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi V
                    %mi k
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} &amp;#10761;\colon V^k \to T(V)
          %p
            for some natural arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            such that:
          %ol
            %li
              %p
                Alternation:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⨉
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} &amp;#10761;(v_1,\ldots,v_k) = 0
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                      %mo =
                      %msub
                        %mi v
                        %mi j
                    %annotation{:encoding => "application/x-tex"} v_i = v_j
                for some
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ≠
                        %mi j
                      %annotation{:encoding => "application/x-tex"} i \ne j
            %li
              %p
                Orthogonality:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⨉
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} &amp;#10761;(v_1,\ldots,v_k)
                is orthogonal (in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T(V)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T(v_i)
            %li
              %p
                Area:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi ⨉
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi v
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ‖
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi v
                          %mi i
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|&amp;#10761;(v_1,\ldots,v_k)\|} = \prod_i {\|v_i\|}
                if the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                    %annotation{:encoding => "application/x-tex"} v_i
                are mutually orthogonal (in
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
          %p
            Again it follows that in any case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi ⨉
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} {\|&amp;#10761;(v_1,\ldots,v_k)\|}
            is a square root of the Gram determinant, and again this implies both (1) and (3).
          %p
            I do not know a full list of these, but one important example is the
            %strong scalar-valued binary cross product
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            dimensions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mi d
                  %mo −
                  %mi b
                  %mi c
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a, b) \times (c, d) = a d - b c .
          %p
            Actually, this scalar-valued cross product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ×
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \times y
            is simply the dot product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋅
                    %mo ×
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \cdot {\times}y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ×
                  %mi y
                %annotation{:encoding => "application/x-tex"} {\times}y
            is the
            %a{:href => "#counary"} unary
            cross product in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            dimensions.
          %p
            More generally, in any number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            of dimensions, there is a
            %strong multivector-valued binary cross product
            (actually one for each orientation) whose values are
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-2)
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/multivector"} vectors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            and the classical cross product when
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} n = 4
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/bivector"} bivector
            %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exterior+product"} exterior product
          %p
            Or generalizing the scalar-valued binary cross product in a different way, the
            %a.existingWikiWord{:href => "/nlab/show/volume"} volume
            form on an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %strong scalar-valued co-nullary cross product
            (so
            = succeed "-ary)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} k \gt n
            and the two nullary products given by the unit-norm scalars (so just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            over the real numbers) for arbitrary
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h2#relationships Relationships
          %h3#exterior_products Exterior products
          %p
            The cross product is also called ‘outer product’, and both of these terms are sometimes also used for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exterior+product"} exterior product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ,
                  %mi v
                %annotation{:encoding => "application/x-tex"} u,v
            is a
            %a.existingWikiWord{:href => "/nlab/show/bivector"} bivector
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∧
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \wedge v
            %em not
            a bivector-valued cross product by the definition
            = succeed "," do
              %a{:href => "#tensorvalued"} above
          %p
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                %annotation{:encoding => "application/x-tex"} 3
            dimensions, given an inner product and an orientation, we can use the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
            to turn the exterior product into a vector, and this is the classical cross product once more. In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            dimensions, using the same structure, we can turn the bivector into a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/scalar"} scalar
            = succeed "." do
              %a{:href => "#tensorvalued"} above
            = succeed "-vector-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-2)
          %p
            Using only the inner product but not the orientation, we get (respectively) a
            %a.existingWikiWord{:href => "/nlab/show/pseudovector"} pseudovector
            (sometimes called an axial vector) or more generally a
            %a.existingWikiWord{:href => "/nlab/show/pseudoscalar"} pseudoscalar
            or other
            = succeed ";" do
              %span.newWikiWord
                pseudotensor
                %a{:href => "/nlab/new/pseudotensor"} ?
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+algebra"} geometric algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-pseudovector," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-2)
          %p In classical applications of the cross product, often not all of the structure is needed, and the exterior product is really the fundamental concept.
          %h3#curls Curls
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            at each point is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/curl"} curl
            of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            %a.existingWikiWord{:href => "/nlab/show/multivector"} vector
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} field
            as follows:
          %ul
            %li
              Use the metric to turn the
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} form
            %li
              Take the
              %a.existingWikiWord{:href => "/nlab/show/exterior+differential"} exterior differential
              to get a
              = succeed "-form." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %li
              Use the metric again to get a
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %li
              Apply the cross product to get a
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              (or more generally a
              %a.existingWikiWord{:href => "/nlab/show/tensor+field"} tensor field
              for a tensor-valued cross product).
          %p
            This vector field is the
            %strong curl
            of the original
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Del \times X
            for the curl.
          %p
            (It's important that the cross product is
            %a.existingWikiWord{:href => "/nlab/show/alternating+form"} alternating
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            individual vectors.)
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k = 2
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
            = succeed "." do
              %a{:href => "#tensorvalued"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the same as the
            %a.existingWikiWord{:href => "/nlab/show/divergence"} divergence
            of the rotated vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} {\times}X
            (using the
            %a{:href => "#counary"} unary
            cross product in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            dimensions); that is,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo ×
                    %mi X
                    %mo =
                    %mo ∇
                    %mo ⋅
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Del \times X = \Del \cdot {\times}X
          %p In modern mathematics, of course, we usually think of the exterior differential of differential forms as the fundamental concept, and only turn these forms into vector fields and the like under certain circumstances.
