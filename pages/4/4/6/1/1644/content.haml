          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            any
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            or, more generally,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
            %em core
            is the maximal
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            inside it, generally the maximal sub-
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C0%29-category"}> (n,0)-category
            , hence the maximal
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid
            inside it.
          %p
            Since a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            out of a groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-functor"} (n,r)-functor
            out of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoid
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            or generally in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mrow
                      %mi n
                      %mo ,
                      %mi r
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒢
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Grpd
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒢
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi core
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Cat_{n,r}
                  \\big(
                  \\mathcal{G}
                  ,\,
                  \\mathcal{C}
                  \\big)
                  \\;\;
                  \\simeq
                  \\;\;
                  Grpd_{n}
                  \\big(
                  \\mathcal{G}
                  ,\,
                  core(\mathcal{C})
                  \\big)
                  \\,,
          %p
            the core construction is the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full inclusion
            of
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            among
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            (generally:
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C0%29-categories"} (n,0)-categories
            among
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-categories"} (n,r)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Grpd
                    %mi n
                  %munderover
                    %mo ⊥
                    %munder
                      %mo ⟵
                      %mi core
                    %mover
                      %mo ↪
                      %mi F
                  %msub
                    %mi Cat
                    %mrow
                      %mi n
                      %mo ,
                      %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Grpd_n
                  \\underoverset
                  {\underset{core}{\longleftarrow}}
                  {\overset{F}{\hookrightarrow}}
                  {\bot}
                  Cat_{n,r}
                  \\,.
          %p
            (Incidentally, the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} Grp
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            also has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "-construction.)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+groupoid"} free groupoid
          %h2#definition Definition
          #CoreOfCategories.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} C \in
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %strong core
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi core
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} core(C) \in
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              = succeed "is" do
                %br/
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              which is the maximal
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} sub
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              consisting of all objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              but with
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              only the
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              This construction extends to a 1-
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi core
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Cat
                    %mo →
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    core \colon Cat \to Grpd
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              We usually think of a groupoid as a special kind of category, but we can also think of a category as a groupoid equipped with additional morphisms. (This is possible because
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorified
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              is a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              equipped with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
              %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
              one).
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              Given a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preordered set
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of the preorder.
          %p
          .num_remark
            %h6 Example
            %p
              The core of
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              is known as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/permutation+groupoid"} permutation groupoid
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/symmetric+groupoid"} symmetric groupoid
              or something similar.
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+species"} combinatorial species
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groupoid"} symmetric groupoid
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h2#properties Properties
          %h3#universal_property Universal property
          .num_prop
            %h6#proposition Proposition
            %p
              The core functor of def.
              %a.maruku-ref{:href => "#CoreOfCategories"}
              is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Grpd
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} U \colon Grpd \to Cat
              of groupoids into categories.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mi core
                      %mo ↪
                    %mi Cat
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Grpd
                    \\underoverset
                    {\underset{core}{\longleftarrow}}
                    {\hookrightarrow}
                    {\bot}
                    Cat
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    A \to C
            %p
              (hence a functor out of the underlying category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(A)
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              to isomorphisms, hence has to send every
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi core
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \to core(C) \to C
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Grpd
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} U \colon Grpd \to Cat
              is the
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              functor that universally inverts every morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              this is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibrant+replacement"} Kan fibrant replacement
          %h2#variations_and_generalizations Variations and generalizations
          %h3#categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            \-Categories
          %p
            The
            %strong core
            of a
            %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger category
            consists of its
            %a.existingWikiWord{:href => "/nlab/show/unitary+morphism"} unitary
            isomorphisms only. This is why, for example, it makes sense to think of
            %a.existingWikiWord{:href => "/nlab/show/Hilb"} Hilb
            either as a category whose morphisms are linear maps bounded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            or as a dagger category whose morphisms are all linear maps; either way, the core is the same (invertible linear maps of norm exactly
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %h3#higher_categories Higher categories
          %p
            The
            %strong core
            of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-category"} category
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} groupoid
            consisting only of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %strong core
            of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/infinity-category"} category
            is similarly an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/quasicategory"} quasicategory
            is the maximal
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            inside it.
          %p
            For more on this see also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+object+in+an+%28infinity%2C1%29-category"} category object in an (infinity,1)-category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+groupoid"}> free groupoid
                ,
                %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiberwise+core"} fiberwise core
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/core+in+a+2-category"} core in a 2-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Gabriel"}> Pierre Gabriel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michel+Zisman"} Michel Zisman
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Calculus+of+fractions+and+homotopy+theory"} Calculus of fractions and homotopy theory
              = succeed "," do
                %strong 35
              = succeed "," do
                %a{:href => "https://link.springer.com/book/10.1007/978-3-642-85844-4"} doi:10.1007/978-3-642-85844-4
              = succeed "&rbrack;" do
                %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/GZ.pdf"} pdf
          %p
            Discussion in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-categories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
                \-categories
          %ul
            %li#Lurie09
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Around Prop. 1.1.14 in:
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-Categories+and+the+Goodwillie+Calculus"} (∞,2)-Categories and the Goodwillie Calculus
              (
              %a{:href => "http://arxiv.org/abs/0905.0462"}> arXiv:0905.0462
              )
