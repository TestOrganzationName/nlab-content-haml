            (
            %a{:href => "#Grothendieck83"}> Grothendieck 83
            ) is meant to axiomatize common features of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of
            %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"} shapes
            used to model
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cellular+sets"} cellular sets
          %h2#definition Definition
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "-sets," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functors"} contravariant functors
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c\in C
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo :
                    %msup
                      %mi Δ
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(-,c)=:\Delta^c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} X \colon \mathcal{C}^{op} \to Set
            is a
            = succeed "-set," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(c)
            are called the
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                \-cells
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi c
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta^c\to X
          %p
            Let the
            %strong cell category
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi 𝒞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}} X
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{C}Set/X
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the transformations of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi c
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta^c\to X
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %msub
                    %mi i
                    %mi 𝒞
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\mapsto i_{\mathcal{C}}X
            extends to a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi 𝒞
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mi Set
                  %mo →
                %annotation{:encoding => "application/x-tex"}
                  i_{\mathcal{C}} \colon\mathcal{C}Set
                  \\to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi i
                    %mi 𝒞
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Cat
                  %mo →
                  %mi 𝒞
                  %mi Set
                %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}}^* \colon Cat\to\mathcal{C}Set
            whose object part is given by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi i
                    %mi 𝒞
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi Hom
                    %mi Cat
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} /
                  %mi c
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i_{\mathcal{C}}^*(D)(c)
                  \\coloneqq
                  Hom_{Cat}(\mathcal{C}/c,D)
                  \\,.
          %p
            Denote the
            %a.existingWikiWord{:href => "/nlab/show/counit+of+the+adjunction"} counit of the adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %msub
                      %mi i
                      %mi 𝒞
                    %msubsup
                      %mi i
                      %mi 𝒞
                      %mo *
                    %mo →
                    %msub
                      %mi Id
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} \epsilon : i_{\mathcal{C}}i_{\mathcal{C}}^*\to Id_{Cat}
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X\to Y
            is a
            %strong weak equivalence
            is the induced map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi 𝒞
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi i
                    %mi 𝒞
                  %mi X
                  %mo →
                  %msub
                    %mi i
                    %mi 𝒞
                  %mi Y
                %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}}(f)\colon i_{\mathcal{C}} X\to i_{\mathcal{C}} Y
            of their cell categories, i.e., the induced map of
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            (“
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"}> classifying spaces
            ”)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mi 𝒞
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mi 𝒞
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(i_{\mathcal{C}} X)\to B(i_{\mathcal{C}} Y)
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence+of+simplicial+sets"} weak equivalence of simplicial sets
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are called
            %strong weakly equivalent
            if there is a weak equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi 𝒞
                  %mo :
                  %mi 𝒞
                  %mi Set
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}}:\mathcal{C}Set\to Cat
          %p induces a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mrow
                      %mi 𝒞
                      %mo *
                  %mo :
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}*}:Ho(\mathcal{C}Set)\to Ho(Cat)
          %p
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
          #testcategory.num_defn
            %h6#definition_2 Definition
            %p
              A
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %strong aspherical
              if the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}}(X)
              is weakly contractible, i.e. the nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(i_{\mathcal{C}}(X))
              is a weakly contractible simplicial set. Note that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a weakly contractible category, then this is equivalent to the condition that the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X \to 1
              to the terminal presheaf is a weak equivalence of
              = succeed "-sets." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              A
              %strong weak test category
              is a small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              such that, for any category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
              which has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi 𝒞
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_{\mathcal{C}}^\ast(D)
              is aspherical.
            %p
              A
              %strong test category
              is any small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              such that
            %ul
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  is aspherical) its (
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                  of the)
                  %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/classifying+space"}> classifying space
                  ”)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi 𝒜
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} \vert \mathcal{A}\vert
                  is
                  %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  is a “local test category”) for every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  require the
                  %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                        %mo{:stretchy => "false"} /
                        %mi a
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}/a
                  to be a weak test category. Thus for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} a \in \mathcal{A}
                  and any category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  with a terminal object, we require that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mrow
                            %mi 𝒜
                            %mo{:stretchy => "false"} /
                            %mi a
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi i
                          %mrow
                            %mi 𝒜
                            %mo{:stretchy => "false"} /
                            %mi a
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B(i_{\mathcal{A}/a}(i_{\mathcal{A}/a}^\ast(D)))
                  be a weakly contractible simplicial set.
            %p
              A
              %strong strict test category
              is a test category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              such that
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi 𝒜
                      %mo :
                      %mi 𝒜
                      %mi Set
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} i_{\mathcal{A}} : \mathcal{A}Set \to Cat
                preserves
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                up to weak equivalence,
            %p or equivalently, such that
            %ul
              %li
                the induced functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mrow
                          %mi 𝒜
                          %mo *
                      %mo :
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mi Set
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Cat
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i_{\mathcal{A}*}:Ho(\mathcal{A}Set)\to Ho(Cat)
                preserves finite products.
          .num_remark
            %h6#remark Remark
            %p
              One can show that a small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a weak test category if and only if both the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %msub
                      %mi i
                      %mi 𝒞
                    %msubsup
                      %mi i
                      %mi 𝒞
                      %mo *
                    %mo →
                    %msub
                      %mi Id
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} \epsilon : i_{\mathcal{C}}i_{\mathcal{C}}^*\to Id_{Cat}
              and the co-unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msub
                      %mi Id
                      %mrow
                        %mi 𝒞
                        %mi Set
                    %mo →
                    %msubsup
                      %mi i
                      %mi 𝒞
                      %mo *
                    %msub
                      %mi i
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \eta : Id_{\mathcal{C}Set}\to i^*_{\mathcal{C}}i_{\mathcal{C}}
              are weak equivalence; see Lemme 1.3.8 and Proposition 1.3.9 in (
              %a{:href => "#Maltsin05"}> Maltsiniotis
              ). In particular, one then has an equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C}Set)\cong Ho(Cat)\, .
            %p
              An example of weak test category which is not a test category is the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Delta_+
              (so that a presheaf on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \Delta_+
              is a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/semi-simplicial+set"} semi-simplicial set
              = succeed ")." do
                %a{:href => "#CisMal11"} Cisinski, Maltsiniotis
          %h2#properties Properties
          %h3#homotopy_category Homotopy category
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            over a (weak) test category, as a
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            is equivalent to the standard homotopy category of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            with weak equivalences being
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
          %p
            In other words, presheaves over a (weak) test category are models for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
          %h3#model_category_structure Model category structure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            over a test category with the above weak equivalences admits a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure: the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+presheaves+over+a+test+category"} model structure on presheaves over a test category
            = succeed ")" do
              %a{:href => "#Cisinski"} Cisinski
            = succeed ")." do
              %a{:href => "#Jardine"} Jardine
            %strong local
            test categories:
          .num_theorem
            %h6#theorem Theorem
            %p
              A small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is a local test category if and only if the category of presheaves of sets on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure whose cofibrations are the monomorphisms with the weak equivalences defined as above. Such a model category structure is always
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is a local test category, the assignment
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\mapsto (N(i_{\mathcal{A}}(X))\to N(\mathcal{A}))
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mi Set
                    %mo →
                    %mi SSet
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}Set\to SSet/N(\mathcal{A})
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                    %mo{:stretchy => "false"} /
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} SSet/\mathcal{C}
              is equipped with the sliced
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} Kan-Quillen model structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SSet
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{A}Set)\cong Ho(Cat/\mathcal{A})\cong Ho(SSet/N(\mathcal{A}))\, .
          .proof
            %h6#proof Proof
            %p
              See Théorème 1.4.3 and Corollaire 4.2.18 in (
              %a{:href => "#Cisinski"}> Cisinski
              ) for the first and second assertion. The Quillen equivalence is a particular case of Proposition 4.4.28 in loc. cit. The properness of the model structure is a particular case of Théorème 4.4.30 in loc. cit.
          .num_remark
            %h6#remark_2 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is a local test category, one can describe the model structure on
              = succeed "-sets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} i_\mathcal{A}
              as follows: it is the minimal
              %a.existingWikiWord{:href => "/nlab/show/Cisinski+model+structure"} Cisinski model structure
              such that any morphism between representable presheaves is a weak equivalence and such that any presheaf on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is canonically an homotopy colimit of representable presheaves. This is Proposition 6.4.26 in (
              %a{:href => "#Cisinski"}> Cisinski
              ).
          %h2#examples Examples
          %p
            Apart from the archetypical example of the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            we have the following
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
                is a test category (
                %a{:href => "#Grothendieck"}> Grothendieck
                ,
                = succeed ")," do
                  %a{:href => "#Cisinski"} Cisinski
                = succeed ")." do
                  %a{:href => "#Kan"} Kan
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                is discussed at
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cubical+sets"} model structure on cubical sets
              %p
                The category of
                %a.existingWikiWord{:href => "/nlab/show/cubes"} cubes
                equipped with
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+cubical+set"} connections
                is even a strict test category (
                %a{:href => "#Maltsiniotis"}> Maltsiniotis, 2008
                ).
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Theta+category"} Theta category
                and its
                = succeed "-analog" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Θ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde \Theta
                are strict test categories (
                %a{:href => "#CisMal11"} Cisinski, Maltsiniotis
                and
                = succeed ")." do
                  %a{:href => "#Ara"} Ara
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/tree+category"} tree category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
                is a test category. This was proven in an unpublished note of Cisinski, and later appeared as
                = succeed "." do
                  %a{:href => "#AraCisinskiMoerdijk"} Ara, Cisinski, Moerdijk, 2019
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/cycle+category"} cycle category
                of Connes is a local test category. The corresponding model structure models homotopy types over
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},2)
                = succeed ")." do
                  %a{:href => "#Cisinski"} Cisinski
            %li
              %p
                Given a local test category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
                and a small category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %a.existingWikiWord{:href => "/nlab/show/product"} product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                      %mo ×
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}\times\mathcal{C}
                is a local test category. It is a test category if both
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                have weakly contractible nerves. This is a special case of a more general fact: if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
                is a local test category, for any a
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi 𝒳
                      %mo →
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} p:\mathcal{X}\to\mathcal{A}
                (with small fibers), the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
                is a local test category. This follows from Corollaire 1.7.15, Exemple 3.2.2 and the dual version of Proposition 3.2.9 in (
                %a{:href => "#Maltsin05"}> Maltsiniotis, 2005
                ). In particular, given any presheaf of groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on a local test category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed ")." do
                  %a{:href => "#Cisinski"} Cisinski
          %p
            Any small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            which is closed under finite products and which contains an interval is a strict test category (where an interval is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            equipped with two morphisms from the terminal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mi e
                    %mo :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} d^e:*\to I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} e=0,1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            which factors through both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 0
                %annotation{:encoding => "application/x-tex"} d^0
            and
            = succeed ");" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d^1
            = succeed ")." do
              %a{:href => "#Maltsin05"} Maltsiniotis
          %ul
            %li
              %p
                The category of non-empty finite sets is a strict test category (hence
                %a.existingWikiWord{:href => "/nlab/show/symmetric+simplicial+sets"} symmetric simplicial sets
                are a model of homotopy types of CW-complexes).
            %li
              %p The full subcategory of the category of topological spaces, whose objects are closed balls in euclidian spaces, is a strict test category.
            %li
              %p
                The category of open balls in euclidian spaces, with
                = succeed "-maps" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} C^\infty
            %li
              %p
                The category of contractible
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stein+manifold"} Stein manifolds
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/direct+category"} direct category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/basic+localizer"} basic localizer
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/test+topos"} test topos
          %h2#references References
          %p The notion of test category was introduced in
          %ul
            %li#Grothendieck83
              %a.existingWikiWord{:href => "/nlab/show/Alexandre+Grothendieck"}> Alexandre Grothendieck
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Pursuing+Stacks"} Pursuing Stacks
              = succeed ")" do
                %a{:href => "http://webusers.imj-prg.fr/~georges.maltsiniotis/groth/ps/Pursuing_Stacks.djvu"} djvu
          %p Various conjectures made there are proven in
          %ul
            %li#Cisinski
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %em Les préfaisceaux comme modèles des types d’homotopie
              = succeed "," do
                %strong 308
              = succeed "." do
                %a{:href => "http://www.math.univ-toulouse.fr/~dcisinsk/ast.pdf"} pdf
          %p
            which moreover develops the main toolset and establishes the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+presheaves+over+a+test+category"} model structure on presheaves over a test category
          %p General surveys include
          %ul
            %li#Maltsin05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georges+Maltsiniotis"}> Georges Maltsiniotis
                ,
                = succeed "," do
                  %em La théorie de l’homotopie de Grothendieck
              %p
                %a{:href => "https://webusers.imj-prg.fr/~georges.maltsiniotis/textes.html"}> html
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
                ,
                = succeed "," do
                  %em Categorical homotopy theory
                %strong 8
                (1), 2006, pp.71–144,
                = succeed "." do
                  %a{:href => "https://doi.org/10.4310/hha.2006.v8.n1.a3"} doi
          %p
            That the
            %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
            is a test category is asserted without proof in (
            %a{:href => "#Grothendieck"}> Grothendieck
            ). A proof is spelled out in (
            %a{:href => "#Cisinski"}> Cisinski
            )
          %p That it is not a strict test category is implicitly already in
          %ul
            %li#Kan
              %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"}> Dan Kan
              ,
              %em Abstract homotopy. I
              , Proc. Nat. Acad. Sci. U.S.A. 41 (1955), 1092–1096. (
              %a{:href => "http://www.ncbi.nlm.nih.gov/pmc/articles/PMC528202/pdf/pnas00727-0082.pdf"}> pdf
              )
          %p
            and led to the preference for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
          %p
            That the category of
            %a.existingWikiWord{:href => "/nlab/show/cubes"} cubes
            %em
              equipped with
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+cubical+set"} connection on a cubical set
            forms a
            %em strict
            test category is shown in
          %ul#Maltsiniotis
            %li
              %a.existingWikiWord{:href => "/nlab/show/Georges+Maltsiniotis"}> Georges Maltsiniotis
              ,
              %em La catégorie cubique avec connexions est une catégorie test stricte
              \. (French. English summary) Homology, Homotopy Appl. 11 (2009), no. 2, 309–326. (
              %a{:href => "http://www.intlpress.com/HHA/v11/n2/a15/"}> web
              )
          %p
            The test category nature of the groupoidal
            %a.existingWikiWord{:href => "/nlab/show/Theta+category"} Theta category
            is discussed in
          %ul
            %li#Ara
              %a.existingWikiWord{:href => "/nlab/show/Dimitri+Ara"}> Dimitri Ara
              ,
              %em
                The groupoidal analogue
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Θ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde \Theta
                to Joyal’s category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                    %annotation{:encoding => "application/x-tex"} \Theta
                is a test category
              (
              %a{:href => "http://arxiv.org/abs/1012.4319"}> arXiv:1012.4319
              )
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/Theta+category"} Theta category
            itself is discussed in
          %ul#CisMal11
            %li
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Georges+Maltsiniotis"} Georges Maltsiniotis
              %em
                La catégorie
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                    %annotation{:encoding => "application/x-tex"} \Theta
                de Joyal est une catégorie test
              , JPAA
              %strong 215
              no.5 (2011) pp.962-982. (
              %a{:href => "http://webusers.imj-prg.fr/~georges.maltsiniotis/ps/theta.pdf"}> pdf
              , in French)
          %p
            That fact that the
            %a.existingWikiWord{:href => "/nlab/show/tree+category"} tree category
            is a test category was proved in
          %ul
            %li#AraCisinskiMoerdijk
              %a.existingWikiWord{:href => "/nlab/show/Dimitri+Ara"}> Dimitri Ara
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"} Denis-Charles Cisinski
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              = succeed "," do
                %em The dendroidal category is a test category
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/S030500411800021X"} doi:10.1017/S030500411800021X
              = succeed ")." do
                %a{:href => "http://arxiv.org/abs/1703.07098"} arXiv:1703.07098
          %p A short introduction can be found in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
              ,
              %em Introduction to Test Categories
              = succeed "." do
                %a{:href => "http://www.math.uwo.ca/faculty/kapulkin/notes/test_categories.pdf"} PDF
        .revisedby
