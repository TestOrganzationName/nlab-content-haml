          %h3#extensive_categories Extensive categories
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong finitely extensive category
              (or
              = succeed ")" do
                %strong finitary extensive category
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with
              %a.existingWikiWord{:href => "/nlab/show/finite+coproduct"} finite
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproducts
              such that one, and hence all, of the following equivalent conditions holds:
            %ol
              %li
                %p
                  For any
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a, b
                  the coproduct functor on
                  %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
                  is an
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                #eq:CoproductFunctorOnSliceCategoriesIsEquivalenceOfCategories.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi E
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mi a
                                %mspace{:width => "thinmathspace"}
                                %mo ×
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi E
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mi b
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %mo ≃
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                              %mtd
                                %msub
                                  %mi E
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mo{:stretchy => "false"} (
                                    %mi a
                                    %mo ⊔
                                    %mi b
                                    %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mi X
                                      %mtr
                                        %mtd
                                          %mo{:stretchy => "false"} ↓
                                      %mtr
                                        %mtd
                                          %mi a
                                  %mo )
                                %mo ,
                                %mspace{:width => "thickmathspace"}
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mi Y
                                      %mtr
                                        %mtd
                                          %mo{:stretchy => "false"} ↓
                                      %mtr
                                        %mtd
                                          %mi b
                                  %mo )
                              %mtd
                                %mo ↦
                              %mtd
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mi X
                                          %mo ⊔
                                          %mi Y
                                      %mtr
                                        %mtd
                                          %mo{:stretchy => "false"} ↓
                                      %mtr
                                        %mtd
                                          %mi a
                                          %mo ⊔
                                          %mi b
                                  %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        E_{/a}
                        \\,\times\,
                        E_{/b}
                        \&amp;\xrightarrow{\;\;\;\simeq\;\;\;}&amp;
                        E_{/(a \sqcup b)}
                        \\\
                        \\left(
                        \\array{
                        X
                        \\\
                        \\downarrow
                        \\\
                        a
                        }
                        \\right)
                        ,\;
                        \\left(
                        \\array{
                        Y
                        \\\
                        \\downarrow
                        \\\
                        b
                        }
                        \\right)
                        \&amp;\mapsto&amp;
                        \\left(
                        \\array{
                        X \sqcup Y
                        \\\
                        \\downarrow
                        \\\
                        a \sqcup b
                        }
                        \\right)
                        }
                %p
                  (e.g.
                  = succeed ")." do
                    %a{:href => "#CarboniLackWalters93"} Carboni, Lack &amp; Walters 1993, Def. 2.1
              %li#DisjointAndPullbackStableCoproducts
                %p
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} Pullbacks
                  of finite-coproduct injections along arbitrary morphisms exist and finite coproducts are
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+coproduct"} disjoint
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pullback-stable+colimit"} stable under pullback
                %p
                  (e.g
                  = succeed ")" do
                    %a{:href => "#CarboniLackWalters93"} CLW93, Prop. 2.6, Lem. 2.11
              %li
                %p Pullbacks of finite-coproduct injections (and thus all coproduct injections) along arbitrary morphisms exist, and in any commutative diagram
                #eq:HomIntoCoproductIsPullbackIfDomainIsCoproduct.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi x
                              %mtd
                                %mo →
                              %mtd
                                %mi z
                              %mtd
                                %mo ←
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mo →
                              %mtd
                                %mi a
                                %mo +
                                %mi b
                              %mtd
                                %mo ←
                              %mtd
                                %mi b
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        x &amp; \to &amp; z &amp; \leftarrow &amp; y
                        \\\
                        \\downarrow  &amp; &amp;   \downarrow  &amp;  &amp;  \downarrow
                        \\\
                        a &amp; \to &amp; a+b &amp; \leftarrow &amp; b
                        }
                %p the two squares are pullbacks if and only if the top row is a coproduct diagram
                %p
                  (e.g.
                  = succeed ")." do
                    %a{:href => "#CarboniLackWalters93"} CLW93, Prop. 2.2
              %li
                %p
                  Finite coproducts are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimits"} van Kampen colimits
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              An
              %strong infinitary extensive category
              is a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with all (small)
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              such that the following analogous equivalent conditions hold:
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} Pullbacks
                  of
                  %a.existingWikiWord{:href => "/nlab/show/coprojection"} coproduct injections
                  along arbitrary morphisms exist
                %p
                  and small coproducts are
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+coproduct"} disjoint
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pullback-stable+colimit"} stable under pullback
              %li
                %p
                  For any small-
                  %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a_i)
                  of objects, the coproduct functor of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:CoproductFunctorOnSliceCategoriesIsEquivalenceOfCategories"} (1)
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi a
                              %mi i
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ∼
                        %msub
                          %mi E
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi i
                            %msub
                              %mi a
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{i \in I}{\prod}
                        (E_{/a_i})
                        \\overset{\sim}{\longrightarrow}
                        E_{/(\coprod_i a_i)}
                        \\,.
              %li
                %p Pullbacks of finite-coproduct injections (and thus all coproduct injections) along arbitrary morphisms exist, and for any family of commutative squares
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi x
                                  %mi i
                              %mtd
                                %mo →
                              %mtd
                                %mi z
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mi f
                            %mtr
                              %mtd
                                %msub
                                  %mi a
                                  %mi i
                              %mtd
                                %mo →
                              %mtd
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mi i
                                %msub
                                  %mi a
                                  %mi i
                      %annotation{:encoding => "application/x-tex"} \array{ x_i &amp; \to &amp; z \\\downarrow &amp;&amp;\downarrow^f \\ a_i &amp; \to &amp; \coprod_i a_i }
                %p
                  in which the bottom family of morphisms is the coproduct injections and the right-hand morphism is always the same, the top family are the injections of a coproduct diagram (hence
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo =
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi i
                          %msub
                            %mi x
                            %mi i
                        %annotation{:encoding => "application/x-tex"} z = \coprod_i x_i
              %li
                %p
                  All small coproducts are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimits"} van Kampen colimits
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              In between finitary and infinitary extensive , a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                \-ary extensive category
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              a
              %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
              or an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/arity+class"} arity class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              objects. The unqualified term
              %strong extensive category
              can refer to either the finitary or infinitary version, depending on the author; the more usual meaning is the finitary version.
          %p
          .num_remark
            %h6 Remark
            %p
              Extensive categories are also called
              = succeed "," do
                %strong positive categories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent
              %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact
              is called a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck toposes
              (the remaining condition is the existence of a small
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/generating+set"} generating set
          %p
          .num_defn
            %h6 Definition
            %p
              If an extensive category also has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finite limits
              %strong lextensive
              or
              = succeed "." do
                %strong disjunctive
              %br/
          (Note that the more usual default meaning of ‘disjunctive’, unlike the other terms, is the infinitary case.)
          %p
          .num_remark
            %h6 Remark
            %p
              The alternative definitions of finitary disjunctive refer only to binary coproducts, but they obviously imply analogous statements for
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \ge 1
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %em strict
              (any map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a\to 0
              is an isomorphism).
            %p
              Furthermore, if binary coproducts are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+coproduct"} disjoint
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                    %msub
                      %mi X
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi a
                          %mn 0
                    %mo ⊔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                      %mrow
                        %mi a
                        %mo ≠
                        %msub
                          %mi a
                          %mn 0
                    %msub
                      %mi X
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi a
                          %mn 0
                    %mo ⊔
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ⊔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                      %mrow
                        %mi a
                        %mo ≠
                        %msub
                          %mi a
                          %mn 0
                        %mo ,
                        %msub
                          %mi a
                          %mn 1
                    %msub
                      %mi X
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\bigsqcup_{a\in A} X_a
                    \\;\;\cong\;\;
                    X_{a_0} \sqcup \bigsqcup_{a\neq a_0} X_a
                    \\;\;\cong\;\;
                    X_{a_0} \sqcup X_{a_1} \sqcup \bigsqcup_{a\neq a_0,a_1} X_a
            %p
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 0
                      %mo ,
                      %msub
                        %mi a
                        %mn 1
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a_0, a_1\in A
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              is finitary extensive if and only if it is infinitary extensive.
          %p
          .num_remark
            %h6 Remark
            %p
              As a further special case of the preceding, since an
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
              is finitary extensive, any cocomplete elementary topos is infinitary extensive. However, in this case, one of the arguments for finitary extensivity applies directly to the infinitary case and does
              %em not
              require classical logic; see
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/toposes+are+extensive"} toposes are extensive
          %p
          .num_remark
            %h6 Remark
            %p
              See
              %a.existingWikiWord{:href => "/nlab/show/familial+regularity+and+exactness"} familial regularity and exactness
              for a generalization of extensivity and its relationship to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+category"} exactness
          %p
          .num_remark
            %h6 Remark
            %p
              Any extensive category with
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              is automatically a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributive+category"} distributive category
          %h3#superextensive_sites Superextensive sites
          %p
            Any extensive category admits a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            whose
            %a.existingWikiWord{:href => "/nlab/show/cover"} covering families
            are (generated by) the families of inclusions into a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            (finite or small, as appropriate). We call this the
            %strong
              extensive
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            or
            = succeed "." do
              %strong extensive topology
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            of any extensive category is a
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            for its extensive topology.
          %p
            In general, we call a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %strong superextensive
            if its underlying category is extensive, its covering families are generated by (finite or small) families, and its coverage includes the extensive one. See
            %a.existingWikiWord{:href => "/nlab/show/superextensive+site"} superextensive site
            for more details.
          %h3#prelextensive_categories Pre-lextensive categories
          %p
            Extensivity is an “exactness” condition, analogous to being a
            %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact category
            or a
            %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            (a pretopos being precisely a category that is exact and finitary-extensive). The corresponding “regularity” condition analogous to being a
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            or a
            %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent category
            is not well-known, but is not hard to write down.
          %p
            Let us say (without making any assertion that this is good or permanent terminology) that a category is
            %strong pre-lextensive
            if
          %ol
            %li
              it has a
              %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              (equivalently, its
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %a.existingWikiWord{:href => "/nlab/show/preorders"} preorders
              have pullback-stable bottom elements), and
            %li
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↣
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A\rightarrowtail X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↣
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B\rightarrowtail X
              are disjoint subobjects (i.e.
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi B
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} A\cap B=0
          %p This is intended to complete the table of analogies:
          %table
            %thead
              %tr
                %th some
                %th all
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact category
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent category
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
              %tr
                %td{:style => "text-align: left;"} pre-lextensive category
                %td{:style => "text-align: left;"} lextensive category
          %p
            Regular/exact categories have quotients of (some)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/congruences"} congruences
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/kernel+pairs"} kernel pairs
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            if it existed. Similarly, pre-/lextensive categories have
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            have a disjoint union if you can exhibit another object in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            can be embedded disjointly. Finally, coherent categories/pretoposes have both quotients and disjoint unions, or equivalently quotients and not-necessarily-disjoint unions, with the same sort of relationship between the two.
          %p
            Evidently a pre-lextensive category is lextensive as soon as any two objects can be embedded disjointly in a third. Pre-lextensive categories also suffice for the interpretation of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} disjunctive logic
          %p
            Being pre-lextensive is also sufficient to define the extensive topology and show that it is subcanonical, since it implies that whatever disjoint coproducts exist must be pullback-stable. The codomain fibration of a pre-lextensive category is not necessarily a stack for its extensive topology, but this condition is weaker than extensivity. It is true, however, that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a pre-lextensive category whose codomain fibration is a stack for its extensive topology, and in which the disjoint coproduct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1+1
            exists, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is extensive, for arbitrary disjoint (binary) coproducts can then be obtained by descent along the covering family
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo →
                    %mn 1
                    %mo +
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo →
                    %mn 1
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1\to 1+1, 1\to 1+1)
          %h2#examples Examples
          %p
          #FreeCoproductCompletionsAreExtensive.num_remark
            %h6 Example
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
              is extensive.
            %p
              As one immediately checks condition
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CoproductFunctorOnSliceCategoriesIsEquivalenceOfCategories"} (1)
              = succeed "." do
                %a{:href => "#CarboniLackWalters93"} Carboni, Lack &amp; Walters 1993, Prop. 2.4
          %p
          .num_remark
            %h6 Example
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
              (or, more generally, any
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              (or, more generally, any
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              elementary topos) is infinitary lextensive.
          %p
          .num_remark
            %h6 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
              with disjoint coproducts, or more generally a
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              with disjoint coproducts, is extensive. (Of course not all quasitoposes have disjoint coproducts, one example being a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/complete+Heyting+algebra"} complete Heyting algebra
          %p
          .num_remark
            %h6 Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is infinitary lextensive. The category
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              is infinitary extensive, though it does not have all
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (only those involving a
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/transversal+maps"} transversal maps
          %p
          .num_remark
            %h6 Example
            %p
              The category of
              %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
              is infinitary lextensive. In more detail: the category of functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} CRing \to Set
              is infinitary lextensive (since finite limits and small coproducts are computed pointwise in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CRing
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CRing^{op}
              form an infinitary lextensive category (since finite limits and small coproducts are reflected back from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi CRing
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CRing, Set]
              by applying a left exact reflection to the inclusion of sheaves in presheaves). Finally, the category of schemes, as a full subcategory of the Zariski sheaves, are closed under finite limits and small coproducts. (Some discussion of these points can be found at the
              = succeed "," do
                %a{:href => "http://nforum.mathforge.org/discussion/5149/extensive-category/"} nForum
          %p
          .num_remark
            %h6 Example
            %p
              The category of affine schemes (opposite to the category of commutative
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %em not
              infinitary lextensive. Some details may be found
              = succeed "." do
                %a{:href => "http://ncatlab.org/toddtrimble/published/Dippy+disproof+of+infinitary+extensivity+of+affine+schemes"} here
          %p
          .num_remark
            %h6 Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              is infinitary lextensive.
          %p
          .num_remark
            %h6 Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              is not even finitely extensive.
          %h2#Properties Properties
          %p
          #InExtensiveCategoryCOnnectedObjectsArePrimitiveUnderCoproduct.num_prop
            %h6 Proposition
            %p
              %strong (in extensive categories connected objects are primitive under coproduct)
              %br/
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in an extensive category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected object
              (in that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,-) \,\colon\, \mathcal{C} \to Set
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              decomposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %mi U
                      %mo +
                      %mi V
                    %annotation{:encoding => "application/x-tex"} X \simeq U + V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is not the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          %p
          #ProofThatInExtensiveCategoryCOnnectedObjectsArePrimitiveUnderCoproduct.proof
            %h6 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is connected and consider an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mo ∼
                    %msub
                      %mi X
                      %mn 1
                    %mo ⊔
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{\sim} X_1 \sqcup X_2
              to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
