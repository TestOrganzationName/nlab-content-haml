                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mn ∞
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in \infty Grp(G)
            be an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
            for its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            object.
          %p
            By the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            we have the following.
          #InfinityAction.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              any object, an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is equivalently an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X/G
              and a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; X//G
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} X/G
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
          .num_remark
            %h6#remark Remark
            %p
              The action as a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi G
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times G \to X
              is recovered from prop.
              %a.maruku-ref{:href => "#InfinityAction"}
              by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times G &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\to&amp; X//G
                    }
                    \\,.
          #StabilizerInInfinityTopos.num_defn
            %h6#definition_2 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#InfinityAction"}
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    x \colon \ast \to X
            %p
              then the
              %strong
                stabilizer
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab_\rho(x)
              of the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Ω
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab_\rho(x) \coloneqq \Omega_x (X//G)
                    \\,.
          .num_defn
            %h6#remark_2 Remark
            %p
              Equivalently, def.
              = succeed "," do
                %a.maruku-ref{:href => "#StabilizerInInfinityTopos"}
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of the
              %a.existingWikiWord{:href => "/nlab/show/1-image"} 1-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Stab_\rho(x)
              of the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo →
                      %mi x
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast \stackrel{x}{\to} X \to X//G
                    \\,.
            %p
              As such the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the stabilizer
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
              factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}Stab_\rho(x) \hookrightarrow X//G
              which combines with the homotopy fiber sequence of prop.
              %a.maruku-ref{:href => "#InfinityAction"}
              to a diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi x
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi mono
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi Stab
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi Stab
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\stackrel{x}{\longrightarrow}&amp; X &amp;\stackrel{}{\longrightarrow}&amp; X//G
                    \\\
                    \\downarrow^{\mathrlap{epi}} &amp;&amp; &amp; \nearrow_{\mathrlap{mono}} &amp; \downarrow
                    \\\
                    \\mathbf{B} Stab_\rho(x)
                    \&amp;=&amp;
                    \\mathbf{B} Stab_\rho(x)
                    \&amp;\longrightarrow&amp;
                    \\mathbf{B}G
                    }
                    \\,.
            %p
              In particular there is hence a canonical homomorphism of
              = succeed "-groups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab_\rho(x) \longrightarrow G
                    \\,.
            %p
              However, in contrast to the classical situation, this morphism is not in general a monomorphism anymore, hence the stabilizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab_\rho(x)
              is not a
              = succeed "-group" do
                %em sub
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              in general.
          %h2#properties Properties
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/orbit-stabilizer+theorem"} orbit-stabilizer theorem
          %h2#examples Examples
          %h3#for_a_group_acting_on_itself For a group acting on itself
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            any
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on itself is given by the
            %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping/delooping
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mo *
                  %mover
                    %mo →
                    %mi ρ
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G \to * \stackrel{\rho}{\to} \mathbf{B}G
                  \\,.
          %p
            Clearly, for every point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \in G
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo *
                  %msub
                    %mo ×
                    %mo *
                  %mo *
                  %mo ≃
                  %mo *
                %annotation{:encoding => "application/x-tex"} Stab_{\rho}(g) \simeq * \times_* * \simeq *
            is trivial. Hence the action is free.
          %h3#KleinGeometry Stabilizers of shapes – Klein geometry
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mover
                    %mo →
                    %mi ρ
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to X//G \stackrel{\rho}{\to} \mathbf{B}G
            be an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} Y \in \mathbf{H}
            any other object, and regard it as equipped with the trivial
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi Y
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} Y \to Y \times \mathbf{B}G \to \mathbf{B}G
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi Y
                %annotation{:encoding => "application/x-tex"} \rho_Y
            on the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [Y,X]
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [Y,X] \to \underset{\mathbf{B}G}{\sum} [Y,X]_{/\mathbf{B}G} \to \mathbf{B}G
                  \\,.
          %p
            Now given any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \colon Y \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mrow
                      %msub
                        %mi ρ
                        %mi Y
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab_{\rho_Y}(f)
            is the stabilizer of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            “in”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            under this
            = succeed "-action." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The morphism of
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Stab
                    %mrow
                      %msub
                        %mi ρ
                        %mi Y
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  i_f\colon Stab_{\rho_Y}(f) \to G
          %p
            hence characterizes the (
            %a.existingWikiWord{:href => "/nlab/show/higher+Klein+geometry"}> higher
            )
            %a.existingWikiWord{:href => "/nlab/show/Klein+geometry"} Klein geometry
            induced by the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f\colon Y \to X
            = succeed ".)" do
              %a{:href => "Klein+geometry#History"} Klein geometry – History
          %p For completeness we notice that:
          #ReformulationOfRightSidedConjugationAction.num_prop
            %h6#proposition_2 Proposition
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\underset{\mathbf{B}G}{\sum} [Y,X]_{/\mathbf{B}G} \to \mathbf{B}G )
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \rho_Y
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ρ
                                    %mi Y
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi Y
                                  %mo ,
                                  %mi ρ
                                  %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{\mathbf{B}G}{\sum} [Y,X]_{/\mathbf{B}G} &amp;\to&amp; [Y, X//G]
                    \\\
                    \\downarrow^{\mathrlap{\rho_Y}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{[Y, \rho]}}
                    \\\
                    \\mathbf{B}G
                    \&amp;\to&amp;
                    [Y, \mathbf{B}G]
                    }
                    \\,,
            %p
              where the bottom morphism is the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} Y \times \mathbf{B}G \to \mathbf{B}G
          .proof
            %h6#proof Proof
            %p
              We check the Hom adjunction property, that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mover
                      %mo →
                      %mi α
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (A//G \stackrel{\alpha}{\to} \mathbf{B}G) \in \mathbf{B}G
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{/\mathbf{B}G}(A,[Y,X]_{\mathbf{B}G})
                    \\simeq
                    \\mathbf{H}_{/\mathbf{B}G}(A\times_{\mathbf{B}G} Y, X)
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} [Y,X]_{/\mathbf{B}G}
              replaced by the above pullback.
            %p
              Notice that by the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              being trivial, we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi Y
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mo ×
                      %mi Y
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mover
                        %mo →
                        %mi α
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                    %annotation{:encoding => "application/x-tex"} A \times_{\mathbf{B}G} Y \simeq (A//G \times Y  \stackrel{p_1}{\to} A//G \stackrel{\alpha}{\to} \mathbf{B}G) \in \mathbf{H}_{/\mathbf{B}G}
            %p
              Then use the characterization of
              %a{:href => "over-%28infinity%2C1%29-category#HamSpacesInASlice"} Hom-spaces in a slice
              to find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}(A,[Y,X]_{\mathbf{B}G})
              as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              on the left of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} /
                                  %mo{:stretchy => "false"} /
                                  %mi G
                                  %mo ,
                                  %msub
                                    %mi ρ
                                    %mi Y
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} /
                                  %mo{:stretchy => "false"} /
                                  %mi G
                                  %mo ,
                                  %mo{:stretchy => "false"} [
                                  %mi Y
                                  %mo ,
                                  %mi ρ
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ⊢
                                %mi α
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{/\mathbf{B}G}(A,[Y,X]_{\mathbf{B}G})
                    \&amp;\longrightarrow&amp;
                    \\mathbf{H}(A//G, [Y,X]//G) &amp;\to&amp; \mathbf{H}(A//G,[Y, X//G])
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{H}(A//G,\rho_Y)}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\mathbf{H}(A//G,[Y, \rho])}}
                    \\\
                    \\ast
                    \&amp;\stackrel{\vdash \alpha}{\longrightarrow}&amp;
                    \\mathbf{H}(A//G,\mathbf{B}G)
                    \&amp;\to&amp;
                    \\mathbf{H}(A//G,[Y, \mathbf{B}G])
                    }
                    \\,,
            %p
              Now using the Hom-adjunction in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              itself, the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(A//G,-)
              preserves
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              and the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              this is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi A
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ×
                            %mi Y
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ⊢
                                %mi α
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ×
                            %mi Y
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{/\mathbf{B}G}(A\times_{\mathbf{B}G} Y, X)
                    \&amp;\longrightarrow&amp;
                    \&amp;\longrightarrow&amp;
                    \\mathbf{H}(A//G \times Y, X //G)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \\ast
                    \&amp;\stackrel{\vdash \alpha}{\longrightarrow}&amp;
                    \\mathbf{H}(A//G,\mathbf{B}G)
                    \&amp;\to&amp;
                    \\mathbf{H}(A//G \times Y,  \mathbf{B}G)
                    }
                    \\,,
            %p
              Here the bottom map is indeed the name of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∘
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha \circ p_1
              and so again by the pullback characterization of
              %a{:href => "over-%28infinity%2C1%29-category#HamSpacesInASlice"} Hom-spaces in a slice
              this pasting diagram does exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}(A\times_{\mathbf{B}G} Y, X)
              as indicated.
          %h3#ForCanonicalActionOnCosetSpace For the canonical action on a coset space
          %p
            Conversely, for any
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \to G
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            given, then the canonical
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the stabilizer
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
          %p
            This follows from def.
            %a.maruku-ref{:href => "#StabilizerInInfinityTopos"}
            by observing that the homotopy fiber sequence of prop.
            %a.maruku-ref{:href => "#InfinityAction"}
            for the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            is just
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G/H &amp;\stackrel{}{\longrightarrow}&amp; \mathbf{B}H
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
          %p
            so that for any point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} x \colon \ast \to G/H
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Ω
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Ω
                    %mo *
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                  %mo ≃
                  %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Stab(x) \simeq \Omega_{x}(\mathbf{B}H) \simeq \Omega_\ast \mathbf{B}H \simeq H
                  \\,.
          %h3#StabilizersOfCoShapes Stabilizers of coshapes
          %p
            Dually to “stabilizers of shapes”, as
            %a{:href => "#KleinGeometry"} above
            one may consider stabilizers of “co-shapes”.
          %p
            I.e. given a
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f \colon X \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in the canonical
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,A]
          %p
            For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            here is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n}U(1)_{conn}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} f \colon X \to \mathbf{B}^n U(1)_{conn}
            is regarded as a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
            ,and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,A]
            is replaced by its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+concretification"} differential concretification
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-groups"} quantomorphism n-groups
          %blockquote
            %p to be expanded on
