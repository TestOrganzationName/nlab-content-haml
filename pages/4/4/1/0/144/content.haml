                            %mi op
                          %mo →
                        %annotation{:encoding => "application/x-tex"} X : C^{op} \to
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-quantity"} ∞-quantity
                    modeled on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                    is a cosimplicial copresheaf on
