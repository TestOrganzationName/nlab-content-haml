                    \\;\colon\;
                    \\Delta^{op}
                    \\longrightarrow
                    dgcAlg_{\mathbb{R}, \geq 0}
                    \\,.
          #PolynomialDifferentialForms.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Sym
                      %mi ℚ
                      %mo •
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                    %mo ,
                    %mi d
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi d
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %msub
                        %mi t
                        %mi i
                      %mo −
                      %mn 1
                      %mo ,
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi d
                      %msub
                        %mi t
                        %mi i
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{poly}^{\bullet}(\Delta^n)
                    \\;\coloneqq\;
                    Sym^\bullet_{\mathbb{Q}}
                    \\langle t_0, \cdots, t_n, d t_0, \cdots, d t_n\rangle/\left(\sum t_i -1, \sum d t_i \right)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
              over the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              in degree 0 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d t_i
              of degree 1.
            %p
              In particular in degree 0 this are called the
              %em polynomial functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi t
                        %mi i
                      %mo =
                      %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^0_{poly}(\Delta^n)
                    \\;=\;
                    \\mathbb{Q}[t_0, t_1, \cdots t_n]/\left( \underset{i}{\sum} t_i = 0 \right)
            %p due to the canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^0_{poly}(\Delta^n)
                    \\hookrightarrow
                    C^\infty(\Delta^n_{smth})
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothDifferentialFormsOnSmoothnSimplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              as the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of the polynomial differential forms over these polynomial functions with the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              = succeed "-simplex," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^n_{smth})
              of smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              = succeed ":" do
                %a.maruku-ref{:href => "#SmoothDifferentialFormsOnSmoothnSimplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi poly
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\Delta^n_{smth})
                    \\simeq
                    C^\infty(\Delta^n_{smth}) \otimes_{\Omega^0_{poly}(\Delta^n)}
                    \\Omega^\bullet_{poly}(\Delta^n)
            %p
              where moreover the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d t_i
              are identified with the de Rham differential of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p This defines a canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^n)
                    \\hookrightarrow
                    \\Omega^\bullet(\Delta^n_{smth})
            %p
              and there is uniquely the structure of a
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly}(\Delta^n)
              that makes this a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              = succeed "." do
                %em dg-algebra of polynomial differential forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f \colon [n_1] \to [n_1]
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of finite non-empty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(f)
                    \\;\colon\;
                    \\Omega^\bullet_{poly}(\Delta^{n_2}) \to \Omega^\bullet_{poly}(\Delta^{n_1})
            %p be the morphism of dg-algebras given on generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi t
                      %mi i
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi i
                    %msub
                      %mi t
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(f) : t_i \mapsto \sum_{f(j) = i} t_j
                    \\,.
            %p
              This yields a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %msub
                      %mi cdgcAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^{(-)}) : \Delta^{op} \to cdgcAlg_k
            %p which is a sub-simplicial object of that of smooth differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^{(-)})
                    \\hookrightarrow
                    \\Omega^\bullet(\Delta_{smth}^{(-)})
                    \\,.
          #AdjunctionBetweenSimplicialSetAnddgcAlgebras.num_defn
            %h6#definition_6 Definition
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/polynomial+differential+forms"} polynomial differential forms
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#PolynomialDifferentialForms"}
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
              in the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#dgcAlgebras"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %msubsup
                      %mi dgcAlg
                      %mrow
                        %mi ℚ
                        %mo ,
                        %mo ≥
                        %mn 0
                      %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}
                    \\;\colon\;
                    \\Delta
                    \\longrightarrow
                    dgcAlg_{\mathbb{Q}, \geq 0}^{op}
                    \\,.
            %p
              By the general discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              between the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mi ℚ
                        %mo ,
                        %mo ≥
                        %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#dgcAlgebras"}
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo ⊣
                    %msub
                      %mi 𝒦
                      %mi poly
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mi ℚ
                        %mo ,
                        %mo ≥
                        %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi K
                            %mi poly
                      %mover
                        %mo ⟵
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi poly
                            %mo •
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega^\bullet_{poly} \dashv \mathcal{K}_{poly})
                    \\;\colon\;
                    (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
                    \\underoverset
                    {\underset{K_{poly}}{\longrightarrow}}
                    {\overset{\Omega^\bullet_{poly}}{\longleftarrow}}
                    {\bot}
                    sSet
                    \\,.
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              is the
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %msub
                      %mo •
                      %mi poly
                  %annotation{:encoding => "application/x-tex"} \Omega \bullet_{poly}
              along the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo ↪
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} \Delta \hookrightarrow sSet
          %p
            This adjunction is an algebraic analog of the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            construction, which we briefly recall (for detailed exposition see at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} geometry of physics – homotopy types
          #SingluarNerveAndRealization.num_defn
            %h6#definition_7 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} on
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \on \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi top
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{top}
              for the
              %a.existingWikiWord{:href => "/nlab/show/n-simplex"} n-simplex
              canonically regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{smth}
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothnSimplex"}
              %a.maruku-ref{:href => "#PolynomialDifferentialForms"}
              this is a
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi top
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^{(-)}_{top}
                    \\;\colon\;
                    \\Delta \longrightarrow Top
            %p
              now in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p
              This also induces a
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Sing
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi Sing
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} |
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    ({\vert -\vert} \dashv Sing)
                    \\;\colon\;
                    Top
                    \\underoverset
                    {\underset{Sing}{\longrightarrow}}
                    {\overset{{\vert -\vert}}{\longleftarrow}}
                    {\bot}
                    sSet
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                  %annotation{:encoding => "application/x-tex"} Sing
              is the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              functor and the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert- \vert}
              is the
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              functor.
          #AdjunctionBetweenTopopologicalSpacesAnddgcAlgebras.num_defn
            %h6#definition_8 Definition
            %p
              Combining the
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              from def.
              %a.maruku-ref{:href => "#AdjunctionBetweenSimplicialSetAnddgcAlgebras"}
              and def.
              %a.maruku-ref{:href => "#SingluarNerveAndRealization"}
              we finally obtain a functorial association of differential forms to a topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi pwpoly
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mover
                      %mo ⟶
                      %mi Sing
                    %mi sSet
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi poly
                          %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mi ℚ
                        %mo ,
                        %mo ≥
                        %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{pwpoly}
                    \\;\colon\;
                    Top
                    \\overset{Sing}{\longrightarrow}
                    sSet
                    \\overset{\Omega^\bullet_{poly}}{\longrightarrow}
                    (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
            %p
              (foring “
              %a.existingWikiWord{:href => "/nlab/show/piecewise+polynomial+differential+forms"}> piecewise polynomial differential forms
              ”) and a functorial operation that turns every
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              into a topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mi ℚ
                        %mo ,
                        %mo ≥
                        %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi K
                          %mi poly
                    %mi sSet
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                    %mi Top
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spec
                    \\;\colon\;
                    (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
                    \\overset{K_{poly}}{\longrightarrow}
                    sSet
                    \\overset{\vert - \vert}{\longrightarrow}
                    Top
                    \\,.
          %h3#SullivanModels Sullivan models
          #SullivanAlgebra.num_defn
            %h6#definition_9 Definition
            %p
              %strong (Sullivan algebras)
            %p
              A
              %strong relative Sullivan algebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
              in non-negative degrees, hence a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi dgcAlg
                        %mrow
                          %mo ≥
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} dgcAlg_{\geq 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mo ∧
                      %mo •
                    %mi V
                    %mo ,
                    %mi d
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (A,d) \hookrightarrow (A \otimes_k \wedge^\bullet V, d')
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ↦
                    %mi a
                    %mo ⊗
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    a \mapsto a \otimes 1
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (A,d) \in dgcAlg_{\geq 0}
              any
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              some
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %ol
              %li
                %p
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/well+ordered+set"} well ordered set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  indexing a
                  %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi v
                          %mi α
                        %mo ∈
                        %mi V
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo ∈
                        %mi J
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{v_\alpha \in V| \alpha \in J\}
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                %p
                  writing
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mrow
                            %mo &lt;
                            %mi β
                        %mo ≔
                        %mi span
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mi α
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo &lt;
                        %mi β
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} V_{\lt \beta} \coloneqq span(v_\alpha | \alpha \lt \beta)
                  we have for all basis elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi β
                      %annotation{:encoding => "application/x-tex"} v_\beta
                  that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ′
                    %msub
                      %mi v
                      %mi β
                    %mo ∈
                    %mi A
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mo •
                    %msub
                      %mi V
                      %mrow
                        %mo &lt;
                        %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d' v_\beta \in A \otimes \wedge^\bullet V_{\lt \beta}
                    \\,.
            %p
              (See remark
              %a.maruku-ref{:href => "#MeaningOfOrderingCondition"}
              below for what this means.)
            %p
              Such a relative Sullivan algebra if called
              %strong minimal
              if in addition the degrees of these basis elements increase
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monotone+function"} monotonicly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo &lt;
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi deg
                    %msub
                      %mi v
                      %mi α
                    %mo ≤
                    %mi deg
                    %msub
                      %mi v
                      %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\alpha \lt \beta) \Rightarrow (deg v_\alpha  \leq deg v_\beta)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} A \in dgcAlg_{\geq 0}
              is such that the unique homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo ,
                    %mi d
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{Q}, d = 0) \hookrightarrow A
            %p
              is a (minimal) relative Sullivan algebra in the above sense, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is simply called a
              = succeed "." do
                %em (minimal) Sullivan algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = (\wedge^\bullet, d)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/semifree+dgc-algebra"} semifree dgc-algebra
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ,
                    %msub
                      %mi d
                      %mi 𝔤
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g})
                    \\coloneqq
                    (\wedge^\bullet \mathfrak{g}^\ast, d_\mathfrak{g} = [-,-]^\ast)
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
              in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#SullivanAlgebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+Lie+algebra"} nilpotent Lie algebra
          #GeneratingRelativeSullivanAlgebras.num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} ⟨
                    %mi c
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mi d
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S(n) \coloneqq (\wedge^\bullet \langle c \rangle, d = 0)
            %p
              be the dgc-algebra on a single generator in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              with vanishing differential.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⟨
                    %mi b
                    %mo{:stretchy => "false"} ⟩
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
                    %mi c
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mi b
                    %mo =
                    %mi c
                    %mo ,
                    %mi d
                    %mi c
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    D(n)
                    \\coloneqq
                    (\wedge^\bullet (\langle b \rangle \oplus \langle c \rangle), d b = c, d c = 0)
            %p
              be the dgc-algebra generated by an additional generator in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              such that the differential takes this to the previous generator.
            %p Then the canonical inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo ,
                    %mi d
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_0 \;\colon\; (\mathbb{Q},d = 0) \hookrightarrow S(0)
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_n \;\colon\; S(n) \hookrightarrow D(n)
            %p
              are relative Sullivan algebras according to
              = succeed "." do
                %a.maruku-ref{:href => "#SullivanAlgebra"}
            %p
              These are to be called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} generating cofibrations
              for the
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+dgc-algebras"} projective model structure on dgc-algebras
              below in theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectiveModelStructureOndgcAgebras"}
            %p Moreover, the inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo ,
                    %mi d
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{Q},d = 0) \hookrightarrow D(n)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              are relative Sullivan algebras.
            %p
              These are to be called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} generating acyclic cofibrations
              for the
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+dgc-algebras"} projective model structure on dgc-algebras
              below in theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectiveModelStructureOndgcAgebras"}
          %p
            (
            %a{:href => "#Hess06"}> Hess 06, p. 6
            )
          %p
            The examples in
            %a.maruku-ref{:href => "#GeneratingRelativeSullivanAlgebras"}
            are trivial, but they generate all examples of relative Sullivan algebras:
          #MeaningOfOrderingCondition.num_remark
            %h6#remark Remark
            %p
              The special condition on the ordering in the relative Sullivan algebra in def.
              %a.maruku-ref{:href => "#SullivanAlgebra"}
              says that these morphisms are
              %a.existingWikiWord{:href => "/nlab/show/transfinite+compositions"} transfinite compositions
              of
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              of the generating cofibrations in def.
              = succeed ":" do
                %a.maruku-ref{:href => "#GeneratingRelativeSullivanAlgebras"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi dgcAlg
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} A \in dgcAlg_{\geq 0}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⊗
                            %msup
                              %mo ∧
                              %mo •
                            %mo{:stretchy => "false"} ⟨
                            %mi b
                            %mo{:stretchy => "false"} ⟩
                            %mo ,
                            %mi d
                            %mi b
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S(n) &amp;\stackrel{\phi}{\longrightarrow}&amp; A
                    \\\
                    {}^{\mathllap{i_n}}\downarrow &amp;&amp; \downarrow
                    \\\
                    D(n)
                    \&amp;\longrightarrow&amp;
                    (A \otimes \wedge^\bullet \langle b \rangle, d b = \phi)
                    }
            %p
              is precisely a choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \phi \in A
              of a
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi A
                    %annotation{:encoding => "application/x-tex"} d_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and results in adjoining to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              whose differential is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi b
                      %mo =
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} d b = \phi
            %p This gives the condition in the above definition: the differential of any new element has to be a sum of wedge products of the old elements.
          #SullivanModel.num_defn
            %h6#definition_10 Definition
            %p
              %strong (Sullivan models)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong Sullivan (minimal) model
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a Sullivan (minimal) algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi V
                      %mo *
                    %mo ,
                    %msub
                      %mi d
                      %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\wedge^\bullet V^\ast, d_V)
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi V
                      %mo *
                    %mo ,
                    %msub
                      %mi d
                      %mi V
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi Ω
                      %mi pwpoly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\wedge^\bullet V^*, d_V)
                    \\stackrel{\simeq}{\longrightarrow}
                    \\Omega^\bullet_{pwpoly}(X)
            %p
              to the dg-algebra of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/piecewise+polynomial+differential+forms"} piecewise polynomial differential forms
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Minimal Sullivan models (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SullivanModel"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            e.g
            = succeed "." do
              %a{:href => "#Hess06"} Hess 06, prop 1.18
          %div
            %p
              %strong
                Examples of
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+models"} Sullivan models
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+an+n-sphere"} Sullivan model of an n-sphere
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+spherical+fibration"} Sullivan model of a spherical fibration
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+complex+projective+space"} Sullivan model of complex projective space
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+classifying+space"} Sullivan model of a classifying space
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+mapping+space"} Sullivan model of mapping space
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+free+loop+space"} Sullivan model of free loop space
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+suspension"} Sullivan model of a suspension
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+finite+G-quotient"} Sullivan model of a finite G-quotient
          %h3#HomotopyTheory Homotopy theory
          %h4#topological_homotopy_theory Topological homotopy theory
          %p
            We briefly recall classical statement of the equivalene of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theories"} homotopy theories
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            and of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            (
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"}> simplicial homotopy theory
            ), i.e. the “
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"}> homotopy hypothesis
            ”. For full exposition see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} geometry of physics – homotopy types
          #TopQuillen.num_theorem
            %h6#theorem Theorem
            %p
              Say that a
