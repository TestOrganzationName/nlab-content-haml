                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(X,\mathbb{Q})
                    \\;\simeq\;
                    H^\bullet( \Omega^\bullet_{pwpoly}(X), d_{dR} )
                    \\,.
          %p
            But more is true, also the rationalization of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            may be read off from any
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/minimal+Sullivan+model"} minimal Sullivan model
          #HomotopyGroupsFromSullivanGenerators.num_theorem
            %h6#theorem_7 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi V
                      %mo *
                    %mo ,
                    %msub
                      %mi d
                      %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\wedge^\bullet V^*, d_V)
              be a minimal Sullivan model of a simply connected rational topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(X)
                    \\simeq
                    V
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the generators of the minimal Sullivan model.
          %p
            e.g.
            = succeed "." do
              %a{:href => "#Hess06"} Hess 06, theorem 1.24
          .num_remark
            %h6#remark_2 Remark
            %p
              The need to restrict to
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+spaces"} simply connected topological spaces
              in theorem
              %a.maruku-ref{:href => "#SullivanRationalizationEquivalence"}
              is due to the existence of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+groups"} acyclic groups
              %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              such that their
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} B \Gamma
              has trival
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              in positive degree
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi Γ
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℚ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B \Gamma, \mathbb{Q}) \simeq \mathbb{Q}
                    \\,.
            %p
              Therefore, by corollary
              = succeed "," do
                %a.maruku-ref{:href => "#RationalCohomologyFromSullivanModel"}
              %a.existingWikiWord{:href => "/nlab/show/piecewise+polynomial+differential+forms"} piecewise polynomial differential forms
              do not distinguish such spaces from
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+topological+spaces"} contractible topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Gamma = 1
              is in fact the trivial group,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} B \Gamma
              is not contractible, instead it is the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\Gamma,1)
              with nontrivial
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi Γ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \pi_1(B \Gamma) \simeq \Gamma
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
          %h3#SullivanModelExamples Examples
          %h4#SullivanModelRationalSpheres
            Rational
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            We discuss the minimal Sullivan models of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+n-spheres"} rational n-spheres
          %p
            The minimal
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            of a
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S^{2k+1}
            of odd
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            is the dg-algebra with a single generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_{2k+1}
            in degre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 2k+1
            and vanishing differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{2k+1} = 0
                  \\,.
          %p
            The minimal
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            of a sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} S^{2k}
            of even dimension, for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} \omega_{2k}
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                %annotation{:encoding => "application/x-tex"} 2k
            and another generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 4
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_{4k-1}
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 4k+1
            with the differential defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{2k}= 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi ω
                    %mrow
                      %mn 4
                      %mi k
                      %mo +
                      %mn 1
                  %mo =
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo ∧
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \omega_{4k+1} = \omega_{2k}\wedge \omega_{2k}
                  \\,.
          %p
            One may understand this form theorem
            = succeed ":" do
              %a.maruku-ref{:href => "#HomotopyGroupsFromSullivanGenerators"}
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                  %mo ∧
                  %msub
                    %mi ω
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} \omega_{2k}\wedge \omega_{2k}
            needs to be canceled in cohomology. That is accomplished by the second generator
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \omega_{4k-1}
          %p
            Again by theorem
            = succeed "," do
              %a.maruku-ref{:href => "#HomotopyGroupsFromSullivanGenerators"}
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            are concentrated, in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 2k+1
            for the odd
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                %annotation{:encoding => "application/x-tex"} 2k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi k
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 4k-1
            in for the even
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 2k
          %p
            For instance the
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            has rational homotopy in degree 4 and 7. The one in degree 7 being represented by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
          %h2#QuillenApproach Quillen approach
          %p
            We briefly review Quillen’s approach to rational homotopy theory (
            %a{:href => "#Quillen69"}> Quillen 1969
            ), see for instance
            = succeed "." do
              %a{:href => "#GriffithsMorgan13"} Griffiths &amp; Morgan 2013, chapter 17
          %p
            The following sequence of six consecutive functors, each of which is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            %a.existingWikiWord{:href => "/nlab/show/n-connected+space"} 1-connected
            rational space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
          %p
            One starts with the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+infinity-groupoid"} singular simplicial set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S(X)
          %p
            and throws away all the simplices except the basepoint in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reduced+simplicial+set"} reduced simplicial set
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            functor, see
            = succeed ")" do
              %a{:href => "simplicial+group#AsInfinityGroups"} here
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(X)
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G S(X).
          %p
            Then one forms its
            %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Q}[G S(X)]
          %p
            and completes it with respect to powers of its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/augmentation+ideal"} augmentation ideal
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℚ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbb{Q}[G S(X)],
          %p
            which happens to be cocommutative, since the group ring is cocommutative. Taking degreewise
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/primitive+element"} primitives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prim
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi ℚ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Prim(\hat \mathbb{Q}[G  S(X)]).
          %p
            At the next stage, the
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} normalized chains functor
            is applied, to get Quillen’s
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            model of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Prim
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi ℚ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N^\bullet(Prim(\hat \mathbb{Q}[G S(X)])).
          %p
            Finally, to get a cocommutative dg
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            model for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            One may think of this procedure as doing the following: we are taking the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of the “group”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            which is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
          %h2#synthetic_approach Synthetic approach
          %p
            With the development of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            in the 2010s, it is now possible to do rational homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/synthetic+homotopy+theory"} synthetically
            in homotopy type theory.
          %p
            In particular, homotopy type theory allows one to define rational homotopy types directly in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+types"} pointed types
          %p
            A pointed type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,t)
            is a
            %strong rational homotopy type
            if it is 1-connected and all of its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/torsion-free+divisible+groups"} torsion-free divisible groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isRational
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %mi{:mathvariant => "normal"} isTorsionFree
                  %mrow
                    %mo (
                    %msub
                      %mrow
                        %mo [
                        %msup
                          %mi Ω
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mn 0
                    %mo )
                  %mo ×
                  %mi{:mathvariant => "normal"} isDivisible
                  %mrow
                    %mo (
                    %msub
                      %mrow
                        %mo [
                        %msup
                          %mi Ω
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mn 0
                    %mo )
                  %mo ×
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo →
                      %mi 𝟙
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi 𝟙
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %msub
                      %mrow
                        %mo [
                        %mi{:mathvariant => "normal"} fiber
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mn 1
                    %mo )
                %annotation{:encoding => "application/x-tex"} isRational(T,t) \coloneqq \prod_{n:\mathbb{N}} \mathrm{isTorsionFree}\left(\left[\Omega^n(T,t)\right]_0\right) \times \mathrm{isDivisible}\left(\left[\Omega^n(T,t)\right]_0\right) \times \prod_{f:T \to \mathbb{1}} \prod_{a:\mathbb{1}} \mathrm{isContr}\left(\left[\mathrm{fiber}(f, a)\right]_{1}\right)
          %p
            The
            %strong rationalization
            of a pointed 1-connected type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,t)
            is a rational homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V,v)
            with a point-preserving function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi T
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \phi:T \to V
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            induces an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            on
            %span.newWikiWord
              rationalized
              %a{:href => "/nlab/new/rationalization+of+an+abelian+group"} ?
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          %h2#properties Properties
          %h3#preservation_of_homotopy_pullbacks Preservation of homotopy pullbacks
          .num_theorem
            %h6#theorem_8 Theorem
            %p
              The left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mi sSet
                    %mo →
                    %msubsup
                      %mi dgcAlg
                      %mi ℚ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly} \colon sSet \to dgcAlg^{\geq 0}_{\mathbb{Q}}
              (thorem
              = succeed ")" do
                %a.maruku-ref{:href => "#SullivanRationalizationAdjunction"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of objects of
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              (each rational homotopy group is a
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
              over the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %p
              In other words in the induced pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo ⊣
                    %mrow
                      %msub
                        %mrow
                          %mo |
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo |
                        %mi poly
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi dgcAlg
                      %mi ℚ
                      %mrow
                        %mo ≥
                        %mn 0
                    %msup
                      %mo
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo ⇆
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega^\bullet_{poly} \dashv {\left\vert -\right\vert_{poly}})
                    \\;\colon\;
                    (dgcAlg^{\geq 0}_\mathbb{Q}^{op})^\circ
                    \\leftrightarrows
                    \\infty Grpd
            %p
              the left adjoint preserves
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-categorical pullbacks
              of objects of finite type.
          .proof
            %h6#proof Proof
            %p
              This is the restatement of a result that appears, effectively, below
              %a{:href => "#FelixHalperinThomas00"} Félix, Halperin &amp; Thomas 2000, Prop. 15.8
              and is reproduced in some repackaged form as
              = succeed "." do
                %a{:href => "#Hess06"} Hess 06, theorem 2.2
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category-theoretic
              context that allows to rephrase this result in the above form.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo →
                    %mi c
                    %mo ←
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} C = \{a \to c \leftarrow b\}
              be the pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              category.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              functor is the right
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msub
                      %mi lim
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} lim_C
              for the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (described in detail at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi lim
                            %mi C
                      %mover
                        %mo ←
                        %mi const
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C,sSet]_{inj} \stackrel{\overset{const}{\leftarrow}}{\underset{lim_C}{\to}}
                    sSet
                    \\,.
            %p
              At
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              it is discussed that composition with the Quillen pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo ⊣
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet \dashv K
              induces a Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msup
                      %mi Ω
                      %mi bullet
                    %mo{:stretchy => "false"} ]
                    %mo ⊣
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msup
                      %mi dgcAlg
                      %mi op
                    %mo{:stretchy => "false"} ]
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %mi K
                          %mo{:stretchy => "false"} ]
                      %mover
                        %mo ←
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ([C,\Omega^bullet] \dashv [C,K])
                    \:
                    [C, dgcAlg^{op}]
                    \\stackrel{\overset{[C,\Omega^\bullet]}{\leftarrow}}{\underset{[C,K]}{\to}}
                    [C,sSet]
                    \\,.
            %p
              We need to show that for every fibrant and cofibrant pullback diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F \in [C,sSet]
              there exists a weak equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo ∘
                    %msub
                      %mi lim
                      %mi C
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi lim
                      %mi C
                    %mover
                      %mrow
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet \circ lim_C F
                    \\;\;
                    \\simeq
                    \\;\;
                    lim_C   \widehat{\Omega^\bullet(F)}
                    \\,,
            %p
              here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\Omega^\bullet(F)}
              is a fibrant replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(F)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi dgcAlg
                        %mi op
                    %annotation{:encoding => "application/x-tex"} dgcAlg^{op}
            %p
              Every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} f \in [C,sSet]_{inj}
              is cofibrant. It is fibrant if all three objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(b)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              are fibrant and one of the two morphisms is a fibration. Let us assume without restriction of generality that it is the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(a) \to F(c)
              that is a fibration. So we assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(a), F(b)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              are three
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(a) \to F(b)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mi C
                  %annotation{:encoding => "application/x-tex"} lim_C
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mi C
                    %mi F
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} lim_C F = F(a) \times_{F(c)} F(b)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(F(a) \times_{F(c)} F(b))
                    \\,.
            %p
              Recall that the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dgcAlg
                    %annotation{:encoding => "application/x-tex"} dgcAlg
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi dgcAlg
                        %mi op
                    %annotation{:encoding => "application/x-tex"} dgcAlg^{op}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(F)
              may be obtained by
            %ul
              %li
                %p
                  first choosing a
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo ∧
                          %mo •
                        %mi V
                        %mo ,
                        %msub
                          %mi d
                          %mi V
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\wedge^\bullet V, d_V) \stackrel{\simeq}{\to} \Omega^\bullet(c)
              %li
                %p
                  then choosing factorizations in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dgcAlg
