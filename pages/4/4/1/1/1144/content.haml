                    %mrow
                      %msup
                        %mi F
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F^n
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^n_{smth})
              for the graded
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              defined this way. By definition there is then a canonical linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
