                %p
                  (with aspects of the generalizing to
                  %a.existingWikiWord{:href => "/nlab/show/Borel-equivariant+rational+homotopy+theory"} Borel-equivariant rational homotopy theory
                  for non-
                  %a.existingWikiWord{:href => "/nlab/show/nilpotent+spaces"}> nilpotent spaces
                  )
            %li#Majewski00
              %p
                Martin Majewski,
                = succeed "," do
                  %em Rational homotopy models and uniqueness
                %strong 143
                682 (2000) &amp;lbrack;
                %a{:href => "https://doi.org/10.1090/memo/0682"}> doi:10.1090/memo/0682
                \&amp;rbrack;
            %li#Hess06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"}> Kathryn Hess
                ,
                = succeed "," do
                  %em Rational homotopy theory: a brief introduction
                = succeed "," do
                  %em
                    %a{:href => "https://jdc.math.uwo.ca/summerschool/"} Summer School on Interactions between Homotopy Theory and Algebra
                = succeed "&rbrack;," do
                  %a{:href => "http://arxiv.org/abs/math.AT/0604626"} arXiv:math.AT/0604626
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Christensen"} Dan Christensen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"} William Dwyer
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                (eds.),
                = succeed "," do
                  %em Interactions between Homotopy Theory and Algebra
                = succeed "," do
                  %strong 436
                = succeed "&rbrack;" do
                  %a{:href => "http://dx.doi.org/10.1090/conm/436"} doi:10.1090/conm/436
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"}> Yves Félix
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Oprea"} John Oprea
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Tanr%C3%A9"} Daniel Tanré
                = succeed "," do
                  %em Algebraic models in geometry
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/tanre.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://global.oup.com/academic/product/algebraic-models-in-geometry-9780199206520"} ISBN:9780199206520
            %li#Moerman15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joshua+Moerman"}> Joshua Moerman
                ,
                %em Rational Homotopy Theory
                (2015) &amp;lbrack;
                %a{:href => "https://www.ru.nl/publish/pages/813282/rational_homotopy_theory.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/MoermanRationalHomotopyTheory.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Speirs"}> Martin Speirs
                ,
                = succeed "," do
                  %em Model Categories with a view towards rational homotopy theory
                = succeed "," do
                  %a{:href => "https://speirs.sites.ku.dk/files/2017/10/Master.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Speirs-ModelCategories.pdf", :title => "pdf"} pdf
            %li#FelixHalperin
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"}> Yves Félix
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Steve+Halperin"} Steve Halperin
                = succeed "," do
                  %em Rational homotopy theory via Sullivan models: a survey
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1708.05245"} arXiv:1708.05245
                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.4310/ICCM.2017.v5.n2.a3"} doi:10.4310/ICCM.2017.v5.n2.a3
            %li#Ivanov22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+O.+Ivanov"}> Sergei O. Ivanov
                ,
                = succeed "," do
                  %em An Overview of Rationalization Theories of Non-simply Connected Spaces and Non-nilpotent Groups
                %strong 38
                (2022) 1705–1721 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2111.10694"}> arXiv:2111.10694
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s10114-022-2063-9"} doi:10.1007/s10114-022-2063-9
          %p
            Review that makes the
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
            aspect completely manifest:
          %ul
            %li#BuijsFelixMurillo12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"}> Urtzi Buijs
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"} Yves Félix
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
                    \-rational homotopy of mapping spaces
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
                    \-models of based mapping spaces
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1209.4756"} arXiv:1209.4756
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2969/jmsj/06320503"} doi:10.2969/jmsj/06320503
              %blockquote
                %p
                  (which otherwise is about
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/Sullivan+models+of+mapping+spaces"} Sullivan models of mapping spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+A.+Voronov"}> Alexander A. Voronov
                ,
                = succeed "," do
                  %em Rational Homotopy Theory
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Encyclopedia+of+Mathematical+Physics+2nd+ed"} Encyclopedia of Mathematical Physics 2nd ed
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2404.00939"} arXiv:2404.00939
          %p More on the Quillen model:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"}> Urtzi Buijs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"} Yves Félix
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Tanr%C3%A9"} Daniel Tanré
              = succeed "," do
                %em Lie Models in Topology
              = succeed "," do
                %strong 335
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-030-54430-0"} doi:10.1007/978-3-030-54430-0
          %p
            The above description of the Quillen approach draws on blog comments by
            %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"} Kathryn Hess
            %a{:href => "http://golem.ph.utexas.edu/category/2010/01/this_weeks_finds_in_mathematic_50.html#c030961"} here
            and by
            %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"} David Ben-Zvi
            = succeed "." do
              %a{:href => "http://golem.ph.utexas.edu/category/2010/01/this_weeks_finds_in_mathematic_50.html#c031038"} here
          %p
            An extension of rational homotopy theory to describe (some) non-
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+spaces"} simply connected spaces
            is given, using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"} derived algebraic geometry
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
                ,
                = succeed "," do
                  %em Champs affines
                %strong 12
                (2006), no. 1, 39-135 (
                %a{:href => "https://arxiv.org/abs/math/0012219"}> arXiv:math/0012219
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00029-006-0019-z"} doi:10.1007/s00029-006-0019-z
              %p
                See in particular Cor. 2.4.11, Cor. 2.5.3 and Cor. 2.5.4, and the MathOverflow answer
                %a{:href => "http://mathoverflow.net/a/79309"} MO/79309
                by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"} Denis-Charles Cisinski
          %p
            Further discussion of rational homotopy theory seen within the theory of algebraic
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Section 1 of: DAG XIII:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Rational+and+p-Adic+Homotopy+Theory"} Rational and p-Adic Homotopy Theory
              = succeed "," do
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/DAG-XIII.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Lurie_RationalHomotopyTheory.pdf", :title => "pdf"} pdf
          %p
            Generalization to non-
            %a.existingWikiWord{:href => "/nlab/show/connected+spaces"} connected spaces
            is discussed in
          %ul
            %li#BuijsMurillo12
              %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"}> Urtzi Buijs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
              = succeed "," do
                %em
                  Algebraic models of non-connected spaces and homotopy theory of
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1204.4999"} arXiv:1204.4999
          %h3#relation_to_whitehead_products Relation to Whitehead products
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+products"} Whitehead products
          %ul
            %li#Quillen69
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                , section I.5 of
                = succeed "," do
                  %em Rational Homotopy Theory
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/1970725"} jstor:1970725
            %li
              %p
                Christopher Allday,
                = succeed "," do
                  %em Rational Whitehead products and a spectral sequence of Quillen
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.pjm/1102946308"} euclid:1102946308
            %li
              %p
                Christopher Allday,
                = succeed "," do
                  %em Rational Whitehead product and a spectral sequence of Quillen, II
                = succeed ")" do
                  %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.434.8821&rep=rep1&type=pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Phillip+Griffiths"} Phillip Griffiths
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Dennis+Sullivan"} Dennis Sullivan
                = succeed "," do
                  %em Real homotopy theory of Kähler manifolds
                %strong 29
                (1975) 245-274 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01389853"}> doi:10.1007/BF01389853
                \&amp;rbrack;
            %li
              %p
                Peter Andrews, Martin Arkowitz,
                = succeed "," do
                  %em Sullivan’s Minimal Models and Higher Order Whitehead Products
                = succeed ")" do
                  %a{:href => "https://doi.org/10.4153/CJM-1978-083-6"} doi:10.4153/CJM-1978-083-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francisco+Belch%C3%AD"}> Francisco Belchí
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"} Urtzi Buijs
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+M.+Moreno-Fern%C3%A1ndez"} José M. Moreno-Fernández
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
                = succeed "," do
                  %em
                    Higher order Whitehead products and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
                    structures on the homology of a DGL
                %strong 520
                (2017) 16-31 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1604.01478"}> arXiv:1604.01478
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.laa.2017.01.008"} doi:10.1016/j.laa.2017.01.008
            %li
              %p
                Takahito Naito,
                %em A model for the Whitehead product in rational mapping spaces
                (
