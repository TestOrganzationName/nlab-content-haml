                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \{x\} \times Y
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo =
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi F
                    %annotation{:encoding => "application/x-tex"} W = \bigcup F
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              there are neighborhoods
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              such that
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊗
                      %mi V
                      %mo ≤
                      %mi W
                    %annotation{:encoding => "application/x-tex"} U \otimes V \leq W
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi V
                    %mo :
                    %mi x
                    %mo ∈
                    %msub
                      %mi ψ
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{V: x \in \psi_W(V)\}
              thus covers
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi V
                        %mi n
                    %annotation{:encoding => "application/x-tex"} V_1, \ldots, V_n
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mi i
                      %msub
                        %mi ψ
                        %mi W
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U = \bigwedge_i \psi_W(V_i)
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              that
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                    %mo ≤
                    %msub
                      %mi ϕ
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ψ
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mi ϕ
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_i \leq \phi_W(\psi_W(V_i)) \leq \phi_W(U)
              (the last inequality is by contravariance), hence
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mi i
                      %msub
                        %mi V
                        %mi i
                      %mo ≤
                      %msub
                        %mi ϕ
                        %mi W
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Y = \bigvee_i V_i \leq \phi_W(U)
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi Y
                      %mo ≤
                      %mi W
                    %annotation{:encoding => "application/x-tex"} U \times Y \leq W
          %p
            Any
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo ∈
                  %mi X
                  %mo ⊗
                  %mi Y
                %annotation{:encoding => "application/x-tex"} w \in X \otimes Y
            can be represented as a supremum of elements of the form
            = succeed "," do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⊗
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \otimes v
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msup
                    %mi Y
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo :
                  %mi w
                  %mo ↦
                  %msub
                    %mi ϕ
                    %mi w
                %annotation{:encoding => "application/x-tex"} X \otimes Y \cong [X, Y^{op}]^{op}: w \mapsto \phi_w
            is that it allows one to give a canonical such representation:
          .num_defn
            %h6#definition Definition
            %p
              For sup-lattices
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X, Y
              %em canonical representation
              of
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi X
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} w \in X \otimes Y
              (as a sup of tensors
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⊗
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \otimes v
              with
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} u \in X
              = succeed ")" do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_95.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} v \in Y
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_96.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi u
                          %mo ∈
                          %mi X
                      %mi u
                      %mo ⊗
                      %msub
                        %mi ϕ
                        %mi w
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w = \bigvee_{u \in X} u \otimes \phi_w(u)
          %h2#preframe_representations Preframe representations
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %em preframe
              is a poset with directed joins and finite meets that distribute over directed joins. A
              %em preframe map
              is a poset map that preserves finite meets and directed joins.
          %p
            A frame is
            %em a fortiori
            a preframe. As far as the Tychonoff theorem is concerned, the decisive advantage of preframes is that the notion of compactness of frames can be described categorically in terms of preframe maps.
          %p
            Recall that a frame
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_97.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em compact
            if whenever its top element
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_98.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            is the join of a directed subset
            = succeed "," do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_99.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} J \subseteq X
            = succeed "." do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_100.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} \top \in J
          #char.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_101.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a frame, and let
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_102.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mo ⊤
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_\top: X \to \mathbf{2}
              be the characteristic map of the poset inclusion
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_103.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                      %mo :
                      %mn 1
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \top: 1 \hookrightarrow X
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_104.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %em compact
              iff
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_105.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \chi_\top
              is a preframe map. (Of course
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_106.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \phi_\top
              preserves finite meets for any frame, so the essential condition is preservation of directed joins.)
          %p
            An essential insight of Johnstone and Vickers is that since directed joins commute with finite meets, the theory of preframes is essentially a commutative theory, and thus the category of preframes forms a symmetric monoidal closed category; moreover, frames are exactly those preframes
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_107.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that the binary join operation
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_108.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                  %mo :
                  %mi X
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \vee: X \times X \to X
            is a preframe map in each separate variable. Thus, frames can be described either as commutative monoids
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_109.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ∧
                  %mo ,
                  %mo ⊤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \wedge, \top)
            in the smc category of sup-lattices, or as commutative monoids
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_110.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ∨
                  %mo ,
                  %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \vee, \bot)
            in the smc category of preframes. In either case, coproducts of frames can be described as tensor products in either of these smc categories, with preframe tensors offering a description that is, roughly speaking, “De Morgan dual” to the sup-lattice tensor description.
          %p
            This motivates a construction that is “De Morgan dual” to tensor products
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_111.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ⊗
                  %mi v
                %annotation{:encoding => "application/x-tex"} u \otimes v
            for elements
            = succeed "." do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_112.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi X
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} u \in X, v \in Y
          .num_defn
            %h6#definition_3 Definition
            %p
              For elements
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_113.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} u \in X
              and
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_114.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} v \in Y
              in frames
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_115.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X, Y
              %em par
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_116.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⅋
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \parr v
              in the sup-lattice
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_117.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \otimes Y
              by the formula
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_118.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⅋
                      %mi v
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo ⊗
                      %msub
                        %mo ⊤
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ∨
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ⊤
                        %mi X
                      %mo ⊗
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \parr v = (u \otimes \top_Y) \vee (\top_X \otimes v)
          %p The following proposition is easily checked.
          #prop.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (Johnstone-Vickers)
              If
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_119.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X, Y
              are frames, then
            %ol
              %li
                %p
                  For each
                  = succeed "," do
                    %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_120.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} u \in X
                  %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_121.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ⅋
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo :
                        %mi Y
                        %mo →
                        %mi X
                        %mo ⊗
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} u \parr -: Y \to X \otimes Y
                  is a preframe map, and similarly for each
                  %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_122.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} v \in Y
                  the map
                  %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_123.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ⅋
                        %mi v
                        %mo :
                        %mi X
                        %mo →
                        %mi X
                        %mo ⊗
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} - \parr v: X \to X \otimes Y
                  is a preframe map.
              %li
                %p
                  The map
                  %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_124.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⅋
                        %mo :
                        %mi X
                        %mo ×
                        %mi Y
                        %mo →
                        %mi X
                        %mo ⊗
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \parr: X \times Y \to X \otimes Y
                  preserves arbitrary sups (jointly in the two arguments).
              %li
                %p
                  %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_125.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi u
                        %mo ⊗
                        %mi v
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ⅋
                        %msub
                          %mo ⊥
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ⊥
                          %mi X
                        %mo ⅋
                        %mi v
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} u \otimes v = (u \parr \bot_Y) \wedge (\bot_X \parr v)
                  \.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Given frames
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_126.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X, Y
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_127.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi i
                        %mo ∈
                        %mi F
                    %msub
                      %mi u
                      %mi i
                    %mo ⊗
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigvee_{i \in F} u_i \otimes v_i
              can be expressed as a finite meet of pars.
          .proof
            %h6#proof Proof
            %p
              For each subset
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_128.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi F
                    %annotation{:encoding => "application/x-tex"} S \subseteq F
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_129.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi S
                    %mo ≔
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi i
                        %mo ∈
                        %mi S
                    %msub
                      %mi u
                      %mi i
                  %annotation{:encoding => "application/x-tex"} u_S \coloneqq \bigvee_{i \in S} u_i
              and
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_130.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi S
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi S
                      %msub
                        %mi v
                        %mi i
                    %annotation{:encoding => "application/x-tex"} v_S = \bigvee_{i \in S} v_i
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_131.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \neg S
              denote the complement
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_132.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∖
                      %mi S
                    %annotation{:encoding => "application/x-tex"} F \setminus S
            %p
              Exploiting Proposition
              %a.maruku-ref{:href => "#prop"}
              and finite distributivity in the frame
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_133.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \otimes Y
            .maruku-equation
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_134.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi i
                                %mo ∈
                                %mi F
                            %msub
                              %mi u
                              %mi i
                            %mo ⊗
                            %msub
                              %mi v
                              %mi i
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi i
                                %mo ∈
                                %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi u
                              %mi i
                            %mo ⅋
                            %msub
                              %mo ⊥
                              %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ⊥
                              %mi X
                            %mo ⅋
                            %msub
                              %mi v
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                              %mrow
                                %mi f
                                %mo :
                                %mi F
                                %mo →
                                %mo{:stretchy => "false"} {
                                %mi u
                                %mo ,
                                %mi v
                                %mo{:stretchy => "false"} }
                            %mrow
                              %mo [
                              %mo{:stretchy => "false"} (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %msup
                                    %mi f
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi u
                                  %mo{:stretchy => "false"} )
                              %msub
                                %mi u
                                %mi i
                              %mo ⅋
                              %msub
                                %mo ⊥
                                %mi Y
                              %mo{:stretchy => "false"} )
                              %mo ∨
                              %mo{:stretchy => "false"} (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %msup
                                    %mi f
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi v
                                  %mo{:stretchy => "false"} )
                              %msub
                                %mo ⊥
                                %mi X
                              %mo ⅋
                              %msub
                                %mi v
                                %mi i
                              %mo{:stretchy => "false"} )
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                              %mrow
                                %mi S
                                %mo ⊆
                                %mi F
                            %msub
                              %mi u
                              %mi S
                            %mo ⅋
                            %msub
                              %mi v
                              %mrow
                                %mo ¬
                                %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bigvee_{i \in F} u_i \otimes v_i &amp; = &amp; \bigvee_{i \in F} (u_i \parr \bot_Y) \wedge (\bot_X \parr v_i) \\
                    \&amp; = &amp; \bigwedge_{f: F \to \{u, v\}} \left[(\bigvee_{i \in f^{-1}(u)} u_i \parr \bot_Y) \vee (\bigvee_{i \in f^{-1}(v)} \bot_X \parr v_i)\right] \\
                    \&amp; = &amp; \bigwedge_{S \subseteq F} u_S \parr v_{\neg S}
                    }
            %p which proves the proposition.
          %p
            This leads to a canonical preframe representation of elements
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_135.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo ∈
                  %mi X
                  %mo ⊗
                  %mi Y
                %annotation{:encoding => "application/x-tex"} w \in X \otimes Y
            in a frame coproduct, where
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_136.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            is expressed as a directed join of finite meets of par expressions. We have
          .maruku-equation
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_137.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi w
                        %mtd
                          %mo =
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi u
                              %mo ∈
                              %mi X
                          %mi u
                          %mo ⊗
                          %msub
                            %mi ϕ
                            %mi w
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi finite
                              %mspace{:width => "thickmathspace"}
                              %mi F
                              %mo ⊆
                              %mi X
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi u
                              %mo ∈
                              %mi F
                          %mi u
                          %mo ⊗
                          %msub
                            %mi ϕ
                            %mi w
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi fin
                              %mo .
                              %mspace{:width => "thickmathspace"}
                              %mi F
                              %mo ⊆
                              %mi X
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                            %mrow
                              %mi S
                              %mo ⊆
                              %mi F
                          %mrow
                            %mo [
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi u
                                %mo ∈
                                %mi S
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo ⅋
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi u
                                %mo ∉
                                %mi S
                            %msub
                              %mi ϕ
                              %mi w
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  w &amp; = &amp; \bigvee_{u \in X} u \otimes \phi_w(u) \\
                  \&amp; = &amp; \bigvee_{finite\; F \subseteq X} \bigvee_{u \in F} u \otimes \phi_w(u) \\
                  \&amp; = &amp; \bigvee_{fin.\; F \subseteq X} \bigwedge_{S \subseteq F} \left[(\bigvee_{u \in S} u) \parr (\bigvee_{u \notin S} \phi_w(u))\right]
                  }
          %h2#finitary_tychonoff_theorem Finitary Tychonoff theorem
          %p
            Now suppose
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_138.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X, Y
            are compact frames, which by Proposition
            %a.maruku-ref{:href => "#char"}
            means precisely that the characteristic maps
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_139.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mrow
                      %msub
                        %mo ⊤
                        %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \chi_{\top_X}: X \to \mathbf{2}
            and
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_140.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mrow
                      %msub
                        %mo ⊤
                        %mi Y
                  %mo :
                  %mi Y
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \chi_{\top_Y}: Y \to \mathbf{2}
            preserve directed joins and finite meets.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Finitary Tychonoff theorem)
              The frame
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_141.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \otimes Y
              is compact.
          %p
            Before giving the proof, we might as well say where it comes from. We have remarked earlier that the category of preframes is symmetric monoidal closed; let
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_142.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            denote its monoidal product. Then, as
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_143.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is a frame, the map
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_144.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \vee: \mathbf{2} \times \mathbf{2} \to \mathbf{2}
            is a preframe map in each separate variable, and thus induces a canonical preframe map (which we again denote by
            = succeed "):" do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_145.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                  %annotation{:encoding => "application/x-tex"} \vee
            = succeed "." do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_146.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo ⅋
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2} \parr \mathbf{2} \to \mathbf{2}
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_147.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mrow
                      %msub
                        %mo ⊤
                        %mi X
                %annotation{:encoding => "application/x-tex"} \chi_{\top_X}
            and
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_148.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mrow
                      %msub
                        %mo ⊤
                        %mi Y
                %annotation{:encoding => "application/x-tex"} \chi_{\top_Y}
            are preframe maps by assumption, we may form a composite of preframe maps
          .maruku-equation
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_149.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⅋
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi χ
                        %mrow
                          %msub
                            %mo ⊤
                            %mi X
                      %mo ⅋
                      %msub
                        %mi χ
                        %mrow
                          %msub
                            %mo ⊤
                            %mi Y
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo ⅋
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mover
                    %mo →
                    %mo ∨
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo .
                %annotation{:encoding => "application/x-tex"} X \parr Y \stackrel{\chi_{\top_X} \parr \chi_{\top_Y}}{\to} \mathbf{2} \parr \mathbf{2} \stackrel{\vee}{\to} \mathbf{2}.
          %p
            Call this preframe map
            = succeed "." do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_150.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_151.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⅋
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \parr Y
            gives the coproduct of
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_152.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_153.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_154.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} h(w) = 1
            implies
            = succeed ";" do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_155.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo =
                    %msub
                      %mo ⊤
                      %mrow
                        %mi X
                        %mo ⅋
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} w = \top_{X \parr Y}
            = succeed "," do
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_156.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %msub
                      %mi χ
                      %mrow
                        %msub
                          %mo ⊤
                          %mrow
                            %mi X
                            %mo ⅋
                            %mi Y
                  %annotation{:encoding => "application/x-tex"} h = \chi_{\top_{X \parr Y}}
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_157.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_158.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is compact.
          %p Or so this is how Johnstone and Vickers proceed; our account circumvents the building up of the closed category infrastructure of preframes which lies in the conceptual background.
          .proof
            %h6#proof_2 Proof
            %p
              Exploiting the canonical preframe representation of elements
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_159.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi X
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} w \in X \otimes Y
              from the previous section, define
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_160.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h: X \otimes Y \to \mathbf{2}
              by the formula
            .maruku-equation
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_161.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi fin
                        %mo .
                        %mspace{:width => "thickmathspace"}
                        %mi F
                        %mo ⊆
                        %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mi S
                        %mo ⊆
                        %mi F
                    %mrow
                      %mo [
                      %msub
                        %mi χ
                        %mrow
                          %msub
                            %mo ⊤
                            %mi X
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi u
                          %mo ∈
                          %mi S
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo ∨
                      %msub
                        %mi χ
                        %mrow
                          %msub
                            %mo ⊤
                            %mi Y
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi u
                          %mo ∉
                          %mi S
                      %msub
                        %mi ϕ
                        %mi w
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ]
                  %annotation{:encoding => "application/x-tex"} h(w) = \bigvee_{fin.\; F \subseteq X} \bigwedge_{S \subseteq F} \left[\chi_{\top_X}(\bigvee_{u \in S} u) \vee \chi_{\top_Y}(\bigvee_{u \notin S} \phi_w(u))\right]
            %p
              Now
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_162.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              preserves directed joins and finite meets, due to the fact that directed joins and finite meets commute with directed joins and finite meets, and that
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_163.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                  %annotation{:encoding => "application/x-tex"} \vee
              preserves directed joins and finite meets in separate variables, and that
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_164.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ↦
                    %msub
                      %mi ϕ
                      %mi w
                  %annotation{:encoding => "application/x-tex"} w \mapsto \phi_w
              is a poset isomorphism (so preserves directed joins and finite meets).
            %p
              Now suppose
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_165.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} h(w) = 1
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_166.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F \subseteq X
              we have, for every subset
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_167.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi F
                    %annotation{:encoding => "application/x-tex"} S \subseteq F
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_168.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi u
                        %mo ∈
                        %mi S
                    %mi u
                    %mo =
                    %msub
                      %mo ⊤
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \bigvee_{u \in S} u = \top_X
              or
              = succeed "." do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_169.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi u
                          %mo ∉
                          %mi S
                      %msub
                        %mi ϕ
                        %mi w
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ⊤
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \bigvee_{u \notin S} \phi_w(u) = \top_Y
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_170.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊤
                      %mi X
                    %mo ⅋
                    %mi v
                    %mo =
                    %msub
                      %mo ⊤
                      %mrow
                        %mi X
                        %mo ⊗
                        %mi Y
                    %mo =
                    %mi u
                    %mo ⅋
                    %msub
                      %mo ⊤
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \top_X \parr v = \top_{X \otimes Y} = u \parr \top_Y
              for any
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_171.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi X
                      %mo ,
                      %mi v
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} u \in X, v \in Y
            .maruku-equation
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_172.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi w
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi fin
                                %mo .
                                %mspace{:width => "thickmathspace"}
                                %mi F
                                %mo ⊆
                                %mi X
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                              %mrow
                                %mi S
                                %mo ⊆
                                %mi F
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi u
                                %mo ∈
                                %mi S
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo ⅋
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi u
                                %mo ∉
                                %mi S
                            %msub
                              %mi ϕ
                              %mi w
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                              %mrow
                                %mi fin
                                %mo .
                                %mspace{:width => "thickmathspace"}
                                %mi F
                                %mo ⊆
                                %mi X
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                              %mrow
                                %mi S
                                %mo ⊆
                                %mi F
                            %msub
                              %mo ⊤
                              %mrow
                                %mi X
                                %mo ⊗
                                %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mo ⊤
                              %mrow
                                %mi X
                                %mo ⊗
                                %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    w &amp; = &amp; \bigvee_{fin.\; F \subseteq X} \bigwedge_{S \subseteq F} (\bigvee_{u \in S} u) \parr (\bigvee_{u \notin S} \phi_w(u)) \\
                    \&amp; = &amp; \bigvee_{fin.\; F \subseteq X} \bigwedge_{S \subseteq F} \top_{X \otimes Y} \\
                    \&amp; = &amp; \top_{X \otimes Y}
                    }
            %p
              Thus we have shown
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_173.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %msub
                      %mi χ
                      %mrow
                        %msub
                          %mo ⊤
                          %mrow
                            %mi X
                            %mo ⊗
                            %mi Y
                  %annotation{:encoding => "application/x-tex"} h = \chi_{\top_{X \otimes Y}}
              is a preframe map.
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (Tychonoff theorem)
              An arbitrary coproduct of compact frames
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_174.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sum_{i \in I} X_i
              is compact.
          .proof
            %h6#proof_3 Proof
            %p
              We may assume all the frames
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_175.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X_i
              are non-trivial, i.e. non-terminal. Then each coproduct inclusion
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_176.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊗
                        %mrow
                          %mi i
                          %mo ∈
                          %mi F
                      %msub
                        %mi X
                        %mi i
                      %mo ↪
                      %msub
                        %mo ⊗
                        %mrow
                          %mi j
                          %mo ∈
                          %mi F
                          %mo ′
                      %msub
                        %mi X
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \otimes_{i \in F} X_i \hookrightarrow \otimes_{j \in F'} X_j
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_177.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F, F'
              are finite subsets of
              %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_178.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and
              = succeed "," do
                %math#mathml_8dc3bb6751048ae95b7ef38684e83fcda1a759e8_179.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊆
                      %mi F
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F \subseteq F'
          %h2#references References
          %p#JV91
            Peter Johnstone and Steven Vickers,
            = succeed "," do
              %em Preframe presentation present
            %em Category Theory
            (Proceedings, Como 1990), Springer Lectures Notes in Mathematics 1488 (1991), 193-212. (
            %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.438.8880&rep=rep1&type=pdf"}> online pdf
            )
          %p
            Citation to this
            %a{:href => "http://dml.cz/bitstream/handle/10338.dmlcz/106680/CommentatMathUnivCarol_029-1988-4_3.pdf"} link
            to be added…
