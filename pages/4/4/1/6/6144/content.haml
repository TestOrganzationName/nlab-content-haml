          %p
            Recall the following properties of a
            %a.existingWikiWord{:href => "/nlab/show/Borel+measure"} Borel measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            on a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                is
                %strong outer regular
                if for every
                %a.existingWikiWord{:href => "/nlab/show/Borel+subset"} Borel subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi inf
                      %mo{:stretchy => "false"} {
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi V
                      %mo ⊃
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi and
                      %mspace{:width => "thickmathspace"}
                      %mi V
                      %mspace{:width => "thickmathspace"}
                      %mi is
                      %mspace{:width => "thickmathspace"}
                      %mi open
                      %mo{:stretchy => "false"} }
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mu(B)=\inf\{\mu(V)\mid V\supset B\; and\; V\; is\; open\}.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                is
                %strong locally finite
                if every point has a neighborhood with a finite
                = succeed "-measure." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi μ
                      %annotation{:encoding => "application/x-tex"} \mu
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                is
                %strong inner regular
                on some
                %a.existingWikiWord{:href => "/nlab/show/Borel+subset"} Borel subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                if
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi sup
                      %mo{:stretchy => "false"} {
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi K
                      %mo ⊂
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi and
                      %mspace{:width => "thickmathspace"}
                      %mi K
                      %mspace{:width => "thickmathspace"}
                      %mi is
                      %mspace{:width => "thickmathspace"}
                      %mi compact
                      %mo{:stretchy => "false"} }
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mu(B)=\sup\{\mu(K)\mid K\subset B\; and\; K\; is\; compact\}.
          %p
            Also, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            are
