                  %div
                    %p
                      %a{:href => "/nlab/edit/%28infinity%2C1%29-topos+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
