            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞𝒽
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{Ch}_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is regarded as default and silently assumed.
          %p
            An
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            A chain
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/coderivation"} coderivation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %msup
                    %mi T
                    %mi c
                  %mi V
                  %mo →
                  %msup
                    %mi T
                    %mi c
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  D : T^c V \to T^c V
          %p
            on the reduced tensor coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mi c
                  %mi V
                  %mo =
                  %msub
                    %mo ⊕
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                  %msup
                    %mi V
                    %mrow
                      %mo ⊗
                      %mi n
                %annotation{:encoding => "application/x-tex"} T^c V = \oplus_{n\geq 1} V^{\otimes n}
            (with the standard noncocommutative coproduct, see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+Hopf+algebra"} differential graded Hopf algebra
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mn 2
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D^2 = 0
                  \\,.
          %p
            Coderivations on free coalgebras are entirely determined by their “value on cogenerators”, which allows one to decompose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as a sum:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %msub
                    %mi D
                    %mn 1
                  %mo +
                  %msub
                    %mi D
                    %mn 2
                  %mo +
                  %msub
                    %mi D
                    %mn 3
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  D = D_1 + D_2 + D_3 + \cdots
          %p
            with each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi k
                %annotation{:encoding => "application/x-tex"} D_k
            specified entirely by its action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi k
                  %mo :
                  %msup
                    %mi V
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo →
                  %mi V
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_k : V^{\otimes k} \to V
                  \\,.
          %p
            which is a map of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo −
                  %mi k
                %annotation{:encoding => "application/x-tex"} 2-k
            (or can be alternatively understood as a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi k
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo →
                  %mi V
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} D_k : (V[1])^{\otimes k}\to V[1]
            of degree
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p Then:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 1
                      %mo :
                      %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} D_1 : V\to V
                is the
                %em differential
                with
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi D
                          %mn 1
                          %mn 2
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} D_1^2 = 0
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 2
                      %mo :
                      %msup
                        %mi V
                        %mrow
                          %mo ⊗
                          %mn 2
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} D_2 : V^{\otimes 2} \to V
                is the
                %em product
                in the algebra;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 3
                      %mo :
                      %msup
                        %mi V
                        %mrow
                          %mo ⊗
                          %mn 3
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} D_3 : V^{\otimes 3} \to V
                is the
                %em associator
                which measures the failure of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} D_2
                to be associative;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 4
                      %mo :
                      %msup
                        %mi V
                        %mrow
                          %mo ⊗
                          %mn 4
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} D_4 : V^{\otimes 4} \to V
                is the
                %em pentagonator
                (or so) which measures the failure of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} D_3
                to satisfy the pentagon identity;
            %li
              %p and so on.
          %p
            One can also allow
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} D_0
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            There is a resolution of the operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Ass
                %annotation{:encoding => "application/x-tex"} \mathrm{Ass}
            of associative algebras (as operad on the category of chain complexes) which is called the
            = succeed "-operad;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/A-infinity+operad"} operad
            are precisely the
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            A
            %strong
              morphism of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f : A\to B
            is a collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi f
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \lbrace f_n\rbrace_{n\geq 1}
            of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi n
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  f_n : (A[1])^{\otimes n}\to B[1]
          %p
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            satisfying
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo +
                      %mi j
                      %mo ≤
                      %mi n
                  %msub
                    %mi f
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                      %mo +
                      %mn 1
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msup
                    %mn 1
                    %mrow
                      %mo ⊗
                      %mi i
                  %mo ⊗
                  %msub
                    %mi D
                    %mrow
                      %mi n
                      %mo −
                      %mi i
                      %mo −
                      %mi j
                  %mo ⊗
                  %msup
                    %mn 1
                    %mrow
                      %mo ⊗
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi i
                        %mi r
                      %mo =
                      %mi n
                  %msub
                    %mi D
                    %mi r
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi f
                    %mrow
                      %msub
                        %mi i
                        %mi r
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{0\leq i+j\leq n} f_{i+j+1}\circ(1^{\otimes i}\otimes D_{n-i-j}\otimes 1^{\otimes j})
                  \= \sum_{i_1+\ldots+i_r=n} D_r\circ (f_{i_1}\otimes\ldots \otimes f_{i_r}).
          %p
            For example,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ∘
                    %msub
                      %mi D
                      %mn 1
                    %mo =
                    %msub
                      %mi D
                      %mn 1
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1\circ D_1 = D_1\circ f_1
          %h4#rectification Rectification
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Kadeishvili (1980), Merkulov (1999))
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} chain cohomology
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^\bullet(A)
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              with trivial differentials, naturally carries the structure of an
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as an
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            More details are at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kadeishvili%27s+theorem"} Kadeishvili's theorem
          .num_remark
            %h6#remark Remark
            %p
              This theorem provides a large supply of examples of
              = succeed "-algebras:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
            %p etc.
          %h3#in_topological_space In Topological space
          %p
            An
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is also called an
            %em
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
            \.
          %h4#examples Examples
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            is canonically an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
          %h4#rectification_2 Rectification
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Every
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weakly homotopy equivalent
              to a topological
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
          %p
            This is a classical result by (
            %a{:href => "#Stasheff63"}> Stasheff 1963
            ,
            = succeed ")." do
              %a{:href => "#BoardmanVogt"} BoardmanVogt
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+an+operad"} model structure on algebras over an operad
            (see there).
          %h3#in_spectra In spectra
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra+spectrum"} algebra spectrum
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong>
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
                  \-algebra
                ,
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E-category"} A-∞-category
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/augmented+A-%E2%88%9E+algebra"} augmented A-∞ algebra
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/curved+A-%E2%88%9E+algebra"} curved A-∞ algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/An-space"} An-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A-n+algebra"} A-n algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"}> L-∞ algebra
                , .
          %div
            %table
              %thead
                %tr
                  %th
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"} (∞,1)-operad
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-operad"} ∞-algebra
                  %th grouplike version
                  %th
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  %th generally
              %tbody
                %tr
