                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            which is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie version
            of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
