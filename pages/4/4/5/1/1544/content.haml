                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G Bund_\nabla(X) := Hom(X,\mathbf{B}G_{conn})
                    \\,.
          %p
            Explicitly, a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} g : X \to \mathbf{B}G
            is a nonabelian
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with values in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ol
            %li
              %p
                a choice of
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                a collection of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g_{i j} \in C^\infty(U_i \cap U_j), G)
          %p
            such that on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ∩
                  %msub
                    %mi U
                    %mi k
                %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
            the equation
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mi g
                      %mrow
                        %mi j
                        %mi k
                    %mo =
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi k
                  %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
          %p holds.
          %p
            A lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla : X \to \mathbf{B}G_{conn}
            of this is in addition
          %ol
            %li
              a choice of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A_i \in \Omega^1(U_i, \mathfrak{g}))
          %p
            such that on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                %annotation{:encoding => "application/x-tex"} U_i \cap U_j
            the equation
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi j
                    %mo =
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mi A
                      %mi i
                    %mi g
                    %mo +
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi d
                    %mi g
                  %annotation{:encoding => "application/x-tex"} A_j = g^{-1} A_i g + g^{-1} d g
          %p
            holds, where on the right we have the pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                  %mi θ
                %annotation{:encoding => "application/x-tex"} g^* \theta
            of the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (see there).
          %h2#Properties Properties
          %h3#ExistenceOfConnections Existence of connections
          .num_defn
            %h6#definition_3 Definition
            %p
              %strong (existence of connections)
            %p
              Every
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(X, \bar \mathbf{B}G_{conn}) \to Hom(X,\mathbf{B}G)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
          .proof
            %h6#proof Proof
            %p
              Choose a
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\rho_i \in C^\infty(X,\mathbb{R}))
              subordinate to the
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              with respect to which a given cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g : X \to \mathbf{B}G
              is expressed:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mspace{:width => "thickmathspace"}
                        %mi not
                        %mspace{:width => "thickmathspace"}
                        %mi in
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ⇒
                        %msub
                          %mi ρ
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} (x \;not\; in\; U_i) \Rightarrow \rho_i(x) = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi ρ
                          %mi i
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \sum_i \rho_i = 1
                  \.
            %p Then set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo :
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi d
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_i := \sum_{i_0} \rho_{i_0}|_{U_{i_0}} (g_{i_0 i}|^{-1}_{U_{i_0}}) d_{dR} (g_{i_0 i}|_{U_{i_0}})
                    \\,.
            %p By slight abuse of notation we shall write this and similar expressions simply as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo :
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mi d
                      %mi dR
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_i := \sum_{i_0} \rho_{i_0}(g_{i_0 i}^{-1} d_{dR} g_{i_0 i})
                    \\,.
            %p
              Using the that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_{i j})
              satisfies its cocycle condition, one checks that this satisfies the cocycle condition for the 1-forms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi j
                            %mo −
                            %msubsup
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi A
                              %mi i
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                            %msub
                              %mi ρ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi g
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi d
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi j
                            %mo −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi i
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi i
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                            %msub
                              %mi ρ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi d
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi d
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_j - g_{i j}^{-1} A_i g_{i j}  &amp;=
                    \\sum_{i_0} \rho_{i_0} ( g_{i_0 j}^{-1} d g_{i_0 j} -
                    ( g_{i_0 i} g_{i j}) ^{-1} (d g_{i_0 i}) g_{i j} )
                    \\\
                    \&amp; =
                    \\sum_{i_0} \rho_{i_0} ( g_{i j}^{-1} d g_{i j} )
                    \\\
                    \&amp; =
                    g_{i j}^{-1} d g_{i j}
                    \\end{aligned}
                    \\,.
          %h2#special_cases Special cases
          %h3#connections_on_the_tangent_bundle Connections on the tangent bundle
          %p
            Connections on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
          %p
            They play a central role for instance on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian manifold
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Christoffel+symbol"} Christoffel symbol
          %h3#connections_in_physics Connections in physics
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            connections on bundles model
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                is a connection on a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                more generally is a connection on a
                = succeed "-principal" do
                  %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %li
              %p
                The field of
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
                is encoded in a connection on the
                = succeed "-principal" do
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
          %p
            For more on this see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory+and+physics"} higher category theory and physics
          %h2#generalizations Generalizations
          %h3#superconnections Superconnections
          %p
            Generalizing the parallel transport definition from ordinary manifolds to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/superconnection"} superconnection
          %h3#simonssullivan_structured_bundles Simons-Sullivan structured bundles
          %p
            When the notion of connection on a principal bundle is slightly coarsened, i.e. when more connections are regarded as being ismorphic than usual, one arrives at a structure called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Simons-Sullivan+structured+bundle"} Simons-Sullivan structured bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi U
                %annotation{:encoding => "application/x-tex"} G = U
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            of such bundles is a model for
            = succeed "." do
