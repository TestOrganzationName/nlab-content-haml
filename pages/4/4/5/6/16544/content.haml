                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msub
                      %mo ⨂
                      %mi B
