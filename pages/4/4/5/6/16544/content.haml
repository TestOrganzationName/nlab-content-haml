                          %semantics
                            %mrow
                              %mi B
                            %annotation{:encoding => "application/x-tex"} B
                      %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
                      of
                      %em rows
                      of
                      = succeed "-block" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi B
                              %mo ×
                              %mi B
                            %annotation{:encoding => "application/x-tex"} B \times B
                      %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            %p
              with (co)
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+composition"} Kleisli composition
              expressing the operation of block-
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"}> matrix multiplication
              \.
            %p
              In particular, on the (co)free algebras of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
