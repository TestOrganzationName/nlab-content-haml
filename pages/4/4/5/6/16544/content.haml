          %h2#idea Idea
          %p
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} Formally dually
            to how a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            has a
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            so also a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} P \colon \mathcal{C}\to\mathcal{C}
            has a Kleisli category: its
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi c
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f \colon c_1 \to c_2
            in the Kleisli category is a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\tilde f \colon P(c_1) \longrightarrow c_2
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
