                      %semantics
                        %mrow
                          %mi k
                          %mi Vec
                        %annotation{:encoding => "application/x-tex"} k Vec
                  of
                  = succeed "-vector" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
