                                  %mi p
                                  %mi B
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mo *
                                %msub
                                  %mo ⊕
                                  %mi B
                              %annotation{:encoding => "application/x-tex"} (p_B)^\ast \oplus_B
                  %li
                    %p
                      co-free
                      = succeed "-coalgebras" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi p
                                %mi B
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %msub
                                %mo ⊕
                                %mi B
                            %annotation{:encoding => "application/x-tex"} (p_B)^\ast \oplus_B
                %p
                  are both
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                  to the category
                  %a.existingWikiWord{:href => "/nlab/show/Vect"}
