                    %msub
                      %mi p
                      %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \bigotimes_B (p_B)^\ast k
              this statement holds in the sense of actual
              = succeed "-matrices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B \times B
