                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (as opposed to block matrices).
            %p
              Since every
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              admits
              %em some
              = succeed "-block" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
