                      %a.existingWikiWord{:href => "/nlab/show/coKleisli+category"} coKleisli category
                      of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                              %mi B
                          %annotation{:encoding => "application/x-tex"} \bigoplus_B
