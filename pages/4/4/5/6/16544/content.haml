            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi Jet
                  %annotation{:encoding => "application/x-tex"} P= Jet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
              (see
              = succeed ")." do
                %a{:href => "jet+comonad#Marvan86"} there
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            %li
              %a.existingWikiWord{:href => "/nlab/show/monad+%28in+computer+science%29"} monad (in computer science)
          %h2#references References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            between the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            over a given
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            with the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            (if it exists):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mark+Kleiner"}> Mark Kleiner
              ,
              = succeed "," do
                %em Adjoint monads and an isomorphism of the Kleisli categories
              %p
                Volume
                %strong 133
                1 (1990) 79-82 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0021-8693(90)90069-Z"}> doi:10.1016/0021-8693(90)90069-Z
                \&amp;rbrack;
          %p
            Some introductory material on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comonads"} comonads
            %a.existingWikiWord{:href => "/nlab/show/coalgebras"} coalgebras
            and
            = succeed ":" do
