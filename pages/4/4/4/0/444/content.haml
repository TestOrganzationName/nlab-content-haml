                  \&amp;&amp; d_1
                  \\\
                  \&amp; {}^f\nearrow &amp;&amp; \searrow^{f^{-1}}
                  \\\
                  d_0 &amp;&amp;\stackrel{Id_{d_0}}{\to} &amp;&amp; d_0
                  }
          %p (even unique fillers, due to the above).
          %p
            It suggests the sense that a Kan complex models an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/coskeletal"} coskeletal
            property requirement means that the homotopy type it represents has enough generality, not being constrained to be a 1-type.
          %p
          #NerveOfCategoriesIsFullyFaithfulFunctor.num_prop
            %h6 Proposition
            %p
              The nerve functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Cat
                    %mo ⟶
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"}
                    N \colon Cat \longrightarrow SSet
              (on
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/strict+categories"} strict categories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
          %p
            (e.g
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kerodon"} Kerodon
            = succeed ";" do
              %a{:href => "https://kerodon.net/tag/002Z"} Prop. 1.2.2.1
            = succeed ")" do
              %a{:href => "#Rezk22"} Rezk 2022, Prop. 4.10
          %p
            So
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            between
            %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small categories
            are in
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            with morphisms of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            between their nerves.
          %p
          #NerveOfCategoriesPreservesFiniteProducts.num_prop
            %h6 Proposition
            %p
              The nerve functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Cat
                    %mo ⟶
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"}
                    N \colon Cat \longrightarrow SSet
              (on
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/strict+categories"} strict categories
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                  to the terminal simplicial set,
              %li
                %p
                  any
                  %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/product+of+simplicial+sets"} product of simplicial sets
                  of the nerves of the factors:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ×
                        %mi 𝒟
                        %mspace{:width => "thickmathspace"}
                        %mo ↦
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi 𝒟
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        N \;\colon\;
                        \\mathcal{C} \times \mathcal{D}
                        \\;\mapsto\;
                        N(\mathcal{C})
                        \\times
                        N(\mathcal{D})
            %p
          .proof
            %h6 Proof
            %p
              By direct inspection, using that the
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in a
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              are just
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of morphisms of the two factor categories.
          %p
          #NerveOfCategoriesPreservesMappingObjects.num_prop
            %h6 Proposition
            %p
              The nerve functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Cat
                    %mo ⟶
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"}
                    N \colon Cat \longrightarrow SSet
              sends
              %a.existingWikiWord{:href => "/nlab/show/functor+categories"} functor categories
              to the
              %a.existingWikiWord{:href => "/nlab/show/function+complexes"} function complexes
              between the separate nerves:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\big(
                    Maps(\mathcal{X},\,\mathcal{A})
                    \\big)
                    \\;\simeq\;
                    Maps
                    \\big(
                    N(\mathcal{X})
                    ,\,
                    N(\mathcal{A})
                    \\big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have the following sequence of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
