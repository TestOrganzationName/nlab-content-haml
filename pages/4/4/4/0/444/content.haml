                  (
                  %a{:href => "natural+transformation#InTermsOfCartMon"}> here
                  );
              %li
                %p
                  the second step follow by Prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#NerveOfCategoriesIsFullyFaithfulFunctor"}
              %li
                %p
                  the third step follows by Prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#NerveOfCategoriesPreservesFiniteProducts"}
            %p
          .num_prop
            %h6#proposition_3 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the nerve of a locally small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              precisely if it satisfies the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mrow
                                %mi n
                                %mo +
                                %mi m
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi ⋯
                                %mo ∘
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ∘
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %msub
                              %mi S
                              %mi m
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mrow
                                    %mi ⋯
                                    %msub
                                      %mi d
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mi m
                                        %mo −
                                        %mn 1
                                    %mo ∘
                                    %msub
                                      %mi d
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mi m
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ∘
                                %mi ⋯
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %msub
                              %mi S
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S_{n+m}
                    \&amp;
                    \\overset
                    {\cdots \circ d_0 \circ d_0}
                    {\longrightarrow}
                    \&amp;
                    S_m
                    \\\
                    \\mathllap{
                    ^{
                    \\cdots d_{n+m-1}\circ d_{n+m}
                    }
                    }
                    \\big\downarrow &amp;&amp; \big\downarrow
                    \\\
                    S_n
                    \&amp;\underset{d_0 \circ \cdots d_0}{\longrightarrow}&amp;
                    S_0
                    }
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagrams.
          %p
            Unwrapping this definition inductively in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+m)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \geq 2
            are unique compositors, associators, pentagonators, etc of composition of 1-morphisms. No non-trivial such structure cells appear and no further higher cells appear.
          %p
            This characterization of categories in terms of nerves directly leads to the model of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/complete+Segal+spaces"} complete Segal spaces
            by replacing in the above discussion sets by
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            (or something similar, like
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullbacks
          %p
          #NerveOfACategoryIsTwoCoskeletal.num_prop
            %h6 Proposition
            %p
              The nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C)
              of a category is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
          (e.g.
          = succeed "," do
            %a{:href => "monadic+cohomology#Duskin75"} Duskin 1975, §0.18(b)
          = succeed ")" do
            %a{:href => "quasi-category#Joyal08"} Joyal 2008, Cor. 1.2
          %p
            Hence in the nerve of a category, all
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi i
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda[n]_i \hookrightarrow \Delta[n]
            have unique fillers for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \gt 3
            %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary
            inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \hookrightarrow \Delta[n]
            have unique fillers for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \geq 3
          %p In summary:
          %p
          #CoskeletalityOfSimplicialNervesOfCategories.num_remark
            %h6 Example
            %p
              %strong (coskeletality of simplicial nerves of categories)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (i.e. of a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              (Prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#NerveOfACategoryIsTwoCoskeletal"}
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"}
                boundary of an
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} n \geq 3
              encodes the
              = succeed "-condition" do
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-tuples
              of composable morphisms.
            %p
              Of course there is more to a category than its associativity condition, and hence the converse fails: Not every
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nerve+of+a+category"} nerve of a category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of the 2-simplex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \partial \Delta^2
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of the edges
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 0 \to 1 \to 2
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+horn"} inner horn
            %p
              In fact, a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              iff it has
              %em unique
              = succeed "-fillers" do
                %a.existingWikiWord{:href => "/nlab/show/inner+horn"}
                  inner
                  = succeed "-horn" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#sSetIsNerveOfCategoryIffAllInnerHornsHaveUniqueFillers"}
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletality
              already implies that all
              = succeed "-horns" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} k \geq 4
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k-1
              = succeed ")-cell." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              iff
            %ol
              %li
                %p
                  it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %li
                %p
                  all
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/inner+horn"} inner
                  2- and 3-
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  have unique fillers (encoding
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  and
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            %p
              Similarly for
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              (byProp.
              = succeed "):" do
                %a.maruku-ref{:href => "#sSetIsNerveOfGroupoidIffAllHornsHaveUniqueFillers"}
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              iff
            %ol
              %li
                %p
                  it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              %li
                %p
                  all 2- and 3-
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  have unique fillers.
            %p
              For better or worse, such a simplicial set has at times also been called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/1-hypergroupoid"} 1-hypergroupoid
              = succeed "-coskeletal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              with unique horn fillers as models for
              %a.existingWikiWord{:href => "/nlab/show/n-groupoids"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-groupoids
            %p
              Notice that a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              which is
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              but with possibly non-unique 2-horn fillers is still a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
              and may still be called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              in the sense of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/bigroupoid"} bigroupoid
              (2-
              %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"}> hypergroupoid
              ) which happens to be just a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
          %p
            %br/
          %h3#nerve_of_a_2category Nerve of a 2-category
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            modeled as
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            the nerve operation is called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Duskin+nerve"} Duskin nerve
          .num_prop
            %h6#proposition_4 Proposition
            %p
              A simplicial set is the
              %a.existingWikiWord{:href => "/nlab/show/Duskin+nerve"} Duskin nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/bigroupoid"} bigroupoid
              precisely if it is a 2-
              %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"}> hypergroupoid
              \: a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              such that the horn fillers in dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \geq 3
              are
              = succeed "." do
                %em unique
          %p
            This is theorem 8.6 in (
            %a{:href => "http://www.tac.mta.ca/tac/volumes/9/n10/9-10abs.html"}> Duskin
            )
          %p
            For a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
            one can apply the nerve operation for categories in stages, to obtain the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/double+nerve"} double nerve
          %h3#nerve_of_a_3category Nerve of a 3-category
          %p
            One also has a nerve operation for
            %a.existingWikiWord{:href => "/nlab/show/3-categories"} 3-categories
            modeled as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tricategories"} tricategories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Street+nerve"} Street nerve
          .num_prop
            %h6#proposition_5 Proposition
            %p
              A simplicial set is the
              %a.existingWikiWord{:href => "/nlab/show/Street+nerve"} Street nerve
              of a
              %span.newWikiWord
                trigroupoid
                %a{:href => "/nlab/new/trigroupoid"} ?
              precisely if it is a 3-
              %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"}> hypergroupoid
              \: a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              such that the horn fillers in dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} \geq 4
              are
              = succeed "." do
                %em unique
          %p
            This is the main result of (
            %a{:href => "#Carrasco2014"}> Carrasco, 2014
            ).
          %h3#nerve_of_an_category
            Nerve of an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %ul
            %li
              For
              %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"} strict omega-categories
              there is a nerve induced by the
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/orientals"} orientals
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
          %h3#nerve_of_chain_complexes Nerve of chain complexes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo +
                %annotation{:encoding => "application/x-tex"} Ch_+
            be the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            of abelian groups, then there is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} cosimplicial chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo :
                  %mi Δ
                  %mo →
                  %msub
                    %mi Ch
                    %mo +
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet : \Delta \to Ch_+
          %p
            given by sending the standard
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            first to the free
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(\Delta[n])
            over it and then that to the normalized
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of the standard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          %p The nerve induced by this cosimplicial object was first considered in
          %ul
            %li
              D. Kan,
              = succeed "," do
                %em Functors involving c.s.s complexes
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/1993103"} jstor
          %p
            The nerve/
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} realization
            adjunction induced from this is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          %h2#remarks Remarks
          %h3#geometric_realization Geometric realization
          %p
            Often the operation of taking the nerve of a (higher) category is followed by forming the
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of the corresponding cellular set.
          %h3#nerves_and_higher_categories Nerves and higher categories
          %p
            For many purposes it is convenient to conceive categories and especially
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-categories"} ∞-categories
            entirely in terms of their nerves: those simplicial sets that arise as certain nerves are usually characterized by certain properties. So one can turn this around and
            %em define
            an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
            as a simplicial set with certain properties. This is the strategy of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+definition+of+higher+category"} geometric definition of higher category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complicial+set"} complicial sets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complexes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-categories
            = succeed ",\u2026" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+T-complex"} simplicial T-complexes
          %h3#internal_nerve Internal nerve
          %p
            A variant of the nerve construction can also be applied
            %em internally
            within a category, to any internal category, see the discussion at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
          %h3#direct_categories_versus_finite_simplicial_sets Direct categories versus finite simplicial sets
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/direct+category"} direct category
            has finitely many objects then its nerve is a finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %h2#properties_2 Properties
          %h3#PreservationOfColimits (Non-)Preservation of colimits
          %p
            While the nerve operation is a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            (
            %a{:href => "nerve+and+realization#NerveAndRealizationAreAdjoint"}> this Prop.
            ) and
            %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} hence
            %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
            all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserve
            all
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            (Exp.
            = succeed ")," do
              %a.maruku-ref{:href => "#NervesDoNotPreserveQuotientOfDeloopingByNormalSubgroup"}
            %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} hence
            is not a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
          %p
            However, it does preserve
            %em some
            colimits (Exp.
            = succeed ");" do
              %a.maruku-ref{:href => "#NervePreservesLeftQuotientsOnRightActionGroupoids"}
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            constructed via
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
            (Exp.
            = succeed ")." do
              %a.maruku-ref{:href => "#NerveDoesPreserveQuotientOfPairGroupoidOfGroupByGroupAction"}
          %p
            (In the following Exp.
            %a.maruku-ref{:href => "#NervesDoNotPreserveQuotientOfDeloopingByNormalSubgroup"}
            we use “card” instead of the more common notation “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {\vert - \vert}
            ” for
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            (of
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
          %p
          #NervesDoNotPreserveQuotientOfDeloopingByNormalSubgroup.num_remark
            %h6 Example
            %p
              %strong (Nerve does not preserve quotients of delooping groupoids by normal subgroups)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ↪
                    %mi G
                    %mo ↠
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} H \hookrightarrow G \twoheadrightarrow G/N
              be the inclusion of a
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} non-trivial
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              of a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/cardinalities"} cardinalities
              of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grpd
                    %mo ⟶
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    N \;\colon\; Grpd \longrightarrow sSet
            %p
              of their
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                    %mo ⟶
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}(-)
                    \\;\colon\;
                    Grp \longrightarrow Grpd
            %p
              satisfy, from degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              on, an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inequality+relation"} inequality relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi card
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi card
                        %mo{:stretchy => "false"} (
                        %mi G
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                      %mrow
                        %mi card
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo &gt;
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi card
                        %mo{:stretchy => "false"} (
                        %mi G
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                      %mrow
                        %mi card
                        %mo{:stretchy => "false"} (
                        %mi H
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi card
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi n
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    n \geq 2
                    \\;\;\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;\;\;
                    card
                    \\Big(
                    \\big( N \mathbf{B} G \big)_n / H
                    \\Big)
                    \\;=\;
                    \\frac{
                    card(G)^n
                    }
                    {
                    card(H)
                    }
                    \\;\;
                    \\gt
                    \\;\;
                    \\frac{
                    card(G)^n
                    }
                    {
                    card(H)^n
                    }
                    \\;=\;
                    card
                    \\Big(
                    \\big( N \mathbf{B} (G/H) \big)_n
                    \\Big)
                    \\,.
            %p
              But this means that it is impossible for there to be an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (namely a degree-wise
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} N(\mathbf{B}G)/H
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} N\big(\mathbf{B}(G/H)\big)
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              by the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+action"} action
          %p
          #NerveDoesPreserveQuotientOfPairGroupoidOfGroupByGroupAction.num_remark
            %h6 Example
            %p
              %strong (nerve does preserve canonical quotients of chaotic groupoids of groups)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Set)
              a (
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"}> discrete
              )
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi G
                        %mo ⇉
                        %mo *
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G \;\coloneqq\; \big( G \rightrightarrows \ast\big)
                  for its
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi E
                        %mi G
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi G
                        %mo ×
                        %mi G
                        %mo ⇉
                        %mi G
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{E}G \;\coloneqq\; \big( G \times G \rightrightarrows G  \big)
                  for its
                  %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
                  equipped with the usual left
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/group+action"} action
                  (discussed
                  = succeed ")," do
                    %a{:href => "codiscrete+groupoid#UniversalGPrincipalBundle"} there
            %p
              so that the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              of this action is
            #eq:QuotientCoprojectionFromPairGroupoidOfGroupToDeloopingGroupoid.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}G \xrightarrow{\;\;} (\mathbf{E}G)/G \;=\; \mathbf{B}G
                    \\,.
            %p
              Noticing that the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}G
              (which is the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+simplicial+complex"} universal principal simplicial complex
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi W
                      %mi G
                    %annotation{:encoding => "application/x-tex"} N(\mathbf{E}G) \,=\, W G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mi n
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    N(\mathbf{E}G)_n
                    \\;=\;
                    \\big\{
                    (g_n, g_{n-1}, \cdots, g_0)
                    \\;\in\;
                    G^{\times_{n+1}}
                    \\big\}
            %p
              with the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              action given degreewise by left-multiplication on
              %em just the leftmost factor
              (see also
              = succeed ")," do
                %a{:href => "simplicial+classifying+space#SimplicialClassifyingSpaceOfAnOrdinaryGroup"} this exp.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mrow
                            %mi n
                            %mo +
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\big(  N(\mathbf{E}G)_n \big)/G
                    \\;\simeq\;
                    \\big\{
                    (g_{n-1}, \cdots, g_0)
                    \\;\in\;
                    G^{\times_{n+}}
                    \\big\}
                    \\;=\;
                    N(\mathbf{B}G)_n
            %p
              and hence here the nerve operation does preserve the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:QuotientCoprojectionFromPairGroupoidOfGroupToDeloopingGroupoid"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ≃
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W G
                    \\;=\;
                    N(\mathbf{E}G)
                    \\xrightarrow{\;\;}
                    \\big(N(\mathbf{E}G)\big)/G
                    \\simeq
                    N\big(
                    (\mathbf{E}G)/G
                    \\big)
                    \\;=\;
                    N\big(
                    \\mathbf{B}G
                    \\big)
                    \\;=\;
                    \\overline{W} G
                    \\,.
            %p
              The result is the
              %a.existingWikiWord{:href => "/nlab/show/universal+simplicial+principal+bundle"} universal simplicial principal bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mi Grp
                        %mo{:stretchy => "false"} (
                        %mi Disc
                        %mo{:stretchy => "false"} )
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Set) \xhookrightarrow{Grp(Disc)} Grp(sSet)
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              The joint relevance of Exp.
              %a.maruku-ref{:href => "#NervesDoNotPreserveQuotientOfDeloopingByNormalSubgroup"}
              and Exp.
              %a.maruku-ref{:href => "#NerveDoesPreserveQuotientOfPairGroupoidOfGroupByGroupAction"}
              has been highlighted in
              %a{:href => "equivariant+bundle#GuillouMayMerling17"} Guillou, May &amp; Merling 2017
              (corresponding there to Exp. 2.9 and Lem. 2.10 – but Exp. 2.9 seems a little broken (?) while Lem. 2.10 does not quite get around to discussing the quotienting, for which it seems to be quoted later on).
          %p
            The principle behind Exp.
            %a.maruku-ref{:href => "#NerveDoesPreserveQuotientOfPairGroupoidOfGroupByGroupAction"}
            is readily seen to be, more generally, the following:
          %p
          #NervePreservesLeftQuotientsOnRightActionGroupoids.num_remark
            %h6 Example
            %p
              %strong (nerve preserves left quotients of right action groupoids)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi L
                    %mo ,
                    %msub
                      %mi G
                      %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_L, G_R \,\in\, Grp(Set)
              a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi L
                    %mo ×
                    %msubsup
                      %mi G
                      %mi R
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in (G_L \times G^{op}_R) Act(Set)
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/group+action"} left action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi L
                  %annotation{:encoding => "application/x-tex"} G_L
              and a commuting right action of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi R
                    %annotation{:encoding => "application/x-tex"} G_R
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of the right
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi R
                    %annotation{:encoding => "application/x-tex"} G_R
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi L
                    %annotation{:encoding => "application/x-tex"} G_L
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ×
                    %msub
                      %mi G
                      %mi R
                    %munderover
                      %mo ⇉
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi G
                      %mi L
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Grpd
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    X \times G_R
                    \\underoverset
                    {(-)\cdot(-)}
                    {pr_1}
                    {\rightrightarrows}
                    X
                    \\big)
                    \\;\;
                    \\in
                    \\;\;
                    G_L Act\big( Grpd \big)
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              by this left action is preserved by the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              operation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ×
                    %msub
                      %mi G
                      %mi R
                    %munderover
                      %mo ⇉
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
