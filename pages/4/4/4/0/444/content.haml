                          %mi 𝒞
                          %mo ,
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %msub
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mi n
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Hom
                            %mi Cat
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi 𝒞
                          %mo ×
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒟
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
