                          %mi Maps
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
