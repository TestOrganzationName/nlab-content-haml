                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Hom
                            %mi sSet
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Hom
                            %mi sSet
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
