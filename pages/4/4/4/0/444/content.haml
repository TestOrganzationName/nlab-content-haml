                  %annotation{:encoding => "application/x-tex"} [n] \in Obj(\Delta)
              may be identified with the category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mn 2
                      %mo →
                      %mi ⋯
                      %mo →
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} [n] = \{0 \to 1 \to 2 \to \cdots \to n\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              are all functors between these total linear categories.
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
              its
              %em nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(\mathcal{C})
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo ↪
                    %msup
                      %mi Cat
                      %mi op
                    %mover
                      %mo →
                      %mrow
                        %mi Cat
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    N(\mathcal{C})
                    \\colon
                    \\Delta^{op}
                    \\hookrightarrow
                    Cat^{op}
                    \\stackrel{Cat(-,\mathcal{C})}{\to}
                    Set
                    \\,,
            %p
              where
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              is regarded as a
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              with objects locally small strict categories, and morphisms being
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between these.
          %p
            So the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} N(\mathcal{C})_n
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            of the nerve is the set of functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \{0 \to 1 \to \cdots \to n\} \to \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            obtained by iterated fiber product (as
            %a{:href => "#NerveOfACategory"} above
            for pairs of composables):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %msub
                    %munder
                      %mrow
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ×
                          %mrow
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ×
                          %mrow
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                        %mi ⋯
                        %msub
                          %mo ×
                          %mrow
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %mo ⏟
                    %mrow
                      %mi n
                      %mspace{:width => "mediummathspace"}
                      %mi factors
                %annotation{:encoding => "application/x-tex"}
                  N(\mathcal{C})_n =
                  \\underbrace{
                  Mor(\mathcal{C}) \times_{Obj(\mathcal{C})} Mor(\mathcal{C})
                  \\times_{Obj(\mathcal{C})} \cdots \times_{Obj(\mathcal{C})} Mor(\mathcal{C})
                  }_{n \medspace factors}
          %p The collection of all functors between linear orders
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo →
                  %mn 1
                  %mo →
                  %mi ⋯
                  %mo →
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo →
                  %mn 1
                  %mo →
                  %mi ⋯
                  %mo →
                  %mi m
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{
                  0 \to 1 \to \cdots \to n
                  \\}
                  \\to
                  \\{
                  0 \to 1 \to \cdots \to m
                  \\}
          %p
            is generated from those that map almost all generating morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo →
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k \to k+1
            to another generating morphism, except at one position, where they
          %ul
            %li
              %p map a single generating morphism to the composite of two generating morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi δ
                        %mi i
                        %mi n
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\delta^n_i : [n-1] \to [n]
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi δ
                        %mi i
                        %mi n
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi i
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\delta^n_i : ((i-1) \to i) \mapsto ((i-1) \to i \to (i+1))
            %li
              %p map one generating morphism to an identity morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi σ
                        %mi i
                        %mi n
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\sigma^n_i : [n+1] \to [n]
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi σ
                        %mi i
                        %mi n
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo →
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msub
                        %mi Id
                        %mi i
                    %annotation{:encoding => "application/x-tex"}
                      \\sigma^n_i : (i \to i+1) \mapsto Id_i
          %p It follows that, for instance
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                      %msub
                        %mi d
                        %mn 1
                      %mo ,
                      %msub
                        %mi d
                        %mn 1
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                      %msub
                        %mi d
                        %mn 2
                      %mo ,
                      %msub
                        %mi d
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 3
                      %msub
                        %mi d
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi D
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} (d_0 \stackrel{f_1}{\to} d_1, d_1 \stackrel{f_2}{\to} d_2, d_2 \stackrel{f_3}{\to} d_3) \in N(D)_3
                the image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo :
                      %mo =
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 3
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d_1 := N(\mathcal{C})(\delta_1) : N(\mathcal{C})_3 \to N(\mathcal{C})_2
                is obtained by composing the first two morphisms in this sequence:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                          %mo ∘
                          %msub
                            %mi f
                            %mn 1
                      %msub
                        %mi d
                        %mn 2
                      %mo ,
                      %msub
                        %mi d
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 3
                      %msub
                        %mi d
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (d_0 \stackrel{f_2 \circ f_1}{\to} d_2, d_2 \stackrel{f_3}{\to} d_3) \in N(\mathcal{C})_2
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} (d_0 \stackrel{f_1}{\to} d_1) \in N(\mathcal{C})_1
                the image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                      %mo :
                      %mo =
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} s_1 := N(\mathcal{C})(\sigma_1) : N(\mathcal{C})_1 \to N(\mathcal{C})_2
                is obtained by inserting an identity morphism:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 0
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi f
                              %mn 1
                        %msub
                          %mi d
                          %mn 1
                        %mo ,
                        %msub
                          %mi d
                          %mn 1
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi Id
                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                        %msub
                          %mi d
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} (d_0 \stackrel{f_1}{\to} d_1, d_1 \stackrel{Id_{d_1}}{\to} d_1) \in N(\mathcal{C})_2
          %p In this way, generally the face and degeneracy maps of the nerve of a category come from composition of morphisms and from inserting identity morphisms.
          %p
            In particular in light of their generalization to nerves of higher categories, discussed below, the cells in the nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(\mathcal{C})
            have the following interpretation:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mo{:stretchy => "false"} |
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} N(\mathcal{C})_0 = \{d | d \in Obj(\mathcal{C})\}
                is the collection of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo =
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mover
                        %mo →
                        %mi f
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} N(\mathcal{C})_1 = Mor(\mathcal{C}) = \{d \stackrel{f}{\to} d' | f \in Mor(D)\}
                is the collection of
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %msub
                                    %mi d
                                    %mn 1
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mrow
                                      %msub
                                        %mi f
                                        %mn 1
                                  %mo ↗
                                %mtd
                                  %msup
                                    %mo ⇓
                                    %mrow
                                      %mo ∃
                                      %mo !
                                %mtd
                                  %msup
                                    %mo ↘
                                    %mrow
                                      %msub
                                        %mi f
                                        %mn 2
                              %mtr
                                %mtd
                                  %msub
                                    %mi d
                                    %mn 0
                                %mtd
                                %mtd
                                  %mover
                                    %mo →
                                    %mrow
                                      %msub
                                        %mi f
                                        %mn 2
                                      %mo ∘
                                      %msub
                                        %mi f
                                        %mn 1
                                %mtd
                                %mtd
                                  %msub
                                    %mi d
                                    %mn 2
                          %mo |
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mn 1
                        %mo ,
                        %msub
                          %mi f
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %msub
                          %mrow
                          %mi t
                        %msub
                          %mo ×
                          %mi s
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      N(\mathcal{C})_2 = \left\{
                      \\left.
                      \\array{
                      \&amp;&amp; d_1
                      \\\
                      \&amp; {}^{f_1}\nearrow &amp;\Downarrow^{\exists !}&amp; \searrow^{f_2}
                      \\\
                      d_0 &amp;&amp;\stackrel{f_2 \circ f_1}{\to}&amp;&amp; d_2
