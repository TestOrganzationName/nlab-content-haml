          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
            %em interpretation
            refers to equipping the
            %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
            of some
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/syntactic+categories"} syntactic categories
          %h2#definition Definition
          %p
            In the language of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+logic"} categorical logic
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"} cartesian
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is just a (
            %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"}> cartesian
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is first-order, and the functor (say
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %em logical
            (in the sense of Makkai-Reyes, equivalently coherent if we take the
            %a.existingWikiWord{:href => "/nlab/show/Morleyization"} Morleyization
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %em models
            in the sense usually studied in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
          %h2#interpretations_of_theories_in_each_other Interpretations of theories in each other
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            be (
            %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"}> cartesian
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"} cartesian
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric
            %em interpretation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo →
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_1 \to T_2
            is just a functor between the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+categories"} syntactic categories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Def
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Def
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T_1) \to \mathbf{Def}(T_2)
          %p
            Elsewhere, interpretations have been defined as assignments of symbols in the language
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_1
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            to definable sets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            satisfying various coherence conditions (usually at least product-preserving) which amount to functoriality.
          %p
            Note that via the duality between taking
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic categories
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            is just an interpretation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in the theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Lang
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Lang}(\mathbf{Set})
          %h3#biinterpretations_of_theories Bi-interpretations of theories
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            are
            %em bi-interpretable
            if there are functors (of appropriate logical strength)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⇆
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T_1) \leftrightarrows \mathbf{Def}(T_2)
            forming an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            %a.existingWikiWord{:href => "/nlab/show/conceptual+completeness"} conceptual completeness
            is that bi-interpretable theories have equivalent categories of models. This follows from the fact that (
            %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"}> cartesian
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric
          %p
            Many notions from
            %a.existingWikiWord{:href => "/nlab/show/geometric+stability+theory"} geometric stability theory
            and
            %span.newWikiWord
              classification theory
              %a{:href => "/nlab/new/classification+theory"} ?
            are invariant under bi-interpretability, e.g.
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stability+in+model+theory"} stability
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantifier+elimination"} quantifier elimination
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elimination+of+imaginaries"} elimination of imaginaries
          %p
            Since bi-interpretations induce equivalences of categories of models, monsters of bi-interpretable first-order theories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo ,
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_1, T_2
            will have isomorphic automorphism groups, with the isomorphism induced by restrictions along reducts. This indicates the bi-interpretation extends to the
            %a.existingWikiWord{:href => "/nlab/show/imaginaries"} imaginaries
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            also, so that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mn 1
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                    %mo ≃
                    %msubsup
                      %mi T
                      %mn 2
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                  %annotation{:encoding => "application/x-tex"} T_1^{\operatorname{eq}} \simeq T_2^{\operatorname{eq}}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completion
          %h2#interpretations_of_models_in_each_other Interpretations of models in each other
          %p
            This notion has appeared in the model-theoretic literature, and is what some model theorists mean when they say “interpretation.” Specialize to first-order logic and models in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                    %mo ⊧
                    %msub
                      %mi T
                      %mn 1
                    %mo ,
                    %msub
                      %mi M
                      %mn 2
                    %mo ⊧
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} M_1 \models T_1, M_2 \models T_2
            %em interpretation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} M_1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 2
                %annotation{:encoding => "application/x-tex"} M_2
            is a surjection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mover
                    %mo ↠
                    %mi f
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} U \overset{f}{\twoheadrightarrow} M_1
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            some subset of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi M
                      %mn 2
                      %mi k
                  %annotation{:encoding => "application/x-tex"} M_2^k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} f^*X
            of any definable (with parameters) set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} M_1
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is again definable in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T_1) \to \mathbf{Def}(T_2)
            (surjectivity implies witnessed existentials continue to be witnessed, and the functor being induced by pullback implies logicalness), in fact a logical functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T_1(M_1)) \to \mathbf{Def}(T_2(M_2))
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            enriched with the elementary diagrams of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} M_1
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} M_2
          %p Facts:
          %ul
            %li
              %p Every interpretation between theories can be realized as being induced by a concrete interpretation between sufficiently saturated models of those theories.
            %li
              %p
                Given an
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi U
                        %mo ↠
                        %msub
                          %mi M
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} f : U \twoheadrightarrow M_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi U
                      %mo ↠
                      %msub
                        %mi M
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} g : U \twoheadrightarrow M_1
                which is also an interpretation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mn 1
                      %mo →
                      %msub
                        %mi M
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} M_1 \to M_2
                is of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \sigma \circ f
                for some
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∈
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi M
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \sigma \in \operatorname{Aut}(M_1)
          %h3#examples Examples
          %ul
            %li
              %p
                The construction of the
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group+of+a+commutative+monoid"} Grothendieck group of a commutative monoid
                implements a canonical interpretation of the ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                in the semiring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
                (in fact inside
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
                viewed as the standard model of
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Peano+arithmetic"} Peano arithmetic
            %li
              %p
                The complex field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                is canonically interpreted in the real field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                by identifying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
                and noting that the multiplication of complex numbers is definable from multiplication on the reals.
          %h2#classifying_toposes Classifying toposes
          %p
            An interpretation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo →
                  %mi T
                  %mo ′
                %annotation{:encoding => "application/x-tex"} T \to T'
            is precisely the inverse image part of a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            of
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying toposes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}(T') \to \mathcal{E}(T)
            %a.existingWikiWord{:href => "/nlab/show/structure+in+model+theory"} models
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            are
            %a.existingWikiWord{:href => "/nlab/show/points+of+a+topos"} points
            of
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}(T)
