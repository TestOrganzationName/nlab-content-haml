          %p
            %a{:href => "#Virto21"} Virto 21, p.6
            points out (their emphasis):
          %blockquote
            %p
              %strong
                Both
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi K
