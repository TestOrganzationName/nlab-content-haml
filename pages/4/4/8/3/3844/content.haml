                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_{(\infty,1)}(C^{op})
            itself is modeled by the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %mi sSet
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo ∘
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  PSh_{(\infty,1)}(C^{op})
                  \\simeq
                  [T, sSet]^\circ
                  \\,,
          %p
            where we regard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            as a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            and have on the right the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
            with the projective or injective model structure, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} (-)^\circ
            denoting the full enriched subcategory on fibrant-cofibrant objects.
          %p
            This says in particular that every weak
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi T
                  %mo →
                  %mn ∞
                  %mi{:mathvariant => "normal"} Grp
                %annotation{:encoding => "application/x-tex"} f : T \to \infty \mathrm{Grp}
            is equivalent to a
            %em rectified
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi T
                    %mo →
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} F : T \to KanCplx
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in PSh_{(\infty,1)}(C^{op})
            belongs to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Alg_{(\infty,1)}(C)
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            preserves finite products
            %em weakly
            in that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi c
                    %mi i
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{c_i \in C\}
            a finite collection of objects, the canonical natural morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ×
                  %mi ⋯
                  %mo ×
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} c
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ⋯
                  %mo ×
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  F(c_1 \times \cdots\times \c_n)
                  \\to
                  F(c_1) \times \cdots \times F(c_n)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            of
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is an ordinary category with products, hence an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
          %p
            We now look at model category structure on
            %em strictly
            product preserving functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} C \to sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Alg_{(\infty,1)}(C)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial T-algebras
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with finite
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sTAlg
                    %mo ⊂
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sTAlg \subset Func(C,sSet)
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              on those functors that preserve these products.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sAlg
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sAlg(C)
              carries the structure of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sAlg
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} sAlg(C)_{proj}
              where the weak equivalences and the fibrations are objectwise those in the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          %p
            This is due to (
            %a{:href => "#Quillen"}> Quillen
            ).
          %p
            The inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                %annotation{:encoding => "application/x-tex"} i : sAlg(C) \hookrightarrow sPSh(C^{op})_{proj}
            into the projective
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            evidently preserves fibrations and acylclic fibrations and gives a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                  %mover
                    %munder
                      %mo ↪
                      %mi i
                    %mo ←
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  sAlg(C)_{proj}
                  \\stackrel{\leftarrow}{\underset{i}{\hookrightarrow}}
                  sPSh(C^{op})
                  \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The total right
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi i
                    %mo :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sAlg
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}i : Ho(sAlg(C)_{proj}) \to Ho(sPSh(C^{op})_{proj})
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              and an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in sPSh(C^{op})
              belongs to the
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}i
              precisely if it preserves products up to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          %p
            This is due to (
            %a{:href => "#Bergner"}> Bergner
            ).
          %p
            It follows that the natural
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi sAlg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi proj
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mover
                    %mo →
                    %mrow
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (sAlg(C)_{proj})^\circ \stackrel{}{\to}
                  PSh_{(\infty,1)}(C^{op})
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence
          %p
            A comprehensive statement of these facts is in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, section 5.5.9
          %h2#examples Examples
          %h3#simplicial_1algebras Simplicial 1-algebras
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            of) an ordinary
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} T Alg
            be the category of its ordinary algebras, the ordinary product-preserving functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} T \to Set
          %p
            We may regard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            as an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} T \to sSet
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ×
                  %mo ≃
                  %mi T
                  %msup
                    %mi Alg
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [T, sSet]_\times \simeq T Alg^{\Delta^{op}}
                  \\,.
          %p
            There is a standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial T-algebras
            and we find that simplicial
            = succeed "-1-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#homotopy_algebras
            Homotopy
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            an ordinary Lawvere theory, there is also a model category structure on ordinary functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo →
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} T \to sSet
            that preserve the products only up to weak equivalence. Such functors are called
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
          %p
            This model structure is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial T-algebras
            (see
            %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
            for details) but has the advantage that it is a left
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
          %h3#simplicial_theories Simplicial theories
          %p
            There is a notion of
            %em simplicial algebraic theory
            that captures some class of
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed ")" do
              %a{:href => "#Rezk"} Rezk
          %h3#structuresheaves
            Structure-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-sheaves
          %p
            A pre
            %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28%E2%88%9E%2C1%29-toposes%29"} geometry (for structured (∞,1)-toposes)
            is a (multi-sorted)
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %em
              structure
              = succeed "-sheaf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            on an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            in the sense of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo :
                  %mi 𝒯
                  %mo →
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O} : \mathcal{T} \to \mathcal{X}
          %p
            in the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            – a special one satisfying extra conditions that make it indeed behave like a sheaf of
            %em function algebras
            \.
          %h3#EInfty
            Symmetric monoidal
            = succeed "-Categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            There is a
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-categories"} symmetric monoidal (∞,1)-categories
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+%28%E2%88%9E%2C1%29-category"} monoid in a monoidal (∞,1)-category
          %p
            This is in (
            %a{:href => "#Cranch"}> Cranch
            ). For more details see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-algebraic+theory+of+E-infinity+algebras"} (2,1)-algebraic theory of E-infinity algebras
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
                \/
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
                \/
                %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+theory"} essentially algebraic theory
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/2-Lawvere+theory"} 2-Lawvere theory
                %li
                  %p
                    %strong
                      algebraic
                      = succeed "-theory" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn ∞
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (\infty,1)
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+%28%E2%88%9E%2C1%29-theory"} essentially algebraic (∞,1)-theory
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+Lawvere+theory"} simplicial Lawvere theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                \/
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monad"} (∞,1)-monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/operad"} operad
                \/
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"} (∞,1)-operad
          %h2#references References
          %p
            The model structure presentation for the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul#Quillen
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              ,
              %em Homotopical Algebra
              Lectures Notes in Mathematics 43, SpringerVerlag, Berlin, (1967)
          %p
            A characterization of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/sifted+colimit"} sifted colimit
          %ul
            %li
              J. Rosicky
              %em On homotopy varieties
              (
              %a{:href => "http://www.math.muni.cz/~rosicky/papers/infty6.pdf"}> pdf
              )
          %p
            using the incarnation of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
          %p
            An
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"}> Andre Joyal
              ,
              = succeed "," do
                %em The theory of quasi-categories and its applications
              = succeed "_" do
                %a{:href => "http://www.crm.cat/HigherCategories/hc2.pdf#page=44"} hc2.pdf
          %p from page 44 on.
          %p
            A detailed account in the context of a general theory of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            is the context of section 5.5.8 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              \.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentations
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul#Rezk
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em Every homotopy theory of simplicial algebras admits a proper model
              (
              %a{:href => "http://arxiv.org/abs/math/0003065"}> math/0003065
              ) ,
          %p
            where it is shown that every such model is
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to a left
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            A discussion of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bernard+Badzioch"}> Bernard Badzioch
              ,
              %em Algebraic theories in homotopy theory
              Annals of Mathematics, 155 (2002), 895-913 (
              %a{:href => "http://www.jstor.org/stable/3062135"}> JSTOR
              )
          %p and for multi-sorted theories in
          %ul#Bergner
            %li
              %a.existingWikiWord{:href => "/nlab/show/Julie+Bergner"}> Julie Bergner
              ,
              %em Rigidification of algebras over multi-sorted theories
              , Algebraic and Geometric Topoogy 7, 2007.
          %p
            A discussion of
            = succeed "-structures" do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul#Cranch
            %li
              %a.existingWikiWord{:href => "/nlab/show/James+Cranch"}> James Cranch
              ,
              %em
                Algebraic Theories and
                = succeed "-Categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
              (
              %a{:href => "http://arxiv.org/abs/1011.3243"}> arXiv
              )
          %p See also
          %ul
            %li
              %a{:href => "http://mathoverflow.net/questions/118500/what-is-a-simplicial-commutative-ring-from-the-point-of-view-of-homotopy-theory"} MO discussion
          %p
            Expressed as a higher form of
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+D.+Berman"}> John D. Berman
              ,
              %em Higher Lawvere theories
              (
              %a{:href => "https://arxiv.org/abs/1903.02991"}> arXiv:1903.02991
