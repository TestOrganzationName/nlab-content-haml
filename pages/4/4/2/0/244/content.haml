                    %a.existingWikiWord{:href => "/nlab/show/bialgebra"} bialgebra
                  %td{:style => "text-align: left;"}
                    strict
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/2-ring"} 2-ring
                    %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                    with
                    %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
                    with
                    %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/hopfish+algebra"} hopfish algebra
                    (correct version)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
                    (without fiber functor)
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/weak+Hopf+algebra"} weak Hopf algebra
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/fusion+category"} fusion category
                    with generalized
                    %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasitriangular+bialgebra"} quasitriangular bialgebra
                  %td{:style => "text-align: left;"}
