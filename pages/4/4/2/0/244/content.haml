            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+logic"} quantum logic
          %h3#permutations Permutations
          %p
            For every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \ge 2
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msub
                      %mi 𝔖
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \in \mathfrak{S}_{n}
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi A
                        %mi n
                  %mo :
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi A
                    %mi n
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %msup
                        %mi σ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi A
                    %mrow
                      %msup
                        %mi σ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma_{A_{1},...,A_{n}}: A_{1} \otimes ... \otimes A_{n} \rightarrow A_{\sigma^{-1}(1)} \otimes ... \otimes A_{\sigma^{-1}(n)}
          %p
            that is defined by the decomposition of a
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            in a product of adjacent
            %a.existingWikiWord{:href => "/nlab/show/transpositions"} transpositions
            and generalizes the
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi A
                    %mn 2
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                  %mo ⊗
                  %msub
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  B:A_{1} \otimes A_{2} \rightarrow A_{2} \otimes A_{1}
          %p
            We recall that an adjacent transposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1,n] \rightarrow [1,n]
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \ge 2
            is a permutation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} t:[1,n] \rightarrow [1,n]
            such that there exists a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ≤
                  %mi i
                  %mo ≤
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1 \le i \le n-1
            such that:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo −
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo +
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo +
                  %mn 2
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi n
                %annotation{:encoding => "application/x-tex"}
                  t(1)=1,..., t(i-1)=i-1, t(i) = i+1, t(i+1) = i, t(i+2)=i+2,.... ,t(n)=n
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is then unique, and for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \le i \le n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                %annotation{:encoding => "application/x-tex"} t_{i}
            the associated adjacent transposition.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \ge 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ∈
                  %msub
                    %mi 𝔖
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sigma \in \mathfrak{S}_{n}
            admits at least a decomposition under the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ;
                  %mo .
                  %mo .
                  %mo .
                  %mo ;
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi i
                        %mi q
                %annotation{:encoding => "application/x-tex"} \sigma = t_{i_{1}}; ...;t_{i_{q}}
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ge 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi i
                      %mi q
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \le i_{1},....,i_{q} \le n-1
          %p
            In every symmetric monoidal category, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \ge 2
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \le i \le n-1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                  %mo :
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi A
                    %mi n
                  %mo →
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                  %mo ⊗
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ⊗
                  %msub
                    %mi A
                    %mi i
                  %mo ⊗
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mo +
                      %mn 2
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} t_{i}:A_{1} \otimes .... \otimes A_{n} \rightarrow A_{1} \otimes ... \otimes A_{i-1} \otimes A_{i+1} \otimes A_{i} \otimes A_{i+2} \otimes .... \otimes A_{n}
          %p defined by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mo −
                          %mn 1
                  %mo ⊗
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} B
                    %mrow
                      %msub
                        %mi A
                        %mi i
                      %mo ,
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mo +
                          %mn 2
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mn 1
                    %mrow
                      %msub
                        %mi A
                        %mi n
                %annotation{:encoding => "application/x-tex"} t_{i} = 1_{A_{1}} \otimes ... \otimes 1_{A_{i-1}} \otimes \B_{A_{i},A_{i+1}} \otimes 1_{A_{i+2}} \otimes ... \otimes 1_{A_{n}}
          %p
            Given a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msub
                      %mi 𝔖
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \in \mathfrak{S}_{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ;
                  %mo .
                  %mo .
                  %mo .
                  %mo .
                  %mo ;
                  %msub
                    %mi t
                    %mrow
                      %msub
                        %mi i
                        %mi q
                %annotation{:encoding => "application/x-tex"} t_{i_{1}};....;t_{i_{q}}
            for any such decomposition of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+symmetric+monoidal+categories"} coherence theorem for symmetric monoidal categories
          %h2#examples Examples
          %ul
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
                is necessarily symmetric monoidal, due to the essential uniqueness of the categorical
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                some
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/field"} field
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                of
                = succeed "-vector" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                coming from the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V \otimes W
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo ⊗
                      %mi V
                    %annotation{:encoding => "application/x-tex"} W \otimes V
                by mapping homogeneous elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⊗
                      %mi w
                    %annotation{:encoding => "application/x-tex"} v \otimes w
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ⊗
                      %mi v
                    %annotation{:encoding => "application/x-tex"} w \otimes v
                obviously makes
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                into a symmetric monoidal category.
            %li
              %p
                The category of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                monoidal structure. One is the trivial one from above, the other is the one that induces a a sign when two odd-graded vectors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                    %annotation{:encoding => "application/x-tex"} w
                are passed past each other :
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ⊗
                        %mi w
                        %mo ↦
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi w
                        %mo ⊗
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v \otimes w \mapsto - w \otimes v
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Vect[\mathbb{Z}_2]
                defines the symmetric monoidal category of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            %li
              %p
                The monoidal category of
                %a.existingWikiWord{:href => "/nlab/show/graded+modules"} graded modules
                over a
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                (with the usual
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of graded modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi V
                          %mo ⊗
                          %mi W
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi W
                          %mo ⊗
                          %mi V
                      %mtr
                        %mtd
                          %mi x
                          %mo ⊗
                          %mi y
                        %mtd
                          %mo ↦
                        %mtd
                          %mi y
                          %mo ⊗
                          %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V \otimes W &amp;\longrightarrow&amp; W \otimes V
                  \\\
                  x \otimes y &amp;\mapsto&amp; y \otimes x
                  }
                  \\,.
          %p
            The braiding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⊗
                  %mi y
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo{:stretchy => "false"} |
                  %mi y
                  %mo ⊗
                  %mi x
                %annotation{:encoding => "application/x-tex"} x \otimes y \mapsto (-1)^{|x| |y|} y \otimes x
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |x|
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |y|
            denote the degrees) is also commonly used.
          %p
            More generally, for any invertible element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            of the base ring, there is the
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braiding
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo ↦
                    %msup
                      %mi u
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} |
                        %mi y
                        %mo{:stretchy => "false"} |
                    %mi y
                    %mo ⊗
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \otimes y \mapsto u^{|x| |y|} y \otimes x
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            is symmetric if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mn 2
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} u^2 = 1
