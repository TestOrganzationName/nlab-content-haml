                %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
                (eds.):
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
          %p Textbook accounts:
          %ul
            %li#Borceux94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Section 6.1 of:
                %em Handbook of Categorical Algebra
                Vol. 2:
                %em Categories and Structures
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1017/CBO9780511525865"} doi:10.1017/CBO9780511525865
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
                = succeed "," do
