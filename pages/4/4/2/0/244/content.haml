                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                %em Algèbre élémentaire dans les catégories
                (1964), C. R. Acad. Sci. Paris
                %strong 258
                (1964) 771-774 &amp;lbrack;
                %a{:href => "https://gallica.bnf.fr/ark:/12148/bpt6k40102/f817"}> ark:12148/bpt6k40102/f817
                \&amp;rbrack;
            %li#EilenbergKelly65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
