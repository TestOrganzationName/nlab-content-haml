                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo ⊗
                          %mi x
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (x \otimes y) \otimes z
                  \&amp;\stackrel{a_{x,y,z}}{\to}&amp;
                  x \otimes (y \otimes z)
                  \&amp;\stackrel{B_{x,y \otimes z}}{\to}&amp;
                  (y \otimes z) \otimes x
                  \\\
                  \\downarrow^{B_{x,y}\otimes 1_z}
                  \&amp;&amp;&amp;&amp;
                  \\downarrow^{a_{y,z,x}}
                  \\\
                  (y \otimes x) \otimes z
                  \&amp;\stackrel{a_{y,x,z}}{\to}&amp;
                  y \otimes (x \otimes z)
                  \&amp;\stackrel{1_y \otimes B_{x,z}}{\to}&amp;
                  y \otimes (z \otimes x)
                  }
          %p And lastly, we demand that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mrow
                      %mi y
                      %mo ,
                      %mi x
                  %msub
                    %mi B
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %mi x
                      %mo ⊗
                      %mi y
                  %mo .
                %annotation{:encoding => "application/x-tex"} B_{y,x} B_{x,y} = 1_{x \otimes y} .
          %p
            (The definition of
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            has
            %em two
            hexagon identities, but either one implies the other given this equation.)
          %h2#properties Properties
          %h3#the_2category_of_symmetric_monoidal_categories The 2-category of symmetric monoidal categories
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SymmMonCat
                %annotation{:encoding => "application/x-tex"} SymmMonCat
            with:
          %ul
            %li symmetric monoidal categories as objects,
            %li
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"}> symmetric monoidal functor
              s as morphisms,
            %li
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+natural+transformation"}> symmetric monoidal natural transformation
              s as 2-morphisms.
          %p
            This 2-category has (weak) 2-
            %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
            given by the cartesian product of underlying categories (analogously to how
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            has biproducts given by the cartesian product of underlying sets). For a proof, see
            = succeed "," do
              %a{:href => "#FongSpivak"} Fong-Spivak, Theorem 2.3
            %a.existingWikiWord{:href => "/nlab/show/pseudomonoids"} pseudomonoids
            = succeed "." do
              %a{:href => "#Schaeppi"} Schaeppi, Appendix A
          %h3#ModelsForConnectiveSpectra As models for connective spectra
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of a symmetric monoidal category is always an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinite+loop+space"} infinite loop space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            spectrum of the symmetric monoidal category:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Spectra
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi K
                          %mo ↗
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi SymmMonCat
                        %mtd
                          %mo →
                        %mtd
                          %mi Cat
                        %mtd
                          %munder
                            %mo →
                            %mi N
                        %mtd
                          %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp;&amp;&amp; Spectra
                  \\\
                  \&amp;&amp; {}^{\mathllap{K}}\nearrow &amp;&amp; \downarrow
                  \\\
                  SymmMonCat &amp;\to&amp; Cat &amp;\underset{N}{\to}&amp; sSet
                  }
                  \\,.
          %p
            This construction extended to an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi SymmMonCat
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ≥
                      %mn 0
                  %mo ↪
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K :  Ho(SymmMonCat)
                  \\stackrel{\simeq}{\to}
                  Ho(Spectra)_{\geq 0}
                  \\hookrightarrow
                  Ho(Spectra)
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            on the
            %a.existingWikiWord{:href => "/nlab/show/connective+spectra"} connective spectra
            and the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SymmMonCat
                  %annotation{:encoding => "application/x-tex"} SymmMonCat
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred structure
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
          %p
            This is due to (
            %a{:href => "#Thomason"}> Thomason, 95
            ). Further discussion is in (
            %a{:href => "#Mandell"}> Mandell, 2010
            ).
          %p
            Notice that this is
            %em almost
            the complete analog in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the
            %a.existingWikiWord{:href => "/nlab/show/Thomason+model+structure"} Thomason model structure
            on
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            and the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SymmMonCat
                %annotation{:encoding => "application/x-tex"} SymmMonCat
            cannot carry a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure because it does not have all
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SymmMonCat
                %annotation{:encoding => "application/x-tex"} SymmMonCat
            is the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %p (This is currently being investigated by Elmendorf, Nikolaus and maybe others.)
          %p
            However, a subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SymmMonCat
                %annotation{:encoding => "application/x-tex"} SymmMonCat
            whose objects are
            %a.existingWikiWord{:href => "/nlab/show/permutative+categories"} permutative categories
            and maps are symmetric strict monoidal functors, denoted by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Perm
                %annotation{:encoding => "application/x-tex"} Perm
            has a model category structure which is transferred from the natural model category structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "." do
              %a{:href => "#Sharma"} Sharma
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Perm
                  %annotation{:encoding => "application/x-tex"} Perm
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem"} coherence theorem
            for symmetric monoidal categories states that each symmetric monoidal category is equivalent to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/permutative+category"} permutative category
          %h3#relation_to_categories
            Relation to
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            The aforementioned natural model category of permutative categories is NOT a symmetric monoidal closed model category. This shortcoming was overcome in [Sharma] by constructing a Quillen equivalent
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            which is symmetric monoidal closed. A (unnormalized)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Gamma^{op}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Gamma^{op}
            is a skeletal category of finite based sets and based maps. The category of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            product. The aforementioned symmetric monoidal closed model category is constructed in
            %a{:href => "#Sharma"} Sharma
            as a left-Bousfield localization of the projective model category structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %a{:href => "#Sharma"} Sharma
            is that an unnormalized version of the classical Segal’s nerve functor is the right
            %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
            of a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the natural model category of permutative categories and the symmetric monoidal closed model category of coherently commutative monoidal categories.
          %h3#as_algebras_over_the_little_cubes_operad
            As algebras over the little
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            A symmetric monoidal category is equivalently a category that is equipped with the structure of an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over
            the
            %a.existingWikiWord{:href => "/nlab/show/little+cubes+operad"} little k-cubes operad
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} k \geq 3
          %p Details are in examples 1.2.3 and 1.2.4 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔼
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{E}[k]
              %a.existingWikiWord{:href => "/nlab/show/Ek-Algebras"} Algebras
          %h3#tannaka_duality Tannaka duality
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
                for
                %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
                over
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
                %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/monoid"}> monoid
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %td{:style => "text-align: left;"}
