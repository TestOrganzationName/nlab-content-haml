                = succeed "," do
                  %em Ind-abelian categories and quasi-coherent sheaves
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1211.3678"} arxiv
            %li
              %p
                Amit Sharma,
                %em
                  Symmetric monoidal categories and
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                Theory and applications of Categories, Vol. 35, No. 14, (2020) pp. 417-512
          %ul
            %li
              %p
                Stefano Kasangian and Fabio Rossi.
                = succeed "." do
                  %em Some remarks on symmetry for a monoidal category
            %li
              %p
                J. M. Egger.
                = succeed "." do
                  %em On involutive monoidal categories
