                    (
                    %a.existingWikiWord{:href => "/nlab/show/quantum+group"}> quantum group
                    )
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid
                    %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
                    with
                    %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/triangular+Hopf+algebra"} triangular Hopf algebra
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                    with
