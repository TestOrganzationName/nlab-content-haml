                %em On the generalized action principle for superstrings and supermembranes
              %strong 352
              (1995) 269-275 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9502141"}> arXiv:hep-th/9502141
              \&amp;rbrack;
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/super+AdS+spacetime"} super AdS
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/target+spacetime"} target spacetime
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+A.+Bandos"}> Igor A. Bandos
              \:
              = succeed "," do
                %em
                  Superembedding approach to superstring in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 5
                        %mo ×
                        %msup
                          %mi S
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} AdS_5 \times S^5
                  superspace
              %em Fundamental Interactions
              (2009) 303-334 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0812.0257"}> arXiv:0812.0257
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/9789814277839_0018"} doi:10.1142/9789814277839_0018
          %h3#for_the_m2brane For the M2-brane
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            for the
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            have been derived via the
            %a.existingWikiWord{:href => "/nlab/show/superembedding+approach"} superembedding approach
            in
          %ul
            %li
              %a{:href => "#BPSTV95"} BPSTV 95, Chapter 3
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            in
          %ul
            %li#HoweSezgin05
              %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %em The supermembrane revisited
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0412245"} arXiv:hep-th/0412245
          %h3#for_the_m5brane_2 For the M5-brane
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
