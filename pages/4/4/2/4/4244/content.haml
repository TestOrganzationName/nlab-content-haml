          %h2#properties Properties
          %h3#in_terms_of_structure
            In terms of
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Calabi-Yau structure is equivalently
            %a.existingWikiWord{:href => "/nlab/show/integrability+of+G-structure"} integrable
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                %annotation{:encoding => "application/x-tex"} G =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"} SU(n)
          %p
            Details are in
            = succeed "." do
              %a{:href => "#Prins16"} Prins 16, Prop. 1.3.2
            = succeed "." do
              %a{:href => "#Vezzoni06"} Vezzoni 06, p. 24
          %h3#InSUBordismTheory In SU-bordism theory
          %p
            We discuss the classes of Calabi-Yau manifolds seen in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+theory"} SU-bordism theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds+in+SU-bordism+theory"} Calabi-Yau manifolds in SU-bordism theory
          #K3SurfaceSpansSUBordismRingInDegree4.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
                spans
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                in degree 4)
            %p
              The degree-4 generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 4
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                  %annotation{:encoding => "application/x-tex"} y_4 \in \Omega^{SU}_4
              in the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SUBordismRingAwayFromTwo"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/torus"} torus
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{SU}_4 \;\simeq\; \mathbb{Z}\big[ \tfrac{1}{2}\big]\big\langle -[K3] \big\rangle
                    \\,.
          %p
            (
            %a{:href => "#LLP17"}> LLP 17, Lemma 1.5, Example 3.1
            ,
            = succeed ")" do
              %a{:href => "#CLP19"} CLP 19, Theorem 13.5a
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
                generate the
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
              is multiplicatively generated by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
          %p
            (
            %a{:href => "#LLP17"}> LLP 17, Theorem 2.4
            )
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
                in complex dim
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} \leq 4
                generate the
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo ≤
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} deg \leq 8
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
            %p
              There are
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
              of complex dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4
              whose whose SU-bordism classes equal the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %msub
                      %mi y
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \pm y_6
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %msub
                      %mi y
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} \pm y_8
              in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SUBordismRingAwayFromTwo"}
          %p
            (
            %a{:href => "#CLP19"}> CLP 19, Theorem 13.5b,c
            )
          %h3#artinmazur_formal_group Artin-Mazur formal group
          %p
