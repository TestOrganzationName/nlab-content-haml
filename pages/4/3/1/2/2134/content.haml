                  \\left\langle
                  V_2
                  \\,,\,
                  W
                  \\right\rangle
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ⟨
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi W
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi W
                      %mi w
