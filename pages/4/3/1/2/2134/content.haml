                      %mi W
                      %mn 2
                    %mo ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\left\langle
                  V
                  \\,,\,
                  W_1 \oplus W_w
                  \\right\rangle
                  \\;=\;
                  \\left\langle
                  V
                  \\,,\,
                  W_1
                  \\right\rangle
                  +
                  \\left\langle
                  V
                  \\,,\,
                  W_2
                  \\right\rangle
          %p
            (This is, ultimately, due to the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            as a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
          %p
            To further strengthen the emerging picture, we may consider the
            %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %msubsup
                    %mi Rep
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mi fin
                %annotation{:encoding => "application/x-tex"} G Rep^{fin}_{/\sim}
            by passing to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+ring"} Grothendieck ring
            if we remember also the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            is called the
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi K
                  %mrow
                    %mo (
                    %mi G
                    %msubsup
                      %mi Rep
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mi fin
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  R(G) \;\coloneqq\; K\left(  G Rep^{fin}_{/\sim} \right)
          %p
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
