                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            itself, as proved
            = succeed "." do
              %a{:href => "simple+object#in_an_abelian_category"} here
          %h3#for_bridgeland_stable_objects For Bridgeland stable objects
          %p
