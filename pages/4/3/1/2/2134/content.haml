                  %annotation{:encoding => "application/x-tex"} R(G)
          #eq:DecategorifiedInnterProduct.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
