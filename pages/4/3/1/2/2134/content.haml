          %p
            on
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %msubsup
                    %mi Rep
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mi fin
                %annotation{:encoding => "application/x-tex"} G Rep^{fin}_{/\sim}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
            with respect to the underlying
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} additive monoid
            structure:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ⟨
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi V
