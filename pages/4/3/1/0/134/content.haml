          #ClosedSubspacesGluing.num_example
            %h6#example_11 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                of two
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                or two
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              be
              %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A,B \subset X
                  are both
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  or are both
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %li
                %p
                  they constitute a
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/cover"} cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mi A
                        %mo ∪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} X = A \cup B
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_A \colon A \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi B
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_B \colon B \to X
              for the corresponding inclusion
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ∩
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi A
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mi B
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \cap B &amp;\longrightarrow&amp; A
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{i_A}}
                    \\\
                    B &amp;\underset{i_B}{\longrightarrow}&amp; X
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              square in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#PushoutInTop"}
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              this means in particular that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              then a function of underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              as soon as its two restrictions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi Y
                    %mphantom
                      %mi AAAA
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_A \;\colon\; A \longrightarrow Y
                    \\phantom{AAAA}
                    f\vert_A \;\colon\; B \longrightarrow Y
            %p are continuous.
          .proof
            %h6#proof_2 Proof
            %p
              Clearly the underlying diagram of underlying
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              is a pushout in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %a.maruku-ref{:href => "#DescriptionOfLimitsAndColimitsInTop"}
              we need to show that the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              induced by the set of functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi i
                        %mi A
                      %mo ,
                      %msub
                        %mi i
                        %mi B
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{i_A, i_B\}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              (restrictions)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi A
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi A
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %msubsup
                      %mi i
                      %mi B
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    i_A^{-1}(S) = S \cap A
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    i_B^{-1}(S) = S \cap B
            %p
              are open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              Now by definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open, then the intersections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open in these subspaces.
            %p
              Conversely, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open. We need to show that then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open.
            %p
              Consider now first the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ;
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A;B \subset X
              are both open open. Then by the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              means that there is an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A \subset X
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi S
                      %mo =
                      %mi A
                      %mo ∩
                      %msub
                        %mi S
                        %mi A
                    %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S_A
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open. Similarly
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                    %annotation{:encoding => "application/x-tex"} B \cap S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∪
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S
                    \&amp; =
                    S \cap X
                    \\\
                    \&amp; = S \cap (A \cup B)
                    \\\
                    \&amp; =  (S \cap A) \cup (S \cap B)
                    \\end{aligned}
            %p is the union of two open subsets and therefore open.
            %p
              Now consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are both closed subsets.
            %p
              Again by the nature of the subspace topology, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open means that there exist open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ,
                    %msub
                      %mi S
                      %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A, S_B \subset X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo =
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                      %mo =
                      %mi B
                      %mo ∩
                      %msub
                        %mi S
                        %mi B
                    %annotation{:encoding => "application/x-tex"} B \cap S = B \cap S_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are closed by assumption, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∖
                    %mi S
                    %mo ,
                    %mi B
                    %mo ∖
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \setminus S, B \setminus S \subset X
              are still closed, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∖
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \setminus (A \setminus S), X \setminus (B \setminus S) \subset X
              are open.
            %p
              Now observe that (by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∪
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S
                    \&amp; = X \setminus (X \setminus S)
                    \\\
                    \&amp; =
                    X \setminus ( (A \cup B) \setminus S )
                    \\\
                    \&amp; =
                    X \setminus ( (A \setminus S) \cup (B \setminus S) )
                    \\\
                    \&amp; =
                    (X \setminus (A \setminus S)) \cap (X \setminus (B \setminus S))
                    \\,.
                    \\end{aligned}
            %p
              This exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              as the intersection of two open subsets, hence as open.
          #attach.num_example
            %h6#example_12 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X, Y, Z
              are
              %a.existingWikiWord{:href => "/nlab/show/normal+topological+spaces"} normal topological spaces
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} h: X \to Z
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+embedding+of+topological+spaces"} closed embedding of topological spaces
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi k
                          %mtd
                            %mi W
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp; \stackrel{h}{\to} &amp; Z \\
                    \\mathllap{f} \downarrow &amp; &amp; \downarrow \mathrlap{g} \\
                    Y &amp; \underset{k}{\to} &amp; W,
                    }
            %p
              the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is normal and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi Y
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} k: Y \to W
              is a closed embedding.
          %p
            For
            %strong proof
            of this and related statements see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/colimits+of+normal+spaces"} colimits of normal spaces
          %h3#relation_with_
            Relation with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
            Write
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
          #ForgetfulFunctorFromTopToSet.num_defn
            %h6#definition_3 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Top
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    U \colon Top \longrightarrow Set
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              that sends a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X = (S,\tau)
              to its underlying set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U(X) = S \in Set
              and which regards a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              as a plain
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on the underlying sets.
          %p
            Prop.
            %a.maruku-ref{:href => "#DescriptionOfLimitsAndColimitsInTop"}
            means in particular that:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              has all small
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Top
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \colon Top \to Set
              from def.
              %a.maruku-ref{:href => "#ForgetfulFunctorFromTopToSet"}
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              and
              %a.existingWikiWord{:href => "/nlab/show/lifted+limit"} lifts
              limits and colimits.
          %p
            (But it does not
            %a.existingWikiWord{:href => "/nlab/show/created+limit"} create
            or
            %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflect
            them.)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              from def.
              %a.maruku-ref{:href => "#ForgetfulFunctorFromTopToSet"}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi disc
                    %annotation{:encoding => "application/x-tex"} disc
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              %a.maruku-ref{:href => "#DiscreteTopologicalSpaceAsCoproduct"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mover
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mi disc
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top
                    \\stackrel{\overset{disc}{\longleftarrow}}{\underset{U}{\longrightarrow}}
                    Set
                    \\,.
          #topcat.num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              from def.
              %a.maruku-ref{:href => "#ForgetfulFunctorFromTopToSet"}
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              as
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
              %li
                %p
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
          %h3#MonoEpiMorphisms Mono-/Epimorphisms
          #SubspaceInclusionsAreRegularMonos.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                  are those
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  which are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/injective+functions"} injective functions
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/topological+embeddings"} topological embeddings
                  (i.e. those continuous functions which are
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
                  onto their
                  %a.existingWikiWord{:href => "/nlab/show/images"} images
                  equipped with the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
          .proof
            %h6#proof_3 Proof
            %p
              Regarding the first statement: An injective continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              clearly has the cancellation property that defines monomorphisms: for parallel continuous functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Z
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g_1,g_2 \colon Z \to X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %mi f
                      %mo ∘
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f \circ g_1 = f \circ g_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} g_1 = g_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the cancellation property, then testing on points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g_1, g_2 \colon \ast \to X
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is injective.
            %p
              Regarding the second statement: from the construction of
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EqualizerInTop"}
            %p
              Conversely, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i \colon X \to Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace+embedding"} topological subspace embedding
            %p
              To that end, form the
              %a.existingWikiWord{:href => "/nlab/show/cokernel+pair"} cokernel pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i_1, i_2)
              by taking the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              against itself (in the category of sets, and using the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              on a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              = succeed "," do
                %a{:href => "regular+monomorphism#RegEquEff"} this prop.
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              are regular, we get the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              back, and again by example
              = succeed "," do
                %a.maruku-ref{:href => "#EqualizerInTop"}
          %h3#intersections_and_quotients Intersections and quotients
          #pushout.num_lemma
            %h6#lemma Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of any (closed/open)
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ↪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow B
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalSubspace"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f \colon A \to C
              is itself an a (closed/open) subspace
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} j \colon C \hookrightarrow D
          %p
            For proof see
            = succeed "." do
              %a{:href => "subspace+topology#pushout"} there
          %h3#closed_monoidal_structure Closed monoidal structure
          %p
            It is well known that
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is not
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed"} cartesian closed
            (see for example at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
          %p
            It is however
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\otimes Y
                is given by the cartesian product of the underlying spaces, equipped with the
                = succeed "," do
                  %em topology of separate continuity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊆
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} U\subseteq X\times Y
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo ∈
                      %mi Y
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      U_x \;\coloneqq\; \{y\in Y : (x,y\in U)\}
              %p
                is an open subset of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi y
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi X
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      U_y \;\coloneqq\; \{x\in X : (x,y)\in U\}
              %p
                is an open subset of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo ⊗
                      %mi Y
                      %mo →
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} f:X\otimes Y\to Z
                is continuous if and only if: for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                the function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y\mapsto f(x,y)
                is continuous, and for every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y\in Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\mapsto f(x,y)
                is continuous.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,Y]
                is given by the set of
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X\to Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      S(x,V) \;\coloneqq\; \{f:X\to Y : f(x)\in V\}
              %p
                for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                and each open
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} V\subseteq Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi α
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f_\alpha:X\to Y)
                tends to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f:X\to Y
                if and only if for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x\in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\alpha(x)\to f(x)
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"}> Ho(Top)
                ,
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/TopGrp"} TopGrp
          %h2#references References
          %p
            For general references see those listed at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          %ul
            %li#Bourbaki71
              %a.existingWikiWord{:href => "/nlab/show/Nicolas+Bourbaki"}> Nicolas Bourbaki
              , chapter 1
              %em Topological Structures
              of
              = succeed "," do
                %em Elements of Mathematics III: General topology
          %p See also
          %ul
            %li#AguilarGitlerPrieto02
              Marcelo Aguilar,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Gitler"} Samuel Gitler
              = succeed "," do
                %em Algebraic topology from a homotopical viewpoint
              = succeed ")" do
                %a{:href => "http://tocs.ulb.tu-darmstadt.de/106999419.pdf"} toc pdf
          %p
            An axiomatic desciption of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            along the lines of
            %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            for
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is discussed in
          %ul
            %li
              Dana Schlomiuk,
              = succeed "," do
                %em An elementary theory of the category of topological space
          %p
            For its
            = succeed "," do
              %a{:href => "#closed_monoidal_structure"} closed monoidal structure
          %ul
            %li
              Maria Cristina Pedicchio and Fabio Rossi,
              = succeed "," do
                %em Monoidal closed structures for topological spaces: counter-example to a question of Booth and Tillotson
            %li#dagger_martingales
              Appendix A of
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
              and Ruben Van Belle,
              = succeed "," do
                %em Convergence of martingales via enriched dagger categories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2404.15191"} arXiv
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/category"} category
