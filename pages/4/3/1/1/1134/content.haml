            %li#HohnholdSolzTeichner11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henning+Hohnhold"}> Henning Hohnhold
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stephan+Stolz"} Stephan Stolz
                = succeed ":" do
