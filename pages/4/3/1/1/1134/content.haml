            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/complex+supermanifold"}> complex supermanifold
                ,
                %a.existingWikiWord{:href => "/nlab/show/super+Riemann+surface"} super Riemann surface
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/superconnection"} superconnection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/superdifferential+form"} superdifferential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/superalgebra"}> superalgebra
                ,
