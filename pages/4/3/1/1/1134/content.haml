            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henning+Hohnhold"}> Henning Hohnhold
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Kreck"} Matthias Kreck
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stephan+Stolz"} Stephan Stolz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                = succeed "," do
                  %em Differential forms and 0-dimensional supersymmetric field theories
                %strong 2
                1 (2011) 1–41 &amp;lbrack;
                %a{:href => "http://dx.doi.org/10.4171/QT/12"}> doi:10.4171/QT/12
                ,
