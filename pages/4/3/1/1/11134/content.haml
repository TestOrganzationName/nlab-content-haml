            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/writer+monad"} writer monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/QRAM"} QRAM
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/store+comonad"} store comonad
          %h2#references References
          %p
            Original discussion of the state/side-effect monad as a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monad+in+computer+science"} monad in computer science
          %ul
            %li#Moggi91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eugenio+Moggi"}> Eugenio Moggi
                , Exp. 1.1 in:
                = succeed "," do
                  %em Notions of computation and monads
                %strong 93
                1 (1991) &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0890-5401(91)90052-4"}> doi:10.1016/0890-5401(91)90052-4
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.disi.unige.it/person/MoggiE/ftp/ic91.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philip+Wadler"}> Philip Wadler
                , Section 2.3 in:
                = succeed "," do
                  %em Monads for functional programming
                %em Program Design Calculi
                NATO ASI Series,
                %strong 118
                Springer (1992) &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/978-3-662-02880-3_8"}> doi;10.1007/978-3-662-02880-3_8
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://homepages.inf.ed.ac.uk/wadler/papers/marktoberdorf/baastad.pdf"} pdf
            %li#BentonHughesMoggi02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nick+Benton"}> Nick Benton
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Hughes"} John Hughes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eugenio+Moggi"} Eugenio Moggi
                = succeed "," do
                  %em Monads and Effects
                = succeed "," do
                  %em Applied Semantics
                = succeed "," do
                  %strong 2395
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/3-540-45699-6_2"} doi:10.1007/3-540-45699-6_2
            %li#PlotkinPower02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Plotkin"}> Gordon Plotkin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Power"} John Power
                %em Notions of computation determine monads
                In: M. Nielsen, U. Engberg, (eds.) FOSSACS 2002. LNCS, Lecture Notes in Computer Science
                = succeed "," do
                  %strong 2303
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/3-540-45931-6_24"} doi:10.1007/3-540-45931-6_24p
          %p Exposition:
          %ul
            %li#Milewski19
              %a.existingWikiWord{:href => "/nlab/show/Bartosz+Milewski"}> Bartosz Milewski
              , §21.2.5 in:
              = succeed "," do
                %em Category Theory for Programmers
              = succeed "," do
                %a{:href => "https://github.com/hmemcpy/milewski-ctfp-pdf/releases/download/v1.3.0/category-theory-for-programmers.pdf"} pdf
              = succeed "," do
                %a{:href => "https://github.com/hmemcpy/milewski-ctfp-pdf"} github
              = succeed "," do
                %a{:href => "https://bartoszmilewski.com/2014/10/28/category-theory-for-programmers-the-preface/"} webpage
              = succeed "&rbrack;" do
                %a{:href => "https://www.blurb.com/b/9621951-category-theory-for-programmers-new-edition-hardco"} ISBN:9780464243878
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/module+of+a+monad"} modules
            (“algebras”) of the state monad:
          %ul
