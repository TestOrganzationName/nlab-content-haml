                              %mo ⊣
                            %annotation{:encoding => "application/x-tex"} \dashv
                        %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#Definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#realization_in_dependent_type_theory"} Realization in dependent type theory
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em state monad
            is the name for the
            %a.existingWikiWord{:href => "/nlab/show/monad+in+computer+science"} monad in computer science
            which is used to implement the functionality of read/write on a global “mutable state” (a global variable) in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functional+programming+languages"} functional programming languages
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/functional+program"} functional program
            with
          %ol
            %li
              %p
                input of (
                %a.existingWikiWord{:href => "/nlab/show/data+type"}> data-
                )
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                output of
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %li
              %p
                and “mutable state” of
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %p
                (e.g. the state of a “random access memory” device, cf.
                = succeed ")" do
                  %a{:href => "#Yates19"} Yates (2019), p. 26 &amp; Fig. 1.10
          %p#IsClearly
            is clearly a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            (
            %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
            ) of
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            between the
            %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            (also known as a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Mealy+machine"} Mealy machine
            %a{:href => "Mealy+machine#MealyMachinesAsEffectfulMaps"} there
            and cf.
            = succeed "):" do
              %a{:href => "#OliveiraMiraldo16"} Oliveira &amp; Miraldo 2016, p. 462
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi prog
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ×
                  %mi W
                  %mo ⟶
                  %mi Y
                  %mo ×
                  %mi W
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  prog
                  \\;\colon\;
                  X \times W
                  \\longrightarrow
                  Y \times W
                  \\,.
          %p
            Now, under the
            %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
            of the (
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed ")-" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            (
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"}> internal hom
            ):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %mo{:stretchy => "false"} [
                  %mi W
                  %mo ,
                  %mi W
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \longrightarrow [W, W \times Y ]
                  \\,.
          %p
            Here the operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi W
                  %mo ,
                  %mi W
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [W, W\times (-)]
            is the
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on the type system which is induced by the above
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of this monad.
          %p#RAM
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monad+%28in+computer+science%29"} monads in computer science
            %em state monad
            for mutable states of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of Random-Access-Memory:
          %center
            %img{:src => "/nlab/files/State-Effectful-Program-230804.jpg", :width => "600"}/
          %h2#Definition Definition
          %p
            Concretely, with the
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            functor being
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi State
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi D
                  %mspace{:width => "thinmathspace"}
                  %mo ↦
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi W
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi W
                  %mo ×
                  %mi D
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                %annotation{:encoding => "application/x-tex"}
                  W State \;\colon\; D \,\mapsto\, \big[W,\, W \times D \big]
          %p
            the join operation of the
            = succeed "-state" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            on the intermediate
            = succeed "-variable," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/StateMonadBinding-230828.jpg", :width => "750px"}/
          %p
            To see more in detail how this encodes access to a global variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo{:lspace => "verythinmathspace"} :
                  %mi W
                %annotation{:encoding => "application/x-tex"} w \colon W
            in the sense of
            %a.existingWikiWord{:href => "/nlab/show/programming+languages"} programming languages
            consider the following operations which isolate the processes of reading from and writing to that variable, respectively:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi read
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi W
                          %mi State
                          %mo{:stretchy => "false"} (
                          %mi W
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi read
                        %mtd
                          %mo ≡
                        %mtd
                          %mi w
                          %mo ↦
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo ,
                          %mi w
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi write
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi W
                          %mo →
                          %mi W
                          %mi State
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi write
                        %mtd
                          %mo ≡
                        %mtd
                          %mi w
                          %mo ↦
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo ′
                          %mo ↦
                          %mi w
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  read &amp;\colon&amp; W State(W)
                  \\\
                  read &amp;\equiv&amp; w \mapsto (w,w)
                  }
                  \\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;
                  \\array{
                  write &amp;\colon&amp; W \to W State(\ast)
                  \\\
                  write &amp;\equiv&amp; w \mapsto (w' \mapsto w)
                  }
          %p With these, for instance the procedure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi inc
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi ℕ
                          %mi State
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi inc
                        %mtd
                          %mo ≡
                        %mtd
                          %mi n
                          %mo ↦
                          %mi n
                          %mo +
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  inc &amp;\colon&amp; \mathbb{N}State(\ast)
                  \\\
                  inc &amp;\equiv&amp; n \mapsto n+1
                  }
          %p
            which first reads-in the state of a global natural number variable and then overwrites it by its increment may be constructed as shown (on the right in
            = succeed ")" do
              %a{:href => "monad+in+computer+science#DoNotation"} do-notation
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/StatefulNumberIncrementInDONotation-230828.jpg", :width => "560px"}/
          %p
            (This is essentially the example from
            = succeed ")" do
              %a{:href => "#BentonHughesMoggi02"} Benton, Hughes &amp; Moggi 2002 p. 68 &amp; 71
          %h2#properties Properties
          %h3#realization_in_dependent_type_theory Realization in dependent type theory
          %p
            In a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/locally+Cartesian+closed+category"} locally Cartesian closed category
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is associated its
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi W
                  %mover
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mi W
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi W
                            %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi W
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}_{/W}
                  \\stackrel{\overset{\sum_W}{\longrightarrow}}{\stackrel{\overset{W^\ast}{\longleftarrow}}{\underset{\prod_W}{\longrightarrow}}}
                  \\mathbf{H}
                  \\,.
          %p In terms of this the state monad is the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi State
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi W
                  %msup
                    %mi W
                    %mo *
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi W
                  %msup
                    %mi W
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  State = \prod_W W^\ast \sum_W W^\ast
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/context+extension"} context extension
            followed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/context+extension"} context extension
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi W
                  %msup
                    %mi W
                    %mo *
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi W
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \prod_W W^\ast = [W,-]
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/function+monad"} function monad
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/reader+monad"} reader monad
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi W
                  %msup
                    %mi W
                    %mo *
                  %mo =
                  %mi W
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_W W^\ast = W \times (-)
            is the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/coreader+comonad"} coreader comonad
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mealy+machine"} Mealy machine
            %li
              %p
