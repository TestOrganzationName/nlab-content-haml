              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coprime+integers"} coprime integers
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            whose orbi-singular (
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"}> fixed
            ) locus has
