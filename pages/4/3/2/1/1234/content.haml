            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/mixed+motives"} mixed motives
          %h2#construction Construction
          %p
            Fix some
            %a.existingWikiWord{:href => "/nlab/show/adequate+equivalence+relation"} adequate equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            (e.g.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/rational+equivalence"} rational equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Z
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z^i(X)
            denote the group of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimensional
            %a.existingWikiWord{:href => "/nlab/show/algebraic+cycles"} algebraic cycles
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi A
                    %mo ∼
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^i_\sim(X)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} Z^i(X)/\sim
          %h3#category_of_correspondences Category of correspondences
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mo ∼
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_\sim(k)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            %a.existingWikiWord{:href => "/nlab/show/smooth+variety"} smooth
            %a.existingWikiWord{:href => "/nlab/show/projective+varieties"} projective varieties
            and whose
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            are the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mi i
                  %msubsup
                    %mi A
                    %mo ∼
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Corr_\sim(h(X),h(Y)) = \bigoplus_i A^{n_i}_\sim(X_i \times Y)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_i)
            are the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+components"} irreducible components
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi i
                %annotation{:encoding => "application/x-tex"} n_i
            are their respective
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dimensions"} dimensions
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of two
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha \in Corr(X,Y)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo ∈
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta \in Corr(Y,Z)
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mrow
                      %mi XZ
                      %mo ,
                      %mo *
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi p
                    %mi XY
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo .
                  %msubsup
                    %mi p
                    %mi YZ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi β
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p_{XZ,*} (p_{XY}^*(\alpha) . p_{YZ}^*(\beta))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi XY
                %annotation{:encoding => "application/x-tex"} p_{XY}
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                  %mo ×
                  %mi Z
                  %mo →
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y \times Z \to X \times Y
            and so on, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo .
                %annotation{:encoding => "application/x-tex"} .
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/intersection+product"} intersection product
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo ×
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X \times Y \times Z
          %p
            There is a canonical
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %mi SmProj
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Corr
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  h \colon SmProj(k) \to Corr_\sim(k)
          %p
            from the category of smooth projective varieties over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            given by
            %a.existingWikiWord{:href => "/nlab/show/mapping"} mapping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \mapsto X
            and a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of its
            %a.existingWikiWord{:href => "/nlab/show/graph+morphism"} graph morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \Gamma_f : X \to X \times Y
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category+of+correspondences"} category of correspondences
            is
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(X) \otimes h(Y) \coloneqq h(X \times Y)
          %p
            We also define a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Corr_\sim(k, R)
            of correspondences with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in some
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensoring
            the morphisms with
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/linear+category"} linear category
            %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            category.
          %h3#category_of_effective_pure_motives Category of effective pure motives
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
            (pseudo-abelianisation) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Corr_\sim(k, R)
            is called the category of
            %strong effective pure motives
            (with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and with respect to the equivalence relation
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Mot
                      %mo ∼
                      %mi eff
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mot^eff_\sim(k, R)
          %p
            Explicitly its objects are
            %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (h(X), p)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a smooth projective variety and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p \in Corr(h(X), h(X))
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (h(X), p)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (h(Y), q)
            are morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h(X) \to h(Y)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} Corr_\sim
            of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∘
                  %mi α
                  %mo ∘
                  %mi p
                %annotation{:encoding => "application/x-tex"} q \circ \alpha \circ p
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msub
                      %mi Corr
                      %mo ∼
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in Corr_{\sim}(h(X), h(Y))
          %p
            This is still a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            category with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo ×
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (h(X), p) \otimes (h(Y), q) = (h(X \times Y), p \times q)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Karoubian+category"} Karoubian
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/linear+category"} linear
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
          %p
            The image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi SmProj
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \in SmProj(k)
            under the above functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %mi SmProj
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Corr
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi Mot
                    %mo ∼
                    %mi eff
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  h \colon SmProj(k) \to Corr_\sim(k,A) \to Mot^{eff}_\sim(k,R)
          %p
            is the
            = succeed "." do
              %strong
                the motive of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h3#category_of_pure_motives Category of pure motives
          %p
            There exists a motive
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Lefschetz+motive"} Lefschetz motive
            %a.existingWikiWord{:href => "/nlab/show/projective+line"} projective line
            decomposes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Spec
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} h(\mathbf{P}^1_k) = h(\Spec(k)) \oplus \mathbf{L}
          %p
            To get a
            %a.existingWikiWord{:href => "/nlab/show/rigid+category"} rigid category
            we formally invert the Lefschetz motive and get a category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mot
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msubsup
                    %mi Mot
                    %mo ∼
                    %mi eff
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Mot_\sim(k, R)
                  \\coloneqq
                  Mot^{eff}_\sim(k,R)[\mathbf{L}^{-1}]
                  \\,,
          %p
            the
            %strong category of pure motives
            (with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and with respect to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
          %p
            This is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rigid+category"} rigid
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Karoubian+category"} Karoubian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (h(X), p, n)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} n \in \mathbf{Z}
          %h3#category_of_pure_chow_motives Category of pure Chow motives
          %p
            When the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            is
            %a.existingWikiWord{:href => "/nlab/show/rational+equivalence"} rational equivalence
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi A
                    %mo ∼
                    %mo *
                %annotation{:encoding => "application/x-tex"} A^*_\sim
            are the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chow+groups"} Chow groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mot
                    %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Mot
                    %mi rat
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mot_\sim(k) = Mot_{rat}(k)
            is called the category of
            = succeed "." do
              %strong
                pure
                %a.existingWikiWord{:href => "/nlab/show/Chow+motives"} Chow motives
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Weil+cohomology+theory"} Weil cohomology theories
          %h3#category_of_pure_numerical_motives Category of pure numerical motives
          %p
            When the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/numerical+equivalence"} numerical equivalence
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/numerical+motives"} numerical motives
            %a.existingWikiWord{:href => "/nlab/show/semisimple+category"} semisimple
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %a.existingWikiWord{:href => "/nlab/show/Uwe+Jannsen"} Uwe Jannsen
            proved that numerical equivalence is the only
            %a.existingWikiWord{:href => "/nlab/show/adequate+equivalence+relation"} adequate equivalence relation
            that gives a semisimple abelian category of pure motives.
