                                    %mi A
                                    %mo ,
                                    %mi B
                                    %mo ,
                                    %mi N
                                    %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi BMod
                                %mo ⊗
                            %mtd
                              %mo →
                            %mtd
                              %msup
                                %mi Assoc
                                %mo ⊗
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    BMod(\mathcal{C})
                    \\simeq
                    {Alg_{BMod}}_{/Assoc}(\mathcal{C})
                    \\simeq
                    \\left\{
                    \\array{
                    \&amp;&amp; \mathcal{C}
                    \\\
                    \&amp;{}^{\mathllap{(A,B,N)}}\nearrow&amp; \downarrow
                    \\\
                    BMod^\otimes &amp;\to&amp; Assoc^\otimes
                    }
                    \\right\}
          .num_remark
            %h6#remark_3 Remark
            %p
              Let
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_42.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi B
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                  %annotation{:encoding => "application/x-tex"}
                    (A_1,B_1,N_1) \to
            %p
              in
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} BMod(\mathcal{C})
              is a pair
              = succeed "," do
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi A
                        %mn 1
                      %mo →
                      %msub
                        %mi A
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi_1 \colon A_1 \to A_1
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mn 1
                    %mo →
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \rho \colon B_1 \to B_2
              of algebra homomorphisms and a morphism
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \kappa \colon N_1 \to N_2
              which is “linear in both
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "\u201D" do
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/intertwiner"} intertwiner
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              and
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              in that for all
              = succeed "," do
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
              and
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \in N
              we have
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_54.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⋅
                    %mi n
                    %mo ⋅
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi κ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa(a \cdot n \cdot b) = \phi(a) \cdot \kappa(n)
                    \\,.
            %p It is natural to depict this by the square diagram
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_55.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi N
                                  %mn 1
                          %mtd
                            %msub
                              %mi B
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ϕ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ⇓
                              %mi κ
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi N
                                  %mn 2
                          %mtd
                            %msub
                              %mi B
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_1 &amp;\stackrel{N_1}{\to}&amp; B_1
                    \\\
                    {}^{\mathllap{\phi}}\downarrow
                    \&amp;
                    \\Downarrow^{\kappa}
                    \&amp;
                    \\downarrow^{\mathrlap{\rho}}
                    \\\
                    A_2 &amp;\underset{N_2}{\to}&amp; B_2
                    }
                    \\,.
            %p
              This notation is naturally suggestive of the existence of the further
              %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+%28%E2%88%9E%2C1%29-modules"} tensor product of (∞,1)-modules
              = succeed "." do
                %a{:href => "#TensorProductOfBimodules"} below
            %p
              On the other hand, a morphism
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1 \to N_2
              in
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi A
                    %mi BMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi B
                  %annotation{:encoding => "application/x-tex"} {}_A BMod(\mathcal{C})_B
              is given by the special case of the above for
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} \phi = id
              and
              = succeed "." do
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo =
                      %mi id
                    %annotation{:encoding => "application/x-tex"} \rho = id
          %h3#TensorProductOfBimodules
            Tensor products of
            = succeed "-Bimodules" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          #NotationForTensS.num_defn
            %h6#definition_notation_2 Definition (Notation)
            %p
              Write
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Tens
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Tens^\otimes
              for the
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28%E2%88%9E%2C1%29-operad"} generalized (∞,1)-operad
              discussed at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+%E2%88%9E-modules"} tensor product of ∞-modules
            %p
              For
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} S \to \Delta^{op}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              (given as a map of simplicial sets from a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_64.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tens
                      %mi S
                      %mo ⊗
                    %mo ≔
                    %msup
                      %mi Tens
                      %mo ⊗
                    %munder
                      %mo ×
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    Tens^\otimes_{S}
                    \\coloneqq
                    Tens^\otimes \underset{\Delta^{op}}{\times} S
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %p
              Moreover, for
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msubsup
                      %mi Tens
                      %mi S
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes \to Tens^\otimes_S
              a
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              which exhibits
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes
              as an
              = succeed "-" do
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/family+of+%28%E2%88%9E%2C1%29-operads"} family of (∞,1)-operads
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_68.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi Fun
                      %mrow
                        %msubsup
                          %mi Tens
                          %mi S
                          %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Step
                      %mi S
                    %mo ,
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Alg_S(\mathcal{C}) \hookrightarrow Fun_{Tens^\otimes_S}(Step_S, \mathcal{C}^\otimes)
            %p
              for the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              on those
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
              which send inert morphisms to inert morphisms.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, notation 4.3.4.15
            )
          %h3#the_category_of_algebras_and_bimodules
            The
            = succeed "-Category" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            = succeed "-algebras" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            We discuss the generalization of the notion of bimodules to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            = succeed ")." do
              %a{:href => "#Lurie"} Lurie, section 4.3
          %p
            Let
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
            such that
          %ol
            %li
              %p
                it admits
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                of
                %a.existingWikiWord{:href => "/nlab/show/simplicial+objects+in+an+%28%E2%88%9E%2C1%29-category"} simplicial objects in an (∞,1)-category
                (hence a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi 𝒞
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} {\vert-\vert} \colon \mathcal{C}^{\Delta^{op}} \to \mathcal{C}
                to the constant simplicial object functor), true notably when
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo ×
                      %mi 𝒞
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \otimes \colon \mathcal{C}\times \mathcal{C} \to \mathcal{C}
                preserves this geometric realization separately in each argument.
          %p
            Then there is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(\mathcal{C})
            which given as an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+object"} (∞,1)-category object
            internal to
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
            has
          %ul
            %li
              %p
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-category of objects
              .maruku-equation
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_77.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi Alg
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Mod(\mathcal{C})_{[0]} \simeq Alg(\mathcal{C})
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebras"} A-∞ algebras
                and
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra"} ∞-algebra
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                in
                = succeed ";" do
                  %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-category of morphisms
              .maruku-equation
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_80.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi BMod
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Mod(\mathcal{C})_{[1]} \simeq BMod(\mathcal{C})
              %p
                the
                = succeed "-bimodules" do
                  %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/intertwiners"} intertwiners
                %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, def. 4.3.6.10, remark 4.3.6.11
            ).
          %p
            Morover, the
            %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
            of bimodules in this
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            is indeed the relative
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+%E2%88%9E-modules"} tensor product of ∞-modules
          .maruku-equation
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_83.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∘
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi C
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mrow
                    %mi A
                  %msub
                    %mi Mod
                    %mi B
                  %mo ×
                  %msub
                    %mrow
                    %mi B
                  %msub
                    %mi Mod
                    %mi C
                  %mo →
                  %msub
                    %mrow
                    %mi A
                  %msub
                    %mi Mod
                    %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\circ_{A,B,C}
                  \=
                  (-) \otimes_B (-)
                  \\;\colon\;
                  {}_A Mod_{B} \times {}_{B}Mod_C \to {}_A Mod_C
                  \\,.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, lemma 4.3.6.9 (3)
            ).
          %p Here are some steps in the construction:
          %p
            The
            %strong idea
            of the following constructions is this: we start with a
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28%E2%88%9E%2C1%29-operad"} generalized (∞,1)-operad
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Tens
                    %mo ⊗
                  %mo →
                  %msub
                    %mi FinSet
                    %mo *
                  %mo ×
                  %msup
                    %mi Δ
                    %mi op
                %annotation{:encoding => "application/x-tex"} Tens^\otimes \to FinSet_* \times \Delta^{op}
            which is such that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-algebras+over+an+%28%E2%88%9E%2C1%29-operad"} (∞,1)-algebras over an (∞,1)-operad
            over its fiber over
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msup
                    %mi Δ
                    %mi op
                %annotation{:encoding => "application/x-tex"} [k] \in \Delta^{op}
            is equivalently the collection of
            = succeed "-tuples" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebras"} A-∞ algebras
            in
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            together with a string of
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            = succeed "-bimodules" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object
            in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
          .maruku-equation
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_90.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Mod(\mathcal{C}) \in ((\infty,1)Cat)^{\Delta^{op}}
                  \\,.
          %p
            This turns out to be an
            %a.existingWikiWord{:href => "/nlab/show/internal+%28%E2%88%9E%2C1%29-category"} internal (∞,1)-category
            object in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            whose object of objects is the category
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Alg(\mathcal{C})
            of
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebras"} A-∞ algebras
            and
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            in
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            between them, and whose object of morphisms is the category
            %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BMod
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} BMod(\mathcal{C})
            of
            = succeed "-bimodules" do
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intertwiners"} intertwiners
          .num_defn
            %h6#definition_3 Definition
            %p
              Define
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_95.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Mod(\mathcal{C}) \to \Delta^{op}
              as the map of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              with the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              that for every other map of simplicial set
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_96.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} K \to \Delta^{op}
              there is a canonical bijection
            .maruku-equation
              %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_97.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi sSet
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi Δ
                          %mi op
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Alg
                      %mrow
                        %msub
                          %mi Tens
                          %mi K
                        %mo{:stretchy => "false"} /
                        %mi Assoc
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{sSet/\Delta^{op}}(K, Mod(\mathcal{C}))
                    \\simeq
                    Alg_{Tens_K / Assoc}( \mathcal{C} )
                    \\,,
            %p where
            %ul
              %li
                %p
                  on the left we have the hom-simplicial set in the
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %li
                %p
                  on the right we have the
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-algebras+over+an+%28%E2%88%9E%2C1%29-operad"} (∞,1)-algebras over an (∞,1)-operad
                  given by lifts
                  %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_98.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  in
                .maruku-equation
                  %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_99.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mi 𝒞
                                  %mo ⊗
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mi 𝒜
                                %mo ↗
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %msub
                                  %mi Tens
                                  %mi K
                              %mtd
                                %mo →
                              %mtd
                                %mi Assoc
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; \mathcal{C}^\otimes
                        \\\
                        \&amp;{}^{\mathcal{A}}\nearrow&amp; \downarrow
                        \\\
                        Tens_K &amp;\to&amp; Assoc
                        }
                        \\,.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, cor. 4.3.6.2
            ) specified to the case of (
            %a{:href => "#Lurie"}> Lurie, lemma 4.3.6.9
            ). Also (
            %a{:href => "#Lurie"}> Lurie, def. 4.3.4.19
            )
          %h2#references References
          %p
            The general theory in terms of
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operads"} (∞,1)-operads
            is discussed in section 4.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p
            Specifically the homotopy theory of
            %span.newWikiWord
              A-infinity bimodules
              %a{:href => "/nlab/new/A-infinity+bimodules"} ?
            is discussed in
          %ul
            %li
              Volodymyr Lyubashenko, Oleksandr Manzyuk,
              %em A-infinity-bimodules and Serre A-infinity-functors
              (
              %a{:href => "http://arxiv.org/abs/math/0701165"}> arXiv:math/0701165
              )
          %p and section 5.4.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Boris+Tsygan"}> Boris Tsygan
              ,
              %em Noncommutative calculus and operads
              in
              %p
                Guillermo Cortinas (ed.)
                = succeed "," do
                  %em Topics in Noncommutative geometry
          %p
            The generalization to
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-modules"} (infinity,n)-modules
            is in
          %ul
            %li#Haugseng14
              %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"}> Rune Haugseng
              ,
              %em
                The higher Morita category of
                = succeed "-algebras" do
                  %math#mathml_1a03ffc10183a0ccb3a0a10150bb6f2bb0af35cf_100.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi n
                      %annotation{:encoding => "application/x-tex"} E_n
              (
              %a{:href => "http://arxiv.org/abs/1412.8459"}> arXiv:1412.8459
              )
        .revisedby
