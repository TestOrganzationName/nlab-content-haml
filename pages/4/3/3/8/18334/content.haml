                = succeed "," do
                  %em Quantum Physics meets Mathematics
                = succeed ")" do
                  %a{:href => "http://aschenkel.eu/Hamburg17.pdf"} pdf slides
            %li#BeniniSchenkel19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
                = succeed "," do
                  %em Higher Structures in Algebraic Quantum Field Theory
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Structures+in+M-Theory+2018"} Higher Structures in M-Theory 2018
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1903.02878"} arXiv:1903.02878
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1002/prop.201910015"} doi:10.1002/prop.201910015
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simen+Bruinsma"}> Simen Bruinsma
                ,
