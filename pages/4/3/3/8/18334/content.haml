                Fortschritte der Physik, Special Issue Volume 67, Issue 8-9 (
                %a{:href => "https://arxiv.org/abs/1903.02863"} arXiv:1903.02863
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1002/prop.201910004"} doi:10.1002/prop.201910004
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
                = succeed "," do
