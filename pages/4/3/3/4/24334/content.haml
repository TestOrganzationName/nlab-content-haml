                represents
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos#A1ExhibitingCohesion"} localization at the simplicial interval
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi 𝕀
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L_\mathbb{I}(A)
                for
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+anima"} simplicial anima
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \flat A
                represents the
                %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
                which takes a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+anima"} simplicial anima
                and returns its
                %a.existingWikiWord{:href => "/nlab/show/core"} core
                discrete
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/anima"} anima
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \sharp A
                represents the
                %a.existingWikiWord{:href => "/nlab/show/complete+graph"} complete graph
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
                which takes a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+anima"} simplicial anima
                and returns its codiscrete anima, which has the same objects as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                but where every
                %a.existingWikiWord{:href => "/nlab/show/hom-type"} hom-type
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \sharp A
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                %a.existingWikiWord{:href => "/nlab/show/higher+inductive-inductive+type"} higher inductive-inductive type
                that is generated by a type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \sharp A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mo ♯
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A \to \sharp A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} hom
                        %mrow
                          %mo ♯
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo :
                          %mo ♯
                          %mi A
                          %mo ,
                          %mi y
                          %mo :
                          %mo ♯
                          %mi A
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathrm{hom}_{\sharp A}(x, y))_{(x:\sharp A, y:\sharp A)}
                such that each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} hom
                        %mrow
                          %mo ♯
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{hom}_{\sharp A}(x, y)
                is
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalent
                to the
                %a.existingWikiWord{:href => "/nlab/show/cone+type"} cone type
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Cone
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi{:mathvariant => "normal"} hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Cone}(\mathrm{hom}_{A}(x, y))
          %p There are also two other modalities
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/op+modality"} op modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %annotation{:encoding => "application/x-tex"} A^\op
                which reverses all (higher) morphisms in a type. This modality is an
                %a.existingWikiWord{:href => "/nlab/show/involution"} involution
                on types (i.e.
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi A
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                        %mo ≃
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (A^\op)^\op \simeq A)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                        %msup
                          %mi A
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                        %mo ≃
                        %mo ♭
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \flat A^\op \simeq \flat A
                %a.existingWikiWord{:href => "/nlab/show/opposite+simplicial+anima"} opposite simplicial anima
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+modality"} twisted arrow modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi{:mathvariant => "normal"} tw
                    %annotation{:encoding => "application/x-tex"} A^\mathrm{tw}
                which represents the
                %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+construction"} twisted arrow construction
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+anima"} simplicial anima
          %p
            In addition, simplicial type theory comes with a designated
            %a.existingWikiWord{:href => "/nlab/show/bounded+total+order"} bounded total order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathbb{I}
            called a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/directed+interval"} directed interval
          %ul
            %li
              %p
                there is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo :
                      %msup
                        %mi 𝕀
                        %mi op
                      %mo ≃
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \neg:\mathbb{I}^op \simeq \mathbb{I}
                which swaps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi max
                    %annotation{:encoding => "application/x-tex"} \max
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi min
                      %annotation{:encoding => "application/x-tex"} \min
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/booleans"} booleans
                are the global points of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
                %a.existingWikiWord{:href => "/nlab/show/monotonic+function"} monotonic function
                from the
                %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{2}
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}
                is an
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+types"} embedding of types
                and the unique endpoints-preserving monotonic function from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{2}
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \flat \mathbb{I}
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %li
              %p
                the
                = succeed ":" do
                  %strong
                    axiom of simplicial
                    %a.existingWikiWord{:href => "/nlab/show/axiom+of+cohesion"} cohesion
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "-counit" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ♭
                      %mi A
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \flat(-):\flat A \to A
                is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                if and only if the function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} const
                        %mrow
                          %mi A
                          %mo ,
                          %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \mathrm{const}_{A, \mathbb{I}}
                which takes elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to constant functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbb{I} \to A
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %li
              %p
                the interval
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos#A1ExhibitingCohesion"} exhibits the cohesion
                of types: the shape modality is equivalent to
                %a.existingWikiWord{:href => "/nlab/show/localization+of+a+type"} localization
                at
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mi A
                        %mo ≃
                        %msub
                          %mi L
                          %mi 𝕀
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \esh A \simeq L_\mathbb{I}(A)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-cubes detect continuity: for every crisp function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f::A \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is
                = succeed "-modal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                      %annotation{:encoding => "application/x-tex"} \sharp
                %a.existingWikiWord{:href => "/nlab/show/if+and+only+if"} if and only if
                it lifts up against the
                = succeed "-counit" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ♭
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝕀
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝕀
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \flat(-):\flat(\mathrm{Fin}(n) \to \mathbb{I}) \to (\mathrm{Fin}(n) \to \mathbb{I})
                for all crisp natural numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo :
                        %mo :
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n::\mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo :
                          %mi ℕ
                      %mi i
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n) \coloneqq \sum_{i:\mathbb{N}} i \lt n
                is the crisp standard
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                elements.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}
                is
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/tiny+object"} tiny
                %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
                %a.existingWikiWord{:href => "/nlab/show/modality"} modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo :
                          %mi 𝕀
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \prod_{i:\mathbb{I}} (-)(i)
                has an
                %a.existingWikiWord{:href => "/nlab/show/amazing+right+adjoint"} amazing right adjoint
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} (-)^{1/\mathbb{I}}
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/synthetic+quasi-coherence"} synthetic quasi-coherence
                %a.existingWikiWord{:href => "/nlab/show/duality"} duality
                axiom for
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                be a finitely presented
                = succeed "-algebra," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a
                %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
                equivalent to the quotient of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕀
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mi …
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}[x_1 \ldots x_n]
                by finitely many relations, and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} hom
                        %mrow
                          %mi 𝕀
                          %mi{:mathvariant => "normal"} Alg
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi 𝕀
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{hom}_{\mathbb{I}\mathrm{Alg}}(A, \mathbb{I})
                be the type of
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi a
                  %mo .
                  %mi λ
                  %mi f
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mrow
                      %mi 𝕀
                      %mi{:mathvariant => "normal"} Alg
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi 𝕀
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝕀
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda a.\lambda f.f(a):A \to (\mathrm{hom}_{\mathbb{I}\mathrm{Alg}}(A, \mathbb{I}) \to \mathbb{I})
          %h3#formalising_the_directed_interval Formalising the directed interval
          %p There are many different ways to formalize the directed interval in simplicial type theory:
          %ul
            %li
              %p
                one could simply postulate in vanilla
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
                via inference rules and axioms a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bounded+total+order"} bounded total order
                %a{:href => "#GWB24"} Gratzer, Weinberger, &amp; Buchholtz 2024
                and
                = succeed "." do
                  %a{:href => "#GWB25"} Gratzer, Weinberger, &amp; Buchholtz 2025
            %li
              %p
                one could use
                %a.existingWikiWord{:href => "/nlab/show/two-level+type+theory"} two-level type theory
                consisting of a non-fibrant layer, and then axiomatise a
                %a.existingWikiWord{:href => "/nlab/show/bounded+total+order"} bounded total order
                in the non-fibrant layer
            %li
              %p
                one could use
                %a.existingWikiWord{:href => "/nlab/show/type+theory+with+shapes"} type theory with shapes
                consisting of a non-fibrant layer of cubes which is a
                %a.existingWikiWord{:href => "/nlab/show/simple+type+theory"} simple type theory
                and a non-fibrant layer of topes which is a
                %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
                over the cube layer, and then define the
                %a.existingWikiWord{:href => "/nlab/show/bounded+total+order"} bounded total order
                using the cube and tope layers, as in
                = succeed "." do
                  %a{:href => "#RiehlShulman17"} Riehl &amp; Shulman 2017
          %p
            The first approach is simpler to define, while the latter two are easier to work with, since the equalities in the directed interval type are
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            rather than
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            hell.
          %p
            In the latter two approaches, the
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbb{I} \to A
            used in the axiom of cohesion is usually defined as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extension+type"} extension type
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+type"} dependent function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi 𝕀
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{i:\mathbb{I}} A(i)
            is usually defined as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+extension+type"} dependent extension type
          %h2#simplicial_anima_theory_and_category_theory
            Simplicial anima theory and
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#morphisms Morphisms
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} y:A
            in a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are defined in simplicial type theory as a
            %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
            consisting of a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi 𝕀
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
            and two identifications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 0
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} p_0:f(0) = x
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p_1:f(1) = y
            %em
              %a.existingWikiWord{:href => "/nlab/show/hom-type"} hom-type
            and is defined as the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hom}_A(x, y) \coloneqq \sum_{f:\mathbb{I} \to A} (f(0) = x) \times (f(1) = y)
          %p
            Given an element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hom}_A(x, x)
            has an
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            given by the tuple consisting of the
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathbb{I}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and two witnesses that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} f(0) = x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} f(1) = x
            both derivable from the typal
            %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo ,
                  %msubsup
                    %mi β
                    %mrow
                      %mi 𝕀
                      %mo →
                      %mi A
                    %mrow
                      %mi t
                      %mo .
                      %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msubsup
                    %mi β
                    %mrow
                      %mi 𝕀
                      %mo →
                      %mi A
                    %mrow
                      %mi t
                      %mo .
                      %mi x
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{id}_A(x) \coloneqq (\lambda t.x, \beta_{\mathbb{I} \to A}^{t.x}(0), \beta_{\mathbb{I} \to A}^{t.x}(1)):\mathrm{hom}_A(x, x)
          %p
            Given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♯
                  %mi A
                %annotation{:encoding => "application/x-tex"} \sharp A
            are contractible for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo ♯
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:\sharp A
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mo ♯
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:\sharp A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mo ♯
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mo ♯
                      %mi A
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mrow
                      %mo ♯
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:\sharp A} \prod_{y:\sharp A} \mathrm{isContr}(\mathrm{hom}_{\sharp A}(x, y))
          %h3#functors Functors
          %p
            Given two types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            induces a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_{x, y}:\mathrm{hom}_A(x, y) \to \mathrm{hom}_B(f(x), f(y))
          %p
            by postcomposition which takes a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi 𝕀
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} h:\mathbb{I} \to A
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi h
                  %mo :
                  %mi 𝕀
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f \circ h:\mathbb{I} \to B
            and by the
            %a.existingWikiWord{:href => "/nlab/show/action+on+identifications"} action on identifications
            which take identifications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 0
                  %mo :
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} p_0:h(0) = x
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f(p_0):f(h(0)) = f(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} p_1:h(1) = x
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f(p_1):f(h(1)) = f(y)
          %p
            As a result, functions can also be called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %em
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            from type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi A
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F:A^\op \to B
            from the
            %a.existingWikiWord{:href => "/nlab/show/opposite+type"} opposite type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h3#diagrams Diagrams
          %p
            Diagrams in
            %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            can be defined in an arbitrary type, rather than just the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Segal+types"} Segal types
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/composable+pair"} composable pair
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/commutative+triangle"} commutative triangle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/composite"}> composite
                ,
                %a.existingWikiWord{:href => "/nlab/show/unique+composite"} unique composite
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/span"}> span
                ,
                %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/isomorphism+in+simplicial+type+theory"} isomorphism in simplicial type theory
          %h3#limits_and_colimits Limits and colimits
          %p
            Limits and colimits in
            %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            can be defined in an arbitrary type, rather than just the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Segal+types"} Segal types
          %p Limits include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+simplicial+type+theory"} terminal object in simplicial type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-product"} (infinity,1)-product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-equalizer"} (infinity,1)-equalizer
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-pullback"} (infinity,1)-pullback
          %p Colimits include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/initial+object+in+simplicial+type+theory"} initial object in simplicial type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-coproduct"} (infinity,1)-coproduct
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-coequalizer"} (infinity,1)-coequalizer
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-pushout"} (infinity,1)-pushout
          %h3#types Types
          %p Types include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicially+discrete+type"} simplicially discrete type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Segal+type"} Segal type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rezk+complete+type"} Rezk complete type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rezk+type"} Rezk type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/gaunt+Segal+type"} gaunt Segal type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/finitely+complete+type"} finitely complete type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/finitely+cocomplete+type"} finitely cocomplete type
          %h3#heterogeneous_morphisms_and_covariant_type_families Heterogeneous morphisms and covariant type families
          %p
            Given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 0
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} p_0:f(0) =_A x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} p_1:f(1) =_A y
            a type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u:B(x)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v:B(y)
            %em
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+morphism"} heterogeneous morphism
            is a
            %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
            consisting of a
            %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi 𝕀
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g:\prod_{i:\mathbb{I}} B(f(i))
            and two
            %a.existingWikiWord{:href => "/nlab/show/indexed+heterogeneous+identifications"} indexed heterogeneous identifications
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mn 0
                  %mo :
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo =
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mo ,
                      %msub
                        %mi p
                        %mn 0
                      %mo{:stretchy => "false"} )
                  %mi u
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} and
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi q
                    %mn 1
                  %mo :
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo =
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi y
                      %mo ,
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mi v
                %annotation{:encoding => "application/x-tex"} q_0:g(0) =_{t.B(t)}^{(f(0), x, p_0)} u \; \mathrm{and} \; q_1:g(1) =_{t.B(t)}^{(f(1), y, p_1)} v
          %p
            where the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %msubsup
                    %mo =
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mi v
                %annotation{:encoding => "application/x-tex"} u =_{t.B(t)}^{(x, y, p)} v
            is the
            %a.existingWikiWord{:href => "/nlab/show/indexed+heterogeneous+identity+type"} indexed heterogeneous identity type
            over the type family
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
          %p
            The type of heterogeneous morphisms is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+hom-type"} heterogeneous hom-type
            and is defined as the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hhom
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi f
                  %mo ,
                  %msub
                    %mi p
                    %mn 0
                  %mo ,
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi u
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi g
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo :
                          %mi 𝕀
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo =
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mo ,
                      %msub
                        %mi p
                        %mn 0
                      %mo{:stretchy => "false"} )
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo =
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi y
                      %mo ,
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hhom}_{t.B(t)}(x, y, f, p_0, p_1, u, v) \coloneqq \sum_{g:\prod_{i:\mathbb{I}} B(f(i))} (g(0) =_{t.B(t)}^{(f(0), x, p_0)} u) \times (g(1) =_{t.B(t)}^{(f(1), y, p_1)} v)
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/covariant+type+family"} covariant type family
            is a
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            such that for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hom
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\mathrm{hom}_A(x, y)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u:B(x)
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} there exists a unique
            element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v:B(y)
            with a
            %a.existingWikiWord{:href => "/nlab/show/heterogeneous+morphism"} heterogeneous morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isCovariant
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi u
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo ∃
                  %mo !
                  %mi v
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo .
                  %msub
                    %mi{:mathvariant => "normal"} hhom
                    %mrow
                      %mi t
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi f
                  %mo ,
                  %msub
                    %mi p
                    %mn 0
                  %mo ,
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi u
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isCovariant}(t:A.B(t)) \coloneqq \prod_{x:A} \prod_{y:A} \prod_{f:\mathrm{hom}_A(x, y)} \prod_{u:B(x)} \exists!v:B(y).\mathrm{hhom}_{t.B(t)}(x, y, f, p_0, p_1, u, v)
          %h3#amazing_covariance_and_directed_univalent_universes Amazing covariance and directed univalent universes
          %p
            A type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            %strong amazingly covariant type
            if it satisfies the following predicate
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isACov
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi{:mathvariant => "normal"} isCov
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %msup
                    %mi A
                    %mi η
                  %mo ⋅
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathrm{isACov}(A) \coloneqq \mathrm{isCov}(i:\mathbb{I}.A^\eta \cdot i)^{1 / \mathbb{I}}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            %a.existingWikiWord{:href => "/nlab/show/directed+univalence"} directed univalent
            subuniverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ↪
                  %mi U
                %annotation{:encoding => "application/x-tex"} \mathcal{S} \hookrightarrow U
            is defined as the type of
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi X
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isACov
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{S} \coloneqq \sum_{X:U} \mathrm{isACov}(T(X))
          %p
            The directed univalent universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            is a
            %a.existingWikiWord{:href => "/nlab/show/finitely+complete+type"} finitely complete
            and
            %a.existingWikiWord{:href => "/nlab/show/finitely+cocomplete+type"} finitely cocomplete
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Rezk+type"} Rezk type
          %h2#categorical_semantics Categorical semantics
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of simplicial type theory was originally meant to be the
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-category"} locally cartesian closed (infinity,1)-category
