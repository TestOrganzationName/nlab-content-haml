                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Ω
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathcal{P}({}_-) = [({}_-)^{op},\Omega]
            have this property,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
