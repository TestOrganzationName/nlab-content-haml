                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
              assigns to every admissible object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
