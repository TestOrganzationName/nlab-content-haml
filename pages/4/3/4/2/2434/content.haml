            has the following generators:
          %p objects are generated from
          %ul
            %li
              %p
                the
                %strong circle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi ℓ
                      %mo :
                      %mo =
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                      %mo ⋅
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} K_\ell := \mathbb{R}^2/\mathbb{Z}\cdot \ell
                of length
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \ell \gt 0
                (with collars!! that’s why it looks like a cylinder of circumference
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℓ
                      %annotation{:encoding => "application/x-tex"} \ell
              %p
                notice that we may think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
                as parameteriing translation by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo ⋊
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi Eucl
                        %mi or
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \rtimes SO(2) = Eucl_{or}(\mathbb{R}^2)
              %p
                and the circle with
                = succeed "/" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (+)
                = succeed "-collars" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
