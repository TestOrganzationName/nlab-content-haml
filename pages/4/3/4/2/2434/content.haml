                      %msup
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L^2(M)
                inner product to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi t
                      %mi H
