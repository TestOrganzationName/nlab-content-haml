                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mi ℓ
                          %mo ,
                          %mi τ
                    %annotation{:encoding => "application/x-tex"} C_{\ell,\tau}
                which as a manifold is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                      %mo ⋅
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \simeq \mathbb{R}^2/\mathbb{Z}\cdot \ell
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                parameterizes the embedding of the outgoing circle: the incoming circle is embedded in the canonical way (the identity map on the cylinder, really), while the outgoing circle is embedded by translating the cylinder by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo ⋅
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ell \cdot Re(\tau)
                upwards and rotated by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℓ
                        %mi ⋯
                        %mi Im
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \ell \cdots Im(\tau)
            %li
              %p
                %strong right elbows
                which are the same as the cylinder, except that now the second circle is embedded after reflection so that it becomes an ingoing circle.
            %li
              %p
                the
                %strong thin left elbow
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi ℓ
                      %annotation{:encoding => "application/x-tex"} L_\ell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
                but
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \tau = 0
            %li
              %p
                the
                %strong torus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi τ
                    %annotation{:encoding => "application/x-tex"} T_\tau
                obtained from the cylinder by gluing incoming and outgoing
          %p
            %strong notice
            the
            %strong pair of pants
            is not a morphism in the category at all! since, recall, we require all bordisms to be
            %em flat
            and all boundaries to be
            %em geodesics
            \. There is no way to put such a flat metric on the trinion.
          %p satisfying the relations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi ℓ
                  %mo ∘
                  %msub
                    %mi R
                    %mrow
                      %mi ℓ
                      %mo ,
                      %mi τ
                  %mo =
                  %msub
                    %mi T
                    %mrow
                      %mi ℓ
                      %mo ,
                      %mi τ
                %annotation{:encoding => "application/x-tex"}
                  L_\ell \circ R_{\ell, \tau}
                  \=
                  T_{\ell, \tau}
          %p as for the non-family version, but now also with the new relations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi ℓ
                      %mo ′
                      %mo ,
                      %mi τ
                      %mo ′
                  %mo =
                  %msub
                    %mi T
                    %mrow
                      %mi ℓ
                      %mo ,
                      %mi τ
                %annotation{:encoding => "application/x-tex"}
                  T_{\ell', \tau'} = T_{\ell, \tau}
          %p
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo ′
                  %mo =
                  %mi ℓ
                  %mo ⋅
                  %mo{:stretchy => "false"} |
                  %mi c
                  %mi τ
                  %mo +
                  %mi d
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \ell' = \ell \cdot|c \tau + d|
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ′
                  %mo =
                  %mfrac
                    %mrow
                      %mi a
                      %mi τ
                      %mo +
                      %mi b
                    %mrow
                      %mi c
                      %mi τ
                      %mo +
                      %mi d
                %annotation{:encoding => "application/x-tex"} \tau' = \frac{a \tau + b }{c \tau + d}
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi a
                            %mtd
                              %mi b
                          %mtr
                            %mtd
                              %mi c
                            %mtd
                              %mi d
                      %mo )
                    %mo ∈
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left(\array{a &amp; b \\ c &amp; d }\right) \in SL_2(\mathbb{Z})
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
            is generated by
          %ul
            %li
              %p
                translation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mo ,
                      %mi τ
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\ell, \tau) \mapsto (\ell, \tau + 1)
            %li
              %p
                S-matrix
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mo ⋅
                      %mo{:stretchy => "false"} |
                      %mi τ
                      %mo{:stretchy => "false"} |
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mn 1
                        %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\ell, \tau) \mapsto (\ell \cdot |\tau|, - \frac{1}{\tau})
          %p
            and now there is
            %strong one more relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi ℓ
                      %mo ,
                      %mi τ
                  %mo =
                  %msub
                    %mi T
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} |
                      %mi τ
                      %mo{:stretchy => "false"} |
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mn 1
                        %mi τ
                %annotation{:encoding => "application/x-tex"}
                  T_{\ell, \tau}
                  \=
                  T_{\ell |\tau|, - \frac{1}{\tau}}
          %p
            as usual write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                      %mi τ
                %annotation{:encoding => "application/x-tex"} q := e^{2 \pi  i \tau}
            which is on the pointed unit disk since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            is half plane since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
          %h2#explicit_description_of__3
            explicit description of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %msubsup
                    %mi Bord
                    %mn 2
                    %mi fam
                %annotation{:encoding => "application/x-tex"} E Bord_{2}^{fam}
          %p
            thwe category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %msubsup
                    %mi Bord
                    %mrow
                      %mn 2
                      %mo ,
                      %mi oriented
                    %mi fam
                %annotation{:encoding => "application/x-tex"} E Bord_{2, oriented}^{fam}
            is generated from
          %p objects:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi K
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi S
                              %mo =
                              %msub
                                %mi ℝ
                                %mo +
                    %annotation{:encoding => "application/x-tex"} \array{K \\ \downarrow \\ S = \mathbb{R}_+}
            %li
              %p morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi L
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mi ℝ
                                %mo +
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      L \\ \downarrow \\ \mathbb{R}_+
                      }
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi R
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mi ℝ
                                %mo +
                              %mo ×
                              %mi h
                              %mo{:stretchy => "false"} /
                              %mi ℤ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      R \\ \downarrow \\ \mathbb{R}_+ \times h/\mathbb{Z}
                      }
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mi ℝ
                                %mo +
                              %mo ×
                              %mo{:stretchy => "false"} (
                              %mi h
                              %mo ∪
                              %mi ℝ
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi ℤ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C \\ \downarrow \\ \mathbb{R}_+ \times (h \cup \mathbb{R})/\mathbb{Z}
                      }
          %p subject to the relations
          %p … as before (homework 3, problem 4).. and the furhter one:
          %p for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi T
                        %mtd
                        %mtd
                          %msup
                            %mi α
                            %mo *
                          %mi T
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi ℝ
                            %mo +
                          %mo ×
                          %mi h
                        %mtd
                          %mover
                            %mo ←
                            %mi α
                        %mtd
                          %msub
                            %mi ℝ
                            %mo +
                          %mo ×
                          %mi h
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo ⋅
                          %mo{:stretchy => "false"} |
                          %mi τ
                          %mo{:stretchy => "false"} |
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mfrac
                            %mn 1
                            %mi τ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mrow
                              %mo &lt;
                              %mo ←
                            %mrow
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T  &amp;&amp; \alpha^* T
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbb{R}_+ \times h
                  \&amp;\stackrel{\alpha}{\leftarrow}&amp;
                  \\mathbb{R}_+ \times h
                  \\\
                  \\\
                  (\ell\cdot |\tau|, -\frac{1}{\tau})
                  \&amp;\stackrel{}{\lt\leftarrow}&amp;
                  (\ell, \tau)
                  }
          %p the relation is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi α
                    %mo *
                  %mi T
                  %mo =
                  %mi T
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha^* T  = T
                  \\,.
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephan+Stolz"}> Stephan Stolz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                %em
                  %a.existingWikiWord{:href => "/nlab/show/What+is+an+elliptic+object%3F"} What is an elliptic object?
                in:
                = succeed "," do
                  %em Topology, geometry and quantum field theory
                = succeed "," do
                  %strong 308
                = succeed "," do
                  %a{:href => "https://math.berkeley.edu/~teichner/Papers/Oxford.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Stolz-Teichner_EllipticObject.pdf", :title => "pdf"} pdf
            %li#Stolz
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Stolz"} Stefan Stolz
                (notes by Arlo Caine),
                %em Supersymmetric Euclidean field theories and generalized cohomology
                Lecture notes (2009) (
                %a{:href => "http://www.nd.edu/~jcaine1/pdf/Lectures_complete.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Stolz"}> Stefan Stolz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                %em Supersymmetric field theories and generalized cohomology
                , in:
                = succeed "," do
