                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} |
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2|1)
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/modular+forms+from+partition+functions"} modular forms from partition functions
          %p
            it will be shows that the claim is true at least for the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            over the point: the
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            of a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
