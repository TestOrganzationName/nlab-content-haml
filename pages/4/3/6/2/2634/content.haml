                  %div
                    %p
                      %a{:href => "/nlab/edit/physicscontents"} Edit this sidebar
          %h1#hamiltonians Hamiltonians
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#in_mechanical_systems"} In mechanical systems
              %ul
                %li
                  %a{:href => "#in_classical_mechanics"} In classical mechanics
                %li
                  %a{:href => "#in_quantum_mechanics"} In quantum mechanics
                %ul
                  %li
                    %a{:href => "#physical_meaning_and_relation_to_unitary_transformations"} Physical meaning and relation to unitary transformations
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %p
            Disambiguation: there is an unrelated notion of a Hamilton or Hamiltonian operator also called
            %a.existingWikiWord{:href => "/nlab/show/nabla"} nabla
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+analysis"} vector analysis
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \{-,-\})
            and a
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
            %strong Hamiltonian
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi v
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h_v \in C^\infty(X)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi h
                    %mi v
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{h_v,-\}
            is the
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            corresponding to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %p
            Conversely, one says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi v
                  %annotation{:encoding => "application/x-tex"} h_v
          %h2#in_mechanical_systems In mechanical systems
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanical+system"} classical mechanical system
            evolving in time, there is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            (or at least
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            that generates time evolution. Its Hamiltonian is often called
            %em the
            Hamiltonian. This is the concept that Hamilton originally considered and which hence gives the name to the general situaiton.
          %h3#in_classical_mechanics In classical mechanics
          %p
            The simplest, so-called “natural”, Hamiltonian (function) of a
            %a.existingWikiWord{:href => "/nlab/show/dynamical+system"} dynamical system
            is the sum of the kinetic and potential energy:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mi T
                  %mo +
                  %mi V
                  %mo .
                %annotation{:encoding => "application/x-tex"} H = T + V.
          %p
            Knowing only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            as a function on
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            (so as a function of
            %a.existingWikiWord{:href => "/nlab/show/position"} position
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi q
                    %mi i
                %annotation{:encoding => "application/x-tex"} q^i
            and
            %a.existingWikiWord{:href => "/nlab/show/momentum"} momentum
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/velocity"}> velocity
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi v
                          %mi i
                        %mo =
                        %mo ∂
                        %mi H
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %mrow
                          %msub
                            %mi p
                            %mi i
                      %annotation{:encoding => "application/x-tex"} v^i = \partial{H}/\partial{p_i}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/force"}> force
                ,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi i
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ∂
                        %mi H
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %mrow
                          %msup
                            %mi q
                            %mi i
                      %annotation{:encoding => "application/x-tex"} f_i = -\partial{H}/\partial{q^i}
          %p
            Setting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mi i
                  %mo =
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi q
                    %mi i
                  %mo{:stretchy => "false"} /
                  %mi{:mathvariant => "normal"} d
                  %mi t
                %annotation{:encoding => "application/x-tex"} v^i = \mathrm{d}q^i/\mathrm{d}t
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %msub
                      %mi p
                      %mi i
                    %mo{:stretchy => "false"} /
                    %mi{:mathvariant => "normal"} d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} f_i = \mathrm{d}p_i/\mathrm{d}t
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+mechanics"} Hamiltonian mechanics
          %h3#in_quantum_mechanics In quantum mechanics
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            of a point
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            in the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+picture"} Schrödinger picture
            is encoded in a
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathcal{H} \to \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            over the real line – the
            %em worldline
            – of the particle.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}
            the fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi t
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_t
            is the
            %strong
              space of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
            of the system, at given parameter time
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo ≃
                    %msub
                      %mi ℋ
                      %mn 0
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H} \simeq \mathcal{H}_0 \times \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} 1-form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            with values in
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/linear+operator"} linear operator
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi H
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ,
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A = H \;d t \in \Omega^1(\mathbb{R}, End(\mathcal{H}))
                  \\,.
          %p
            The component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
