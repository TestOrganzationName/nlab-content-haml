          %title Multisets
          %h1#multisets Multisets
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#operations_on_multisets"} Operations on multisets
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A multiset (also called a bag) is like a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{1,1,2\}
            differs from the multiset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,2\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{1,2,1\}
            is the same as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,1,2\}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            = succeed "." do
              %a{:href => "http://en.wikipedia.org/wiki/Multiset"} wikipedia
          %h2#definitions Definitions
          %p
            While it is possible to take multisets as a fundamental concept in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
          %p
            A
            %strong multiset
            = succeed ",can" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi X
                    %mo ,
                    %msub
                      %mi μ
                      %mi X
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} = \langle X,\mu_X\rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (its
            = succeed ")" do
              %strong underlying set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mu_X
            (giving each element its
            = succeed ")" do
              %strong multiplicity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a class of nonzero
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cardinal+numbers"} cardinal numbers
            %strong locally finite
            if multiplicity takes values in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %strong finite
            if it is locally finite and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
            of all objects to the class of all cardinal numbers, with the proviso that the objects whose multiplicity is nonzero form a set (the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            above).
          %p
            If we are only interested in multisets with elements drawn from a given set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (as is common in combinatorics), then an alternative definition is very useful: a
            %strong multisubset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} f\colon B \to U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} f\colon B \to U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo ′
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} f'\colon B' \to U
            are considered
            %em equal
            if there is a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi B
                  %mo ′
                %annotation{:encoding => "application/x-tex"} g\colon B \to B'
            that makes a commutative triangle. In other words, a multisubset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is an isomorphism class in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Set/U
            %em
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            as an
            %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
            to
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            A multisubset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is locally finite if every
            %a.existingWikiWord{:href => "/nlab/show/fibre"} fibre
            is finite; it is finite if additionally the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (which corresponds to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in the original definition) is finite. A locally finite multisubset can also be described as a function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            to the set of natural numbers; this is just the multiplicity function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            again, now with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (rather than
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            to be taken.
          %h2#operations_on_multisets Operations on multisets
          %p
            The operations on cardinal numbers induce operations on multisets (or on multisubsets of any given set
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            In the following, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo ,
                  %msub
                    %mi μ
                    %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \mathcal{X} = \langle X,\mu_X\rangle
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒴
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi Y
                  %mo ,
                  %msub
                    %mi μ
                    %mi Y
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \mathcal{Y} = \langle Y,\mu_Y\rangle
            be multisets.
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
                of a multiset is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi 𝒳
                      %mo{:stretchy => "false"} |
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi e
                          %mo ∈
                          %mi X
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} |\mathcal{X}| = \sum_{e\in X} \mu_X(e).
            %li
              %p
                The
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                of multisets is the multiset whose cardinality is given by the
                %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
                operation on cardinal numbers.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo ∩
                      %mi 𝒴
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi X
                      %mo ∩
                      %mi Y
                      %mo ,
                      %mi min
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi μ
                        %mi X
                      %mo ,
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟩
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}\cap\mathcal{Y} = \langle X\cap Y, \min(\mu_X,\mu_Y)\rangle.
            %li
              %p
                The
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                of multisets is the multiset whose cardinality is given by the
                %a.existingWikiWord{:href => "/nlab/show/supremum"} supremum
                operation on cardinal numbers.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo ∪
                      %mi 𝒴
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi X
                      %mo ∪
                      %mi Y
                      %mo ,
                      %mi max
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi μ
                        %mi X
                      %mo ,
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟩
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}\cup\mathcal{Y} = \langle X\cup Y, \max(\mu_X,\mu_Y)\rangle.
            %li
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/set+difference"} set difference
                of multisets is the multiset given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo \
                      %mi 𝒴
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo ∈
                      %mi X
                      %mo ∪
                      %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %msub
                        %mi μ
                        %mi X
                      %mo −
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} ⟩
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X} \backslash \mathcal{Y} = \langle \{ a \in X \cup Y \;|\; \mu_X(a) \gt \mu_Y(a) \}, \mu_X - \mu_Y \rangle .
            %li
              %p
                The
                %strong sum
                of multisets is the multiset whose cardinality is given by addition of cardinal numbers; this has no analogue for ordinary sets.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo +
                      %mi 𝒴
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi X
                      %mo ∪
                      %mi Y
                      %mo ,
                      %msub
                        %mi μ
                        %mi X
                      %mo +
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} ⟩
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}+\mathcal{Y} = \langle X\cup Y, \mu_X+\mu_Y\rangle.
            %li
              %p
                The
                %strong product
                of multisets (turning them into a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/rig"} rig
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mi 𝒴
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi X
                      %mo ∩
                      %mi Y
                      %mo ,
                      %msub
                        %mi μ
                        %mi X
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} ⟩
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}\mathcal{Y} = \langle X\cap Y, \mu_X\mu_Y\rangle.
              %p
                Note that if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
                is a set, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mi 𝒳
                      %mo =
                      %mi 𝒳
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}\mathcal{X} = \mathcal{X}.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/inner+product+of+multisets"} inner product of multisets
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi 𝒳
                      %mo ,
                      %mi 𝒴
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi e
                          %mo ∈
                          %mrow
                            %mi X
                            %mo ∩
                            %mi Y
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi μ
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \langle\mathcal{X},\mathcal{Y}\rangle = \sum_{e\in{X\cap Y}} \mu_X(e) \mu_Y(e).
              %p Note that the inner product corresponds to the cardinality of the product
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi 𝒳
                      %mo ,
                      %mi 𝒴
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} |
                      %mi 𝒳
                      %mi 𝒴
                      %mo{:stretchy => "false"} |
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \langle\mathcal{X},\mathcal{Y}\rangle = |\mathcal{X}\mathcal{Y}|.
          %h2#examples Examples
          %p …
          %ul
            %li
              See also
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+product+of+multisets"} inner product of multisets
          %h2#references References
          %ul
            %li
              %p
                %a{:href => "http://asyropoulos.eu/papers/PDF/MathMSet.pdf"}> Mathematics of Multisets
                , Apostolos Syropoulos
            %li
              %p
                %a{:href => "http://asyropoulos.eu/papers/PDF/mset.pdf"}> Categorical Models of Multisets
                , Apostolos Syropoulos
            %li
              %p
                %a{:href => "http://www.emis.de/journals/NSJOM/Papers/37_2/NSJOM_37_2_073_092.pdf"}> An Overview of the Applications of Multisets
                , D. Singh, A. M. Ibrahim, T. Yohanna and J. N. Singh
