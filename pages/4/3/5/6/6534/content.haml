          %p
            %strong Stanisław Lech Woronowicz
            is a mathematical physicist from Warsaw, a specialist in operator algebras and one of the founders of
            %a.existingWikiWord{:href => "/nlab/show/quantum+group"} quantum group
            theory.
          %ul
            %li
              %p
                %a{:href => "http://www.fuw.edu.pl/~slworono"} homepage
            %li
              %p
                %a{:href => "http://www.fuw.edu.pl/~slworono/Prace.html"} articles
            %li
              %p
                %a{:href => "http://en.wikipedia.org/wiki/S._L._Woronowicz"} Wikipedia entry
            %li
              %p
                %em> Compact matrix pseudogroups
                , Commun. Math. Phys.
                = succeed "," do
                  %strong 111
                %a{:href => "http://projecteuclid.org/euclid.cmp/1104159726"} euclid
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=0901157"} MR0901157
            %li
              %p
                %em Differential calculus on compact matrix pseudogroups (quantum groups)
                Commun. Math. Phys.
                = succeed "," do
                  %strong 122
                %a{:href => "http://projecteuclid.org/euclid.cmp/1104178320"} euclid
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=0994499"} MR0994499
            %li
              %p
                %em> Tannaka-Krein duality for compact matrix pseudogroups
                , Twisted SU(N) groups, Inventiones Mathematicae
                = succeed "," do
                  %strong 93
                %a{:href => "http://dx.doi.org/10.1007/BF01393687"} doi
            %li
              %p
                %em>
                  Unbounded elements affiliated with
                  = succeed "-algebras" do
                    %math#mathml_b0bb75c53a155bff46c3744c863c5d6542e4f4fb_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
                , Commun. Math. Phys.
                = succeed "," do
                  %strong 136
                %a{:href => "http://projecteuclid.org/euclid.cmp/1104202358"} euclid
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1096123"} MR1096123
            %li
              %p
                %em>
                  %math#mathml_b0bb75c53a155bff46c3744c863c5d6542e4f4fb_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebras generated by unbounded elements
                ,
                %a{:href => "http://www.fuw.edu.pl/~slworono/PDF-y/GENER.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S.+L.+Woronowicz"}> S. L. Woronowicz
                , K. Napiórkowski,
                = succeed "," do
                  %em
                    Operator theory in
                    = succeed "-framework" do
                      %math#mathml_b0bb75c53a155bff46c3744c863c5d6542e4f4fb_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
                = succeed "," do
                  %strong 31
