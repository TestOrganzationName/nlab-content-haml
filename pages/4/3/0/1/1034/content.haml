                      %annotation{:encoding => "application/x-tex"} U
                = succeed "-small;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
            %li
              %p
                the function set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mi S
                    %annotation{:encoding => "application/x-tex"} T^S
                for any two
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                = succeed "-small;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} union
                of a
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
