                    %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A^{*(n + 1)} \coloneqq A^{*(n)} * A
          %p
            Then the propositional truncation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
