          %h3#as_localization As localization
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            be the
            %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} \mathbb{2}
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+type+at+a+family+of+functions"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            at the unique function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟚
                    %mo →
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{2} \to \mathbb{1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %mi A
                    %mo ]
                  %mo ≔
                  %msub
                    %mi L
                    %mi 𝟚
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \left[A\right] \coloneqq L_\mathbb{2}(A)
          %p
            By definition, the type of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝟙
                  %mo →
                  %mrow
                    %mo [
                    %mi A
                    %mo ]
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi 𝟚
                  %mo →
                  %mrow
                    %mo [
                    %mi A
                    %mo ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{1} \to \left[A\right]) \to (\mathbb{2} \to \left[A\right])
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          %p
            This is the special case of the
            %a.existingWikiWord{:href => "/nlab/show/n-truncation+modality"} n-truncation modality
            as the
            %a.existingWikiWord{:href => "/nlab/show/n-truncation+modality"} n-truncation modality
            is localization at the unique map from the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
