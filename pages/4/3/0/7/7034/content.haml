                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n + 1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} \mathbb{2}
            is the zero-dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sphere+type"} sphere type
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-truncation+modality"} n-truncation modality
          %h3#as_a_sequential_colimit As a sequential colimit
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
