                      %mi A
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-]:A \to [A]
            %li
              %p
                For each function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
