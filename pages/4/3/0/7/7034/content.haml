          %h2#semantics Semantics
          %p
            One presentation of the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            of
            %a.existingWikiWord{:href => "/nlab/show/regular+categories"} regular categories
            consists of
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %span.newWikiWord
                strong extensional equality types
                %a{:href => "/nlab/new/strong+extensional+equality+types"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sums"} dependent sums
            = succeed ".)" do
              %span.newWikiWord
                logic-enriched type theory
                %a{:href => "/nlab/new/logic-enriched+type+theory"} ?
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
            of bracket types in a
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is as follows.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            (a type in
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⊢
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} x\colon X \vdash A(x) \colon Type
          %p
            is interpreted in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A
                  \\\
                  \\downarrow
                  \\\
                  X
                  }
                  \\,.
          %p The corresponding bracket type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⊢
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} x\colon X \vdash [A(x)] \colon Type
          %p
            is interpreted then as the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/image"} image
            %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} factorization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo :
                          %mo =
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo →
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;&amp;\to&amp;&amp; [A] &amp; := im(A \to X)
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; X
                  \\,.
                  }
          %p
            Therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} [A] \to X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            about the elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
