          %title Braid representations via twisted cohomology of configuration spaces
          %h3#BraidRepresentationsViaTwisteddRCohomologyOfConfigurationSpaces Braid representations via twisted cohomology of configuration spaces
          %p
            The “
            %a.existingWikiWord{:href => "/nlab/show/hypergeometric+construction+of+KZ+solutions"}> hypergeometric integral
            ” construction of
            %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
            for
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/affine+Lie+algebra"} affine Lie algebra
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            %a.existingWikiWord{:href => "/nlab/show/2d+CFTs"} 2d CFTs
            and of more general solutions to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+equation"} Knizhnik-Zamolodchikov equation
            %a.existingWikiWord{:href => "/nlab/show/twisted+de+Rham+cohomology"} twisted de Rham cohomology
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"}> Vadim Schechtman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                = succeed "," do
                  %em Integral representations of N-point conformal correlators in the WZW model
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "http://cds.cern.ch/record/1044951"} cds:1044951
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#DateJimboMatsuoMiwa90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Etsuro+Date"}> Etsuro Date
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michio+Jimbo"} Michio Jimbo
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"} Atsushi Matsuo
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tetsuji+Miwa"} Tetsuji Miwa
                = succeed "," do
                  %em
                    Hypergeometric-type integrals and the
                    = succeed "-Knizhnik-Zamolodchikov" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝔰𝔩
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
                %strong 04
                05 (1990) 1049-1057
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1142/S0217979290000528"} doi:10.1142/S0217979290000528
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
              %blockquote
                %p
                  (for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sl%282%29"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝔰𝔩
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"}> Atsushi Matsuo
                ,
                = succeed "," do
                  %em
                    An application of Aomoto-Gelfand hypergeometric functions to the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(n)
                    Knizhnik-Zamolodchikov equation
                %strong 134
                (1990) 65–77
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1007/BF02102089"} doi:10.1007/BF02102089
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"}> Vadim Schechtman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                = succeed "," do
                  %em Hypergeometric solutions of Knizhnik-Zamolodchikov equations
                %strong 20
                (1990) 279–283
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1007/BF00626523"} doi:10.1007/BF00626523
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"}> Vadim Schechtman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                = succeed "," do
                  %em Arrangements of hyperplanes and Lie algebra homology
                %strong 106
                1 (1991) 139-194
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://eudml.org/doc/143938"} dml:143938
                %a.existingWikiWord{:href => "/nlab/files/SchechtmanVarchenko_HyperplaneArrangements.pdf", :title => "pdf"} pdf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p following precursor observations due to:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+S.+Dotsenko"}> Vladimir S. Dotsenko
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vladimir+A.+Fateev"} Vladimir A. Fateev
                = succeed "," do
                  %em Conformal algebra and multipoint correlation functions in 2D statistical models
                %strong 240
                3 (1984) 312-348
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1016/0550-3213(84)90269-4"} doi:10.1016/0550-3213(84)90269-4
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philippe+Christe"}> Philippe Christe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rainald+Flume"} Rainald Flume
                = succeed "," do
                  %em
                    The four-point correlations of all primary operators of the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} d = 2
                    conformally invariant
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(2)
                    = succeed "-model" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi σ
                          %annotation{:encoding => "application/x-tex"} \sigma
              %p
                %strong 282
                (1987) 466-494
