            %p by setting
            #eq:SpaceOfSmoothFunctionsOfGivenVaishingOrderProjector.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
