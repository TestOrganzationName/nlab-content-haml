                    \\mathbb{R}_+, \cdot
                    \\right)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
              (under
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              %em
                %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              for the given choice of field species and
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameters.
          %p
            (
            %a{:href => "renormalization#Duetsch18"}> Dütsch 18, def. 3.19
            )
          #ScalarFieldMassDimensionOnMinkowskiSpacetime.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi m
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,m}
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
              for
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameter
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m \in (0,\infty)
              %a.existingWikiWord{:href => "/nlab/show/Green+function"} Green function
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            %p
              Let the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mo +
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RG \coloneqq (\mathbb{R}_+, \cdots)
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \rho \in \mathbb{R}_+
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ,
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi m
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %msup
                          %mi ρ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\rho , \Delta_{F,m})
                    \\mapsto
                    \\Delta_{F,\rho^{-1}m}(\rho (-))
                    \\,.
            %p Then we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %msup
                          %mi ρ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 2
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{F,\rho^{-1}m}(\rho (-))
                    \\;=\;
                    \\rho^{-(p+1) + 2}
                    \\Delta_{F,1}(x)
            %p
              and hence the corresponding
              %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mtext scalar field
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim(\text{scalar field})
                    \=
                    (p+1)/2 - 1
                    \\,.
          .proof
            %h6#proof_19 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#FeynmanPropagatorAsACauchyPrincipalvalue"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              in question is given by the
              = succeed "-formula" do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
              = succeed "-notation)" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi m
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mi lim
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi ϵ
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mn 0
                                    %mo ,
                                    %mn ∞
                                    %mo{:stretchy => "false"} )
                                %mrow
                                  %mrow
                                    %mi ϵ
                                    %mo →
                                    %mn 0
                            %mfrac
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mn 1
                            %mo ∫
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mfrac
                              %mrow
                                %msup
                                  %mi e
                                  %mrow
                                    %mi i
                                    %msub
                                      %mi k
                                      %mi μ
                                    %msup
                                      %mi x
                                      %mi μ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mi k
                                  %mi μ
                                %msup
                                  %mi k
