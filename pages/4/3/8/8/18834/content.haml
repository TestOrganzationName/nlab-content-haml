                      %mn 1
                    %mo +
                    %msub
                      %mi O
                      %mn 2
                    %mo +
                    %msub
                      %mi O
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mn 1
                    %mo +
                    %msub
                      %mi O
                      %mn 2
                    %mo +
                    %msub
                      %mi O
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
