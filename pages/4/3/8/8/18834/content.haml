            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              this acts on
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              (
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi ρ
                                  %mo *
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Φ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(E)
                    \&amp;\overset{\rho^\ast}{\longrightarrow}&amp;
                    \\Gamma_\Sigma(E)
                    \\\
                    \\Phi &amp;\mapsto&amp; \Phi(\rho(-))
                    }
                    \\,.
            %p Let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ↦
                    %msub
                      %mi vac
                      %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
