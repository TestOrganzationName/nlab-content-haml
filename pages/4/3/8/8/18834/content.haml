                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                      %mo =
                      %munder
                        %mi lim
                        %mrow
                          %mi Λ
                          %mo →
                          %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒮
                        %mi Λ
                      %mo ∘
                      %msub
                        %mi 𝒵
                        %mi Λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{S} = \underset{\Lambda \to \infty }{\lim} (\mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda)
              %em every
              other S-matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒮
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{\mathcal{S}}
              there exist counterterms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi 𝒵
                        %mo ˜
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} \widetilde{\mathcal{Z}}_\lambda
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi 𝒮
                        %mo ˜
                      %mo =
                      %munder
                        %mi lim
                        %mrow
                          %mi Λ
                          %mo →
                          %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒮
                        %mi Λ
                      %mo ∘
                      %msub
                        %mover
                          %mi 𝒵
                          %mo ˜
                        %mi Λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widetilde{\mathcal{S}} = \underset{\Lambda \to \infty }{\lim} (\mathcal{S}_\Lambda \circ \widetilde{\mathcal{Z}}_\Lambda)
            %p
              But by the
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi 𝒮
                              %mo ˜
                          %mtd
                            %mo =
                            %mi 𝒮
                            %mo ∘
                            %mi 𝒵
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi Λ
                                %mo →
                                %mn ∞
                            %mrow
                              %mo (
                              %msub
                                %mi 𝒮
                                %mi Λ
                              %mo ∘
                              %msub
                                %mi 𝒵
                                %mi Λ
                              %mo )
                            %mo ∘
                            %mi 𝒵
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi Λ
                                %mo →
                                %mn ∞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi 𝒵
                                    %mi Λ
                                  %mo ∘
                                  %mi 𝒵
                                %mo ⏟
                              %mrow
                                %msub
                                  %mover
                                    %mi 𝒵
                                    %mo ˜
                                  %mi Λ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widetilde{\mathcal{S}}
                    \&amp; = \mathcal{S} \circ \mathcal{Z}
                    \\\
                    \&amp; =
                    \\underset{\Lambda \to \infty}{\lim}
                    \\left(
                    \\mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda
                    \\right)
                    \\circ
                    \\mathcal{Z}
                    \\\
                    \&amp; =
                    \\underset{\Lambda \to \infty}{\lim}
                    (
                    \\mathcal{S}_\Lambda
                    \\circ
                    (
                    \\underset{
                    \\widetilde{\mathcal{Z}}_\Lambda
                    }{
                    \\underbrace{
                    \\mathcal{Z}_\Lambda
                    \\circ
                    \\mathcal{Z}
                    }
                    }
                    )
                    )
                    \\end{aligned}
            %p
              and hence with counterterms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              given, then counterterms for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒮
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{\mathcal{S}}
              are given by the composite
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi 𝒵
                          %mo ˜
                        %mi Λ
                      %mo ≔
                      %msub
                        %mi 𝒵
                        %mi Λ
                      %mo ∘
                      %mi 𝒵
                    %annotation{:encoding => "application/x-tex"} \widetilde{\mathcal{Z}}_\Lambda \coloneqq \mathcal{Z}_\Lambda \circ \mathcal{Z}
          #TermCounter.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/counterterms"}> counterterms
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            %p Consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int} + j A
                    \\;\in\;
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g,j\rangle
            %p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Then prop.
              %a.maruku-ref{:href => "#UVRegularization"}
              says that there exist
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
              of this
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{Z}_\Lambda(g S_{int} + j A)
                    \\;\in\;
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g,j\rangle
            %p
              parameterized by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Lambda \in [0,\infty)
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mrow
                        %mi Λ
                        %mo →
                        %mn ∞
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mrow
                      %mo (
                      %msub
                        %mi 𝒵
                        %mi Λ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_\infty(g S_{int} + j A)
                    \\;\coloneqq\;
                    \\underset{\Lambda \to \infty}{\lim}
                    \\mathcal{S}_\Lambda\left( \mathcal{Z}_\Lambda( g S_{int} + j A )\right)
            %p
              exists and is an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              with the given
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            %p In this case the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mrow
                                %mi counter
                                %mo ,
                                %mi Λ
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo +
                              %mi j
                              %mi A
                              %mo )
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi 𝒵
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi Loc
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ⟨
                            %msup
                              %mi g
                              %mn 2
                            %mo ,
                            %msup
                              %mi j
                              %mn 2
                            %mo ,
                            %mi g
                            %mi j
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_{counter, \Lambda}
                    \&amp; \coloneqq
                    \\left(
                    g S_{int} + j A
                    \\right)
                    \\;-\;
                    \\mathcal{Z}_{\Lambda}(g S_{int} + j A)
                    \\;\;\;\;\;\in\;
                    Loc(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g^2, j^2, g j\rangle
                    \\end{aligned}
            %p
              (which by the axiom “perturbation” in def.
              %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
              is at least of second order in the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              %em
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              at cutoff scale
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mrow
                        %mi counter
                        %mo ,
                        %mi Λ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{Z}_{\Lambda}(g S_{int} + j A)
                    \\;=\;
                    g S_{int} + j A
                    \\;+\;
                    S_{counter,\Lambda}
                    \\,.
            %p
              In this language prop.
              %a.maruku-ref{:href => "#UVRegularization"}
              says that for every free field vacuum and every choice of local interaction, there is a choice of counterterms to the interaction that defines a corresponding
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalized
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} (re"-)normalized
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              arises from some choice of counterterms.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#EffectiveQFTFlowWislonian
            %strong
              %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} Wilson-Polchinski effective QFT flow
          %p
            We have seen
            %a{:href => "#UVRegularizationViaZ"} above
            that a choice of
            %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
            induces
            %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+schemes"} effective S-matrix schemes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
            at cutoff scale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#SMatrixEffective"}
            %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi eff
                      %mo ,
                      %mi Λ
                %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
            (def.
            %a.maruku-ref{:href => "#EffectiveActionRelative"}
            below) which are such that their effective
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            at scale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            coincide with the true scattering amplitudes of a genuine
            %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
            interaction as the cutoff is removed. This is the Wilsonian picture of
            %em
              %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} effective quantum field theory
            at a given cutoff scale (remark
            %a.maruku-ref{:href => "#pQFTEffective"}
            below). Crucially the “flow” of the
            %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
            with the cutoff scale satisfies a
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            that in itself is independent of the full UV-theory; this is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Polchinski%27s+flow+equation"} Polchinski's flow equation
            (prop.
            %a.maruku-ref{:href => "#FlowEquationPolchinski"}
            below). Solving this equation for given choice of initial value data is hence another way of choosing
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            constants.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #EffectiveSmatrixSchemeInvertible.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+schemes"} effective S-matrix schemes
                are
                = succeed ")" do
