          #pQFTEffective.num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"}> effective quantum field theory
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mo =
                    %munder
                      %mi lim
                      %mrow
                        %mi Λ
                        %mo →
                        %mn ∞
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty = \underset{\Lambda \to \infty}{\lim} \mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#UVRegularization"}
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BrST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int} + j A
                    \\;\in\;
                    LocObs(E_{\text{BV-BrST}})[ [ \hbar, g, j] ]\langle g, j\rangle
            %p
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Then def.
              %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              and def.
              %a.maruku-ref{:href => "#EffectiveActionRelative"}
              say that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda \in (0,\infty)
              the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"} effective S-matrix
              %a.maruku-eqref{:href => "#eq:EffectiveSMatrixScheme"} (12)
              of the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              %a.maruku-eqref{:href => "#eq:RelativeEffectiveActionComposite"} (21)
              equals the genuine
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
              of the genuine
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_\Lambda( S_{eff,\Lambda} )
                    \\;=\;
                    \\mathcal{S}_\infty\left( g S_{int} + j A  \right)
                    \\,.
            %p
              In other words the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              encodes what the actual
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty\left( g S_{int} + j A  \right)
              %em effectively
              looks like at
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
            %p
              Therefore one says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              defines
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} effective quantum field theory
              at
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
            %p
              Notice that in general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              is
              %em
                not a
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              anymore: By prop.
              %a.maruku-ref{:href => "#EffectiveSmatrixSchemeInvertible"}
              the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒮
                      %mi Λ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}^{-1}_\Lambda
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"} effective S-matrix
              is
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} 1 + PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]\langle g,j\rangle
              and there is no guarantee that this lands in the subspace of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            %p
              Therefore
              %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theories"} effective quantum field theories
              at finite
              = succeed "-scale" do
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
