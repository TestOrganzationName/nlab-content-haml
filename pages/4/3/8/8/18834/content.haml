                    \\underset{
                    n \in \{1, \cdots, k-1\}
                    }{\sum}
                    \\frac{1}{n!} Z_n
            %p
              is the truncation of the
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
              to degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \lt k
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{S} \circ \mathcal{Z}_{\lt k}
              is still an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme (by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CausalFactorizationSatisfiedByCompositionOfSMatrixWithVertexRedefinition"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_k
              are
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              (by example
              = succeed ")." do
                %a.maruku-ref{:href => "#TimeOrderedProductsFromSMatrixScheme"}
            %p
              So as we solve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ′
                    %mo =
                    %mi 𝒮
                    %mo ∘
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}' = \mathcal{S} \circ \mathcal{Z}
              inductively in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              the expressions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{\lt k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %mi 𝒵
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z})_{\lt k}
              agree and are both time-ordered products. By prop.
              %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_{k}
              agree away from the diagonal. This means that their difference
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Z_k
              is supported on the diagonal, and hence is indeed local.
          %p
            In conclusion this establishes the following pivotal statement of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
          #PerturbativeRenormalizationMainTheorem.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
                –
                %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H)
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#VacuumFree"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒵
                      %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                  under
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %li
                %p
                  the set of
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} ("re"-)normalization schemes
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
                  = succeed ")" do
                    %a.maruku-ref{:href => "#calSFunctionIsRenormalizationScheme"}
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
                  “field independence” (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#BasicConditionsRenormalization"}
                  %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                  over this group, hence equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
                  in that
                %ol
                  %li
                    %p
                      the set of
                      %a.existingWikiWord{:href => "/nlab/show/S-matrix+schemes"} S-matrix schemes
                      is
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  %li
                    %p
                      any two
                      %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                      %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} ("re"-)normalization schemes
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒮
                            %annotation{:encoding => "application/x-tex"} \mathcal{S}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒮
                            %mo ′
                          %annotation{:encoding => "application/x-tex"} \mathcal{S}'
                      are related by a
                      %em unique
                      %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒵
                          %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                      via
                      = succeed ":" do
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒮
                            %mo ′
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒮
                            %mo ∘
                            %mi 𝒵
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\mathcal{S}' \;=\; \mathcal{S} \circ \mathcal{Z}
                            \\,.
            %p
              This group is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
            %p
              Typically one imposes a set of
              %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"} renormalization conditions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RenormalizationConditions"}
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
              preserving these conditions.
          .proof
            %h6#proof_12 Proof
            %p
              The
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              and
              %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
              is given by prop.
              %a.maruku-ref{:href => "#CausalFactorizationSatisfiedByCompositionOfSMatrixWithVertexRedefinition"}
              and prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
              in theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ExistenceRenormalization"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#UVRegularizationViaZ
            %strong
              %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-Regularization
              via
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
          %p
            While
            %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#ExistenceRenormalization"}
            %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
            in prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            (theorem
            = succeed ")," do
              %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
            %em difference
            between any two such choices as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            itself should have an incarnation in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
          %p
            This may be realized via a construction of
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            in terms of
            %em
              %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-regularization
            (prop.
            %a.maruku-ref{:href => "#UVRegularization"}
            below): For any choice of “
            %a.existingWikiWord{:href => "/nlab/show/UV-cutoff"}> UV-cutoff
            ”, given by an approximation of the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi F
                %annotation{:encoding => "application/x-tex"} \Delta_F
            by
            %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mi F
                      %mo ,
                      %mi Λ
                %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
            (def.
            %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            below) there is a unique “
            %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"}> effective S-matrix
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
            induced at each cutoff scale (def.
            %a.maruku-ref{:href => "#SMatrixEffective"}
            below). While the “UV-limit”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi Λ
                      %mo →
                      %mn ∞
                  %msub
                    %mi 𝒮
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \underset{\Lambda \to \infty}{\lim} \mathcal{S}_\Lambda
            does not in general exist, it may be “regularized” by applying suitable
            %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counter
            %a.maruku-ref{:href => "#TermCounter"}
            below) the coresponding UV-divergences.
          %p
            This perspective of
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization via
            via
            %em
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
            is often regarded as the primary one. Its elegant proof in prop.
            %a.maruku-ref{:href => "#UVRegularization"}
            below, however relies on the
            %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
            via inductive
            %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
            and uses the same kind of argument as in the proof of the
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            (theorem
            %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
            via prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CutoffsUVForPerturbativeQFT.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"}> UV cutoffs
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (according to def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Δ
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H = \tfrac{i}{2}(\Delta_+ - \Delta_-) + H
              is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              inducing the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ×
                        %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ⊠
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_F \in \Gamma'_{\Sigma \times \Sigma}(E_{\text{BV-BRST}} \boxtimes E_{\text{BV-BRST}})
            %p
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi F
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi Δ
                        %mo −
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_F = \tfrac{i}{2}(\Delta_+ + \Delta_-) + H
            %p
              Then a choice of
              %em
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
                for
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum is a collection of
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              parameterized by
              %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ×
                                %mi Σ
                                %mo ,
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo ⊠
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Λ
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (0, \infty)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\Gamma_{\Sigma \times \Sigma,cp}(E_{\text{BV-BRST}} \boxtimes E_{\text{BV-BRST}})
                    \\\
                    \\Lambda &amp;\mapsto&amp; \Delta_{F,\Lambda}
                    }
            %p such that:
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
                  satisfies the following basic properties
                %ol
                  %li
                    %p (translation invariance)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\Delta_{F,\Lambda}(x,y) = \Delta_{F,\Lambda}(x-y)
                  %li
                    %p (symmetry)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi b
                                %mi a
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\Delta^{b a}_{F,\Lambda}(y, x)
                            \\;=\;
                            \\Delta^{a b}_{F,\Lambda}(x, y)
                    %p i.e.
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi b
                                %mi a
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\Delta_{F,\Lambda}^{b a}(-x)
                            \\;=\;
                            \\Delta_{F,\Lambda}^{a b}(x)
              %li
                %p
                  the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
                  interpolate between zero and the Feynman propagator, in that, in the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander+topology"} Hörmander topology
                %ol
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                      as
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Λ
                            %mo →
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \Lambda \to 0
                      exists and is zero
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mi lim
                              %mrow
                                %mi Λ
                                %mo →
                                %mn ∞
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 0
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\underset{\Lambda \to \infty}{\lim} \Delta_{F,\Lambda}
                            \\;=\;
                            0
                            \\,.
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                      as
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Λ
                            %mo →
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \Lambda \to \infty
                      exists and is the
                      = succeed ":" do
                        %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mi lim
                              %mrow
                                %mi Λ
                                %mo →
                                %mn ∞
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi Δ
                              %mi F
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\underset{\Lambda \to \infty}{\lim} \Delta_{F,\Lambda}
                            \\;=\;
                            \\Delta_F
                            \\,.
          %p
            (
            %a{:href => "renormalization#Duetsch10"}> Dütsch 10, section 4
            )
          .num_example
            %h6#example_4 Example
            %p
              %strong (relativistic momentum cutoff)
            %p
              Recall from
              %a{:href => "Feynman+propagator#FeynmanPropagatorAsACauchyPrincipalvalue"} this prop.
              that the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              is,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi Δ
                                %mo ^
                              %mi F
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mfrac
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mn 1
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi η
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                                %mo −
                                %msup
                                  %mrow
                                    %mo (
                                    %mstyle{:displaystyle => "false"}
                                      %mfrac
                                        %mrow
                                          %mi m
                                          %mi c
                                        %mi ℏ
                                    %mo )
                                  %mn 2
                                %mo +
                                %mi i
                                %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat{\Delta}_F(k)
                    \&amp; =
                    \\frac{+i}{(2\pi)^{p+1}}
                    \\frac{
                    1
                    }{
                    \- \eta(k,k) - \left( \tfrac{m c}{\hbar} \right)^2 + i 0
                    }
                    \\end{aligned}
            %p
              To produce a
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              in the sense of def.
              %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              we would like to set this function to zero for
              %a.existingWikiWord{:href => "/nlab/show/wave+numbers"} wave numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert \vec k\vert
              (hence
              %a.existingWikiWord{:href => "/nlab/show/momenta"} momenta
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \hbar\vert \vec k\vert
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
            %p
              This needs to be done with due care: First, the
              %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#PaleyWienerSchwartzTheorem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              to be a test function and hence compactly supported, its
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Δ
                        %mo ^
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \widehat{\Delta}_{F,\Lambda}
              needs to be smooth and of bounded growth. So instead of multiplying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Δ
                        %mo ^
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \widehat{\Delta}_F
              by a
              %a.existingWikiWord{:href => "/nlab/show/step+function"} step function
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            (
            %a{:href => "UV+regularization#KellerKopperSchophaus97"}> Keller-Kopper-Schophaus 97, section 6.1
            ,
            = succeed ")" do
              %a{:href => "renormalization#Duetsch18"} Dütsch 18, example 3.126
          #SMatrixEffective.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"}> effective S-matrix scheme
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            %p
              We say that the
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"} effective S-matrix scheme
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
              at cutoff scale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda \in [0,\infty)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi 𝒮
                                  %mi Λ
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mi O
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                    \&amp;\overset{\mathcal{S}_{\Lambda}}{\longrightarrow}&amp;
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                    \\\
                    O &amp;\mapsto&amp; \mathcal{S}_\Lambda(O)
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
            #eq:EffectiveSMatrixScheme.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msub
                              %mi exp
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mrow
                              %mo (
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                              %mi O
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                            %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mi i
                                %mi ℏ
                            %mi O
                            %mo +
                            %mfrac
                              %mn 1
                              %mn 2
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi ℏ
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mi O
                            %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mn 3
                                %mo !
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi ℏ
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 3
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mn 0
                            %mo +
                            %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{S}_\Lambda(O)
                    \&amp; \coloneqq
                    \\exp_{F,\Lambda}\left( \frac{1}{i \hbar} O \right)
                    \\\
                    \&amp; =
                    1
                    +
                    \\frac{1}{i \hbar} O
                    +
                    \\frac{1}{2} \frac{1}{(i \hbar)^2} O \star_{F,\Lambda} O
                    +
                    \\frac{1}{3!} \frac{1}{(i \hbar)^3} O \star_{F,\Lambda} O \star_{F,\Lambda} 0
                    +
                    \\cdots
                    \\end{aligned}
                    \\,.
            %p
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \star_{F,\Lambda}
              induced by the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PropagatorStarProduct"}
            %p
              This is evidently defined on all
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              as shown, and restricts to an endomorphism on
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              as shown, since the contraction coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
          %p
            (
            %a{:href => "renormalization#Duetsch10"}> Dütsch 10, (4.2)
            )
          #UVRegularization.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g,j\rangle
              a polynomial
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FormalParameters"}
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Let moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{\Delta_{F,\Lambda}\}_{\Lambda \in [0,\infty)}
              be a
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
              the induced
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+schemes"} effective S-matrix schemes
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:EffectiveSMatrixScheme"} (12)
            %p Then
            %ol
              %li
                %p
                  there exists a
                  = succeed "-parameterized" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn ∞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} [0,\infty)
                  %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi 𝒵
                          %mi Λ
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi Λ
                            %mo ∈
                            %msub
                              %mi ℝ
                              %mrow
                                %mo ≥
                                %mn 0
                      %annotation{:encoding => "application/x-tex"} \{\mathcal{Z}_\Lambda\}_{\Lambda \in \mathbb{R}_{\geq 0}}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
                  %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                  of
                  %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+schemes"} effective S-matrix schemes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒮
                          %mi Λ
                      %annotation{:encoding => "application/x-tex"} \mathcal{S}_{\Lambda}
                  %a.maruku-eqref{:href => "#eq:EffectiveSMatrixScheme"} (12)
                  applied to the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒵
                            %mi Λ
                        %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} redefined interactions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒮
                          %mn ∞
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mi lim
                          %mrow
                            %mi Λ
                            %mo →
                            %mn ∞
                        %mrow
                          %mo (
                          %msub
                            %mi 𝒮
                            %mi Λ
                          %mo ∘
                          %msub
                            %mi 𝒵
                            %mi Λ
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{S}_\infty
                        \\;\coloneqq\;
                        \\underset{\Lambda \to \infty}{\lim}
                        \\left(
                        \\mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda
                        \\right)
                %p
                  exists and is a genuine
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix+scheme"} S-matrix scheme
                  around the given vacuum (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix+scheme"} S-matrix scheme
                  around the given vacuum arises this way.
            %p
              These
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              (remark
              %a.maruku-ref{:href => "#TermCounter"}
              below) and the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrices"} effective S-matrices
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mi Λ
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-regularization
              via
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              is a method of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ExtensionOfTimeOrderedProoductsRenormalization"}
          %p
            This was claimed in (
            %a{:href => "renormalization#BrunettiDuetschFredenhagen09"}> Brunetti-Dütsch-Fredenhagen 09, (75)
            ), a proof was indicated in (
            %a{:href => "renormalization#DuetschFredenhagenKellerRejzner14"}> Dütsch-Fredenhagen-Keller-Rejzner 14, theorem A.1
            ).
          .proof
            %h6#proof_13 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{p_{\rho_{k}}\}_{k \in \mathbb{N}}
              be a sequence of projection maps as in
              %a.maruku-eqref{:href => "#eq:ForExtensionOfDistributionsProjectionMaps"} (6)
              defining an
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi T
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \in \mathbb{N}}
              as
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T_k
              = succeed "," do
                %a.maruku-ref{:href => "#TimeOrderedProductOfFixedInteraction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mi k
                      %mi α
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q_k^\alpha = 0
              in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ExtensionOfDitstributionsPointFixedAndChoice"} (9)
            %p
              We will construct that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              in terms of these projections
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi ρ
                    %annotation{:encoding => "application/x-tex"} p_\rho
            %p First consider some convenient shorthand:
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒵
                        %mrow
                          %mo ≤
                          %mi n
                      %mo ≔
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mn 1
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} }
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo !
                      %msub
                        %mi Z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathcal{Z}_{\leq n} \coloneqq \underset{1 \in \{1, \cdots, n\}}{\sum} \frac{1}{n!} Z_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi Λ
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo ≤
                        %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T_\Lambda \circ \mathcal{Z}_{\leq n})_k
              for the
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mi Λ
                      %mo ∘
                      %msub
                        %mi 𝒵
                        %mrow
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda \circ \mathcal{Z}_{\leq n}
              %a.maruku-eqref{:href => "#eq:MainTheoremPerturbativeRenormalizationInductionStep"} (11)
              in the proof of the
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              = succeed "," do
                %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              = succeed ")." do
                %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
            %p
              In this notation we need to find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have
            #eq:CountertermsInductionAssumption.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi Λ
                        %mo →
                        %mn ∞
                    %msub
                      %mrow
                        %mo (
                        %msub
                          %mi T
                          %mi Λ
                        %mo ∘
                        %msub
                          %mi 𝒵
                          %mrow
                            %mo ≤
                            %mi n
                            %mo ,
                            %mi Λ
                        %mo )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\Lambda \to \infty}{\lim}
                    \\left(
                    T_\Lambda \circ \mathcal{Z}_{\leq n, \Lambda}
                    \\right)_n
                    \\;=\;
                    T_n
                    \\,.
            %p
              We proceed by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Since by definition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_0 = const_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} T_1 = id
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Z_0 = const_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 1
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} Z_1 = id
              the statement is trivially true for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
            %p
              So assume now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Z
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \{Z_{k}\}_{k \leq n}
              has been found such that
              %a.maruku-eqref{:href => "#eq:CountertermsInductionAssumption"} (13)
              holds.
            %p
              Observe that with the chosen renormalizing projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} p_{\rho_{n+1}}
              the time-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} T_{n+1}
              may be expressed as follows:
            #eq:RenormalizedSMatrixAsLimitOfEffectiveSMatricesEvaluatedOnProjection.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi O
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mrow
                              %mo ⟨
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mstyle{:mathvariant => "bold"}
                                        %mi I
                                      %mo ∈
                                      %mo{:stretchy => "false"} {
