                                      %mo{:stretchy => "false"} |
                                    %mo ≤
                                    %mi ρ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} |
