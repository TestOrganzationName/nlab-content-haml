            %p
              Therefore prop.
              %a.maruku-ref{:href => "#ExtensionUniqueNonPositiveDegreeOfDivergence"}
              says that each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi α
                    %mi u
