                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mi ρ
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} = \rho + 1
              has a unique extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
