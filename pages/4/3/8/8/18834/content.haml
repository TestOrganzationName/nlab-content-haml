                    deg(u)
                    \\,.
            %p
              Observe that (by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingDegreeOfDistributionsBasicProperties"}
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi α
                    %mi u
                  %annotation{:encoding => "application/x-tex"} x^\alpha u
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mi ρ
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} = \rho + 1
              is
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
