                        %mn 2
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi sp
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mn 1
