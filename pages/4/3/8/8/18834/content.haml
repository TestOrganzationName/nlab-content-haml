          %p
            (
            %a{:href => "renormalization#Duetsch18"}> Dütsch 18, exercise 3.98
            )
          .proof
            %h6#proof_9 Proof
            %p Under the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
