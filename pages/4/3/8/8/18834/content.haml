                        %mi ρ
                        %mo ,
                        %mi sp
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
