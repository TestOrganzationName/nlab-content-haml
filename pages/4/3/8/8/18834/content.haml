              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sp
                    %mo ∈
                    %mi Spec
                  %annotation{:encoding => "application/x-tex"} sp \in Spec
              the collection of
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagators"} Feynman propagators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi ρ
                        %mo ,
                        %mi sp
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\rho,sp}
              for that species
              %em scales homogeneously
              in that there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi sp
                    %mo{:stretchy => "false"} )
                    %mo ∈
