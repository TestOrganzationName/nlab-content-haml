                      %mi α
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    {\hat u}^\prime - \hat u
                    \\;=\;
                    \\underset{
                    { \alpha \in \mathbb{N}^n  }
                    \\atop
                    { {\vert \alpha\vert} \leq \rho }
                    }{\sum}
                    ( (c')^\alpha - c^\alpha )
                    \\,
                    \\partial_\alpha \delta_0
                    \\,,
            %p
              where the constants
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mi α
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi α
                    %mo −
                    %msup
                      %mi c
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} q^\alpha \coloneqq ( (c')^\alpha - c^\alpha ) \in \mathbb{C}
              are independent of any choices.
            %p
              It remains to see that all these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              in fact have the same degree of divergence as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %p
              By example
              %a.maruku-ref{:href => "#DerivativesOfDeltaDistributionScalingDegree"}
              the degree of divergence of the point-supported distributions on the right is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mi α
                      %msub
                        %mi δ
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                      %mo ≤
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} deg(\partial_\alpha \delta_0) = {\vert \alpha\vert} \leq \rho
            %p Therefore to conclude it is now sufficient to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mrow
                      %mo (
                      %mover
                        %mrow
                          %mi u
                          %mo ∘
                          %msub
                            %mi p
                            %mi ρ
                        %mo ^
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg\left(
                    \\widehat{
                    u \circ p_\rho
                    }
                    \\right)
                    \\;=\;
                    \\rho
                    \\,.
            %p
              This is shown in (
              %a{:href => "extension+of+distributions#BrunettiFredenhagen00"}> Brunetti-Fredenhagen 00, p. 25
              ).
          #WExtensions.num_remark
            %h6#remark_2 Remark
            %p
              %strong (“W-extensions”)
            %p
              Since in
              %a{:href => "renormalization#BrunettiFredenhagen00"} Brunetti-Fredenhagen 00, (38)
              the projectors
              %a.maruku-eqref{:href => "#eq:SpaceOfSmoothFunctionsOfGivenVaishingOrderProjector"} (7)
              are denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              ”, the construction of
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              via the proof of prop.
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
              has come to be called “W-extensions” (e.g
              = succeed ")." do
                %a{:href => "renormalization#Duetsch18"} Dütsch 18
          %p
            In conclusion we obtain the central theorem of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
          #ExistenceRenormalization.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (existence and choices of
                %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
                of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFTs"} perturbative QFTs
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge-fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              = succeed "," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              is
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              and the
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              is translation-invariant.
            %p Then:
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix+scheme"} S-matrix scheme
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒮
                      %annotation{:encoding => "application/x-tex"} \mathcal{S}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo +
                        %mi j
                        %mi A
                        %mo ∈
                        %mi LocObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo ,
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ⟨
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} g S_{int} + j A \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g,j\rangle
                  a
                  %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                  as in def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#FormalParameters"}
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                  %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo +
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi PolyObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi mc
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo ,
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{S}(g S_{int} + j A)
                        \\;\in\;
                        PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                %p
                  hence of the corresponding
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/perturbative+QFTs"} perturbative QFTs
                  = succeed "," do
                    %a.maruku-ref{:href => "#InteractingFieldAlgebraOfObservablesIsFormalDeformationQuantization"}
                  %a.existingWikiWord{:href => "/nlab/show/induction"} inductively
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
                  %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi k
                      %annotation{:encoding => "application/x-tex"} T_k
                  to the locus of coinciding interaction points.
          .proof
            %h6#proof_8 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#FeynmanPropagatorOnMinkowskiScalingDegree"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              is finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree of a distribution
              %a.maruku-ref{:href => "#ScalingDegreeOfProductDistribution"}
              the binary
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              away from the diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi Σ
                          %mn 2
                        %mo ∖
                        %mi diag
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_2(-,-)\vert_{\Sigma^2 \setminus diag(\Sigma)} = (-) \star_{F} (-)
              has finite scaling degree.
            %p
              By prop.
              %a.maruku-ref{:href => "#ScalingDegreeOfProductDistribution"}
              this implies that in the inductive description of the time-ordered products by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              of finite
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree of a distribution
              to the point. By prop.
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
              this always exists.
            %p This proves the first statement.
            %p
              Now if a polynomial local interaction is fixed, then via remark
              %a.maruku-ref{:href => "#TimeOrderedProductOfFixedInteraction"}
              each induction step involved extending a finite number of distributions, each of finite scaling degree. By prop.
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
              the corresponding space of choices is in each step a finite-dimensional affine space.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#SPRenormalizationGroup
            %strong
              %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
          %p
            A genuine re-normalization is the passage from one
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} ("re"-)normalization scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            to another such scheme
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}'
            %a.existingWikiWord{:href => "/nlab/show/induction"} inductive
            %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-normalization)
            construction (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{S}'
            is inductively in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            a choice of extra term in the
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            factors, equivalently in the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
            for
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of these vertices coincide in
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            (prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
          %p
            A natural question is whether these additional interactions that appear when several interaction vertices coincide may be absorbed into a re-definition of the original interaction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            %em
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
            (def.
            %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
            below)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒵
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %mtext higher order corrections
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{Z}
                  \\;\colon\;
                  g S_{int} + j A
                  \\;\mapsto\;
                  g S_{int} + j A
                  \\;+\;
                  \\text{higher order corrections}
          %p
            should perturbatively send
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local
            interactions to local interactions with higher order corrections.
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            (theorem
            %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
            below) says that indeed under mild conditions every re-normalization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ↦
                  %mi 𝒮
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{S} \mapsto \mathcal{S}'
            is induced by such an
            %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
            in that there exists a
            %em unique
            such redefinition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒵
                %annotation{:encoding => "application/x-tex"} \mathcal{Z}
            so that for every local interaction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                %annotation{:encoding => "application/x-tex"} g S_{int} +  j A
            we have that
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            for the interaction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            computed with the
            %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} ("re"-)normalization scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{S}'
            equal those computed with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            but applied to the
            %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} re-defined interaction
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}(g S_{int} + j A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ′
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒮
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
