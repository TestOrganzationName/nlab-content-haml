                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    PolyObs(E)
                    \&amp;
                    \\overset{
                    \\sigma_\rho
                    }{\longrightarrow}
                    \&amp;
                    PolyObs(E)
