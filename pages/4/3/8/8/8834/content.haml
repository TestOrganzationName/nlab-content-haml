          %p
            Here the last
            %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
            on the bottom right shows the
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
            %a.existingWikiWord{:href => "/nlab/show/mapping+cones"} mapping cones
            (ordinary
            %a.existingWikiWord{:href => "/nlab/show/cofiber+coproducts"} cofiber coproducts
            after
            %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} resolving
            points to
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/cones"} cones
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+diagram"} homotopy coherent diagram
