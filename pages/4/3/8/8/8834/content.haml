              %use{:x => "374.619527", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-1", :y => "119.037"}
              %use{:x => "378.409325", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "119.037"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "384.5005", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-6", :y => "119.037"}
              %use{:x => "388.645965", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-7", :y => "119.037"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "303.96", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-16", :y => "126.01"}
              %use{:x => "307.657146", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-2", :y => "126.01"}
              %use{:x => "310.009331", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-13", :y => "126.01"}
              %use{:x => "314.043016", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "126.01"}
              %use{:x => "317.336673", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "126.01"}
              %use{:x => "320.630331", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-1", :y => "126.01"}
              %use{:x => "324.420129", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "126.01"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "330.517281", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-6", :y => "126.01"}
              %use{:x => "334.662747", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-7", :y => "126.01"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "340.036609", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-16", :y => "126.01"}
              %use{:x => "343.733755", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-6", :y => "126.01"}
              %use{:x => "347.87922", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-4", :y => "126.01"}
              %use{:x => "352.473006", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "126.01"}
              %use{:x => "355.766664", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-1", :y => "126.01"}
              %use{:x => "359.556462", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-16", :y => "126.01"}
              %use{:x => "363.253608", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-14", :y => "126.01"}
              %use{:x => "367.847393", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-5", :y => "126.01"}
              %use{:x => "371.096219", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-19", :y => "126.01"}
              %use{:x => "373.448404", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-22", :y => "126.01"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "377.596859", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-1", :y => "126.01"}
            %g{:fill => "rgb(55.488586%, 52.549744%, 0%)", "fill-opacity" => "1"}
              %use{:x => "384.184174", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-3", :y => "126.01"}
              %use{:x => "391.01956", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-13", :y => "126.01"}
              %use{:x => "395.053244", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-20", :y => "126.01"}
              %use{:x => "399.64703", "xlink:href" => "#sGFr1APuXhxTeyMX8W2__4EDsb8=-glyph-0-21", :y => "126.01"}
          %p
            In any case, the Toda bracket may be thought of as being in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            what the
            %a.existingWikiWord{:href => "/nlab/show/Massey+product"} Massey product
            is in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/secondary+characteristic+class"} secondary
            invariant”, which exists (has
            %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of the morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 2
                  %mo ∘
                  %msub
                    %mi f
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f_2 \circ f_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 3
                  %mo ∘
                  %msub
                    %mi f
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f_3\circ f_2
            – vanish, as witnessed by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/null+homotopies"} null homotopies
          %p
            A generalization of the Toda bracket produces an invariant for sequences of morphisms, equipped with consecutive pair-wise null-homotopies, which may contain possibly more than three morphisms; this
            %em higher Toda bracket
            was maybe first considered in
            %a{:href => "#Cohen68"} Cohen 68, Sec. 2
          %p
            %br/
          %h2#preliminaries Preliminaries
          %p
            Consider a sequence of maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} A_0 \to A_1 \to A_2 \to A_3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A_0 \to A_2
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo →
                  %msub
                    %mi A
                    %mn 3
                %annotation{:encoding => "application/x-tex"} A_1\to A_3
            are nulhomotopic, then one has a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi A
                          %mn 0
                      %mtd
                        %mo →
                      %mtd
                        %msub
                          %mi A
                          %mn 1
                      %mtd
                        %mo →
                      %mtd
                        %mo *
                    %mtr
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                    %mtr
                      %mtd
                        %mo *
                      %mtd
                        %mo →
                      %mtd
                        %msub
                          %mi A
                          %mn 2
                      %mtd
                        %mo →
                      %mtd
                        %msub
                          %mi A
                          %mn 3
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccc}
                  A_0 &amp; \to &amp; A_1 &amp; \to &amp; * \\
                  \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                  * &amp; \to &amp; A_2 &amp; \to &amp; A_3
                  \\end{array}
          %p
            any choice of homotopies in the two squares gives a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \Sigma A_0 \to A_3
          %p
            Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            to be the cofibers of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} A_0 \to A_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1\to A_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                  %mo ∼
                  %mn 0
                %annotation{:encoding => "application/x-tex"} A_0 \to A_2 \sim 0
            corresponds to a choice of factorization
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %mi C
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 \to C \to A_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi A
                          %mn 0
                      %mtd
                        %mo →
                      %mtd
                        %msub
                          %mi A
                          %mn 1
                      %mtd
                        %mo →
                      %mtd
                        %mo *
                    %mtr
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                    %mtr
                      %mtd
                        %mo *
                      %mtd
                        %mo →
                      %mtd
                        %mi C
                      %mtd
                        %mo →
                      %mtd
                        %mi Σ
                        %msub
                          %mi A
                          %mn 0
                      %mtd
                        %mo →
                      %mtd
                        %mo *
                    %mtr
                      %mtd
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↓
                    %mtr
                      %mtd
                      %mtd
                      %mtd
                        %msub
                          %mi A
                          %mn 2
                      %mtd
                        %mo →
                      %mtd
                        %mi D
                      %mtd
                        %mo →
                      %mtd
                        %mi C
                        %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccccc}
                  A_0 &amp; \to &amp; A_1 &amp; \to &amp; * \\
                  \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                  * &amp; \to &amp; C &amp;\to &amp; \Sigma A_0  &amp; \to &amp; *\\
                  \&amp; &amp; \downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                  \&amp; &amp; A_2 &amp; \to &amp; D &amp; \to &amp; C'
                  \\end{array}
          %p
            It is to be noted that the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \Sigma A_0 \to D
            and possibly the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            depend on the choice of factor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C \to A_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 2
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} A_2 \to D
            does not, in any meaningful sense, so depend: this is just the structure map of the cofiber of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1\to A_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} C\to A_2
            is thus equivalent to that of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \Sigma A_0 \to D
          %h2#definitions Definitions
          %p
            A sequence of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mn 1
                  %mo →
                  %mi ⋯
                  %mo →
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A_0 \to A_1 \to \cdots \to A_n
            will be called
            %em a bracket sequence
            (a novel phrase for the purposes of this entry) in either of two cases:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
              and the composites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_0 \to A_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} A_1 \to A_3
              are nulhomotopic; OR
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \gt 3
              , and (using the preceding notations), there are choices of factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C\to A_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} D \to A_3
              such that the induced sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %mi D
                    %mo →
                    %msub
                      %mi A
                      %mn 3
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma A_0 \to D \to A_3 \to \cdots \to A_n
              is a bracket sequence.
          %p In all cases, a bracket sequence leads to a three-map sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mi m
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi D
                    %mi m
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo +
                      %mn 2
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo +
                      %mn 3
                %annotation{:encoding => "application/x-tex"} \Sigma^m A_0 \to D_m \to A_{m+2} \to A_{m+3}
          %p in which consecutive maps compose trivially, and so there are induced choices of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mrow
                      %mi m
                      %mo +
                      %mn 1
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo +
                      %mn 3
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Sigma^{m+1} A_0 \to A_{m+3} .
          %p
            The collection of all such maps, taking all compatible variations, is the
            %strong Toda Bracket
            of the bracket sequence.
          %p
            Among the bracket sequences, a particular family arises which here will be called
            %em null-bracket
            (again, a novel phrase). A sequence will be called null-bracket if
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_0 \to A_2
              is trivial, OR
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \gt 2
              , and there is a choice of factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo →
                    %mi C
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 \to C \to A_2
              such that the sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C \to A_2 \to \cdots \to A_n
              is null-bracket.
          %p
            If the Toda bracket for a bracket sequence includes the trivial map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mrow
                      %mi m
                      %mo +
                      %mn 1
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo +
                      %mn 3
                %annotation{:encoding => "application/x-tex"} \Sigma^{m+1} A_0 \to A_{m+3}
            then the sequence is null-bracket.
          %h2#applications Applications
          %p
            By definition, if a sequence is a bracket sequence AND NOT a null-bracket sequence, it follows that all the relevant maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mi k
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Sigma^{k} A_0 \to A_n
            are nontrivial. Things like these Toda brackets have been studied by many
            %em (FIXME: references later)
            and especially the length-three brackets used by H. Toda to describe most of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi k
                  %msup
                    %mi 𝕊
                    %mi n
                %annotation{:encoding => "application/x-tex"} \pi_k \mathbb{S}^n
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &lt;
                  %mn 31
                %annotation{:encoding => "application/x-tex"} k \lt 31
            or so.
          %p
            In (
            %a{:href => "#Cohen68"}> Cohen, 1968
            ) is given a criterion for stable maps of spheres to inhabit non-null Toda brackets; this turns out to be most of the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo *
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \pi_* \mathbb{S}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} n \iota
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+map"} Hopf map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo ,
                    %mi θ
                    %mo ,
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \eta, \theta,\sigma
            = succeed "\u2026" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \alpha_p
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Massey+product"} Massey product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/e-invariant"} e-invariant
          %h2#references References
          %p The concept of Toda brackets is due to:
          %ul
            %li#Toda62
              %a.existingWikiWord{:href => "/nlab/show/Hirosi+Toda"}> Hirosi Toda
              ,
              = succeed "," do
                %em Composition Methods in Homotopy Groups of Spheres
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/j.ctt1bgzb5t"} jstor:j.ctt1bgzb5t
          %p and the concept of higher Toda brackets appears around
          %ul
            %li#Cohen68
              Joel Cohen, Section 2 of:
              = succeed "," do
                %em The decomposition of stable homotopy
              = succeed ")" do
                %a{:href => "https://doi.org/10.2307/1970586"} doi:10.2307/1970586
          %p#ReferencesTodaBracketInHomotopy2Category
            The conceptualization of Toda brackets a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+diagram"} homotopy coherent
            %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            in a
            %a.existingWikiWord{:href => "/nlab/show/pointed+%28infinity%2C1%29-category"} pointed
            %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category"} homotopy 2-category
            (regarded as a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/strict+%282%2C1%29-category"} strict (2,1)-category
          %ul
            %li#HardieKampsKieboom99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Heiner+Kamps"} Klaus Heiner Kamps
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rudger+Kieboom"} Rudger Kieboom
                = succeed "," do
                  %em Higher homotopy groupoids and Toda brackets
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.hha/1139840198"} euclid:hha/1139840198
            %li#HardieMarcumOda01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Howard+Marcum"} Howard Marcum
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nobuyuki+Oda"} Nobuyuki Oda
                = succeed "," do
                  %em Bracket operations in the homotopy theory of a 2-category
                = succeed ")" do
                  %a{:href => "https://rendiconti.dmi.units.it/volumi/33/02.pdf"} rendiconti:33/02
            %li#HardieKampsMarcum02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Heiner+Kamps"} Klaus Heiner Kamps
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Howard+Marcum"} Howard Marcum
                = succeed "," do
                  %em The Toda bracket in the homotopy category of a track bicategory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0022-4049(02)00131-7"} doi:10.1016/S0022-4049(02)00131-7
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Howard+Marcum"}> Howard Marcum
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nobuyuki+Oda"} Nobuyuki Oda
                = succeed "," do
                  %em Long Box Bracket Operations in Homotopy Theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s10485-009-9186-3"} doi:10.1007/s10485-009-9186-3
          %p
            Application of Toda brackets to the concrete computations of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
          %ul
            %li
              %p
                %a{:href => "#Toda62"} Toda 62
            %li
              %p
                %a{:href => "#HardieMarcumOda01"} Hardie-Marcum-Oda 01, Sec. 7
            %li#IaksenWangXu20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"}> Daniel Isaksen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Guozhen+Wang"} Guozhen Wang
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Zhouli+Xu"} Zhouli Xu
                %em More stable stems
                (
                %a{:href => "https://arxiv.org/abs/2001.04511"}> arXiv:2001.04511
                )
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans-Joachim+Baues"}> Hans-Joachim Baues
                ,
                = succeed "," do
                  %em On the cohomology of categories, universal Toda brackets and homotopy pairs
                = succeed ":3," do
                  %strong 11
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1023/A:1007796409912"} doi:10.1023/A:1007796409912
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Toda_bracket"} Toda bracket
          %p
            Discussion for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
          %ul
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 5.7 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li
              %p
                Boryana Dimitrova,
                = succeed "," do
                  %em Universal Toda brackets of commutative ring spectra
                = succeed ")" do
                  %a{:href => "http://www.math.uni-bonn.de/people/grk1150/YWT2010/YWT_Dimitrova.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Constanze+Roitzheim"}> Constanze Roitzheim
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sarah+Whitehouse"} Sarah Whitehouse
                %em
                  Uniqueness of
                  = succeed "-structures" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
                (
                %a{:href => "http://arxiv.org/abs/0909.3222"}> arxiv/0909.3222
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Sagave"}> Steffen Sagave
                ,
