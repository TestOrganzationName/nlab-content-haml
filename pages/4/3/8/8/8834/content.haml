                    %mi ϕ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\vdash
                  \\big(
                  (\phi_2 \cdot f_1)
                  \\circ
                  (f_3 \cdot \phi_1)
                  \\big)
            that
            %em classifies
            this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
